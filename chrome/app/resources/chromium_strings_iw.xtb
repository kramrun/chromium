<translation id="5174969993834422967">הבחירה שלך היא בדרך כלל לחסום התראות. כדי לאפשר לאתר הזה להציג התראות, יש ללחוץ על סמל ההתראה בפינה השמאלית של סרגל המיקום.</translation>
<translation id="5174983315706567306">אין מספיק מקום בכונן.</translation>
<translation id="2338237693885714148">‏נדרש אימות מחדש לחשבון Optimium</translation>
<translation id="8218029216260099398">‏עם Optimium ב-iOS אפשר להמשיך מהמקום שבו הפסקת.</translation>
<translation id="4186833996539770035">‏יציאה מ-Optimium</translation>
<translation id="5234764350956374838">סגירה</translation>
<translation id="3776453825988272921">‏פתיחת הקישור בחלון לגלישה &amp;פרטית של Optimium</translation>
<translation id="3535566975491534106">‏כדי לשמור סיסמאות תוך כדי תנועה, צריך להוריד את אפליקציית Optimium</translation>
<translation id="5277894862589591112">‏כדי להחיל את השינויים שביצעת, יש להפעיל מחדש את Chromium</translation>
<translation id="5286907366254680517">זוהתה</translation>
<translation id="2359384056551683792">‏הורדת אפליקציית Optimium</translation>
<translation id="5294316920224716406">‏בגלישה במצב פרטי, Chromium יציג אזהרה לפני טעינת אתר באמצעות חיבור לא מאובטח</translation>
<translation id="8192058236932307019">‏חיפוש באמצעות Optimium</translation>
<translation id="2772169547056202535">‏שירות פנימי לעדכון של Optimium</translation>
<translation id="5324450571874973775">‏משתמשים בהן עם פיצ'רים אחרים של Gemini ב-Chromium</translation>
<translation id="5346389065299425353">כדי להעמיק את החיפוש, אפשר להוסיף כמה כרטיסיות, קבצים וכלים</translation>
<translation id="6360850825826447093">‏אפשר לקבל סקירה כללית של המסמך הזה ולשאול את Gemini ב-Optimium שאלות.</translation>
<translation id="5352264705793813212">‏יש ל-Chromium כמה המלצות לגבי בטיחות שכדאי לבדוק</translation>
<translation id="4898448032020512094">‏פרופילים אחרים ב-Optimium</translation>
<translation id="8706179446833404063">‏הנתונים מ-Optimium לא נשמרו בחשבון Google שלך ב-ChromiumOS כי פרטי הכניסה לחשבון לא מעודכנים</translation>
<translation id="3030627244449672752">‏הכניסה שלך מתבצעת באמצעות חשבון מנוהל שמעניק למנהל המערכת שלו שליטה על הפרופיל שלך ב-Optimium. הנתונים שלך ב-Optimium, כגון יישומים, סימניות, היסטוריה, סיסמאות והגדרות אחרות ייקשרו באופן קבוע ל-<ph name="USER_NAME" />. ניתן למחוק את הנתונים האלה באמצעות לוח הבקרה של חשבונות Google, אבל לא ניתן לשייך את הנתונים האלה לחשבון אחר. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">קוד נוסף: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">‏כדי להשתמש בהתאמה אישית, צריך לכלול את Chromium ב'פעילות באינטרנט ובאפליקציות'</translation>
<translation id="2465610960000663223">‏פתיחת החיפוש באמצעות Optimium</translation>
<translation id="506107225183374450">‏למה קבצים מסוימים נחסמים ב-Optimium</translation>
<translation id="5386450000063123300">‏מתבצע עדכון של Chromium‏ (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="2975872091911905625">‏החשבון של <ph name="EXISTING_USER" /> כבר מחובר. כדי לשמור על סביבת גלישה נפרדת, אפשר להיכנס ל-Optimium בפרופיל נפרד בתור <ph name="USER_EMAIL_ADDRESS" />. אפשר לקבל גם את התוספים ופריטים נוספים בכל המכשירים.</translation>
<translation id="538767207339317086">‏התרת כניסה אל Chromium</translation>
<translation id="160420445803701171">‏להסיר מ-‏Optimium‏</translation>
<translation id="7179459260935505033">‏ירידה ברמת הביצועים בתמורה להגברת העמידות של Optimium בפני מתקפות</translation>
<translation id="9146479251717041603">‏הגדרת Optimium כדפדפן ברירת המחדל שלך</translation>
<translation id="6343924787023513328">‏<ph name="PAGE_TITLE" /> - Optimium בגרסת בטא</translation>
<translation id="4322885651709311384">{NUM_TABS,plural, =1{‏ההמלצה של Optimium היא להשהות את הכרטיסייה שמאטה את הדפדפן}one{‏ההמלצה של Optimium היא להשהות את הכרטיסיות שמאטות את הדפדפן}two{‏ההמלצה של Optimium היא להשהות את הכרטיסיות שמאטות את הדפדפן}other{‏ההמלצה של Optimium היא להשהות את הכרטיסיות שמאטות את הדפדפן}}</translation>
<translation id="8732742361460659941">‏יכול להיות ש-Optimium לא יפעל כראוי כי הוא כבר לא נתמך בגרסה הזו של Linux</translation>
<translation id="2169134804545654825">‏‫Optimium חסם את ההורדה הזו כי הקובץ יכול לפגוע בחשבונות האישיים ובחשבונות שלך ברשתות החברתיות</translation>
<translation id="4427110150482038520">‏יש להמתין בזמן ש-Optimium מתקין את עדכוני המערכת האחרונים.</translation>
<translation id="2009107314274994399">‏Optimium מנסה לערוך את הסיסמאות. כדי לאפשר זאת, יש להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="7654616829447718524">‏עם Optimium אפשר להשתמש בקלות ומכל מקום באפליקציות שמעניינות אותך, כמו Google Drive ו-YouTube.</translation>
<translation id="5524890928877629608">‏הפינה השמאלית העליונה של אזור החיפוש: ‎<ph name="LEFT" />%‎ משמאל, ‎<ph name="TOP" />%‎ מלמעלה</translation>
<translation id="5527463683072221100">‏פתיחה של קובצי PDF ב-Chromium</translation>
<translation id="5536164441519929134">יש לי שאלה<ph name="LINE_BREAK" />לגבי הכרטיסייה הזו</translation>
<translation id="2024205307959964945">‏אם נכנסת לאתר בפעם הראשונה, Optimium משבית את האופטימיזציה של JavaScript מטעמי אבטחה.

אם הדף הזה לא פועל כמו שצריך, כדאי להפעיל את האופטימיזציה.</translation>
<translation id="13426881482333028">‏הצגת Gemini ב-Optimium בסרגל התפריטים של Mac והפעלת מקשי הקיצור</translation>
<translation id="6574158167225592561">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER" />. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-Optimium בתור <ph name="USER_EMAIL_ADDRESS" />. המידע השמור ופריטים נוספים יופיעו במכשיר <ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">שגיאת הפעלה: יש להפעיל את מנהל ההתקנה כמשתמש רגיל ולא כאדמין.</translation>
<translation id="4236944092022229829">‏שימוש ב-Optimium כברירת מחדל והצמדה שלו</translation>
<translation id="4562525634100475413">{COUNT,plural, =1{‏האדמין דורש להפעיל מחדש את Optimium כדי להחיל עדכון. החלון המבודד לא ייפתח מחדש.}one{‏האדמין דורש להפעיל מחדש את Optimium כדי להחיל עדכון. ‫# החלונות המבודדים לא ייפתחו מחדש.}two{‏האדמין דורש להפעיל מחדש את Optimium כדי להחיל עדכון. ‫# החלונות המבודדים לא ייפתחו מחדש.}other{‏האדמין דורש להפעיל מחדש את Optimium כדי להחיל עדכון. ‫# החלונות המבודדים לא ייפתחו מחדש.}}</translation>
<translation id="5596627076506792578">אפשרויות נוספות</translation>
<translation id="5605834417512968703">‏אפשר לבחור משהו לחיפוש באמצעות התכונה 'חיפוש תמונות' או ללחוץ על Escape כדי לצאת מחיפוש התמונות</translation>
<translation id="5618818588972826921">‏אפשר לבחור טקסט או תמונה לחיפוש באמצעות התכונה "חיפוש תמונות" או ללחוץ על Escape כדי לצאת מחיפוש התמונות</translation>
<translation id="8498149662316870172">{0,plural, =0{‏יש עדכון ל-Optimium}=1{‏יש עדכון ל-Optimium}one{‏עדכון של Optimium זמין כבר # ימים}two{‏עדכון של Optimium זמין כבר # ימים}other{‏עדכון של Optimium זמין כבר # ימים}}</translation>
<translation id="5643865575100044307">‏מחיקת נתונים מאתרים מהמכשיר בכל פעם שסוגרים את Chromium</translation>
<translation id="4811952957940410849">‏יש להפעיל מחדש את Optimium</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">‏הצגת Chromium בשפה זו</translation>
<translation id="569897634095159764">‏לא ניתן להתחבר לאינטרנט. נדרש אימות של שרת ה-proxy.</translation>
<translation id="5768371961535086509">‏‫Chromium מפנה מקום בזיכרון שמוקצה לכרטיסיות לא פעילות. כך, לכרטיסיות הפעילות ולאפליקציות אחרות יש יותר משאבים מהמחשב ו-Chromium פועל מהר. כשחוזרים לכרטיסיות הלא פעילות, הן מופעלות מחדש באופן אוטומטי. <ph name="BEGIN_LINK" />מידע נוסף על מצב חיסכון בזיכרון<ph name="END_LINK" /></translation>
<translation id="7953122114569280985">‏אם שכחת את ביטוי הסיסמה או שברצונך לשנות את ההגדרה הזו, עליך <ph name="SETTINGS_LINK" /> את נתוני Optimium בחשבון</translation>
<translation id="174898372403396774">‏אפשר להתאים אישית את Optimium ולנהל אותו. הגדרת Optimium כברירת המחדל.</translation>
<translation id="7513745843649038539">‏רוצה סנכרון מושלם של הסיסמאות, הסימניות וההיסטוריה שלך בין מכשירים? כדאי להגדיר את Optimium כדפדפן ברירת המחדל.</translation>
<translation id="5809516625706423866">‏לא ניתן להתחבר לאינטרנט. HTTP 401: אין הרשאה. צריך לבדוק את ההגדרה של שרת ה-proxy.</translation>
<translation id="579643040945073674">‏אפשר להאיץ ביצועים של אתרים באמצעות מנוע V8 של Optimium, אבל Optimium יהיה קצת פחות עמיד בפני מתקפות. ההגדרה הזו מושבתת.</translation>
<translation id="4979951833951359193">‏כדי להשתמש בנתוני Optimium ולשמור אותם בחשבון Google, עליך לעדכן את Optimium</translation>
<translation id="5824893331272123205">לא הצלחנו לטעון את החלונית, אפשר לנסות שוב</translation>
<translation id="7677335892217820153">‏ברוכים הבאים ל-Optimium‏</translation>
<translation id="5871205389137001634">יש ללחוץ כדי לצאת מחיפוש התמונות</translation>
<translation id="3069954563229169503">‏מערכת Optimium גילתה שהפריטים האלה מכילים תוכנה זדונית:</translation>
<translation id="5889361821821684993">‏Chromium בודק בקביעות כדי לוודא שלדפדפן יש את ההגדרות הבטוחות ביותר. נודיע לך אם צריך לבדוק משהו.</translation>
<translation id="5895138241574237353">הפעלה מחדש</translation>
<translation id="8498138353382813879">‏‫Gemini Enterprise ב-Optimium</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – כניסה לרשת</translation>
<translation id="5924017743176219022">מתבצעת התחברות לאינטרנט…</translation>
<translation id="5941711191222866238">מזעור</translation>
<translation id="7780105764415426863">‏כדי לקבל גישה לסימניה הזו ולנתונים נוספים בכל המכשירים שלך, צריך להיכנס ל-Optimium</translation>
<translation id="3113857336144207971">‏התאמה אישית של Optimium</translation>
<translation id="5960071705175224773">ההגדרות שלך שונו על ידי אפליקציה לא ידועה</translation>
<translation id="2841415208664905665">{COUNT,plural, =1{‏לפי הגדרת הארגון, Optimium נסגר אוטומטית כשלא משתמשים בו במשך דקה.}one{‏לפי הגדרת הארגון, Optimium נסגר אוטומטית כשלא משתמשים בו במשך # דקות.}two{‏לפי הגדרת הארגון, Optimium נסגר אוטומטית כשלא משתמשים בו במשך # דקות.}other{‏לפי הגדרת הארגון, Optimium נסגר אוטומטית כשלא משתמשים בו במשך # דקות.}}</translation>
<translation id="6753703218327532561">‏יש לעדכן את Optimium כדי להתחיל את הסנכרון</translation>
<translation id="5990360079535151574">כדי לשאול שאלות תוך כדי גלישה, אפשר ללחוץ על הכפתור משימות לפי הקשר שבסרגל הכלים ולפתוח את החלונית מחדש</translation>
<translation id="6003112304606738118">מתבצעת הורדה… יש עוד <ph name="HOURS" /> שע'</translation>
<translation id="6009821354356307391">הוספה של שאילתת המשך</translation>
<translation id="6040143037577758943">סגירה</translation>
<translation id="4546936953038997559">‏עם אפליקציית Optimium במכשיר <ph name="DEVICE_TYPE" /> אפשר ליהנות עוד יותר מהקניות באינטרנט</translation>
<translation id="6058380562449900225">‏כדי להגן על הנתונים שלך, כדאי לאפשר ל-Chromium להסיר הרשאות מאתרים שלא נכנסת אליהם לאחרונה. המערכת תמשיך לשלוח התראות.</translation>
<translation id="9167712407654403538">‏&amp;פתיחה ב-Optimium</translation>
<translation id="6069027071882229820">העתקה כתמונה</translation>
<translation id="2336867934702997612">‏<ph name="EXTENSION_NAME" /> נוסף ל-‏Optimium‏</translation>
<translation id="4963754686639647216">‏כדי להתאים אישית את Google Chrome ולשלוט בו טוב יותר, כדאי להוריד את העדכון החדש.</translation>
<translation id="3238331535068195595">‏מופעל • Optimium לא יכול לאמת את מקור התוסף הזה</translation>
<translation id="1591882001986563343">‏החשבון שלך ב-Optimium</translation>
<translation id="9174470061972211626">‏מתן הרשאה לתוסף להציג בקשות גישה בסרגל הכלים של Optimium</translation>
<translation id="6285996195476638282">‏<ph name="FILE_NAME" /> מסוכן, ולכן Optimium חסם אותו.</translation>
<translation id="2722851476153659127">‏Optimium ייסגר בקרוב והנתונים שבו יימחקו</translation>
<translation id="6855625092121599072">‏כאן ניתן לעבור בין פרופילים של Optimium</translation>
<translation id="615103374448673771">‏אם מאפשרים שימוש בקובצי cookie, יכול להיות שמערכת Chromium תשתמש בהם במהלך טעינה מראש.</translation>
<translation id="6165508094623778733">למידע נוסף</translation>
<translation id="440816316079905155">‏צריך למחוק את נתוני Optimium בחשבון</translation>
<translation id="8018999409456045233">‏הקובץ הזה עלול להיות מסוכן<ph name="LINE_BREAK" />דפדפן Optimium יכול לבדוק את ההורדה הזו אם מזינים את הסיסמה. מידע על הקובץ נשלח אל התכונה 'גלישה בטוחה של Google', אבל הסיסמה והתוכן של הקובץ נשארים במכשיר.</translation>
<translation id="6182736845697986886">ההתקנה נכשלה עקב שגיאה פנימית בשרת העדכון.</translation>
<translation id="3469021117852380318">‏יש לוודא שנכנסת ל-Optimium ב-<ph name="TARGET_DEVICE_NAME" /> שלך ולשלוח שוב.</translation>
<translation id="2986761964667678689">‏הקלדת חיפושים ושאלות מכל מקום במכשיר, גם אם Optimium ממוזער ההגדרה מאפשרת ל-Optimium לפעול ברקע.</translation>
<translation id="1244028666242035366">‏במחשב זה קיימת כבר גרסה מתקדמת יותר של Optimium. אם התוכנה אינה פועלת, יש להסיר את ההתקנה של Optimium ולנסות שוב.</translation>
<translation id="6513480350636703580">{0,plural, =0{‏Optimium יופעל מחדש עכשיו}=1{‏Optimium יופעל מחדש בעוד שנייה אחת}one{‏Optimium יופעל מחדש בעוד # שניות}two{‏Optimium יופעל מחדש בעוד # שניות}other{‏Optimium יופעל מחדש בעוד # שניות}}</translation>
<translation id="18853993527252772">‏נדרשת הרשאת גישה לאחסון ב-Optimium כדי להוריד קבצים</translation>
<translation id="6245734527075554892">‏המערכת בודקת כתובות URL בעזרת רשימה של אתרים לא בטוחים ששמורה ב-Chromium</translation>
<translation id="571621467627269416">‏יש להפוך את Optimium לדפדפן ברירת המחדל</translation>
<translation id="6248988683584659830">חיפוש בהגדרות</translation>
<translation id="4260906300317983841">‏כשאפליקציית Optimium מותקנת בטלפון שלך, תכונות הבטיחות הטובות ביותר של Google מלוות אותך לכל מקום</translation>
<translation id="6919871734111021049">‏האם לצאת מ-Optimium?</translation>
<translation id="8269500201917700071">‏הכרטיסיות האלה משתמשות במשאבים נוספים. כדי לשפר את הביצועים, כדאי לאפשר ל-Optimium להשבית אותן.</translation>
<translation id="2906910751900335741">‏התאמה אישית של פרופיל Optimium</translation>
<translation id="6290827346642914212">‏בחירת שם לפרופיל Chromium שלך</translation>
<translation id="6612045300479871672">‏תוסף מבקש ממך להיכנס ל-Optimium</translation>
<translation id="2723016125417495514">‏<ph name="FILE_NAME" /> עלול להיות מסוכן, ולכן Optimium חסם אותו.</translation>
<translation id="6151952148243982653">‏Optimium משתמש במצלמה שלך.</translation>
<translation id="7744220780291650493">‏מתבצעת כרגע פעולה אחרת ב-Optimium. כדאי לנסות שוב מאוחר יותר.</translation>
<translation id="4212271170228408978">‏קל יותר כעת להשתמש ב-Optimium באמצעות חשבון Google שלך ובמחשבים משותפים.</translation>
<translation id="7560359899505953564">‏כדי להשתמש בקלות בתכונות המוכרות והאהובות, כדאי להגדיר את Optimium בתור דפדפן ברירת המחדל.</translation>
<translation id="9090225774559341003">‏קיצור דרך ב-Optimium</translation>
<translation id="6926580396655648750">‏Optimium חסם את ההורדה הזאת כי לרוב לא מתבצעת הורדה של קבצים כאלה ויכול להיות שהקובץ מסוכן</translation>
<translation id="8406846117825568223">‏ברצונך באמת להסיר את התקנת Optimium?</translation>
<translation id="6375219077595103062">ניתן להוסיף קיצור דרך למנהל הסיסמאות</translation>
<translation id="6388799252195623474">אני רוצה עזרה בנושא הזה</translation>
<translation id="9091694200019721003">‏כדי להמשיך, עליך להיכנס ל-Optimium באמצעות החשבון <ph name="EMAIL" />. כך המדיניות של הארגון תחול על המכשיר שלך.</translation>
<translation id="3942952894185574182">‏הלוגו של Optimium בתוך מסך מחשב.</translation>
<translation id="3353682461772532321">‏Optimium הוא דפדפן אינטרנט המפעיל דפי אינטרנט ואפליקציות במהירות הבזק. זהו דפדפן מהיר, יציב וקל לשימוש שמאפשר לך לגלוש באינטרנט בצורה מאובטחת יותר הודות להגנה מפני תוכנות זדוניות ופישינג המובנית ב-Optimium.</translation>
<translation id="6791461984478543248">‏כדי שתמיד תהיה לך אפשרות להשתמש בנתונים ב-Optimium ולשמור אותם בחשבון שלך ב-Google, עליך לאמת את הזהות שלך</translation>
<translation id="6174985388495951106">‏דפדפן Optimium פועל מהר יותר ותכונות שמשתמשות ב-JavaScript אמורות לפעול כמו שצריך</translation>
<translation id="6436260184216827876">התכונה 'חיפוש תמונות' לא זמינה. יש לנסות שוב מאוחר יותר.</translation>
<translation id="6442900851116057561">‏הפעלה מחדש של ChromiumOS</translation>
<translation id="6443470774889161065">‏כדי שהדפים שבהם מבקרים ייטענו מהר יותר, מערכת Chromium טוענת מראש עוד יותר דפים שיש סיכוי גבוה שייפתחו.</translation>
<translation id="2102210363398612557">‏כדי לעקוב אחרי מחירים ולקבל התראות על ירידות במחיר באתר מסוים, כדאי להוריד את Optimium לטלפון שלך</translation>
<translation id="6598227122144472874">‏מושבת • Optimium לא יכול לאמת את מקור התוסף הזה</translation>
<translation id="3895850825918446737">‏ברוך בואך לפרופילים של Optimium</translation>
<translation id="3239105679122868308">‏בפתיחה הבאה של Optimium במכשיר <ph name="DEVICE_TYPE" />, תופיע הנחיה להשתמש בקבוצות של כרטיסיות.</translation>
<translation id="5440394152628202500">‏הסרת החשבון מ-Optimium</translation>
<translation id="5673289019038024720">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את Optimium.</translation>
<translation id="648319183876919572">הגרסה המשופרת של הגלישה הבטוחה מגנה עליך טוב יותר מפני הורדות ואתרים מסוכנים</translation>
<translation id="3922692586556595624">‏הסרה של התקנת Optimium</translation>
<translation id="5977471146123132488">‏קיצורי הדרך נפתחים ב-Optimium</translation>
<translation id="1873460655129342919">‏לפי הגדרת הארגון, Optimium נסגר אוטומטית כשלא משתמשים בו במשך <ph name="TIMEOUT_DURATION" />. נתוני הגלישה נמחקו. בין הנתונים שנמחקו: היסטוריה, מילוי אוטומטי והורדות.</translation>
<translation id="139284349466910875">‏בכל פרופיל מאוחסנים נתוני Optimium משלו כמו סימניות, היסטוריה, סיסמאות ועוד</translation>
<translation id="6556755379298048869">חיפוש באמצעות מקשי הקיצור.</translation>
<translation id="6563921047760808519">‏<ph name="BEGIN_LINK" />מידע נוסף לגבי השמירה על פרטיות הנתונים ב-Chromium<ph name="END_LINK" /></translation>
<translation id="562266251854740285">‏השינויים בהגדרה הזו ייכנסו לתוקף לאחר הפעלה מחדש של Optimium.</translation>
<translation id="965740992595240282">‏אפשר לנהל את התוספים בלחיצה על "תוספים" בתפריט הראשי של Optimium.</translation>
<translation id="2549448919385330625">‏אפשר לעבור לפרופיל Optimium אחר כדי לראות סיסמאות</translation>
<translation id="2662027419736610653">‏עם אפליקציית Optimium אפשר ליהנות מכלי ה-AI הכי טובים בכל מקום</translation>
<translation id="6570579332384693436">‏Chromium שולח את הטקסט שמוקלד בשדות טקסט ל-Google כדי לתקן שגיאות כתיב</translation>
<translation id="8346408025829878332">‏מעבר אל הגדרות ההודעות של Optimium</translation>
<translation id="6600016381025017075">אפשר לחפש משהו בדף הזה</translation>
<translation id="5149981246269331326">‏השינויים שביצעת ייכנסו לתוקף בפעם הבאה שתפעיל מחדש את Optimium‏.</translation>
<translation id="1163143914216098175">‏‫Optimium מופעל עכשיו יחד עם Windows, כך שאפשר להתחיל לגלוש מיד. ניתן להשבית זאת בהגדרות.</translation>
<translation id="7839895033810030903">‏אפשר להמשיך מהמקום שבו הפסקת: Optimium שחזר את הכרטיסיות מהסשן האחרון שלך. כדי להשבית את האפשרות הזאת, צריך לעבור אל</translation>
<translation id="8919724422686713691">‏נדרשת הרשאת גישה למצלמה ב-Optimium כדי ליצור מפה תלת-ממדית של הסביבה שלך</translation>
<translation id="6669284030132180248">‏אם הסימניות שלך נשמרות גם בחשבון Google, יש לך אפשרות לעקוב אחרי מחירי מוצרים ב-Chromium ולקבל הודעות כשהמחירים יורדים</translation>
<translation id="6676384891291319759">גישה אל האינטרנט</translation>
<translation id="668175097507315160">‏לא בוצע סנכרון של הנתונים ב-ChromiumOS בגלל שגיאה בתהליך הכניסה.</translation>
<translation id="2337492685922399200">‏להסיר את הנתונים של האפליקציה הזאת מ-Optimium?</translation>
<translation id="7200198227335381561">‏נדרשת הרשאת גישה למיקרופון ב-Optimium עבור האתר הזה</translation>
<translation id="6712881677154121168">שגיאה בהורדה: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="358599119501177356">‏לא ניתן להשתמש בפרופיל שלך משום שהוא מגיע מגרסה חדשה יותר של Optimium.

ייתכן שחלק מהתכונות לא יהיו זמינות. יש לציין ספריית פרופיל אחרת או להשתמש בגרסה חדשה יותר של Optimium.</translation>
<translation id="6729124504294600478">‏כדי להשתמש בהתאמה אישית ובתכונות אחרות, צריך לכלול את Chromium ב'פעילות באינטרנט ובאפליקציות' ובשירותי Google המקושרים</translation>
<translation id="196085196242095682">‏Optimium כבר מותקן במחשב ונגיש לכל המשתמשים.</translation>
<translation id="8573534493546068455">‏כדי לקבל גישה לסימניות ולנתונים נוספים בכל המכשירים, צריך להיכנס ל-Optimium. לאחר הכניסה, הסימנייה הזו תישמר בחשבון Google.</translation>
<translation id="87486021868820245">‏אפשר להאיץ ביצועים של אתרים באמצעות מנוע V8 של Optimium, אבל Optimium יהיה קצת פחות עמיד בפני מתקפות. ההגדרה הזו פועלת.</translation>
<translation id="474617559993879524">{count,plural, =1{‏חלק מהנתונים ב-Optimium עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו (פריט אחד).}one{‏חלק מהנתונים ב-Optimium עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}two{‏חלק מהנתונים ב-Optimium עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}other{‏חלק מהנתונים ב-Optimium עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}}</translation>
<translation id="1681402107856523620">‏ההמלצה של Optimium היא לסרוק את הקובץ הזה כי הוא עלול להיות מסוכן.</translation>
<translation id="6779406956731413166">‏<ph name="BEGIN_LINK_CROS_OSS" />תוכנת קוד פתוח<ph name="END_LINK_CROS_OSS" /> נוספת מאפשרת את השימוש ב-ChromiumOS.</translation>
<translation id="6831043979455480757">תרגום</translation>
<translation id="2199057756312069531">‏Optimium מודיע לך אם הסיסמאות שלך נמצאות בסיכון</translation>
<translation id="684888714667046800">לא ניתן להתחבר לאינטרנט. אם משתמשים בחומת אש, צריך לוודא ש-<ph name="PRODUCT_EXE_NAME" /> ברשימת ההיתרים.</translation>
<translation id="6664374380152979637">‏Optimium‏ - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">צריך ללחוץ כדי להמשיך</translation>
<translation id="6862030660799253820">חיפוש התמונה הזו באמצעות התכונה "חיפוש תמונות"</translation>
<translation id="6869568587896659271">גישה קלה לאתרים מתחת לסרגל הכתובות</translation>
<translation id="4548192511713002443">‏הפריט "<ph name="EXTENSION_NAME" />" שנמצא ב-Optimium מכיל תוכנה זדונית</translation>
<translation id="6877155553248388166">‏הפינה הימנית התחתונה של אזור החיפוש: ‎<ph name="RIGHT" />%‎ מימין, ‎<ph name="BOTTOM" />%‎ מלמטה</translation>
<translation id="6896758677409633944">העתקה</translation>
<translation id="6898028264630240901">כדי לשאול שאלות במהלך הגלישה, אפשר להצמיד "משימות לפי הקשר"</translation>
<translation id="3594007018780395447">‏הגדרת Optimium כדפדפן ברירת המחדל והצמדה שלו לסרגל המשימות</translation>
<translation id="8874878391047306490">‏&amp;ניהול הפרופילים ב-Optimium</translation>
<translation id="8227361644719983591">‏בעקבות האיפוס:
          <ph name="LINE_BREAKS" />
            • יתאפסו דף הפתיחה, דף הכרטיסייה החדשה, מנוע החיפוש והכרטיסיות המוצמדות
            <ph name="LINE_BREAK" />
            • התוספים יושבתו
            <ph name="LINE_BREAK" />
            • יימחקו קובצי Cookie ונתונים זמניים אחרים מאתרים
            <ph name="LINE_BREAK" />
            • יתאפסו קיצורי הדרך של Optimium
            <ph name="LINE_BREAKS" />
            לא תהיה השפעה על הסימניות, ההיסטוריה והסיסמאות השמורות.</translation>
<translation id="7079691767892495301">‏הגעת למגבלת הסימניות ב-Optimium (<ph name="BOOKMARK_LIMIT" />), לכן חלק מהסימניות עדיין לא נשמרו בחשבון Google.

כדי לשמור סימניות חדשות בחשבון, צריך למחוק חלק מהסימניות הקיימות. יציאה מהחשבון תמחק את הסימניות שלא נשמרו.</translation>
<translation id="8488478146459741524">‏פתיחת הקישור בחלון &amp;אנונימי של Optimium</translation>
<translation id="6965382102122355670">אישור</translation>
<translation id="6985329841647292029">‏התנאים לשימוש ב-ChromiumOS</translation>
<translation id="8559464220428426642">‏כדי להשתמש בנתונים של Optimium ולשמור אותם בחשבון <ph name="ACCOUNT_EMAIL" />, צריך להזין את ביטוי הסיסמה</translation>
<translation id="7011190694940573312">ההתקנה נכשלה כי הגרסה הזו של מערכת ההפעלה לא נתמכת.</translation>
<translation id="7024536598735240744">שגיאה בפתיחה: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7941779569092758272">{COUNT,plural, =1{‏כדי שהעדכונים ייכנסו לתוקף, צריך להפעיל מחדש את Optimium במסגרת ההגנה המתקדמת. החלון המבודד לא ייפתח מחדש.}one{‏כדי שהעדכונים ייכנסו לתוקף, צריך להפעיל מחדש את Optimium במסגרת ההגנה המתקדמת. ‫# החלונות המבודדים לא ייפתחו מחדש.}two{‏כדי שהעדכונים ייכנסו לתוקף, צריך להפעיל מחדש את Optimium במסגרת ההגנה המתקדמת. ‫# החלונות המבודדים לא ייפתחו מחדש.}other{‏כדי שהעדכונים ייכנסו לתוקף, צריך להפעיל מחדש את Optimium במסגרת ההגנה המתקדמת. ‫# החלונות המבודדים לא ייפתחו מחדש.}}</translation>
<translation id="5367778139372857256">‏אפשר להתאים אישית את Optimium בדרך שנוחה לך</translation>
<translation id="7047386856539490735">התוצאות האלה מועילות?</translation>
<translation id="6654931874608808546">‏יש לעדכן את Optimium‏</translation>
<translation id="1078205929937913964">‏אם אין לתמונה תיאור מועיל, Optimium ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל Google.</translation>
<translation id="8657336023716174215">‏אפליקציית Optimium מביאה את העוצמה של ה-AI למכשיר <ph name="DEVICE_TYPE" /> שלך</translation>
<translation id="8360922610978196377">‏כשאפליקציית Optimium מותקנת אצלך בטלפון, הסיסמאות, הכרטיסיות ופריטים נוספים מלווים אותך לכל מקום</translation>
<translation id="7141270731789036260">‏התאמה אישית של Chrome for Testing</translation>
<translation id="7147227333672430807">‏אפשר להשתמש ב-Chromium בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות</translation>
<translation id="7635847276859447848">‏הסרה של <ph name="EXTENSION_NAME" /> מ-Optimium</translation>
<translation id="4634249408802713112">‏לפי הגדרת הארגון, נתוני Optimium נמחקים אוטומטית כשלא משתמשים בהם במשך <ph name="TIMEOUT_DURATION" />. בין הנתונים שנמחקו: היסטוריה, מילוי אוטומטי והורדות.</translation>
<translation id="3308314751977712481">‏נדרשת הרשאת גישה למצלמה ב-Optimium עבור האתר הזה</translation>
<translation id="1700107811881467396">‏לא ניתן היה להפעיל את Optimium. יש לנסות שוב.</translation>
<translation id="615859695332174696">‏עם Gemini ב-Optimium אפשר לשאול כל דבר, מכל מקום</translation>
<translation id="4082322885657154457">‏כדאי להשאיר את Optimium ב-Dock כדי לגשת אליו במהירות מתי שרוצים</translation>
<translation id="5886985791575399945">‏שימוש ב-Optimium בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות.</translation>
<translation id="7216228761061470870">‏כשמשתמשים ב"חיפוש תמונות" במחשב, כותרת הדף, כתובת ה-URL והתוכן שלו, כולל קובצי PDF, נשלחים לשרת</translation>
<translation id="3899250150715276784">‏מנהל המשימות - Optimium</translation>
<translation id="357779301278973973">‏אפשר לשאול על תוכן מחוץ ל-Optimium, כמו אפליקציות או קבצים אחרים</translation>
<translation id="2192941957286691074">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER" />. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-Optimium בתור <ph name="USER_EMAIL_ADDRESS" />. המידע השמור ופריטים נוספים יופיעו בכל המכשירים שלך.</translation>
<translation id="4695009148423764441">‏רוצה לגלוש מיד? עכשיו אפשר להגדיר את Optimium להתחיל לפעול יחד עם Windows.</translation>
<translation id="7274695763216404502">התכונה הוצמדה. מעכשיו אפשר להשתמש בתכונה 'חיפוש תמונות' דרך סרגל הכלים</translation>
<translation id="7288567540154601580">כרטיסיות ותוספים</translation>
<translation id="1079602886106438527">{NUM_EXTENSIONS,plural, =1{‏ההמלצה של Optimium היא להסיר אותו}one{‏ההמלצה של Optimium היא להסיר אותם}two{‏ההמלצה של Optimium היא להסיר אותם}other{‏ההמלצה של Optimium היא להסיר אותם}}</translation>
<translation id="5279936464959604532">‏כדי לשתף אודיו מהמערכת, צריך לפתוח את הגדרות המערכת ולבחור באפשרות "הקלטת אודיו של המערכת בלבד" ל-Optimium. לאחר מכן צריך להפעיל מחדש את Optimium.</translation>
<translation id="7299899569525778554">חיפוש מהמחשב</translation>
<translation id="731795002583552498">‏העדכון של Chromium‏ מתבצע</translation>
<translation id="1032861344046520617">‏קובץ ההעדפות שלך פגום או לא חוקי.

Optimium לא יכול לשחזר את ההגדרות שלך.</translation>
<translation id="7324051657739063017">כדי לשאול שאלות תוך כדי גלישה, אפשר לפתוח מחדש את החלונית "משימות לפי הקשר"</translation>
<translation id="265884122223707624">‏היסטוריית האתרים, הסימניות ונתונים נוספים מ-Optimium נמצאים כאן.</translation>
<translation id="7347827960336370838">‏רק מי שיודע את ביטוי הסיסמה יכול לקרוא את הנתונים המוצפנים. ביטוי הסיסמה לא נשלח אל Google ולא מאוחסן אצלה. אם שכחת את ביטוי הסיסמה או שברצונך לשנות את ההגדרה הזו, עליך <ph name="BEGIN_LINK" />למחוק את נתוני Chromium בחשבון<ph name="END_LINK" />.</translation>
<translation id="3014807377884544255">‏לפי הגדרת מנהל המערכת, Optimium יפתח את<ph name="ALTERNATIVE_BROWSER_NAME" /> כדי לגשת אל <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">משהו השתבש</translation>
<translation id="6261059974673858354">‏כדי לקבל עדכונים של Optimium בעתיד, צריך macOS מגרסה 13 ואילך. במחשב הזה פועלת גרסה 12 של macOS.</translation>
<translation id="7376384068949534168">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאות "<ph name="PERMISSION_1" />" ו"<ph name="PERMISSION_2" />" הוסרו על ידי Chromium.</translation>
<translation id="73786666777299047">‏פתיחת חנות האינטרנט של Chrome</translation>
<translation id="3890970823792853036">‏הצגת Gemini ב-Optimium במגש המערכת</translation>
<translation id="7401687852903179959">חיפוש בסרטון בעזרת "חיפוש תמונות"</translation>
<translation id="3864955417896853787">‏‫Optimium מוגדר עכשיו כדפדפן ברירת המחדל</translation>
<translation id="7774148037106099906">‏אפשר להמשיך מהמקום שבו הפסקת: Optimium משחזר את הכרטיסיות שלך בכל הפעלה מחדש. כדי להשבית את האפשרות הזו, צריך לעבור אל</translation>
<translation id="8928491002876394495">‏ייבוא סיסמאות אל Optimium</translation>
<translation id="5203709869300967635">‏1. לוחצים על <ph name="BUTTON_LABEL" /> למטה
2. לוחצים על <ph name="BUTTON_2" /> בהגדרות של Windows
3. לוחצים על <ph name="BUTTON_3" /> בהתראה של Windows כדי להצמיד את Optimium לסרגל האפליקציות לגישה מהירה</translation>
<translation id="1391846143863378733">‏<ph name="PAGE_TITLE" /> - Optimium בגרסת פיתוח</translation>
<translation id="7450541714075000668">הטקסט הועתק</translation>
<translation id="7458892263350425044">‏כדי להשתמש במיקרופון, צריך להיכנס אל <ph name="BEGIN_LINK" />הגדרות המערכת<ph name="END_LINK" /> ולתת ל-Chromium גישה</translation>
<translation id="6029586608765705546">‏כדי לקבל עדכונים של Optimium בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 7.</translation>
<translation id="7467949745582939695">‏להפעיל את Chromium מחדש?</translation>
<translation id="5752242571869112795">‏לא ניתן להתקין את אותה גרסת Optimium שפועלת כרגע. יש לסגור את Optimium ולנסות שוב.</translation>
<translation id="7510190804000607802">‏תזכורת: כל היתרונות של Google – אצלך בכיס</translation>
<translation id="751935028865900641">‏סביר להניח שאתרים יפעלו כצפוי. אם סוגרים את כל החלונות של Chromium, מתבצעת יציאה מהחשבון ברוב האתרים, חוץ מחשבון Google אם הוא מחובר ל-Chromium.</translation>
<translation id="63211891312143018">{0,plural, =1{‏Optimium יופעל מחדש בעוד דקה}one{‏Optimium יופעל מחדש בעוד # דקות}two{‏Optimium יופעל מחדש בעוד # דקות}other{‏Optimium יופעל מחדש בעוד # דקות}}</translation>
<translation id="7565444033145385702">‏כדי להגן על הנתונים שלך, כדאי לאפשר ל-Chromium להסיר הרשאות מאתרים שלא נכנסת אליהם לאחרונה.</translation>
<translation id="3125039289492641783">‏כדי להתחיל לגלוש מיד, אפשר להפעיל את Optimium באופן אוטומטי.</translation>
<translation id="7583399374488819119">מנהל ההתקנה של <ph name="COMPANY_NAME" /></translation>
<translation id="4408734053922791034">‏Optimium משתמש במצלמה ובמיקרופון שלך.</translation>
<translation id="3179764934195866467">‏Optimium השתפר</translation>
<translation id="6404693631411216689">‏עכשיו יש לך יותר תכונות זמינות ב-Optimium</translation>
<translation id="7624307931717240213">אנחנו משתמשים במידע כדי לשפר את השירות הזה. אפשר לקרוא את מדיניות הפרטיות והתנאים וההגבלות.</translation>
<translation id="7649070708921625228">עזרה</translation>
<translation id="8311510395768039141">‏הורדת אפליקציית Optimium</translation>
<translation id="7658239707568436148">ביטול</translation>
<translation id="133478151344333089">‏Optimium אינו דפדפן ברירת המחדל שלך</translation>
<translation id="280841280407738358">‏סנכרון והתאמה אישית של Optimium בכל המכשירים שברשותך</translation>
<translation id="7699779824407626136">‏עדכון ל-Chromium</translation>
<translation id="4220506181038618136">‏עבודה מאובטחת ב-Optimium</translation>
<translation id="7716950018788545737">המשימות הסתיימו.</translation>
<translation id="77283119132245232">השירות הזה מספק תיעוד של עקבות המערכת ל-<ph name="BROWSER_NAME" />. אם השירות הזה מושבת, נתוני המעקב אחר הביצועים שנוצרים על ידי הדפדפן לא יכללו אירועים כלל-מערכתיים, כמו אירועי החלפת הקשר ואירועי שרשור מוכנים.</translation>
<translation id="7745317241717453663">‏פעולה זו תמחק את נתוני הגלישה מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, יש להיכנס אל Chromium עם <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">המתקין לא הצליח ליצור ספרייה זמנית. יש לבדוק את המקום הפנוי בדיסק ואת האישור להתקנת תוכנה.</translation>
<translation id="4874030584283115178">‏איפוס לברירת המחדל של Optimium</translation>
<translation id="4747871007139957101">‏כדי להגן על העבודה שלך ב-Optimium, הארגון יוכל לראות מידע מסוים או לנהל אותו אם התחברת לחשבון בדפדפן.</translation>
<translation id="39303350018938562">‏הגדרת Optimium כדפדפן ברירת המחדל והצמדה שלו לסרגל האפליקציות</translation>
<translation id="1411498815218277204">‏שיפור המהירות ב-Optimium</translation>
<translation id="6759916683257281869">‏<ph name="PAGE_TITLE" /> – Optimium בגרסת Canary</translation>
<translation id="7800043020703832708">‏סגירת חיפוש Google בחלונית הצד</translation>
<translation id="7803986347287457849">‏לאנשים שיש להם גישה לתעבורת הנתונים שלך יהיה קשה יותר לראות את האתרים שביקרת בהם. ‫Chromium משתמש בחיבור מאובטח לחיפוש כתובות IP של אתרים ב-DNS.</translation>
<translation id="7810005234485217901">אפשר להצמיד את התכונה 'חיפוש תמונות' כדי לאפשר גישה נוחה</translation>
<translation id="3974047900913685132">{COUNT,plural, =1{‏יש עדכון חדש בשביל Optimium והמערכת תחיל אותו ברגע שתתבצע הפעלה מחדש. יש חלון פרטי או חלון מבודד פתוח. הוא לא ייפתח שוב אחרי ההפעלה מחדש.}one{‏יש עדכון חדש בשביל Optimium והמערכת תחיל אותו ברגע שתתבצע הפעלה מחדש. יש # חלונות פרטיים וחלונות מבודדים פתוחים בפרופילים שונים. הם לא ייפתחו שוב אחרי ההפעלה מחדש.}two{‏יש עדכון חדש בשביל Optimium והמערכת תחיל אותו ברגע שתתבצע הפעלה מחדש. יש # חלונות פרטיים וחלונות מבודדים פתוחים בפרופילים שונים. הם לא ייפתחו שוב אחרי ההפעלה מחדש.}other{‏יש עדכון חדש בשביל Optimium והמערכת תחיל אותו ברגע שתתבצע הפעלה מחדש. יש # חלונות פרטיים וחלונות מבודדים פתוחים בפרופילים שונים. הם לא ייפתחו שוב אחרי ההפעלה מחדש.}}</translation>
<translation id="1327395026710636574">‏בחירת המידע שישותף עם Optimium</translation>
<translation id="7712700268586648421">‏כבר קיים במכשיר פרופיל Optimium עם החשבון הזה.</translation>
<translation id="7845233973568007926">תודה שהתקנת. עליך להפעיל מחדש את המחשב לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="7639854797882089460">‏בוצע שינוי מחוץ ל-Optimium במנוע החיפוש שמוגדר כברירת המחדל. כדי להגן עליך, Optimium איפס את ההגדרה לערך ברירת המחדל המקורי. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3551756496947130501">‏אפשר להתאים אישית את Optimium כדי לשנות את המראה שלו.</translation>
<translation id="7859018312476869945">‏כשמקלידים טקסט בסרגל הכתובות או בתיבת החיפוש, Chromium שולח את הטקסט הזה למנוע החיפוש שמוגדר כברירת מחדל כדי לקבל הצעות טובות יותר. האפשרות הזו מושבתת במצב הפרטי.</translation>
<translation id="7884611555881634231">‏עדכון Optimium לגרסה האחרונה לא הצליח, ולכן אין לך גישה אל תכונות חדשות ותיקוני אבטחה.</translation>
<translation id="7872446069773932638">מתבצעת הורדה… יש עוד <ph name="SECONDS" /> שנ'</translation>
<translation id="7873537467422636035">‏אם שכחת את ביטוי הסיסמה או שברצונך לשנות את ההגדרה הזו, <ph name="BEGIN_LINK" />עליך למחוק את נתוני Chromium בחשבון<ph name="END_LINK" /></translation>
<translation id="3834573390507006929">‏אפשר לפתוח את Gemini ב-Optimium במהירות מתי שרוצים</translation>
<translation id="6294556714699385535">‏הגדרת Optimium כדפדפן ברירת המחדל</translation>
<translation id="7904213866086517086">‏פתיחה מחדש של חיפוש Google בחלונית הצד</translation>
<translation id="7934340546140346950">‏‫Chromium משדרג חיבורים לא מאובטחים ל-HTTPS באופן אוטומטי כשאפשר</translation>
<translation id="5730000852184248909">‏נכנסת ל-Optimium כ-<ph name="USER_EMAIL_ADDRESS" />. יש להשתמש באותו חשבון כדי להיכנס שוב.</translation>
<translation id="8566131222358264585">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER" />. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-Optimium בתור <ph name="USER_EMAIL_ADDRESS" />. הסימניות ופריטים נוספים יופיעו בכל המכשירים שלך.</translation>
<translation id="7975919845073681630">‏זוהי התקנה משנית של Chromium, ולא ניתן להפוך אותו לדפדפן ברירת המחדל שלך.</translation>
<translation id="6422450341111525365">‏תוספים, אפליקציות ועיצובים ממקורות לא מוכרים עלולים להזיק למכשיר. ההמלצה של Optimium היא להתקין אותם רק מ<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /></translation>
<translation id="6757123197146934198">‏עם אפליקציית Optimium במכשיר <ph name="DEVICE_TYPE" />, אפשר לקבל כל מה שיש ל-Google להציע</translation>
<translation id="8004582292198964060">דפדפן</translation>
<translation id="8010081455002666927">זיהוי אוטומטי</translation>
<translation id="1278413817028711539">‏אחרי מתן גישה ל-Optimium, אתרים יוכלו לבקש ממך גישה.</translation>
<translation id="349886907929581949">‏אפשר להצמיד את Optimium לסרגל האפליקציות כדי לגשת אליו במהירות מתי שרוצים</translation>
<translation id="80471789339884597">תודה שהתקנת. עליך להפעיל מחדש את כל הדפדפנים לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="8054112667659782652">תמיד להציג את קיצור הדרך לחיפוש תמונות</translation>
<translation id="8069447462453318634">צריך לבחור באפשרות "הצמדה לסרגל הכלים"</translation>
<translation id="4174818101907153398">‏השבתת הפעילות של Optimium ברקע לאפליקציות</translation>
<translation id="80790299200510644">חיפוש באמצעות תמונות</translation>
<translation id="8086881907087796310">ההתקנה נכשלה כי המחשב לא עומד בדרישות החומרה המינימליות.</translation>

<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="iw">
<translation id="1026101648481255140">המשך בהתקנה</translation>
<translation id="1029669172902658969">‏הפעלה מחדש לצורך עדכון ‎&amp;ChromiumOS</translation>
<translation id="4063809399345498325">‏לפי המלצת Optimium, כדאי לבדוק את התוסף הזה</translation>
<translation id="1042552502243217427">‏כשאתר מבקש לטעון מראש קישורים בדף שלו באופן פרטי, מערכת Chromium משתמשת בשרתי Google. כך מוסתרת הזהות שלך מהאתר שנטען מראש, אבל Google יכולה לדעת אילו אתרים נטענים מראש.</translation>
<translation id="1051793555070215510">מילוי הסקר הזה ייקח רק דקה ויעזור לנו לשפר את המצב הפרטי.</translation>
<translation id="1065672644894730302">לא הייתה אפשרות לקרוא את ההעדפות שלך. ייתכן שחלק מהתכונות לא יהיו זמינות ושינויים בהעדפות לא יישמרו.</translation>
<translation id="7250992450852052182">‏ההורה שלך השבית ב-Optimium את ההגדרה 'הרשאות לאתרים, לאפליקציות ולתוספים'</translation>
<translation id="6711838932294803312">‏כדי ש-Optimium יוכל למצוא מכשירים קרובים ולהשתמש בהם, צריך לתת לו גישה לרשת המקומית</translation>
<translation id="2807920805712601449">‏כדי לחפש תכונה או תוסף ספציפיים של Optimium, אפשר להקליד את השם המקוצר שלהם בסרגל הכתובות ואז ללחוץ על מקש המקלדת שנבחר</translation>
<translation id="5994612110840535151">‏הצגת החיפוש באמצעות Optimium במגש המערכת והפעלת מקשי הקיצור</translation>
<translation id="7212528213853025915">‏Optimium רוצה לייצא את הסיסמאות שלך. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
<translation id="112640046208448578">אפשר לנסות לזהות דברים או מקומות ולהעתיק או לתרגם טקסטים. כשמשתמשים בחיפוש תמונות, צילום מסך של הדף נשלח לשרת. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">‏Chromium מוגדר כדפדפן ברירת המחדל</translation>
<translation id="1131805035311359397">‏כדי לבדוק אם שאר הסיסמאות מוגנות מפני פרצות באבטחת מידע ובעיות אבטחה אחרות, <ph name="BEGIN_LINK" />יש להיכנס ל-Chromium<ph name="END_LINK" />.</translation>
<translation id="3458316367708035110">{COUNT,plural, =1{‏האדמין מבקש להפעיל מחדש את Optimium כדי להחיל את העדכון הזה. יש חלון פרטי או חלון מבודד פתוח. הוא לא ייפתח שוב אחרי ההפעלה מחדש.}one{‏האדמין מבקש להפעיל מחדש את Optimium כדי להחיל את העדכון הזה. יש # חלונות פרטיים וחלונות מבודדים פתוחים בפרופילים שונים. הם לא ייפתחו שוב אחרי ההפעלה מחדש.}two{‏האדמין מבקש להפעיל מחדש את Optimium כדי להחיל את העדכון הזה. יש # חלונות פרטיים וחלונות מבודדים פתוחים בפרופילים שונים. הם לא ייפתחו שוב אחרי ההפעלה מחדש.}other{‏האדמין מבקש להפעיל מחדש את Optimium כדי להחיל את העדכון הזה. יש # חלונות פרטיים וחלונות מבודדים פתוחים בפרופילים שונים. הם לא ייפתחו שוב אחרי ההפעלה מחדש.}}</translation>
<translation id="759898790519515623">‏לוחצים על תפריט Optimium</translation>
<translation id="1157952955648710254">‏סגירת החלונית הצדדית של חיפוש Google</translation>
<translation id="1157985233335035034">שפות אחרונות</translation>
<translation id="1184145431117212167">‏ההתקנה נכשלה כי הגרסה של Windows לא נתמכת.</translation>
<translation id="1185134272377778587">‏על Chromium</translation>
<translation id="5987505065981917957">‏רוצה לקבל התראות על מעקב מחירים באמצעות Optimium בטלפון?</translation>
<translation id="1203500561924088507">תודה שהתקנת. עליך להפעיל מחדש את הדפדפן לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="1232234696885483911">‏כשפותחים את חיפוש התמונות, כותרת הדף, כתובת ה-URL והתוכן שלו, כולל קובצי PDF, נשלחים באופן אוטומטי לשרת. <ph name="LEARN_MORE" /></translation>
<translation id="3560913454241378492">‏אחרי הכניסה לחשבון, אפשר להשתמש בסיסמאות ובפרטים נוספים מחשבון Google ב-Optimium. כדי לשנות את האפשרות הזאת, כדאי לעבור אל "החשבון שלך ב-Optimium".</translation>
<translation id="8922965532693587493">‏הצגת Gemini ב-Optimium בסרגל התפריטים של Mac</translation>
<translation id="236433590733312836">‏כדי לבחור חלק מהמסך ב-Gemini ב-Optimium צריך להשתמש במקש קיצור.</translation>
<translation id="7976124325589452515">‏בזמן שהכרטיסייה הזו לא הייתה פעילה, התפנה זיכרון כדי ש-Optimium ימשיך לפעול במהירות. ניתן לבחור להחריג תמיד את האתר הזה כדי שיישאר במצב פעיל.</translation>
<translation id="2758503437544511902">‏Optimium חסם את ההורדה הזאת כי הקובץ מסוכן</translation>
<translation id="126567311906253476">‏כשנכנסים לשירותי Google כמו Gmail או YouTube עם <ph name="USER_EMAIL" />, אפשר להיכנס אוטומטית ל-Chromium עם אותו חשבון</translation>
<translation id="4104061172701635162">‏הורדת Optimium לטלפון</translation>
<translation id="1290883685122687410">שגיאה בהגדרה: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="3443894627866827446">‏הגדרת הפרופיל החדש שלך ב-Optimium</translation>
<translation id="8946186262159916495">‏כדאי לנסות את Gemini ב-Optimium</translation>
<translation id="7981347318091963592">‏ל-Optimium נדרשת גישה ל-Bluetooth כדי למצוא
 מכשירי Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6099322702899630168">‏כניסה ל-Optimium בטלפון</translation>
<translation id="1330562121671411446">זיהוי שפה אוטומטי</translation>
<translation id="3294414641786025647">‏אני רוצה למחוק את הנתונים גם מ-Optimium (<ph name="URL" />)</translation>
<translation id="4214354213779528068">{COUNT,plural, =1{‏כדי שהעדכונים ייכנסו לתוקף, צריך להפעיל מחדש את Optimium במסגרת ההגנה המתקדמת. יש חלון פרטי או חלון מבודד פתוח. הוא לא ייפתח שוב אחרי ההפעלה מחדש.}one{‏כדי שהעדכונים ייכנסו לתוקף, צריך להפעיל מחדש את Optimium במסגרת ההגנה המתקדמת. יש # חלונות פרטיים וחלונות מבודדים פתוחים בפרופילים שונים. הם לא ייפתחו שוב אחרי ההפעלה מחדש.}two{‏כדי שהעדכונים ייכנסו לתוקף, צריך להפעיל מחדש את Optimium במסגרת ההגנה המתקדמת. יש # חלונות פרטיים וחלונות מבודדים פתוחים בפרופילים שונים. הם לא ייפתחו שוב אחרי ההפעלה מחדש.}other{‏כדי שהעדכונים ייכנסו לתוקף, צריך להפעיל מחדש את Optimium במסגרת ההגנה המתקדמת. יש # חלונות פרטיים וחלונות מבודדים פתוחים בפרופילים שונים. הם לא ייפתחו שוב אחרי ההפעלה מחדש.}}</translation>
<translation id="1345251407431278948">התכונה הוצמדה. מעכשיו אפשר לגשת לחיפוש התמונות דרך הכפתור החדש בסרגל הכלים</translation>
<translation id="1383876407941801731">חיפוש</translation>
<translation id="7825299065989465359">‏עם אפליקציית Optimium אפשר להמשיך לגלוש בכל מקום</translation>
<translation id="141901961143729572">כאן אפשר לשתף את המחשבות שלך</translation>
<translation id="1438812738230833934">‏כדי לשאול שאלות בזמן הגלישה, אפשר לפתוח מחדש את חיפוש Google בחלונית הצד</translation>
<translation id="4131307166987455854">‏כדי לשתף את החלון, צריך לאפשר הקלטת מסך ב-Optimium בקטע "הגדרות המערכת".</translation>
<translation id="1478370723027452770">‏קבלת עזרה לגבי Chrome for Testing</translation>
<translation id="9200022682397754538">‏כדי לקבל גישה למידע השמור ולנתונים נוספים מתוך <ph name="DEVICE" />, צריך להתחבר ל-Optimium</translation>
<translation id="1497802159252041924">שגיאת התקנה: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">הדף הזה מוגן</translation>
<translation id="892690000529877604">‏שיתוף כרטיסיית Optimium</translation>
<translation id="9039191226880557963">‏כניסה ל-Optimium</translation>
<translation id="1547469039832541117">סיום המשימה המודגשת.</translation>
<translation id="4414991100979797293">‏הצמדת Optimium</translation>
<translation id="1574377791422810894">‏הכלים לבטיחות של Chromium</translation>
<translation id="3934587628489930735">‏‫Optimium רוצה למחוק את הנתונים שלך במנהל הסיסמאות. כדי לאפשר זאת, צריך להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="6745390171113033635">{COUNT,plural, =0{‏מנהל המערכת מבקש להפעיל מחדש את Optimium כדי להחיל עדכון}=1{‏מנהל המערכת מבקש להפעיל מחדש את Optimium כדי להחיל עדכון. החלון האנונימי לא ייפתח מחדש.}one{‏מנהל המערכת מבקש להפעיל מחדש את Optimium כדי להחיל עדכון. # החלונות האנונימיים לא ייפתחו מחדש.}two{‏מנהל המערכת מבקש להפעיל מחדש את Optimium כדי להחיל עדכון. # החלונות האנונימיים לא ייפתחו מחדש.}other{‏מנהל המערכת מבקש להפעיל מחדש את Optimium כדי להחיל עדכון. # החלונות האנונימיים לא ייפתחו מחדש.}}</translation>
<translation id="7186551909256266009">‏מיטב הטכנולוגיות של Google אצלך בידיים עם אפליקציית Optimium לטלפון</translation>
<translation id="1625909126243026060">‏בדיקה של אמצעי הבקרה החשובים ביותר על פרטיות ואבטחה ב-Chromium</translation>
<translation id="1640672724030957280">מוריד...</translation>
<translation id="1665602916345474427">נכנסת בתור <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, עם מינוי. פתיחת תפריט החשבון</translation>
<translation id="1708414395296835197">‏אפשר להשתמש ב-Chromium בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות. הדפדפן גם יוצמד לסרגל האפליקציות.</translation>
<translation id="1709772298389099340">השירות הזה מספק הרשאות מורחבות ל-<ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">כך תהיה לך אפשרות לבחור מבין המכשירים הזמינים ולהציג בהם תוכן.</translation>
<translation id="6717880500969720524">‏נתוני הגלישה ב-Optimium יימחקו בקרוב</translation>
<translation id="1736443181683099871">‏Chromium ינסה לשדרג את הניווטים ל-HTTPS</translation>
<translation id="4418738262462299802">‏נתוני Optimium נמחקו</translation>
<translation id="8469746761106187775">‏Optimium יופעל מחדש בעוד <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">‏כש-HTTPS לא יהיה זמין, Chromium ישתמש בחיבור לא מאובטח בלי להציג אזהרה</translation>
<translation id="6555789357989792722">‏התרה ל-Optimium לפעול ברקע</translation>
<translation id="627441522449241646">‏כדי לשפר את האבטחה של Optimium, השבתנו חלק מהתוספים שלא רשומים ב<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> וייתכן שנוספו ללא ידיעתך.</translation>
<translation id="1912380661217770781">‏כדי להצמיד את Optimium לסרגל האפליקציות לגישה מהירה, צריך ללחוץ על <ph name="BEGIN_BOLD" />כן<ph name="END_BOLD" /> בהתראה של Windows.</translation>
<translation id="9034578483087384251">‏התקנת Optimium מחדש</translation>
<translation id="2856362667064664106">‏Optimium מנסה <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="1665590461646883113">‏החשבון של <ph name="EXISTING_USER" /> כבר מחובר. כדי לשמור על סביבת גלישה נפרדת, אפשר להיכנס ל-Optimium בפרופיל נפרד בתור <ph name="USER_EMAIL_ADDRESS" />. אפשר לקבל גם את התוספים ופריטים נוספים ממכשיר <ph name="DEVICE" />.</translation>
<translation id="1668665535355826445">‏בפעם הבאה ש-Optimium ייפתח במכשיר <ph name="DEVICE_TYPE" />, תופיע הנחיה להשתמש במנהל הסיסמאות של Google.</translation>
<translation id="1838374766361614909">ניקוי חיפוש</translation>
<translation id="8674417702521959187">‏כדי למחוק את נתוני הגלישה מהמכשיר הזה בלבד ועדיין לשמור אותם בחשבון שלך ב-Google, <ph name="BEGIN_LINK" />עליך לצאת מהחשבון ב-Optimium<ph name="END_LINK" />.</translation>
<translation id="6186721318460238018">‏כדי לפתוח או ליצור קבוצות חדשות של כרטיסיות תוך כדי תנועה, כדאי להוריד את Optimium לטלפון שלך.</translation>
<translation id="185970820835152459">‏יש לך אפשרות לנהל את חשבונות Google שאליהם נכנסת. כדי ליהנות מחיבור לחשבון בדפדפן Chromium, בחנות Play, ב-‏Gmail ובשירותים נוספים, עליך להיכנס עם חשבונות Google שלך. כדי להוסיף חשבון של מישהו אחר, כמו חבר/ה בקבוצה המשפחתית, יש להוסיף משתמש חדש ל-<ph name="DEVICE_TYPE" />. <ph name="LINK_BEGIN" />מידע נוסף<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">חיפוש באמצעות התכונה 'חיפוש תמונות'</translation>
<translation id="1781731701613313704">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER" />. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-Optimium בתור <ph name="USER_EMAIL_ADDRESS" />. הסימניות ופריטים נוספים יופיעו במכשיר <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">בחירת טקסט</translation>
<translation id="5960850334733792580">‏נכנסת עם חשבון מנוהל שנותן למנהל המערכת שלו שליטה על הפרופיל שלך ב-Optimium. הנתונים שלך ב-Optimium, כגון אפליקציות, סימניות, היסטוריה, סיסמאות והגדרות אחרות ייקשרו באופן קבוע ל-<ph name="USER_NAME" />. ניתן למחוק את הנתונים האלה באמצעות לוח הבקרה של חשבונות Google, אבל אי אפשר לשייך את הנתונים האלה לחשבון אחר. לחלופין, באפשרותך ליצור פרופיל חדש כדי לשמור את הנתונים הקיימים שלך ב-Optimium בנפרד.<ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">‏‫Chromium חוסך בחיי הסוללה על ידי הגבלת הפעילות ברקע והאפקטים החזותיים, כמו גלילה חלקה וקצב פריימים של סרטונים. <ph name="BEGIN_LINK" />מידע נוסף על מצב חיסכון באנרגיה<ph name="END_LINK" /></translation>
<translation id="7900167719031567542">‏שירות לעדכון של Optimium</translation>
<translation id="1911763535808217981">‏כיבוי הגדרה זו יאפשר לך להיכנס לאתרי Google, כמו Gmail, בלי להיכנס אל Chromium</translation>
<translation id="5015349619125768393">‏Optimium אינו מגיב. להפעיל מחדש עכשיו?</translation>
<translation id="2019000760486664637">‏לפי דרישת הארגון שלך, <ph name="MANAGER" />, עליך להיכנס לחשבון ב-Optimium</translation>
<translation id="193439633299369377">‏צריך להפעיל מחדש את ChromiumOS כדי להחיל את העדכון הזה.</translation>
<translation id="3382368450324191331">‏Optimium חסם את ההורדה הזאת כי לרוב לא מתבצעת הורדה של קבצים מהסוג הזה ויכול להיות שהקובץ מסוכן</translation>
<translation id="1953553007165777902">מתבצעת הורדה… יש עוד <ph name="MINUTE" /> דק'</translation>
<translation id="1966382378801805537">‏ב-Chromium לא ניתן לקבוע או להגדיר את דפדפן ברירת המחדל</translation>
<translation id="197326043290947695">גלישה חכמה יותר עם "חיפוש תמונות"</translation>
<translation id="5321661580966500942">‏מידע על חסימה של קבצים מסוימים ב-Optimium, נפתח בכרטיסייה חדשה</translation>
<translation id="8960045458031480819">‏השירות הזה שומר על תוכנת Optimium עדכנית. אם השירות הזה מושבת או מופסק, תוכנת Optimium לא תתעדכן באופן קבוע. כתוצאה מכך, לא ניתן יהיה לתקן פרצות אבטחה שעלולות להיווצר, וייתכן שחלק מהתכונות לא יפעלו. השירות הזה יוסר באופן אוטומטי אם אין תוכנת Optimium שמשתמשת בו.</translation>
<translation id="2008474315282236005">‏הפעולה הזו תמחק פריט אחד מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, היכנס אל Chromium עם <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">ההתקנה נכשלה. יש לנסות שוב.</translation>
<translation id="2039417478970545937">הגדרות.</translation>
<translation id="2049376729098081731">‏בוחרים אם לכלול את ההיסטוריה ב-Chromium להתאמה אישית מדויקת יותר בשירותי Google</translation>
<translation id="4120951192672345208">‏מנהל הסיסמאות מובנה ב-Optimium ומאפשר לך ליצור סיסמאות חזקות, לשמור אותן ולמלא אותן אוטומטית. כדי להגיע אליו בקלות, אפשר להוסיף את קיצור הדרך.</translation>
<translation id="7165258062917217746">‏אפשר ללחוץ על הכפתור "התאמה אישית של Optimium" בדף הכרטיסייה החדשה כדי לשנות את המראה שלו</translation>
<translation id="3702823791268559760">‏Optimium חסם את ההורדה הזאת כי הקובץ מטעה ועשוי לבצע שינויים לא צפויים במכשיר שלך</translation>
<translation id="2370804817835146114">‏בפעם הבאה ש-Optimium ייפתח ב-iOS, תופיע הנחיה לנסות את <ph name="FEATURE_NAME" />.</translation>
<translation id="5887094242311035059">‏הסיסמאות ונתונים אחרים מ-Optimium ששמרת בחשבון שלך ב-Google יוסרו מהמכשיר הזה. כדי להשתמש בהם שוב ב-Optimium, צריך להיכנס בחזרה לחשבון.</translation>
<translation id="8794268168383660193">{COUNT,plural, =1{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-Optimium במשך דקה. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}one{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-Optimium במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}two{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-Optimium במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}other{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-Optimium במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}}</translation>

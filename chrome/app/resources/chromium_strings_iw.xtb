<translation id="4547231940814681999">‏הוספת פרופיל Optimium</translation>
<translation id="4447409407328223819">‏מידע על Chrome for Testing</translation>
<translation id="5633209319760692383">‏כדי להשתמש בנתוני Optimium ולשמור אותם בחשבון Google, עליך להזין את ביטוי הסיסמה שלך</translation>
<translation id="4493028449971051158">שגיאת הפעלה: יש להפעיל את מנהל ההתקנה כאדמין.</translation>
<translation id="4501471624619070934">ההתקנה נכשלה כי הגישה מוגבלת במדינה הזו.</translation>
<translation id="4501839397124711198">‏כדי לשאול שאלות בזמן הגלישה, אפשר להצמיד את חיפוש Google בחלונית הצד</translation>
<translation id="2800276662284246735">‏לתוסף הזה לא פורסמו נוהלי פרטיות, למשל האופן שבו הוא אוסף נתונים ומשתמש בהם. ההמלצה של Optimium היא להסיר אותו.</translation>
<translation id="5128821773878845255">‏ברוך בואך אל Optimium. נפתח חלון חדש בדפדפן</translation>
<translation id="2317489323536472198">‏ל-Optimium נדרשת הרשאה כדי למפות את הסביבה שלך ולעקוב אחרי תנועות הידיים</translation>
<translation id="8080035720506683743">‏כבר נכנסת לחשבון בתור <ph name="USER_EMAIL_ADDRESS" /> בפרופיל Optimium אחר</translation>
<translation id="4548534452171747496">‏‫Chromium טוען מראש דפים וכך ניתן לגלוש ולחפש מהר יותר. <ph name="BEGIN_LINK" />מידע נוסף על טעינה מראש של דפים<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">כדי לשפר את הבטיחות באינטרנט לכולם, אפשר לדווח על אתר שלדעתך עשוי לגרום נזק.</translation>
<translation id="8636960717768483692">‏Optimium חסם את ההורדה הזאת כי השבתת את הגלישה הבטוחה ואי אפשר לאמת את הקובץ</translation>
<translation id="1056620590372326996">‏רוצה לנסות את Google Lens ב-Optimium בטלפון?</translation>
<translation id="4594305310729380060">שמירה למנהל הסיסמאות במכשיר הזה</translation>
<translation id="1647545052658850323">‏יישומי Optimium</translation>
<translation id="4598116752460667024">מחפשים תהליך כלשהו מהרשימה.</translation>
<translation id="4613863813562375431">‏גרסת ChromiumOS</translation>
<translation id="4621240073146040695">‏העדכון כמעט הושלם! הפעל מחדש את Chromium‏ כדי לסיים את העדכון.</translation>
<translation id="2905329563261343101">‏אפשר להאיץ ביצועים של אתרים באמצעות מנוע V8 של Optimium, אבל Optimium יהיה קצת פחות עמיד בפני מתקפות.</translation>
<translation id="3476739270743628464">‏פתיחת החיפוש באמצעות Optimium</translation>
<translation id="8852417056873245680">‏פרופיל Optimium</translation>
<translation id="7306598352117034690">‏אזהרה: Optimium לא יכול למנוע מתוספים לתעד את היסטוריית הגלישה שלך. כדי להשבית את התוסף הזה במצב אנונימי, צריך לבטל את הבחירה של האפשרות הזו.</translation>
<translation id="4673151026126227699">‏אם בנוסף ישותפו דוחות שימוש ב-Chromium, הדוחות האלה יכללו את כתובות ה-URL שבהן ביקרת</translation>
<translation id="4673710618874938871">נכנסת בתור <ph name="USER_NAME" />, עם מינוי. פתיחת תפריט החשבון</translation>
<translation id="8554460300897634995">‏נראה שהפרופיל נמצא בשימוש על ידי תהליך Optimium אחר (<ph name="PROCESS_ID" />) במחשב אחר (<ph name="HOST_NAME" />)‏. Optimium נעל את הפרופיל כדי שלא ייפגם. אם וידאת שאף תהליך אחר אינו משתמש בפרופיל זה, אפשר את נעילת הפרופיל ולהפעיל את Optimium מחדש.</translation>
<translation id="4680828127924988555">ביטול ההתקנה</translation>
<translation id="3120454893225058851">‏חלק מהנתונים ב-Optimium עדיין לא נשמרו בחשבון Google. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו.</translation>
<translation id="382482205580353394">‏כשמחוברים לחשבון, אפשר להשתמש בסיסמאות ובפרטים נוספים מחשבון Google ב-Optimium. אפשר לשנות את ההגדרות של שירותי Google באמצעות קיצור הדרך <ph name="SHORTCUT" />.</translation>
<translation id="3042362992251330365">‏מישהו נכנס בעבר ל-Optimium מהמחשב הזה כ-<ph name="ACCOUNT_EMAIL_LAST" />. יש ליצור משתמש חדש ל-Optimium כדי לשמור על פרטיות המידע שלך.</translation>
<translation id="4724676981607797757">ההתקנה נכשלה בגלל שגיאת פרוטוקול שלא נתמך.</translation>
<translation id="1193287511990404405">‏לסגור את Optimium בכל זאת?</translation>
<translation id="8952177001318268390">‏בוצע עדכון אבטחה מיוחד של Optimium. עכשיו עליך להפעיל מחדש ואנחנו נשחזר את הכרטיסיות.</translation>
<translation id="4771701986670315895">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאות "<ph name="PERMISSION_1" />", "<ph name="PERMISSION_2" />" ועוד <ph name="COUNT" /> הרשאות הוסרו על ידי Chromium.</translation>
<translation id="2836181158089477791">‏אם Gemini פתוח ב-Optimium, החלונית הצדדית נשארת פתוחה כשיוצרים כרטיסיות חדשות</translation>
<translation id="479167709087336770">‏נעשה כאן שימוש בבדיקת האיות של חיפוש Google. הטקסט המוקלד בדפדפן נשלח אל Google. אפשר לשנות את ההתנהגות הזו בכל שלב דרך ההגדרות.</translation>
<translation id="1328138522631482119">‏שימוש ב-Optimium ללא חשבון</translation>
<translation id="4839733921943823254">הצמדה של קיצור הדרך</translation>
<translation id="3892081057957249936">‏כלל נכנס עבור Optimium על מנת לאפשר תנועת mDNS.</translation>

<translation id="8164014945047474187">‏תנאים והגבלות נוספים של Chromium</translation>
<translation id="4835039973898764392">{COUNT,plural, =1{‏האדמין דורש להפעיל מחדש את Optimium כדי להחיל עדכון. יש חלון פרטי או חלון מבודד פתוח. הוא לא ייפתח שוב אחרי ההפעלה מחדש.}one{‏האדמין דורש להפעיל מחדש את Optimium כדי להחיל עדכון. יש # חלונות פרטיים וחלונות מבודדים פתוחים בפרופילים שונים. הם לא ייפתחו שוב אחרי ההפעלה מחדש.}two{‏האדמין דורש להפעיל מחדש את Optimium כדי להחיל עדכון. יש # חלונות פרטיים וחלונות מבודדים פתוחים בפרופילים שונים. הם לא ייפתחו שוב אחרי ההפעלה מחדש.}other{‏האדמין דורש להפעיל מחדש את Optimium כדי להחיל עדכון. יש # חלונות פרטיים וחלונות מבודדים פתוחים בפרופילים שונים. הם לא ייפתחו שוב אחרי ההפעלה מחדש.}}</translation>
<translation id="8065654717207240588">‏Optimium‏ חסם את הקובץ הזה כי הוא מסוכן.</translation>
<translation id="8177472873527554730">לא נמצא תוכן בדף</translation>
<translation id="8200109504272824693">‏כדי להשתמש בנתונים של Chromium ולשמור אותם בחשבון <ph name="USER_EMAIL" />, צריך להזין את ביטוי הסיסמה</translation>
<translation id="820759916613250543">חיפוש בתמונה בעזרת "חיפוש תמונות"</translation>
<translation id="8221491193165283816">הבחירה שלך היא בדרך כלל לחסום התראות. כדי לאפשר לאתר הזה להציג התראות יש ללחוץ כאן.</translation>
<translation id="8223363452568144035">‏כדי להשתמש במצלמה, צריך להיכנס אל <ph name="BEGIN_LINK" />הגדרות המערכת<ph name="END_LINK" /> ולתת ל-Chromium גישה</translation>
<translation id="1094434558959920914">‏‫Optimium לא יכול לאמת את מקור התוסף הזה ויכול להיות שהוא לא בטוח. צריך להסיר אותו מ-Optimium כדי לא לאפשר לו יותר לראות ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="3957438238123670294">‏אם אין לתמונה תיאור מועיל, Optimium ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל Google. אפשר להשבית את האפשרות הזו בכל זמן דרך ההגדרות.</translation>
<translation id="2706853324286223963">‏להיכנס ל-Optimium עם פרופיל חדש?</translation>
<translation id="1237310177197195175">‏הדפדפן כבר מחובר לחשבון של <ph name="EXISTING_USER" />. כדי להפריד בין נתוני הגלישה של החשבונות, עליך להיכנס לפרופיל שלך ב-Optimium בתור <ph name="USER_EMAIL_ADDRESS" />. הסיסמאות שלך ופרטים נוספים יופיעו במכשיר <ph name="DEVICE" />.</translation>
<translation id="2801607883759458012">‏הצגת Gemini ב-Optimium במגש המערכת והפעלת מקשי הקיצור</translation>
<translation id="8286943863733751221">‏<ph name="BEGIN_LINK" />ב-Chromium מוצגות אזהרות<ph name="END_LINK" /> מפני הורדות ואתרים לא בטוחים</translation>
<translation id="8295827201165805317">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאה "<ph name="PERMISSION" />" הוסרה על ידי Chromium.</translation>
<translation id="5265623464653503960">‏אפשר לקנות, לתרגם ולזהות את מה שרואים במצלמה באפליקציית Optimium ל-iOS</translation>
<translation id="7565411431973063464">‏קוד QR לכניסה אל Optimium בתור <ph name="USER_NAME" /></translation>
<translation id="8313851650939857356">שגיאת הפעלה: <ph name="STARTUP_ERROR" />.</translation>
<translation id="5911806827430614904">‏לפי הגדרת הארגון, Optimium נסגר אוטומטית כשלא משתמשים בו במשך <ph name="TIMEOUT_DURATION" />.</translation>
<translation id="8321888067342493336">שמירה כתמונה</translation>
<translation id="1508573889613002459">‏בכתובת <ph name="USER_EMAIL_ADDRESS" /> השתמשו בעבר ב-Optimium</translation>
<translation id="8351551329754447960">‏הפעלה של מיומנויות ב-Chromium</translation>
<translation id="406081439566291910">‏כדי להמשיך להשתמש בנתונים של Optimium בחשבון שלך ב-Google (<ph name="ACCOUNT_EMAIL" />), צריך לעדכן את Optimium</translation>
<translation id="1007124785122331769">‏כדי לקבל עדכונים של Optimium בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 8.</translation>
<translation id="8362914115861174987">תרגום ל</translation>
<translation id="8367705492654390392">אפשר לשאול הכל</translation>
<translation id="8370517070665726704">‏Copyright <ph name="YEAR" /> Google LLC.‎ כל הזכויות שמורות.</translation>
<translation id="3692978295966861512">‏כדי לקבל גישה לסיסמאות ולנתונים נוספים בכל המכשירים שלך, כדאי להיכנס ל-Optimium. לאחר הכניסה, הסיסמה הזו תישמר בחשבון שלך ב-Google.</translation>
<translation id="7364603585139702314">‏לאחר מכן יהיה עליך להפעיל מחדש את Optimium.</translation>
<translation id="8376752431516546391">‏החלונית הצדדית של חיפוש Google</translation>
<translation id="8236183484860169180">‏ההמלצה של Optimium היא להסיר אותו. <ph name="BEGIN_LINK" />מידע נוסף על תוספים נתמכים<ph name="END_LINK" /></translation>
<translation id="5920842078198979811">‏הפרסום של התוסף הזה בוטל על ידי המפתח שלו, ויכול להיות שהתוסף לא בטוח. צריך להסיר אותו מ-Optimium כדי לא לאפשר לו יותר להציג ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="8406687098231754303">‏כדי לשאול שאלות בזמן הגלישה, אפשר ללחוץ על הכפתור "חיפוש Google בחלונית הצד" שבסרגל הכלים ולפתוח את החלונית מחדש</translation>
<translation id="2185697372454035703">‏‫Optimium צריך לאמת את הזהות שלך לפני שאפשר יהיה לשמור חלק מהנתונים בחשבון Google ולהשתמש בהם בכל המכשירים שלך. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו.</translation>
<translation id="4724639108574581385">{0,plural, =1{‏צריך להפעיל מחדש את Optimium בתוך יום אחד}one{‏צריך להפעיל מחדש את Optimium בתוך # ימים}two{‏צריך להפעיל מחדש את Optimium בתוך # ימים}other{‏צריך להפעיל מחדש את Optimium בתוך # ימים}}</translation>
<translation id="8438543370129609977">‏כשמשתמשים בתכונה 'חיפוש תמונות', כותרת הדף, כתובת ה-URL והתוכן שלו, כולל קובצי PDF, נשלחים לשרת. <ph name="LEARN_MORE" /></translation>
<translation id="3557945352384776441">‏מידע נוסף על חיפוש באמצעות התכונה "חיפוש תמונות" ב-Optimium</translation>
<translation id="6672310590031980518">‏הארכיון של המתקין פגום או שאינו חוקי. יש להוריד שוב את Optimium.</translation>
<translation id="8463672209299734063">‏אופציונלי: שליחה אוטומטית של נתוני אבחון ונתוני שימוש במכשיר אל Google תעזור לשפר את התכונות ואת הביצועים של ChromiumOS.</translation>
<translation id="3954441584666499211">‏כדי להשתמש בנתוני Optimium ולשמור אותם בחשבון Google, עליך לאמת את הזהות שלך</translation>
<translation id="8482493977473846331">‏הצגת פרומפטים לצורך כניסה אל Chromium</translation>
<translation id="8202428378580208719">‏Optimium אינו מעודכן</translation>
<translation id="850264194101621529">‏תודה שבחרת ב-Chromium כדפדפן ברירת המחדל שלך!</translation>
<translation id="8522801943730206384">‏ל-Chromium יש אפשרות לבדוק את הסיסמאות שלך רק אם שמרת אותן</translation>
<translation id="8525579356836940628">ההתקנה נעצרה</translation>
<translation id="8984919429007493543">‏כשאפליקציית Optimium מותקנת במכשיר <ph name="DEVICE_TYPE" /> שלך, הסיסמאות, הכרטיסיות ופריטים נוספים הולכים איתך לכל מקום</translation>
<translation id="8555465886620020932">שגיאה בשירות: <ph name="SERVICE_ERROR" />.</translation>
<translation id="3963774984615461205">‏חלק מהתכונות והתוספים של Optimium מגיעים עם מקשי קיצור. אפשר להפעיל אותם מחדש.</translation>
<translation id="8556420416730706394">אפשר להצמיד את התכונה 'חיפוש תמונות' כדי לאפשר גישה נוחה: פשוט לוחצים על הכפתור 'הצמדה' בחלק העליון של החלונית הצדדית</translation>
<translation id="8564408666201523086">‏הפעולה הצליחה. עכשיו בזמן הגלישה בחיפוש Google, אפשר לשאול שאלות בקלות ישירות מחלונית הצד</translation>
<translation id="856656450041460113">רשימת שפות לחיפוש</translation>
<translation id="2996904635986800713">‏מספר ארגונים מנהלים את Optimium</translation>
<translation id="8586442755830160949">‏Copyright <ph name="YEAR" /> The Chromium Authors. כל הזכויות שמורות.</translation>
<translation id="8590782867495422699">‏פתיחה מחדש של מצב AI בחיפוש Google</translation>
<translation id="2446482746737130055">‏הפעלת Optimium מתבצעת...</translation>
<translation id="8624541899164515475">הגדרות, ייפתחו בכרטיסייה חדשה.</translation>
<translation id="8648201657708811153">‏לא ניתן להגדיר את Google Chrome for Testing כדפדפן ברירת המחדל.</translation>
<translation id="9172606645924379921">‏חיפוש באמצעות Optimium מכל מקום</translation>
<translation id="5596132704047725626">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את Optimium או מבצעים חיפוש מסרגל הכתובות.</translation>
<translation id="567010981548424498">‏כדי לשלוח את הכרטיסייה הזו למכשיר אחר, צריך להתחבר בו ל-Optimium</translation>
<translation id="4758459198907306138">‏זהו ה-Optimium שלך</translation>
<translation id="8712637175834984815">הבנתי</translation>
<translation id="5293592838971423777">‏להיכנס אל Optimium?</translation>
<translation id="8747073452963259673">‏הפינה השמאלית התחתונה של אזור החיפוש: ‎<ph name="LEFT" />%‎ משמאל, ‎<ph name="BOTTOM" />%‎ מלמטה</translation>
<translation id="878572486461146056">שגיאת התקנה: מנהל הרשת החיל מדיניות קבוצתית שמונעת את ההתקנה: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">אני רוצה לקבל תזכורת אחר כך</translation>
<translation id="8601403845093292651">‏כדי לקבל סקירה כללית זריזה ולשאול שאלות המשך, אפשר לשתף את המסמך הזה עם Gemini ב-Optimium</translation>
<translation id="3011694712607672183">‏להיכנס אל Optimium?</translation>
<translation id="8823401858233292222">‏הגדרת Chromium כדפדפן ברירת המחדל והצמדה שלו לסרגל המשימות</translation>
<translation id="8826492472752484139">לוחצים על 'מנהל הסיסמאות'</translation>
<translation id="8833697763442816810">‏מערכת ChromiumOS</translation>
<translation id="8852026904190808918">‏זו השפה שבה מוצגים תפריטים, הגדרות, התראות וטקסטים אחרים ב-Chromium</translation>
<translation id="8862326446509486874">אין לך זכויות שמתאימות להתקנה ברמת המערכת. יש לנסות להפעיל שוב את המתקין כמנהל מערכת.</translation>
<translation id="8400219074131043686">‏הוספת פרופיל Optimium</translation>
<translation id="3471339840299959661">‏הנתונים מ-Optimium לא נשמרו בחשבון Google שלך ב-ChromiumOS בגלל שגיאה בתהליך הכניסה</translation>
<translation id="8161120518458367008">‏לפי דרישת הארגון שלך, עליך להיכנס לחשבון ב-Optimium</translation>
<translation id="4176797355456373725">‏Optimium מנסה להציג סיסמאות. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
<translation id="8300184335948277828">‏‫Optimium כבר לא מוגדר כדפדפן ברירת המחדל שלך. אני רוצה ש-Optimium יהיה דפדפן ברירת המחדל</translation>
<translation id="8365648631713891786">‏לא ניתן לעדכן את Optimium</translation>
<translation id="8944232836376404813">‏בעקבות האיפוס:
          <ph name="LINE_BREAKS" />
            • יתאפסו דף הפתיחה, דף הכרטיסייה החדשה, מנוע החיפוש והכרטיסיות המוצמדות
            <ph name="LINE_BREAK" />
            • התוספים יושבתו
            <ph name="LINE_BREAK" />
            • יימחקו קובצי Cookie ונתונים זמניים אחרים מאתרים
            <ph name="LINE_BREAKS" />
            לא תהיה השפעה על הסימניות, ההיסטוריה והסיסמאות השמורות.</translation>
<translation id="4517341657960407384">‏הצגת קיצורי דרך לאתרים ב-Optimium</translation>
<translation id="6334459924587075942">‏הלוגו של Optimium Enterprise</translation>
<translation id="1013608620694172987">‏עם אפליקציית Optimium במכשיר <ph name="DEVICE_TYPE" />, תכונות הבטיחות של Google הולכות איתך לכל מקום</translation>
<translation id="6377692339934065652">‏אי אפשר להפעיל את Optimium בגלל שמשהו השתבש בפתיחת הפרופיל. כדאי לנסות להפעיל מחדש את Optimium.</translation>
<translation id="8411734418760705455">‏כדי לחפש באמצעות Optimium או להתאים אישית ב<ph name="BEGIN_LINK" />הגדרות<ph name="END_LINK" /></translation>
<translation id="4403836439014450645">‏ניהול הפרופילים ב-Optimium</translation>
<translation id="7714694033208252813">‏כדי לעבור בין Gemini ב-Optimium לבין הכרטיסייה הפתוחה, אפשר להשתמש במקלדת.</translation>
<translation id="9018218886431812662">ההתקנה הושלמה</translation>
<translation id="4028461118515168614">‏כדי לשפר את האבטחה של Optimium, השבתנו את התוסף הבא שאינו רשום ב-<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> וייתכן שנוסף ללא ידיעתך.</translation>
<translation id="8853260188791570953">‏כניסה אל Optimium</translation>
<translation id="6769418925691762561">‏הצגת החיפוש באמצעות Optimium בסרגל התפריטים של Mac והפעלת מקשי הקיצור</translation>
<translation id="1582160730719680639">‏‫Optimium חסם את ההורדה הזו כי קובץ הארכיון כולל קבצים אחרים שעלולים להסתיר תוכנות זדוניות</translation>
<translation id="136372829312763612">‏רוצה לסנכרן את הסיסמאות, הסימניות וההיסטוריה שלך באופן מושלם בין המכשירים? כדי להשתמש בקלות בתכונות המוכרות והאהובות, צריך לעדכן את דפדפן ברירת המחדל ל-Optimium. לגישה מהירה, Optimium יוצמד לסרגל האפליקציות.</translation>
<translation id="4121763951659864948">‏רוצה להשתמש בכלי ה-AI הטובים ביותר של Google? כשאפליקציית Optimium מותקנת בטלפון שלך זה אפשרי</translation>
<translation id="570680773394181802">‏כדי לקבל גישה לסיסמאות ולנתונים נוספים מתוך <ph name="DEVICE" />, צריך להתחבר ל-Optimium</translation>
<translation id="9062666675513499497">‏כניסה אל Chromium כשנכנסים לשירותי Google אחרים</translation>
<translation id="9074041031320636790">‏הצלחנו! עכשיו אפשר לשאול שאלות בקלות במהלך הגלישה בחיפוש Google במצב AI</translation>
<translation id="516400912738056453">‏Optimium נסגר באופן אוטומטי</translation>
<translation id="807899198682302888">‏Optimium אינו מעודכן</translation>

<translation id="5977471146123132488">ផ្លូវកាត់​បើក​នៅក្នុង Optimium</translation>
<translation id="1873460655129342919">ស្ថាប័ន​របស់អ្នក​បិទ Optimium នៅពេលដែល​មិនប្រើប្រាស់វា​រយៈពេល <ph name="TIMEOUT_DURATION" />។ ទិន្នន័យរុករក​ត្រូវបាន​លុប។ ទិន្នន័យ​នេះ​អាច​រួមមាន​ប្រវត្តិ ការ​បំពេញស្វ័យប្រវត្តិ និង​ការទាញ​យក។</translation>
<translation id="139284349466910875">កម្រងព័ត៌មាននីមួយៗមានព័ត៌មាន Optimium របស់វាផ្ទាល់ដូចជា ចំណាំ ប្រវត្តិ ពាក្យ​សម្ងាត់ និងអ្វីៗជាច្រើនទៀត</translation>
<translation id="6556755379298048869">ស្វែងរកដោយប្រើផ្លូវកាត់​ក្ដារ​ចុច។</translation>
<translation id="6563921047760808519">ស្វែងយល់​បន្ថែម​អំពី<ph name="BEGIN_LINK" />របៀបដែល Chromium រក្សាទិន្នន័យ​របស់អ្នក​ជាលក្ខណៈ​ឯកជន<ph name="END_LINK" /></translation>
<translation id="562266251854740285">ការផ្លាស់ប្ដូរ​ចំពោះ​ការកំណត់នេះ​នឹង​ត្រូវបាន​អនុវត្ត​បន្ទាប់ពី Optimium ចាប់ផ្ដើម​ឡើងវិញ។</translation>
<translation id="965740992595240282">គ្រប់គ្រង​កម្មវិធីបន្ថែម​របស់អ្នក​ដោយ​ចុច "កម្មវិធីបន្ថែម" នៅក្នុង​ម៉ឺនុយ​ចម្បង​របស់ Optimium។</translation>
<translation id="2549448919385330625">អ្នកអាចប្ដូរ ដើម្បីមើល​ពាក្យសម្ងាត់​ពីកម្រងព័ត៌មាន Optimium ផ្សេងទៀត</translation>
<translation id="2662027419736610653">ប្រើកម្មវិធី Optimium ដើម្បីយកឧបករណ៍ AI ល្អបំផុតតាមខ្លួនពេលធ្វើដំណើរ</translation>
<translation id="6570579332384693436">ដើម្បី​កែ​កំហុសអក្ខរាវិរុទ្ធ​, Chromium ផ្ញើ​អក្សរ​ដែលអ្នក​វាយបញ្ចូល​នៅក្នុង​កន្លែង​បញ្ចូលអក្សរ​ទៅ Google</translation>
<translation id="8346408025829878332">ចូលទៅ​កាន់ការ​កំណត់​ការជូន​ដំណឹង Optimium</translation>
<translation id="6600016381025017075">ស្វែងរកអ្វីមួយនៅលើទំព័រនេះ</translation>
<translation id="5149981246269331326">ការផ្លាស់ប្តូររបស់អ្នកនឹងមានប្រសិទ្ធភាពនៅពេលដែលបើកដំណើរការ Optimium ឡើងវិញពេលក្រោយ។</translation>
<translation id="1163143914216098175">ឥឡូវនេះ Optimium ចាប់ផ្ដើម នៅពេល Windows ចាប់ផ្ដើម ដូច្នេះអ្នកអាចចាប់ផ្ដើមរុករកភ្លាមៗ។ អ្នកអាចបិទលក្ខណៈនេះ​បាននៅក្នុងការកំណត់។</translation>
<translation id="7839895033810030903">បន្តពី​ចំណុច​ដែលអ្នក​បានឈប់៖ Optimium បានស្ដារ​ផ្ទាំង​របស់អ្នក​ពីវគ្គ​ចុងក្រោយ​របស់អ្នក។ អ្នកអាច​បិទមុខងារនេះ​បាននៅក្នុង</translation>
<translation id="8919724422686713691">Optimium ត្រូវការ​ការអនុញ្ញាត​កាមេរ៉ា ដើម្បីបង្កើត​ផែនទី 3D នៃមជ្ឈដ្ឋានជុំវិញ​របស់អ្នក</translation>
<translation id="6669284030132180248">ប្រសិនបើអ្នកក៏រក្សាទុកចំណាំរបស់អ្នកនៅក្នុងគណនី Google របស់អ្នក នោះអ្នកអាចតាមដានតម្លៃផលិតផលនៅក្នុង Chromium និងទទួលបានការជូនដំណឹងនៅពេលមានការធ្លាក់ថ្លៃ</translation>
<translation id="6676384891291319759">ចូលប្រើអ៊ីនធឺណិត</translation>
<translation id="668175097507315160">ChromiumOS មិនអាចធ្វើ​សមកាលកម្មទិន្នន័យរបស់អ្នកបានទេ ដោយសារមានបញ្ហាក្នុងការចូលគណនី។</translation>
<translation id="2337492685922399200">ដក​ទិន្នន័យ​កម្មវិធីនេះ​ចេញពី Optimium</translation>
<translation id="7200198227335381561">Optimium ត្រូវការ​ការអនុញ្ញាត​មីក្រូហ្វូន​សម្រាប់​គេហទំព័រនេះ</translation>
<translation id="6712881677154121168">បញ្ហា​ក្នុងការទាញយក៖ <ph name="DOWNLOAD_ERROR" />។</translation>
<translation id="358599119501177356">ទម្រង់របស់អ្នកមិនអាចត្រូវបានប្រើទេ ពីព្រោះវាមកពីកំណែ Optimium ថ្មីជាងនេះ។

លក្ខណៈពិសេសមួយចំនួនអាចប្រហែលជាមិនមានទេ។.សូមបញ្ជាក់ពីថតឯកសារទម្រង់ផ្សេងទៀត ឬប្រើកំណែ Optimium ថ្មីជាងនេះ។</translation>
<translation id="6729124504294600478">ដើម្បីទទួលបានការកំណត់​ឱ្យមានលក្ខណៈផ្ទាល់ខ្លួន និងមុខងារផ្សេងទៀត សូមរួមបញ្ចូល Chromium នៅក្នុងសកម្មភាពកម្មវិធី និងគេហទំព័រ និងសេវាកម្ម Google ដែលបានភ្ជាប់</translation>

<translation id="3729187154190517324">ស្វែងរក​កាន់តែស៊ីជម្រៅ​ដោយបញ្ចូល​ផ្ទាំង ឯកសារ និង​ឧបករណ៍​ច្រើន​ដោយប្រើ​ប៊ូតុង "បញ្ចូល​ផ្ទាំង និង​អ្វីៗជា​ច្រើនទៀត"។</translation>
<translation id="3032577647176321971">គ្រប់គ្រង​កម្រងព័ត៌មាន Optimium</translation>
<translation id="6314444399103340747">ស្វែងយល់​អំពីមូលហេតុ​ដែល Optimium ទប់ស្កាត់​ការទាញយក​មួយចំនួន</translation>
<translation id="379589255253486813">Chromium នឹង​ប្រាប់ឱ្យអ្នកដឹង ប្រសិនបើមានអ្វី​ដែលអ្នកត្រូវ​ពិនិត្យមើល</translation>
<translation id="3802055581630249637">Chromium ផ្ទុកជាមុននូវទំព័រដែលអ្នក​ទំនងជា​ចូលមើល ដើម្បីឱ្យ​ទំព័រ​ទាំងនោះ​ផ្ទុកកាន់តែ​លឿន នៅពេល​អ្នកចូលមើល</translation>
<translation id="3810973564298564668">គ្រប់គ្រង</translation>
<translation id="4301680230606686279">ដើម្បីប្រើ​ពាក្យសម្ងាត់​ដែលអ្នក​បានរក្សាទុក សូម​ទៅតាម​កូដ QR, ទាញយក Optimium សម្រាប់ iOS រួចចូលគណនី Google របស់អ្នក</translation>
<translation id="3846683726093018685">**សង្ខេប៖** ពណ៌នា​អំពី​ប្រធានបទ និង​គោលបំណង​ចម្បង​នៃខ្លឹមសារ​នៅក្នុង​រូបថត​អេក្រង់​ដោយប្រើ​តែមួយប្រយោគ​ដែលតិចជាង 30 ពាក្យ។

          **ណែនាំ​សំណួរ៖** បង្កើត​បញ្ជី​ត្រេ​ដែលមាន​សំណួរ​បំផុស​ការគិត 3-5 សំណួរ ដែល​អ្នកប្រើប្រាស់​អាចសួរ ដើម្បី​ឱ្យយល់​កាន់តែច្បាស់​អំពី​រូបថត​អេក្រង់។ សំណួរ​ទាំងនេះ​គួរតែ​រួមបញ្ចូល​យ៉ាង​ហោចណាស់​មួយសំណួរ​ដែលទាក់ទង​ជាក់លាក់​នឹង​វត្ថុ​ដែលអាច​មើលឃើញ ការរចនា​របស់វា ឬ​ទីតាំងដាក់វា​ជាដើម។</translation>
<translation id="3287167856630539345"><ph name="PAGE_TITLE" /> - Optimium</translation>
<translation id="3117512156333858342">ដើម្បី​ទទួលបាន​ចំណាំ​របស់អ្នក និង​អ្វីៗជាច្រើនទៀត​នៅលើ​ឧបករណ៍​ទាំងអស់​របស់អ្នក សូម​ចូលគណនី Optimium</translation>
<translation id="3511883131632987404">{COUNT,plural, =1{អ្នក​គ្រប់គ្រង​របស់អ្នក​ស្នើឱ្យអ្នក​ចាប់ផ្ដើម Optimium ឡើងវិញ ដើម្បីដំឡើងកំណែថ្មីនេះ។ ផ្ទាំងដាច់ដោយឡែក​របស់អ្នក​នឹងមិន​បើកឡើងវិញទេ។}other{អ្នក​គ្រប់គ្រង​របស់អ្នក​ស្នើឱ្យអ្នក​ចាប់ផ្ដើម Optimium ឡើងវិញ ដើម្បីដំឡើងកំណែថ្មីនេះ។ ផ្ទាំងដាច់ដោយឡែក # របស់អ្នក​នឹងមិន​បើកឡើងវិញទេ។}}</translation>
<translation id="3885770153807205175">ផ្ទាំង​ជ្រើសរើស​ភាសា</translation>
<translation id="7294070483192043494">ប្ដូរតាម​បំណង និងគ្រប់គ្រង Optimium ។ មានអ្វីមួយ​ដែលអ្នកត្រូវ​ត្រួតពិនិត្យ - សូមចុច ដើម្បី​ទទួលបាន​ព័ត៌មាន​លម្អិត។</translation>
<translation id="7920927747111819647">ចុចឈ្មោះរបស់អ្នកដើម្បីបើក Optimium ហើយចាប់ផ្តើមការរុករក។</translation>
<translation id="3892148308691398805">ចម្លង​អត្ថបទ</translation>
<translation id="4454986649289930182"><ph name="EXISTING_USER" /> បានចូលកម្រងព័ត៌មាន Optimium នេះរួចហើយ។ ដើម្បី​រក្សាការរុករក​របស់អ្នកដាច់ដោយឡែក​ Optimium អាច​បង្កើត​កម្រងព័ត៌មាន​ផ្ទាល់ខ្លួនរបស់អ្នកសម្រាប់អ្នក។</translation>
<translation id="7225128703667880746">កម្មវិធីបន្ថែមនេះបំពានគោលការណ៍ Chrome Web Store និងប្រហែលជាមិនមានសុវត្ថិភាពនោះទេ។ សូមដកកម្មវិធីបន្ថែមនេះចេញពី Optimium ដូច្នេះវាមិនអាចមើលឃើញ និងផ្លាស់ប្ដូរទិន្នន័យរបស់អ្នកនៅលើគេហទំព័រដែលអ្នកចូលមើលបានទៀតទេ រួមទាំងព័ត៌មានផ្ទាល់ខ្លួនរបស់អ្នក។</translation>
<translation id="3941890832296813527">បញ្ហា​ក្នុងការដំឡើង៖ ឈ្មោះឯកសារ​កម្មវិធីដំឡើង​មិនត្រឹមត្រូវ ឬមិនអាចប្រើបាន។</translation>
<translation id="6304622602441037994">Optimium កំពុង​ព្យាយាម​ចម្លង​ពាក្យសម្ងាត់។ សូម​វាយបញ្ចូល​ពាក្យសម្ងាត់ Windows របស់អ្នក ដើម្បី​អនុញ្ញាត​ការចម្លងនេះ។</translation>
<translation id="2274695480528598968">ដើម្បី​ទទួលបាន​ព័ត៌មាន​ដែលអ្នក​បានរក្សាទុក និង​អ្វីៗជាច្រើនទៀត​នៅលើ​ឧបករណ៍​ទាំងអស់​របស់អ្នក សូម​ចូលគណនី Optimium</translation>
<translation id="1713567483777335359">ពាក្យ​សម្ងាត់ វិធីបង់ប្រាក់ និងអាសយដ្ឋានរបស់អ្នកដែលអ្នកបានរក្សាទុកនៅក្នុងគណនី Google នឹងត្រូវបានដកចេញពីឧបករណ៍នេះ។ ដើម្បីប្រើព័ត៌មានទាំងនេះម្ដងទៀតនៅក្នុង Optimium សូមចូលគណនីវិញ។</translation>
<translation id="395904275706073188">មិនអាច​អាន​ទំព័រ​ដែលមាន​ការការពារ​បានទេ។ សូម​សាកល្បងអាន​ទំព័រ​ផ្សេងទៀត។</translation>
<translation id="3962647064319009959">ស្វែងយល់​អំពីរបៀបដែល Chromium រក្សាសុវត្ថិភាព​របស់អ្នក</translation>
<translation id="3967822245660637423">ការទាញយកបានបញ្ចប់</translation>
<translation id="3971865010372729242">នៅពេល​អ្នក​វាយបញ្ចូល​ក្នុង​របារអាសយដ្ឋាន ឬ​ប្រអប់​ស្វែងរក Chromium បញ្ជូន​អ្វីដែលអ្នក​វាយបញ្ចូលទៅ​ឧបករណ៍​ភ្នាក់ងារ, AI និង​ការស្វែងរក​របស់​ស្ថាប័ន​អ្នក ដើម្បី​ទទួលបាន​ការណែនាំ។</translation>

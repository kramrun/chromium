<translation id="4212271170228408978">ឥឡូវនេះ វាមានភាពងាយស្រួលក្នុងការប្រើ Optimium ជាមួយគណនី Google របស់អ្នក និងនៅលើកុំព្យូទ័រដែលបានចែករំលែក។</translation>
<translation id="7560359899505953564">ងាយស្រួល​ចូលប្រើ​មុខងារ​ដែលអ្នក​ស្គាល់ ពេញចិត្ត និង​ជឿទុកចិត្ត​ដោយ​កំណត់ Optimium ជា​កម្មវិធីរុករកតាមអ៊ីនធឺណិតលំនាំដើម​របស់អ្នក។</translation>
<translation id="9090225774559341003">ផ្លូវ​កាត់ Optimium</translation>
<translation id="6926580396655648750">Optimium បានទប់ស្កាត់​ការទាញយកនេះ ដោយសារ​ឯកសារនេះ​មិនត្រូវបាន​ទាញយក​ជាទូទៅទេ ហើយវាអាច​បង្កគ្រោះថ្នាក់</translation>
<translation id="8406846117825568223">តើអ្នកប្រាកដថាចង់លុបការតំឡើង Optimium ទេ?</translation>
<translation id="6375219077595103062">បញ្ចូល​ផ្លូវកាត់​ទៅកាន់​កម្មវិធីគ្រប់គ្រង​ពាក្យសម្ងាត់</translation>
<translation id="6388799252195623474">ជួយខ្ញុំ​ពាក់ព័ន្ធនឹង​ករណីនេះ</translation>
<translation id="9091694200019721003">ដើម្បី​បន្ត សូម​ចូលគណនី Optimium ជា <ph name="EMAIL" />។ ការធ្វើបែបនេះ​ធានាថា អ្នកគោរពតាម​គោលការណ៍​របស់ស្ថាប័ន​អ្នក។</translation>
<translation id="3942952894185574182">រូបសញ្ញា Optimium នៅក្នុង​អេក្រង់​កុំព្យូទ័រ។</translation>
<translation id="3353682461772532321">Optimium គឺជាកម្មវិធីរុករកអ៊ីនធឺណិត ដែលដំណើរការគេហទំព័រ និងកម្មវិធីបានយ៉ាងរហ័សបំផុត។ វាលឿន មានស្ថេរភាព និងងាយស្រួលប្រើ។ រុករកគេហទំព័រប្រកបដោយសុវត្ថិភាពជាមួយការពារពីមេរោគ និងការលួចឆ្មក់យកទិន្នន័យដែលភ្ជាប់នៅក្នុង Optimium។</translation>
<translation id="6791461984478543248">ដើម្បី​ប្រាកដថា​អ្នកអាចប្រើ និង​រក្សាទុក​ទិន្នន័យ Optimium នៅក្នុង​គណនី Google របស់អ្នក​បានជានិច្ច សូម​ផ្ទៀងផ្ទាត់​ថាជាអ្នក</translation>
<translation id="6174985388495951106">Optimium ដំណើរការ​លឿន​ជាងមុន ហើយ​មុខងារដែលប្រើ JavaScript គួរតែ​ដំណើរការ​ដូចដែលបាន​រចនាឡើង</translation>
<translation id="6436260184216827876">មិនអាចប្រើការស្វែងរករូបភាពបានទេ។ សូមព្យាយាមម្ដងទៀតនៅពេលក្រោយ។</translation>
<translation id="6442900851116057561">ចាប់ផ្តើម ChromiumOS ឡើងវិញ</translation>
<translation id="6443470774889161065">Chromium ផ្ទុកជាមុន​នូវទំព័រ​កាន់តែច្រើនទៀតដែល​អ្នក​ទំនង​ជា​ចូលមើល ដើម្បីឱ្យទំព័រ​ទាំង​នោះ​ផ្ទុក​កាន់តែ​លឿន​នៅ​ពេល​អ្នក​ចូលមើល</translation>
<translation id="2102210363398612557">ទាញយក Optimium នៅលើ​ទូរសព្ទ​របស់អ្នក​ដើម្បី​តាមដានតម្លៃ និង​ទទួលបាន​ការជូនដំណឹង នៅពេលដែល​មានការធ្លាក់ថ្លៃ​នៅលើ​គេហទំព័រ​ណាមួយ</translation>
<translation id="6598227122144472874">បិទ • Optimium មិនអាចផ្ទៀងផ្ទាត់ប្រភពរបស់កម្មវិធីបន្ថែម​នេះបានទេ</translation>
<translation id="3895850825918446737">សូមស្វាគមន៍​មកកាន់កម្រង​ព័ត៌មាន Optimium</translation>
<translation id="3239105679122868308">នៅពេល​អ្នកបើក Optimium នៅលើ <ph name="DEVICE_TYPE" /> របស់អ្នក​នៅលើកក្រោយ អ្នក​នឹងឃើញ​សារតម្រុយ​ដែលប្រាប់​ឱ្យប្រើ​ក្រុមផ្ទាំង។</translation>
<translation id="5440394152628202500">ដក​គណនី​ចេញពី Optimium</translation>
<translation id="5673289019038024720">វាក៏គ្រប់គ្រងអ្វីដែលត្រូវបានបង្ហាញនៅលើទំព័រដែរ នៅពេលអ្នកចាប់ផ្តើម Optimium។</translation>
<translation id="648319183876919572">ការរុករក​ដោយសុវត្ថិភាពបន្ថែម​ធ្វើបានកាន់តែច្រើនក្នុងការការពារអ្នកពី​ការទាញយក និងគេហទំព័រ​គ្រោះថ្នាក់</translation>

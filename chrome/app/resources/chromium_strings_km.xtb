<translation id="6377692339934065652">មិនអាច​ចាប់ផ្ដើម Optimium បានទេ ដោយសារ​មានអ្វីមួយ​ខុសប្រក្រតី នៅពេល​បើក​កម្រងព័ត៌មាន​របស់អ្នក។ សូម​សាកល្បង​ចាប់ផ្ដើម Optimium ឡើងវិញ។</translation>
<translation id="8411734418760705455">ដើម្បីស្វែងរកដោយប្រើ Optimium ឬប្ដូរតាមបំណងនៅក្នុង <ph name="BEGIN_LINK" />"ការកំណត់"<ph name="END_LINK" /></translation>
<translation id="4403836439014450645">គ្រប់គ្រង​កម្រងព័ត៌មាន Optimium</translation>
<translation id="7714694033208252813">ប្រើក្ដារចុចរបស់អ្នក ដើម្បីប្ដូររវាង Gemini ក្នុង Optimium និងផ្ទាំងដែលអ្នកបើក។</translation>
<translation id="9018218886431812662">ការដំឡើង​បានបញ្ចប់</translation>
<translation id="4028461118515168614">ដើម្បីធ្វើឲ្យ Optimium មានសុវត្ថិភាពជាងមុន យើងបានបិទដំណើរកម្មវិធីបន្ថែមមួយចំនួនដែលមិនត្រូវបានរាយនៅក្នុង <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ហើយអាចត្រូវបានបន្ថែមដោយពុំមានការជូនដំណឹងដល់អ្នក។</translation>
<translation id="8853260188791570953">ចូលទៅ Optimium</translation>
<translation id="6769418925691762561">បង្ហាញការស្វែងរកតាមរយៈ Optimium នៅក្នុងរបារម៉ឺនុយ Mac និងបើកផ្លូវកាត់​ក្ដារ​ចុច</translation>
<translation id="1582160730719680639">Optimium បានទប់ស្កាត់​ការទាញយកនេះ ដោយសារ​ឯកសារ​ក្នុង​បណ្ណសារនេះ​រួមមាន​ឯកសារ​ផ្សេងទៀត​ដែលអាច​លាក់កម្មវិធីគ្រោះថ្នាក់</translation>
<translation id="136372829312763612">បន្តធ្វើ​សមកាលកម្ម​ពាក្យសម្ងាត់ ចំណាំ និង​ប្រវត្តិ​របស់អ្នក​បានយ៉ាងល្អ​ឥតខ្ចោះ​នៅលើ​ឧបករណ៍​នានា។ ងាយស្រួល​ចូលប្រើ​មុខងារ​ដែលអ្នក​ស្គាល់ និង​ពេញចិត្ត​ដោយ​ប្ដូរ​កម្មវិធីរុករកតាមអ៊ីនធឺណិតលំនាំដើម​របស់អ្នក​ទៅ Optimium។ Optimium នឹង​ត្រូវបានខ្ទាស់​ទៅរបារកិច្ចការ​របស់អ្នក ដើម្បី​ចូលប្រើបានរហ័ស។</translation>
<translation id="4121763951659864948">ប្រើឧបករណ៍ AI ល្អបំផុតរបស់ Google តាមរយៈកម្មវិធី Optimium នៅលើទូរសព្ទរបស់អ្នក</translation>
<translation id="570680773394181802">ដើម្បី​ទទួលបាន​ពាក្យ​សម្ងាត់​របស់អ្នក និង​អ្វីៗជាច្រើនទៀត​ពី<ph name="DEVICE" /> សូម​ចូលគណនី Optimium</translation>
<translation id="9062666675513499497">ចូលគណនីលើ Chromium នៅពេលអ្នកចូលសេវាកម្ម Google ផ្សេងទៀត</translation>
<translation id="9074041031320636790">ជោគជ័យហើយ! ឥឡូវនេះ អ្នកអាចសួរសំណួរយ៉ាងងាយស្រួល នៅពេលអ្នករុករកដោយប្រើមុខងារ AI របស់ម៉ាស៊ីនស្វែងរកនៅលើ Google</translation>
<translation id="9074163480955555019">រូបតំណាងថ្មី ផ្លូវកាត់ដដែល៖ ចុចដើម្បីសួរសំណួរ នៅពេលអ្នករុករកដោយប្រើម៉ាស៊ីនស្វែងរកនៅលើ Google ក្នុង Chrome។</translation>

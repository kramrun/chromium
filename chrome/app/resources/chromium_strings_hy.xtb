<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hy">
<translation id="1026101648481255140">Վերսկսել տեղադրումը</translation>
<translation id="1029669172902658969">Վերագործարկել՝ &amp;ChromiumOS-ը թարմացնելու համար</translation>
<translation id="4063809399345498325">Optimium-ը խորհուրդ է տալիս ստուգել այս ընդլայնումը</translation>
<translation id="1042552502243217427">Երբ որևէ կայք հայցում է էջերի անանուն նախաբեռնում իր էջում առկա հղումների միջոցով, Chromium-ը օգտագործում է Google-ի սերվերները։ Այդպիսով ձեր անձնական տվյալները չեն փոխանցվում, սակայն Google-ը իմանում է, թե որ կայքերն են նախապես բեռնվում։</translation>
<translation id="1051793555070215510">Օգնեք մեզ բարելավել ինկոգնիտո ռեժիմը՝ անցնելով այս 1 րոպեանոց հարցումը։</translation>
<translation id="1065672644894730302">Ձեր նախասիրությունները չի հաջողվում ստանալ:

Որոշ գործառույթներ կարող են մատչելի չլինել: Նախընտրանքների փոփոխությունները չեն պահպանվի:</translation>
<translation id="7250992450852052182">Ձեր ծնողն անջատել է «Թույլտվություններ կայքերի, հավելվածների և ընդլայնումների համար» պարամետրը Optimium-ում</translation>
<translation id="6711838932294803312">Optimium-ին անհրաժեշտ է ձեր լոկալ ցանցի հասանելիություն՝ մոտակա սարքերը հայտնաբերելու և օգտագործելու համար</translation>
<translation id="2807920805712601449">Optimium-ի որոշակի գործառույթ կամ ընդլայնում որոնելու համար հասցեագոտում մուտքագրեք դրա դյուրանցումը, ապա՝ ձեր ընտրած ստեղնը</translation>
<translation id="5994612110840535151">Ցույց տալ Optimium-ով որոնումը ծանուցման տարածքում և միացնել ստեղնային դյուրանցումը</translation>
<translation id="7212528213853025915">Optimium-ն ուզում է արտահանել ձեր գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="112640046208448578">Նույնականացրեք իրեր կամ վայրեր և պատճենեք կամ թարգմանեք տեքստեր։ Երբ օգտագործում եք «Որոնում պատկերով» գործառույթը, էջի սքրինշոթն ուղարկվում է սերվերին։ <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium-ը ձեր կանխադրված դիտարկիչն է</translation>
<translation id="1131805035311359397">Որպեսզի պաշտպանեք ձեր գաղտնաբառերը տվյալների արտահոսքից և խուսափեք անվտանգության հետ կապված այլ խնդիրներից, <ph name="BEGIN_LINK" />մտեք հաշիվ Chromium դիտարկիչում<ph name="END_LINK" />։</translation>
<translation id="3458316367708035110">{COUNT,plural, =1{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Optimium-ը։ Բացված է ինկոգնիտո կամ մեկուսացված պատուհան։ Վերագործարկումից հետո այն նորից չի բացվի։}one{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Optimium-ը։ Պրոֆիլներում բացված է # ինկոգնիտո կամ մեկուսացված պատուհան։ Վերագործարկումից հետո այն նորից չի բացվի։}other{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Optimium-ը։ Պրոֆիլներում բացված է # ինկոգնիտո և մեկուսացված պատուհան։ Վերագործարկումից հետո դրանք նորից չեն բացվի։}}</translation>
<translation id="1150418667633096194">Գործիքագոտու «Google Որոնման կողային վահանակ» կոճակը նոր պատկերակ ունի։ Սեղմեք այն՝ Google Որոնման կողային վահանակի միջոցով դիտարկման ընթացքում հարցեր տալու համար։</translation>
<translation id="759898790519515623">Սեղմեք Optimium-ի ընտրացանկը</translation>
<translation id="1157952955648710254">Փակել Google Որոնման կողային վահանակը</translation>
<translation id="1157985233335035034">Վերջերս ընտրված լեզուներ</translation>
<translation id="1184145431117212167">Տեղադրումը ձախողվեց, քանի որ Windows-ի ձեր տարբերակը չի աջակցվում։</translation>
<translation id="1185134272377778587">Chromium-ի մասին</translation>
<translation id="5987505065981917957">Ստացեք գների հետագծման ծանուցումներ ձեր հեռախոսի Optimium դիտարկիչում</translation>
<translation id="1203500561924088507">Շնորհակալություն տեղադրելու համար։ Նախքան <ph name="BUNDLE_NAME" />-ն օգտագործելը դուք պետք է վերագործարկեք ձեր դիտարկիչը։</translation>
<translation id="1232234696885483911">Երբ բացեք «Որոնում պատկերով» գործառույթը, էջի վերնագիրը, URL-ը և բովանդակությունը՝ ներառյալ PDF-ները, ավտոմատ կուղարկվեն սերվերին։ <ph name="LEARN_MORE" /></translation>
<translation id="3560913454241378492">Հաշիվ մուտք գործած ժամանակ Optimium-ում դուք կարող եք օգտագործել ձեր գաղտնաբառերն ու մյուս կարգավորումները ձեր Google հաշվից։ Այս կարգավորումը փոխելու համար անցեք «Ձեր հաշիվը Optimium-ում» բաժին։</translation>
<translation id="8922965532693587493">Ցույց տալ «Gemini-ը Optimium-ում» հավելվածը Mac-ի ընտրացանկի գոտում</translation>
<translation id="236433590733312836">«Gemini-ը Optimium-ում» հավելվածում էկրանի մի մասն ընտրելու համար օգտագործել ստեղնային դյուրանցում։</translation>
<translation id="7976124325589452515">Մինչ այս ներդիրն ակտիվ չէր, Optimium-ի աշխատանքի արագությունը պահպանելու համար տարածք է ազատվել։ Դուք կարող եք ընտրել, որ այս կայքը միշտ ակտիվ մնա։</translation>
<translation id="2758503437544511902">Optimium-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը վտանգավոր է</translation>
<translation id="126567311906253476">Երբ <ph name="USER_EMAIL" /> հաշվի միջոցով մուտք եք գործում Google-ի ծառայություններ, օր․՝ Gmail կամ YouTube, նույն հաշվի միջոցով կարող եք ավտոմատ մուտք գործել Chrome</translation>
<translation id="4104061172701635162">Ներբեռնեք Optimium-ը ձեր հեռախոսում</translation>
<translation id="1290883685122687410">Կարգավորման սխալ՝ <ph name="METAINSTALLER_EXIT_CODE" />։ <ph name="WINDOWS_ERROR" /></translation>
<translation id="3443894627866827446">Կարգավորեք Optimium-ի ձեր նոր պրոֆիլը</translation>
<translation id="8946186262159916495">Փորձել Gemini-ը Optimium-ում</translation>
<translation id="7981347318091963592">Optimium-ին անհրաժեշտ է Bluetooth-ի հասանելիություն՝
 Bluetooth սարքեր որոնելու համար։ <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6099322702899630168">Մուտք գործեք Optimium ձեր հեռախոսում</translation>
<translation id="1330562121671411446">Ճանաչել լեզուն</translation>
<translation id="3294414641786025647">Նաև հեռացնել տվյալները Optimium-ից (<ph name="URL" />)</translation>
<translation id="4214354213779528068">{COUNT,plural, =1{Համաձայն Լրացուցիչ պաշտպանության կարգավորումների՝ թարմացումը կիրառելու համար անհրաժեշտ է վերագործարկել Optimium-ը։ Բացված է ինկոգնիտո կամ մեկուսացված պատուհան։ Վերագործարկումից հետո այն նորից չի բացվի։}one{Համաձայն Լրացուցիչ պաշտպանության կարգավորումների՝ թարմացումը կիրառելու համար անհրաժեշտ է վերագործարկել Optimium-ը։ Պրոֆիլներում բացված է # ինկոգնիտո կամ մեկուսացված պատուհան։ Վերագործարկումից հետո այն նորից չի բացվի։}other{Համաձայն Լրացուցիչ պաշտպանության կարգավորումների՝ թարմացումը կիրառելու համար անհրաժեշտ է վերագործարկել Optimium-ը։ Պրոֆիլներում բացված է # ինկոգնիտո և մեկուսացված պատուհան։ Վերագործարկումից հետո դրանք նորից չեն բացվի։}}</translation>
<translation id="1345251407431278948">«Որոնում պատկերով» գործառույթն ամրացված է․ այն բացելու համար օգտագործեք գործիքագոտու նոր կոճակը</translation>
<translation id="1383876407941801731">Որոնում</translation>
<translation id="7825299065989465359">Շարունակեք դիտարկումը Optimium հավելվածի միջոցով՝ շարժման մեջ</translation>
<translation id="141901961143729572">Կիսվեք ձեր մտքերով</translation>
<translation id="1438812738230833934">Դուք կարող եք նորից բացել Google Որոնումը կողային վահանակում՝ դիտարկման ընթացքում հարցեր տալու համար</translation>
<translation id="4131307166987455854">Ձեր պատուհանով կիսվելու համար Համակարգի կարգավորումներում թույլատրեք էկրանի տեսագրումը Optimium-ի համար։</translation>
<translation id="1470136641087909499">Դուք կարող եք նորից բացել Google Որոնումը Chrome-ում՝ դիտարկման ընթացքում հարցեր տալու համար</translation>
<translation id="1478370723027452770">Ստանալ օգնություն Chrome for Testing-ի միջոցով</translation>
<translation id="9200022682397754538">Մուտք գործեք Optimium՝ ձեր պահված տեղեկություններն ու այլ տվյալներ <ph name="DEVICE" />ից օգտագործելու համար</translation>
<translation id="1497802159252041924">Տեղադրման սխալ՝ <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Այս էջը պաշտպանված է</translation>
<translation id="892690000529877604">Կիսվեք Optimium-ի ներդիրով</translation>
<translation id="15408169957028265">Նորից բացել Google Որոնումը Chrome-ում</translation>
<translation id="9039191226880557963">Մուտք գործել Optimium</translation>
<translation id="1547469039832541117">Ավարտում է ընդգծված առաջադրանքը։</translation>
<translation id="4414991100979797293">Ամրացնել Optimium-ը</translation>
<translation id="1574377791422810894">Chromium-ի անվտանգության գործիքներ</translation>
<translation id="3934587628489930735">Optimium-ը ուզում է ջնջել Գաղտնաբառերի կառավարչի ձեր տվյալները։ Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը։</translation>
<translation id="6745390171113033635">{COUNT,plural, =0{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Optimium-ը}=1{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Optimium-ը։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Optimium-ը։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Optimium-ը։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="7186551909256266009">Օգտվեք Google-ի բոլոր առավելություններից ձեր հեռախոսի Optimium հավելվածի միջոցով</translation>
<translation id="1625909126243026060">Դիտեք գաղտնիության և անվտանգության հիմնական կառավարման տարրերը Chromium-ում։</translation>
<translation id="1640672724030957280">Ներբեռնում…</translation>
<translation id="1648201623125974721">Նոր պատկերակ, նույն դյուրանցումը․ սեղմեք՝ համատեքստային առաջադրանքների միջոցով դիտարկման ընթացքում հարցեր տալու համար։</translation>
<translation id="1665602916345474427">Մուտք եք գործել որպես <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, բաժանորդագրություն։ Բացել հաշվի ընտրացանկը</translation>
<translation id="1708414395296835197">Օգտագործեք Chromium-ը ցանկացած ժամանակ, երբ սեղմում եք հաղորդագրություններում, փաստաթղթերում և այլ հավելվածներում առկա հղումների վրա։ Այն նաև կամրացվի հավելվածների վահանակում։</translation>
<translation id="1709772298389099340">Ընդլայնված արտոնություններ է տալիս <ph name="BROWSER_NAME" />-ին։</translation>
<translation id="1722488837206509557">Սա ձեզ թույլ կտա ընտություն կատարել հասանելի սարքերից և բովանդակություն ցուցադրել այդ սարքերում։</translation>
<translation id="6717880500969720524">Optimium-ը շուտով կջնջի դիտարկման տվյալները</translation>
<translation id="1736443181683099871">Chromium-ը կփորձի անցնել HTTPS հաղորդակարգի</translation>
<translation id="4418738262462299802">Optimium-ի տվյալները մաքրվեցին</translation>
<translation id="8469746761106187775">Optimium-ը կվերագործարկվի <ph name="REMAINING_TIME" />ից</translation>
<translation id="1749104137266986751">Երբ HTTPS հաղորդակարգը հասանելի չէ, Chromium-ը առանց ձեզ զգուշացնելու կօգտագործի ոչ ապահով միացում</translation>
<translation id="1769661297620183092">Դուք կարող եք նորից բացել Google Որոնման վահանակը՝ դիտարկման ընթացքում հարցեր տալու համար</translation>
<translation id="6555789357989792722">Թույլ տալ Optimium-ին աշխատել հետնաշերտում</translation>
<translation id="627441522449241646">Optimium-ն ավելի ապահով դարձնելու համար որոշ ընդլայնումներ, որոնք նշված չեն <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ում և կարող են ավելացվել առանց ձեր իմացության, անջատվել են։</translation>
<translation id="1912380661217770781">Սեղմեք <ph name="BEGIN_BOLD" />Այո<ph name="END_BOLD" /> Windows-ի ծանուցման մեջ՝ Optimium-ը հավելվածների վահանակում ամրացնելու համար։</translation>
<translation id="9034578483087384251">Նորից տեղադրել Optimium-ը</translation>
<translation id="2856362667064664106">Optimium-ը փորձում է <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="1665590461646883113"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Optimium <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Ձեզ նաև հասանելի կլինեն ընդլայնումները և այլ տվյալներ <ph name="DEVICE" />։</translation>
<translation id="1668665535355826445">Հաջորդ անգամ, երբ ձեր <ph name="DEVICE_TYPE" /> սարքում բացեք Optimium-ը, կտեսնեք Google գաղտնաբառերի կառավարիչն օգտագործելու հրավեր։</translation>
<translation id="1838374766361614909">Մաքրել որոնումը</translation>
<translation id="8674417702521959187">Այցելությունների պատմությունը միայն այս սարքից ջնջելու, սակայն Google հաշվում պահպանելու համար <ph name="BEGIN_LINK" />դուրս եկեք Optimium-ից<ph name="END_LINK" />։</translation>
<translation id="6186721318460238018">Ներբեռնեք Optimium-ը հեռախոսում՝ ցանկացած վայրից ներդիրների նոր խմբեր բացելու կամ ստեղծելու համար։</translation>
<translation id="185970820835152459">Դուք կարող եք կառավարել ձեր Google հաշիվները, որոնցում մուտք եք գործել։ Դրանք օգտագործվում են Chromium դիտարկիչում, Play Խանութում, Gmail-ում և այլ ծառայություններում։ Եթե ուզում եք ընտանեկան խմբի անդամի կամ մեկ ուրիշի համար հաշիվ ավելացնել, <ph name="DEVICE_TYPE" /> սարքում ավելացրեք նոր օգտատեր։ <ph name="LINK_BEGIN" />Իմանալ ավելին<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Որոնել «Որոնում պատկերով» գործառույթի միջոցով</translation>
<translation id="1781731701613313704"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Optimium <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Ձեզ նաև հասանելի կլինեն էջանիշները և այլ տվյալներ <ph name="DEVICE" />։</translation>
<translation id="1880677175115548835">Ընտրեք տեքստը</translation>
<translation id="5960850334733792580">Դուք մուտք եք գործում վերահսկվող հաշիվ` թույլ տալով ադմինիստրատորին վերահսկել ձեր Optimium պրոֆիլը: Ձեր Optimium տվյալները, ինչպես օրինակ՝ հավելվածները, էջանիշները, պատմությունը, գաղտնաբառերը և այլ կարգավորումները մշտապես կկցվեն <ph name="USER_NAME" />-ին: Դուք կարող եք ջնջել այս տվյալները Google Dashboard-ի միջոցով, սակայն չեք կարող համակցել այս տվյալները այլ հաշվի հետ: Կարող եք ստեղծել նոր պրոֆիլ՝ ձեր առկա Optimium տվյալներն առանձին պահելու համար: <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium-ը տնտեսում է մարտկոցի լիցքը՝ սահմանափակելով աշխատանքը ֆոնային ռեժիմում և վիզուալ էֆեկտները, օրինակ՝ սահուն ոլորումը և տեսանյութերի կադրերի հաճախականությունը։ <ph name="BEGIN_LINK" />Իմանալ ավելին Էներգիայի խնայման մասին<ph name="END_LINK" /></translation>
<translation id="7900167719031567542">Optimium Updater ծառայություն</translation>
<translation id="1911763535808217981">Անջատելով այս գործառույթը՝ դուք կարող եք մտնել հաշիվ Google-ի կայքերում, օրինակ՝ Gmail, առանց մուտք գործելու Chromium:</translation>
<translation id="5015349619125768393">Optimium-ը չի պատասխանում: Վերագործարկե՞լ:</translation>
<translation id="2019000760486664637">Ձեր կազմակերպության (<ph name="MANAGER" />) կանոնների համաձայն՝ դուք պետք է մուտք գործեք Optimium</translation>
<translation id="193439633299369377">Թարմացումը կիրառելու համար հարկավոր է վերագործարկել ChromiumOS-ը։</translation>
<translation id="3382368450324191331">Optimium-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլի այս տեսակը հազվադեպ է ներբեռնվում, և այն կարող է վտանգավոր լինել</translation>
<translation id="1953553007165777902">Ներբեռնում… Մնաց <ph name="MINUTE" /> րոպե</translation>
<translation id="1966382378801805537">Chromium-ը չի կարողանում որոշել կամ սահմանել կանխադրված դիտարկիչը</translation>
<translation id="197326043290947695">Որոնեք ավելի խելացի կերպով «Որոնում պատկերով» գործառույթի միջոցով</translation>
<translation id="5321661580966500942">Իմացեք, թե ինչու է Optimium-ն արգելափակում որոշ ֆայլեր կամ բացում նոր ներդիրում</translation>
<translation id="8960045458031480819">Թարմացնում է Optimium-ի ծրագրակազմը։ Եթե անջատեք կամ դադարեցնեք ծառայությունը, դա կարող է հանգեցնել նրան, որ ի հայտ եկած խոցելիությունները չշտկվեն, և որոշ գործառույթներ չաշխատեն։ Այս ծառայությունն ավտոմատ կհեռացվի, եթե չկա Optimium-ի ծրագրակազմ, որն օգտագործում է այն։</translation>
<translation id="2008474315282236005">1 տարր կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք Chromium <ph name="USER_EMAIL" /> հաշվով:</translation>
<translation id="2018879682492276940">Չհաջողվեց տեղադրել։ Նորից փորձեք։</translation>
<translation id="2039417478970545937">Կարգավորումներ։</translation>
<translation id="2049376729098081731">Ընտրեք, թե արդյոք ներառել Chromium-ի պատմությունը՝ Google-ի ծառայությունների ավելի անհատականացված օգտագործման համար։</translation>
<translation id="4120951192672345208">Ներկառուցված է Optimium-ում՝ օգնելու ձեզ ստեղծել, պահել և ավտոմատ լրացնել հուսալի գաղտնաբառեր։ Ավելացրեք դյուրանցումը՝ արագ մուտքի համար։</translation>
<translation id="2060311596979880693">Պատրաստ է․ այժմ դուք կարող եք հեշտությամբ հարցեր տալ դիտարկման ընթացքում՝ Google Որոնման օգնությամբ Chrome-ում</translation>
<translation id="7165258062917217746">Սեղմեք «Անհատականացնել Optimium-ը» կոճակը նոր ներդիրի էջում՝ Optimium-ին նոր տեսք հաղորդելու համար</translation>
<translation id="3702823791268559760">Optimium-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը կասկածելի է և կարող է անսպասելի փոփոխություններ կատարել ձեր սարքում</translation>
<translation id="2370804817835146114">Հաջորդ անգամ Optimium iOS-ը բացելիս կտեսնեք <ph name="FEATURE_NAME" /> գործառույթը փորձելու հրավեր։</translation>
<translation id="5887094242311035059">Ձեր գաղտնաբառերն ու Optimium-ի մյուս տվյալները, որոնք պահել եք ձեր Google հաշվում, կհեռացվեն այս սարքից։ Optimium-ում դրանք նորից օգտագործելու համար պետք է կրկին մուտք գործեք։</translation>
<translation id="8794268168383660193">{COUNT,plural, =1{Ձեր կազմակերպությունն ավտոմատ ջնջում է այցելությունների պատմությունը, երբ Optimium-ը 1 րոպե չի օգտագործվում։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։ Ձեր ներդիրները բացված կմնան։}one{Ձեր կազմակերպությունն ավտոմատ ջնջում է այցելությունների պատմությունը, երբ Optimium-ը # րոպե չի օգտագործվում։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։ Ձեր ներդիրները բացված կմնան։}other{Ձեր կազմակերպությունն ավտոմատ ջնջում է այցելությունների պատմությունը, երբ Optimium-ը # րոպե չի օգտագործվում։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։ Ձեր ներդիրները բացված կմնան։}}</translation>
<translation id="2125838419757773031">Որոնելու համար ընտրեք էկրանի տարածքը</translation>
<translation id="2126108037660393668">Ներբեռնված ֆայլը չանցավ հաստատումը։</translation>
<translation id="2135919691573380097">Հաղորդել այս կայքի մասին</translation>
<translation id="2137162749895930932">Փակել թարգմանել պատուհանը</translation>
<translation id="2147218225094845757">Թաքցնել կողային վահանակը</translation>
<translation id="8888656790178891761">Optimium-ն արգելափակել է այս ներբեռնումը, քանի որ կայքը չի օգտագործում անվտանգ կապ, և ֆայլում, հնարավոր է, չարտոնված գործողություններ են կատարվել</translation>
<translation id="2170098639895543546">Ընտրեք ցանկացած բան էջում</translation>
<translation id="6975401993318112971">Անհատականացնել Optimium-ը</translation>
<translation id="2174917724755363426">Տեղադրումը չի ավարտվել։ Իսկապե՞ս ուզում եք չեղարկել։</translation>
<translation id="7741769305753410467">Optimium – Ցանցի մուտք – <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Թարմացումների ստուգման սխալ՝ <ph name="UPDATE_CHECK_ERROR" />։</translation>
<translation id="2133097742403140075">Հեռացնել հաշիվը Optimium-ից</translation>
<translation id="6495056863394621013">Օգտագործեք Optimium հավելվածը՝ գնումների համար լավագույն գործիքներից շարժման մեջ օգտվելու համար</translation>
<translation id="2209877494277346829">Մեկուսացնել Chromium-ը այլ հավելվածներից</translation>
<translation id="2035198300681156782">iOS-ի համար Optimium-ում բարելավված Ապահով դիտարկումը կօգնի պաշտպանել բջջային սարքերի տվյալները</translation>
<translation id="2210682093923538346">Վտանգավոր կայք։ Chromium-ը հեռացրել է ծանուցումների թույլտվությունը։</translation>
<translation id="2236949375853147973">Իմ գործողությունները</translation>
<translation id="871771486544954531">Հասցեները և այլ տվյալներ ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք Optimium։ Այս հասցեն կպահվի ձեր Google հաշվում, երբ մուտք գործեք։</translation>
<translation id="524316078518338158">Եթե ձեզնից բացի որևէ այլ մեկն օգտվում է այս համակարգչից, օրինակ ձեր ընկերները կամ հարազատները, ապա նրանք կարող են առանձին աշխատել և կարգավորել Optimium-ն իրենց ուզած ձևով:</translation>
<translation id="22571759390241347">Հմտություններ Chromium-ում</translation>
<translation id="2283228908180457226">Նոր պատկերակ, նույն դյուրանցումը․ սեղմեք՝ դիտարկման ընթացքում Google Որոնման կողային վահանակի միջոցով հարցեր տալու համար։</translation>
<translation id="2283803047247799269">Որոնել այս ներդիրը պատկերով որոնման միջոցով</translation>
<translation id="5808794606375505413">{NUM_TABS,plural, =1{Optimium-ը խորհուրդ է տալիս դադարեցնել ներդիրը, որը դադաղեցնում է ձեր դիտարկիչը}one{Optimium-ը խորհուրդ է տալիս դադարեցնել ներդիրները, որոնք դանդաղեցնում են ձեր դիտարկիչը}other{Optimium-ը խորհուրդ է տալիս դադարեցնել ներդիրները, որոնք դանդաղեցնում են ձեր դիտարկիչը}}</translation>
<translation id="2307973900865360088">Ամրացնել Dock վահանակի վրա</translation>
<translation id="2313870531055795960">Ստուգում է URL-ները Chromium-ում պահված վտանգավոր կայքերի ցանկի միջոցով։ Եթե կայքը փորձում է գողանալ ձեր գաղտնաբառը, կամ երբ վնասակար ֆայլ եք ներբեռնում, Chromium-ը կարող է ուղարկել URL-ն ու էջի բովանդակությունը՝ անվտանգ դիտարկման միջոցով ստուգելու համար։</translation>
<translation id="2356070529366658676">Հարցնել</translation>
<translation id="2359808026110333948">Շարունակել</translation>
<translation id="7000103009822967939">«<ph name="EXTENSION_NAME" />» ընդլայնումն ուզում է, որ դուք մուտք գործեք Optimium</translation>
<translation id="184381469736757112">Անջատել Optimium-ի ֆոնային ռեժիմը հավելվածների համար</translation>
<translation id="5141894774016157674">Այս ընդլայնումը որպես <ph name="USER_EMAIL_ADDRESS" /> օգտագործելու համար մուտք գործեք Optimium։</translation>
<translation id="2384373936468275798">ChromiumOS-ին չհաջողվեց համաժամացնել տվյալները, քանի որ ձեր հաշվի մուտքի տվյալները հնացած են։</translation>
<translation id="2523694910556579068">{NUM_DEVICES,plural, =0{Optimium-ի մեկ կամ մի քանի ընդլայնում ստացել է 1 HID սարքի հասանելիություն}=1{Optimium-ի մեկ կամ մի քանի ընդլայնման հասանելի է 1 HID սարք}one{Optimium-ի մեկ կամ մի քանի ընդլայնման հասանելի է # HID սարք}other{Optimium-ի մեկ կամ մի քանի ընդլայնման հասանելի է # HID սարք}}</translation>
<translation id="2899976927368522713">Այս կայքի համար Optimium-ին անհրաժեշտ է խոսափողն ու տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="2403703063067034158">Մեկնարկի սխալ․ ներկայումս կարգավորման մեկ այլ օրինակ է աշխատում։ Փորձեք ավելի ուշ։</translation>
<translation id="8530786035410512232">Բացեք հղումները Optimium-ում ցանկացած հավելվածից և պահեք դիտարկիչը հավելվածների վահանակում՝ հեշտ մուտքի համար</translation>
<translation id="5645058843566501763">Սեղմեք «Ամփոփել» կոճակը՝ այս փաստաթղթով Gemini-ի հետ Optimium-ում կիսվելու համար, որպեսզի ստանաք համառոտ նկարագրություն և լրացուցիչ հարցեր տաք</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Chromium-ի գործիքների<ph name="END_LINK" /> միջոցով դուք կարող եք ապահով դիտարկել և կառավարել կարգավորումները</translation>
<translation id="5384013849288198705"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Optimium <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Գաղտնաբառերը և մյուս տվյալները նույնպես կհայտնվեն ձեր բոլոր սարքերում։</translation>
<translation id="2451727308784734061">Արագ բացեք Գաղտնաբառերի կառավարիչը դյուրանցման միջոցով։ Դյուրանցումը կարող եք տեղափոխել համակարգչի հիմնական էկրան կամ հավելվածների գործարկիչ։</translation>
<translation id="4074322039453189342">Optimium-ը շուտով կփակվի</translation>
<translation id="4239399282729309306">Optimium-ի մեջ</translation>
<translation id="2485422356828889247">Ապատեղադրել</translation>
<translation id="2513154137948333830">Հարկավոր է վերաբեռնել. <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2521391734665471391">Փակել Google Որոնման ԱԲ ռեժիմը</translation>
<translation id="2542968102051442371">Ընտրեք տեքստ «Որոնում պատկերով» գործառույթի միջոցով</translation>
<translation id="7238239459452345825">Optimium-ը փորձում է փոխարինել գոյություն ունեցող գաղտնաբառերը։ Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը։</translation>
<translation id="5059411697679064446">Ֆայլեր ներբեռնելու համար Optimium-ին անհրաժեշտ է պահեստի օգտագործման թույլտվություն</translation>
<translation id="5959299320608819381">Optimium օգնական</translation>
<translation id="2575822587468774919">Ընտրեք ցանկացած բան՝ «Որոնում պատկերով» գործառույթի միջոցով որոնելու համար</translation>
<translation id="8063772441784541423">Գաղտնաբառերը և մյուս տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք Optimium</translation>
<translation id="3112793931795471365">Հեռախոսով սկանավորեք QR կոդը՝ Optimium-ը ներբեռնելու և ձեր Google հաշիվ մուտք գործելու համար։</translation>
<translation id="1584670114556742260">Optimium-ով որոնելու համար։</translation>
<translation id="2680687985294820735">Շարունակել Optimium-ի օգտագործումը</translation>
<translation id="259935314519650377">Չհաջողվեց քեշավորել ներբեռնված տեղադրիչը։ Սխալ՝ <ph name="UNPACK_CACHING_ERROR_CODE" />։</translation>
<translation id="2620436844016719705">Համակարգ</translation>
<translation id="7753906894780562903">Ձեր կազմակերպությունը կարող է տեսնել և կառավարել այցելությունների պատմությունը, օրինակ՝ էջանիշները, պատմությունը և գաղտնաբառերը։ Optimium-ի անձնական պրոֆիլներում այցելությունների պատմությունը հասանելի չի լինի ձեր կազմակերպությանը։</translation>
<translation id="3912526786507084695">Հաստատեք ձեր ինքնությունը, որպեսզի օգտագործեք և պահեք Optimium-ի տվյալները ձեր <ph name="ACCOUNT_EMAIL" /> հաշվում</translation>
<translation id="1723346026518998062">{COUNT,plural, =0{Համաձայն Լրացուցիչ պաշտպանության կարգավորումների՝ թարմացումը կիրառելու համար անհրաժեշտ է վերագործարկել Optimium-ը}=1{Համաձայն Լրացուցիչ պաշտպանության կարգավորումների՝ թարմացումը կիրառելու համար անհրաժեշտ է վերագործարկել Optimium-ը։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Համաձայն Լրացուցիչ պաշտպանության կարգավորումների՝ թարմացումը կիրառելու համար անհրաժեշտ է վերագործարկել Optimium-ը։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Համաձայն Լրացուցիչ պաշտպանության կարգավորումների՝ թարմացումը կիրառելու համար անհրաժեշտ է վերագործարկել Optimium-ը։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="1676939910504260523">Գործարկել Optimium-ը</translation>
<translation id="4524556064279918264">Տեղադրման ժամանակ օպերացիոն համակարգի սխալ տեղի ունեցավ: Նորից տեղադրեք Optimium-ը:</translation>
<translation id="1998551382060432430">Եթե ձեզնից բացի որևէ այլ օգտատեր օգտվում է այս սարքից (օրինակ՝ ձեր ընկերները կամ հարազատները), ապա նրանք կարող են առանձին աշխատել և անհատականացնել Optimium-ը</translation>
<translation id="5180414833025415316">Թույլ է տալիս արագ բացել «Gemini-ը Optimium-ում» հավելվածը ձեր սարքում, նույնիսկ եթե Optimium-ը ծալված է։</translation>
<translation id="5895170254499246640">Optimium-ի ներդիր</translation>
<translation id="2718390899429598676">Լրացուցիչ անվտանգության համար Chromium-ը կգաղտնագրի ձեր տվյալները:</translation>
<translation id="6684098000857849465">Ձեր Google հաշիվը Optimium-ից հեռացնելու համար դուրս եկեք հաշվից</translation>
<translation id="8035579362848370000">Գաղտնաբառերը, էջանիշները և մյուս տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք Optimium</translation>
<translation id="2738871930057338499">Հնարավոր չէ միանալ ինտերնետին։ HTTP 403 Forbidden։ Ստուգեք ձեր պրոքսի սերվերի կազմաձևը։</translation>
<translation id="2753623023919742414">Սեղմեք որոնելու համար</translation>
<translation id="6013736131971103780">Սահմանեք Optimium-ը որպես ձեր կանխադրված PDF դիտակ</translation>
<translation id="218391145495840504">Այս ընդլայնումը պարունակում է վնասագիր և վտանգավոր է։ Հեռացրեք ընդլայնումը Optimium-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="2799223571221894425">Վերագործարկել</translation>
<translation id="8757776333711121842">Ձեր Optimium-ը</translation>
<translation id="2816462166102338036">Որոնել այս տեսանյութը պատկերով որոնման միջոցով</translation>
<translation id="8289509301112665497">Ուշադրություն․ Optimium-ը չի կարող արգելել ընդլայնումներին գրանցել ձեր այցելությունների պատմությունը։ Ընդլայնումը մեկուսացված ռեժիմում անջատելու համար չեղարկեք այս պարամետրի ընտրությունը։</translation>
<translation id="5977650568712460613">Գտեք ապրանքներ ձեր տեսախցիկի օգնությամբ, հետևեք գնիջեցումներին և ավելին արեք շարժման մեջ՝ iOS-ի համար Optimium հավելվածի միջոցով։</translation>
<translation id="2841525013647267359">Թարգմանվող լեզու</translation>
<translation id="2846251086934905009">Տեղադրման սխալ. չհաջողվեց ավարտել տեղադրումը։ Գործընթացն ընդհատվել է։</translation>
<translation id="7445294455857704594">Հեռացնել Optimium-ից...</translation>
<translation id="2850691299438350830">Ապահովում է ձեր անվտանգությունը Chromium-ում և Google հավելվածներում, երբ մտել եք ձեր հաշիվ։</translation>
<translation id="2876152561415416331">Նորից բացել Google Որոնման վահանակը</translation>
<translation id="2885378588091291677">Task Manager</translation>
<translation id="8130920144001221645">&amp;Optimium-ի մասին</translation>
<translation id="2915996080311180594">Վերագործարկել ավելի ուշ</translation>
<translation id="5422843128705358539">Ձեր տվյալները գաղտնագրված են անցաբառով։ Optimium-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը։</translation>
<translation id="2945997411976714835">Տեղադրման սխալ. չհաջողվեց սկսել տեղադրումը։</translation>
<translation id="7644909281692978299">Ավելի արագ մուտք գործեք կայքեր՝ օգտագործելով iOS-ի համար Optimium-ում պահված գաղտնաբառերը</translation>
<translation id="6715328262141930431">Optimium-ը կառավարվում է ձեր կազմակերպության կողմից</translation>
<translation id="2977470724722393594">Chromium-ը թարմացված է</translation>
<translation id="2977506796191543575">Եթե կայքը փորձում է գողանալ ձեր գաղտնաբառը, կամ երբ վնասակար ֆայլ եք ներբեռնում, Chromium-ը կարող է ուղարկել URL-ն ու էջի բովանդակությունը՝ Ապահով դիտարկման միջոցով ստուգելու համար։</translation>
<translation id="3373190939774209520">Ձեր ծնողների ընտրած ավելի անվտանգ կարգավորումներն օգտագործելու համար մուտք գործեք Optimium</translation>
<translation id="2992577225802060159">Պաշտպանում է Chromium-ի հիշողությունը ձեր համակարգչի այլ հավելվածներից։</translation>
<translation id="3003694935412297923">Բոլոր առաջադրանքները</translation>
<translation id="2169110625780321257">{count,plural, =1{Որպեսզի որոշ տվյալներ հնարավոր լինի պահել Google հաշվում, և դուք կարողանաք օգտագործել դրանք ձեր բոլոր սարքերում, Optimium-ը նախ պետք է հաստատի ձեր ինքնությունը։ Եթե դուրս գաք հիմա, այս տվյալները (1 տարր) կջնջվեն։}one{Որպեսզի որոշ տվյալներ հնարավոր լինի պահել Google հաշվում, և դուք կարողանաք օգտագործել դրանք ձեր բոլոր սարքերում, Optimium-ը նախ պետք է հաստատի ձեր ինքնությունը։ Եթե դուրս գաք հիմա, այս տվյալները ({count} տարր) կջնջվեն։}other{Որպեսզի որոշ տվյալներ հնարավոր լինի պահել Google հաշվում, և դուք կարողանաք օգտագործել դրանք ձեր բոլոր սարքերում, Optimium-ը նախ պետք է հաստատի ձեր ինքնությունը։ Եթե դուրս գաք հիմա, այս տվյալները ({count} տարր) կջնջվեն։}}</translation>
<translation id="535155819036938485">Բացել <ph name="URL" /> հղումը Optimium-ի նոր ներդիրում։</translation>
<translation id="302551344979399011">ԱԲ նորարարությունները, օրինակ՝ հմտությունները, պահվում են ձեր Google հաշվում և կառավարվում են Chromium-ի համաժամացումից առանձին</translation>
<translation id="69529237724150463">Մուտք գործեք Optimium՝ ձեր բոլոր սարքերում ընդլայնումները և այլ տվյալներ օգտագործելու համար</translation>
<translation id="1699367992046240140">Ավելացվում է Optimium-ին…</translation>
<translation id="3034219227076811559">Google Որոնումը Chrome-ում</translation>
<translation id="3037190258341683404">Դուք կարող եք ամրացնել Google Որոնումը Chrome-ում, որպեսզի հարցեր տաք դիտարկման ընթացքում</translation>
<translation id="3038232873781883849">Սպասում ենք տեղադրմանը…</translation>
<translation id="3045032126857188731">Թարգմանության լեզուն՝ <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Փակել կարծիքով երկխոսության պատուհանը</translation>
<translation id="7641708778616103377"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Optimium <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Ձեզ նաև հասանելի կլինեն ընթերցանության ցանկը և այլ տվյալներ <ph name="DEVICE" />։</translation>
<translation id="1759532319192341458">Optimium-ի այլ պրոֆիլներ</translation>
<translation id="2862149341123916634">Ընդլայնումները հավելումներ են, որոնք թույլ են տալիս անհատականացնել Optimium-ը։ Դրանք օգնում են կազմակերպել աշխատանքը, պարզեցնել առօրյա առաջադրանքները և անհատականացնել Optimium-ը։</translation>
<translation id="9144026989666254609">Օգնեք բարելավել Optimium-ը՝ Google-ին ուղարկելով խափանման մասին հաշվետվությունները և <ph name="UMA_LINK" />ը</translation>
<translation id="4449472527250709676">Օգտագործեք Google-ի անվտանգության գործառույթները Optimium հավելվածի միջոցով՝ շարժման մեջ</translation>
<translation id="6183456495642882201">{NUM_DEVICES,plural, =0{Optimium-ի մեկ կամ մի քանի ընդլայնում ստացել է 1 USB սարքի հասանելիություն}=1{Optimium-ի մեկ կամ մի քանի ընդլայնման հասանելի է 1 USB սարք}one{Optimium-ի մեկ կամ մի քանի ընդլայնման հասանելի է # USB սարք}other{Optimium-ի մեկ կամ մի քանի ընդլայնման հասանելի է # USB սարք}}</translation>
<translation id="7419486418212185022">Մուտք գործեք Optimium՝ ձեր ընթերցանության ցանկը և այլ տվյալներ <ph name="DEVICE" />ից օգտագործելու համար</translation>
<translation id="4481023367748355854">Optimium-ի պատմություն</translation>
<translation id="6289574887308484514">Տեղադրիչը չկարողացավ բացել արխիվը: Նորից ներբեռնեք Optimium-ը:</translation>
<translation id="310459126943037700">Չհաջողվեց ավարտել առաջադրանք(ներ)ը։</translation>
<translation id="3104828284009500087">Որոնեք ցանկացած բան էջում</translation>
<translation id="1866751185142421235">Ձեր գաղտնաբառերը, էջանիշները և պատմությունը կհամաժամացվեն ձեր բոլոր սարքերում։ Հեշտությամբ օգտագործեք ձեզ ծանոթ և սիրելի գործառույթները՝ որպես կանխադրված դիտարկիչ ընտրելով Optimium-ը։</translation>
<translation id="7071720283847574213">Optimium-ն օգտագործում է ձեր խոսափողը:</translation>
<translation id="3130333203120345554">Նոր որոնում</translation>
<translation id="3137969841538672700">Քաշեք որոնելու համար</translation>
<translation id="8832375982733310873">Այս ներդիրն օգտագործում է լրացուցիչ ռեսուրսներ։ Թույլատրեք Optimium-ին ապակտիվացնել այն, և աշխատանքի արդյունավետությունը կբարձրանա։</translation>
<translation id="7212905776009358992">Ձեր էկրանով կիսվելու համար Համակարգի կարգավորումներում թույլատրեք էկրանի տեսագրումը Optimium-ի համար</translation>
<translation id="7220401039380362840">Optimium-ի վերագործարկում</translation>
<translation id="3161522574479303604">Բոլոր լեզուները</translation>
<translation id="2945128209475147845">Բացել հղումը Optimium-ի ինկ&amp;ոգնիտո պատուհանում</translation>
<translation id="5550841702580813851">Կարգավորեք Optimium-ի նոր պրոֆիլը</translation>
<translation id="6179644101029308447">Դուք կարող եք շարունակել զրույցը ԱԲ ռեժիմում՝ առանց մեկ ներդիրից մյուսն անցնելու։ Սկսելու համար մուտք գործեք Optimium։ Ձեր գաղտնաբառերը և այլ տվյալներ նույնպես հասանելի կլինեն բոլոր սարքերում։</translation>
<translation id="5843425624301789054">Ձեր Google հաշիվը Optimium-ից հեռացնելու համար դուրս եկեք Optimium-ից «Կարգավորումներ» էջում</translation>
<translation id="3234316605225071811">Հետագայում Chromium-ը կարող է հարցնել, թե արդյոք ուզում եք օգտագործել պահված տեղեկությունները ձևերի ավտոմատ լրացման համար</translation>
<translation id="3381027830404501211">Optimium-ը չի կարող կարդալ և գրել իր տվյալների գրացուցակում՝

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="8146675538658659954">Օգտագործեք Google-ի ԱԲ գործիքները շարժման մեջ՝ iOS-ի համար Optimium-ի միջոցով։</translation>
<translation id="6800117212942659992">Մուտք գործեք Optimium՝ ընդլայնումները և այլ տվյալներ <ph name="DEVICE" />ից օգտագործելու համար</translation>
<translation id="1315108685137442441">{COUNT,plural, =1{Optimium-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր մեկուսացված պատուհանը նորից չի բացվի։}one{Optimium-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր # մեկուսացված պատուհանը նորից չի բացվի։}other{Optimium-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր # մեկուսացված պատուհանները նորից չեն բացվի։}}</translation>
<translation id="3286538390144397061">Վերագործարկել հիմա</translation>
<translation id="2161039902967573767">Google API-ի բանալիները չկան: Optimium-ի որոշ գործառույթներ կանջատվեն:</translation>
<translation id="3296368748942286671">Շարունակել հետնաշերտի հավելվածների աշխատանքը, երբ Chromium-ը փակված է</translation>
<translation id="3313189106987092621">Նախքան ոչ ապահով միացման միջոցով որևէ կայք բեռնելը Chromium-ը ձեզ կնախազգուշացնի</translation>
<translation id="1282007042347821406">Դուք դուրս կգրվեք կայքերի մեծամասնությունից, երբ փակեք Optimium-ի բոլոր պատուհանները, սակայն կմնաք ձեր Google հաշվում, եթե մուտք եք գործել Optimium։ Որպեսզի թույլ տաք կայքերին հիշել ձեզ, <ph name="SETTINGS_LINK" />։</translation>
<translation id="3352986031709923790">որոնման տարածքի վերևի աջ անկյուն՝ <ph name="RIGHT" />% աջից, <ph name="TOP" />% վերևից</translation>
<translation id="3366305173356742781">Chromium-ի տվյալները ձեր հաշվում</translation>
<translation id="3798810966749973116">Օգտագործեք ձեր գաղտնաբառերը ձեր հեռախոսի Optimium դիտարկիչում</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="3114385794555902051">Անցնե՞լ Optimium-ի ընթացիկ պրոֆիլ</translation>
<translation id="3412460710772753638">Այս սարքի Գաղտնաբառերի կառավարիչում</translation>
<translation id="1395799713002454043">Մուտք գործեք Optimium՝ ձեր էջանիշները և այլ տվյալներ <ph name="DEVICE" />ից օգտագործելու համար</translation>
<translation id="3438772217992559640">Որոնել այս ներդիրը պատկերով որոնման միջոցով</translation>
<translation id="1565712261560212491">Ընդլայնեք բարելավված Ապահով դիտարկման հնարավորությունները Optimium-ի հետ ձեր հեռախոսում</translation>
<translation id="7003115800241574875">Optimium-ի անհատականացում…</translation>
<translation id="3474745554856756813"><ph name="ITEMS_COUNT" /> տարր կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք Chromium <ph name="USER_EMAIL" /> հաշվով:</translation>
<translation id="1749327805708308979">Optimium-ի այլ պրոֆիլի կարող եք անցնել <ph name="SHORTCUT" /> ստեղների համադրության միջոցով</translation>
<translation id="7437253251955408447">Փակեք Optimium-ի բոլոր պատուհանները և կրկին փորձեք:</translation>
<translation id="4544226979083343619">Ձեր պատուհանով կիսվելու համար Համակարգի կարգավորումներում թույլատրեք էկրանի տեսագրումը Optimium-ի համար</translation>
<translation id="7742324910239513884"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։  Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Optimium <ph name="USER_EMAIL_ADDRESS" /> հաշվով։</translation>
<translation id="8618656037793872415">QR կոդ՝ Optimium դիտարկիչը շարժական սարքերում ներբեռնելու համար</translation>
<translation id="354621070532799440">Հիշեցում․ Google-ի անվտանգության լավագույն գործառույթները ձեր գրպանում</translation>
<translation id="3043015282185018117">Ձեր էկրանով կիսվելու համար Համակարգի կարգավորումներում թույլատրեք էկրանի տեսագրումը Optimium-ի համար։</translation>
<translation id="3597003331831379823">Չհաջողվեց գործարկել ընդլայնված արտոնություններով կարգավորումը։ <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3261842649996827269">Մուտք գործեք Optimium</translation>
<translation id="1140403329282632523">Այս օգտատիրոջ այցելությունների պատմությունը կհեռացվի այս սարքից։ Տվյալները վերականգնելու համար <ph name="USER_EMAIL" /> հաշվով մուտք գործեք Optimium-ում։</translation>
<translation id="5228011645297638039">{COUNT,plural, =0{Optimium-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։}=1{Optimium-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Optimium-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Optimium-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="3667616615096815454">Չհաջողվեց տեղադրել․ հավելվածն անծանոթ է սերվերի համար։</translation>
<translation id="3675854891107786059">Օգտագործեք <ph name="BEGIN_LINK" />ձեր անցաբառը<ph name="END_LINK" />՝ Chromium-ի բոլոր տվյալները Google հաշվում գաղտնագրելու համար։ Վճարման եղանակները և Google Pay-ի հասցեները չեն գաղտնագրվի։ Chromium-ի այցելությունների պատմությունը չի համաժամացվի։</translation>
<translation id="7861068783030138988">{COUNT,plural, =0{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Optimium-ը}=1{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Optimium-ը։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Optimium-ը։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Optimium-ը։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="8611928240945733486">Բացել հղումը Optimium-ի նոր &amp;ներդիրում</translation>
<translation id="3728124580182886854">Կապեք Chromium-ը Google-ի մյուս ծառայությունների հետ՝ անհատականացման և այլ գործընթացների համար</translation>
<translation id="3729187154190517324">Որոնումն ընդլայնելու համար ավելացրեք մի քանի ներդիր, ֆայլեր և գործիքներ՝ օգտագործելով «Ավելացնել ներդիր կամ մեկ այլ բան» կոճակը։</translation>
<translation id="3032577647176321971">Կառավարել Optimium-ի պրոֆիլները</translation>
<translation id="6314444399103340747">Իմացեք, թե ինչու է Optimium-ն արգելափակում որոշ ներբեռնումներ</translation>
<translation id="379589255253486813">Chromium-ը ձեզ կտեղեկացնի, եթե որևէ բան փոխելու անհրաժեշտություն լինի</translation>
<translation id="3802055581630249637">Chromium-ը նախապես բեռնում է էջերը, որոնք դուք հավանաբար կայցելեք, որպեսզի դրանք ավելի արագ բեռնվեն</translation>
<translation id="3810973564298564668">Կառավարել</translation>
<translation id="4301680230606686279">Պահված գաղտնաբառերն օգտագործելու համար սկանավորեք QR կոդը, ներբեռնեք iOS-ի համար նախատեսված Optimium դիտարկիչը և մուտք գործեք ձեր Google հաշիվ</translation>
<translation id="3846683726093018685">**Ամփոփում։** Մեկ նախադասությամբ մինչև 30 բառի սահմաններում սքրինշոթից նկարագրիր հիմնական թեման և բովանդակության նշանակությունը։

          **Առաջարկվող հարցեր։** Ստեղծիր մտածելու տեղիք տվող 3-5 հարցից բաղկացած կետանշված ցուցակ, որոնք օգտատերը կարող է տալ՝ սքրինշոթն ավելի լավ հասկանալու համար։ Դրանցից առնվազն մեկը պետք է կապված լինի վիզուալ օբյեկտի, դրա դիզայնի կամ տեղակայման հետ։</translation>
<translation id="3287167856630539345"><ph name="PAGE_TITLE" /> - Optimium</translation>
<translation id="3117512156333858342">Էջանիշները և մյուս տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք Optimium</translation>
<translation id="3511883131632987404">{COUNT,plural, =1{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Optimium-ը։ Ձեր մեկուսացված պատուհանը նորից չի բացվի։}one{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Optimium-ը։ Ձեր # մեկուսացված պատուհանը նորից չի բացվի։}other{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել Optimium-ը։ Ձեր # մեկուսացված պատուհանները նորից չեն բացվի։}}</translation>
<translation id="3885770153807205175">Լեզվի ընտրիչ</translation>
<translation id="7294070483192043494">Optimium-ի կարգավորման և կառավարման համար անհրաժեշտ է ձեր ուշադրությունը։ Սեղմեք՝ մանրամասներին ծանոթանալու համար։</translation>
<translation id="7920927747111819647">Սեղմեք ձեր անվան վրա՝ Optimium-ը բացելու համար:</translation>
<translation id="3892148308691398805">Պատճենել տեքստը</translation>
<translation id="4454986649289930182"><ph name="EXISTING_USER" />-ն արդեն մուտք է գործել Optimium-ի այս պրոֆիլը։ Ձեր դիտարկումների պատմությունն առանձին պահելու համար կարող եք Optimium-ի առանձին պրոֆիլ ստեղծել։</translation>
<translation id="7225128703667880746">Այս ընդլայնումը խախտում է Chrome Web Store-ի քաղաքականությունը և կարող է վտանգավոր լինել։ Հեռացրեք ընդլայնումը Optimium-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="3941890832296813527">Տեղադրման սխալ. տեղադրման ծրագրի ֆայլի անվանումն անվավեր է կամ չի աջակցվում։</translation>
<translation id="6304622602441037994">Optimium-ը փորձում է պատճենել գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="2274695480528598968">Մուտք գործեք Optimium՝ ձեր պահած տեղեկությունները և մյուս տվյալները բոլոր սարքերում օգտագործելու համար</translation>
<translation id="1713567483777335359">Ձեր գաղտնաբառերը, վճարման եղանակները և հասցեները, որոնք պահել եք ձեր Google հաշվում, կհեռացվեն այս սարքից։ Optimium-ում դրանք նորից օգտագործելու համար պետք է նորից մուտք գործեք։</translation>
<translation id="395904275706073188">Պաշտպանված էջերը հնարավոր չէ ընթերցել։ Փորձեք այլ էջ։</translation>
<translation id="3962647064319009959">Ինչպես է Chromium-ն ապահով պահում ձեր տվյալները</translation>
<translation id="3967822245660637423">Ներբեռնումն ավարտվեց</translation>
<translation id="3971865010372729242">Երբ դուք տեքստ եք մուտքագրում հասցեագոտում կամ որոնման դաշտում, Chromium-ը ձեր հարցումն ուղարկում է ձեր կազմակերպության որոնողական համակարգին, ԱԲ-ին և ագենտային գործիքներին՝ առաջարկներ ստանալու համար։</translation>
<translation id="3975724895399328945">&amp;Google Chrome for Testing-ի մասին</translation>
<translation id="3984557288004650913">Գործիքագոտում սեղմելով «Google Որոնումը Chrome-ում» կոճակը՝ կարող եք նորից բացել Google Որոնումը Chrome-ում և հարցեր տալ դիտարկման ընթացքում</translation>
<translation id="3997429360543082038">ChromiumOS-ի մասին</translation>
<translation id="4016217212818346953">Եղեք պաշտպանված Գաղտնաբառերի կառավարչի օգնությամբ</translation>
<translation id="4019629340646866719">ChromiumOS-ը ստեղծվել է <ph name="BEGIN_LINK_CROS_OSS" />բաց կոդով ծրագրակազմի<ph name="END_LINK_CROS_OSS" /> հիման վրա, ինչպիսին է <ph name="BEGIN_LINK_LINUX_OSS" />Լինուքսի մշակման միջավայրը<ph name="END_LINK_LINUX_OSS" />։</translation>
<translation id="4022972681110646219">Թարգմանել էկրանը</translation>
<translation id="4023601594785368013">Բնօրինակի լեզուն՝ <ph name="LANGUAGE" /></translation>
<translation id="8098054594752731054">Հղումները բացեք Optimium-ում ցանկացած հավելվածից։ Հեշտ մուտքի համար դիտարկիչն ամրացվում է խնդրագոտում։</translation>
<translation id="4036079820698952681">Օգնեք կատարելագործել Chromium-ը՝ հաղորդելով <ph name="BEGIN_LINK" />ընթացիկ կարգավորումների<ph name="END_LINK" /> մասին</translation>
<translation id="4050175100176540509">Վերջին տարբերակում առկա են անվտանգության կարևոր բարելավումներ և նոր գործառույթներ:</translation>
<translation id="4055805654398742145">Գ&amp;աղտնաբառերի կառավարիչ</translation>
<translation id="3150466418323356831">{COUNT,plural, =1{Ձեր կազմակերպությունն ավտոմատ փակում է Optimium-ը, երբ այն 1 րոպե չի օգտագործվում։ Դիտարկման տվյալները ջնջվում են։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։}one{Ձեր կազմակերպությունն ավտոմատ անջատում է Optimium-ը, երբ այն # րոպե չի օգտագործվում։ Դիտարկման տվյալները ջնջվում են։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։}other{Ձեր կազմակերպությունն ավտոմատ անջատում է Optimium-ը, երբ այն # րոպե չի օգտագործվում։ Դիտարկման տվյալները ջնջվում են։ Դիտարկման տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։}}</translation>
<translation id="4118474109249235144">Chromium ինկոգնիտո</translation>
<translation id="4122186850977583290">Անցնել «Chromium-ի մասին» էջ</translation>
<translation id="5040058062446726786">Անհատականացրեք Optimium-ը՝ ձեր դիտարկիչին նոր տեսք հաղորդելու համար</translation>
<translation id="3417230552019009112">Անհատականացրեք ձեր Optimium-ը</translation>
<translation id="4148957013307229264">Տեղադրում…</translation>
<translation id="8036654966821129512">Թարմացրեք Optimium-ը՝ պաշտպանված մնալու համար</translation>
<translation id="113287843321846936"><ph name="PAGE_TITLE" /> – Ցանցի մուտքի էջ – Optimium</translation>
<translation id="101945827160630872"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Optimium <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Ձեր ընթերցանության ցանկը և այլ տվյալները նույնպես հասանելի կլինեն ձեր բոլոր սարքերում։</translation>
<translation id="5914158797921975103">Հավելվածների, խաղերի, ընդլայնումների և թեմաների լայն ընտրանի Optimium-ի համար:</translation>
<translation id="7188357620681202939">Ձեր բոլոր համակարգիչներում այս ընդլայնումը և ավելին ստանալու համար մուտք գործեք Optimium</translation>
<translation id="1889725122457669356">Ձեր ծնողների ընտրած ավելի անվտանգ կարգավորումներն օգտագործելու համար անցեք Optimium պրոֆիլ, որտեղ արդեն մուտք եք գործել որպես <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">Չեղարկվում է…</translation>
<translation id="4224210481850767180">Տեղադրումը չեղարկվել է։</translation>
<translation id="3467085712950617325">Կապել Optimium-ի տվյալներն այս հաշվի հետ:</translation>
<translation id="4251772536351901305">Զգուշացնում է ձեզ վտանգավոր, այդ թվում՝ Google-ին նախկինում անհայտ կայքերի մասին, քանի որ ավելի շատ տվյալներ է վերլուծում կայքերում՝ համեմատած ստանդարտ պաշտպանության հետ։ Դուք կարող եք բաց թողնել Chromium-ի նախազգուշացումները։</translation>
<translation id="2140865310399147834">Դուրս գալ Optimium-ից</translation>
<translation id="4271805377592243930">Chromium-ի օգնության էջ</translation>
<translation id="4275788652681621337">Փակել կողային վահանակը</translation>
<translation id="4281844954008187215">Օգտագործման պայմաններ</translation>
<translation id="3179093133057739293">Անհայտ սխալի պատճառով տեղադրումը չհաջողվեց: Եթե Optimium-ը բաց է, փակեք այն և կրկին փորձեք:</translation>
<translation id="5932936993463393384">Արտահանեք գաղտնաբառերը Optimium-ից</translation>
<translation id="4304713468139749426">Գաղտնաբառերի կառավարիչ</translation>
<translation id="4334241893986177674">Որոնում այս սքրինշոթում</translation>
<translation id="109990079583792895">Գործարկել Optimium-ը, երբ Windows-ը միանա</translation>
<translation id="4400772909124543403">Հասանելի թարմացումներ չկան</translation>
<translation id="4669117187454638908">Փակե՞լ Optimium-ը։</translation>
<translation id="4413205837991854510">Միշտ ցույց տալ պատկերով որոնման դյուրանցումը</translation>
<translation id="1696050014109987987">Թույլատրել Optimium-ին աշխատել ֆոնային ռեժիմում</translation>
<translation id="7368827027253482667">{NUM_EXTENSIONS,plural, =1{Optimium-ը խորհուրդ է տալիս հեռացնել այն։ <ph name="BEGIN_LINK" />Իմանալ ավելին աջակցվող ընդլայնումների մասին<ph name="END_LINK" />}one{Optimium-ը խորհուրդ է տալիս հեռացնել այն։ <ph name="BEGIN_LINK" />Իմանալ ավելին աջակցվող ընդլայնումների մասին<ph name="END_LINK" />}other{Optimium-ը խորհուրդ է տալիս հեռացնել դրանք։ <ph name="BEGIN_LINK" />Իմանալ ավելին աջակցվող ընդլայնումների մասին<ph name="END_LINK" />}}</translation>
<translation id="6842479443769252421">Հարմարեցնել և վերահսկել Optimium-ը</translation>
<translation id="4427306783828095590">Լրացուցիչ պաշտպանությունն օգնում է խուսափել ֆիշինգից և արգելափակել վնասաբեր ծրագրերը</translation>
<translation id="4434353761996769206">Տեղադրիչի սխալ՝ <ph name="INSTALLER_ERROR" /></translation>
<translation id="1220175535870261362">Optimium-ը կառավարվում է <ph name="MANAGER" />-ի կողմից</translation>
<translation id="4547231940814681999">Ավելացնել Optimium պրոֆիլ</translation>
<translation id="4447409407328223819">Chrome for Testing-ի մասին</translation>
<translation id="5633209319760692383">Optimium-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը</translation>
<translation id="4493028449971051158">Մեկնարկի սխալ․ գործարկեք տեղադրիչը որպես ադմինիստրատոր։</translation>
<translation id="4501471624619070934">Չհաջողվեց տեղադրել, քանի որ այս երկրում հասանելիության սահմանափակումներ կան։</translation>
<translation id="4501839397124711198">Դուք կարող եք ամրացնել Google Որոնումը կողային վահանակում, որպեսզի հարցեր տաք դիտարկման ընթացքում</translation>
<translation id="2800276662284246735">Այս ընդլայնումը չի հրապարակել գաղտնիության քաղաքականություն, օրինակ՝ թե ինչպես է այն հավաքում և օգտագործում տվյալները։ Optimium-ը խորհուրդ է տալիս հեռացնել այն։</translation>
<translation id="5128821773878845255">Բարի գալուստ Optimium․ բացված է դիտարկիչի նոր պատուհան</translation>
<translation id="2317489323536472198">Optimium-ին անհրաժեշտ է թույլտվություն՝ ձեր շրջակայքի քարտեզը ստեղծելու և ձեր ձեռքերի շարժումները հետագծելու համար</translation>
<translation id="8080035720506683743">Դուք արդեն մուտք եք գործել <ph name="USER_EMAIL_ADDRESS" /> հաշիվ մյուս Optimium պրոֆիլում</translation>
<translation id="4548534452171747496">Chromium-ը նախապես բեռնում է էջերը՝ արագացնելով դիտարկումն ու որոնումը։ <ph name="BEGIN_LINK" />Իմանալ ավելին էջերի նախաբեռնման մասին<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Հաղորդեք կայքի մասին, որը ձեր կարծիքով վնասակար է, և օգնեք բարելավել համացանցի անվտանգությունը բոլորի համար։</translation>
<translation id="8636960717768483692">Optimium-ն արգելափակել է այս ներբեռնումը, քանի որ դուք անջատել եք Անվտանգ դիտարկումը, և ֆայլը հնարավոր չէ ստուգել</translation>
<translation id="1056620590372326996">Փորձեք Google Տեսապակին Optimium-ի հետ ձեր հեռախոսում</translation>
<translation id="4594305310729380060">Այս սարքի Գաղտնաբառերի կառավարիչում</translation>
<translation id="1647545052658850323">Optimium հավելվածներ</translation>
<translation id="4598116752460667024">Ցանկում գտեք անհրաժեշտ գործընթացը։</translation>
<translation id="4613863813562375431">ChromiumOS-ի տարբերակը</translation>
<translation id="4621240073146040695">Գրեթե պատրաստ է: Վերագործարկեք Chromium-ը՝ թարմացումն ավարտելու համար:</translation>
<translation id="2905329563261343101">Արագացնում է կայքերի աշխատանքը Optimium-ի V8 շարժիչի օգնությամբ, սակայն փոքր-ինչ խոցելի է դարձնում Optimium-ը հարձակումների նկատմամբ</translation>
<translation id="3476739270743628464">Բացել Որոնումը Optimium-ով</translation>
<translation id="8852417056873245680">Optimium պրոֆիլ</translation>
<translation id="7306598352117034690">Ուշադրություն․ Optimium-ը չի կարող արգելել ընդլայնումներին գրանցել ձեր այցելությունների պատմությունը։ Ընդլայնումն ինկոգնիտո ռեժիմում անջատելու համար ապանշեք այս պարամետրը։</translation>
<translation id="4673151026126227699">Եթե դուք նաև ուղարկում եք Chromium-ի օգտագործման մասին հաշվետվություններ, դրանցում կներառվեն ձեր այցելած URL-ները։</translation>
<translation id="4673710618874938871">Մուտք եք գործել որպես <ph name="USER_NAME" />, բաժանորդագրություն։ Բացել հաշվի ընտրացանկը</translation>
<translation id="8554460300897634995">Կարծես թե պրոֆիլն օգտագործվում է Optimium-ի այլ գործընթացի կողմից (<ph name="PROCESS_ID" />) այլ համակարգչում (<ph name="HOST_NAME" />): Optimium-ը կողպել է պրոֆիլը, որպեսզի այն չվնասվի: Եթե համոզված եք, որ պրոֆիլը չի օգտագործվում այլ գործընթացների կողմից, կարող եք ապակողպել պրոֆիլը և նորից գործարկել Optimium-ը:</translation>
<translation id="4680828127924988555">Չեղարկել տեղադրումը</translation>
<translation id="3120454893225058851">Optimium-ի որոշ տվյալներ դեռ չեն պահվել ձեր Google հաշվում։ Նախքան դուրս գալը մի քանի րոպե սպասեք։ Եթե դուրս գաք հիմա, այս տվյալները կջնջվեն։</translation>
<translation id="382482205580353394">Հաշիվ մուտք գործած ժամանակ Optimium-ում դուք կարող եք օգտագործել ձեր գաղտնաբառերն ու մյուս կարգավորումները ձեր Google հաշվից։ <ph name="SHORTCUT" /> դյուրանցումով կարող եք փոխել Google-ի ձեր ծառայությունների կարգավորումները։</translation>
<translation id="3042362992251330365">Ինչ-որ մեկն այս համակարգչում <ph name="ACCOUNT_EMAIL_LAST" /> հասցեով մուտք է գործել Optimium: Ստեղծեք Optimium-ի նոր պրոֆիլ` ձեր տվյալներն առանձին պահելու համար:</translation>
<translation id="4724676981607797757">Չհաջողվեց տեղադրել հավելվածը, քանի որ չաջակցվող հաղորդակարգի կիրառման արդյունքում սխալ է առաջացել։</translation>
<translation id="1193287511990404405">Փակե՞լ Optimium-ը։</translation>
<translation id="8952177001318268390">Optimium-ի անվտանգության կարգավորումները հենց նոր թարմացվել են: Վերագործարկեք Chrome-ը, և ձեր ներդիրները կվերականգնվեն:</translation>
<translation id="4771701986670315895">Դուք վաղուց չեք այցելել կայք։ Chromium-ը հեռացրել է «<ph name="PERMISSION_1" />», «<ph name="PERMISSION_2" />» ու ևս <ph name="COUNT" /> թույլտվություն։</translation>
<translation id="2836181158089477791">Եթե «Gemini-ը Optimium-ում» հավելվածը բացված է, նոր ներդիրներ ստեղծելիս կողային վահանակը բացված կմնա</translation>
<translation id="479167709087336770">Օգտագործվում է միևնույն ուղղագրիչը, ինչ Google Որոնման մեջ: Դիտարկիչում մուտքագրված տեքստերն ուղարկվում են Google-ին: Սա կարող եք փոխել կարգավորումներում։</translation>
<translation id="4803313124144656665">Փակել Google Որոնումը Chrome-ում</translation>
<translation id="1328138522631482119">Օգտագործել Optimium-ն առանց հաշվի</translation>
<translation id="4839733921943823254">Ամրացնել դյուրանցումը</translation>
<translation id="3892081057957249936">Թույլատրել Optimium-ում տվյալների մուտքային հոսքի փոխանցումը mDNS հաղորդակարգով:</translation>
<translation id="7651599052663598373">Վերագործարկել՝ &amp;Optimium-ը թարմացնելու համար</translation>
<translation id="4918086044614829423">Ընդունել</translation>
<translation id="4918844574251943176">Պատկերը պատճենվեց</translation>
<translation id="5410814264258278350">Մուտք գործեք Optimium՝ ձեր ընթերցանության ցանկը և մյուս տվյալները բոլոր սարքերում օգտագործելու համար</translation>
<translation id="6875307114047320453">Optimium-ն աշխատում է ֆոնային ռեժիմում:</translation>
<translation id="2394968926407196930">Սեղմեք՝ Optimium մտնելու երկխոսության պատուհանը փակելու համար</translation>
<translation id="1768466544858725503">Optimium պրոֆիլների միջոցով դուք կարող եք օգտագործել դիտարկիչն առանձին այլ օգտատերերից։ Ստեղծեք պրոֆիլներ ձեր ընկերների և ընտանիքի անդամների կամ գործնական և անձնական նպատակների համար։</translation>
<translation id="7886648924703056279">Օգտագործելով Optimium-ը հյուրի ռեժիմում՝ դուք ոչ մի հետք չեք թողնում:</translation>
<translation id="5471135073467145273">Ձեր հաշիվը Optimium-ում</translation>
<translation id="6876331590693993673">Ավելացրեք ձեր հաշիվը Optimium-ին</translation>
<translation id="5000497292978544380">Google Որոնման ԱԲ ռեժիմ</translation>
<translation id="504699503110800016">Բացեք լրացուցիչ ընտրացանկը</translation>
<translation id="4438081792500757652">Օգտագործեք Google-ի ձեր սիրելի ծառայությունները Optimium-ի միջոցով ձեր <ph name="DEVICE_TYPE" /> սարքում</translation>
<translation id="5121592697493894155">Google Որոնումը կողային վահանակում</translation>
<translation id="2242644352859741625">Optimium-ին անհրաժեշտ է թույլտվություն՝ ձեր ձեռքերի շարժումները հետագծելու համար</translation>
<translation id="5141988424377517949">Դուք վաղուց չեք այցելել կայք։ Chromium-ը հեռացրել է «<ph name="PERMISSION_1" />», «<ph name="PERMISSION_2" />» և «<ph name="PERMISSION_3" />» թույլտվությունները։</translation>
<translation id="988933134885096200">Մուտք Optimium</translation>
<translation id="5174969993834422967">Դուք սովորաբար արգելափակում եք ծանուցումները։ Հասցեագոտու աջ անկյունում սեղմեք ծանուցման պատկերակը, որպեսզի թույլ տաք կայքին ծանուցել ձեզ։</translation>
<translation id="5174983315706567306">Սկավառակում բավարար տարածք չկա։</translation>
<translation id="2338237693885714148">Optimium հաշիվը պահանջում է վերաիսկորոշում</translation>
<translation id="8218029216260099398">Շարունակեք այնտեղից, որտեղ կանգ էիք առել iOS-ի համար Optimium-ում։</translation>
<translation id="4186833996539770035">Դուրս գալ Optimium-ից</translation>
<translation id="5234764350956374838">Փակել</translation>
<translation id="5247617065091903691">Դուք կարող եք ամրացնել Google Որոնման կողային վահանակը, որպեսզի հարցեր տաք դիտարկման ընթացքում</translation>
<translation id="3776453825988272921">Բացել հղումը Optimium-ի ինկո&amp;գնիտո պատուհանում</translation>
<translation id="3535566975491534106">Ներբեռնեք Optimium հավելվածը՝ գաղտնաբառերը ցանկացած պահի պահելու համար</translation>
<translation id="5277894862589591112">Փոփոխությունները կիրառելու համար վերագործարկեք Chromium-ը</translation>
<translation id="5286907366254680517">Ճանաչվել է</translation>
<translation id="2359384056551683792">Ներբեռնել Optimium հավելվածը</translation>
<translation id="5294316920224716406">Երբ ինկոգնիտո ռեժիմում դիտարկելիս լինեք, նախքան ոչ ապահով միացման միջոցով կայք բեռնելը Chromium-ը ձեզ կնախազգուշացնի</translation>
<translation id="8192058236932307019">Որոնում Optimium-ով</translation>
<translation id="2772169547056202535">Optimium Updater ներքին ծառայություն</translation>
<translation id="5324450571874973775">Օգտագործեք դրանք Chromium-ում Gemini-ի այլ գործառույթների հետ միասին</translation>
<translation id="5346389065299425353">Որոնումն ընդլայնելու համար ավելացրեք մի քանի ներդիր, ֆայլեր և գործիքներ</translation>
<translation id="6360850825826447093">Ստացեք այս փաստաթղթի համառոտ նկարագրությունը և հարցեր տվեք Gemini-ին Optimium-ում</translation>
<translation id="5352264705793813212">Chromium-ը անվտանգության հետ կապված որոշ առաջարկներ է գտել ձեզ համար</translation>
<translation id="4898448032020512094">Optimium-ի այլ պրոֆիլներ</translation>
<translation id="8706179446833404063">ChromiumOS-ին չհաջողվեց պահել Optimium-ի տվյալները ձեր Google հաշվում, քանի որ ձեր հաշվի մուտքի տվյալները հնացած են</translation>
<translation id="3030627244449672752">Դուք մուտք եք գործում վերահսկվող հաշիվ՝ թույլ տալով ադմինիստրատորին կառավարել ձեր Optimium պրոֆիլը: Ձեր Optimium-ի տվյալները, ինչպես օրինակ՝ հավելվածները, էջանիշները, պատմությունը, գաղտնաբառերը և այլ կարգավորումները, մշտապես կկապվեն <ph name="USER_NAME" />-ի հետ: Դուք կկարողանաք ջնջել այս տվյալները Google Dashboard-ի միջոցով, սակայն չեք կարողանա համակցել դրանք այլ հաշվի հետ: <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Լրացուցիչ կոդ՝ <ph name="EXTRA_CODE" />։</translation>
<translation id="5377622451696208284">Անհատականացումը կարգավորելու համար ավելացրեք Chromium-ը Վեբ որոնման և հավելվածների պատմության մեջ</translation>
<translation id="2465610960000663223">Բացել որոնումը Optimium-ով</translation>
<translation id="506107225183374450">Իմացեք, թե ինչու է Optimium-ն արգելափակում որոշ ֆայլեր</translation>
<translation id="5386450000063123300">Chromium-ի թարմացում (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="2975872091911905625"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Optimium <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Ընդլայնումները և այլ տվյալները նույնպես հասանելի կլինեն ձեր բոլոր սարքերում։</translation>
<translation id="538767207339317086">Թույլատրել մուտքը Chromium-ում</translation>
<translation id="160420445803701171">Հեռացնել Optimium-ից</translation>
<translation id="7179459260935505033">Արդյունավետությունը կնվազի, սակայն Optimium-ն ավելի դիմակայուն կդառնա հարձակումների նկատմամբ</translation>
<translation id="9146479251717041603">Դարձնել Optimium-ը կանխադրված դիտարկիչը</translation>
<translation id="6343924787023513328"><ph name="PAGE_TITLE" /> – Optimium բետա</translation>
<translation id="4322885651709311384">{NUM_TABS,plural, =1{Optimium-ը խորհուրդ է տալիս դադարեցնել ներդիրը, որը դադաղեցնում է ձեր դիտարկիչը}one{Optimium-ը խորհուրդ է տալիս դադարեցնել ներդիրները, որոնք դանդաղեցնում են ձեր դիտարկիչը}other{Optimium-ը խորհուրդ է տալիս դադարեցնել ներդիրները, որոնք դանդաղեցնում են ձեր դիտարկիչը}}</translation>
<translation id="8732742361460659941">Optimium-ը հնարավոր է չաշխատի ինչպես հարկն է, քանի որ այն այլևս չի աջակցվում Լինուքսի այս բաշխման մեջ։</translation>
<translation id="2169134804545654825">Optimium-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը կարող է վնասել ձեր անձնական և սոցիալական ցանցերի հաշիվները</translation>
<translation id="5482575505313585759">Փակել Google Որոնման վահանակը</translation>
<translation id="4427110150482038520">Սպասեք` մինչ Optimium-ը տեղադրում է համակարգի նորագույն թարմացումները:</translation>
<translation id="2009107314274994399">Optimium-ը փորձում է փոխել գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="7654616829447718524">Սահուն աշխատեք ձեր սիրած հավելվածների հետ, ինչպիսիք են Google Drive-ը և YouTube-ը, Optimium-ի միջոցով։</translation>
<translation id="5524890928877629608">որոնման տարածքի վերևի ձախ անկյուն՝ <ph name="LEFT" />% ձախից, <ph name="TOP" />% վերևից</translation>
<translation id="5527463683072221100">Բացել PDF ֆայլեր Chromium-ում</translation>
<translation id="5536164441519929134">Հարցրեք<ph name="LINE_BREAK" />այս ներդիրի մասին</translation>
<translation id="2024205307959964945">Անվտանգության նկատառումներից ելնելով՝ Optimium-ն անջատում է JavaScript-ի օպտիմալացումը, երբ առաջին անգամ եք այցելում կայք։

Եթե այս էջը չի աշխատում սպասվածի պես, փորձեք թույլատրել օպտիմալացումը։</translation>
<translation id="13426881482333028">Ցույց տալ «Gemini-ը Optimium-ում» հավելվածը Mac-ի ընտրացանկի գոտում և միացնել ստեղնային դյուրանցումը</translation>
<translation id="6574158167225592561"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Optimium <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Ձեզ նաև հասանելի կլինեն պահված տեղեկությունները և այլ տվյալներ <ph name="DEVICE" />։</translation>
<translation id="5579324208890605088">Մեկնարկի սխալ․ գործարկեք տեղադրիչը որպես սովորական օգտատեր, այլ ոչ որպես ադմինիստրատոր։</translation>
<translation id="4236944092022229829">Դարձրեք Optimium-ը ձեր կանխադրված դիտարկիչը և ամրացրեք այն</translation>
<translation id="4562525634100475413">{COUNT,plural, =1{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Optimium-ը։ Ձեր մեկուսացված պատուհանը նորից չի բացվի։}one{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Optimium-ը։ Ձեր # մեկուսացված պատուհանը նորից չի բացվի։}other{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Optimium-ը։ Ձեր # մեկուսացված պատուհանները նորից չեն բացվի։}}</translation>
<translation id="5596627076506792578">Լրացուցիչ ընտրանքներ</translation>
<translation id="5605834417512968703">Ընտրեք որևէ բան՝ «Որոնում պատկերով» գործառույթի միջոցով որոնելու համար, կամ սեղմեք Escape՝ այդ գործառույթից դուրս գալու համար</translation>
<translation id="7026300828382155386"><ph name="IMPORTANT_UPDATE" />ը պատրաստ է։ Դուք կարող եք վերագործարկել հիմա կամ կարգավորել Optimium-ը, որպեսզի այն թարմացվի հաջորդ անգամ, երբ ձեր էկրանը միացված լինի և <ph name="IDLE_DURATION" /> օգտագործման մեջ չլինի։</translation>
<translation id="5618818588972826921">Ընտրեք ցանկացած տեքստ կամ պատկեր պատկերների որոնման միջոցով որոնելու համար կամ սեղմեք Escape՝ պատկերների միջոցով որոնումից դուրս գալու համար</translation>
<translation id="8498149662316870172">{0,plural, =0{Հասանելի է Optimium-ի նոր տարբերակը}=1{Հասանելի է Optimium-ի նոր տարբերակը}one{Optimium-ի նոր տարբերակը # օր է հասանելի է}other{Optimium-ի նոր տարբերակը # օր է հասանելի է}}</translation>
<translation id="5643865575100044307">Միշտ ջնջել կայքերի տվյալները սարքից՝ Chromium-ը փակելու դեպքում</translation>
<translation id="4811952957940410849">Վերագործարկեք Optimium-ը</translation>
<translation id="8019243097022864687">Optimium-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10-ի 1809 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 10-ի հին տարբերակ։</translation>
<translation id="568656514202614970">Պատրաստ է։ Այժմ դուք կարող եք հեշտությամբ հարցեր տալ դիտարկման ընթացքում՝ Google Որոնման կողային վահանակի օգնությամբ։</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">Chromium-ը ցուցադրել այս լեզվով</translation>
<translation id="569897634095159764">Հնարավոր չէ միանալ ինտերնետին։ Պրոքսի սերվերն իսկորոշում է պահանջում։</translation>
<translation id="5768371961535086509">Chromium-ը ազատում է ոչ ակտիվ ներդիրներին հատկացված հիշողությունը։ Դրա շնորհիվ ակտիվ ներդիրներն ու մյուս հավելվածները համակարգչի ավելի շատ ռեսուրսներից են կարողանում օգտվել, իսկ Chromium-ը կարողանում է արագ աշխատել։ Ոչ ակտիվ ներդիրներն ավտոմատ կակտիվանան, երբ նորից սկսեք օգտագործել դրանք։ <ph name="BEGIN_LINK" />Իմանալ ավելին Հիշողության տնտեսման մասին<ph name="END_LINK" /></translation>
<translation id="7953122114569280985">Եթե մոռացել եք ձեր անցաբառը կամ ուզում եք փոխել այս կարգավորումը, խորհուրդ ենք տալիս <ph name="SETTINGS_LINK" /> Optimium-ի տվյալները ձեր հաշվից</translation>
<translation id="174898372403396774">Անհատականացրեք և վերահսկեք Optimium-ը։ Դարձրեք Optimium-ը ձեր կանխադրված դիտարկիչը։</translation>
<translation id="7513745843649038539">Դարձրեք Optimium-ը ձեր կանխադրված դիտարկիչը, որպեսզի ձեր գաղտնաբառերը, էջանիշները և պատմությունը համաժամացվեն ձեր բոլոր սարքերում։</translation>
<translation id="5809516625706423866">Հնարավոր չէ միանալ ինտերնետին։ HTTP 401 Unauthorized։ Ստուգեք ձեր պրոքսի սերվերի կազմաձևը։</translation>
<translation id="579643040945073674">Արագացնում է կայքերի աշխատանքը Optimium-ի V8 շարժիչի օգնությամբ, սակայն փոքր-ինչ խոցելի է դարձնում Optimium-ը հարձակումների նկատմամբ։ Այս կարգավորումն անջատված է։</translation>
<translation id="4979951833951359193">Optimium-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար թարմացրեք Optimium-ը</translation>
<translation id="5824893331272123205">Չհաջողվեց բեռնել այս վահանակը։ Նորից փորձեք։</translation>
<translation id="7677335892217820153">Բարի գալուստ Optimium</translation>
<translation id="5871205389137001634">Սեղմեք՝ «Որոնում պատկերով» գործառույթից դուրս գալու համար</translation>
<translation id="3069954563229169503">Optimium-ը այս տարրերում վնասագիր է հայտնաբերել՝</translation>
<translation id="5889361821821684993">Chromium-ը պարբերաբար ստուգում է իրականացնում՝ համոզվելու, որ ձեր դիտարկիչն ամենաանվտանգ կարգավորումներն ունի։ Մենք ձեզ կտեղեկացնենք, եթե որևէ բան փոխելու անհրաժեշտություն լինի։</translation>
<translation id="5895138241574237353">Վերագործարկել</translation>
<translation id="8498138353382813879">Gemini Enterprise-ը Optimium-ում</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – Ցանցի մուտք</translation>
<translation id="5924017743176219022">Միացում համացանցին…</translation>
<translation id="5941711191222866238">Նվազեցնել</translation>
<translation id="7780105764415426863">Որպեսզի այս էջանիշը և այլ տվյալներ հասանելի լինեն ձեր բոլոր սարքերում, մուտք գործեք Optimium</translation>
<translation id="3113857336144207971">Հարմարեցրեք Optimium-ը</translation>
<translation id="5960071705175224773">Կարգավորումները փոխվել են անհայտ հավելվածի կողմից</translation>
<translation id="2841415208664905665">{COUNT,plural, =1{Ձեր կազմակերպությունն ավտոմատ փակում է Optimium-ը, երբ այն 1 րոպե չի օգտագործվում։}one{Ձեր կազմակերպությունն ավտոմատ անջատում է Optimium-ը, երբ այն # րոպե չի օգտագործվում։}other{Ձեր կազմակերպությունն ավտոմատ անջատում է Optimium-ը, երբ այն # րոպե չի օգտագործվում։}}</translation>
<translation id="6753703218327532561">Թարմացրեք Optimium-ը՝ համաժամացումը սկսելու համար</translation>
<translation id="5990360079535151574">Գործիքագոտում սեղմելով «Համատեքստային առաջադրանքներ» կոճակը՝ կարող եք նորից բացել համատեքստային առաջադրանքները և հարցեր տալ դիտարկման ընթացքում։</translation>
<translation id="6003112304606738118">Ներբեռնում… Մնաց <ph name="HOURS" /> ժամ</translation>
<translation id="6009821354356307391">Լրացուցիչ հարցեր տվեք</translation>
<translation id="6040143037577758943">Փակել</translation>
<translation id="4546936953038997559">Օգտվեք առցանց գնումների բոլոր առավելություններից՝ ձեր <ph name="DEVICE_TYPE" />-ում օգտագործելով Optimium հավելվածը</translation>
<translation id="6058380562449900225">Ձեր տվյալները պաշտպանելու համար թույլ տվեք Chromium-ին հեռացնել թույլտվություններն այն կայքերից, որոնք վերջերս չեք այցելել։ Ընդ որում՝ ծանուցումները չեն անջատվի։</translation>
<translation id="9167712407654403538">&amp;Բացել Optimium-ում</translation>
<translation id="6069027071882229820">Պատճենել որպես պատկեր</translation>
<translation id="2336867934702997612">«<ph name="EXTENSION_NAME" />» ընդլայնումն ավելացվել է Optimium-ին</translation>
<translation id="4963754686639647216">Հասանելի է Optimium-ի նոր տարբերակը։</translation>
<translation id="3238331535068195595">Միացված է • Optimium-ը չի կարող հաստատել այս ընդլայնման ծագումը</translation>
<translation id="1591882001986563343">Ձեր հաշիվը Optimium-ում</translation>
<translation id="9174470061972211626">Թույլատրել ընդլայնմանը մուտքի հարցումներ ցուցադրել Optimium-ի գործիքագոտում</translation>
<translation id="6285996195476638282"><ph name="FILE_NAME" /> ֆայլը վտանգավոր է, և Optimium-ն արգելափակել է այն։</translation>
<translation id="2722851476153659127">Optimium-ը շուտով կփակվի և կջնջի տվյալները</translation>
<translation id="6855625092121599072">Այստեղ կարող եք անցնել Optimium-ի այլ պրոֆիլի</translation>
<translation id="615103374448673771">Եթե դուք թույլատրում եք քուքիների օգտագործումը, Chromium-ը կարող է դրանք օգտագործել նախաբեռնման ժամանակ</translation>
<translation id="6165508094623778733">Իմանալ ավելին</translation>
<translation id="440816316079905155">Մաքրել Optimium-ի տվյալները ձեր հաշվից</translation>
<translation id="8018999409456045233">Այս ֆայլը կարող է վտանգավոր լինել<ph name="LINE_BREAK" />Optimium-ը կարող է ստուգել այն, եթե մուտքագրեք ձեր գաղտնաբառը։ Ֆայլի մասին տեղեկությունները կուղարկվեն «Google Ապահով դիտարկում» ծառայությանը, սակայն ֆայլի բովանդակությունը և գաղտնաբառը կմնան ձեր սարքում։</translation>
<translation id="6182736845697986886">Չհաջողվեց տեղադրել հավելվածը թարմացումն իրականացնող սերվերի ներքին սխալի պատճառով։</translation>
<translation id="3469021117852380318">Համոզվեք, որ մուտք եք գործել հաշիվ <ph name="TARGET_DEVICE_NAME" /> սարքի Optimium դիտարկիչում և փորձեք նորից ուղարկել։</translation>
<translation id="2986761964667678689">Որոնեք և հարցեր տվեք ցանկացած տեղից, նույնիսկ եթե Optimium-ը ծալված է։ Թույլ է տալիս Optimium-ին աշխատել ֆոնային ռեժիմում։</translation>
<translation id="1244028666242035366">Այս համակարգչում արդեն տեղադրված է Optimium-ի ավելի նոր տարբերակը: Եթե ծրագրակազմը չի աշխատում, ապատեղադրեք Optimium-ը և նորից փորձեք:</translation>
<translation id="6513480350636703580">{0,plural, =0{Optimium-ը հիմա կվերագործարկվի}=1{Optimium-ը կվերագործարկվի 1 վայրկյանից}one{Optimium-ը կվերագործարկվի # վայրկյանից}other{Optimium-ը կվերագործարկվի # վայրկյանից}}</translation>
<translation id="3859762680410498178">Optimium-ը կթարմացվի, երբ ձեր էկրանը օգտագործման մեջ չլինի</translation>
<translation id="18853993527252772">Ֆայլեր ներբեռնելու համար Optimium-ին անհրաժեշտ է հիշողությունն օգտագործելու թույլտվություն</translation>
<translation id="6245734527075554892">Ստուգում է URL-ները Chromium-ում պահված վտանգավոր կայքերի ցանկի միջոցով։</translation>
<translation id="571621467627269416">Դարձնել Optimium-ը կանխադրված դիտարկիչ</translation>
<translation id="6248988683584659830">Որոնման կարգավորումներ</translation>
<translation id="4260906300317983841">Օգտվեք Google-ի անվտանգության լավագույն գործառույթներից ցանկացած պահի ձեր հեռախոսի Optimium հավելվածի օգնությամբ</translation>
<translation id="6919871734111021049">Դուրս գա՞լ Optimium-ից:</translation>
<translation id="8269500201917700071">Այս ներդիրները լրացուցիչ ռեսուրսներ են օգտագործում։ Թույլատրեք Optimium-ին ապակտիվացնել դրանք, և աշխատանքի արդյունավետությունը կբարձրանա։</translation>
<translation id="2906910751900335741">Անհատականացնել Optimium-ի պրոֆիլը</translation>
<translation id="6290827346642914212">Անվանեք ձեր Chromium պրոֆիլը</translation>
<translation id="6294638840436017818">Գործիքագոտում սեղմելով «Google Որոնման կողային վահանակ» կոճակը՝ կարող եք նորից բացել Google Որոնման կողային վահանակը և հարցեր տալ դիտարկման ընթացքում</translation>
<translation id="6612045300479871672">Ընդլայնումն ուզում է, որ դուք մուտք գործեք Optimium</translation>
<translation id="2723016125417495514"><ph name="FILE_NAME" /> ֆայլը կարող է վտանգավոր լինել, և Optimium-ն արգելափակել է այն։</translation>
<translation id="6308106880471005841">Գործիքագոտու «Google Որոնման վահանակ» կոճակը նոր պատկերակ ունի։ Սեղմեք այն՝ Google Որոնման վահանակի միջոցով դիտարկման ընթացքում հարցեր տալու համար։</translation>
<translation id="6151952148243982653">Optimium-ն օգտագործում է ձեր տեսախցիկը:</translation>
<translation id="7744220780291650493">Optimium-ում տեղադրման մեկ այլ գործողություն ընթացքի մեջ է: Փորձեք ավելի ուշ:</translation>
<translation id="4212271170228408978">Այժմ ավելի հեշտ է օգտագործել Optimium-ը ձեր Google հաշվի հետ, այդ թվում նաև համօգտագործվող համակարգիչներով:</translation>
<translation id="7560359899505953564">Դարձրեք Optimium-ը ձեր կանխադրված դիտարկիչը՝ հեշտությամբ օգտվելու ձեզ ծանոթ, սիրելի և վստահելի գործառույթներից։</translation>
<translation id="9090225774559341003">Optimium-ի դյուրանցում</translation>
<translation id="6926580396655648750">Optimium-ն արգելափակել է այս ներբեռնումը, քանի որ ֆայլը հազվադեպ է ներբեռնվում, և այն կարող է վտանգավոր լինել</translation>
<translation id="8406846117825568223">Հեռացնե՞լ Optimium-ը:</translation>
<translation id="6375219077595103062">Ավելացրեք Գաղտնաբառերի կառավարչի դյուրանցումը</translation>
<translation id="6388799252195623474">ինձ օգնություն է անհրաժեշտ</translation>
<translation id="9091694200019721003">Շարունակելու համար մուտք գործեք Optimium <ph name="EMAIL" /> էլփոստով։ Սա ապահովում է, որ դուք ունեք ձեր կազմակերպության կանոնները։</translation>
<translation id="3942952894185574182">Optimium-ի լոգոն՝ համակարգչի էկրանին։</translation>
<translation id="3353682461772532321">Optimium-ը վեբ դիտարկիչ է, որը կայծակի արագությամբ է բացում վեբէջերն ու հավելվածները: Այն արագ է, կայուն և պարզ՝ օգտագործման մեջ: Ավելի ապահով աշխատեք համացանցում՝ վնասագրերի և խաբկայքերի դեմ ներկառուցված պաշտպանության շնորհիվ:</translation>
<translation id="6791461984478543248">Հաստատեք ձեր ինքնությունը, որպեսզի միշտ կարողանաք օգտագործել և պահել Optimium-ի տվյալները ձեր Google հաշվում</translation>
<translation id="6174985388495951106">Optimium-ն ավելի արագ է աշխատում, իսկ JavaScript օգտագործող գործառույթները պետք է աշխատեն նախատեսվածի պես</translation>
<translation id="6436260184216827876">«Որոնում պատկերով» գործառույթը հասանելի չէ։ Փորձեք ավելի ուշ։</translation>
<translation id="6442900851116057561">Վերագործարկեք ChromiumOS-ը</translation>
<translation id="6443470774889161065">Chromium-ը նախապես բեռնում է էլ ավելի շատ էջեր, որոնք դուք հավանաբար կայցելեք, որպեսզի դրանք ավելի արագ բեռնվեն</translation>
<translation id="2102210363398612557">Ներբեռնեք Optimium-ը հեռախոսում՝ գներին հետևելու և ծանուցումներ ստանալու համար, երբ որևէ կայքում գնիջեցում լինի</translation>
<translation id="6598227122144472874">Անջատված է • Optimium-ը չի կարող հաստատել այս ընդլայնման ծագումը</translation>
<translation id="3895850825918446737">Բարի գալուստ Optimium պրոֆիլներ</translation>
<translation id="3239105679122868308">Հաջորդ անգամ, երբ ձեր <ph name="DEVICE_TYPE" /> սարքում բացեք Optimium-ը, կտեսնեք ներդիրների խմբերն օգտագործելու հրավեր։</translation>
<translation id="5440394152628202500">Հեռացնել հաշիվը Optimium-ից</translation>
<translation id="5673289019038024720">Այն նաև վերահսկում է, թե որ էջը ցուցադրվի Optimium-ը մեկնարկելիս:</translation>
<translation id="648319183876919572">Բարելավված Ապահով դիտարկումն օգնում է պաշտպանվել վտանգավոր կայքերից և ներբեռնումներից</translation>
<translation id="3922692586556595624">Ապատեղադրել Optimium-ը</translation>
<translation id="5977471146123132488">Դյուրանցումները բացվում են Optimium-ում</translation>
<translation id="1873460655129342919">Ձեր կազմակերպությունը փակում է Optimium-ը, երբ այն չի օգտագործվում <ph name="TIMEOUT_DURATION" />։ Այցելությունների պատմությունը ջնջվել է։ Այս տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։</translation>
<translation id="139284349466910875">Յուրաքանչյուր պրոֆիլում առանձին պահվում են Optimium-ի օգտատերերի տվյալները, օրինակ՝ էջանիշները, պատմությունը, գաղտնաբառերը և այլն</translation>
<translation id="6556755379298048869">Որոնեք ստեղնային դյուրանցման միջոցով։</translation>
<translation id="6563921047760808519">Իմացեք ավելին, թե <ph name="BEGIN_LINK" />ինչպես է Chromium-ը պահպանում ձեր տվյալների գաղտնիությունը<ph name="END_LINK" /></translation>
<translation id="562266251854740285">Այս կարգավորումների փոփոխությունները կկիրառվեն Optimium-ի վերագործարկումից հետո։</translation>
<translation id="965740992595240282">Կառավարեք ընդլայնումները՝ Optimium-ի հիմնական ընտրացանկում սեղմելով Ընդլայնումներ։</translation>
<translation id="2549448919385330625">Դուք կարող եք դիտել գաղտնաբառերը՝ անցնելով մյուս Optimium պրոֆիլ</translation>
<translation id="2662027419736610653">Օգտագործեք Optimium հավելվածը՝ ԱԲ լավագույն գործիքները շարժման մեջ օգտագործելու համար</translation>
<translation id="6570579332384693436">Ուղղագրական սխալները շտկելու համար Chromium-ը Google-ին է ուղարկում տեքստային դաշտերում ձեր մուտքագրած տեքստը</translation>
<translation id="8346408025829878332">Անցնել Optimium-ի ծանուցումների կարգավորումներ</translation>
<translation id="6600016381025017075">Որոնեք ցանկացած բան այս էջում</translation>
<translation id="5149981246269331326">Փոփոխություններն ուժի մեջ կմտնեն Optimium-ը հաջորդ անգամ գործարկելիս:</translation>
<translation id="1163143914216098175">Optimium-ն այժմ գործարկվում է Windows-ի միանալուն պես, այնպես որ կարող եք ակնթարթորեն սկսել դիտարկումը։ Դուք կարող եք անջատել այս գործառույթը կարգավորումներում։</translation>
<translation id="7839895033810030903">Շարունակեք այնտեղից, որտեղ կանգ էիք առել։ Optimium-ը վերականգնել է ձեր նախորդ աշխատաշրջանի ներդիրները։ Այս գործառույթն անջատելու համար անցեք</translation>
<translation id="8919724422686713691">Ձեր շրջակայքի եռաչափ քարտեզը ստեղծելու համար Optimium-ին անհրաժեշտ է տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="6669284030132180248">Պահելով էջանիշները Google հաշվում՝ դուք կարող եք հետագծել ապրանքների գները Chromium-ում և ստանալ զեղչերի մասին ծանուցումներ</translation>
<translation id="6676384891291319759">Մտնել համացանց</translation>
<translation id="668175097507315160">Մուտքի սխալի պատճառով ChromiumOS-ը չկարողացավ համաժամացնել ձեր տվյալները։</translation>
<translation id="2337492685922399200">Հեռացնել այս հավելվածի տվյալները Optimium-ից</translation>
<translation id="7200198227335381561">Այս կայքի համար Optimium-ին անհրաժեշտ է խոսափողն օգտագործելու թույլտվություն</translation>
<translation id="6712881677154121168">Ներբեռնման սխալ՝ <ph name="DOWNLOAD_ERROR" />։</translation>
<translation id="358599119501177356">Դուք չեք կարող օգտագործել ձեր պրոֆիլը, քանի որ այն Optimium-ի նոր տարբերակից է:

Որոշ գործառույթներ մատչելի չեն լինի: Հատկորոշեք այլ պրոֆիլի գրացուցակ կամ օգտվեք Optimium-ի ավելի նոր տարբերակից:</translation>
<translation id="6729124504294600478">Անհատականացումը և այլ գործառույթներ կարգավորելու համար ավելացրեք Chromium-ը Վեբ որոնման և հավելվածների պատմության մեջ և Google-ի կապված ծառայություններում</translation>
<translation id="196085196242095682">Optimium-ն արդեն տեղադրված է ձեր համակարգչում բոլոր օգտատերերի համար:</translation>
<translation id="8573534493546068455">Էջանիշները և մյուս տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք Optimium։ Այս էջանիշը կպահվի ձեր Google հաշվում, երբ մուտք գործեք։</translation>
<translation id="674891594898436429">Փակել ակտիվ որոնումն այս ներդիրում</translation>
<translation id="87486021868820245">Արագացնում է կայքերի աշխատանքը Optimium-ի V8 շարժիչի օգնությամբ, սակայն փոքր-ինչ խոցելի է դարձնում Optimium-ը հարձակումների նկատմամբ։ Այս կարգավորումը միացված է։</translation>
<translation id="474617559993879524">{count,plural, =1{Optimium-ի որոշ տվյալներ դեռ չեն պահվել Google հաշվում։ Նախքան դուրս գալը մի քանի րոպե սպասեք։ Եթե դուրս գաք հիմա, այս տվյալները (1 տարր) կջնջվեն։}one{Optimium-ի որոշ տվյալներ դեռ չեն պահվել Google հաշվում։ Նախքան դուրս գալը մի քանի րոպե սպասեք։ Եթե դուրս գաք հիմա, այս տվյալները ({count} տարր) կջնջվեն։}other{Optimium-ի որոշ տվյալներ դեռ չեն պահվել Google հաշվում։ Նախքան դուրս գալը մի քանի րոպե սպասեք։ Եթե դուրս գաք հիմա, այս տվյալները ({count} տարր) կջնջվեն։}}</translation>
<translation id="1681402107856523620">Optimium-ը խորհուրդ է տալիս ստուգել այս ֆայլը, քանի որ այն կարող է վտանգավոր լինել։</translation>
<translation id="6779406956731413166">ChromiumOS-ը ստեղծվել է <ph name="BEGIN_LINK_CROS_OSS" />բաց կոդով ծրագրակազմի<ph name="END_LINK_CROS_OSS" /> հիման վրա։</translation>
<translation id="6804256634866838775">Փակել ակտիվ որոնումը</translation>
<translation id="6831043979455480757">Թարգմանել</translation>
<translation id="2199057756312069531">Optimium-ը ձեզ տեղյակ կպահի, եթե ձեր գաղտնաբառերի անվտագությանը սպառնալիք լինի</translation>
<translation id="684888714667046800">Հնարավոր չէ միանալ ինտերնետին։ Հրապատ օգտագործելու դեպքում համոզվեք, որ <ph name="PRODUCT_EXE_NAME" /> ֆայլը թույլատրվածների ցուցակում է։</translation>
<translation id="6664374380152979637">Optimium – <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Շարունակելու համար սեղմեք Tab</translation>
<translation id="6862030660799253820">Որոնել այս պատկերը պատկերով որոնման միջոցով</translation>
<translation id="6869568587896659271">Հասցեագոտու տակ գտնվող կայքերի հեշտ հասանելիություն</translation>
<translation id="4548192511713002443">Optimium-ը «<ph name="EXTENSION_NAME" />» ընդլայնման մեջ վնասագիր է հայտնաբերել</translation>
<translation id="6877155553248388166">որոնման տարածքի ներքևի աջ անկյուն՝ <ph name="RIGHT" />% աջից, <ph name="BOTTOM" />% վերևից</translation>
<translation id="6896758677409633944">Պատճենել</translation>
<translation id="6898028264630240901">Դուք կարող եք ամրացնել համատեքստային առաջադրանքները, որպեսզի հարցեր տաք դիտարկման ընթացքում</translation>
<translation id="3594007018780395447">Նշեք Optimium-ը որպես կանխադրված դիտարկիչ և այն ամրացրեք ձեր հավելվածների վահանակում</translation>
<translation id="8874878391047306490">&amp;Կառավարել Optimium-ի պրոֆիլները</translation>
<translation id="8227361644719983591">Այս գործողության արդյունքում տեղի կունենա հետևյալը․
          <ph name="LINE_BREAKS" />
            • Մեկնարկային էջի, նոր ներդիրի էջի, որոնողական համակարգի և ամրացված ներդիրների կարգավորումները կզրոյացվեն
            <ph name="LINE_BREAK" />
            • Ընդլայնումները կանջատվեն
            <ph name="LINE_BREAK" />
            • Քուքիները և կայքերի մյուս ժամանակավոր տվյալները կջնջվեն
            <ph name="LINE_BREAK" />
            • Optimium-ի դյուրանցումների կարգավորումները կզրոյացվեն
            <ph name="LINE_BREAKS" />
            Էջանիշները, պատմությունը և պահված գաղտնաբառերը կպահպանվեն։</translation>
<translation id="6926772305569367352">Գործիքագոտու «Google Որոնումը Chrome-ում» կոճակը նոր պատկերակ ունի։ Սեղմեք այն՝ Chrome-ում Google Որոնման միջոցով դիտարկման ընթացքում հարցեր տալու համար։</translation>
<translation id="7079691767892495301">Դուք Optimium-ում արդեն առավելագույն թույլատրելի թվով (<ph name="BOOKMARK_LIMIT" />) էջանիշներ եք պահել, ուստի ձեր էջանիշներից մի քանիսը դեռ չեն պահվել ձեր Google հաշվում։

Դուք չեք կարող նոր էջանիշներ պահել ձեր հաշվում, մինչև չջնջեք մի քանիսը։ Եթե դուրս գաք հիմա, չպահված էջանիշները կջնջվեն։</translation>
<translation id="8488478146459741524">Բացել հղումը Optimium-ի ինկ&amp;ոգնիտո պատուհանում</translation>
<translation id="6965382102122355670">Եղավ</translation>
<translation id="6985329841647292029">ChromiumOS-ի պայմաններ</translation>
<translation id="8559464220428426642">Optimium-ի տվյալները <ph name="ACCOUNT_EMAIL" /> հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը</translation>
<translation id="7011190694940573312">Տեղադրումը ձախողվեց, քանի որ օպերացիոն համակարգի այս տարբերակը չի աջակցվում։</translation>
<translation id="7024536598735240744">Ապափաթեթավորման սխալ՝ <ph name="UNPACK_ERROR" />։</translation>
<translation id="7941779569092758272">{COUNT,plural, =1{Համաձայն Լրացուցիչ պաշտպանության կարգավորումների՝ թարմացումը կիրառելու համար անհրաժեշտ է վերագործարկել Optimium-ը։ Ձեր մեկուսացված պատուհանը նորից չի բացվի։}one{Համաձայն Լրացուցիչ պաշտպանության կարգավորումների՝ թարմացումը կիրառելու համար անհրաժեշտ է վերագործարկել Optimium-ը։ Ձեր # մեկուսացված պատուհանը նորից չի բացվի։}other{Համաձայն Լրացուցիչ պաշտպանության կարգավորումների՝ թարմացումը կիրառելու համար անհրաժեշտ է վերագործարկել Optimium-ը։ Ձեր # մեկուսացված պատուհանները նորից չեն բացվի։}}</translation>
<translation id="5367778139372857256">Անհատականացրեք Optimium դիտարկիչը</translation>
<translation id="7047386856539490735">Այս արդյունքներն օգտակա՞ր են։</translation>
<translation id="6654931874608808546">Թարմացնել Optimium-ը</translation>
<translation id="1078205929937913964">Եթե պատկերն օգտակար նկարագրություն չունի, Optimium-ը կփորձի նոր նկարագրություն տրամադրել: Պատկերներն ուղարկվում են Google-ին՝ նկարագրություններ ստեղծելու համար։</translation>
<translation id="8657336023716174215">Օգտվեք ԱԲ-ի հնարավորություններից, երբ օգտագործում եք Optimium հավելվածը ձեր <ph name="DEVICE_TYPE" /> սարքում</translation>
<translation id="8360922610978196377">Ձեր գաղտնաբառերը, ներդիրները և այլ տվյալներ միշտ հասանելի կլինեն ձեր հեռախոսի Optimium հավելվածի շնորհիվ</translation>
<translation id="7141270731789036260">Անհատականացրեք Chrome for Testing-ը</translation>
<translation id="7147227333672430807">Օգտագործեք Chromium-ը ցանկացած ժամանակ, երբ սեղմում եք հաղորդագրություններում, փաստաթղթերում և այլ հավելվածներում առկա հղումների վրա</translation>
<translation id="7635847276859447848">Հեռացնել <ph name="EXTENSION_NAME" /> ընդլայնումը Optimium-ից</translation>
<translation id="4634249408802713112">Ձեր կազմակերպությունը ջնջում է Optimium-ի տվյալները, երբ այն չի օգտագործվում <ph name="TIMEOUT_DURATION" />։ Այս տվյալները կարող են ներառել պատմությունը, ինքնալրացված տվյալները և ներբեռնումները։</translation>
<translation id="3308314751977712481">Այս կայքի համար Optimium-ին անհրաժեշտ է տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="1700107811881467396">Չհաջողվեց գործարկել Optimium-ը։ Նորից փորձեք։</translation>
<translation id="615859695332174696">Հարցրեք ցանկացած բան ցանկացած տեղում «Gemini-ը Optimium-ում» մոդելի միջոցով</translation>
<translation id="4082322885657154457">Ամրացրեք Optimium-ը Dock վահանակի վրա՝ այն ցանկացած պահի արագ բացելու համար</translation>
<translation id="5886985791575399945">Օգտագործեք Optimium-ը ցանկացած ժամանակ, երբ սեղմում եք հաղորդագրություններում, փաստաթղթերում և այլ հավելվածներում առկա հղումների վրա</translation>
<translation id="7213435258745128111">Google Որոնումը Chromium-ում</translation>
<translation id="7216228761061470870">Երբ օգտագործում եք «Որոնում պատկերով» գործառույթը, էջի վերնագիրը, URL-ը և բովանդակությունը՝ ներառյալ PDF-ները, ուղարկվում են սերվերին</translation>
<translation id="3899250150715276784">Խնդիրների կառավարիչ - Optimium</translation>
<translation id="357779301278973973">Հարցեր տվեք Optimium-ից դուրս բովանդակության, օրինակ՝ այլ հավելվածների կամ ֆայլերի մասին</translation>
<translation id="2192941957286691074"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Optimium <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Պահպանված տեղեկությունները և մյուս տվյալները նույնպես կհայտնվեն ձեր բոլոր սարքերում։</translation>
<translation id="4695009148423764441">Ակնթարթորեն սկսեք դիտարկումը․ Optimium-ն այժմ կարող է գործարկվել Windows-ի միանալուն պես։</translation>
<translation id="7274695763216404502">«Որոնում պատկերով» գործառույթն ամրացված է․ այն այժմ հասանելի է գործիքագոտում</translation>
<translation id="7288567540154601580">Ներդիրներ և ընդլայնումներ</translation>
<translation id="7290997427370476749">Գործիքագոտում սեղմելով «Google Որոնման վահանակ» կոճակը՝ կարող եք նորից բացել Google Որոնման վահանակը և հարցեր տալ դիտարկման ընթացքում</translation>
<translation id="1079602886106438527">{NUM_EXTENSIONS,plural, =1{Optimium-ը խորհուրդ է տալիս ձեզ հեռացնել այն}one{Optimium-ը խորհուրդ է տալիս ձեզ հեռացնել այն}other{Optimium-ը խորհուրդ է տալիս ձեզ հեռացնել դրանք}}</translation>
<translation id="5279936464959604532">Համակարգի աուդիոյով կիսվելու համար բացեք Համակարգի կարգավորումները և թույլատրեք «Միայն համակարգի աուդիոյի ձայնագրումը» Optimium-ի համար։ Այնուհետև անհրաժեշտ կլինի վերագործարկել Optimium-ը։</translation>
<translation id="7299899569525778554">Որոնում համակարգչից</translation>
<translation id="731795002583552498">Chromium-ը թարմացվում է</translation>
<translation id="1032861344046520617">Ձեր նախընտրանքների ֆայլը վնասված է կամ անվավեր:

Optimium-ին չհաջողվեց վերականգնել ձեր կարգավորումները:</translation>
<translation id="7324051657739063017">Դուք կարող եք նորից բացել համատեքստային առաջադրանքները, որպեսզի հարցեր տաք դիտարկման ընթացքում</translation>
<translation id="265884122223707624">Բոլոր վեբէջերը, էջանիշները և Optimium-ի այլ տվյալները պահվում են այստեղ:</translation>
<translation id="7347827960336370838">Միայն ձեր անցաբառն ունեցող մարդիկ կարող են կարդալ ձեր գաղտնագրված տվյալները։ Անցաբառը չի ուղարկվում Google-ին կամ պահվում նրա կողմից։ Եթե մոռացել եք ձեր անցաբառը կամ ուզում եք փոխել այս կարգավորումը, ապա ձեզ անհրաժեշտ կլինի <ph name="BEGIN_LINK" />ջնջել Chromium-ի տվյալները ձեր հաշվում<ph name="END_LINK" />։</translation>
<translation id="3014807377884544255">Ձեր համակարգի ադմինիստրատորն այնպես է կարգավորել Optimium-ը, որ <ph name="TARGET_URL_HOSTNAME" /> կայքը բացվի <ph name="ALTERNATIVE_BROWSER_NAME" /> դիտարկիչով։</translation>
<translation id="7352651011704765696">Ինչ-որ սխալ տեղի ունեցավ</translation>
<translation id="6261059974673858354">Optimium-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է macOS 13 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է macOS 12 տարբերակը։</translation>
<translation id="7374061268215476070">Դուք կարող եք նորից բացել Google Որոնման կողային վահանակը՝ դիտարկման ընթացքում հարցեր տալու համար</translation>
<translation id="7376384068949534168">Դուք վաղուց չեք այցելել կայք։ Chromium-ը հեռացրել է «<ph name="PERMISSION_1" />» և «<ph name="PERMISSION_2" />» թույլտվությունները։</translation>
<translation id="73786666777299047">Բացել Chrome Web Store-ը</translation>
<translation id="3890970823792853036">Ցույց տալ «Gemini-ը Optimium-ում» հավելվածը ծանուցման տարածքում</translation>
<translation id="7401687852903179959">Որոնել այս տեսանյութը պատկերով որոնման միջոցով</translation>
<translation id="3864955417896853787">Optimium-ն այժմ ձեր կանխադրված դիտարկիչն է</translation>
<translation id="7774148037106099906">Շարունակեք այնտեղից, որտեղ կանգ էիք առել։ Optimium-ը վերականգնում է ներդիրները յուրաքանչյուր վերագործարկումից հետո։ Այս գործառույթն անջատելու համար անցեք</translation>
<translation id="8928491002876394495">Արտահանեք գաղտնաբառեր Optimium</translation>
<translation id="5203709869300967635">1. Սեղմեք <ph name="BUTTON_LABEL" /> ներքևում
2. Windows-ի կարգավորումներում սեղմեք <ph name="BUTTON_2" />
3. Սեղմեք <ph name="BUTTON_3" /> Windows-ի ծանուցման մեջ՝ Optimium-ը հավելվածների վահանակում ամրացնելու համար</translation>
<translation id="1391846143863378733"><ph name="PAGE_TITLE" /> – Optimium Dev</translation>
<translation id="7450541714075000668">Տեքստը պատճենվեց</translation>
<translation id="7458892263350425044">Ձեր խոսափողն օգտագործելու համար Chromium-ին թույլտվություն տրամադրեք <ph name="BEGIN_LINK" />համակարգի կարգավորումներում<ph name="END_LINK" /></translation>
<translation id="6029586608765705546">Optimium-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 7 տարբերակը։</translation>
<translation id="7467949745582939695">Վերագործարկե՞լ Chromium-ը</translation>
<translation id="5752242571869112795">Հնարավոր չէ տեղադրել Optimium-ի նույն տարբերակը, որն այժմ գործարկվում է: Փակեք Optimium-ը և նորից փորձեք:</translation>
<translation id="7510190804000607802">Հիշեցում․ Google-ի լավագույն հավելվածները ձեր գրպանում</translation>
<translation id="751935028865900641">Կայքերի մեծ մասը ամենայն հավանականությամբ պատշաճ կերպով կաշխատի։ Դուք դուրս կգրվեք կայքերի մեծամասնությունից, երբ փակեք Chromium-ի բոլոր պատուհանները, սակայն կմնաք ձեր Google հաշվում, եթե մուտք եք գործել Chromium։</translation>
<translation id="63211891312143018">{0,plural, =1{Optimium-ը կվերագործարկվի 1 րոպեից}one{Optimium-ը կվերագործարկվի # րոպեից}other{Optimium-ը կվերագործարկվի # րոպեից}}</translation>
<translation id="7565444033145385702">Ձեր տվյալները պաշտպանելու համար թույլ տվեք Chromium-ին հեռացնել թույլտվություններն այն կայքերից, որոնք վերջերս չեք այցելել։</translation>
<translation id="3125039289492641783">Ավտոմատ գործարկեք Optimium-ը՝ անմիջապես դիտարկում սկսելու համար։</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" />-ի տեղադրիչ</translation>
<translation id="4408734053922791034">Optimium-ն օգտագործում է ձեր տեսախցիկն ու խոսափողը:</translation>
<translation id="3179764934195866467">Optimium-ը կատարելագործվել է</translation>
<translation id="6404693631411216689">Այժմ Optimium-ում ձեզ ավելի շատ գործառույթներ են հասանելի</translation>
<translation id="7624307931717240213">Մենք օգտագործում ենք տեղեկությունները՝ այս ծառայությունը բարելավելու համար։ Ծանոթացեք գաղտնիության քաղաքականությանը և Օգտագործման պայմաններին։</translation>
<translation id="7649070708921625228">Օգնություն</translation>
<translation id="8311510395768039141">Ներբեռնել Optimium հավելվածը</translation>
<translation id="7658239707568436148">Չեղարկել</translation>
<translation id="133478151344333089">Optimium-ը ձեր կանխադրված դիտարկիչը չէ</translation>
<translation id="280841280407738358">Համաժամացրեք և անհատականացրեք Optimium-ը ձեր բոլոր սարքերում</translation>
<translation id="7699779824407626136">Chromium-ի թարմացում</translation>
<translation id="4220506181038618136">Ձեր աշխատանքը պաշտպանված է Optimium-ում</translation>
<translation id="7716950018788545737">Առաջադրանք(ներ)ը ավարտված են։</translation>
<translation id="77283119132245232">Տրամադրում է <ph name="BROWSER_NAME" /> դիտարկիչին համակարգի հետագծման ծառայություններ։ Եթե այս ծառայությունն անջատված է, դիտարկիչի կողմից ստեղծված արդյունավետության հետագծումները չեն ներառի համակարգային իրադարձություններ, ինչպիսիք են համատեքստի փոխանջատումը և հոսքի պատրաստությունը։</translation>
<translation id="7745317241717453663">Ձեր այցելությունների պատմությունը կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք Chromium <ph name="USER_EMAIL" /> հաշվով:</translation>
<translation id="7747138024166251722">Տեղադրիչը չկարողացավ ստեղծել ժամանակավոր գրացուցակ: Ստուգեք սկավառակում ազատ տարածքի առկայությունը և ծրագրակազմը տեղադրելու թույլտվությունը:</translation>
<translation id="4874030584283115178">Վերականգնել Optimium-ի կանխադրված կարգավորումները</translation>
<translation id="4747871007139957101">Optimium-ում աշխատանքի անվտանգությունն ապահովելու համար ձեր կազմակերպությունը կկարողանա դիտել կամ կառավարել որոշակի տեղեկություններ, երբ մուտք գործեք Optimium։</translation>
<translation id="39303350018938562">Դարձրեք Optimium-ը կանխադրված դիտարկիչ և ամրացրեք այն հավելվածների վահանակում</translation>
<translation id="1411498815218277204">Արագացրեք Optimium-ի աշխատանքը</translation>
<translation id="6759916683257281869"><ph name="PAGE_TITLE" /> – Optimium Canary</translation>
<translation id="7800043020703832708">Փակել Google Որոնումը կողային վահանակում</translation>
<translation id="7801317262080715012">Նոր պատկերակ, նույն դյուրանցումը․ սեղմեք՝ Google Որոնման վահանակի միջոցով դիտարկման ընթացքում հարցեր տալու համար։</translation>
<translation id="7803986347287457849">Արեք այնպես, որ ձեր ինտերնետ թրաֆիկի հասանելիություն ունեցող մարդիկ չկարողանան տեսնել, թե ինչ կայքեր եք այցելել։ Chromium-ն օգտագործում է ապահով միացում՝ DNS-ում (տիրույթի անունների համակարգ) կայքերի IP հասցեները որոնելու համար։</translation>
<translation id="7810005234485217901">Ամրացրեք «Որոնում պատկերով» գործառույթը՝ արագ մուտքի համար</translation>
<translation id="3974047900913685132">{COUNT,plural, =1{Optimium-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Բացված է ինկոգնիտո կամ մեկուսացված պատուհան։ Վերագործարկումից հետո այն նորից չի բացվի։}one{Optimium-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Պրոֆիլներում բացված է # ինկոգնիտո կամ մեկուսացված պատուհան։ Վերագործարկումից հետո այն նորից չի բացվի։}other{Optimium-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Պրոֆիլներում բացված է # ինկոգնիտո և մեկուսացված պատուհան։ Վերագործարկումից հետո դրանք նորից չեն բացվի։}}</translation>
<translation id="1327395026710636574">Ընտրեք, թե ինչ տվյալներով կիսվել Optimium-ի հետ</translation>
<translation id="7712700268586648421">Այս հաշվի հետ կապված Optimium-ի պրոֆիլ արդեն գոյություն ունի այս սարքում</translation>
<translation id="7845233973568007926">Շնորհակալություն տեղադրելու համար։ Նախքան <ph name="BUNDLE_NAME" />-ն օգտագործելը դուք պետք է վերագործարկեք ձեր համակարգիչը։</translation>
<translation id="7639854797882089460">Ձեր որոնողական համակարգը Optimium-ից դուրս է փոխվել։ Անվտանգության նկատառումներով՝ Optimium-ը վերականգնել է կանխադրված կարգավորումները։ <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3551756496947130501">Անհատականացրեք Optimium-ը՝ դրան նոր տեսք հաղորդելու համար</translation>
<translation id="7859018312476869945">Երբ դուք տեքստ եք մուտքագրում հասցեագոտում կամ որոնման դաշտում, Chromium-ը ձեր հարցումն ուղարկում է կանխադրված որոնողական համակարգին՝ ավելի լավ առաջարկներ ստանալու համար։ Այս գործառույթն անջատված է ինկոգնիտո ռեժիմում։</translation>
<translation id="7884611555881634231">Չհաջողվեց տեղադրել Optimium-ի վերջին տարբերակը, որը թարմացվել է նոր գործառույթներով և անվտանգության բարելավումներով:</translation>
<translation id="7872446069773932638">Ներբեռնում… Մնաց <ph name="SECONDS" /> վայրկյան</translation>
<translation id="7873537467422636035">Եթե մոռացել եք ձեր անցաբառը կամ ուզում եք փոխել այս կարգավորումը, <ph name="BEGIN_LINK" />ջնջեք Chromium-ի տվյալները ձեր հաշվում<ph name="END_LINK" />։</translation>
<translation id="3834573390507006929">Թույլ է տալիս արագ բացել «Gemini-ը Optimium-ում» հավելվածը, երբ դրա անհրաժեշտությունը կա</translation>
<translation id="6294556714699385535">Դարձնել Optimium-ը ձեր կանխադրված դիտարկիչը</translation>
<translation id="7904213866086517086">Նորից բացել Google Որոնումը կողային վահանակում</translation>
<translation id="7934340546140346950">Chromium-ը հնարավորության դեպքում ավտոմատ կերպով վերածում է ոչ ապահով միացումները HTTPS-ի</translation>
<translation id="5730000852184248909">Դուք մուտք եք գործել Optimium որպես <ph name="USER_EMAIL_ADDRESS" />: Նորից մուտք գործելու համար օգտագործեք նույն հաշիվը:</translation>
<translation id="8566131222358264585"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Optimium <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Էջանիշները և մյուս տվյալները նույնպես կհայտնվեն ձեր բոլոր սարքերում։</translation>
<translation id="7975919845073681630">Սա Chromium-ի երկրորդային տեղադրումն է: Այն չի կարող դառնալ ձեր կանխադրված դիտարկիչը:</translation>
<translation id="6422450341111525365">Անհայտ աղբյուրներից ընդլայնումները, հավելվածներն ու թեմաները կարող են վնասել ձեր սարքը։ Optimium-ը խորհուրդ է տալիս դրանք տեղադրել միայն <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ից։</translation>
<translation id="6757123197146934198">Օգտագործեք Google-ի բոլոր առավելությունները Optimium հավելվածի միջոցով ձեր <ph name="DEVICE_TYPE" /> սարքում</translation>
<translation id="8004582292198964060">Դիտարկիչ</translation>
<translation id="8010081455002666927">Ինքնահայտնաբերում</translation>
<translation id="1278413817028711539">Երբ Optimium-ը հասանելիություն ստանա, կայքերը կկարողանան ձեզնից հասանելիություն խնդրել։</translation>
<translation id="349886907929581949">Ամրացրեք Optimium-ը խնդրագոտու վրա՝ այն ցանկացած պահի արագ բացելու համար</translation>
<translation id="80471789339884597">Շնորհակալություն տեղադրելու համար։ Նախքան <ph name="BUNDLE_NAME" />-ն օգտագործելը դուք պետք է վերագործարկեք ձեր բոլոր դիտարկիչները։</translation>
<translation id="8054112667659782652">Միշտ ցույց տալ պատկերով որոնման դյուրանցումը</translation>
<translation id="8069447462453318634">Ընտրեք «Ամրացնել գործիքագոտում»</translation>
<translation id="4174818101907153398">Անջատել Optimium-ի ֆոնային ռեժիմը հավելվածների համար</translation>
<translation id="80790299200510644">Որոնում պատկերով</translation>
<translation id="8086881907087796310">Տեղադրումը ձախողվեց, քանի որ ձեր համակարգիչը չի համապատասխանում սարքակազմի նվազագույն պահանջներին։</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> — Google Chrome for Testing</translation>
<translation id="1888025000812363096">Այս կայքի համար Optimium-ին անհրաժեշտ է տեղորոշումն օգտագործելու թույլտվություն</translation>
<translation id="7584643292999340766">Հաջորդ անգամ, երբ ձեր <ph name="DEVICE_TYPE" /> սարքում բացեք Optimium-ը, կտեսնեք գների հետագծման ծանուցումները միացնելու հրավեր։</translation>
<translation id="7461287607957342327">Ստացեք ձեզ հետաքրքրող ապրանքների գնիջեցման մասին ծանուցումներ ձեր հեռախոսի Optimium հավելվածում</translation>
<translation id="8118331347066725040">Կարծիք հայտնեք «Որոնել Տեսապակու միջոցով» գործառույթի մասին</translation>
<translation id="3539581840889743095">Անհատականացրեք Optimium-ը</translation>
<translation id="8133124826068723441">ChromiumOS-ին չհաջողվեց համաժամացնել տվյալները, քանի որ այդ գործառույթը հասանելի չէ ձեր տիրույթի համար։</translation>
<translation id="813913629614996137">Նախապատրաստվում է...</translation>
<translation id="4772631357296776122">Բացել «Gemini-ը Optimium-ում» հավելվածը ստեղնային դյուրանցման միջոցով։</translation>
<translation id="8164014945047474187">Chromium-ի օգտագործման լրացուցիչ պայմաններ</translation>
<translation id="4835039973898764392">{COUNT,plural, =1{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Optimium-ը։ Բացված է ինկոգնիտո կամ մեկուսացված պատուհան։ Վերագործարկումից հետո այն նորից չի բացվի։}one{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Optimium-ը։ Պրոֆիլներում բացված է # ինկոգնիտո կամ մեկուսացված պատուհան։ Վերագործարկումից հետո այն նորից չի բացվի։}other{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել Optimium-ը։ Պրոֆիլներում բացված է # ինկոգնիտո և մեկուսացված պատուհան։ Վերագործարկումից հետո դրանք նորից չեն բացվի։}}</translation>
<translation id="8065654717207240588">Այս ֆայլը վտանգավոր է, և Optimium-ն արգելափակել է այն։</translation>
<translation id="8177472873527554730">Էջում բովանդակություն գտնել հնարավոր չէ</translation>
<translation id="8200109504272824693">Chromium-ի տվյալները <ph name="USER_EMAIL" /> հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը</translation>
<translation id="8203105157044679380">Google Որոնման վահանակ</translation>
<translation id="820759916613250543">Որոնել այս պատկերը պատկերով որոնման միջոցով</translation>
<translation id="8221491193165283816">Դուք սովորաբար արգելափակում եք ծանուցումները։ Այս կայքում ծանուցումներ ստանալու համար սեղմեք այստեղ։</translation>
<translation id="8223363452568144035">Ձեր տեսախցիկն օգտագործելու համար Chromium-ին թույլտվություն տրամադրեք <ph name="BEGIN_LINK" />համակարգի կարգավորումներում<ph name="END_LINK" /></translation>
<translation id="1094434558959920914">Optimium-ը չի կարող ստուգել այս ընդլայնման ծագումը, ուստի այն կարող է վտանգավոր լինել։ Հեռացրեք ընդլայնումը Optimium-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="3957438238123670294">Եթե պատկերն օգտակար նկարագրություն չունի, Optimium-ը կփորձի նոր նկարագրություն տրամադրել: Պատկերներն ուղարկվում են Google-ին՝ նկարագրություններ ստեղծելու համար։ Ցանկացած պահի կարգավորումներում կարող եք անջատել սա:</translation>
<translation id="2706853324286223963">Մուտք գործե՞լ Optimium նոր պրոֆիլում</translation>
<translation id="1237310177197195175"><ph name="EXISTING_USER" />-ն արդեն մտել է հաշիվ։ Ձեր այցելությունների պատմությունն առանձին պահելու համար ձեր սեփական պրոֆիլում մուտք գործեք Optimium <ph name="USER_EMAIL_ADDRESS" /> հաշվով։ Ձեզ նաև հասանելի կլինեն գաղտնաբառերը և այլ տվյալներ <ph name="DEVICE" />։</translation>
<translation id="2801607883759458012">«Gemini-ը Optimium-ում» հավելվածը ավելացնել ծանուցման տարածքում և միացնել ստեղնային դյուրանցումը</translation>
<translation id="8286943863733751221"><ph name="BEGIN_LINK" />Chromium-ը զգուշացնում է ձեզ<ph name="END_LINK" /> վտանգավոր կայքերի և ներբեռնումների մասին</translation>
<translation id="8295827201165805317">Դուք վաղուց չեք այցելել կայք։ Chromium-ը հեռացրել է «<ph name="PERMISSION" />» թույլտվությունը։</translation>
<translation id="5265623464653503960">Օգտագործեք ձեր շարժական սարքի տեսախցիկը՝ Optimium-ի iOS հավելվածում ապրանքներ գտնելու, տեքստեր թարգմանելու և ձեզ շրջապատող օբյեկտների մասին տեղեկություններ ստանալու համար</translation>
<translation id="7565411431973063464">QR կոդ՝ Optimium որպես <ph name="USER_NAME" /> մուտք գործելու համար</translation>
<translation id="8313851650939857356">Մեկնարկի սխալ․ <ph name="STARTUP_ERROR" />։</translation>
<translation id="5911806827430614904">Ձեր կազմակերպությունը փակում է Optimium-ը, երբ այն չի օգտագործվում <ph name="TIMEOUT_DURATION" />։</translation>
<translation id="8321058241987390452">Պատրաստ է․ այժմ դուք կարող եք հեշտությամբ հարցեր տալ դիտարկման ընթացքում՝ Google Որոնման վահանակի օգնությամբ</translation>
<translation id="8321888067342493336">Պահել որպես պատկեր</translation>
<translation id="1508573889613002459"><ph name="USER_EMAIL_ADDRESS" />-ը նախկինում Optimium է օգտագործել</translation>
<translation id="8351551329754447960">Միացնել հմտությունները Chromium-ում</translation>
<translation id="406081439566291910">Թարմացրեք Optimium-ը, որպեսզի շարունակեք օգտագործել Optimium-ի տվյալները ձեր <ph name="ACCOUNT_EMAIL" /> Google հաշվում։</translation>
<translation id="1007124785122331769">Optimium-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 8 տարբերակը։</translation>
<translation id="8362914115861174987">Թարգմանության լեզու</translation>
<translation id="8367705492654390392">Հարցրեք որևէ բան</translation>
<translation id="8370517070665726704">© Google LLC <ph name="YEAR" />։ Բոլոր իրավունքները պահպանված են:</translation>
<translation id="3692978295966861512">Գաղտնաբառերը և մյուս տվյալները ձեր բոլոր սարքերում օգտագործելու համար մուտք գործեք Optimium։ Այս գաղտնաբառը կպահվի ձեր Google հաշվում, երբ մուտք գործեք։</translation>
<translation id="7364603585139702314">Այնուհետև անհրաժեշտ կլինի վերագործարկել Optimium-ը։</translation>
<translation id="8376752431516546391">Google Որոնման կողային վահանակ</translation>
<translation id="8236183484860169180">Optimium-ը խորհուրդ է տալիս հեռացնել այն։ <ph name="BEGIN_LINK" />Իմանալ ավելին աջակցվող ընդլայնումների մասին<ph name="END_LINK" /></translation>
<translation id="5920842078198979811">Այս ընդլայնման հրապարակումը չեղարկվել է մշակողի կողմից, և այն կարող է վտանգավոր լինել։ Հեռացրեք ընդլայնումը Optimium-ից, որպեսզի այն այլևս չկարողանա տեսնել և փոփոխել ձեր տվյալները, այդ թվում՝ անձնական տեղեկությունները, ձեր այցելած կայքերում։</translation>
<translation id="8406687098231754303">Գործիքագոտում սեղմելով «Google Որոնումը կողային վահանակում» կոճակը՝ կարող եք նորից բացել Google Որոնումը կողային վահանակում և հարցեր տալ դիտարկման ընթացքում</translation>
<translation id="2185697372454035703">Որպեսզի որոշ տվյալներ հնարավոր լինի պահել ձեր Google հաշվում, և դուք կարողանաք օգտագործել դրանք ձեր բոլոր սարքերում, Optimium-ը նախ պետք է հաստատի ձեր ինքնությունը։ Եթե դուրս գաք հիմա, այս տվյալները կջնջվեն։</translation>
<translation id="4724639108574581385">{0,plural, =1{Վերագործարկեք Optimium-ը մեկ օրվա ընթացքում}one{Վերագործարկեք Optimium-ը # օրվա ընթացքում}other{Վերագործարկեք Optimium-ը # օրվա ընթացքում}}</translation>
<translation id="8438543370129609977">Երբ օգտագործում եք «Որոնում պատկերով» գործառույթը, էջի վերնագիրը, URL-ը և բովանդակությունը՝ ներառյալ PDF-ները, ուղարկվում են սերվերին։ <ph name="LEARN_MORE" /></translation>
<translation id="3557945352384776441">Իմանալ ավելին Optimium-ում պատկերների միջոցով որոնման մասին</translation>
<translation id="6672310590031980518">Տեղադրիչի արխիվը վնասված է կամ անվավեր: Նորից ներբեռնեք Optimium-ը:</translation>
<translation id="8463672209299734063">Ըստ ցանկության. օգնեք բարելավել ChromiumOS-ի գործառույթներն ու աշխատանքը՝ Google-ին ավտոմատ կերպով ուղարկելով օգտագործման և դիագնոստիկ տվյալները։</translation>
<translation id="3954441584666499211">Optimium-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար հաստատեք ձեր ինքնությունը</translation>
<translation id="8482493977473846331">Ցույց է տալիս հաղորդագրություն Chromium-ում մուտք գործելու համար</translation>
<translation id="8202428378580208719">Optimium-ը հնացած է</translation>
<translation id="850264194101621529">Շնորհակալություն Chromium-ը որպես ձեր կանխադրված դիտարկիչ ընտրելու համար։</translation>
<translation id="8520489851087523435">Նորից բացել Google Որոնման կողային վահանակը</translation>
<translation id="8522801943730206384">Chromium-ը կարող է ստուգել ձեր գաղտնաբառերը, երբ պահում եք դրանք</translation>
<translation id="8525579356836940628">Տեղադրումը կանգնեցվել է</translation>
<translation id="8984919429007493543">Ձեր գաղտնաբառերը, ներդիրները և այլ տվյալներ միշտ հասանելի կլինեն ձեր <ph name="DEVICE_TYPE" />-ի Optimium հավելվածի միջոցով</translation>
<translation id="8555465886620020932">Ծառայության սխալ՝ <ph name="SERVICE_ERROR" />։</translation>
<translation id="3963774984615461205">Optimium-ի որոշ գործառույթներ և ընդլայնումներ ունեն դյուրանցումներ։ Դուք կարող եք նորից միացնել դրանք։</translation>
<translation id="8556420416730706394">«Որոնում պատկերով» գործառույթից արագ օգտվելու համար սեղմեք կողային վահանակի վերևի հատվածում գտնվող «Ամրացնել» կոճակը</translation>
<translation id="8564408666201523086">Պատրաստ է։ Այժմ դուք կարող եք հեշտությամբ հարցեր տալ դիտարկման ընթացքում՝ Google Որոնման կողային վահանակի օգնությամբ։</translation>
<translation id="856656450041460113">Որոնել լեզուների ցանկում</translation>
<translation id="8568499811906962479">Դուք կարող եք ամրացնել Google Որոնման վահանակը, որպեսզի հարցեր տաք դիտարկման ընթացքում</translation>
<translation id="2996904635986800713">Optimium-ը կառավարվում է մի քանի կազմակերպության կողմից</translation>
<translation id="8586442755830160949">© <ph name="YEAR" /> The Chromium Authors: Բոլոր իրավունքները պահպանված են:</translation>
<translation id="8590782867495422699">Նորից բացել Google Որոնման ԱԲ ռեժիմը</translation>
<translation id="2446482746737130055">Optimium-ի գործարկում...</translation>
<translation id="8624541899164515475">Կարգավորումներ, բացվում է նոր ներդիրում։</translation>
<translation id="8648201657708811153">Google Chrome for Testing-ը չի կարող դառնալ ձեր կանխադրված դիտարկիչը։</translation>
<translation id="9172606645924379921">Որոնեք Optimium-ի միջոցով ցանկացած վայրից</translation>
<translation id="8689408573494410517">Գործիքագոտու «Google Որոնումը կողային վահանակում» կոճակը նոր պատկերակ ունի։ Սեղմեք այն՝ կողային վահանակում Google Որոնման միջոցով դիտարկման ընթացքում հարցեր տալու համար։</translation>
<translation id="5596132704047725626">Այն նաև վերահսկում է Optimium-ի մեկնարկի կամ Omnibox-ից որոնում կատարելու ժամանակ ցուցադրվող էջը:</translation>
<translation id="567010981548424498">Այս ներդիրը մեկ այլ սարք ուղարկելու համար մուտք գործեք Optimium այդ սարքում</translation>
<translation id="4758459198907306138">Սա ձեր Optimium-ն է</translation>
<translation id="8712637175834984815">Պատրաստ է</translation>
<translation id="5293592838971423777">Մուտք գործե՞լ Optimium</translation>
<translation id="8747073452963259673">որոնման տարածքի ներքևի ձախ անկյուն՝ <ph name="LEFT" />% ձախից, <ph name="BOTTOM" />% վերևից</translation>
<translation id="878572486461146056">Տեղադրման սխալ. ձեր ցանցի ադմինիստրատորը կիրառել է խմբային կանոն, որը կանխում է տեղադրումը՝ <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">Հիշեցնել ավելի ուշ</translation>
<translation id="8601403845093292651">Կիսվեք այս փաստաթղթով Gemini-ի հետ Optimium-ում՝ դրա համառոտ նկարագրությունը ստանալու և լրացուցիչ հարցեր տալու համար</translation>
<translation id="3011694712607672183">Մուտք գործե՞լ Optimium</translation>
<translation id="8823401858233292222">Դարձնել Chromium-ը կանխադրված դիտարկիչ և ամրացնել խնդրագոտում</translation>
<translation id="8826492472752484139">Սեղմեք «Գաղտնաբառերի կառավարիչ»</translation>
<translation id="8833697763442816810">ChromiumOS համակարգ</translation>
<translation id="8852026904190808918">Այս լեզուն օգտագործվում է՝ Chromium-ում ընտրացանկերը, կարգավորումները, զգուշացումները և այլ տեքստեր ցուցադրելու համար</translation>
<translation id="8862326446509486874">Դուք չունեք համապատասխան իրավունքներ՝ համակարգի մակարդակով տեղադրում կատարելու համար: Փորձեք տեղադրումը կատարել որպես Ադմինիստրատոր:</translation>
<translation id="8400219074131043686">Ավելացնել Optimium պրոֆիլ</translation>
<translation id="3471339840299959661">Մուտքի սխալի պատճառով ChromiumOS-ին չհաջողվեց պահել Optimium-ի տվյալները ձեր Google հաշվում</translation>
<translation id="8161120518458367008">Ձեր կազմակերպության կանոնների համաձայն՝ դուք պետք է մուտք գործեք Optimium</translation>
<translation id="8897637834206928776">Նոր պատկերակ, նույն դյուրանցումը․ սեղմեք՝ դիտարկման ընթացքում Google Որոնման կողային վահանակում հարցեր տալու համար։</translation>
<translation id="3459877940554598369">Optimium-ի համար պահանջվում է Windows 10-ի 1809 կամ ավելի նոր տարբերակ։</translation>
<translation id="4176797355456373725">Optimium-ը փորձում է ցուցադրել գաղտնաբառերը: Մուտքագրեք ձեր Windows-ի գաղտնաբառը՝ այս գործողությունը թույլ տալու համար:</translation>
<translation id="8300184335948277828">Optimium-ն այլևս ձեր կանխադրված դիտարկիչը չէ։ Դարձնե՞լ Optimium-ը կանխադրված դիտարկիչ։</translation>
<translation id="8365648631713891786">Չհաջողվեց թարմացնել Optimium-ը</translation>
<translation id="8944232836376404813">Այս գործողության արդյունքում տեղի կունենա հետևյալը․
          <ph name="LINE_BREAKS" />
            • Մեկնարկային էջի, նոր ներդիրի էջի, որոնողական համակարգի և ամրացված ներդիրների կարգավորումները կզրոյացվեն
            <ph name="LINE_BREAK" />
            • Ընդլայնումները կանջատվեն
            <ph name="LINE_BREAK" />
            • Քուքիները և կայքերի մյուս ժամանակավոր տվյալները կջնջվեն
            <ph name="LINE_BREAKS" />
            Էջանիշները, պատմությունը և պահված գաղտնաբառերը կպահպանվեն</translation>
<translation id="4517341657960407384">Ցույց տալ Optimium կայքի դյուրանցումները</translation>
<translation id="6334459924587075942">Optimium Enterprise-ի լոգո</translation>
<translation id="1013608620694172987">Օգտագործեք Google-ի անվտանգության գործառույթները ձեր <ph name="DEVICE_TYPE" />-ում Optimium հավելվածի միջոցով</translation>
<translation id="6377692339934065652">Չհաջողվեց գործարկել Optimium-ը, քանի որ պրոֆիլը բացելիս սխալ առաջացավ։ Փորձեք վերագործարկել Optimium-ը։</translation>
<translation id="8411734418760705455">Optimium-ով որոնելու կամ <ph name="BEGIN_LINK" />Կարգավորումներում<ph name="END_LINK" /> անհատականացնելու համար</translation>
<translation id="4403836439014450645">Կառավարել Optimium-ի պրոֆիլները</translation>
<translation id="7714694033208252813">Օգտագործեք ձեր ստեղնաշարը՝ «Gemini-ը Optimium-ում» հավելվածի և ձեր բացված ներդիրի միջև անցում կատարելու համար։</translation>
<translation id="9018218886431812662">Տեղադրումն ավարտվեց</translation>
<translation id="4028461118515168614">Optimium-ն ավելի ապահով դարձնելու համար հետևյալ ընդլայնումներն անջատվել են, որոնք նշված չեն <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ում և կարող են ավելացված լինել առանց ձեր իմացության։</translation>
<translation id="8853260188791570953">Մուտք գործել Optimium</translation>
<translation id="6769418925691762561">Ցույց տալ Optimium-ով որոնումը Mac-ի ընտրացանկի գոտում և միացնել ստեղնային դյուրանցումը</translation>
<translation id="1582160730719680639">Optimium-ն արգելափակել է այս ներբեռնումը, քանի որ արխիվացված ֆայլը կարող է այլ ֆայլեր պարունակել, որոնք կարող են վնասագրեր լինել</translation>
<translation id="136372829312763612">Ձեր գաղտնաբառերը, էջանիշները և պատմությունը կհամաժամացվեն ձեր բոլոր սարքերում։ Հեշտությամբ օգտագործեք ձեզ ծանոթ և սիրելի գործառույթները՝ որպես կանխադրված դիտարկիչ ընտրելով Optimium-ը։ Optimium-ը կամրացվի հավելվածների վահանակում՝ արագ մուտքի համար։</translation>
<translation id="4121763951659864948">Օգտվեք Google-ի լավագույն ԱԲ գործիքներից ձեր հեռախոսի Optimium հավելվածի օգնությամբ</translation>
<translation id="570680773394181802">Մուտք գործեք Optimium՝ ձեր գաղտնաբառերը և այլ տվյալներ <ph name="DEVICE" />ից օգտագործելու համար</translation>
<translation id="9062666675513499497">Մուտք գործեք Chromium, երբ մուտք եք գործում Google-ի այլ ծառայություններ</translation>
<translation id="9074041031320636790">Պատրաստ է։ Այժմ դուք կարող եք հեշտությամբ հարցեր տալ դիտարկման ընթացքում՝ Google Որոնման ԱԲ ռեժիմի օգնությամբ</translation>
<translation id="9074163480955555019">Նոր պատկերակ, նույն դյուրանցումը․ սեղմեք՝ Chrome-ում Google Որոնման միջոցով դիտարկման ընթացքում հարցեր տալու համար։</translation>
<translation id="516400912738056453">Optimium-ն ավտոմատ փակվել է</translation>
<translation id="807899198682302888">Optimium-ը հնացել է</translation>
<translation id="4711199283523757502">{0,plural, =1{Optimium-ը կվերագործարկվի մեկ ժամից}one{Optimium-ը կվերագործարկվի # ժամից}other{Optimium-ը կվերագործարկվի # ժամից}}</translation>
<translation id="9106236359747881194">Ընտրեք տեքստը՝ որոնելու համար</translation>
<translation id="8368867604698561866">Optimium-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է Windows 10 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է Windows 8.1 տարբերակը։</translation>
<translation id="4437683009835184797">Բացել հղումը Optimium-ի նոր &amp;ներդիրում</translation>
<translation id="911206726377975832">Ջնջե՞լ նաև ձեր դիտարկումների տվյալները:</translation>
<translation id="9118146721060781133">Գործիքագոտու «Համատեքստային առաջադրանքներ» կոճակը նոր պատկերակ ունի։ Սեղմեք այն՝ համատեքստային առաջադրանքների միջոցով դիտարկման ընթացքում հարցեր տալու համար։</translation>
<translation id="9134482777260927479">Օգնություն տնային աշխատանքը կատարելիս</translation>
<translation id="9148058034647219655">Ելնել</translation>
<translation id="3295815393935110309">Շարունակեք այնտեղից, որտեղ կանգ էիք առել։ Optimium-ը կարող է վերականգնել ներդիրները յուրաքանչյուր վերագործարկումից հետո։ Այս գործառույթը միացնելու համար անցեք</translation>
<translation id="5167935114017057528">Ձեր համակարգի ադմինիստրատորն այնպես է կարգավորել Optimium-ը, որ <ph name="TARGET_URL_HOSTNAME" /> կայքը բացվի մեկ այլ դիտարկիչով:</translation>
<translation id="903669083727317908">Վերագործարկել՝ &amp;Optimium-ը թարմացնելու համար</translation>
<translation id="1256233032126781893">Optimium (mDNS-In)</translation>
<translation id="6225435091563451277">Անհատականացրեք Optimium-ը</translation>
<translation id="1987988401118534091">Optimium-ը հնարավոր է չաշխատի ինչպես հարկն է, քանի որ այն այլևս չի աջակցվում Windows XP և Windows Vista համակարգերում</translation>
<translation id="8102971646278891292">Օգտվեք Google-ի անվտանգության լավագույն գործառույթներից Optimium-ում։</translation>
<translation id="945522503751344254">Կարծիք հայտնել</translation>
<translation id="225981349930289899">Ո՞վ է օգտագործում Optimium-ը</translation>
<translation id="2788235168912697021">Ուժեղացրեք Optimium-ի անվտանգությունը</translation>
<translation id="983803489796659991">Չհաջողվեց տեղադրել հավելվածը, քանի որ թարմացումն իրականացնող սերվերը չունի հավելվածի համար անհրաժեշտ հեշերի տվյալներ։</translation>
<translation id="802168381040095988">Օգտագործել Optimium-ն առանց հաշվի</translation>
<translation id="985602178874221306">Chromium Authors</translation>
<translation id="989970834842471429">Ընտրեք ցանկացած տեքստ կամ պատկեր պատկերների որոնման միջոցով որոնում անելու համար</translation>
<translation id="992780518932311116">Ձեր տեղադրության տվյալներն օգտագործելու համար Chromium-ին թույլտվություն տրամադրեք <ph name="BEGIN_LINK" />համակարգի կարգավորումներում<ph name="END_LINK" /></translation>
</translationbundle>

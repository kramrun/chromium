<!DOCTYPE translationbundle>
<translationbundle lang="sq">
<translation id="1026101648481255140">Rifillo instalimin</translation>
<translation id="1029669172902658969">Nise sërish për të përditësuar ChromiumOS</translation>
<translation id="4063809399345498325">Optimium rekomandon që ta rinovosh këtë shtesë</translation>
<translation id="1042552502243217427">Kur një sajt kërkon të ngarkojë paraprakisht lidhje në mënyrë private në faqen e tij, Chromium përdor serverët e Google. Kjo e fsheh identitetin tënd nga sajti i ngarkuar paraprakisht, por Google mëson se çfarë sajtesh ngarkohen paraprakisht.</translation>
<translation id="1051793555070215510">Na ndihmo të përmirësojmë modalitetin "I fshehtë" duke plotësuar këtë anketë 1-minutëshe.</translation>
<translation id="1065672644894730302">Preferencat e tua nuk mund të lexohen.

Disa funksione mund të mos ofrohen dhe ndryshimet në preferenca nuk do të ruhen.</translation>
<translation id="7250992450852052182">Prindi yt ka çaktivizuar "Lejet për sajtet, aplikacionet dhe shtesat" për Optimium</translation>
<translation id="6711838932294803312">Optimium ka nevojë për qasje te rrjeti yt lokal për të zbuluar dhe përdorur pajisjet në afërsi</translation>
<translation id="2807920805712601449">Për të kërkuar një veçori ose shtesë specifike të Optimium, shkruaj shkurtoren e saj në shiritin e adresave, të ndjekur nga tasti i zgjedhur i tastierës</translation>
<translation id="5994612110840535151">Shfaq kërkimin me Optimium në tabakanë e sistemit dhe aktivizo shkurtoren e tastierës</translation>
<translation id="7212528213853025915">Optimium dëshiron të eksportojë fjalëkalimet e tua. Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="112640046208448578">Identifiko gjërat ose vendet dhe kopjo ose përkthe tekstin. Kur përdor "Kërkimin nëpërmjet imazheve", një pamje ekrani e faqes dërgohet te serveri. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium është shfletuesi yt i parazgjedhur</translation>
<translation id="1131805035311359397">Për të kontrolluar nëse fjalëkalimet e tua janë të sigurta nga nxjerrjet e paautorizuara të të dhënave dhe probleme të tjera të sigurisë, <ph name="BEGIN_LINK" />identifikohu në Chromium<ph name="END_LINK" />.</translation>
<translation id="3458316367708035110">{COUNT,plural, =1{Administratori yt kërkon që të nisësh sërish Optimium për të zbatuar këtë përditësim. Është hapur një "Dritare e izoluar" ose "E fshehtë". Ajo nuk do të rihapet pasi ta nisësh sërish.}other{Administratori yt kërkon që të nisësh sërish Optimium për të zbatuar këtë përditësim. Janë hapur # "Dritare të izoluara" dhe "Të fshehta" nëpër profile. Ato nuk do të rihapen pasi ta nisësh sërish.}}</translation>
<translation id="1150418667633096194">Butoni "Paneli anësor i 'Kërko në Google'" në shiritin e veglave ka një ikonë të re. Kliko tek ai për të bërë pyetje ndërkohë që shfleton me panelin anësor të "Kërko në Google".</translation>
<translation id="759898790519515623">Kliko te menyja e Optimium</translation>
<translation id="1157952955648710254">Mbyll panelin anësor të "Kërko në Google"</translation>
<translation id="1157985233335035034">Gjuhët e fundit</translation>
<translation id="1184145431117212167">Instalimi dështoi pasi versioni yt i Windows nuk mbështetet.</translation>
<translation id="1185134272377778587">Rreth Chromium</translation>
<translation id="5987505065981917957">Merr sinjalizime për monitorimin e çmimeve me Optimium në telefonin tënd</translation>
<translation id="1203500561924088507">Faleminderit që e instalove. Duhet të rinisësh shfletuesin përpara se të përdorësh <ph name="BUNDLE_NAME" />.</translation>
<translation id="1232234696885483911">Kur hap "Kërkimin e imazheve", titulli i faqes, URL-ja dhe përmbajtja, duke përfshirë skedarët PDF, do të dërgohen automatikisht te serveri. <ph name="LEARN_MORE" /></translation>
<translation id="3560913454241378492">Kur je i identifikuar, mund të përdorësh fjalëkalimet dhe më shumë nga "Llogaria jote e Google" në Optimium. Për ta ndryshuar këtë, shko te "Llogaria jote në Optimium".</translation>
<translation id="8922965532693587493">Shfaq Gemini në Optimium në shiritin e menysë së Mac</translation>
<translation id="236433590733312836">Për të zgjedhur një pjesë të ekranit në Gemini në Optimium, përdor shkurtoren e tastierës.</translation>
<translation id="7976124325589452515">Kur kjo skedë ishte joaktive, memoria u lirua që Optimium të vazhdojë të jetë i shpejtë. Mund të zgjedhësh që ta përjashtosh gjithmonë këtë sajt nga caktimi si joaktiv.</translation>
<translation id="2758503437544511902">Optimium e bllokoi këtë shkarkim sepse skedari është i rrezikshëm</translation>
<translation id="126567311906253476">Kur identifikohesh me <ph name="USER_EMAIL" /> në shërbimet e Google, si p.sh. Gmail ose YouTube, mund të identifikohesh automatikisht në Chromium me të njëjtën llogari</translation>
<translation id="4104061172701635162">Merr Optimium në telefonin tënd</translation>
<translation id="1290883685122687410">Gabim në konfigurim: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="3443894627866827446">Konfiguro profilin tënd të ri të Optimium</translation>
<translation id="8946186262159916495">Provo me Gemini në Optimium</translation>
<translation id="7981347318091963592">Optimium ka nevojë për qasje te Bluetooth-i për të eksploruar pajisjet me Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6099322702899630168">Identifikohu në Optimium në telefonin tënd</translation>
<translation id="1330562121671411446">Zbulo gjuhën</translation>
<translation id="3294414641786025647">Fshi po ashtu të dhënat nga Optimium (<ph name="URL" />)</translation>
<translation id="4214354213779528068">{COUNT,plural, =1{"Mbrojtja e përparuar" kërkon që të nisësh sërish Optimium për të zbatuar një përditësim. Është hapur një "Dritare e izoluar" ose "E fshehtë". Ajo nuk do të rihapet pasi ta nisësh sërish.}other{"Mbrojtja e përparuar" kërkon që të nisësh sërish Optimium për të zbatuar një përditësim. Janë hapur # "Dritare të izoluara" dhe "Të fshehta" nëpër profile. Ato nuk do të rihapen pasi ta nisësh sërish.}}</translation>
<translation id="1345251407431278948">U gozhdua! Mund të qasesh përsëri te "Kërkimi nëpërmjet imazheve" nga butoni i ri në shiritin e veglave</translation>
<translation id="1383876407941801731">Kërko</translation>
<translation id="7825299065989465359">Përdor aplikacionin e Optimium për të vazhduar të shfletosh kur je në lëvizje</translation>
<translation id="141901961143729572">Ndaj mendimet e tua</translation>
<translation id="1438812738230833934">Mund ta rihapësh "Kërko në Google" në panelin anësor për të bërë pyetje ndërkohë që shfleton</translation>
<translation id="4131307166987455854">Për të ndarë dritaren tënde, lejo regjistrimin e ekranit për Optimium te "Cilësimet e sistemit".</translation>
<translation id="1470136641087909499">Mund ta rihapësh "Kërko në Google" në Chrome për të bërë pyetje ndërkohë që shfleton</translation>
<translation id="1478370723027452770">Merr ndihmë për Chrome for Testing</translation>
<translation id="9200022682397754538">Për të marrë informacionet e ruajtura etj. nga <ph name="DEVICE" />, identifikohu në Optimium</translation>
<translation id="1497802159252041924">Gabim gjatë instalimit: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Kjo faqe është e mbrojtur</translation>
<translation id="892690000529877604">Ndaj një skedë të Optimium</translation>
<translation id="15408169957028265">Rihap "Kërko në Google" në Chrome</translation>
<translation id="9039191226880557963">Identifikohu në Optimium</translation>
<translation id="1547469039832541117">Përfundon detyrën e theksuar.</translation>
<translation id="4414991100979797293">Gozhdo Optimium</translation>
<translation id="1574377791422810894">Veglat e sigurisë të Chromium</translation>
<translation id="3934587628489930735">Optimium dëshiron të fshijë të dhënat e tua të "Menaxherit të fjalëkalimeve". Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="6745390171113033635">{COUNT,plural, =0{Administratori yt kërkon që të hapësh përsëri Optimium për të zbatuar këtë përditësim}=1{Administratori yt kërkon që të hapësh përsëri Optimium për të zbatuar këtë përditësim Dritarja jote "e fshehtë" nuk do të rihapet.}other{Administratori yt kërkon që të hapësh përsëri Optimium për të zbatuar këtë përditësim # dritaret e tua "të fshehta" nuk do të rihapen.}}</translation>
<translation id="7186551909256266009">Merr më të mirën e Google me aplikacionin e Optimium në telefonin tënd</translation>
<translation id="1625909126243026060">Shqyrto kontrollet kryesore të sigurisë dhe privatësisë në Chromium</translation>
<translation id="1640672724030957280">Po shkarkohet...</translation>
<translation id="1648201623125974721">Ikonë e re, e njëjta shkurtore: Kliko për të bërë pyetje ndërkohë që shfleton me "Detyrat kontekstuale".</translation>
<translation id="1665602916345474427">Identifikuar si <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, anëtarësim. Hap menynë e llogarisë</translation>
<translation id="1708414395296835197">Mund të përdorësh Chromium sa herë që klikon te lidhjet në mesazhe, dokumente dhe aplikacione të tjera. Ai do të gozhdohet gjithashtu te shiriti i detyrave.</translation>
<translation id="1709772298389099340">Ofron privilegje të larta për <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Kjo do të të lejojë që të zgjedhësh nga pajisjet e disponueshme dhe të shfaqësh përmbajtjet në to.</translation>
<translation id="6717880500969720524">Optimium do t'i fshijë së shpejti të dhënat e shfletimit</translation>
<translation id="1736443181683099871">Chromium do të përpiqet t'i përmirësojë navigimet në HTTPS</translation>
<translation id="4418738262462299802">Të dhënat e Optimium u pastruan</translation>
<translation id="8469746761106187775">Optimium do të riniset pas <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Kur HTTPS nuk ofrohet, Chromium do të përdorë një lidhje të pasigurt pa të të paralajmëruar</translation>
<translation id="1769661297620183092">Mund të rihapësh panelin e "Kërko në Google" për të bërë pyetje ndërkohë që shfleton</translation>
<translation id="6555789357989792722">Lejo që Optimium të ekzekutohet në sfond</translation>
<translation id="627441522449241646">Për ta bërë më të sigurt Optimium, çaktivizuam disa shtesa që nuk janë të listuara në <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> dhe që mund të jenë shtuar pa dijeninë tënde.</translation>
<translation id="1912380661217770781">Kliko te <ph name="BEGIN_BOLD" />Po<ph name="END_BOLD" /> në njoftimin e Windows për të gozhduar Optimium te shiriti i detyrave për qasje të shpejtë.</translation>
<translation id="9034578483087384251">Instalo përsëri Optimium</translation>
<translation id="2856362667064664106">Optimium po përpiqet <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="1665590461646883113"><ph name="EXISTING_USER" /> është identifikuar tashmë. Për ta mbajtur shfletimin tënd të ndarë, identifikohu në Optimium në profilin tënd si <ph name="USER_EMAIL_ADDRESS" />. Do të marrësh gjithashtu shtesat e tua etj. nga <ph name="DEVICE" />.</translation>
<translation id="1668665535355826445">Herën tjetër që të hapësh Optimium në <ph name="DEVICE_TYPE" />, do të shikosh një kërkesë për të përdorur "Menaxherin e fjalëkalimeve të Google".</translation>
<translation id="1838374766361614909">Fshi kërkimin</translation>
<translation id="8674417702521959187">Për t'i fshirë të dhënat e shfletimit vetëm nga kjo pajisje, ndërkohë që i mban ato në "Llogarinë tënde të Google", <ph name="BEGIN_LINK" />dil nga llogaria në Optimium<ph name="END_LINK" />.</translation>
<translation id="6186721318460238018">Shkarko Optimium në telefon për të hapur ose krijuar grupe të reja skedash kur je në lëvizje.</translation>
<translation id="185970820835152459">Mund t'i menaxhosh "Llogaritë e Google" ku je identifikuar. "Llogaritë e tua të Google" përdoren për shfletuesin Chromium, Play Store, Gmail etj. Nëse do të shtosh një llogari për dikë tjetër, si p.sh. anëtar të familjes, shto më mirë një person të ri te <ph name="DEVICE_TYPE" /> yt. <ph name="LINK_BEGIN" />Mëso më shumë<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Kërko me "Kërkimin nëpërmjet imazheve"</translation>
<translation id="1781731701613313704"><ph name="EXISTING_USER" /> është identifikuar tashmë. Për ta mbajtur shfletimin tënd të ndarë, identifikohu në Optimium në profilin tënd si <ph name="USER_EMAIL_ADDRESS" />. Do të marrësh gjithashtu faqeshënuesit e tu etj. nga <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Përzgjidh tekstin</translation>
<translation id="5960850334733792580">Po identifikohesh me një llogari të menaxhuar dhe po i jep administratorit të saj kontrollin mbi profilin tënd të Optimium. Të dhënat e tua të Optimium, si aplikacionet, faqeshënuesit, historiku, fjalëkalimet dhe cilësimet e tjera do të bëhen të lidhura përgjithmonë me <ph name="USER_NAME" />. Do të mund t'i fshish këto të dhëna nëpërmjet "Panelit të llogarive të Google", por nuk do të mund t'i lidhësh këto të dhëna me një llogari tjetër. Mund të krijosh si opsion një profil të ri për t'i mbajtur më vete të dhënat ekzistuese të Optimium. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium kursen energjinë e baterisë duke kufizuar aktivitetin në sfond dhe efektet vizuale, si p.sh. lëvizjen e butë dhe shpejtësitë e kuadrove të videove. <ph name="BEGIN_LINK" />Mëso më shumë për "Kursyesin e energjisë"<ph name="END_LINK" /></translation>
<translation id="7900167719031567542">Optimium Updater Service</translation>
<translation id="1911763535808217981">Duke çaktivizuar këtë, mund të identifikohesh në sajtet e Google si Gmail pa u identifikuar në Chromium</translation>
<translation id="5015349619125768393">Optimium nuk përgjigjet. Dëshiron ta hapësh sërish tani?</translation>
<translation id="2019000760486664637">Organizata jote, <ph name="MANAGER" />, kërkon që të identifikohesh në Optimium</translation>
<translation id="193439633299369377">ChromiumOS ka nevojë të riniset për të zbatuar përditësimin.</translation>
<translation id="3382368450324191331">Optimium e bllokoi këtë shkarkim sepse lloji i skedarit nuk është shkarkuar zakonisht dhe mund të jetë i rrezikshëm</translation>
<translation id="1953553007165777902">Po shkarkohet... Kanë mbetur edhe <ph name="MINUTE" /> minuta</translation>
<translation id="1966382378801805537">Chromium nuk mund të përcaktojë ose caktojë shfletuesin e parazgjedhur</translation>
<translation id="197326043290947695">Shfleto në mënyrë më inteligjente me "Kërkimin e imazheve"</translation>
<translation id="5321661580966500942">Mëso se pse Optimium i bllokon disa skedarë, hapet në një skedë të re</translation>
<translation id="8960045458031480819">E mban të përditësuar softuerin e Optimium. Nëse ky shërbim çaktivizohet ose ndalohet, softueri yt i Optimium nuk do të mbahet i përditësuar, që do të thotë se dobësitë e sigurisë që mund të lindin nuk mund të rregullohen dhe veçoritë mund të mos funksionojnë. Ky shërbim çinstalohet vetë kur nuk ka një softuer të Optimium që e përdor atë.</translation>
<translation id="2008474315282236005">Kjo do të fshijë 1 artikull nga kjo pajisje. Për t'i marrë më vonë të dhënat, identifikohu te Chromium si <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Instalimi nuk u krye. Provo përsëri.</translation>
<translation id="2039417478970545937">Cilësimet.</translation>
<translation id="2049376729098081731">Zgjidh nëse do ta përfshish historikun e Chromium për përvoja më të personalizuara në shërbimet e Google</translation>
<translation id="4120951192672345208">I integruar në Optimium për të të ndihmuar të krijosh, ruash dhe plotësosh automatikisht fjalëkalime të forta. Shto shkurtoren për qasje të lehtë.</translation>
<translation id="2060311596979880693">Me sukses! Tani mund të bësh me lehtësi pyetje ndërkohë që shfleton me "Kërko në Google" në Chrome</translation>
<translation id="7165258062917217746">Kliko te butoni "Personalizo Optimium" në faqen e skedës së re për t'i dhënë Optimium një pamje të re</translation>
<translation id="3702823791268559760">Optimium e bllokoi këtë shkarkim sepse skedari është mashtrues dhe mund të bëjë ndryshime të papritura në pajisjen tënde</translation>
<translation id="2370804817835146114">Do të shikosh një kërkesë për të provuar <ph name="FEATURE_NAME" /> herën tjetër kur të hapësh Optimium për iOS.</translation>
<translation id="5887094242311035059">Fjalëkalimet e tua dhe të dhënat e tjera të Optimium që ke ruajtur në "Llogarinë tënde të Google" do të hiqen nga kjo pajisje. Për t'i përdorur përsëri në Optimium, identifikohu përsëri.</translation>
<translation id="8794268168383660193">{COUNT,plural, =1{Organizata jote i fshin automatikisht të dhënat e shfletimit kur Optimium nuk përdoret për 1 minutë. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet. Skedat e tua do të qëndrojnë të hapura.}other{Organizata jote i fshin automatikisht të dhënat e shfletimit kur Optimium nuk përdoret për # minuta. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet. Skedat e tua do të qëndrojnë të hapura.}}</translation>
<translation id="2125838419757773031">Zgjidh rajonin e ekranit për të kërkuar</translation>
<translation id="2126108037660393668">Skedari i shkarkuar nuk u verifikua.</translation>
<translation id="2135919691573380097">Raportoje këtë sajt</translation>
<translation id="2137162749895930932">Mbyll ekranin e përkthimit</translation>
<translation id="2147218225094845757">Fshihe panelin anësor</translation>
<translation id="8888656790178891761">Optimium e bllokoi këtë shkarkim sepse sajti nuk po përdor një lidhje të sigurt dhe mund të ketë pasur ndërhyrje te skedari</translation>
<translation id="2170098639895543546">Zgjidh çdo gjë në faqe</translation>
<translation id="6975401993318112971">Personalizo Optimium</translation>
<translation id="2174917724755363426">Instalimi nuk përfundoi. E konfirmon që dëshiron ta anulosh?</translation>
<translation id="7741769305753410467">Optimium - identifikimi në rrjet - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Gabim në kontrollin e përditësimeve: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2133097742403140075">Hiqe llogarinë nga Optimium</translation>
<translation id="6495056863394621013">Përdor aplikacionin e Optimium për të marrë veglat më të mira të blerjeve kur je në lëvizje</translation>
<translation id="2209877494277346829">Izolo Chromium nga aplikacionet e tjera</translation>
<translation id="2035198300681156782">Qëndro më i sigurt në lëvizje me "Shfletimin e sigurt të përmirësuar" në Optimium për iOS</translation>
<translation id="2210682093923538346">Sajt i rrezikshëm. Chromium ka hequr njoftimet.</translation>
<translation id="2236949375853147973">Aktiviteti im</translation>
<translation id="871771486544954531">Për të marrë adresat etj. në të gjitha pajisjet e tua, identifikohu në Optimium. Kjo adresë do të ruhet në "Llogarinë tënde të Google" pasi të identifikohesh.</translation>
<translation id="524316078518338158">Nëse e ndan një kompjuter, miqtë dhe familja mund të shfletojnë veçmas dhe ta konfigurojnë Optimium pikërisht ashtu si dëshirojnë.</translation>
<translation id="22571759390241347">"Aftësitë" në Chromium</translation>

<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ta">
<translation id="1026101648481255140">நிறுவலை மீண்டும் தொடங்கு</translation>
<translation id="1029669172902658969">&amp;ChromiumOSஸைப் புதுப்பிக்க மீண்டும் தொடங்கு</translation>
<translation id="4063809399345498325">இந்த நீட்டிப்பைச் சரிபார்க்குமாறு Optimium பரிந்துரைக்கிறது</translation>
<translation id="1042552502243217427">ஒரு தளம் அதன் பக்கத்தில் இருக்கும் இணைப்புகளைத் தனிப்பட்ட முறையில் முன்கூட்டியே ஏற்றுமாறு கேட்கும்போது Google சேவையகங்களை Chromium பயன்படுத்துகிறது. இதனால் முன்கூட்டியே ஏற்றப்பட்ட தளத்துடன் உங்கள் அடையாளம் பகிரப்படாது. ஆனால் எந்தத் தளம் முன்கூட்டியே ஏற்றப்பட வேண்டும் என்பதை Google அறிந்துகொள்ளும்.</translation>
<translation id="1051793555070215510">இந்த ஒரு நிமிடக் கருத்துக்கணிப்பில் பங்கேற்று, மறைநிலைப் பயன்முறையை மேம்படுத்த எங்களுக்கு உதவுங்கள்.</translation>
<translation id="1065672644894730302">உங்கள் விருப்பதேர்வுகள் படிக்கும்படி இல்லை. சில அம்சங்கள் கிடைக்காமல் இருக்கலாம் மேலும் விருப்பதேர்வுகளின் மாற்றங்களைச் சேமிக்க முடியாது.</translation>
<translation id="7250992450852052182">Optimiumமில் "தளங்கள், ஆப்ஸ், நீட்டிப்புகள் ஆகியவற்றுக்கான அனுமதிகள்" என்பதை உங்கள் பெற்றோர் முடக்கிவிட்டார்</translation>
<translation id="6711838932294803312">அருகிலுள்ள சாதனங்களைக் கண்டறிந்து பயன்படுத்த Optimiumமிற்கு உங்கள் லோக்கல் நெட்வொர்க் அணுகல் தேவை</translation>
<translation id="2807920805712601449">குறிப்பிட்ட Optimium அம்சம் அல்லது நீட்டிப்பைத் தேட, முகவரிப் பட்டியில் அதன் ஷார்ட்கட்டை டைப் செய்தபிறகு நீங்கள் தேர்ந்தெடுத்த கீபோர்டு பட்டனை டைப் செய்யவும்</translation>
<translation id="5994612110840535151">சிஸ்டம் டிரேயில் Optimiumமில் Search காட்டி, கீபோர்டு ஷார்ட்கட்டை ஆன் செய்</translation>
<translation id="7212528213853025915">Optimium உங்கள் கடவுச்சொற்களை ஏற்ற விரும்புகிறது. இதை அனுமதிக்க, உங்கள் Windows கடவுச்சொல்லை உள்ளிடவும்.</translation>
<translation id="112640046208448578">பொருட்களையும் இடங்களையும் கண்டறியலாம், வார்த்தைகளை நகலெடுக்கலாம் மொழிபெயர்க்கலாம். படத் தேடலைப் பயன்படுத்தும்போது அந்தப் பக்கத்தின் ஸ்கிரீன்ஷாட் சேவையகத்துக்கு அனுப்பப்படும். <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">உங்கள் இயல்புநிலை உலாவி Chromium ஆகும்</translation>
<translation id="1131805035311359397">தரவு மீறல்கள் மற்றும் பிற பாதுகாப்புச் சிக்கல்களிலிருந்து உங்கள் கடவுச்சொற்கள் பாதுகாப்பாக இருக்கின்றனவா என்பதைச் சரிபார்க்க <ph name="BEGIN_LINK" />Chromiumமில் உள்நுழையுங்கள்<ph name="END_LINK" />.</translation>
<translation id="3458316367708035110">{COUNT,plural, =1{இந்தப் புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி கேட்கிறார். மறைநிலை அல்லது ஐசோலேட்டட் விண்டோ திறந்துள்ளது. மீண்டும் தொடங்கினால் அது திறக்கப்படாது.}other{இந்தப் புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி கேட்கிறார். சுயவிவரங்கள் முழுவதிலும் # மறைநிலை மற்றும் ஐசோலேட்டட் விண்டோக்கள் திறந்துள்ளன. மீண்டும் தொடங்கினால் அவை திறக்கப்படாது.}}</translation>
<translation id="1150418667633096194">கருவிப்பட்டியில் உள்ள "Google Search பக்கவாட்டு பேனல்" பட்டன் புதிய ஐகானைப் பெற்றுள்ளது. நீங்கள் பிரவுசிங் செய்யும்போதே ‘Google Search பக்கவாட்டு பேனல்’ மூலம் கேள்விகளைக் கேட்க, அதைக் கிளிக் செய்யுங்கள்.</translation>
<translation id="759898790519515623">Optimium மெனுவைக் கிளிக் செய்யவும்</translation>
<translation id="1157952955648710254">Google Search பக்கவாட்டு பேனலை மூடும்</translation>
<translation id="1157985233335035034">சமீபத்திய மொழிகள்</translation>
<translation id="1184145431117212167">ஆதரிக்கப்படாத Windows பதிப்பை நீங்கள் பயன்படுத்துவதால் நிறுவ முடியவில்லை.</translation>
<translation id="1185134272377778587">Chromium அறிமுகம்</translation>
<translation id="5987505065981917957">உங்கள் மொபைலில் Optimium மூலம் விலைக் கண்காணிப்பு விழிப்பூட்டல்களைப் பெறுங்கள்</translation>
<translation id="1203500561924088507">நிறுவியதற்கு நன்றி. <ph name="BUNDLE_NAME" /> ஐப் பயன்படுத்துவதற்கு முன் உலாவியை மீண்டும் தொடங்க வேண்டும்.</translation>
<translation id="1232234696885483911">படத் தேடலைத் திறக்கும்போது பக்கத் தலைப்பு, URL, PDFகள் உள்ளிட்ட உள்ளடக்கம் ஆகியவை தானாகவே சேவையகத்திற்கு அனுப்பப்படும். <ph name="LEARN_MORE" /></translation>
<translation id="3560913454241378492">உள்நுழைந்திருக்கும்போது உங்கள் Google கணக்கில் உள்ள கடவுச்சொற்களையும், மேலும் பலவற்றையும் நீங்கள் Optimiumமில் பயன்படுத்தலாம். இதை மாற்ற, “Optimiumமில் உங்கள் கணக்கு” என்பதற்குச் செல்லவும்.</translation>
<translation id="8922965532693587493">Mac மெனு பட்டியில் Optimiumமில் Geminiயைக் காட்டு</translation>
<translation id="236433590733312836">Optimiumமில் Geminiயில் திரையின் ஒரு பகுதியைத் தேர்ந்தெடுக்க கீபோர்டு ஷார்ட்கட்டைப் பயன்படுத்தலாம்.</translation>
<translation id="7976124325589452515">Optimium தொடர்ந்து வேகமாக இயங்குவதற்கு, இந்தப் பக்கம் செயலில் இல்லாதபோது நினைவகம் காலியாக்கப்பட்டது. இந்தத் தளத்தை எப்போதும் செயலற்ற நிலையில் இருந்து விலக்க நீங்கள் தேர்வுசெய்யலாம்.</translation>
<translation id="2758503437544511902">இந்த ஃபைல் ஆபத்தானது என்பதால் இந்தப் பதிவிறக்கத்தை Optimium தடுத்துள்ளது</translation>
<translation id="126567311906253476"><ph name="USER_EMAIL" /> கணக்கின் மூலம் Gmail, YouTube போன்ற Google சேவைகளில் உள்நுழையும்போது Chromiumமிலும் அதே கணக்கின் மூலம் தானாக நீங்கள் உள்நுழையலாம்.</translation>
<translation id="4104061172701635162">உங்கள் மொபைலில் Optimiumமைப் பெறுங்கள்</translation>
<translation id="1290883685122687410">அமைவுப் பிழை: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="3443894627866827446">உங்கள் புதிய Optimium சுயவிவரத்தை அமைத்திடுங்கள்</translation>
<translation id="8946186262159916495">Optimiumமில் Gemini மூலம் பயன்படுத்துக</translation>
<translation id="7981347318091963592">புளூடூத் சாதனங்களைக் கண்டறிய
 Optimiumமிற்கு புளூடூத் அணுகல் தேவை. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6099322702899630168">மொபைலில் Optimiumமில் உள்நுழையுங்கள்</translation>
<translation id="1330562121671411446">மொழியைக் கண்டறி</translation>
<translation id="3294414641786025647">Optimium தரவையும் நீக்கு (<ph name="URL" />)</translation>
<translation id="4214354213779528068">{COUNT,plural, =1{புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி மேம்பட்ட பாதுகாப்பு கேட்கிறது. மறைநிலை அல்லது ஐசோலேட்டட் விண்டோ திறந்துள்ளது. மீண்டும் தொடங்கினால் அது திறக்கப்படாது.}other{புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி மேம்பட்ட பாதுகாப்பு கேட்கிறது. சுயவிவரங்கள் முழுவதிலும் # மறைநிலை மற்றும் ஐசோலேட்டட் விண்டோக்கள் திறந்துள்ளன. மீண்டும் தொடங்கினால் அவை திறக்கப்படாது.}}</translation>
<translation id="1345251407431278948">பின் செய்யப்பட்டது! கருவிப்பட்டியில் உள்ள புதிய பட்டன் மூலம் படத் தேடலை மீண்டும் அணுகலாம்</translation>
<translation id="1383876407941801731">தேடுக</translation>
<translation id="7825299065989465359">எங்கிருந்தும் தொடர்ந்து பிரவுஸ் செய்ய Optimium ஆப்ஸைப் பயன்படுத்தலாம்</translation>
<translation id="141901961143729572">உங்கள் கருத்துகளைப் பகிருங்கள்</translation>
<translation id="1438812738230833934">நீங்கள் பிரவுசிங் செய்யும்போதே கேள்விகளைக் கேட்க, பக்கவாட்டு பேனலில் Google Searchசை மீண்டும் திறக்கலாம்</translation>
<translation id="4131307166987455854">சாளரத்தைப் பகிர, சிஸ்டம் அமைப்புகளில் Optimiumமிற்கு ஸ்கிரீன் ரெக்கார்டிங்கை அனுமதிக்கவும்.</translation>
<translation id="1470136641087909499">நீங்கள் பிரவுசிங் செய்யும்போதே கேள்விகளைக் கேட்க Chromeமில் Google Searchசை மீண்டும் திறக்கலாம்</translation>
<translation id="1478370723027452770">Chrome for Testing தொடர்பான உதவியைப் பெறுங்கள்</translation>
<translation id="9200022682397754538"><ph name="DEVICE" /> சாதனத்தில் உள்ள சேமிக்கப்பட்ட தகவல்களையும் மேலும் பலவற்றையும் பெற Optimiumமில் உள்நுழையுங்கள்</translation>
<translation id="1497802159252041924">நிறுவல் பிழை: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">இந்தப் பக்கம் பாதுகாக்கப்படுகிறது</translation>
<translation id="892690000529877604">Optimium தாவலைப் பகிர்தல்</translation>
<translation id="15408169957028265">Chromeமில் Google Searchசை மீண்டும் திறக்கும்</translation>
<translation id="9039191226880557963">Optimiumமில் உள்நுழை</translation>
<translation id="1547469039832541117">தனிப்படுத்திய பணியை முடிக்கும்.</translation>
<translation id="4414991100979797293">Optimiumமைப் பின் செய்</translation>
<translation id="1574377791422810894">Chromiumமின் பாதுகாப்புக் கருவிகள்</translation>
<translation id="3934587628489930735">உங்கள் Password Managerரில் உள்ள தரவை Optimium நீக்க விரும்புகிறது. இதை அனுமதிக்க உங்கள் Windows கடவுச்சொல்லை டைப் செய்யவும்.</translation>
<translation id="6745390171113033635">{COUNT,plural, =0{புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி சொல்கிறார்}=1{புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி சொல்கிறார். உங்கள் மறைநிலை சாளரம் மீண்டும் திறக்காது.}other{புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி சொல்கிறார். உங்கள் # மறைநிலை சாளரங்கள் மீண்டும் திறக்காது.}}</translation>
<translation id="7186551909256266009">உங்கள் மொபைலில் Optimium ஆப்ஸ் மூலம் Googleளின் சிறந்த அம்சங்களைப் பெறுங்கள்</translation>
<translation id="1625909126243026060">Chromiumமில் உள்ள முக்கியமான தனியுரிமை மற்றும் பாதுகாப்புக் கட்டுப்பாடுகளைச் சரிபாருங்கள்</translation>
<translation id="1640672724030957280">பதிவிறக்குகிறது...</translation>
<translation id="1648201623125974721">புதிய ஐகான், அதே ஷார்ட்கட்: நீங்கள் பிரவுசிங் செய்யும்போதே சூழல் சார்ந்த பணிகள் மூலம் கேள்விகளைக் கேட்க கிளிக் செய்யுங்கள்.</translation>
<translation id="1665602916345474427">மெம்பர்ஷிப் உள்ள <ph name="USER_NAME" /> (<ph name="USER_EMAIL" />) என்ற கணக்கில் உள்நுழைந்துள்ளீர்கள். கணக்கு மெனுவைத் திறக்கும்.</translation>
<translation id="1708414395296835197">மெசேஜ்கள், ஆவணங்கள் மற்றும் பிற ஆப்ஸில் உள்ள இணைப்புகளைக் கிளிக் செய்யும்போதெல்லாம் Chromiumமைப் பயன்படுத்தலாம். அது உங்கள் செயல் பட்டியிலும் பின் செய்யப்படும்.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" /> பிரவுசருக்குக் கூடுதல் அணுகலை வழங்கும்.</translation>
<translation id="1722488837206509557">கிடைக்கக்கூடிய சாதனங்களில் இருந்து தேர்ந்தெடுக்கவும், அவற்றில் உள்ளடக்கத்தைக் காட்டவும் இது அனுமதிக்கும்.</translation>
<translation id="6717880500969720524">உலாவிய தரவை Optimium விரைவில் நீக்கும்</translation>
<translation id="1736443181683099871">வழிசெலுத்தல்களை HTTPSக்கு மேம்படுத்த Chromium முயலும்</translation>
<translation id="4418738262462299802">Optimium தரவு அழிக்கப்பட்டது</translation>
<translation id="8469746761106187775"><ph name="REMAINING_TIME" /> இல் Optimium மீண்டும் தொடங்கும்</translation>
<translation id="1749104137266986751">HTTPS கிடைக்காதபோது, Chromium உங்களை எச்சரிக்காமலேயே பாதுகாப்பற்ற இணைப்பைப் பயன்படுத்தும்</translation>
<translation id="1769661297620183092">நீங்கள் பிரவுசிங் செய்யும்போதே கேள்விகளைக் கேட்க Google Search பேனலை மீண்டும் திறக்கலாம்</translation>
<translation id="6555789357989792722">பின்புலத்தில் Optimium ஐ இயக்கு</translation>
<translation id="627441522449241646">Optimium ஐப் பாதுகாப்பானதாக்க <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> இல் பட்டியலிடப்படாத சில நீட்டிப்புகளை நாங்கள் முடக்கிவிட்டோம், மேலும் அவை உங்களுக்குத் தெரியாமல் சேர்க்கப்பட்டிருக்கலாம்.</translation>
<translation id="1912380661217770781">விரைவாக அணுகுவதற்கு Optimiumமை உங்கள் செயல் பட்டியில் பின் செய்ய, Windows அறிவிப்பில் <ph name="BEGIN_BOLD" />ஆம்<ph name="END_BOLD" /> என்பதைக் கிளிக் செய்யுங்கள்.</translation>
<translation id="9034578483087384251">Optimium ஐ மீண்டும்நிறுவு</translation>
<translation id="2856362667064664106">Optimium <ph name="AUTHENTICATION_PURPOSE" /> முயல்கிறது</translation>
<translation id="1665590461646883113"><ph name="EXISTING_USER" /> ஆக ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Optimiumமில் <ph name="USER_EMAIL_ADDRESS" /> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். <ph name="DEVICE" /> கணக்கில் இருந்து உங்கள் நீட்டிப்புகளையும், மேலும் பலவற்றையும் பெறுவீர்கள்.</translation>
<translation id="1668665535355826445">அடுத்த முறை உங்கள் <ph name="DEVICE_TYPE" /> சாதனத்தில் Optimiumமைத் திறக்கும்போது, Google Password Managerரைப் பயன்படுத்தும்படி ஓர் அறிவிப்பு காட்டப்படும்.</translation>
<translation id="1838374766361614909">தேடலை அழி</translation>
<translation id="8674417702521959187">உலாவிய தரவை உங்கள் Google கணக்கில் இருந்து நீக்காமல் இந்தச் சாதனத்தில் இருந்து மட்டும் நீக்க, <ph name="BEGIN_LINK" />Optimiumமில் இருந்து வெளியேறுங்கள்<ph name="END_LINK" />.</translation>
<translation id="6186721318460238018">எங்கிருந்தும் புதிய பக்கக் குழுக்களைத் திறக்கவோ உருவாக்கவோ உங்கள் மொபைலில் Optimiumமைப் பதிவிறக்குங்கள்.</translation>
<translation id="185970820835152459">நீங்கள் உள்நுழைந்துள்ள Google கணக்குகளை நிர்வகிக்கலாம். Chromium உலாவி, Play Store, Gmail மற்றும் பலவற்றில் உங்கள் Google கணக்குகள் பயன்படுத்தப்படும். வேறு ஒருவரின் (எ.கா. குடும்ப உறுப்பினர்) கணக்கைச் சேர்க்க விரும்பினால் உங்கள் <ph name="DEVICE_TYPE" /> சாதனத்தில் ஒரு புதிய பயனரைச் சேர்க்கவும். <ph name="LINK_BEGIN" />மேலும் அறிக<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">படத் தேடல் மூலம் தேடு</translation>
<translation id="1781731701613313704"><ph name="EXISTING_USER" /> கணக்கில் ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Optimiumமில் <ph name="USER_EMAIL_ADDRESS" /> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். <ph name="DEVICE" /> இருந்து புக்மார்க்குகளையும், மேலும் பலவற்றையும் பெறுவீர்கள்.</translation>
<translation id="1880677175115548835">உரையைத் தேர்வுசெய்க</translation>
<translation id="5960850334733792580">நீங்கள் நிர்வகிக்கப்படும் கணக்கு மூலம் உள்நுழைகிறீர்கள், மேலும் அதன் நிர்வாகிக்கு உங்கள் Optimium சுயவிவரத்தின் கட்டுப்பாட்டை வழங்குகிறீர்கள். உங்கள் ஆப்ஸ், புக்மார்க்குகள், வரலாறு, கடவுச்சொற்கள் போன்ற உங்கள் Optimium தரவு மற்றும் பிற அமைப்புகள் நிரந்தரமாக <ph name="USER_NAME" /> உடன் இணைக்கப்படும். இந்தத் தரவை Google கணக்குகளின் டாஷ்போர்டு வழியாக நீக்க முடியும், ஆனால் இந்தத் தரவை வேறொரு கணக்குடன் தொடர்புபடுத்த முடியாது. விரும்பினால், உங்களுடைய நடப்பு Optimium தரவைத் தனிப்பட்ட முறையில் வைத்திருக்க நீங்கள் புதிய சுயவிவரத்தை உருவாக்கலாம். <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">பின்னணிச் செயல்பாடுகளையும் ஸ்மூத் ஸ்க்ரோலிங், வீடியோ ஃப்ரேம் வீதங்கள் போன்ற விஷுவல் எஃபெக்ட்டுகளையும் கட்டுப்படுத்தி Chromium பேட்டரி பவரைச் சேமிக்கிறது. <ph name="BEGIN_LINK" />எனர்ஜி சேமிப்பு குறித்து மேலும் தெரிந்துகொள்ளுங்கள்<ph name="END_LINK" /></translation>
<translation id="7900167719031567542">Optimium Updater Service</translation>
<translation id="1911763535808217981">இதை முடக்கினால், நீங்கள் Chromiumமில் உள்நுழையாமலேயே Gmail போன்ற Google தளங்களில் உள்நுழையலாம்</translation>
<translation id="5015349619125768393">Optimium பதிலளிக்கவில்லை. இப்போது மீண்டும் தொடங்கவா?</translation>
<translation id="2019000760486664637">Optimiumமில் உள்நுழையும்படி உங்கள் நிறுவனம் (<ph name="MANAGER" />) வலியுறுத்துகிறது</translation>
<translation id="193439633299369377">புதுப்பிப்பைப் பயன்படுத்த, ChromiumOSஸை மீண்டும் தொடங்க வேண்டும்.</translation>
<translation id="3382368450324191331">இந்த ஃபைல் வகை பொதுவாகப் பதிவிறக்கப்படுவதில்லை என்பதுடன் ஆபத்தானதாகவும் இருக்கலாம் என்பதால் இந்தப் பதிவிறக்கத்தை Optimium தடுத்துள்ளது</translation>
<translation id="1953553007165777902">பதிவிறக்குகிறது... <ph name="MINUTE" /> நிமிடங்கள் மீதமுள்ளன</translation>
<translation id="1966382378801805537">இயல்புநிலை உலாவியைக் கண்டறியவோ அமைக்கவோ Chromium ஆல் முடியவில்லை</translation>
<translation id="197326043290947695">படத்தேடல் மூலம் ஸ்மார்ட் பிரவுசிங் செய்க</translation>
<translation id="5321661580966500942">சில ஃபைல்களைத் தடுத்து, புதிய பக்கத்தில் Optimium ஏன் திறக்கிறது என்று தெரிந்துகொள்ளுங்கள்.</translation>
<translation id="8960045458031480819">Optimium மென்பொருளைச் சமீபத்தியதாக வைத்திருக்கும். இந்தச் சேவை முடக்கப்பட்டாலோ நிறுத்தப்பட்டாலோ, உங்கள் Optimium மென்பொருள் சமீபத்தியதாக வைத்திருக்கப்படாது. அதாவது, பாதுகாப்புக் குறைபாடுகள் ஏற்படக்கூடும். அவற்றைச் சரிசெய்ய முடியாது என்பதுடன் அம்சங்களும் செயல்படாமல் போகலாம். இந்தச் சேவையை Optimium மென்பொருள் எதுவும் பயன்படுத்தவில்லை என்றால், சேவை தானாகவே நிறுவல் நீக்கப்படும்.</translation>
<translation id="2008474315282236005">வெளியேறினால், இந்தச் சாதனத்திலிருந்து ஓர் உருப்படி நீக்கப்படும். பின்னர் தரவை மீட்டமைக்க, Chromium இல் <ph name="USER_EMAIL" /> எனும் முகவரியின் மூலம் உள்நுழையவும்.</translation>
<translation id="2018879682492276940">நிறுவ முடியவில்லை. மீண்டும் முயலவும்.</translation>
<translation id="2039417478970545937">அமைப்புகள்.</translation>
<translation id="2049376729098081731">Google சேவைகளில் மேலும் பிரத்தியேகமான அனுபவங்களைப் பெறுவதற்கு Chromium செயல்பாடுகளைச் சேர்க்க வேண்டுமா என்பதைத் தேர்வுசெய்யலாம்</translation>
<translation id="4120951192672345208">வலிமையான கடவுச்சொற்களை உருவாக்கவும், சேமிக்கவும், தானாக நிரப்பவும் உங்களுக்கு உதவ இது Optimiumமில் உள்ளமைக்கப்பட்டுள்ளது. எளிதாக அணுக ஷார்ட்கட்டைச் சேருங்கள்.</translation>
<translation id="2060311596979880693">முடிந்தது! நீங்கள் பிரவுசிங் செய்யும்போதே Chromeமில் Google Search மூலம் எளிதாகக் கேள்விகளைக் கேட்கலாம்</translation>
<translation id="7165258062917217746">Optimiumமிற்குப் புதிய தோற்றத்தைக் கொடுக்க, புதிய பக்கத்தில் உள்ள Optimiumமைப் பிரத்தியேகமாக்குவதற்கான பட்டனைக் கிளிக் செய்யுங்கள்</translation>
<translation id="3702823791268559760">இந்த ஃபைல் ஏமாற்றக்கூடியது என்பதுடன் உங்கள் சாதனத்தில் எதிர்பாராத மாற்றங்களையும் செய்யலாம் என்பதால் இந்தப் பதிவிறக்கத்தை Optimium தடுத்துள்ளது</translation>
<translation id="2370804817835146114">அடுத்த முறை Optimium iOSஸைத் திறக்கும்போது <ph name="FEATURE_NAME" /> அம்சத்தைப் பயன்படுத்திப் பார்க்கும்படி ஓர் அறிவிப்பு காட்டப்படும்.</translation>
<translation id="5887094242311035059">உங்கள் Google கணக்கில் நீங்கள் சேமித்த உங்கள் கடவுச்சொற்களும் பிற Optimium தரவும் இந்தச் சாதனத்தில் இருந்து அகற்றப்படும். அவற்றைத் திரும்பவும் Optimiumமில் பயன்படுத்த, மீண்டும் உள்நுழையவும்.</translation>
<translation id="8794268168383660193">{COUNT,plural, =1{Optimium 1 நிமிடத்திற்குப் பயன்படுத்தப்படாமல் இருந்தால் உலாவிய தரவை உங்கள் நிறுவனம் தானாகவே நீக்கிவிடும். இதில் பதிவு, தன்னிரப்பி, பதிவிறக்கங்கள் ஆகியவை அடங்கலாம். உலாவிப் பக்கங்கள் திறந்தே இருக்கும்.}other{Optimium # நிமிடங்களுக்குப் பயன்படுத்தப்படாமல் இருந்தால் உலாவிய தரவை உங்கள் நிறுவனம் தானாகவே நீக்கிவிடும். இதில் பதிவு, தன்னிரப்பி, பதிவிறக்கங்கள் ஆகியவை அடங்கலாம். உலாவிப் பக்கங்கள் திறந்தே இருக்கும்.}}</translation>
<translation id="2125838419757773031">தேட திரையின் பகுதியைத் தேர்ந்தெடுக்கலாம்</translation>
<translation id="2126108037660393668">பதிவிறக்கப்பட்ட ஃபைலைச் சரிபார்க்க முடியவில்லை.</translation>
<translation id="2135919691573380097">இந்தத் தளத்தைப் புகாரளிக்கவும்</translation>
<translation id="2137162749895930932">மொழிபெயர்ப்புத் திரையை மூடும்</translation>
<translation id="2147218225094845757">பக்கவாட்டுப் பேனலை மறைக்கும்</translation>
<translation id="8888656790178891761">இந்தத் தளம் பாதுகாப்பான இணைப்பைப் பயன்படுத்தவில்லை என்பதுடன் ஃபைலும் சிதைந்து இருக்கலாம் என்பதால் இந்தப் பதிவிறக்கத்தை Optimium தடுத்துள்ளது</translation>
<translation id="2170098639895543546">இந்தப் பக்கத்தில் எதையும் தேர்ந்தெடுங்கள்</translation>
<translation id="6975401993318112971">Optimiumமைப் பிரத்தியேகப்படுத்து</translation>
<translation id="2174917724755363426">நிறுவல் நிறைவடையவில்லை. நிச்சயமாக ரத்துசெய்ய வேண்டுமா?</translation>
<translation id="7741769305753410467">Optimium - நெட்வொர்க் உள்நுழைவு - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">புதுப்பிப்புச் சரிபார்ப்புப் பிழை: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2133097742403140075">Optimiumமில் இருந்து கணக்கை அகற்று</translation>
<translation id="6495056863394621013">சிறந்த ஷாப்பிங் கருவிகளை எங்கிருந்தும் அணுக Optimium ஆப்ஸைப் பயன்படுத்தலாம்</translation>
<translation id="2209877494277346829">பிற ஆப்ஸில் இருந்து Chromiumமைத் தனிப்படுத்து</translation>
<translation id="2035198300681156782">iOSஸிற்கான Optimiumமில் மேம்பட்ட பாதுகாப்பான பிரவுசிங் மூலம் எங்கும் பாதுகாப்பாக இருக்கலாம்</translation>
<translation id="2210682093923538346">ஆபத்தான தளம். அறிவிப்புகள் அனுமதியை Chromium அகற்றிவிட்டது.</translation>
<translation id="2236949375853147973">எனது செயல்பாடுகள்</translation>
<translation id="871771486544954531">முகவரிகள் மற்றும் பலவற்றை உங்கள் சாதனங்கள் எல்லாவற்றிலும் பெற Optimiumமில் உள்நுழையுங்கள். நீங்கள் உள்நுழைந்த பிறகு உங்கள் Google கணக்கில் இந்த முகவரி சேமிக்கப்படும்.</translation>
<translation id="524316078518338158">நீங்கள் கம்ப்யூட்டரைப் பகிர்ந்தால், நண்பர்களும் குடும்பத்தினரும் தனிப்பட்ட முறையில் உலாவலாம், மேலும் Optimiumமை அவர்கள் விருப்பத்திற்கு ஏற்ப அமைத்துக்கொள்ளலாம்.</translation>
<translation id="22571759390241347">Chromiumமில் திறன்கள்</translation>
<translation id="2283228908180457226">புதிய ஐகான், அதே ஷார்ட்கட்: நீங்கள் பிரவுசிங் செய்யும்போதே ‘Google Search பக்கவாட்டு பேனல்’ மூலம் கேள்விகளைக் கேட்க கிளிக் செய்யுங்கள்.</translation>
<translation id="2283803047247799269">படத் தேடல் மூலம் இந்தப் பக்கத்தைத் தேடுங்கள்</translation>
<translation id="5808794606375505413">{NUM_TABS,plural, =1{உங்கள் பிரவுசர் செயல்படும் வேகத்தைக் குறைக்கும் பக்கத்தை இடைநிறுத்தும்படி Optimium பரிந்துரைக்கிறது}other{உங்கள் பிரவுசர் செயல்படும் வேகத்தைக் குறைக்கும் பக்கங்களை இடைநிறுத்தும்படி Optimium பரிந்துரைக்கிறது}}</translation>
<translation id="2307973900865360088">Dockகில் வைத்திரு</translation>
<translation id="2313870531055795960">Chromiumமில் சேமிக்கப்பட்டுள்ள பாதுகாப்பில்லாத தளங்களின் பட்டியலைப் பயன்படுத்தி URLகளைச் சரிபார்க்கும். ஏதாவதொரு தளம் உங்கள் கடவுச்சொல்லைத் திருட முயன்றாலோ தீங்குவிளைவிக்கும் ஃபைலை நீங்கள் பதிவிறக்கினாலோ Chromium, பாதுகாப்பு உலாவல் விழிப்பூட்டல்களில் பக்க உள்ளடக்கத்தின் சிறிய பகுதிகள் உட்பட URLகளையும் அனுப்பக்கூடும்.</translation>
<translation id="2356070529366658676">கேள்</translation>
<translation id="2359808026110333948">தொடர்க</translation>
<translation id="7000103009822967939">"<ph name="EXTENSION_NAME" />" நீட்டிப்பைப் பயன்படுத்த Optimiumமில் நீங்கள் உள்நுழைய வேண்டும்</translation>
<translation id="184381469736757112">ஆப்ஸிற்காக Optimium பின்புலத்தில் இயங்குவதை முடக்கு</translation>
<translation id="5141894774016157674"><ph name="USER_EMAIL_ADDRESS" /> என்ற கணக்கில் இந்த நீட்டிப்பைப் பயன்படுத்த Optimiumமில் உள்நுழையுங்கள்.</translation>
<translation id="2384373936468275798">உங்கள் கணக்கின் உள்நுழைவு விவரங்கள் காலாவதியாகிவிட்டதால் உங்கள் தரவை ChromiumOSஸால் ஒத்திசைக்க முடியவில்லை.</translation>
<translation id="2523694910556579068">{NUM_DEVICES,plural, =0{1 HID சாதனம் ஒன்று அல்லது அதற்கு மேற்பட்ட Optimium நீட்டிப்புகளால் அணுகப்பட்டது}=1{1 HID சாதனத்தை ஒன்று அல்லது அதற்கு மேற்பட்ட Optimium நீட்டிப்புகள் அணுகுகின்றன}other{# HID சாதனங்களை ஒன்று அல்லது அதற்கு மேற்பட்ட Optimium நீட்டிப்புகள் அணுகுகின்றன}}</translation>
<translation id="2899976927368522713">இந்தத் தளத்தை அணுக, Optimiumமிற்கு கேமரா மற்றும் மைக்ரோஃபோன் அணுகல் தேவை</translation>
<translation id="2403703063067034158">துவக்கப் பிழை: அமைவுச் செயல்முறை ஏற்கெனவே நடைபெறுகிறது, பிறகு முயலவும்.</translation>
<translation id="8530786035410512232">எந்த ஆப்ஸில் இருந்தும் Optimiumமில் இணைப்புகளைத் திறக்கலாம், உங்கள் செயல் பட்டியில் பிரவுசரை அணுகும் வகையில் வைத்திருக்கலாம்</translation>
<translation id="5645058843566501763">விரைவான தகவல் சுருக்கத்தைப் பெறவும் ஃபாலோ-அப் கேள்விகளைக் கேட்கவும் இந்த ஆவணத்தை Optimiumமில் Gemini உடன் பகிர, சுருக்க விவரம் பட்டனைக் கிளிக் செய்யவும்</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Chromiumமின் கருவிகள்<ph name="END_LINK" /> மூலம் பாதுகாப்பாக உலாவலாம், உங்கள் வசமே கட்டுப்பாட்டை வைத்திருக்கலாம்</translation>
<translation id="5384013849288198705"><ph name="EXISTING_USER" /> கணக்கில் ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Optimiumமில் <ph name="USER_EMAIL_ADDRESS" /> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். கடவுச்சொற்களையும், மேலும் பலவற்றையும் உங்களின் எல்லாச் சாதனங்களிலும் பெறுவீர்கள்.</translation>
<translation id="2451727308784734061">ஷார்ட்கட்டைப் பயன்படுத்தி Password Managerரை விரைவாகத் திறக்கலாம். கம்ப்யூட்டரின் முகப்புத் திரைக்கோ ஆப்ஸ் துவக்கிக்கோ ஷார்ட்கட்டை நகர்த்தலாம்.</translation>
<translation id="4074322039453189342">Optimium விரைவில் மூடப்படும்</translation>
<translation id="4239399282729309306">Optimium இல்</translation>
<translation id="2485422356828889247">நிறுவல் நீக்கு</translation>
<translation id="2513154137948333830">மறுதொடக்கம் செய்ய வேண்டும்: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2521391734665471391">Google Search AI மோடை மூடும்</translation>
<translation id="2542968102051442371">படத் தேடல் மூலம் வார்த்தையைத் தேர்ந்தெடுக்கலாம்</translation>
<translation id="7238239459452345825">ஏற்கெனவே இருக்கும் கடவுச்சொற்களை Optimium மாற்ற விரும்புகிறது. இதை அனுமதிக்க உங்கள் Windows கடவுச்சொல்லை டைப்செய்யவும்.</translation>
<translation id="5059411697679064446">ஃபைல்களைப் பதிவிறக்க, Optimiumக்குச் சேமிப்பிட அணுகல் தேவை</translation>
<translation id="5959299320608819381">Optimium உதவி</translation>
<translation id="2575822587468774919">படத் தேடல் மூலம் தேட வேண்டியதைத் தேர்ந்தெடுங்கள்</translation>
<translation id="8063772441784541423">கடவுச்சொற்கள் மற்றும் பலவற்றை உங்கள் சாதனங்கள் அனைத்திலும் பெற Optimiumமில் உள்நுழையுங்கள்</translation>
<translation id="3112793931795471365">Optimiumமைப் பதிவிறக்கி உங்கள் Google கணக்கில் உள்நுழைய, மொபைல் மூலம் QR குறியீட்டை ஸ்கேன் செய்யவும்.</translation>
<translation id="1584670114556742260">Optimiumமில் தேட.</translation>
<translation id="2680687985294820735">தொடர்ந்து Optimium பயன்படுத்துக</translation>
<translation id="259935314519650377">பதிவிறக்கப்பட்ட நிறுவியைத் தற்காலிக நினைவகத்தில் சேமிக்க முடியவில்லை. பிழை: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">அமைப்பு</translation>
<translation id="7753906894780562903">உங்கள் புக்மார்க்குகள், பதிவுகள், கடவுச்சொற்கள் போன்ற பிரவுசிங் தரவை உங்கள் நிறுவனத்தால் பார்க்கவும் நிர்வகிக்கவும் முடியும். பிற Optimium கணக்குகளில் உள்ள பிரவுசிங் தரவை நிறுவனத்தால் பார்க்க முடியாது.</translation>
<translation id="3912526786507084695">உங்கள் கணக்கில் (<ph name="ACCOUNT_EMAIL" />) உள்ள Optimium தரவைப் பயன்படுத்தவும் சேமிக்கவும் இது நீங்கள்தான் என்பதை உறுதிப்படுத்தவும்</translation>
<translation id="1723346026518998062">{COUNT,plural, =0{புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி மேம்பட்ட பாதுகாப்பு கேட்கிறது}=1{புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி மேம்பட்ட பாதுகாப்பு கேட்கிறது. மறைநிலைச் சாளரம் மீண்டும் திறக்கப்படாது.}other{புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி மேம்பட்ட பாதுகாப்பு கேட்கிறது. # மறைநிலைச் சாளரங்கள் மீண்டும் திறக்கப்படாது.}}</translation>
<translation id="1676939910504260523">Optimium ஐத் தொடங்கு</translation>
<translation id="4524556064279918264">நிறுவலின்போது இயக்க முறைமை பிழை ஏற்பட்டது. Optimiumமை மீண்டும் பதிவிறக்கம் செய்க.</translation>
<translation id="1998551382060432430">நீங்கள் சாதனத்தைப் பகிர்ந்தால், நண்பர்களும் குடும்பத்தினரும் தனிப்பட்ட முறையில் உலாவலாம், மேலும் Optimiumமை அவர்கள் விருப்பத்திற்கேற்ப அமைத்துக்கொள்ளலாம்</translation>
<translation id="5180414833025415316">Optimium சிறிதாக்கப்பட்டிருந்தாலும் கூட உங்கள் சாதனம் முழுவதும் Optimiumமில் Geminiயைச் எளிதாகப் பயன்படுத்தலாம்.</translation>
<translation id="5895170254499246640">Optimium தாவல்</translation>
<translation id="2718390899429598676">கூடுதல் பாதுகாப்பிற்கு, Chromium உங்கள் தரவை என்க்ரிப்ட் செய்யும்.</translation>
<translation id="6684098000857849465">உங்கள் Google கணக்கை Optimiumமில் இருந்து அகற்ற, வெளியேறவும்</translation>
<translation id="8035579362848370000">கடவுச்சொற்கள், புக்மார்க்குகள் மற்றும் பலவற்றை உங்களின் எல்லாச் சாதனங்களிலும் பெற Optimiumமில் உள்நுழையுங்கள்</translation>
<translation id="2738871930057338499">இணையத்துடன் இணைக்க முடியவில்லை. HTTP 403 தடுக்கப்பட்டது. உங்கள் ப்ராக்ஸி உள்ளமைவைச் சரிபார்க்கவும்.</translation>
<translation id="2753623023919742414">தேட கிளிக் செய்யவும்</translation>
<translation id="6013736131971103780">Optimiumமை இயல்பு PDF வியூவராக அமையுங்கள்</translation>
<translation id="218391145495840504">இந்த நீட்டிப்பில் மால்வேர் உள்ளது, மேலும் இது பாதுகாப்பற்றது. நீங்கள் பார்க்கும் தளங்கள் குறித்த தரவை (உங்கள் தனிப்பட்ட தகவலும் இதில் அடங்கும்) இந்த நீட்டிப்பு அணுகாமலும், மாற்றங்கள் செய்யாமலும் இருக்க இதை Optimiumமில் இருந்து அகற்றவும்.</translation>
<translation id="2799223571221894425">மீண்டும் தொடங்கு</translation>
<translation id="8757776333711121842">உங்கள் Optimium</translation>
<translation id="2816462166102338036">படத் தேடல் அம்சம் மூலம் இந்த வீடியோவைத் தேடுங்கள்</translation>
<translation id="5977650568712460613">iOSஸிற்கான Optimiumமில் கேமரா மூலம் தயாரிப்புகளைக் கண்டறியலாம், விலைச் சரிவுகளைக் கண்காணிக்கலாம் மற்றும் பலவற்றை எங்கிருந்தும் செய்யலாம்.</translation>
<translation id="2841525013647267359">இதிலிருந்து மொழிபெயர்</translation>
<translation id="2846251086934905009">நிறுவல் பிழை: நிறுவியின் செயல்பாடு நிறைவடையவில்லை. நிறுவல் ரத்துசெய்யப்பட்டது.</translation>
<translation id="7445294455857704594">Optimium இலிருந்து அகற்று...</translation>
<translation id="2850691299438350830">Chromiumமைப் பயன்படுத்தும்போது பாதுகாப்பளிப்பதோடு நீங்கள் பிற Google ஆப்ஸில் உள்நுழைந்திருக்கும்போதும் பாதுகாப்பை அதிகரிக்கும்</translation>
<translation id="2876152561415416331">Google Search பேனலை மீண்டும் திறக்கும்</translation>
<translation id="2885378588091291677">செயல் நிர்வாகி</translation>
<translation id="8130920144001221645">&amp;Optimium அறிமுகம்</translation>
<translation id="2915996080311180594">பின்னர் மீண்டும் தொடங்கு</translation>
<translation id="5422843128705358539">உங்கள் தரவு உங்கள் கடவுச்சொற்றொடர் மூலம் என்க்ரிப்ட் செய்யப்பட்டுள்ளது. உங்கள் Google கணக்கில் உள்ள Optimium தரவைப் பயன்படுத்தவும் சேமிக்கவும் அதை டைப் செய்யவும்.</translation>
<translation id="2945997411976714835">நிறுவல் பிழை: நிறுவியின் செயல்பாடு தொடங்கவில்லை.</translation>
<translation id="7644909281692978299">iOSஸிற்கான Optimiumமில் சேமித்துள்ள கடவுச்சொற்களைப் பயன்படுத்தி தளங்களில் விரைவாக உள்நுழையலாம்</translation>
<translation id="6715328262141930431">Optimiumமை உங்கள் நிறுவனம் நிர்வகிக்கிறது</translation>
<translation id="2977470724722393594">Chromium புதுப்பித்த நிலையில் உள்ளது</translation>
<translation id="2977506796191543575">எந்தத் தளமாவது உங்கள் கடவுச்சொல்லைத் திருட முயன்றாலோ தீங்கிழைக்கும் ஃபைலை நீங்கள் பதிவிறக்கினாலோ பக்க உள்ளடக்கத்தின் சிறிய பகுதிகள் உட்பட URLகளையும் பாதுகாப்பு உலாவலுக்கு Chromium அனுப்பக்கூடும்</translation>
<translation id="3373190939774209520">உங்கள் பெற்றோர் தேர்வுசெய்துள்ள அமைப்புகளுடன் ஆன்லைனில் பாதுகாப்பாக இருக்க, Optimiumமில் உள்நுழையுங்கள்</translation>
<translation id="2992577225802060159">உங்கள் கம்ப்யூட்டரில் உள்ள பிற ஆப்ஸிலிருந்து Chromiumமின் நினைவகத்தைப் பாதுகாக்கும்.</translation>
<translation id="3003694935412297923">எல்லாப் பணிகளும்</translation>
<translation id="2169110625780321257">{count,plural, =1{இது நீங்கள்தான் என்பதை Optimium உறுதிசெய்ய வேண்டும். அதன் பிறகே, சில தரவுகளை உங்கள் Google கணக்கில் சேமித்து அவற்றை உங்களின் எல்லாச் சாதனங்களிலும் பயன்படுத்த முடியும். நீங்கள் இப்போதே வெளியேறினால் இந்தத் தரவு (1 தரவு) நீக்கப்படும்.}other{இது நீங்கள்தான் என்பதை Optimium உறுதிசெய்ய வேண்டும். அதன் பிறகே, சில தரவுகளை உங்கள் Google கணக்கில் சேமித்து அவற்றை உங்களின் எல்லாச் சாதனங்களிலும் பயன்படுத்த முடியும். இப்போதே வெளியேறினால் இந்தத் தரவு ({count} தரவுகள்) நீக்கப்படும்.}}</translation>
<translation id="535155819036938485">Optimiumமில் புதிய பக்கத்தில் <ph name="URL" /> ஐத் திறக்கும்.</translation>
<translation id="302551344979399011">திறன்கள் போன்ற AI கண்டுபிடிப்புகள் உங்கள் Google கணக்கில் சேமிக்கப்பட்டு Chromium ஒத்திசைவில் இருந்து தனியாக நிர்வகிக்கப்படும்</translation>
<translation id="69529237724150463">உங்கள் நீட்டிப்புகளையும் மேலும் பலவற்றையும் உங்கள் எல்லாச் சாதனங்களிலும் பெற Optimiumமில் உள்நுழையுங்கள்</translation>
<translation id="1699367992046240140">Optimium இல் சேர்க்கிறது...</translation>
<translation id="3034219227076811559">Chromeமில் Google Search</translation>
<translation id="3037190258341683404">நீங்கள் பிரவுசிங் செய்யும்போதே கேள்விகளைக் கேட்க Chromeமில் Google Searchசைப் பின் செய்யலாம்</translation>
<translation id="3038232873781883849">நிறுவக் காத்திருக்கிறது...</translation>
<translation id="3045032126857188731">மொழிபெயர்க்கப்படும் மொழி: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">கருத்திற்கான பெட்டியை மூடும்</translation>
<translation id="7641708778616103377"><ph name="EXISTING_USER" /> ஆக ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Optimiumமில் <ph name="USER_EMAIL_ADDRESS" /> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். <ph name="DEVICE" /> கணக்கில் இருந்து உங்கள் வாசிப்புப் பட்டியலையும், மேலும் பலவற்றையும் பெறுவீர்கள்.</translation>
<translation id="1759532319192341458">பிற Optimium சுயவிவரங்கள்</translation>
<translation id="2862149341123916634">நீட்டிப்புகள் என்பவை Optimiumமைப் பிரத்தியேகமாக்க உதவும் செருகு நிரல்கள் ஆகும். ஒழுங்கமைப்பதில் இருந்து அன்றாடப் பணிகளை எளிதாக்குவது வரை, நீட்டிப்புகள் Optimiumமை உங்களுக்கேற்றதாக மாற்ற உதவுகின்றன.</translation>
<translation id="9144026989666254609">சிதைவு அறிக்கைகளையும் <ph name="UMA_LINK" /> உம் Google க்கு அனுப்புவதன் மூலம் Optimium ஐ மேலும் சிறப்பானதாக்க உதவவும்</translation>
<translation id="4449472527250709676">எங்கிருந்தும் Googleளின் பாதுகாப்பைப் பெற Optimium ஆப்ஸைப் பயன்படுத்தலாம்</translation>
<translation id="6183456495642882201">{NUM_DEVICES,plural, =0{1 USB சாதனம் ஒன்று அல்லது அதற்கு மேற்பட்ட Optimium நீட்டிப்புகளால் அணுகப்பட்டது}=1{1 USB சாதனத்தை ஒன்று அல்லது அதற்கு மேற்பட்ட Optimium நீட்டிப்புகள் அணுகுகின்றன}other{# USB சாதனங்களை ஒன்று அல்லது அதற்கு மேற்பட்ட Optimium நீட்டிப்புகள் அணுகுகின்றன}}</translation>
<translation id="7419486418212185022"><ph name="DEVICE" /> சாதனத்தில் இருந்து வாசிப்புப் பட்டியலையும் மேலும் பலவற்றையும் பெற Optimiumமில் உள்நுழையுங்கள்</translation>
<translation id="4481023367748355854">Optimium பதிவுகள்</translation>
<translation id="6289574887308484514">காப்பகத்தைச் சுருக்குவதில் நிறுவி தோல்வியடைந்தது. Optimiumமை மீண்டும் பதிவிறக்குக.</translation>
<translation id="310459126943037700">பணிகளை நிறுத்த முடியவில்லை.</translation>
<translation id="3104828284009500087">இந்தப் பக்கத்தில் எதையும் தேடுங்கள்</translation>
<translation id="1866751185142421235">கடவுச்சொற்கள், புக்மார்க்குகள், பதிவுகள் ஆகியவற்றை எல்லாச் சாதனங்களிலும் சரியாக ஒத்திசைத்த நிலையில் வைத்திருக்கலாம். Optimiumமை இயல்பு பிரவுசராக மாற்றுவதன் மூலம் உங்களுக்குத் தெரிந்த மற்றும் பிடித்த அம்சங்களை எளிதாக அணுகலாம்.</translation>
<translation id="7071720283847574213">Optimium உங்கள் மைக்ரோஃபோனைப் பயன்படுத்துகிறது.</translation>
<translation id="3130333203120345554">புதிய தேடல்</translation>
<translation id="3137969841538672700">தேட இழுக்கவும்</translation>
<translation id="8832375982733310873">இந்தப் பக்கம் கூடுதல் வளங்களைப் பயன்படுத்துகிறது. செயல்திறனை மேம்படுத்த, அதை முடக்குவதற்கு Optimiumமை அனுமதியுங்கள்.</translation>
<translation id="7212905776009358992">ஸ்கிரீனைப் பகிர, சிஸ்டம் அமைப்புகளில் Optimiumமிற்கு ஸ்கிரீன் ரெக்கார்டிங்கை அனுமதிக்கவும்</translation>
<translation id="7220401039380362840">Optimium ஐ மீண்டும் தொடங்கு</translation>
<translation id="3161522574479303604">எல்லா மொழிகளும்</translation>
<translation id="2945128209475147845">Optimium மறை&amp;நிலை சாளரத்தில் இணைப்பைத் திற</translation>
<translation id="5550841702580813851">புதிய Optimium சுயவிவரத்தைப் பிரத்தியேகமாக்குங்கள்</translation>
<translation id="6179644101029308447">பக்கங்களை மாற்றாமலே AI மோடில் தொடர்ந்து உரையாடலாம். தொடங்க, Optimiumமில் உள்நுழையுங்கள். அத்துடன், கடவுச்சொற்கள் மற்றும் பலவற்றை உங்களின் எல்லாச் சாதனங்களிலும் பெறுவீர்கள்.</translation>
<translation id="5843425624301789054">உங்கள் Google கணக்கை Optimiumமில் இருந்து அகற்ற, அமைப்புகள் பக்கத்தில் Optimiumமில் இருந்து வெளியேறவும்</translation>
<translation id="3234316605225071811">சேமித்துள்ள தகவல்களை வைத்து படிவங்களைத் தானாகவே நிரப்ப விரும்புகிறீர்களா என்று Chromium பின்னர் கேட்கலாம்</translation>
<translation id="3381027830404501211">தன்னுடைய தரவுக் கோப்பகத்தில் Optimium படிக்கவும் எழுதவும் செய்யாது:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="8146675538658659954">iOSஸிற்கான Optimiumமில் உங்களுக்குப் பிடித்த Google AI கருவிகளை எங்கிருந்தும் பயன்படுத்தலாம்.</translation>
<translation id="6800117212942659992"><ph name="DEVICE" /> சாதனத்தில் உள்ள உங்கள் நீட்டிப்புகளையும் மேலும் பலவற்றையும் பெற Optimiumமில் உள்நுழையுங்கள்</translation>
<translation id="1315108685137442441">{COUNT,plural, =1{Optimiumமின் புதிய புதுப்பிப்பு உள்ளது, மீண்டும் தொடங்கும்போது அது பயன்படுத்தப்படும். ஐசோலேட்டட் விண்டோ மீண்டும் திறக்கப்படாது.}other{Optimiumமின் புதிய புதுப்பிப்பு உள்ளது, மீண்டும் தொடங்கும்போது அது பயன்படுத்தப்படும். உங்கள் # ஐசோலேட்டட் விண்டோக்கள் மீண்டும் திறக்கப்படாது.}}</translation>
<translation id="3286538390144397061">இப்போது மறுதொடக்கம் செய்க</translation>
<translation id="2161039902967573767">Google API விசைகள் காணப்படவில்லை. Optimium இன் சில செயல்பாடுகள் முடக்கப்படும்.</translation>
<translation id="3296368748942286671">Chromium ஐ மூடியபிறகு, பின்புலப் பயன்பாடுகளைத் தொடர்ந்து இயக்கு</translation>
<translation id="3313189106987092621">பாதுகாப்பற்ற இணைப்பைப் பயன்படுத்தி ஒரு தளத்தை ஏற்றும் முன்னர் Chromium உங்களை எச்சரிக்கும்</translation>
<translation id="1282007042347821406">ஆனால், Optimium சாளரங்கள் அனைத்தையும் மூடும்போது Optimiumமில் உள்நுழைந்திருக்கும் உங்களின் Google கணக்கைத் தவிர பெரும்பாலான தளங்களில் இருந்து வெளியேற்றப்படுவீர்கள். தளங்கள் உங்களை நினைவில் வைத்துக்கொள்ள அனுமதிக்க, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">தேடல் பகுதியின் மேல் வலது மூலை: வலது <ph name="RIGHT" />%, மேல் <ph name="TOP" />%</translation>
<translation id="3366305173356742781">உங்கள் கணக்கில் உள்ள Chromium தரவு</translation>
<translation id="3798810966749973116">மொபைலில் Optimium மூலம் உங்கள் கடவுச்சொற்களைப் பயன்படுத்துங்கள்</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="3114385794555902051">ஏற்கெனவே உள்ள Optimium சுயவிவரத்திற்கு மாறவா?</translation>
<translation id="3412460710772753638">இந்தச் சாதனத்தில் உள்ள Password Managerரில்</translation>
<translation id="1395799713002454043"><ph name="DEVICE" /> சாதனத்தில் உள்ள புக்மார்க்குகளையும் மேலும் பலவற்றையும் பெற Optimiumமில் உள்நுழையுங்கள்</translation>
<translation id="3438772217992559640">படத் தேடல் மூலம் இந்தப் பக்கத்தைத் தேடுங்கள்</translation>
<translation id="1565712261560212491">உங்கள் மொபைலில் Optimium மூலம் மேம்பட்ட பாதுகாப்பான பிரவுசிங்கைப் பெறுங்கள்</translation>
<translation id="7003115800241574875">உங்களுக்கான Optimium தயாராகிறது...</translation>
<translation id="3474745554856756813">வெளியேறினால், இந்தச் சாதனத்திலிருந்து <ph name="ITEMS_COUNT" /> உருப்படிகள் நீக்கப்படும். பின்னர் தரவை மீட்டமைக்க, Chromium இல் <ph name="USER_EMAIL" /> எனும் முகவரியின் மூலம் உள்நுழையவும்.</translation>
<translation id="1749327805708308979"><ph name="SHORTCUT" /> விசைகளை அழுத்தி Optimium சுயவிவரங்களுக்கு இடையே மாறலாம்</translation>
<translation id="7437253251955408447">அனைத்து Optimium சாளரங்களையும் மூடி, பின்னர் முயலவும்.</translation>
<translation id="4544226979083343619">சாளரத்தைப் பகிர, சிஸ்டம் அமைப்புகளில் Optimiumமிற்கு ஸ்கிரீன் ரெக்கார்டிங்கை அனுமதிக்கவும்</translation>
<translation id="7742324910239513884"><ph name="EXISTING_USER" /> ஆக ஏற்கெனவே உள்நுழைந்துள்ளீர்கள்.  உங்கள் உலாவலைத் தனிப்பட்டதாக வைத்திருக்க, உங்கள் சுயவிவரத்தில் <ph name="USER_EMAIL_ADDRESS" /> என்ற மின்னஞ்சல் முகவரி மூலம் Optimiumமில் உள்நுழையவும்.</translation>
<translation id="8618656037793872415">மொபைல் சாதனங்களில் Optimium பிரவுசரைப் பதிவிறக்குவதற்கான QR குறியீடு</translation>
<translation id="354621070532799440">நினைவில்கொள்ளுங்கள்: Googleளின் சிறந்த பாதுகாப்பு அம்சங்கள் உங்கள் பாக்கெட்டில்</translation>
<translation id="3043015282185018117">ஸ்கிரீனைப் பகிர, சிஸ்டம் அமைப்புகளில் Optimiumமிற்கு ஸ்கிரீன் ரெக்கார்டிங்கை அனுமதிக்கவும்.</translation>
<translation id="3597003331831379823">கூடுதல் அணுகல்களுடன் அமைவை இயக்க முடியவில்லை. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3261842649996827269">Optimiumமில் உள்நுழையுங்கள்</translation>
<translation id="1140403329282632523">இவருடைய உலாவிய தரவு இந்தச் சாதனத்திலிருந்து நீக்கப்படும். தரவை மீட்டெடுக்க, Optimiumமில் <ph name="USER_EMAIL" /> ஆக உள்நுழையவும்.</translation>
<translation id="5228011645297638039">{COUNT,plural, =0{Optimiumமின் புதிய புதுப்பிப்பு உள்ளது, மீண்டும் தொடங்கும்போது அது பயன்படுத்தப்படும்.}=1{Optimiumமின் புதிய புதுப்பிப்பு உள்ளது, மீண்டும் தொடங்கும்போது அது பயன்படுத்தப்படும். உங்கள் மறைநிலை சாளரம் மீண்டும் திறக்காது.}other{Optimiumமின் புதிய புதுப்பிப்பு உள்ளது, மீண்டும் தொடங்கும்போது அது பயன்படுத்தப்படும். உங்கள் # மறைநிலை சாளரங்கள் மீண்டும் திறக்காது.}}</translation>
<translation id="3667616615096815454">நிறுவ முடியவில்லை, சேவையகத்திற்கு ஆப்ஸ் பற்றி தெரியவில்லை.</translation>
<translation id="3675854891107786059">எனது Google கணக்கில் உள்ள Chromium தரவு எல்லாவற்றையும் என்க்ரிப்ஷன் செய்ய <ph name="BEGIN_LINK" />எனது கடவுச்சொற்றொடரைப்<ph name="END_LINK" /> பயன்படுத்து. Google Payயில் உள்ள பேமெண்ட் முறைகளும் முகவரிகளும் என்க்ரிப்ட் செய்யப்படாது. Chromiumமில் உள்ள பிரவுசிங் பதிவுகள் ஒத்திசைக்கப்படாது.</translation>
<translation id="7861068783030138988">{COUNT,plural, =0{இந்தப் புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி பரிந்துரைக்கிறார்}=1{இந்தப் புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி பரிந்துரைக்கிறார். உங்கள் மறைநிலை சாளரம் மீண்டும் திறக்காது.}other{இந்தப் புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி பரிந்துரைக்கிறார். உங்கள் # மறைநிலை சாளரங்கள் மீண்டும் திறக்காது.}}</translation>
<translation id="8611928240945733486">புதிய Optimium &amp;தாவலில் இணைப்பைத் திற</translation>
<translation id="3728124580182886854">பிரத்தியேகமாக்குதல் மற்றும் பிற நோக்கங்களுக்காக Chromium உடன் பிற Google சேவைகளை இணைக்கலாம்</translation>
<translation id="3729187154190517324">"பக்கம் மற்றும் பலவற்றைச் சேர்" பட்டனைப் பயன்படுத்தி ஒன்றுக்கும் மேற்பட்ட பக்கங்கள், ஃபைல்கள், கருவிகள் ஆகியவற்றைச் சேர்ப்பதன் மூலம் உங்கள் தேடலை மேம்படுத்தலாம்.</translation>
<translation id="3032577647176321971">Optimium சுயவிவரங்களை நிர்வகியுங்கள்</translation>
<translation id="6314444399103340747">சில பதிவிறக்கங்களை Optimium ஏன் தடுக்கிறது என்பதைத் தெரிந்துகொள்ளுங்கள்</translation>
<translation id="379589255253486813">நீங்கள் ஏதேனும் நடவடிக்கை எடுக்க வேண்டியிருந்தால் அதுகுறித்து Chromium உங்களுக்குத் தெரியப்படுத்தும்</translation>
<translation id="3802055581630249637">நீங்கள் பார்வையிடக்கூடிய பக்கங்களை Chromium முன்கூட்டியே ஏற்றிவிடுவதால் அந்தப் பக்கங்கள் மிக விரைவாக ஏற்றப்படும்</translation>
<translation id="3810973564298564668">நிர்வகி</translation>
<translation id="4301680230606686279">சேமித்த கடவுச்சொற்களைப் பயன்படுத்த QR குறியீட்டை ஸ்கேன் செய்து, iOSஸிற்கான Optimiumமைப் பதிவிறக்கி உங்கள் Google கணக்கில் உள்நுழையவும்</translation>
<translation id="3846683726093018685">**சுருக்கு:** ஸ்கிரீன்ஷாட்டில் உள்ள உள்ளடக்கத்தின் முதன்மைப் பொருளையும் நோக்கத்தையும் 30 வார்த்தைகளுக்கு மிகாமல் ஒரே வாக்கியத்தில் விவரி.

          **கேள்விகளைப் பரிந்துரை:** ஸ்கிரீன்ஷாட்டை நன்றாகப் புரிந்துகொள்ள பயனர் கேட்கக்கூடிய, சிந்தனையைத் தூண்டும் 3 - 5 கேள்விகளைப் பொட்டுக்குறியிட்ட பட்டியலாக உருவாக்கு. இவற்றில் குறைந்தது ஒரு கேள்வி, காட்டப்படும் பொருள், அதன் வடிவமைப்பு அல்லது அது காட்டப்படும் இடத்தைப் பற்றி இருக்க வேண்டும்.</translation>
<translation id="3287167856630539345"><ph name="PAGE_TITLE" /> - Optimium</translation>
<translation id="3117512156333858342">புக்மார்க்குகள் மற்றும் பலவற்றை உங்கள் சாதனங்கள் எல்லாவற்றிலும் பெற Optimiumமில் உள்நுழையுங்கள்</translation>
<translation id="3511883131632987404">{COUNT,plural, =1{இந்தப் புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி கேட்கிறார். ஐசோலேட்டட் விண்டோ மீண்டும் திறக்கப்படாது.}other{இந்தப் புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி கேட்கிறார். உங்கள் # ஐசோலேட்டட் விண்டோக்கள் மீண்டும் திறக்கப்படாது.}}</translation>
<translation id="3885770153807205175">மொழி தேர்ந்தெடுப்பான்</translation>
<translation id="7294070483192043494">Optimiumமைத் தேவைக்கேற்ப மாற்றி கட்டுப்படுத்தும். சிலவற்றை நீங்கள் கவனிக்க வேண்டும் - விவரங்களுக்கு, கிளிக் செய்யவும்.</translation>
<translation id="7920927747111819647">Optimium ஐத் திறந்து, உலாவலைத் தொடங்க உங்கள் பெயரைக் கிளிக் செய்யவும்.</translation>
<translation id="3892148308691398805">உரையை நகலெடு</translation>
<translation id="4454986649289930182">இந்த Optimium சுயவிவரத்தில் ஏற்கெனவே <ph name="EXISTING_USER" /> உள்நுழைந்துள்ளார். நீங்கள் உலாவுவதைத் தனிப்பட்டதாக வைத்திருக்க உங்களுக்கு ஒரு புதிய சுயவிவரத்தை Optimium உருவாக்க முடியும்.</translation>
<translation id="7225128703667880746">Chrome ஆன்லைன் ஸ்டோர் கொள்கையை இந்த நீட்டிப்பு மீறுகிறது, மேலும் இது பாதுகாப்பற்றதாக இருக்கக்கூடும். நீங்கள் பார்க்கும் தளங்கள் குறித்த தரவை (உங்கள் தனிப்பட்ட தகவலும் இதில் அடங்கும்) இந்த நீட்டிப்பு அணுகாமலும், மாற்றங்கள் செய்யாமலும் இருக்க இதை Optimiumமில் இருந்து அகற்றவும்.</translation>
<translation id="3941890832296813527">நிறுவல் பிழை: நிறுவியின் ஃபைல் பெயர் தவறானது அல்லது ஆதரிக்கப்படவில்லை.</translation>
<translation id="6304622602441037994">Optimium கடவுச்சொற்களை நகலெடுக்க முயல்கிறது. இதை அனுமதிக்க உங்கள் Windows கடவுச்சொல்லை உள்ளிடவும்.</translation>
<translation id="2274695480528598968">சேமித்த தகவல்களையும் மேலும் பலவற்றையும் உங்கள் சாதனங்கள் எல்லாவற்றிலும் பெற Optimiumமில் உள்நுழையுங்கள்</translation>
<translation id="1713567483777335359">உங்கள் Google கணக்கில் சேமித்துள்ள கடவுச்சொற்கள், பேமெண்ட் முறைகள், முகவரிகள் ஆகியவை இந்தச் சாதனத்தில் இருந்து அகற்றப்படும். அவற்றை மீண்டும் Optimiumமில் பயன்படுத்த, மீண்டும் உள்நுழையவும்.</translation>
<translation id="395904275706073188">பாதுகாக்கப்பட்ட பக்கங்களை ரீட் செய்ய முடியாது. வேறு பக்கத்தை முயலவும்.</translation>
<translation id="3962647064319009959">Chromium எப்படி உங்களைப் பாதுகாப்பாக வைக்கிறது என்பது பற்றித் தெரிந்துகொள்ளுங்கள்</translation>
<translation id="3967822245660637423">பதிவிறக்கம் முடிந்தது</translation>
<translation id="3971865010372729242">முகவரிப் பட்டி அல்லது தேடல் பெட்டியில் நீங்கள் டைப் செய்யும்போது, பரிந்துரைகளைப் பெறுவதற்காக அவற்றை Chromium உங்கள் நிறுவனத்தின் தேடல், AI அல்லது ஏஜெண்ட் கருவிகளுக்கு அனுப்பும்.</translation>
<translation id="3975724895399328945">&amp;Google Chrome for Testing - ஓர் அறிமுகம்</translation>
<translation id="3984557288004650913">கருவிப்பட்டியில் உள்ள "Chromeமில் Google Search" பட்டன் மூலம், நீங்கள் பிரவுசிங் செய்யும்போதே கேள்விகளைக் கேட்க Chromeமில் Google Searchசை மீண்டும் திறக்கலாம்</translation>
<translation id="3997429360543082038">ChromiumOS - ஓர் அறிமுகம்</translation>
<translation id="4016217212818346953">Password Manager மூலம் பாதுகாப்பாக இருங்கள்</translation>
<translation id="4019629340646866719"><ph name="BEGIN_LINK_LINUX_OSS" />Linux டெவெலப்மெண்ட் சூழல்<ph name="END_LINK_LINUX_OSS" /> போலவே, கூடுதல் <ph name="BEGIN_LINK_CROS_OSS" />ஓப்பன் சோர்ஸ் மென்பொருள்<ph name="END_LINK_CROS_OSS" /> மூலம் ChromiumOS உருவாக்கப்பட்டுள்ளது.</translation>
<translation id="4022972681110646219">திரையை மொழிபெயர்</translation>
<translation id="4023601594785368013">அசல் மொழி: <ph name="LANGUAGE" /></translation>
<translation id="8098054594752731054">எந்த ஆப்ஸில் இருந்தும் Optimiumமில் இணைப்புகளைத் திறக்கலாம். அத்துடன், எளிதாக அணுகும் வகையில் செயல் பட்டியில் பிரவுசரைப் பின் செய்யலாம்.</translation>
<translation id="4036079820698952681"><ph name="BEGIN_LINK" />தற்போதைய அமைப்புகளைப்<ph name="END_LINK" /> பற்றிய அறிக்கையை அனுப்பி, Chromiumஐ இன்னும் சிறந்ததாக்க உதவவும்</translation>
<translation id="4050175100176540509">முக்கியப் பாதுகாப்பு மேம்பாடுகளும், புதிய அம்சங்களும் சமீபத்திய பதிப்பில் கிடைக்கின்றன.</translation>
<translation id="4055805654398742145">P&amp;assword Manager</translation>
<translation id="3150466418323356831">{COUNT,plural, =1{Optimium ஒரு நிமிடத்திற்குப் பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதைத் தானாக மூடிவிடும். உலாவிய தரவு நீக்கப்படும். இதில் பதிவு, தன்னிரப்பி, பதிவிறக்கங்கள் ஆகியவை அடங்கலாம்.}other{Optimium # நிமிடங்களுக்குப் பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதைத் தானாக மூடிவிடும். உலாவிய தரவு நீக்கப்படும். இதில் பதிவு, தன்னிரப்பி, பதிவிறக்கங்கள் ஆகியவை அடங்கலாம்.}}</translation>
<translation id="4118474109249235144">Chromium மறைநிலை</translation>
<translation id="4122186850977583290">Chromium அறிமுகம் என்ற பக்கத்திற்குச் செல்லும்</translation>
<translation id="5040058062446726786">உங்கள் பிரவுசருக்குப் புதிய தோற்றத்தைக் கொடுக்க Optimiumமைப் பிரத்தியேகமாக்குங்கள்</translation>
<translation id="3417230552019009112">Optimiumமைப் பிரத்தியேகமாக்கு</translation>
<translation id="4148957013307229264">நிறுவுகிறது...</translation>
<translation id="8036654966821129512">பாதுகாப்பாக இருக்க Optimiumமைப் புதுப்பியுங்கள்</translation>
<translation id="113287843321846936"><ph name="PAGE_TITLE" /> - நெட்வொர்க் உள்நுழைவு - Optimium</translation>
<translation id="101945827160630872"><ph name="EXISTING_USER" /> ஆக ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Optimiumமில் <ph name="USER_EMAIL_ADDRESS" /> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். வாசிப்புப் பட்டியலையும், மேலும் பலவற்றையும் உங்களின் எல்லாச் சாதனங்களிலும் பெறுவீர்கள்.</translation>
<translation id="5914158797921975103">Optimiumக்கான சிறந்த ஆப்ஸ், கேம்கள், நீட்டிப்புகள் மற்றும் தீம்களைக் கண்டறியவும்.</translation>
<translation id="7188357620681202939">உங்களின் எல்லாக் கம்ப்யூட்டர்களிலும் இந்த நீட்டிப்பையும், மேலும் பலவற்றையும் பெற Optimiumமில் உள்நுழையுங்கள்</translation>
<translation id="1889725122457669356">உங்கள் பெற்றோர் தேர்வுசெய்துள்ள அமைப்புகளுடன் ஆன்லைனில் பாதுகாப்பாக இருக்க, <ph name="USER_EMAIL_ADDRESS" /> என்ற கணக்கில் ஏற்கெனவே உள்நுழைந்துள்ள Optimium சுயவிவரத்திற்கு மாறுங்கள்</translation>
<translation id="4222932583846282852">ரத்துசெய்கிறது...</translation>
<translation id="4224210481850767180">நிறுவுதல் ரத்துசெய்யப்பட்டது.</translation>
<translation id="3467085712950617325">உங்கள் Optimium தரவை இந்தக் கணக்குடன் இணைக்கவா?</translation>
<translation id="4251772536351901305">இயல்பான பாதுகாப்பு நிலையில் செய்வதைவிட அதிகமான தரவைத் தளங்களில் இருந்து பகுப்பாய்வு செய்வதன் மூலம் ஆபத்தான தளங்கள் (Googleளுக்கு முன்பே தெரிந்திருக்காத தளங்கள் உட்பட) பற்றி உங்களை எச்சரிக்கும். Chromium வழங்கும் எச்சரிக்கைகளை நீங்கள் தவிர்க்கலாம்.</translation>
<translation id="2140865310399147834">Optimiumமில் இருந்து வெளியேறு</translation>
<translation id="4271805377592243930">Chromium தொடர்பான உதவி பெறுக</translation>
<translation id="4275788652681621337">பக்கவாட்டு பேனலை மூடு</translation>
<translation id="4281844954008187215">சேவை விதிமுறைகள்</translation>
<translation id="3179093133057739293">குறிப்பிடப்படாத பிழைக் காரணமாக நிறுவல் தோல்வியடைந்தது. Optimium தற்போது இயக்கத்தில் இருந்தால், அதை மூடி, பின்னர் முயலவும்.</translation>
<translation id="5932936993463393384">Optimiumமில் இருந்து கடவுச்சொற்களைப் பதிவிறக்குதல்</translation>
<translation id="4304713468139749426">கடவுச்சொல் நிர்வாகி</translation>
<translation id="4334241893986177674">இந்த ஸ்கிரீன்ஷாட்டைத் தேடும்</translation>
<translation id="109990079583792895">Windows தொடங்கும்போதே Optimiumமைத் தொடங்கு</translation>
<translation id="4400772909124543403">புதுப்பிப்புகள் எதுவுமில்லை</translation>
<translation id="4669117187454638908">Optimium இலிருந்து வெளியேறவா?</translation>
<translation id="4413205837991854510">படத் தேடலுக்கான ஷார்ட்கட்டை எப்போதும் காட்டு</translation>
<translation id="1696050014109987987">பின்னணியில் Optimiumஐ இயங்க அனுமதி</translation>
<translation id="7368827027253482667">{NUM_EXTENSIONS,plural, =1{இதை அகற்றும்படி Optimium பரிந்துரைக்கிறது. <ph name="BEGIN_LINK" />ஆதரிக்கப்படும் நீட்டிப்புகள் குறித்து மேலும் தெரிந்துகொள்ளுங்கள்.<ph name="END_LINK" />}other{இவற்றை அகற்றும்படி Optimium பரிந்துரைக்கிறது. <ph name="BEGIN_LINK" />ஆதரிக்கப்படும் நீட்டிப்புகள் குறித்து மேலும் தெரிந்துகொள்ளுங்கள்.<ph name="END_LINK" />}}</translation>
<translation id="6842479443769252421">Optimium ஐ தனிப்பயனாக்கி கட்டுப்படுத்துக</translation>
<translation id="4427306783828095590">ஃபிஷிங்கையும் மால்வேரையும் தடுக்க மேம்பட்ட பாதுகாப்பு உதவுகிறது</translation>
<translation id="4434353761996769206">நிறுவியில் பிழை: <ph name="INSTALLER_ERROR" /></translation>
<translation id="1220175535870261362">Optimiumமை <ph name="MANAGER" /> நிர்வகிக்கிறது</translation>
<translation id="4547231940814681999">Optimium சுயவிவரத்தைச் சேர்</translation>
<translation id="4447409407328223819">Chrome for Testing - ஓர் அறிமுகம்</translation>
<translation id="5633209319760692383">உங்கள் Google கணக்கில் Optimium தரவைப் பயன்படுத்துவதற்கும் சேமிப்பதற்கும், உங்கள் கடவுச்சொற்றொடரை டைப் செய்யவும்.</translation>
<translation id="4493028449971051158">துவக்கப் பிழை: நிர்வாகியாக நிறுவியை இயக்குங்கள்.</translation>
<translation id="4501471624619070934">இந்த நாட்டில் அணுகல் தடைசெய்யப்பட்டுள்ளதால் நிறுவ முடியவில்லை.</translation>
<translation id="4501839397124711198">நீங்கள் பிரவுஸ் செய்யும்போதே கேள்விகளைக் கேட்க, பக்கவாட்டு பேனலில் Google Searchசைப் பின் செய்து கொள்ளலாம்</translation>
<translation id="2800276662284246735">இந்த நீட்டிப்பு, தனியுரிமை நடைமுறைகளை (தரவை எப்படிச் சேகரித்துப் பயன்படுத்தும் போன்றவை) வெளியிடவில்லை. இதை அகற்றும்படி Optimium பரிந்துரைக்கிறது.</translation>
<translation id="5128821773878845255">Optimiumமிற்கு வரவேற்கிறோம்; புதிய உலாவிச் சாளரம் திறக்கப்பட்டது</translation>
<translation id="2317489323536472198">உங்களைச் சுற்றி இருப்பவற்றை மேப் செய்வதற்கும் உங்கள் கைகளை டிராக் செய்வதற்கும் Optimiumமிற்கு அனுமதி தேவை</translation>
<translation id="8080035720506683743">நீங்கள் மற்றொரு Optimium சுயவிவரத்தில் <ph name="USER_EMAIL_ADDRESS" /> கணக்கின் மூலம் ஏற்கெனவே உள்நுழைந்துள்ளீர்கள்</translation>
<translation id="4548534452171747496">விரைவாக பிரவுஸ் செய்வதற்கும் தேடுவதற்கும் உதவும் வகையில் பக்கங்களை முன்கூட்டியே Chromium ஏற்றுகிறது. <ph name="BEGIN_LINK" />பக்கங்களை முன்கூட்டியே ஏற்றுதல் குறித்து மேலும் தெரிந்துகொள்ளுங்கள்<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">தீங்கு விளைவிக்கும் என்று நீங்கள் நினைக்கும் தளத்தைப் புகாரளிப்பதன் மூலம் அனைவருக்கும் ஆன்லைன் பாதுகாப்பை மேம்படுத்தலாம்.</translation>
<translation id="8636960717768483692">நீங்கள் பாதுகாப்பு உலாவல் அமைப்பை முடக்கியிருப்பதன் காரணமாக ஃபைலைச் சரிபார்க்க முடியவில்லை என்பதால் இந்தப் பதிவிறக்கத்தை Optimium தடுத்துள்ளது</translation>
<translation id="1056620590372326996">உங்கள் மொபைலில் Optimium மூலம் Google Lens பயன்படுத்திப் பாருங்கள்</translation>
<translation id="4594305310729380060">இந்தச் சாதனத்தில் உள்ள Password Managerரில்</translation>
<translation id="1647545052658850323">Optimium ஆப்ஸ்</translation>
<translation id="4598116752460667024">பட்டியலில் உள்ள எந்தச் செயல்பாட்டையும் தேடும்.</translation>
<translation id="4613863813562375431">ChromiumOS பதிப்பு</translation>
<translation id="4621240073146040695">கிட்டத்தட்ட புதுப்பிக்கப்பட்டது! புதுப்பிப்பதை முடிக்க, Chromiumஐ மீண்டும் தொடங்கவும்.</translation>
<translation id="2905329563261343101">Optimiumமின் V8 என்ஜின் மூலம் தளங்கள் செயல்படும் வேகம் அதிகரிக்கும், ஆனால் தாக்குதல்களை Optimium தடுக்கும் திறனைச் சற்று குறைக்கும்</translation>
<translation id="3476739270743628464">Optimium மூலம் தேடலைத் திற</translation>
<translation id="8852417056873245680">Optimium சுயவிவரம்</translation>
<translation id="7306598352117034690">எச்சரிக்கை: நீங்கள் உலாவியவை குறித்த தகவல்களை நீட்டிப்புகள் பதிவுசெய்வதை Optimiumமால் தடுக்க முடியாது. மறைநிலைப் பயன்முறையில் இந்த நீட்டிப்பை முடக்க, இந்த விருப்பத்தைத் தேர்வுநீக்கவும்.</translation>
<translation id="4673151026126227699">Chromium உபயோக அறிக்கைகளை நீங்கள் பகிர்ந்தாலும் நீங்கள் பார்வையிட்ட URLகள் அவற்றில் இருக்கும்</translation>
<translation id="4673710618874938871">மெம்பர்ஷிப் உள்ள <ph name="USER_NAME" /> என்ற கணக்கில் உள்நுழைந்துள்ளீர்கள். கணக்கு மெனுவைத் திறக்கும்.</translation>
<translation id="8554460300897634995">இந்தக் கணக்கு மற்றொரு கம்ப்யூட்டரில் (<ph name="HOST_NAME" />) மற்றொரு Google Optimium செயல்முறையால் (<ph name="PROCESS_ID" />) பயன்படுத்தப்படுவதாகத் தோன்றுகிறது. Optimium இதைப் பூட்டியுள்ளதால், இது சிதைவடையாது. இதை மற்ற செயல்முறைகள் பயன்படுத்தவில்லை என்பதில் நீங்கள் உறுதியாக இருந்தால், நீங்கள் இதை அன்லாக் செய்து Optimiumமை மீண்டும் துவங்கலாம்.</translation>
<translation id="4680828127924988555">நிறுவலை ரத்து செய்</translation>
<translation id="3120454893225058851">உங்களின் சில Optimium தரவுகள் உங்கள் Google கணக்கில் இன்னமும் சேமிக்கப்படவில்லை. வெளியேறுவதற்கு முன் சில நிமிடங்கள் காத்திருக்கவும். இப்போதே வெளியேறினால் இந்தத் தரவு நீக்கப்படும்.</translation>
<translation id="382482205580353394">உள்நுழைந்திருக்கும்போது உங்கள் Google கணக்கில் உள்ள கடவுச்சொற்களையும், மேலும் பலவற்றையும் நீங்கள் Optimiumமில் பயன்படுத்தலாம். Google சேவைகளுக்கான அமைப்புகளை <ph name="SHORTCUT" /> மூலம் மாற்றலாம்.</translation>
<translation id="3042362992251330365">இதற்கு முன்னர் ஒருவர் இந்தக் கம்ப்யூட்டரிலுள்ள Optimiumமில் <ph name="ACCOUNT_EMAIL_LAST" /> எனும் முகவரியைப் பயன்படுத்தி உள்நுழைந்திருந்தார். உங்கள் தகவலைத் தனிப்பட்டதாக வைத்திருக்க, புதிய Optimium பயனரை உருவாக்கவும்.</translation>
<translation id="4724676981607797757">ஆதரிக்கப்படாத நெறிமுறைப் பிழை காரணமாக நிறுவ முடியவில்லை.</translation>
<translation id="1193287511990404405">Optimium இலிருந்து வெளியேறவா?</translation>
<translation id="8952177001318268390">Optimiumமுக்கான சிறப்புப் பாதுகாப்புப் புதுப்பிப்பு சற்றுமுன் இயக்கப்பட்டது. இப்போது Optimiumமை மீண்டும் தொடங்கவும், உங்கள் தாவல்களை மீண்டும் காண்பிப்போம்.</translation>
<translation id="4771701986670315895">இந்தத் தளத்தை நீங்கள் சமீபத்தில் பார்க்கவில்லை. <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> மேலும் <ph name="COUNT" /> அனுமதிகளை Chromium அகற்றிவிட்டது.</translation>
<translation id="2836181158089477791">Optimiumமில் Gemini திறந்திருந்தால், புதிய பக்கங்களை உருவாக்கும்போது பக்கவாட்டு பேனல் திறந்தே இருக்கும்</translation>
<translation id="479167709087336770">இது Google தேடலில் பயன்படுத்தப்படும் அதே பிழைதிருத்தியைப் பயன்படுத்துகிறது. உலாவியில் நீங்கள் உள்ளிடும் உரை Googleளுக்கு அனுப்பப்படும். இதை அமைப்புகளில் எப்போது வேண்டுமானாலும் மாற்றலாம்.</translation>
<translation id="4803313124144656665">Chromeமில் Google Searchசை மூடும்</translation>
<translation id="1328138522631482119">கணக்கு இல்லாமல் Optimiumமைப் பயன்படுத்து</translation>
<translation id="4839733921943823254">ஷார்ட்கட்டைப் பின் செய்</translation>
<translation id="3892081057957249936">mDNS ட்ராஃபிக்கை அனுமதிப்பதற்கான, Optimium க்கான உள்வரும் விதி.</translation>
<translation id="7651599052663598373">&amp;Optimiumமைப் புதுப்பிக்க மீண்டும் தொடங்கு</translation>
<translation id="4918086044614829423">ஏற்கிறேன்</translation>
<translation id="4918844574251943176">படம் நகலெடுக்கப்பட்டது</translation>
<translation id="5410814264258278350">வாசிப்புப் பட்டியலையும் மேலும் பலவற்றையும் உங்கள் எல்லாச் சாதனங்களிலும் பெற Optimiumமில் உள்நுழையுங்கள்</translation>
<translation id="6875307114047320453">Optimium பின்புல பயன்முறையில் இயங்குகிறது.</translation>
<translation id="2394968926407196930">Optimium உள்நுழைவு உரையாடலை மூட இதைக் கிளிக் செய்யவும்</translation>
<translation id="1768466544858725503">Optimium சுயவிவரங்களைப் பயன்படுத்தி உங்கள் Optimium தொடர்பான எல்லாவற்றையும் தனித்தனியாக வைத்துக்கொள்ளலாம். நண்பர்களுக்காகவும் குடும்பத்திற்காகவும் சுயவிவரங்களை உருவாக்கலாம் அல்லது பணி, பொழுதுபோக்கு போன்றவற்றுக்கு அவற்றைத் தனித்தனியாக வைத்துக்கொள்ளலாம்.</translation>
<translation id="7886648924703056279">எதையும் விட்டுசெல்லாமல் கெஸ்ட் பயனர்கள் Optimium ஐப் பயன்படுத்தலாம்.</translation>
<translation id="5471135073467145273">Optimiumமில் உங்கள் கணக்கு</translation>
<translation id="6876331590693993673">உங்களை Optimium இல் சேர்க்கவும்</translation>
<translation id="5000497292978544380">Google Search AI மோட்</translation>
<translation id="504699503110800016">விரிவாக்க மெனுவைத் திறக்கவும்</translation>
<translation id="4438081792500757652"><ph name="DEVICE_TYPE" /> இல் Optimium மூலம் உங்களுக்குப் பிடித்த Google சேவைகள் அனைத்தையும் அணுகலாம்</translation>
<translation id="5121592697493894155">பக்கவாட்டு பேனலில் Google Search</translation>
<translation id="2242644352859741625">உங்கள் கைகளை டிராக் செய்ய Optimiumமிற்கு அனுமதி தேவை</translation>
<translation id="5141988424377517949">இந்தத் தளத்தை நீங்கள் சமீபத்தில் பார்க்கவில்லை. <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" /> ஆகிய அனுமதிகளை Chromium அகற்றிவிட்டது.</translation>
<translation id="988933134885096200">Optimiumமில் உள்நுழைக</translation>
<translation id="5174969993834422967">பொதுவாக அறிவிப்புகளைத் தடுத்து விடுவீர்கள். இந்தத் தளம் உங்களுக்கு அறிவிப்புகளை வழங்க அனுமதிக்க, இடப் பட்டியின் வலது மூலையில் உள்ள அறிவிப்பு ஐகானைக் கிளிக் செய்யவும்.</translation>
<translation id="5174983315706567306">டிஸ்க்கில் போதுமான சேமிப்பிடம் இல்லை.</translation>
<translation id="2338237693885714148">Optimium கணக்கிற்கு மறு அடையாளச் சரிபார்ப்பு தேவைப்படுகிறது</translation>
<translation id="8218029216260099398">iOSஸிற்கான Optimiumமில் விட்ட இடத்திலிருந்து தொடரலாம்.</translation>
<translation id="4186833996539770035">Optimium இலிருந்து வெளியேறு</translation>
<translation id="5234764350956374838">நிராகரி</translation>
<translation id="5247617065091903691">நீங்கள் பிரவுசிங் செய்யும்போதே கேள்விகளைக் கேட்க, Google Search பக்கவாட்டு பேனலைப் பின் செய்யலாம்</translation>
<translation id="3776453825988272921">Optimium மறைநிலைச் சாளரத்தில் இணைப்பைத் திற</translation>
<translation id="3535566975491534106">எங்கிருந்தும் கடவுச்சொற்களைச் சேமிக்க Optimium ஆப்ஸைப் பெறுங்கள்</translation>
<translation id="5277894862589591112">உங்கள் மாற்றங்களைச் செயல்படுத்த, Chromiumமை மீண்டும் தொடங்கவும்</translation>
<translation id="5286907366254680517">கண்டறியப்பட்டது</translation>
<translation id="2359384056551683792">Optimium ஆப்ஸைப் பெறுங்கள்</translation>
<translation id="5294316920224716406">மறைநிலைப் பயன்முறையில் உலாவும்போது, பாதுகாப்பற்ற இணைப்பைப் பயன்படுத்தி ஒரு தளத்தை ஏற்றும் முன் Chromium உங்களை எச்சரிக்கும்</translation>
<translation id="8192058236932307019">Optimiumமில் Search</translation>
<translation id="2772169547056202535">Optimium Updater Internal Service</translation>
<translation id="5324450571874973775">Chromiumமில் பிற Gemini அம்சங்களுடன் அவற்றைப் பயன்படுத்தலாம்</translation>
<translation id="5346389065299425353">பல பக்கங்கள், ஃபைல்கள், கருவிகள் ஆகியவற்றைச் சேர்ப்பதன் மூலம் உங்கள் தேடலை மேம்படுத்தலாம்</translation>
<translation id="6360850825826447093">Optimiumமில் Gemini மூலம் இந்த ஆவணத்தின் விரைவான தகவல் சுருக்கத்தைப் பெறலாம், கேள்விகளைக் கேட்கலாம்.</translation>
<translation id="5352264705793813212">நீங்கள் நடவடிக்கை எடுக்க சில பாதுகாப்பு தொடர்பான பரிந்துரைகளை Chromium கண்டறிந்துள்ளது</translation>
<translation id="4898448032020512094">பிற Optimium சுயவிவரங்கள்</translation>
<translation id="8706179446833404063">உங்கள் கணக்கின் உள்நுழைவு விவரங்கள் காலாவதியாகிவிட்டதால் உங்கள் Google கணக்கில் Optimium தரவை ChromiumOS சேமிக்க முடியவில்லை</translation>
<translation id="3030627244449672752">நீங்கள் நிர்வகிக்கப்படும் கணக்கு மூலம் உள்நுழைகிறீர்கள், மேலும் அதன் நிர்வாகிக்கு உங்கள் Optimium சுயவிவரத்தின் கட்டுப்பாட்டை வழங்குகிறீர்கள். உங்கள் ஆப்ஸ், புக்மார்க்குகள், வரலாறு, கடவுச்சொற்கள் போன்ற உங்கள் Optimium தரவு மற்றும் பிற அமைப்புகள் நிரந்தரமாக <ph name="USER_NAME" /> உடன் இணைக்கப்படும். இந்தத் தரவை Google கணக்குகளின் டாஷ்போர்டு வழியாக நீக்க முடியும், ஆனால் இந்தத் தரவை வேறொரு கணக்குடன் தொடர்புபடுத்த முடியாது. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">கூடுதல் குறியீடு: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">பிரத்தியேகமாக்குதலைப் பெற, இணையம் மற்றும் ஆப்ஸ் செயல்பாட்டில் Chromiumமைச் சேர்க்கவும்</translation>
<translation id="2465610960000663223">Optimium மூலம் தேடலைத் திற</translation>
<translation id="506107225183374450">சில ஃபைல்களை Optimium ஏன் தடுக்கிறது என்பதைத் தெரிந்துகொள்ளுங்கள்</translation>
<translation id="5386450000063123300">Chromiumஐப் புதுப்பிக்கிறது (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="2975872091911905625"><ph name="EXISTING_USER" /> ஆக ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Optimiumமில் <ph name="USER_EMAIL_ADDRESS" /> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். உங்கள் நீட்டிப்புகளையும், மேலும் பலவற்றையும் உங்களின் எல்லாச் சாதனங்களிலும் பெறுவீர்கள்.</translation>
<translation id="538767207339317086">Chromium உள்நுழைவை அனுமதித்தல்</translation>
<translation id="160420445803701171">Optimium இலிருந்து அகற்று</translation>
<translation id="7179459260935505033">செயல்திறனைக் குறைக்கும், ஆனால் தாக்குதல்களை Optimium தடுக்கும் திறனை அதிகரிக்கும்</translation>
<translation id="9146479251717041603">உங்கள் இயல்புநிலை உலாவியாக Optimium ஐ அமை</translation>
<translation id="6343924787023513328"><ph name="PAGE_TITLE" /> - Optimium பீட்டா</translation>
<translation id="4322885651709311384">{NUM_TABS,plural, =1{உங்கள் பிரவுசர் செயல்படும் வேகத்தைக் குறைக்கும் பக்கத்தை இடைநிறுத்தும்படி Optimium பரிந்துரைக்கிறது}other{உங்கள் பிரவுசர் செயல்படும் வேகத்தைக் குறைக்கும் பக்கங்களை இடைநிறுத்தும்படி Optimium பரிந்துரைக்கிறது}}</translation>
<translation id="8732742361460659941">இந்த Linux விநியோகத்தில் Optimium தற்போது ஆதரிக்கப்படுவதில்லை என்பதால் அது சரியாகச் செயல்படாமல் போகலாம்</translation>
<translation id="2169134804545654825">உங்களின் தனிப்பட்ட மற்றும் சமூக வலைத்தளக் கணக்குகளில் இந்த ஃபைல் பாதிப்பை ஏற்படுத்தலாம் என்பதால் இந்தப் பதிவிறக்கத்தை Optimium தடுத்துள்ளது</translation>
<translation id="5482575505313585759">Google Search பேனலை மூடும்</translation>
<translation id="4427110150482038520">சமீபத்திய முறைமை புதுப்பிப்புகளை Optimium நிறுவும் வரை காத்திருக்கவும்.</translation>
<translation id="2009107314274994399">Optimium கடவுச்சொற்களைத் திருத்த முயல்கிறது. இதை அனுமதிக்க உங்கள் Windows கடவுச்சொல்லை உள்ளிடவும்.</translation>
<translation id="7654616829447718524">Optimium மூலம் Google Drive, YouTube போன்ற உங்களுக்குப் பிடித்த ஆப்ஸை எங்கிருந்தும் தடையின்றிப் பயன்படுத்தலாம்.</translation>
<translation id="5524890928877629608">தேடல் பகுதியின் மேல் இடது மூலை: இடது <ph name="LEFT" />%, மேல் <ph name="TOP" />%</translation>
<translation id="5527463683072221100">PDFகளை Chromiumமில் திற</translation>
<translation id="5536164441519929134">இந்தப்<ph name="LINE_BREAK" />பக்கம் பற்றிக் கேட்கலாம்</translation>
<translation id="2024205307959964945">பாதுகாப்பிற்காக, நீங்கள் ஒரு தளத்தை முதன்முறையாகப் பார்வையிடும்போது JavaScript மேம்பாட்டை Optimium ஆஃப் செய்யும்.

எதிர்பார்த்தபடி இந்தப் பக்கம் செயல்படவில்லை என்றால், மேம்பாட்டை ஆன் செய்துப் பார்க்கவும்.</translation>
<translation id="13426881482333028">Mac மெனு பட்டியில் Optimiumமில் Geminiயைக் காட்டி, கீபோர்டு ஷார்ட்கட்டை ஆன் செய்</translation>
<translation id="6574158167225592561"><ph name="EXISTING_USER" /> கணக்கில் ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Optimiumமில் <ph name="USER_EMAIL_ADDRESS" /> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். <ph name="DEVICE" /> இருந்து நீங்கள் சேமித்த தகவல்களையும், மேலும் பலவற்றையும் பெறுவீர்கள்.</translation>
<translation id="5579324208890605088">துவக்கப் பிழை: நிர்வாகியாக இல்லாமல் வழக்கமான பயனராக நிறுவியை இயக்குங்கள்.</translation>
<translation id="4236944092022229829">Optimiumமை இயல்பு பிரவுசராகப் பயன்படுத்துங்கள், அதைப் பின் செய்யுங்கள்</translation>
<translation id="4562525634100475413">{COUNT,plural, =1{புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி கேட்கிறார். ஐசோலேட்டட் விண்டோ மீண்டும் திறக்கப்படாது.}other{புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி கேட்கிறார். உங்கள் # ஐசோலேட்டட் விண்டோக்கள் மீண்டும் திறக்கப்படாது.}}</translation>
<translation id="5596627076506792578">கூடுதல் விருப்பங்கள்</translation>
<translation id="5605834417512968703">படத் தேடல் மூலம் தேட எதையேனும் தேர்ந்தெடுக்கலாம் அல்லது படத் தேடலில் இருந்து வெளியேற escape பட்டனை அழுத்தலாம்</translation>
<translation id="7026300828382155386"><ph name="IMPORTANT_UPDATE" /> தயாராக உள்ளது. நீங்கள் இப்போதே மீண்டும் தொடங்கலாம் அல்லது அடுத்த முறை உங்கள் திரை ஆன் செய்யப்பட்டு <ph name="IDLE_DURATION" /> வரை பயன்படுத்தப்படாமல் இருக்கும்போது புதுப்பிக்கும்படி Optimiumமை அமைக்கலாம்.</translation>
<translation id="5618818588972826921">படத் தேடல் அம்சத்தின் மூலம் தேட வார்த்தைகளையோ படத்தையோ தேர்ந்தெடுக்கவும் அல்லது படத் தேடல் அம்சத்தில் இருந்து வெளியேற Escape அழுத்தவும்</translation>
<translation id="8498149662316870172">{0,plural, =0{Optimiumமிற்கான புதுப்பிப்பு உள்ளது}=1{Optimiumமிற்கான புதுப்பிப்பு உள்ளது}other{Optimiumமிற்கான புதுப்பிப்பு வந்து # நாட்களாகிறது}}</translation>
<translation id="5643865575100044307">Chromium உலாவியை மூடும்போது எனது சாதனத்தில் உள்ள தளத் தரவை எப்போதும் நீக்கு</translation>
<translation id="4811952957940410849">Optimiumமை இப்போது மீண்டும் தொடங்கவும்</translation>
<translation id="8019243097022864687">இனிவரும் Optimium புதுப்பிப்புகளைப் பெற, Windows 10 பதிப்பு 1809 அல்லது அதற்குப் பிந்தைய பதிப்புகள் தேவை. இந்தக் கம்ப்யூட்டர் Windows 10ன் பழைய பதிப்பைப் பயன்படுத்துகிறது.</translation>
<translation id="568656514202614970">முடிந்தது! நீங்கள் பிரவுசிங் செய்யும்போதே Google Search பக்கவாட்டு பேனல் மூலம் எளிதாகக் கேள்விகளைக் கேட்கலாம்</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">Chromiumமை இந்த மொழியில் காட்டு</translation>
<translation id="569897634095159764">இணையத்துடன் இணைக்க முடியவில்லை. ப்ராக்ஸி சர்வருக்கு அங்கீகரிப்பு தேவை.</translation>
<translation id="5768371961535086509">செயலில் இல்லாத பக்கங்களில் உள்ள நினைவகத்தை Chromium காலியாக்குகிறது. இதன்மூலம் செயலில் உள்ள பக்கங்களுக்கும் பிற ஆப்ஸுக்கும் கம்ப்யூட்டரின் செயல்திறன் அதிகமாகக் கிடைப்பதுடன் Chromiumமும் வேகமாக இயங்கும். செயலில் இல்லாத பக்கங்களுக்கு நீங்கள் செல்லும்போது அவை தானாக மீண்டும் செயல்படத் தொடங்கும். <ph name="BEGIN_LINK" />நினைவகச் சேமிப்பான் குறித்து மேலும் தெரிந்துகொள்ளுங்கள்<ph name="END_LINK" /></translation>
<translation id="7953122114569280985">கடவுச்சொற்றொடரை மறந்துவிட்டாலோ இந்த அமைப்பை மாற்ற விரும்பினாலோ, உங்கள் கணக்கில் உள்ள Optimium தரவை <ph name="SETTINGS_LINK" /></translation>
<translation id="174898372403396774">Optimiumமைப் பிரத்தியேகமாக்கலாம் கட்டுப்படுத்தலாம். Optimiumமை இயல்பு உலாவியாக அமைக்கலாம்.</translation>
<translation id="7513745843649038539">Optimiumமை இயல்பு பிரவுசராக அமைப்பதன் மூலம் கடவுச்சொற்கள், புக்மார்க்குகள், பதிவுகள் ஆகியவற்றை எல்லாச் சாதனங்களிலும் சரியாக ஒத்திசைத்த நிலையில் வைத்திருக்கலாம்.</translation>
<translation id="5809516625706423866">இணையத்துடன் இணைக்க முடியவில்லை. HTTP 401 அங்கீகரிக்கப்படவில்லை. உங்கள் ப்ராக்ஸி உள்ளமைவைச் சரிபார்க்கவும்.</translation>
<translation id="579643040945073674">Optimiumமின் V8 என்ஜின் மூலம் தளங்கள் செயல்படும் வேகம் அதிகரிக்கும், ஆனால் தாக்குதல்களை Optimium எதிர்க்கும் திறன் சற்று குறைந்து காணப்படும். இந்த அமைப்பு ஆஃப் செய்யப்பட்டுள்ளது.</translation>
<translation id="4979951833951359193">உங்கள் Google கணக்கில் உள்ள Optimium தரவைப் பயன்படுத்தவும் சேமிக்கவும் Optimium பிரவுசரைப் புதுப்பிக்கவும்</translation>
<translation id="5824893331272123205">இந்தப் பேனலை ஏற்ற முடியவில்லை, மீண்டும் முயலவும்</translation>
<translation id="7677335892217820153">Optimium க்கு வரவேற்கிறோம்</translation>
<translation id="5871205389137001634">படத் தேடலில் இருந்து வெளியேற கிளிக் செய்யுங்கள்</translation>
<translation id="3069954563229169503">இவற்றில் மால்வேர் இருப்பதை Optimium கண்டறிந்துள்ளது:</translation>
<translation id="5889361821821684993">உங்கள் உலாவியில் பாதுகாப்பான அமைப்புகள் அமைக்கப்பட்டுள்ளனவா என்று அவ்வப்போது Chromium சரிபார்க்கும். நீங்கள் எதையேனும் சரிபார்க்க வேண்டியிருந்தால் உங்களுக்குத் தெரியப்படுத்துவோம்.</translation>
<translation id="5895138241574237353">மறுதொடக்கம்</translation>
<translation id="8498138353382813879">Optimiumமில் Gemini Enterprise</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - நெட்வொர்க் உள்நுழைவு</translation>
<translation id="5924017743176219022">இணையத்துடன் இணைக்கிறது...</translation>
<translation id="5941711191222866238">சிறிதாக்கு</translation>
<translation id="7780105764415426863">இந்தப் புக்மார்க்கையும் மேலும் பலவற்றையும் உங்கள் சாதனங்கள் எல்லாவற்றிலும் பெற Optimiumமில் உள்நுழையுங்கள்</translation>
<translation id="3113857336144207971">Optimiumமை உங்களுக்கானதாக மாற்றுங்கள்</translation>
<translation id="5960071705175224773">அறியப்படாத ஆப்ஸ் உங்கள் அமைப்புகளை மாற்றியுள்ளது</translation>
<translation id="2841415208664905665">{COUNT,plural, =1{Optimium ஒரு நிமிடத்திற்குப் பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதைத் தானாக மூடிவிடும்.}other{Optimium # நிமிடங்களுக்குப் பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதைத் தானாக மூடிவிடும்.}}</translation>
<translation id="6753703218327532561">ஒத்திசைவைத் தொடங்க, Optimiumஐப் புதுப்பிக்கவும்</translation>
<translation id="5990360079535151574">கருவிப்பட்டியில் உள்ள "சூழல் சார்ந்த பணிகள்" பட்டனில் இருந்து, பிரவுசிங் செய்யும்போதே கேள்விகளைக் கேட்க சூழல் சார்ந்த பணிகளை மீண்டும் திறக்கலாம்</translation>
<translation id="6003112304606738118">பதிவிறக்குகிறது... <ph name="HOURS" /> மணிநேரம் மீதமுள்ளது</translation>
<translation id="6009821354356307391">ஃபாலோ-அப் கேளுங்கள்</translation>
<translation id="6040143037577758943">மூடு</translation>
<translation id="4546936953038997559">உங்கள் <ph name="DEVICE_TYPE" /> இல் Optimium ஆப்ஸைப் பயன்படுத்தும்போது ஆன்லைன் ஷாப்பிங்கில் இருந்து அதிகப் பலன்களைப் பெறுங்கள்</translation>
<translation id="6058380562449900225">உங்கள் தரவைப் பாதுகாக்க, நீங்கள் சமீபத்தில் பார்வையிடாத தளங்களில் உள்ள அனுமதிகளை அகற்ற Chromiumமை அனுமதியுங்கள். இது அறிவிப்புகளை நிறுத்தாது.</translation>
<translation id="9167712407654403538">Optimium இல் &amp;திற</translation>
<translation id="6069027071882229820">படமாக நகலெடு</translation>
<translation id="2336867934702997612"><ph name="EXTENSION_NAME" /> என்ற நீட்டிப்பு Optimium இல் சேர்க்கப்பட்டது</translation>
<translation id="4963754686639647216">Optimiumஐத் தனிப்பயனாக்கி, கட்டுப்படுத்தலாம். புதுப்பிப்பு உள்ளது.</translation>
<translation id="3238331535068195595">இயக்கு • இந்த நீட்டிப்பு எங்கிருந்து பெறப்பட்டது என்பதை Optimiumமால் சரிபார்க்க முடியவில்லை</translation>
<translation id="1591882001986563343">Optimiumமில் உங்கள் கணக்கு</translation>
<translation id="9174470061972211626">Optimium கருவிப்பட்டியில் அணுகல் கோரிக்கைகளைக் காட்ட நீட்டிப்புகளை அனுமதி</translation>
<translation id="6285996195476638282"><ph name="FILE_NAME" /> ஆபத்தானது என்பதால் Optimium அதைத் தடுத்துள்ளது.</translation>
<translation id="2722851476153659127">Optimium விரைவில் மூடப்படுவதுடன் தரவும் நீக்கப்படும்</translation>
<translation id="6855625092121599072">இங்கே Optimium சுயவிவரங்களுக்கு இடையே மாறலாம்</translation>
<translation id="615103374448673771">குக்கீகளை அனுமதித்தால் பக்கங்களை முன்கூட்டியே ஏற்றுவதற்கு Chromium அவற்றைப் பயன்படுத்தக்கூடும்</translation>
<translation id="6165508094623778733">மேலும் அறிக</translation>
<translation id="440816316079905155">உங்கள் கணக்கில் உள்ள Optimium தரவை அழிக்கலாம்</translation>
<translation id="8018999409456045233">இந்த ஃபைல் ஆபத்தானதாக இருக்கக்கூடும்<ph name="LINE_BREAK" />நீங்கள் கடவுச்சொல்லை வழங்கினால் Optimium உங்களுக்காக இந்தப் பதிவிறக்கத்தைச் சரிபார்க்கும். Google பாதுகாப்பு உலாவலுக்கு ஃபைல் குறித்த தகவல்கள் அனுப்பப்படும், ஆனால் ஃபைலின் உள்ளடக்கமும் கடவுச்சொல்லும் பகிரப்படாமல் சாதனத்திலேயே இருக்கும்.</translation>
<translation id="6182736845697986886">புதுப்பிப்புச் சேவையகத்தின் அகப் பிழை காரணமாக நிறுவ முடியவில்லை.</translation>
<translation id="3469021117852380318">உங்கள் <ph name="TARGET_DEVICE_NAME" /> சாதனத்தின் மூலம் Optimiumமில் உள்நுழைந்திருப்பதை உறுதிசெய்துகொண்டு மீண்டும் அனுப்ப முயலவும்.</translation>
<translation id="2986761964667678689">Optimium சிறிதாக்கப்பட்டிருந்தாலும் கூட எங்கிருந்தும் தேடலாம், கேள்விகளைக் கேட்கலாம். பின்னணியில் Optimium இயங்க அனுமதிக்கும்.</translation>
<translation id="1244028666242035366">இந்தக் கம்ப்யூட்டரில் ஏற்கனவே Optimiumமின் மிகச் சமீபத்திய பதிப்பு உள்ளது. மென்பொருள் இயங்கவில்லை எனில் Optimiumமை நிறுவல் நீக்கி, பின்னர் முயலவும்.</translation>
<translation id="6513480350636703580">{0,plural, =0{இப்போது Optimium மீண்டும் தொடங்கும்}=1{ஒரு வினாடியில் Optimium மீண்டும் தொடங்கும்}other{# வினாடிகளில் Optimium மீண்டும் தொடங்கும்}}</translation>
<translation id="3859762680410498178">திரையைப் பயன்படுத்தாதபோது Optimium புதுப்பிக்கப்படும்</translation>
<translation id="18853993527252772">ஃபைல்களைப் பதிவிறக்க, Optimiumமிற்குச் சேமிப்பக அணுகல் தேவை</translation>
<translation id="6245734527075554892">Chromiumமில் சேமிக்கப்பட்டுள்ள பாதுகாப்பில்லாத தளங்களின் பட்டியலைப் பயன்படுத்தி URLகளைச் சரிபார்க்கும்</translation>
<translation id="571621467627269416">Optimium ஐ இயல்புநிலை உலாவியாக மாற்று</translation>
<translation id="6248988683584659830">தேடல் அமைப்புகள்</translation>
<translation id="4260906300317983841">உங்கள் மொபைலில் Optimium ஆப்ஸ் மூலம் Googleளின் சிறந்த பாதுகாப்பு அம்சங்களை எங்கிருந்தும் பெறுங்கள்</translation>
<translation id="6919871734111021049">Optimium இலிருந்து வெளியேறவா?</translation>
<translation id="8269500201917700071">இந்தப் பக்கங்கள் கூடுதல் ரிசோர்ஸ்களைப் பயன்படுத்துகின்றன. செயல்திறனை மேம்படுத்த, அவற்றை முடக்குவதற்கு Optimiumமை அனுமதியுங்கள்.</translation>
<translation id="2906910751900335741">உங்கள் Optimium சுயவிவரத்தைப் பிரத்தியேகமாக்குக</translation>
<translation id="6290827346642914212">உங்கள் Chromium சுயவிவரத்திற்குப் பெயரிடுங்கள்</translation>
<translation id="6294638840436017818">கருவிப்பட்டியில் உள்ள "Google Search பக்கவாட்டு பேனல்" பட்டன் மூலம், நீங்கள் பிரவுசிங் செய்யும்போதே கேள்விகளைக் கேட்க Google Search பக்கவாட்டு பேனலை மீண்டும் திறக்கலாம்</translation>
<translation id="6612045300479871672">நீட்டிப்பைப் பயன்படுத்த Optimiumமில் நீங்கள் உள்நுழைய வேண்டும் என்று அது விரும்புகிறது</translation>
<translation id="2723016125417495514"><ph name="FILE_NAME" /> ஆபத்தானதாக இருக்கலாம் என்பதால் Optimium அதைத் தடுத்துள்ளது.</translation>
<translation id="6308106880471005841">கருவிப்பட்டியில் உள்ள "Google Search பேனல்" பட்டன் புதிய ஐகானைப் பெற்றுள்ளது. நீங்கள் பிரவுசிங் செய்யும்போதே ‘Google Search பேனல்’ மூலம் கேள்விகளைக் கேட்க, அதைக் கிளிக் செய்யுங்கள்.</translation>
<translation id="6151952148243982653">Optimium உங்கள் கேமராவைப் பயன்படுத்துகிறது.</translation>
<translation id="7744220780291650493">Optimium இல் ஏற்கனவே ஒரு நிறுவி செயல்பாட்டில் உள்ளது. பிறகு முயலவும்.</translation>
<translation id="4212271170228408978">இப்போது உங்கள் Google கணக்குடனும், பகிரப்பட்ட கம்ப்யூட்டர்களிலும் Optimiumமைப் பயன்படுத்துவது எளிதானது.</translation>
<translation id="7560359899505953564">Optimiumமை இயல்பு பிரவுசராக அமைப்பதன் மூலம் உங்களுக்குத் தெரிந்த, பிடித்த மற்றும் நம்பகமான அம்சங்களை எளிதாக அணுகலாம்.</translation>
<translation id="9090225774559341003">Optimium ஷார்ட்கட்</translation>
<translation id="6926580396655648750">இந்த ஃபைல் பொதுவாகப் பதிவிறக்கப்படுவதில்லை என்பதுடன் ஆபத்தானதாகவும் இருக்கலாம் என்பதால் இந்தப் பதிவிறக்கத்தை Optimium தடுத்துள்ளது</translation>
<translation id="8406846117825568223">Optimium ஐ நிச்சயமாக நிறுவல் நீக்கவா?</translation>
<translation id="6375219077595103062">Password Managerருக்கு ஷார்ட்கட்டைச் சேர்க்கலாம்</translation>
<translation id="6388799252195623474">இதில் எனக்கு உதவு</translation>
<translation id="9091694200019721003">தொடர, <ph name="EMAIL" /> என்ற கணக்கில் Optimiumமில் உள்நுழையவும். உங்கள் நிறுவனத்தின் கொள்கைகள் இந்த பிரவுசருக்கு அமைக்கப்பட்டிருப்பதை இது உறுதிசெய்யும்.</translation>
<translation id="3942952894185574182">கம்ப்யூட்டர் ஸ்கிரீன் உள்ளே Optimium உலாவி லோகோ.</translation>
<translation id="3353682461772532321">Optimium ஆனது வலைப்பக்கங்கள் மற்றும் ஆப்ஸில் குறைவான வேகத்துடன் இயங்கும் வலை உலாவியாகும். இது விரைவானது, நிலையானது மற்றும் பயன்படுத்துவதற்கு எளிமையானது. Optimiumமில் உருவாக்கப்பட்ட மால்வேர் மற்றும் ஃபிஷிங் பாதுகாப்பு மூலம் வலையை மிகவும் பாதுகாப்பாக உலாவலாம்.</translation>
<translation id="6791461984478543248">உங்கள் Google கணக்கில் உள்ள Optimium தரவை எப்போதும் பயன்படுத்தவும் சேமிக்கவும் முடிவதை உறுதிசெய்ய, இது நீங்கள்தான் என்பதை உறுதிப்படுத்தவும்.</translation>
<translation id="6174985388495951106">Optimium வேகமாக இயங்கும், அத்துடன் JavaScriptடைப் பயன்படுத்தும் அம்சங்கள் வடிவமைக்கப்பட்டுள்ளபடி செயல்படும்</translation>
<translation id="6436260184216827876">படத் தேடல் கிடைக்கவில்லை. பிறகு முயலவும்.</translation>
<translation id="6442900851116057561">ChromiumOSஸை மீண்டும் தொடங்குங்கள்</translation>
<translation id="6443470774889161065">நீங்கள் பார்வையிடக்கூடிய கூடுதல் பக்கங்களை Chromium முன்கூட்டியே ஏற்றிவிடுவதால் அந்தப் பக்கங்கள் மிக விரைவாக ஏற்றப்படும்</translation>
<translation id="2102210363398612557">விலைகளைக் கண்காணிக்கவும் ஏதேனும் தளத்தில் விலை குறைந்தால் அதுகுறித்த விழிப்பூட்டல்களைப் பெறவும் உங்கள் மொபைலில் Optimiumமைப் பதிவிறக்குங்கள்</translation>
<translation id="6598227122144472874">முடக்கு • இந்த நீட்டிப்பு எங்கிருந்து பெறப்பட்டது என்பதை Optimiumமால் சரிபார்க்க முடியவில்லை</translation>
<translation id="3895850825918446737">Optimium சுயவிவரங்களுக்கு வரவேற்கிறோம்</translation>
<translation id="3239105679122868308">அடுத்த முறை உங்கள் <ph name="DEVICE_TYPE" /> சாதனத்தில் Optimiumமைத் திறக்கும்போது, பக்கக் குழுக்களைப் பயன்படுத்தும்படி ஓர் அறிவிப்பு காட்டப்படும்.</translation>
<translation id="5440394152628202500">Optimiumமில் இருந்து கணக்கை அகற்று</translation>
<translation id="5673289019038024720">Optimium ஐத் தொடங்கும்போது காண்பிக்கப்படும் பக்கத்தையும் இது கட்டுப்படுத்துகிறது.</translation>
<translation id="648319183876919572">ஆபத்தான இணையதளங்கள், பதிவிறக்கங்களில் இருந்து உங்களைப் பாதுகாக்க மேம்பட்ட பாதுகாப்பு உலாவல் அம்சம் பலவற்றைச் செய்கிறது</translation>
<translation id="3922692586556595624">Optimium ஐ நிறுவல் நீக்கு</translation>
<translation id="5977471146123132488">ஷார்ட்கட்கள் Optimiumமில் திறக்கும்</translation>
<translation id="1873460655129342919">Optimium <ph name="TIMEOUT_DURATION" /> பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதை மூடிவிடும். உலாவிய தரவு நீக்கப்பட்டது. இதில் பதிவு, தன்னிரப்பி, பதிவிறக்கங்கள் ஆகியவை அடங்கலாம்.</translation>
<translation id="139284349466910875">புக்மார்க்குகள், இதுவரையான செயல்பாடுகள், கடவுச்சொற்கள் போன்ற Optimium தகவல்கள் ஒவ்வொரு சுயவிவரத்திற்கும் தனித்தனியாக இருக்கும்</translation>
<translation id="6556755379298048869">கீபோர்டு ஷார்ட்கட் மூலம் தேடலாம்.</translation>
<translation id="6563921047760808519"><ph name="BEGIN_LINK" />Chromium உங்கள் தரவை எப்படித் தனிப்பட்டதாக வைத்திருக்கிறது<ph name="END_LINK" /> என்பது குறித்து மேலும் தெரிந்துகொள்ளுங்கள்</translation>
<translation id="562266251854740285">இந்த அமைப்பில் செய்யப்படும் மாற்றங்கள் Optimium மீண்டும் தொடங்கியதும் செயல்படுத்தப்படும்.</translation>
<translation id="965740992595240282">Optimium முதன்மை மெனுவில் உள்ள நீட்டிப்புகள் என்பதைக் கிளிக் செய்து நீட்டிப்புகளை நிர்வகிக்கலாம்.</translation>
<translation id="2549448919385330625">வேறொரு Optimium சுயவிவரத்தில் உள்ள கடவுச்சொற்களைப் பார்க்க அதற்கு மாறலாம்</translation>
<translation id="2662027419736610653">சிறந்த AI கருவிகளை எங்கிருந்தும் அணுக Optimium ஆப்ஸைப் பயன்படுத்தலாம்</translation>
<translation id="6570579332384693436">எழுத்துப் பிழைகளைச் சரிசெய்ய, Chromium நீங்கள் உரைப் புலங்களில் உள்ளிடும் உரைகளை Googleளுக்கு அனுப்பும்</translation>
<translation id="8346408025829878332">Optimium அறிவிப்பு அமைப்புகளுக்குச் செல்</translation>
<translation id="6600016381025017075">இந்தப் பக்கத்தில் எதையும் தேடலாம்</translation>
<translation id="5149981246269331326">அடுத்த முறை நீங்கள் Optimium ஐ மீண்டும் தொடங்கும்போது உங்கள் மாற்றங்கள் செயல்படும்.</translation>
<translation id="1163143914216098175">Windows தொடங்கும்போதே Optimium இப்போது தொடங்கப்படுவதால் நீங்கள் உடனடியாக பிரவுசிங் செய்யத் தொடங்கலாம். இதை நீங்கள் அமைப்புகளில் ஆஃப் செய்யலாம்.</translation>
<translation id="7839895033810030903">விட்ட இடத்திலிருந்து தொடரலாம்: கடந்த அமர்வில் இருந்து Optimium உங்கள் பக்கங்களை மீட்டெடுத்துள்ளது. இதை இங்கு ஆஃப் செய்யலாம்:</translation>
<translation id="8919724422686713691">உங்களைச் சுற்றியுள்ள இடங்களின் 3D வரைபடத்தை உருவாக்க, Optimiumமிற்குக் கேமரா அணுகல் தேவை</translation>
<translation id="6669284030132180248">உங்கள் Google கணக்கில் புக்மார்க்குகளையும் நீங்கள் சேமித்தால், Chromiumமில் தயாரிப்பு விலைகளைக் கண்காணிக்கலாம், விலை குறையும்போது அதற்கான அறிவிப்புகளைப் பெறலாம்</translation>
<translation id="6676384891291319759">இணையத்தை அணுகுதல்</translation>
<translation id="668175097507315160">உள்நுழைவில் பிழை ஏற்பட்டதால் உங்கள் தரவை ChromiumOSஸால் ஒத்திசைக்க முடியவில்லை.</translation>
<translation id="2337492685922399200">Optimiumமில் இருந்து இந்த ஆப்ஸின் தரவை அகற்று</translation>
<translation id="7200198227335381561">இந்தத் தளத்தை அணுக, Optimiumமிற்கு மைக்ரோஃபோன் அணுகல் தேவை</translation>
<translation id="6712881677154121168">பதிவிறக்கப் பிழை: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="358599119501177356">உங்கள் சுயவிவரம் Optimium இன் புதிய பதிப்பில் உள்ளதால், அதைப் பயன்படுத்த முடியாது.

சில அம்சங்கள் கிடைக்காமல் போகலாம். வேறு சுயவிவர கோப்பகத்தைக் குறிப்பிடுக அல்லது Optimium இன் புதிய பதிப்பைப் பயன்படுத்துக.</translation>
<translation id="6729124504294600478">பிரத்தியேகமாக்குதலையும் பிற அம்சங்களையும் பெற, இணையம் மற்றும் ஆப்ஸ் செயல்பாடு மற்றும் இணைக்கப்பட்ட Google சேவைகளில் Chromiumமைச் சேர்க்கவும்</translation>
<translation id="196085196242095682">உங்கள் கம்ப்யூட்டரில் ஏற்கனவே எல்லாப் பயனர்களுக்கும் Optimium நிறுவப்பட்டுள்ளது.</translation>
<translation id="8573534493546068455">புக்மார்க்குகள் மற்றும் பலவற்றை உங்கள் சாதனங்கள் எல்லாவற்றிலும் பெற Optimiumமில் உள்நுழையுங்கள். நீங்கள் உள்நுழைந்த பிறகு உங்கள் Google கணக்கில் இந்த புக்மார்க் சேமிக்கப்படும்.</translation>
<translation id="674891594898436429">இந்தப் பக்கத்தில் செயல்பாட்டுத் தேடலை மூடும்</translation>
<translation id="87486021868820245">Optimiumமின் V8 என்ஜின் மூலம் தளங்கள் செயல்படும் வேகம் அதிகரிக்கும், ஆனால் தாக்குதல்களை Optimium எதிர்க்கும் திறன் சற்று குறைந்து காணப்படும். இந்த அமைப்பு ஆன் செய்யப்பட்டுள்ளது.</translation>
<translation id="474617559993879524">{count,plural, =1{உங்கள் Optimium தரவுகளில் சில உங்கள் Google கணக்கில் இன்னமும் சேமிக்கப்படவில்லை. வெளியேறும் முன் சில நிமிடங்கள் காத்திருக்கவும். நீங்கள் இப்போதே வெளியேறினால் இந்தத் தரவு (1 தரவு) நீக்கப்படும்.}other{உங்கள் Optimium தரவுகளில் சில உங்கள் Google கணக்கில் இன்னமும் சேமிக்கப்படவில்லை. வெளியேறும் முன் சில நிமிடங்கள் காத்திருக்கவும். இப்போதே வெளியேறினால் இந்தத் தரவு ({count} தரவுகள்) நீக்கப்படும்.}}</translation>
<translation id="1681402107856523620">இந்த ஃபைல் ஆபத்தானதாக இருக்கக்கூடும் என்பதால் இதை ஸ்கேன் செய்யுமாறு Optimium பரிந்துரைக்கிறது.</translation>
<translation id="6779406956731413166">கூடுதல் <ph name="BEGIN_LINK_CROS_OSS" />ஓப்பன் சோர்ஸ் மென்பொருள்<ph name="END_LINK_CROS_OSS" /> மூலம் ChromiumOS உருவாக்கப்பட்டுள்ளது.</translation>
<translation id="6804256634866838775">செயல்பாட்டுத் தேடலை மூடும்</translation>
<translation id="6831043979455480757">Translate</translation>
<translation id="2199057756312069531">கடவுச்சொற்கள் பாதுகாப்பை இழக்கும்பட்சத்தில் அவற்றை Optimium உங்களுக்குத் தெரியப்படுத்தும்</translation>
<translation id="684888714667046800">இணையத்துடன் இணைக்க முடியவில்லை. ஃபயர்வாலைப் பயன்படுத்தினால் ஃபைல் ஏற்புப் பட்டியலில் <ph name="PRODUCT_EXE_NAME" /> இருப்பதை உறுதிசெய்துகொள்ளவும்.</translation>
<translation id="6664374380152979637">Optimium - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">தொடர தட்டவும்</translation>
<translation id="6862030660799253820">படத் தேடல் அம்சம் மூலம் இந்தப் படத்தைத் தேடுங்கள்</translation>
<translation id="6869568587896659271">முகவரிப் பட்டிக்குக் கீழே உள்ள இணையதளங்களை எளிதாக அணுகலாம்</translation>
<translation id="4548192511713002443">"<ph name="EXTENSION_NAME" />" நீட்டிப்பில் மால்வேர் இருப்பதை Optimium கண்டறிந்துள்ளது</translation>
<translation id="6877155553248388166">தேடல் பகுதியின் கீழ் வலது மூலை: வலது <ph name="RIGHT" />%, கீழ் <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">நகலெடு</translation>
<translation id="6898028264630240901">பிரவுசிங் செய்யும்போது எளிதாகக் கேள்விகளைக் கேட்க சூழல் சார்ந்த பணிகளைப் பின் செய்யலாம்</translation>
<translation id="3594007018780395447">Optimiumமை இயல்பு பிரவுசராக அமைத்து செயல் பட்டியில் பின் செய்யுங்கள்</translation>
<translation id="8874878391047306490">&amp;Optimium சுயவிவரங்களை நிர்வகியுங்கள்</translation>
<translation id="8227361644719983591">இதனால்:
          <ph name="LINE_BREAKS" />
            • உங்கள் துவக்கப் பக்கம், புதிய பிரவுசர் பக்கம், தேடல் இன்ஜின், இடம் மாறாத பக்கங்கள் ஆகியவை மீட்டமைக்கப்படும்
            <ph name="LINE_BREAK" />
            • நீட்டிப்புகள் முடக்கப்படும்
            <ph name="LINE_BREAK" />
            • குக்கீகளும் பிற தற்காலிகத் தளத் தரவும் நீக்கப்படும்
            <ph name="LINE_BREAK" />
            • Optimium ஷார்ட்கட்கள் மீட்டமைக்கப்படும்
            <ph name="LINE_BREAKS" />
            புக்மார்க்குகள், பதிவுகள், சேமிக்கப்பட்ட கடவுச்சொற்கள் ஆகியவை பாதிக்கப்படாது.</translation>
<translation id="6926772305569367352">கருவிப்பட்டியில் உள்ள "Chromeமில் Google Search" பட்டன் புதிய ஐகானைப் பெற்றுள்ளது. நீங்கள் பிரவுசிங் செய்யும்போதே ‘Chromeமில் Google Search’ மூலம் கேள்விகளைக் கேட்க, அதைக் கிளிக் செய்யுங்கள்.</translation>
<translation id="7079691767892495301">Optimiumமின் <ph name="BOOKMARK_LIMIT" /> புக்மார்க்குகள் என்ற வரம்பை அடைந்துவிட்டதால், உங்களின் சில புக்மார்க்குகள் இன்னும் உங்கள் Google கணக்கில் சேமிக்கப்படவில்லை.

சில புக்மார்க்குகளை நீக்கும் வரை உங்கள் கணக்கில் புதிய புக்மார்க்குகளைச் சேமிக்க முடியாது. இப்போது வெளியேறினால், சேமிக்கப்படாத புக்மார்க்குகள் நீக்கப்படும்.</translation>
<translation id="8488478146459741524">Optimium மறை&amp;நிலை சாளரத்தில் இணைப்பைத் திற</translation>
<translation id="6965382102122355670">சரி</translation>
<translation id="6985329841647292029">ChromiumOS விதிமுறைகள்</translation>
<translation id="8559464220428426642">உங்கள் கணக்கில் (<ph name="ACCOUNT_EMAIL" />) உள்ள Optimium தரவைப் பயன்படுத்தவும் சேமிக்கவும் உங்கள் கடவுச்சொற்றொடரை வழங்கவும்</translation>
<translation id="7011190694940573312">ஆப்ரேட்டிங் சிஸ்டத்தின் இந்தப் பதிப்பு ஆதரிக்கப்படாததால் நிறுவ முடியவில்லை.</translation>
<translation id="7024536598735240744">தொகுக்கப்படாத பிழை: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7941779569092758272">{COUNT,plural, =1{புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி மேம்பட்ட பாதுகாப்பு கேட்கிறது. ஐசோலேட்டட் விண்டோ மீண்டும் திறக்கப்படாது.}other{புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி மேம்பட்ட பாதுகாப்பு கேட்கிறது. உங்கள் # ஐசோலேட்டட் விண்டோக்கள் மீண்டும் திறக்கப்படாது.}}</translation>
<translation id="5367778139372857256">Optimiumமைப் பிரத்தியேகமாக்குங்கள்</translation>
<translation id="7047386856539490735">இந்த முடிவுகள் பயனுள்ளவையாக உள்ளனவா?</translation>
<translation id="6654931874608808546">Optimiumஐப் புதுப்பி</translation>
<translation id="1078205929937913964">ஒரு படத்திற்குப் பயனுள்ள விளக்கம் இல்லாதபட்சத்தில் Optimium உங்களுக்காக அதை வழங்க முயலும். விளக்கங்களை உருவாக்குவதற்காக படங்கள் Googleளுக்கு அனுப்பப்படும்.</translation>
<translation id="8657336023716174215">உங்கள் <ph name="DEVICE_TYPE" /> இல் Optimium ஆப்ஸைப் பயன்படுத்தும்போது AI ஆற்றலைப் பெறுங்கள்</translation>
<translation id="8360922610978196377">மொபைலில் Optimium ஆப்ஸ் மூலம் கடவுச்சொற்கள், பக்கங்கள் மற்றும் பலவற்றை எங்கிருந்தும் அணுகுங்கள்</translation>
<translation id="7141270731789036260">Chrome for Testing உலாவியைப் பிரத்தியேகமாக்கு</translation>
<translation id="7147227333672430807">மெசேஜ்கள், ஆவணங்கள் மற்றும் பிற ஆப்ஸில் உள்ள இணைப்புகளைக் கிளிக் செய்யும்போதெல்லாம் Chromiumமைப் பயன்படுத்தலாம்</translation>
<translation id="7635847276859447848"><ph name="EXTENSION_NAME" /> நீட்டிப்பை Optimiumமில் இருந்து அகற்றும்</translation>
<translation id="4634249408802713112">Optimium தரவு <ph name="TIMEOUT_DURATION" /> பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதை நீக்கிவிடும். இதில் பதிவு, தன்னிரப்பி, பதிவிறக்கங்கள் ஆகியவை அடங்கலாம்.</translation>
<translation id="3308314751977712481">இந்தத் தளத்தை அணுக, Optimiumமிற்கு கேமரா அணுகல் தேவை</translation>
<translation id="1700107811881467396">Optimiumஐத் தொடங்க முடியவில்லை. மீண்டும் முயலவும்.</translation>
<translation id="615859695332174696">Optimiumமில் Gemini மூலம் எங்கிருந்தும் எதை வேண்டுமானாலும் கேளுங்கள்</translation>
<translation id="4082322885657154457">எந்த நேரத்திலும் Optimiumமிற்கு விரைவாகச் செல்ல அதை Dockகில் வைத்திருக்கவும்</translation>
<translation id="5886985791575399945">மெசேஜ்கள், ஆவணங்கள், பிற ஆப்ஸ் ஆகியவற்றில் உள்ள இணைப்புகளைக் கிளிக் செய்யும்போதெல்லாம் Optimium உலாவியைப் பயன்படுத்தலாம்</translation>
<translation id="7213435258745128111">Chromiumமில் Google Search</translation>
<translation id="7216228761061470870">டெஸ்க்டாப்பில் படத் தேடலைப் பயன்படுத்தும்போது பக்கத் தலைப்பு, URL, PDFகள் உள்ளிட்ட உள்ளடக்கம் ஆகியவை சேவையகத்திற்கு அனுப்பப்படும்</translation>
<translation id="3899250150715276784">செயல் நிர்வாகி - Optimium</translation>
<translation id="357779301278973973">பிற ஆப்ஸ், ஃபைல்கள் போன்ற Optimiumமில் இல்லாத உள்ளடக்கத்தைப் பற்றிக் கேட்கலாம்</translation>
<translation id="2192941957286691074"><ph name="EXISTING_USER" /> கணக்கில் ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Optimiumமில் <ph name="USER_EMAIL_ADDRESS" /> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். நீங்கள் சேமித்த தகவல்களையும், மேலும் பலவற்றையும் உங்களின் எல்லாச் சாதனங்களிலும் பெறுவீர்கள்.</translation>
<translation id="4695009148423764441">உடனடியாக பிரவுசிங் செய்யத் தொடங்குங்கள்: Windows தொடங்கும்போதே Optimiumமை இப்போது தொடங்கலாம்.</translation>
<translation id="7274695763216404502">பின் செய்யப்பட்டது! கருவிப்பட்டியில் இருந்து படத் தேடலை மீண்டும் பயன்படுத்தலாம்</translation>
<translation id="7288567540154601580">பக்கங்களும் நீட்டிப்புகளும்</translation>
<translation id="7290997427370476749">கருவிப்பட்டியில் உள்ள "Google Search பேனல்" பட்டன் மூலம், நீங்கள் பிரவுசிங் செய்யும்போதே கேள்விகளைக் கேட்க Google Search பேனலை மீண்டும் திறக்கலாம்</translation>
<translation id="1079602886106438527">{NUM_EXTENSIONS,plural, =1{இதை அகற்றும்படி Optimium பரிந்துரைக்கிறது}other{இவற்றை அகற்றும்படி Optimium பரிந்துரைக்கிறது}}</translation>
<translation id="5279936464959604532">சிஸ்டம் ஆடியோவைப் பகிர, சிஸ்டம் அமைப்புகளைத் திறந்து Optimiumமிற்கு 'சிஸ்டம் ஆடியோ ரெக்கார்டிங் மட்டும்' என்பதை அனுமதியுங்கள். Optimiumமை மீண்டும் தொடங்க வேண்டும்.</translation>
<translation id="7299899569525778554">டெஸ்க்டாப்பில் இருந்து தேடு</translation>
<translation id="731795002583552498">Chromiumஐப் புதுப்பிக்கிறது</translation>
<translation id="1032861344046520617">உங்கள் விருப்பத்தேர்வுகளின் ஃபைல் சிதைவடைந்துள்ளது அல்லது தவறானது.

உங்கள் அமைப்புகளை Optimium ஆல் மீட்டெடுக்க முடியவில்லை.</translation>
<translation id="7324051657739063017">பிரவுசிங் செய்யும்போதே கேள்விகளைக் கேட்க சூழல் சார்ந்த பணிகளை மீண்டும் திறக்கலாம்</translation>
<translation id="265884122223707624">உங்களின் இணையம், புக்மார்க்குகள் மற்றும் பிற Optimium உருப்படிகள் இங்கே உள்ளன.</translation>
<translation id="7347827960336370838">உங்கள் கடவுச்சொற்றொடரை வைத்திருப்பவர்கள் மட்டுமே என்க்ரிப்ட் செய்யப்பட்ட உங்கள் தரவைப் படிக்க முடியும். கடவுச்சொற்றொடர் Googleளுக்கு அனுப்பப்படாது, அதை Google சேமிக்காது. கடவுச்சொற்றொடரை மறந்துவிட்டாலோ இந்த அமைப்பை மாற்ற விரும்பினாலோ <ph name="BEGIN_LINK" />உங்கள் கணக்கில் உள்ள Chromium தரவை நீக்க<ph name="END_LINK" /> வேண்டும்.</translation>
<translation id="3014807377884544255"><ph name="ALTERNATIVE_BROWSER_NAME" /> மூலம் <ph name="TARGET_URL_HOSTNAME" /> இணைப்பைப் பார்ப்பதற்கு உங்கள் சிஸ்டம் நிர்வாகி Optimiumமை உள்ளமைத்துள்ளார்.</translation>
<translation id="7352651011704765696">ஏதோ தவறு ஏற்பட்டது</translation>
<translation id="6261059974673858354">இனிவரும் Optimium புதுப்பிப்புகளைப் பெற macOS 13 அல்லது அதற்குப் பிந்தைய பதிப்பு தேவை. இந்தக் கம்ப்யூட்டர் macOS 12 பதிப்பைப் பயன்படுத்துகிறது.</translation>
<translation id="7374061268215476070">நீங்கள் பிரவுசிங் செய்யும்போதே கேள்விகளைக் கேட்க Google Search பக்கவாட்டு பேனலை மீண்டும் திறக்கலாம்</translation>
<translation id="7376384068949534168">இந்தத் தளத்தை நீங்கள் சமீபத்தில் பார்க்கவில்லை. <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> ஆகிய அனுமதிகளை Chromium அகற்றிவிட்டது.</translation>
<translation id="73786666777299047">Chrome இணைய அங்காடியைத் திற</translation>
<translation id="3890970823792853036">சிஸ்டம் டிரேயில் Optimiumமில் Geminiயைக் காட்டு</translation>
<translation id="7401687852903179959">படத் தேடல் மூலம் இந்த வீடியோவைத் தேடுங்கள்</translation>
<translation id="3864955417896853787">இப்போது உங்கள் இயல்பு பிரவுசர் Optimium</translation>
<translation id="7774148037106099906">விட்ட இடத்திலிருந்து தொடரலாம்: நீங்கள் ஒவ்வொரு முறை மீண்டும் தொடங்கும்போதும் Optimium உங்கள் பக்கங்களை மீட்டெடுக்கிறது. இதை ஆஃப் செய்ய, இதற்குச் செல்லவும்:</translation>
<translation id="8928491002876394495">Optimiumமிற்குக் கடவுச்சொற்களைப் பதிவேற்றுதல்</translation>
<translation id="5203709869300967635">1. கீழே <ph name="BUTTON_LABEL" /> பட்டனைக் கிளிக் செய்யுங்கள்
2. Windows அமைப்புகளில் <ph name="BUTTON_2" /> பட்டனைக் கிளிக் செய்யுங்கள்
3. விரைவாக அணுகுவதற்கு Optimiumமை உங்கள் செயல் பட்டியில் பின் செய்ய, Windows அறிவிப்பில் <ph name="BUTTON_3" /> பட்டனைக் கிளிக் செய்யுங்கள்</translation>
<translation id="1391846143863378733"><ph name="PAGE_TITLE" /> - டெவெலப்பர்களுக்கான Optimium</translation>
<translation id="7450541714075000668">உரை நகலெடுக்கப்பட்டது</translation>
<translation id="7458892263350425044">மைக்ரோஃபோனைப் பயன்படுத்த, Chromiumமிற்கு <ph name="BEGIN_LINK" />சிஸ்டம் அமைப்புகளில்<ph name="END_LINK" /> அணுகலை வழங்குங்கள்</translation>
<translation id="6029586608765705546">இனிவரும் Optimium புதுப்பிப்புகளைப் பெற Windows 10 அல்லது அதற்குப் பிந்தைய பதிப்புத் தேவை. இந்தக் கம்ப்யூட்டர் Windows 7 பதிப்பைப் பயன்படுத்துகிறது.</translation>
<translation id="7467949745582939695">Chromiumமை மீண்டும் தொடங்கவா?</translation>
<translation id="5752242571869112795">தற்போது இயக்கத்தில் உள்ள அதே பதிப்புள்ள Optimiumமை நிறுவ முடியாது. Optimiumமை மூடி, பின்னர் முயலவும்.</translation>
<translation id="7510190804000607802">நினைவில்கொள்ளுங்கள்: Googleளின் சிறந்த அம்சங்கள் உங்கள் பாக்கெட்டில்</translation>
<translation id="751935028865900641">தளங்கள் எதிர்பார்த்தபடி செயல்படும். ஆனால், Chromium சாளரங்கள் அனைத்தையும் மூடும்போது பெரும்பாலான தளங்களில் (Chromiumமில் உள்நுழைந்திருந்தால் உங்களின் Google கணக்கைத் தவிர) இருந்து வெளியேறிவிடுவீர்கள்.</translation>
<translation id="63211891312143018">{0,plural, =1{ஒரு நிமிடத்தில் Optimium மீண்டும் தொடங்கும்}other{# நிமிடங்களில் Optimium மீண்டும் தொடங்கும்}}</translation>
<translation id="7565444033145385702">உங்கள் தரவைப் பாதுகாக்க, நீங்கள் சமீபத்தில் பார்வையிடாத தளங்களில் உள்ள அனுமதிகளை அகற்ற Chromiumமை அனுமதிக்கலாம்.</translation>
<translation id="3125039289492641783">உடனடியாக உலாவத் தொடங்க Optimiumமைத் தானாகவே தொடங்கலாம்.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> நிறுவி</translation>
<translation id="4408734053922791034">Optimium உங்கள் கேமராவையும் மைக்ரோஃபோனையும் பயன்படுத்துகிறது.</translation>
<translation id="3179764934195866467">Optimium இன்னும் சிறப்படைந்துள்ளது</translation>
<translation id="6404693631411216689">Optimiumமில் இப்போது உங்களுக்குக் கூடுதல் அம்சங்கள் கிடைக்கும்</translation>
<translation id="7624307931717240213">இந்தச் சேவையை மேம்படுத்த தகவல்களைப் பயன்படுத்துகிறோம். தனியுரிமைக் கொள்கை மற்றும் சேவை விதிமுறைகளைப் பாருங்கள்.</translation>
<translation id="7649070708921625228">உதவி</translation>
<translation id="8311510395768039141">Optimium ஆப்ஸைப் பெறுங்கள்</translation>
<translation id="7658239707568436148">ரத்து செய்</translation>
<translation id="133478151344333089">Optimium, உங்கள் இயல்புநிலை உலாவியாக இல்லை</translation>
<translation id="280841280407738358">உங்கள் எல்லாச் சாதனங்களிலும் Optimiumஐ ஒத்திசைக்கலாம், தனிப்பயனாக்கலாம்</translation>
<translation id="7699779824407626136">Chromium புதுப்பிப்பு</translation>
<translation id="4220506181038618136">Optimiumமில் உங்கள் பணி பாதுகாப்பாக உள்ளது</translation>
<translation id="7716950018788545737">பணிகள் முடிந்தன.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME" /> பிரவுசருக்கு சிஸ்டம் டிரேஸிங் சேவைகளை வழங்கும். இந்தச் சேவை முடக்கப்பட்டால், பிரவுசர் உருவாக்கும் செயல்பாட்டு டிரேஸ்களில் கண்டக்ஸ்ட் சுவிட்ச், ரெடி த்ரட் நிகழ்வுகளைப் போன்ற, சிஸ்டம் முழுமைக்குமான நிகழ்வுகள் சேர்க்கப்படாது.</translation>
<translation id="7745317241717453663">வெளியேறினால், இந்தச் சாதனத்திலிருந்து நீங்கள் உலாவிய தரவு நீக்கப்படும். பின்னர் தரவை மீட்டமைக்க, Chromiumல் <ph name="USER_EMAIL" /> எனும் முகவரியின் மூலம் உள்நுழையவும்.</translation>
<translation id="7747138024166251722">தற்காலிக டைரக்டரியை நிறுவியால் உருவாக்க முடியவில்லை. வட்டு இடம் காலியாக உள்ளதா, மென்பொருளை நிறுவுவதற்கு தகுந்த அனுமதி உள்ளதா என்பதை சரிபார்க்கவும்.</translation>
<translation id="4874030584283115178">இயல்பு Optimiumமிற்கு மீட்டமை</translation>
<translation id="4747871007139957101">Optimiumமில் உங்கள் பணியைப் பாதுகாக்க, Optimiumமில் நீங்கள் உள்நுழைந்திருக்கும்போது குறிப்பிட்ட சில தகவல்களை உங்கள் நிறுவனத்தால் பார்க்கவோ நிர்வகிக்கவோ முடியும்.</translation>
<translation id="39303350018938562">Optimiumமை இயல்பு பிரவுசராக அமைத்து செயல் பட்டியில் பின் செய்யும்</translation>
<translation id="1411498815218277204">Optimiumமை விரைவாக்குகிறது</translation>
<translation id="6759916683257281869"><ph name="PAGE_TITLE" /> - Optimium Canary</translation>
<translation id="7800043020703832708">பக்கவாட்டு பேனலில் Google Search மூடு</translation>
<translation id="7801317262080715012">புதிய ஐகான், அதே ஷார்ட்கட்: நீங்கள் பிரவுசிங் செய்யும்போதே ‘Google Search பேனல்’ மூலம் கேள்விகளைக் கேட்க கிளிக் செய்யுங்கள்.</translation>
<translation id="7803986347287457849">உங்கள் இன்டர்நெட் டிராஃபிக்கிற்கான அணுகல் உள்ளவர்களுக்கு நீங்கள் பார்க்கும் தளங்களைத் தெரிந்துகொள்வதைக் கடினமாக்குகிறது. DNSஸில் (Domain Name System - டொமைன் பெயர் சிஸ்டம்) ஒரு தளத்தின் IP முகவரியைத் தேட Chromium பாதுகாப்பான இணைப்பைப் பயன்படுத்துகிறது.</translation>
<translation id="7810005234485217901">எளிதாக அணுக படத் தேடலைப் பின் செய்யலாம்</translation>
<translation id="3974047900913685132">{COUNT,plural, =1{Optimiumமின் புதிய புதுப்பிப்பு உள்ளது, மீண்டும் தொடங்கும்போது அது பயன்படுத்தப்படும். மறைநிலை அல்லது ஐசோலேட்டட் விண்டோ திறந்துள்ளது. மீண்டும் தொடங்கினால் அது திறக்கப்படாது.}other{Optimiumமின் புதிய புதுப்பிப்பு உள்ளது, மீண்டும் தொடங்கும்போது அது பயன்படுத்தப்படும். சுயவிவரங்கள் முழுவதிலும் # மறைநிலை மற்றும் ஐசோலேட்டட் விண்டோக்கள் திறந்துள்ளன. மீண்டும் தொடங்கினால் அவை திறக்கப்படாது.}}</translation>
<translation id="1327395026710636574">Optimium உடன் பகிர வேண்டியவற்றைத் தேர்வுசெய்யுங்கள்</translation>
<translation id="7712700268586648421">இந்தக் கணக்கின் மூலம் ஏற்கெனவே ஒரு Optimium சுயவிவரம் இந்தச் சாதனத்தில் உருவாக்கப்பட்டுள்ளது</translation>
<translation id="7845233973568007926">நிறுவியதற்கு நன்றி. <ph name="BUNDLE_NAME" /> ஐப் பயன்படுத்துவதற்கு முன் கம்ப்யூட்டரை மீண்டும் தொடங்க வேண்டும்.</translation>
<translation id="7639854797882089460">Optimium அல்லாமல் வேறொன்றில் இருந்து உங்கள் தேடல் இன்ஜின் மாற்றப்பட்டுள்ளது. உங்களைப் பாதுகாக்க, Optimium அதன் அசல் இயல்புநிலைக்கு இதை மீட்டமைத்துள்ளது. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3551756496947130501">Optimiumமைப் பிரத்தியேகமாக்கி அதற்குப் புதிய தோற்றத்தைக் கொடுக்கலாம்</translation>
<translation id="7859018312476869945">முகவரிப் பட்டியிலோ தேடல் பெட்டியிலோ நீங்கள் டைப்செய்யும்போது, சிறப்பான பரிந்துரைகளைப் பெறுவதற்காக அவற்றை உங்களின் வழக்கமான தேடல் இன்ஜினுக்கு Chromium அனுப்பும். இந்த அம்சம் மறைநிலைப் பயன்முறையில் முடக்கப்பட்டிருக்கும்.</translation>
<translation id="7884611555881634231">Optimium சமீபத்திய பதிப்பிற்குப் புதுப்பிக்கப்படவில்லை என்பதால், புதிய அம்சங்களையும் பாதுகாப்புத் திருத்தங்களையும் தவறவிடுகிறீர்கள்.</translation>
<translation id="7872446069773932638">பதிவிறக்குகிறது... <ph name="SECONDS" /> வினாடிகள் மீதமுள்ளன</translation>
<translation id="7873537467422636035">கடவுச்சொற்றொடரை மறந்துவிட்டாலோ இந்த அமைப்பை மாற்ற விரும்பினாலோ <ph name="BEGIN_LINK" />உங்கள் கணக்கில் உள்ள Chromium தரவை நீக்குங்கள்<ph name="END_LINK" /></translation>
<translation id="3834573390507006929">தேவைப்படும்போதெல்லாம் Optimiumமில் Geminiயை விரைவாகத் திறக்கும்</translation>
<translation id="6294556714699385535">Optimiumமை இயல்பு உலாவியாக அமை</translation>
<translation id="7904213866086517086">பக்கவாட்டு பேனலில் Google Searchசை மீண்டும் திறக்கும்</translation>
<translation id="7934340546140346950">சாத்தியமான சூழல்களில் பாதுகாப்பற்ற இணைப்புகளை Chromium தானாகவே HTTPSஸாக மேம்படுத்தும்</translation>
<translation id="5730000852184248909">Optimiumமில் <ph name="USER_EMAIL_ADDRESS" /> ஆக உள்நுழைந்திருந்தீர்கள். மீண்டும் உள்நுழைய அதே கணக்கைப் பயன்படுத்தவும்.</translation>
<translation id="8566131222358264585"><ph name="EXISTING_USER" /> கணக்கில் ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Optimiumமில் <ph name="USER_EMAIL_ADDRESS" /> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். புக்மார்க்குகளையும், மேலும் பலவற்றையும் உங்களின் எல்லாச் சாதனங்களிலும் பெறுவீர்கள்.</translation>
<translation id="7975919845073681630">இது Chromium இன் இரண்டாம் நிலை நிறுவல் என்பதால், அதை இயல்புநிலை உலாவியாக அமைக்க முடியாது.</translation>
<translation id="6422450341111525365">அறியப்படாத மூலங்களில் இருந்து பெறும் நீட்டிப்புகள், ஆப்ஸ், தீம்கள் ஆகியவை உங்கள் சாதனத்திற்குத் தீங்கு விளைவிக்கக்கூடும். <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> இல் இருந்து மட்டும் இவற்றை நிறுவுமாறு Optimium பரிந்துரைக்கிறது</translation>
<translation id="6757123197146934198">உங்கள் <ph name="DEVICE_TYPE" /> இல் Optimium ஆப்ஸ் மூலம் Googleளின் சிறந்த அம்சங்களைப் பெறுங்கள்</translation>
<translation id="8004582292198964060">உலாவி</translation>
<translation id="8010081455002666927">தானியங்குக் கண்டறிதல்</translation>
<translation id="1278413817028711539">Optimiumமுக்கு அணுகல் கிடைத்தவுடன், இணையதளங்கள் உங்களிடம் அணுகலைக் கோர முடியும்.</translation>
<translation id="349886907929581949">எந்த நேரத்திலும் Optimiumமிற்கு விரைவாகச் செல்ல செயல் பட்டியில் அதைப் பின் செய்யவும்</translation>
<translation id="80471789339884597">நிறுவியதற்கு நன்றி. <ph name="BUNDLE_NAME" /> ஐப் பயன்படுத்துவதற்கு முன் உங்கள் அனைத்து உலாவிகளையும் மீண்டும் தொடங்க வேண்டும்.</translation>
<translation id="8054112667659782652">படத் தேடலுக்கான ஷார்ட்கட்டை எப்போதும் காட்டு</translation>
<translation id="8069447462453318634">"கருவிப்பட்டியில் பின் செய்" என்பதைத் தேர்ந்தெடுக்கவும்</translation>
<translation id="4174818101907153398">ஆப்ஸிற்காக Optimium பின்புலத்தில் இயங்குவதை முடக்கு</translation>
<translation id="80790299200510644">படத் தேடல்</translation>
<translation id="8086881907087796310">குறைந்தபட்ச வன்பொருள் தேவைகளை உங்கள் கம்ப்யூட்டர் பூர்த்திசெய்யவில்லை என்பதால் நிறுவ முடியவில்லை.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> - Google Chrome for Testing</translation>
<translation id="1888025000812363096">இந்தத் தளத்தை அணுக, Optimiumமிற்கு இருப்பிட அணுகல் தேவை</translation>
<translation id="7584643292999340766">அடுத்த முறை உங்கள் <ph name="DEVICE_TYPE" /> சாதனத்தில் Optimiumமைத் திறக்கும்போது, விலைக் கண்காணிப்பு விழிப்பூட்டல்களை ஆன் செய்யும்படி ஓர் அறிவிப்பு காட்டப்படும்.</translation>
<translation id="7461287607957342327">மொபைலில் உள்ள Optimium ஆப்ஸ் மூலம், நீங்கள் வாங்க விரும்பும் தயாரிப்புகளின் விலைச் சரிவு குறித்த விழிப்பூட்டல்களைப் பெறுங்கள்</translation>
<translation id="8118331347066725040">Lens மூலம் தேடுதல் குறித்த கருத்தை அனுப்புக</translation>
<translation id="3539581840889743095">உங்களுக்கான Optimium ஆக மாற்றுங்கள்</translation>
<translation id="8133124826068723441">உங்கள் டொமைனில் ஒத்திசைவு இல்லாததால் உங்கள் தரவை ChromiumOSஸால் ஒத்திசைக்க முடியவில்லை.</translation>
<translation id="813913629614996137">துவக்குகிறது...</translation>
<translation id="4772631357296776122">கீபோர்டு ஷார்ட்கட் மூலம் Optimiumமில் Geminiயைத் திறக்கலாம்.</translation>
<translation id="8164014945047474187">Chromium கூடுதல் சேவை விதிமுறைகள்</translation>
<translation id="4835039973898764392">{COUNT,plural, =1{புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி கேட்கிறார். மறைநிலை அல்லது ஐசோலேட்டட் விண்டோ திறந்துள்ளது. மீண்டும் தொடங்கினால் அது திறக்கப்படாது.}other{புதுப்பிப்பைப் பயன்படுத்த Optimiumமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி கேட்கிறார். சுயவிவரங்கள் முழுவதிலும் # மறைநிலை மற்றும் ஐசோலேட்டட் விண்டோக்கள் திறந்துள்ளன. மீண்டும் தொடங்கினால் அவை திறக்கப்படாது.}}</translation>
<translation id="8065654717207240588">இந்த ஃபைல் ஆபத்தானது என்பதால், அதை Optimium தடுத்துள்ளது.</translation>
<translation id="8177472873527554730">பக்கத்தில் உள்ளடக்கத்தைக் கண்டறிய முடியவில்லை</translation>
<translation id="8200109504272824693">உங்கள் கணக்கில் (<ph name="USER_EMAIL" />) உள்ள Chromium தரவைப் பயன்படுத்தவும் சேமிக்கவும் உங்கள் கடவுச்சொற்றொடரை வழங்கவும்</translation>
<translation id="8203105157044679380">Google Search பேனல்</translation>
<translation id="820759916613250543">படத் தேடல் மூலம் இந்தப் படத்தைத் தேடுங்கள்</translation>
<translation id="8221491193165283816">பொதுவாக அறிவிப்புகளைத் தடுத்துள்ளீர்கள். இந்தத் தளம் அறிவிப்புகளை வழங்கச் செய்ய, இங்கே கிளிக் செய்யவும்.</translation>
<translation id="8223363452568144035">கேமராவைப் பயன்படுத்த, Chromiumமிற்கு <ph name="BEGIN_LINK" />சிஸ்டம் அமைப்புகளில்<ph name="END_LINK" /> அணுகலை வழங்குங்கள்</translation>
<translation id="1094434558959920914">இந்த நீட்டிப்பு எங்கிருந்து பெறப்பட்டது என்பதை Optimiumமால் சரிபார்க்க முடியவில்லை மேலும் இது பாதுகாப்பற்றதாக இருக்கக்கூடும். நீங்கள் பார்க்கும் தளங்கள் குறித்த தரவை (உங்கள் தனிப்பட்ட தகவலும் இதில் அடங்கும்) இந்த நீட்டிப்பு அணுகாமலும், மாற்றங்கள் செய்யாமலும் இருக்க இதை Optimiumமில் இருந்து அகற்றவும்.</translation>
<translation id="3957438238123670294">ஒரு படத்திற்குப் பயனுள்ள விளக்கம் இல்லாதபட்சத்தில் Optimium உங்களுக்காக அதை வழங்க முயலும். விளக்கங்களை உருவாக்குவதற்காக படங்கள் Googleளுக்கு அனுப்பப்படும். அமைப்புகளுக்குச் சென்று எப்போது வேண்டுமானாலும் இதை முடக்கலாம்.</translation>
<translation id="2706853324286223963">Optimiumமில் புதிய சுயவிவரத்தில் உள்நுழைய வேண்டுமா?</translation>
<translation id="1237310177197195175"><ph name="EXISTING_USER" /> கணக்கில் ஏற்கெனவே உள்நுழைந்துள்ளீர்கள். உங்கள் பிரவுசிங்கைத் தனிப்பட்டதாக வைத்திருக்க, Optimiumமில் <ph name="USER_EMAIL_ADDRESS" /> கணக்கின் மூலம் உங்கள் சுயவிவரத்தில் உள்நுழையுங்கள். <ph name="DEVICE" /> இருந்து கடவுச்சொற்களையும், மேலும் பலவற்றையும் பெறுவீர்கள்.</translation>
<translation id="2801607883759458012">சிஸ்டம் டிரேயில் Optimiumமில் Geminiயைக் காட்டி, கீபோர்டு ஷார்ட்கட்டை ஆன் செய்</translation>
<translation id="8286943863733751221">பாதுகாப்பற்ற தளங்கள் மற்றும் பதிவிறக்கங்கள் குறித்து <ph name="BEGIN_LINK" />Chromium உங்களை எச்சரிக்கும்<ph name="END_LINK" /></translation>
<translation id="8295827201165805317">இந்தத் தளத்தை நீங்கள் சமீபத்தில் பார்க்கவில்லை. <ph name="PERMISSION" /> அனுமதியை Chromium அகற்றிவிட்டது.</translation>
<translation id="5265623464653503960">நீங்கள் பார்ப்பவற்றை உங்கள் கேமரா மூலம் Optimium iOS ஆப்ஸில் ஷாப்பிங் செய்யலாம், மொழிபெயர்க்கலாம், அடையாளம் காணலாம்</translation>
<translation id="7565411431973063464"><ph name="USER_NAME" /> என்ற கணக்கில் Optimiumமில் உள்நுழைவதற்கான QR குறியீடு</translation>
<translation id="8313851650939857356">துவக்கப் பிழை: <ph name="STARTUP_ERROR" />.</translation>
<translation id="5911806827430614904">Optimium <ph name="TIMEOUT_DURATION" /> பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதை மூடிவிடும்.</translation>
<translation id="8321058241987390452">முடிந்தது! நீங்கள் பிரவுசிங் செய்யும்போதே Google Search பேனல் மூலம் எளிதாகக் கேள்விகளைக் கேட்கலாம்</translation>
<translation id="8321888067342493336">படமாகச் சேமி</translation>
<translation id="1508573889613002459"><ph name="USER_EMAIL_ADDRESS" /> ஏற்கனவே Optimiumஐப் பயன்படுத்திக் கொண்டிருந்தது</translation>
<translation id="8351551329754447960">Chromiumமில் திறன்களை ஆன் செய்</translation>
<translation id="406081439566291910">உங்கள் Google கணக்கில் (<ph name="ACCOUNT_EMAIL" />) உள்ள Optimium தரவைத் தொடர்ந்து பயன்படுத்த Optimiumமைப் புதுப்பிக்கவும்</translation>
<translation id="1007124785122331769">இனிவரும் Optimium புதுப்பிப்புகளைப் பெற Windows 10 அல்லது அதற்குப் பிந்தைய பதிப்பு தேவை. இந்தக் கம்ப்யூட்டர் Windows 8 பதிப்பைப் பயன்படுத்துகிறது.</translation>
<translation id="8362914115861174987">இதற்கு மொழிபெயர்க்கும்:</translation>
<translation id="8367705492654390392">எதை வேண்டுமானாலும் கேளுங்கள்</translation>
<translation id="8370517070665726704">பதிப்புரிமை <ph name="YEAR" /> Google LLC. அனைத்து உரிமைகளும் பாதுகாக்கப்பட்டவை.</translation>
<translation id="3692978295966861512">கடவுச்சொற்கள் மற்றும் பலவற்றை உங்கள் சாதனங்கள் அனைத்திலும் பெற Optimiumமில் உள்நுழையுங்கள். நீங்கள் உள்நுழைந்த பிறகு உங்கள் Google கணக்கில் இந்தக் கடவுச்சொல் சேமிக்கப்படும்.</translation>
<translation id="7364603585139702314">Optimiumமை மீண்டும் தொடங்க வேண்டும்.</translation>
<translation id="8376752431516546391">Google Search பக்கவாட்டு பேனல்</translation>
<translation id="8236183484860169180">இதை அகற்றும்படி Optimium பரிந்துரைக்கிறது. <ph name="BEGIN_LINK" />ஆதரிக்கப்படும் நீட்டிப்புகள் குறித்து மேலும் தெரிந்துகொள்ளுங்கள்.<ph name="END_LINK" /></translation>
<translation id="5920842078198979811">இந்த நீட்டிப்பின் வெளியீடு அதன் டெவெலப்பரால் நிறுத்தப்பட்டது, மேலும் இது பாதுகாப்பற்றதாக இருக்கக்கூடும். நீங்கள் பார்க்கும் தளங்கள் குறித்த தரவை (உங்கள் தனிப்பட்ட தகவலும் இதில் அடங்கும்) இந்த நீட்டிப்பு அணுகாமலும், மாற்றங்கள் செய்யாமலும் இருக்க இதை Optimiumமில் இருந்து அகற்றவும்.</translation>
<translation id="8406687098231754303">கருவிப்பட்டியில் உள்ள "பக்கவாட்டு பேனலில் Google Search" பட்டனைப் பயன்படுத்தி, நீங்கள் பிரவுசிங் செய்யும்போதே கேள்விகளைக் கேட்க பக்கவாட்டுப் பேனலில் Google Searchசை மீண்டும் திறக்கலாம்</translation>
<translation id="2185697372454035703">இது நீங்கள்தான் என்பதை Optimium உறுதிசெய்ய வேண்டும். அதன் பிறகே, உங்கள் Google கணக்கில் தரவைச் சேமித்து அதை எல்லாச் சாதனங்களிலும் உங்களால் பயன்படுத்த முடியும். இப்போது வெளியேறினால் இந்தத் தரவு நீக்கப்படும்.</translation>
<translation id="4724639108574581385">{0,plural, =1{ஒரு நாளுக்குள் Optimiumமை மீண்டும் தொடங்கவும்}other{# நாட்களுக்குள் Optimiumமை மீண்டும் தொடங்கவும்}}</translation>
<translation id="8438543370129609977">படத் தேடல் அம்சத்தைப் பயன்படுத்தும்போது பக்கத் தலைப்பு, URL, PDFகள் உள்ளிட்ட உள்ளடக்கம் ஆகியவை சேவையகத்திற்கு அனுப்பப்படும். <ph name="LEARN_MORE" /></translation>
<translation id="3557945352384776441">Optimiumமில் படத் தேடல் மூலம் தேடுவது குறித்து மேலும் தெரிந்துகொள்ளலாம்</translation>
<translation id="6672310590031980518">நிறுவி காப்பகம் சிதைந்துள்ளது அல்லது தவறானது. Optimiumமை மீண்டும் பதிவிறக்கவும்.</translation>
<translation id="8463672209299734063">விருப்பத்திற்குரியது: பிழை அறிக்கைத் தரவு, உபயோகத் தரவு ஆகியவற்றை Googleளுக்குத் தானாக அனுப்புவதன் மூலம் ChromiumOS அம்சங்களையும் செயல்திறனையும் மேம்படுத்த உதவுங்கள்.</translation>
<translation id="3954441584666499211">உங்கள் Google கணக்கில் உள்ள Optimium தரவைப் பயன்படுத்துவதற்கும் சேமிப்பதற்கும் இது நீங்கள்தான் என்பதை உறுதிப்படுத்தவும்</translation>
<translation id="8482493977473846331">Chromiumமில் உள்நுழைவதற்கான அறிவிப்புகளைக் காட்டும்</translation>
<translation id="8202428378580208719">Optimium காலாவதியானது</translation>
<translation id="850264194101621529">Chromiumமை இயல்பு பிரவுசராகத் தேர்வுசெய்ததற்கு நன்றி!</translation>
<translation id="8520489851087523435">Google Search பக்கவாட்டு பேனலை மீண்டும் திறக்கும்</translation>
<translation id="8522801943730206384">உங்கள் கடவுச்சொற்களை நீங்கள் சேமிக்கும்போது Chromium உலாவியால் அவற்றைச் சரிபார்க்க முடியும்</translation>
<translation id="8525579356836940628">நிறுவல் நிறுத்தப்பட்டது</translation>
<translation id="8984919429007493543">உங்கள் <ph name="DEVICE_TYPE" /> இல் Optimium ஆப்ஸ் மூலம் கடவுச்சொற்கள், பக்கங்கள் மற்றும் பலவற்றை எங்கிருந்தும் அணுகுங்கள்</translation>
<translation id="8555465886620020932">சேவைப் பிழை: <ph name="SERVICE_ERROR" />.</translation>
<translation id="3963774984615461205">சில Optimium அம்சங்களுக்கும் நீட்டிப்புகளுக்கும் ஷார்ட்கட்கள் உள்ளன. அவற்றை மீண்டும் இயக்க நீங்கள் தேர்வுசெய்யலாம்.</translation>
<translation id="8556420416730706394">எளிதாக அணுக படத் தேடலைப் பின் செய்யலாம். இதற்கு, பக்கவாட்டு பேனலின் மேற்புறத்தில் உள்ள 'பின் செய்' பட்டனைக் கிளிக் செய்யவும்.</translation>
<translation id="8564408666201523086">முடிந்தது! பக்கவாட்டு பேனலில் Google Search மூலம் பிரவுஸ் செய்யும்போதே எளிதாகக் கேள்விகளைக் கேட்கலாம்</translation>
<translation id="856656450041460113">மொழிப் பட்டியலைத் தேடும்</translation>
<translation id="8568499811906962479">நீங்கள் பிரவுசிங் செய்யும்போதே கேள்விகளைக் கேட்க Google Search பேனலைப் பின் செய்யலாம்</translation>
<translation id="2996904635986800713">Optimiumமைப் பல நிறுவனங்கள் நிர்வகிக்கின்றன</translation>
<translation id="8586442755830160949">பதிப்புரிமை <ph name="YEAR" /> Chromium உருவாக்குநர்கள். அனைத்து உரிமைகளும் பாதுகாக்கப்பட்டவை.</translation>
<translation id="8590782867495422699">Google Search AI மோடை மீண்டும் திறக்கும்</translation>
<translation id="2446482746737130055">Optimiumமைத் தொடங்குகிறது...</translation>
<translation id="8624541899164515475">அமைப்புகள், புதிய பக்கத்தில் திறக்கும்.</translation>
<translation id="8648201657708811153">Google Chrome for Testingகை உங்கள் இயல்பு உலாவியாக அமைக்க முடியாது.</translation>
<translation id="9172606645924379921">எங்கிருந்தும் Optimium மூலம் தேடுங்கள்</translation>
<translation id="8689408573494410517">கருவிப்பட்டியில் உள்ள "பக்கவாட்டு பேனலில் Google Search" பட்டன் புதிய ஐகானைப் பெற்றுள்ளது. நீங்கள் பிரவுசிங் செய்யும்போதே ‘பக்கவாட்டு பேனலில் Google Search’ மூலம் கேள்விகளைக் கேட்க, அதைக் கிளிக் செய்யுங்கள்.</translation>
<translation id="5596132704047725626">Optimiumமைத் தொடங்கும்போது அல்லது ஆம்னிபாக்ஸிலிருந்து தேடலை மேற்கொள்ளும்போது காண்பிக்கப்படும் பக்கத்தையும் இது கட்டுப்படுத்துகிறது.</translation>
<translation id="567010981548424498">இந்தப் பக்கத்தை மற்றொரு சாதனத்திற்கு அனுப்ப, அந்தச் சாதனத்திலும் Optimiumமில் உள்நுழையவும்</translation>
<translation id="4758459198907306138">இது உங்கள் Optimium ஆகும்</translation>
<translation id="8712637175834984815">புரிந்தது</translation>
<translation id="5293592838971423777">Optimiumமில் உள்நுழைய வேண்டுமா?</translation>
<translation id="8747073452963259673">தேடல் பகுதியின் கீழ் இடது மூலை: இடது <ph name="LEFT" />%, கீழ் <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">நிறுவல் பிழை: நிறுவலைத் தடுக்கும் குழுக் கொள்கையை உங்கள் நெட்வொர்க் நிர்வாகி பயன்படுத்தியுள்ளார்: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">பின்னர் நினைவூட்டு</translation>
<translation id="8601403845093292651">விரைவான தகவல் சுருக்கத்தைப் பெறவும் ஃபாலோ-அப் கேள்விகளைக் கேட்கவும் Optimiumமில் Geminiயுடன் இந்த ஆவணத்தைப் பகிருங்கள்</translation>
<translation id="3011694712607672183">Optimiumமில் உள்நுழையவா?</translation>
<translation id="8823401858233292222">Chromiumமை இயல்பு பிரவுசராக்கி செயல் பட்டியில் பின் செய்யும்</translation>
<translation id="8826492472752484139">“Password Manager” என்பதைக் கிளிக் செய்யவும்</translation>
<translation id="8833697763442816810">ChromiumOS சிஸ்டம்</translation>
<translation id="8852026904190808918">Chromiumமில் மெனுக்கள், அமைப்புகள், விழிப்பூட்டல்கள் மற்றும் பிற வார்த்தைகளைக் காட்ட இந்த மொழி பயன்படுத்தப்படும்.</translation>
<translation id="8862326446509486874">கம்ப்யூட்டர்-சார்ந்த நிறுவலுக்கான முறையான உரிமைகள் உங்களிடம் இல்லை. அதனால் நிர்வாகியாக மீண்டும் நிறுவலை இயக்க முயற்சி செய்க.</translation>
<translation id="8400219074131043686">Optimium சுயவிவரத்தைச் சேர்</translation>
<translation id="3471339840299959661">உள்நுழைவில் பிழை ஏற்பட்டதால் உங்கள் Google கணக்கில் Optimium தரவை ChromiumOS சேமிக்க முடியவில்லை</translation>
<translation id="8161120518458367008">Optimiumமில் உள்நுழையும்படி உங்கள் நிறுவனம் வலியுறுத்துகிறது</translation>
<translation id="8897637834206928776">புதிய ஐகான், அதே ஷார்ட்கட்: நீங்கள் பிரவுசிங் செய்யும்போதே ‘பக்கவாட்டு பேனலில் Google Search’ மூலம் கேள்விகளைக் கேட்க கிளிக் செய்யுங்கள்.</translation>
<translation id="3459877940554598369">Windows 10 பதிப்பு 1809 அல்லது அதற்குப் பிந்தைய பதிப்புகளில் மட்டுமே Optimium இயங்கும்.</translation>
<translation id="4176797355456373725">Optimium கடவுச்சொற்களைக் காண்பிக்க முயற்சிக்கிறது. இதை அனுமதிக்க உங்கள் Windows கடவுச்சொல்லைத் தட்டச்சு செய்யவும்.</translation>
<translation id="8300184335948277828">Optimium இப்போது உங்கள் இயல்பு பிரவுசராக இல்லை. Optimiumமை இயல்பு பிரவுசராக அமைக்கவா?</translation>
<translation id="8365648631713891786">Optimiumஐப் புதுப்பிக்க முடியவில்லை</translation>
<translation id="8944232836376404813">இதனால்:
          <ph name="LINE_BREAKS" />
            • உங்கள் துவக்கப் பக்கம், புதிய பிரவுசர் பக்கம், தேடல் இன்ஜின், இடம் மாறாத பக்கங்கள் ஆகியவை மீட்டமைக்கப்படும்
            <ph name="LINE_BREAK" />
            • நீட்டிப்புகள் முடக்கப்படும்
            <ph name="LINE_BREAK" />
            • குக்கீகளும் பிற தற்காலிகத் தளத் தரவும் நீக்கப்படும்
            <ph name="LINE_BREAKS" />
            புக்மார்க்குகள், பதிவுகள், சேமிக்கப்பட்ட கடவுச்சொற்கள் ஆகியவை பாதிக்கப்படாது.</translation>
<translation id="4517341657960407384">Optimium தள ஷார்ட்கட்களைக் காட்டு</translation>
<translation id="6334459924587075942">Optimium Enterprise லோகோ</translation>
<translation id="1013608620694172987">உங்கள் <ph name="DEVICE_TYPE" /> இல் Optimium ஆப்ஸ் மூலம் Googleளின் பாதுகாப்பை எங்கிருந்தும் பெறுங்கள்</translation>
<translation id="6377692339934065652">உங்கள் சுயவிவரத்தைத் திறக்கும்போது ஏதோ தவறாகிவிட்டதால் Optimiumமைத் தொடங்க முடியவில்லை. Optimiumமை மீண்டும் தொடங்கவும்.</translation>
<translation id="8411734418760705455">Optimiumமில் தேட அல்லது <ph name="BEGIN_LINK" />அமைப்புகளில்<ph name="END_LINK" /> பிரத்தியேகப்படுத்த</translation>
<translation id="4403836439014450645">Optimium சுயவிவரங்களை நிர்வகியுங்கள்</translation>
<translation id="7714694033208252813">Optimiumமில் உள்ள Geminiக்கும் நீங்கள் திறந்திருக்கும் பக்கத்திற்கும் இடையே மாற உங்கள் கீபோர்டைப் பயன்படுத்தலாம்.</translation>
<translation id="9018218886431812662">நிறுவப்பட்டது</translation>
<translation id="4028461118515168614">Optimiumஐப் பாதுகாப்பானதாக்க, <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> இல் பட்டியலிடப்படாத பின்வரும் நீட்டிப்பை முடக்கியுள்ளோம், மேலும் அது உங்களுக்குத் தெரியாமல் சேர்க்கப்பட்டிருக்கலாம்.</translation>
<translation id="8853260188791570953">Optimium இல் உள்நுழைக</translation>
<translation id="6769418925691762561">Mac மெனு பட்டியில் Optimiumமில் Search காட்டி, கீபோர்டு ஷார்ட்கட்டை ஆன் செய்</translation>
<translation id="1582160730719680639">மால்வேரை மறைக்கக்கூடிய பிற ஃபைல்கள் இந்தக் காப்பக ஃபைலில் இருக்கலாம் என்பதால் இந்தப் பதிவிறக்கத்தை Optimium தடுத்துள்ளது</translation>
<translation id="136372829312763612">கடவுச்சொற்கள், புக்மார்க்குகள், பதிவுகள் ஆகியவற்றை எல்லாச் சாதனங்களிலும் சரியாக ஒத்திசைத்த நிலையில் வைத்திருக்கலாம். Optimiumமை இயல்பு பிரவுசராக மாற்றுவதன் மூலம் உங்களுக்குத் தெரிந்த மற்றும் பிடித்த அம்சங்களை எளிதாக அணுகலாம். விரைவாக அணுகும் வகையில் Optimium உங்கள் செயல் பட்டியில் பின் செய்யப்படும்.</translation>
<translation id="4121763951659864948">மொபைலில் உள்ள Optimium ஆப்ஸ் மூலம் Googleளின் சிறந்த AI கருவிகளைப் பயன்படுத்துங்கள்</translation>
<translation id="570680773394181802"><ph name="DEVICE" /> சாதனத்தில் உள்ள உங்கள் கடவுச்சொற்களையும் மேலும் பலவற்றையும் பெற Optimiumமில் உள்நுழையுங்கள்</translation>
<translation id="9062666675513499497">பிற Google சேவைகளில் உள்நுழையும்போது Chromiumமிலும் உள்நுழை</translation>
<translation id="9074041031320636790">முடிந்தது! Google Search AI மோடில் பிரவுஸ் செய்யும்போதே கேள்விகளை இப்போது எளிதாகக் கேட்கலாம்</translation>
<translation id="9074163480955555019">புதிய ஐகான், அதே ஷார்ட்கட்: நீங்கள் பிரவுசிங் செய்யும்போதே ‘Chromeமில் Google Search’ மூலம் கேள்விகளைக் கேட்க கிளிக் செய்யுங்கள்.</translation>
<translation id="516400912738056453">Optimium தானாக மூடப்பட்டது</translation>
<translation id="807899198682302888">Optimium காலாவதியானது</translation>
<translation id="4711199283523757502">{0,plural, =1{ஒரு மணிநேரத்திற்குள் Optimium மீண்டும் தொடங்கும்}other{# மணிநேரத்திற்குள் Optimium மீண்டும் தொடங்கும்}}</translation>
<translation id="9106236359747881194">தேட வார்த்தையைத் தேர்ந்தெடுக்கவும்</translation>
<translation id="8368867604698561866">இனிவரும் Optimium புதுப்பிப்புகளைப் பெற Windows 10 அல்லது அதற்குப் பிந்தைய பதிப்புத் தேவை. இந்தக் கம்ப்யூட்டர் Windows 8.1 பதிப்பைப் பயன்படுத்துகிறது.</translation>
<translation id="4437683009835184797">புதிய Optimium &amp;தாவலில் இணைப்பைத் திற</translation>
<translation id="911206726377975832">உங்கள் உலாவிய தரவையும் நீக்க வேண்டுமா?</translation>
<translation id="9118146721060781133">கருவிப்பட்டியில் உள்ள "சூழல் சார்ந்த பணிகள்" பட்டன் புதிய ஐகானைப் பெற்றுள்ளது. நீங்கள் பிரவுசிங் செய்யும்போதே சூழல் சார்ந்த பணிகள் மூலம் கேள்விகளைக் கேட்க, அதைக் கிளிக் செய்யுங்கள்.</translation>
<translation id="9134482777260927479">வீட்டுப்பாட உதவி</translation>
<translation id="9148058034647219655">வெளியேறு</translation>
<translation id="3295815393935110309">விட்ட இடத்திலிருந்து தொடரலாம்: நீங்கள் ஒவ்வொரு முறை மீண்டும் தொடங்கும்போதும் Optimium உங்கள் பக்கங்களை மீட்டெடுக்க முடியும். இதை ஆன் செய்ய, இதற்குச் செல்லவும்:</translation>
<translation id="5167935114017057528"><ph name="TARGET_URL_HOSTNAME" />ஐ அணுக Optimium அதை மாற்று உலாவியில் திறக்கும்படி உங்கள் சிஸ்டம் நிர்வாகி உள்ளமைத்துள்ளார்.</translation>
<translation id="903669083727317908">&amp;Optimiumமைப் புதுப்பிக்க மீண்டும் தொடங்கு</translation>
<translation id="1256233032126781893">Optimium (mDNS-In)</translation>
<translation id="6225435091563451277">Optimiumமைப் பிரத்தியேகமாக்குங்கள்</translation>
<translation id="1987988401118534091">Windows XP அல்லது Windows Vista ஆகியவற்றில் Optimium இனி ஆதரிக்கப்படாது என்பதால், அது சரியாகச் செயல்படாது</translation>
<translation id="8102971646278891292">Optimium மூலம் Googleளின் சிறந்த பாதுகாப்பு அம்சங்களை எங்கிருந்தும் பெறலாம்.</translation>
<translation id="945522503751344254">கருத்தை அனுப்பு</translation>
<translation id="225981349930289899">Optimiumமைப் பயன்படுத்துவது யார்?</translation>
<translation id="2788235168912697021">Optimiumமின் உச்சபட்சப் பாதுகாப்பைப் பெறுங்கள்</translation>
<translation id="983803489796659991">புதுப்பிப்புச் சேவையகத்தில் ஆப்ஸுக்கான ஹேஷ் தரவு எதுவும் இல்லாததால் நிறுவ முடியவில்லை.</translation>
<translation id="802168381040095988">கணக்கு இல்லாமல் Optimiumமைப் பயன்படுத்து</translation>
<translation id="985602178874221306">Chromium அங்கீகரிப்பாளர்கள்</translation>
<translation id="989970834842471429">படத் தேடல் அம்சத்தின் மூலம் தேட வார்த்தைகளையோ படத்தையோ தேர்ந்தெடுக்கவும்</translation>
<translation id="992780518932311116">இருப்பிடத்தைப் பயன்படுத்த, Chromiumமிற்கு <ph name="BEGIN_LINK" />சிஸ்டம் அமைப்புகளில்<ph name="END_LINK" /> அணுகலை வழங்குங்கள்</translation>
</translationbundle>

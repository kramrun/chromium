<translation id="8236183484860169180">Optimium እንዲያስወግዱት ይመክራል። <ph name="BEGIN_LINK" />ስለሚደገፉ ቅጥያዎች የበለጠ ይወቁ<ph name="END_LINK" /></translation>
<translation id="5920842078198979811">ይህ ቅጥያ በገንቢው ከህትመት ወጥቷል እና ደህንነቱ የተጠበቀ ላይሆን ይችላል። የግል መረጃዎን ጨምሮ ከእንግዲህ እርስዎ በሚጎበኟቸው ጣቢያዎች ላይ ያለዎን ውሂብ ማየት እና መለወጥ እንዳይችል ከOptimium ያስወግዱት።</translation>
<translation id="8406687098231754303">በመሣሪያ አሞሌው ላይ ካለው «Google ፍለጋ በጎን ፓነል ውስጥ» አዝራር ላይ በሚያስሱበት ጊዜ ጥያቄዎችን ለመጠየቅ Google ፍለጋ በጎን ፓነል ውስጥን እንደገና መክፈት ይችላሉ</translation>
<translation id="2185697372454035703">የተወሰነ ውሂብ በGoogle መለያዎ ውስጥ መቀመጥ እና በሁሉም መሣሪያዎችዎ ላይ ጥቅም ላይ መዋል ከመቻሉ በፊት Optimium ማንነትዎን ማረጋገጥ አለበት። አሁን ዘግተው ከወጡ ይህ ውሂብ ይሰረዛል።</translation>
<translation id="4724639108574581385">{0,plural, =1{በአንድ ቀን ውስጥ Optimiumን ዳግም አስጀምር}one{በ# ቀኖች ውስጥ Optimiumን ዳግም አስጀምር}other{በ# ቀኖች ውስጥ Optimiumን ዳግም አስጀምር}}</translation>
<translation id="8438543370129609977">የምስል ፍለጋ ሲያደርጉ PDFዎችን ጨምሮ የገፁ ርዕስ፣ ዩአርኤል እና ይዘት ወደ አገልጋዩ ይላካሉ። <ph name="LEARN_MORE" /></translation>
<translation id="3557945352384776441">Optimium ውስጥ በምስል ፍለጋ ስለመፈለግ የበለጠ ይወቁ</translation>
<translation id="6672310590031980518">የጫኚው መዝገብ ተበላሽቷል ወይም ትክክል አይደለም። እባክዎ Optimiumን እንደገና ያውርዱ።</translation>
<translation id="8463672209299734063">ከተፈለገ፦ የምርመራ እና የአጠቃቀም ውሂብ ወደ Google በራስ-ሰር በመላክ የChromiumOS ባህሪያትን እና አፈጻጸምን እንዲሻሻል ያግዙ።</translation>
<translation id="3954441584666499211">Google መለያዎ ውስጥ የOptimium ውሂብን ለመጠቀም እና ለማስቀመጥ እርስዎ መሆንዎን ያረጋግጡ</translation>
<translation id="8482493977473846331">ወደ Chromium ለመግባት ጥያቄዎችን ያሳያል</translation>
<translation id="8202428378580208719">Optimium ጊዜው አልፎበታል</translation>
<translation id="850264194101621529">Chromiumን እንደ ነባሪ አሳሽዎ ስለመረጡ እናመሰግናለን!</translation>
<translation id="8520489851087523435">የGoogle ፍለጋ የጎን ፓነልን እንደገና ይክፈቱ</translation>
<translation id="8522801943730206384">እርስዎ የይለፍ ቃላትዎን ሲያስቀምጧቸው Chromium መፈተሽ ይችላል</translation>
<translation id="8525579356836940628">ጭነት ቆሟል</translation>
<translation id="8984919429007493543">በእርስዎ <ph name="DEVICE_TYPE" /> ላይ ባለው የOptimium መተግበሪያ የይለፍ ቃላትዎን፣ ትሮችዎን እና ሌሎችንም በመሄድ ላይ ይውሰዱ</translation>
<translation id="8555465886620020932">የአገልግሎት ስህተት፡ <ph name="SERVICE_ERROR" />።</translation>
<translation id="3963774984615461205">አንዳንድ የOptimium ባህሪያት እና ቅጥያዎች ከአቋራጮች ጋር ይመጣሉ። መልሰው ለማብራት መምረጥ ይችላሉ።</translation>
<translation id="8556420416730706394">በቀላሉ ለመድረስ የምስል ፍለጋ ፒን ማድረግ ይችላሉ፤ በጎን ፓነሉ አናት ላይ የሚገኘውን ፒን አድርግ አዝራርን ጠቅ ያድርጉ</translation>
<translation id="8564408666201523086">ተሳክቷል! አሁን በጎን ፓነል ውስጥ በGoogle ፍለጋ እያሰሱ ሳለ ጥያቄዎችን በቀላሉ መጠየቅ ይችላሉ</translation>
<translation id="856656450041460113">የቋንቋ ዝርዝር ፈልግ</translation>
<translation id="8568499811906962479">በሚያስሱበት ጊዜ ጥያቄዎችን ለመጠየቅ የGoogle ፍለጋ ፓነልን ፒን ማድረግ ይችላሉ</translation>
<translation id="2996904635986800713">ብዙ ድርጅቶች Optimiumን ያስተዳድራሉ</translation>
<translation id="8586442755830160949">የቅጂ መብት <ph name="YEAR" /> የChromium ደራሲያን። ሁሉም መብቶች የተጠበቁ ናቸው።</translation>
<translation id="8590782867495422699">የGoogle ፍለጋ ሰው ሠራሽ አስተውሎት ሁነታን እንደገና ክፈት</translation>
<translation id="2446482746737130055">Optimiumን በማስጀመር ላይ...</translation>
<translation id="8624541899164515475">ቅንብሮች፣ በአዲስ ትር ውስጥ ይከፈታል።</translation>
<translation id="8648201657708811153">Google Chrome ለሙከራ የእርስዎ ነባሪ አሳሽ እንዲሆን ማድረግ አይቻልም።</translation>
<translation id="9172606645924379921">ከየትኛውም ቦታ ሆነው በOptimium ይፈልጉ</translation>
<translation id="8689408573494410517">በመሣሪያ አሞሌው ላይ ያለው «Google ፍለጋ በጎን ፓነል ውስጥ» አዝራር አዲስ አዶ አለው። በጎን ፓነል ውስጥ በGoogle ፍለጋ እያሰሱ ሳለ ጥያቄዎችን ለመጠየቅ እሱን ጠቅ ያድርጉ።</translation>
<translation id="5596132704047725626">እንዲሁም Optimiumን ሲጀምሩት ወይም ከኦምኒቦክሱ ሆነው ሲፈልጉ የሚታየውን ገፅ ይቆጣጠራል።</translation>
<translation id="567010981548424498">ይህን ትር ወደ ሌላ መሣሪያ ለመላክ እዚያ ላይ ወደ Optimium ይግቡ</translation>
<translation id="4758459198907306138">ይሄ የእርስዎ Optimium ነው</translation>
<translation id="8712637175834984815">ገባኝ</translation>
<translation id="5293592838971423777">ወደ Optimium ይግቡ?</translation>
<translation id="8747073452963259673">የፍለጋው አካባቢ ከታች በስተግራ ጥግ፦ ግራ <ph name="LEFT" />%፣ ከታች <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">የጭነት ስህተት፦ የእርስዎ የአውታረ መረብ አስተዳዳሪ ጭነትን የሚከላከል የቡድን መመሪያ ተግባራዊ አድርጓል፦ <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">ቆይተህ አስታውሰኝ</translation>
<translation id="8601403845093292651">ፈጣን አጠቃላይ ዕይታ ለማግኘት እና ተከታይ ጥያቄዎችን ለመጠየቅ ይህን ሰነድ በOptimium ውስጥ ካለው Gemini ጋር ያጋሩ</translation>
<translation id="3011694712607672183">ወደ Optimium ይግቡ?</translation>
<translation id="8823401858233292222">Chromium ነባሪ አሳሽ እንዲሆን ያድርጉ እና ወደ የተግባር አሞሌው ፒን ያድርጉት</translation>
<translation id="8826492472752484139">«የሚስጥር ቁልፍ አስተዳዳሪ» ላይ ጠቅ ያድርጉ</translation>
<translation id="8833697763442816810">የChromiumOS ስርዓት</translation>
<translation id="8852026904190808918">ይህ ቋንቋ Chromium ውስጥ ምናሌዎች፣ ቅንብሮች፣ ማንቂያዎች እና ሌላ ጽሁፍ ለማሳየት ጥቅም ላይ ይውላል</translation>
<translation id="8862326446509486874">ለስርዓተ-ደረጃ ጭነት ተገቢ መብቶች የሉዎትም። ጫኚውን እንደ አስተዳዳሪ በማሄድ እንደገና ይሞክሩ።</translation>
<translation id="8400219074131043686">የOptimium መገለጫ ያክሉ</translation>
<translation id="3471339840299959661">በመለያ በመግባት ላይ ባለ ስሕተት ምክንያት ChromiumOS የOptimium ውሂብን በGoogle መለያዎ ውስጥ ማስቀመጥ አልቻለም</translation>
<translation id="8161120518458367008">ድርጅትዎ ወደ Optimium እንዲገቡ ይጠይቃል</translation>
<translation id="8897637834206928776">አዲስ አዶ፣ ተመሳሳይ አቋራጭ፦ በጎን ፓነል ውስጥ በGoogle ፍለጋ እያሰሱ ሳለ ጥያቄዎችን ለመጠየቅ ጠቅ ያድርጉ።</translation>
<translation id="3459877940554598369">Optimium የWindows 10 ሥሪት 1809 ወይም ከዚያ በላይ ያስፈልገዋል።</translation>
<translation id="4176797355456373725">Optimium የይለፍ ቃሎችን ለማሳየት እየሞከረ ነው። ይህንን ለመፍቀድ የWindows የይለፍ ቃልዎን ይተይቡ።</translation>
<translation id="8300184335948277828">Optimium ከእንግዲህ የእርስዎ ነባሪ አሳሽ አይደለም። Optimium ነባሪውን አሳሽ ያድርጉት?</translation>
<translation id="8365648631713891786">Optimiumን ማዘመን አልተቻለም</translation>
<translation id="8944232836376404813">ይህ እርምጃ የሚከተሉትን ያደርጋል፦
          <ph name="LINE_BREAKS" />
            • የእርስዎን የመነሻ ገጽ፣ አዲስ የትር ገጽ፣ የፍለጋ ፕሮግራም እና ፒን የተደረጉ ትሮችን ዳግም ያስጀምራል
            <ph name="LINE_BREAK" />
            • ቅጥያዎችን ያሰናክላል
            <ph name="LINE_BREAK" />
            • ኩኪዎችን እና ሌሎች ጊዜያዊ የጣቢያ ውሂብን ይሰርዛል
            <ph name="LINE_BREAKS" />
            ዕልባቶች፣ ታሪክ እና የተቀመጡ የይለፍ ቃላት አይነኩም።</translation>
<translation id="4517341657960407384">የOptimium ጣቢያ አቋራጮችን አሳይ</translation>
<translation id="6334459924587075942">የOptimium Enterprise ዓርማ</translation>
<translation id="1013608620694172987">በእርስዎ <ph name="DEVICE_TYPE" /> ላይ ባለው የOptimium መተግበሪያ የGoogleን ደኅንነት በመሄድ ላይ ይውሰዱ</translation>
<translation id="6377692339934065652">መገለጫዎን ሲከፍቱ የሆነ ስሕተት ስለተከሰተ Optimiumን መጀመር አይቻልም። Optimiumን እንደገና ለማስጀመር ይሞክሩ።</translation>
<translation id="8411734418760705455">በOptimium ለመፈለግ ወይም <ph name="BEGIN_LINK" />ቅንብሮች<ph name="END_LINK" /> ውስጥ ለማበጀት</translation>
<translation id="4403836439014450645">የOptimium መገለጫዎችን ያስተዳድሩ</translation>
<translation id="7714694033208252813">በGemini በOptimium ውስጥ እና በክፍት ትርዎ መካከል ለመዳሰስ የቁልፍ ሰሌዳዎን ይጠቀሙ።</translation>
<translation id="9018218886431812662">ጭነት ተጠናቅቋል</translation>
<translation id="4028461118515168614">Optimiumን ይበልጥ ደህንነቱ የተጠበቀ እንዲሆን ለማድረግ፣ በ<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ውስጥ ያልተዘረዘረውን የሚከተለውን ቅጥያ አሰናክለነዋል እና እርስዎ ሳያውቁት የታከለ ሊሆን ይችላል።</translation>
<translation id="8853260188791570953">Optimium ውስጥ ይግቡ</translation>
<translation id="6769418925691762561">በMac የምናሌ አሞሌ ውስጥ በOptimium ፍለጋን አሳይ እና የቁልፍ ሰሌዳ አቋራጭን አብራ</translation>
<translation id="1582160730719680639">የማህደር ፋይሉ ተንኮል አዘል ዌርን ሊደብቁ የሚችሉ ሌሎች ፋይሎችን ስላካተተ Optimium ይህን ውርድ አግዶታል</translation>
<translation id="136372829312763612">የይለፍ ቃላትዎን፣ እልባቶችዎን እና ታሪክዎን በመላው መሣሪያዎችዎ ላይ በትክክል ሠምረው እንዲቆዩ ያድርጉ። ነባሪ አሳሽዎን ወደ Optimium በማዘመን በቀላሉ የሚያውቋቸውን እና የሚወዷቸውን ባህሪያት ይድረሱ። ለፈጣን መዳረሻ Optimium በተግባር አሞሌዎ ላይ ይሰካል።</translation>
<translation id="4121763951659864948">በስልክዎ ላይ የOptimium መተግበሪያን በመጠቀም የGoogleን ምርጥ የሰው ሠራሽ አስተውሎት መሣሪያዎች ይጠቀሙ</translation>
<translation id="570680773394181802">የእርስዎን የይለፍ ቃላት እና ሌሎችንም ከ<ph name="DEVICE" /> ለማግኘት ወደ Optimium ይግቡ</translation>
<translation id="9062666675513499497">ወደ ሌሎች የGoogle አገልግሎቶች ሲገቡ ወደ Chromium ይግቡ</translation>
<translation id="9074041031320636790">ተሳክቷል! አሁን በGoogle ፍለጋ ሰው ሠራሽ አስተውሎት ሁነታ እያሰሱ ሳለ ጥያቄዎችን በቀላሉ መጠየቅ ይችላሉ</translation>
<translation id="9074163480955555019">አዲስ አዶ፣ ተመሳሳይ አቋራጭ፦ Google ፍለጋ በChrome ውስጥሲያስሱ ጥያቄዎችን ለመጠየቅ ጠቅ ያድርጉ።</translation>
<translation id="516400912738056453">Optimium በራስ-ሰር ተዘግቷል</translation>
<translation id="807899198682302888">Optimium ጊዜው አልፎበታል</translation>
<translation id="4711199283523757502">{0,plural, =1{Optimium በአንድ ሰዓት ውስጥ ዳግም ይጀምራል}one{Optimium በ# ሰዓቶች ውስጥ ዳግም ይጀምራል}other{Optimium በ# ሰዓቶች ውስጥ ዳግም ይጀምራል}}</translation>
<translation id="9106236359747881194">ለመፈለግ ጽሑፍ ይምረጡ</translation>
<translation id="8368867604698561866">የወደፊት የOptimium ዝማኔዎችን ለማግኘት Windows 10 ወይም ከዚያ በላይ ያስፈልግዎታል። ይህ ኮምፒውተር Windows 8.1ን እየተጠቀመ ነው።</translation>
<translation id="4437683009835184797">አገናኙን በOptimium አዲስ &amp;ትር ውስጥ ክፈት</translation>
<translation id="911206726377975832">የአሰሳ ውሂብዎም ይሰረዝ?</translation>
<translation id="9118146721060781133">በመሣሪያ አሞሌው ላይ ያለው «ዓውዳዊ ተግባራት» አዝራር አዲስ አዶ አለው። በዓውዳዊ ተግባራት በሚያስሱበት ጊዜ ጥያቄዎችን ለመጠየቅ ጠቅ ያድርጉት።</translation>
<translation id="9134482777260927479">የቤት ሥራ እገዛ</translation>
<translation id="9148058034647219655">ውጣ</translation>
<translation id="3295815393935110309">ካቆሙበት ይቀጥሉ፦ Optimium እንደገና በጀመሩ ቁጥር የእርስዎን ትሮች ወደነበሩበት መመለስ ይችላል። ይህን ለማብራት ወደሚከተለው ይሂዱ</translation>
<translation id="5167935114017057528">የእርስዎ የስርዓት አስተዳዳሪ <ph name="TARGET_URL_HOSTNAME" />ን ለመድረስ Optimium ተለዋጭ አሳሽን እንዲከፍት አዋቅረውታል።</translation>

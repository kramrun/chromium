<translation id="7780105764415426863">ይህን ዕልባት እና ሌሎችንም በሁሉም መሣሪያዎችዎ ላይ ለማግኘት ወደ Optimium ይግቡ</translation>
<translation id="3113857336144207971">Optimiumን የእርስዎ ያድርጉ</translation>
<translation id="5960071705175224773">ቅንብሮችዎ ባልታወቀ መተግበሪያ ተለውጠዋል</translation>
<translation id="2841415208664905665">{COUNT,plural, =1{ድርጅትዎ Optimium ለ1 ደቂቃ ጥቅም ላይ ሳይውል ሲቀር በራስ ሰር ይዘጋዋል።}one{ድርጅትዎ Optimium ለ# ደቂቃ ጥቅም ላይ ሳይውል ሲቀር በራስ ሰር ይዘጋዋል።}other{ድርጅትዎ Optimium ለ# ደቂቃዎች ጥቅም ላይ ሳይውል ሲቀር በራስ ሰር ይዘጋዋል።}}</translation>
<translation id="6753703218327532561">ስምረትን ለመጀመር Optimiumን ያዘምኑ</translation>
<translation id="5990360079535151574">በመሣሪያ አሞሌው ላይ ካለው «ዓውዳዊ ተግባራት» አዝራር ላይ በሚያስሱበት ጊዜ ጥያቄዎችን ለመጠየቅ ዓውዳዊ ተግባራትን እንደገና መክፈት ይችላሉ</translation>
<translation id="6003112304606738118">በማውረድ ላይ... <ph name="HOURS" /> ሰዓት(ታት) ይቀራል(ሉ)</translation>
<translation id="6009821354356307391">ክትትል ይጠይቁ</translation>
<translation id="6040143037577758943">ዝጋ</translation>
<translation id="4546936953038997559">የOptimium መተግበሪያን በእርስዎ <ph name="DEVICE_TYPE" /> ላይ ሲጠቀሙ ከመስመር ላይ ግዢ የበለጠ ያግኙ</translation>
<translation id="6058380562449900225">ውሂብዎን ለመጠበቅ እርስዎ በቅርቡ ካልጎበኟቸው ጣቢያዎች Chromium ፈቃዶችን እንዲያስወግድ ይፍቀዱ። ማሳወቂያዎችን አያቆምም።</translation>
<translation id="9167712407654403538">በOptimium ውስጥ &amp;ክፈት</translation>
<translation id="6069027071882229820">እንደ ምስል ቅዳ</translation>
<translation id="2336867934702997612"><ph name="EXTENSION_NAME" /> ወደ Optimium ታክሏል።</translation>
<translation id="4963754686639647216">Optimiumን ያብጁትና ይቆጣጠሩት። ዝማኔ ይገኛል።</translation>
<translation id="3238331535068195595">በርቷል • Optimium ይህ ቅጥያ ከየት እንደመጣ ማረጋገጥ አይችልም</translation>
<translation id="1591882001986563343">Optimium ውስጥ ያለ መለያዎ</translation>
<translation id="9174470061972211626">ቅጥያ በOptimium የመሣሪያ አሞሌ ውስጥ የመዳረሻ ጥያቄዎችን እንዲያሳይ ፍቀድ</translation>
<translation id="6285996195476638282"><ph name="FILE_NAME" /> አደገኛ ነው፣ ስለዚህ Optimium አግዶታል።</translation>
<translation id="2722851476153659127">Optimium በቅርቡ ይዘጋል እና ውሂብ ይሰርዛል</translation>
<translation id="6855625092121599072">እዚህ በOptimium መገለጫዎች መካከል መቀያየር ይችላሉ</translation>
<translation id="615103374448673771">ኩኪዎችን ከፈቀዱ Chromium ቅድሚያ በመጫን ጊዜ ሊጠቀምባቸው ይችላል</translation>
<translation id="6165508094623778733">የበለጠ ለመረዳት</translation>
<translation id="440816316079905155">በመለያዎ ውስጥ የOptimium ውሂብን ያጽዱ</translation>
<translation id="8018999409456045233">ይህ ፋይል አደገኛ ሊሆን ይችላል<ph name="LINE_BREAK" />የይለፍ ቃሉን ካቀረቡ Optimium ይህንን ውርድ ሊፈትሽልዎ ይችላል። የፋይሉ መረጃ ወደ የGoogle ጥንቃቄ አሰሳ ይላካል፣ ነገር ግን የፋይሉ ይዘት እና የይለፍ ቃል በመሣሪያዎ ላይ ይቆያሉ።</translation>
<translation id="6182736845697986886">በዝማኔ አገልጋይ የውስጥ ስህተት ምክንያት መጫኑ አልተሳካም።</translation>
<translation id="3469021117852380318">በእርስዎ <ph name="TARGET_DEVICE_NAME" /> ላይ በመለያ ወደ Optimium መግባትዎን ያረጋግጡ እና እንደገና ለመላክ ይሞክሩ።</translation>
<translation id="2986761964667678689">Optimium ቢቀንስ እንኳን ከየትኛውም ቦታ ሆነው ይፈልጉ እና ጥያቄዎችን ይጠይቁ። Optimium በዳራ ውስጥ እንዲሄድ ይፈቅዳል።</translation>
<translation id="1244028666242035366">ይህ ኮምፒውተር አስቀድሞ ይበልጥ አዲስ የሆነ የOptimium ስሪት አለው። ሶፍትዌሩ የማይሰራ ከሆነ እባክዎ Optimiumን ያራግፉና እንደገና ይሞክሩ።</translation>
<translation id="6513480350636703580">{0,plural, =0{Optimium አሁን ዳግም ይጀመራል}=1{Optimium በ1 ሰከንድ ውስጥ ዳግም ይጀመራል}one{Optimium በ# ሰከንዶች ውስጥ ዳግም ይጀመራል}other{Optimium በ# ሰከንዶች ውስጥ ዳግም ይጀመራል}}</translation>
<translation id="3859762680410498178">Optimium ማያ ገጽዎ ጥቅም ላይ በማይውልበት ጊዜ ይዘምናል</translation>
<translation id="18853993527252772">Optimium ፋይሎችን ለማውረድ የማከማቻ መዳረሻ ፈቃድ ያስፈልገዋል</translation>
<translation id="6245734527075554892">በChromium ላይ በተከማቹ ደህንነታቸው ያልተጠበቁ ጣቢያዎች ዝርዝር ጋር ዩአርኤሎችን ይፈትሻል</translation>
<translation id="571621467627269416">Optimium ነባሪውን አሳሽ ያድርጉ።</translation>
<translation id="6248988683584659830">የፍለጋ ቅንብሮች</translation>
<translation id="4260906300317983841">በመሄድ ላይ ሳሉ በስልክዎ ላይ በOptimium መተግበሪያ የGoogleን ምርጥ የደህንነት ባህሪያት ያግኙ</translation>
<translation id="6919871734111021049">ከOptimium ተዘግቶ ይውጣ?</translation>
<translation id="8269500201917700071">እነዚህ ትሮች ተጨማሪ ንብረቶችን እየተጠቀሙ ነው። አፈፃፀምዎን ለማሻሻል Optimium እንዲያቦዝናቸው ይፍቀዱ።</translation>
<translation id="2906910751900335741">የOptimium መገለጫዎን ያብጁ</translation>
<translation id="6290827346642914212">የChromium መገለጫዎን ይሰይሙ</translation>
<translation id="6294638840436017818">በመሣሪያ አሞሌው ላይ ካለው «Google ፍለጋ ጎን ፓነል» አዝራር ላይ በሚያስሱበት ጊዜ ጥያቄዎችን ለመጠየቅ Google ፍለጋ ጎን ፓነልን እንደገና መክፈት ይችላሉ</translation>
<translation id="6612045300479871672">አንድ ቅጥያ ወደ Optimium እንዲገቡ ይፈልጋል</translation>
<translation id="2723016125417495514"><ph name="FILE_NAME" /> አደገኛ ሊሆን ስለሚችል Optimium አግዶታል።</translation>
<translation id="6308106880471005841">በመሣሪያ አሞሌው ላይ ያለው «የGoogle ፍለጋ ፓነል» አዝራር አዲስ አዶ አለው። በGoogle ፍለጋ ፓነል እያሰሱ ሳለ ጥያቄዎችን ለመጠየቅ ጠቅ ያድርጉት።</translation>
<translation id="6151952148243982653">Optimium ካሜራዎን እየተጠቀመ ነው።</translation>
<translation id="7744220780291650493">ሌላ ሥርዓተ ክወና በOptimium ላይ በሂደት ላይ ነው። እባክዎ ቆይተው እንደገና ይሞክሩ።</translation>
<translation id="4212271170228408978">አሁን Optimiumን ከGoogle መለያዎ ጋር እና በተጋሩ ኮምፒውተሮች ላይ መጠቀም ይበልጥ ቀላል ነው።</translation>
<translation id="7560359899505953564">Optimiumን እንደ ነባሪ አሳሽዎ በማቀናበር የሚያውቋቸውን፣ የሚወዷቸውን እና የሚያምኗቸውን ባህሪያት ቀላል መዳረሻ ያግኙ።</translation>
<translation id="9090225774559341003">የOptimium አቋራጭ</translation>
<translation id="6926580396655648750">ፋይሉ በተለምዶ ስላማይወርድ እና አደገኛ ሊሆን ስለሚችል Optimium ይህን ውርድ አግዷል</translation>
<translation id="8406846117825568223">እርግጠኛ ነዎት Optimiumን ማራገፍ ይፈልጋሉ?</translation>
<translation id="6375219077595103062">ለየሚስጥር ቁልፍ አስተዳዳሪ አቋራጭ ያክሉ</translation>
<translation id="6388799252195623474">በዚህ አግዘኝ</translation>
<translation id="9091694200019721003">ለመቀጠል እንደ <ph name="EMAIL" /> ወደ Optimium ይግቡ። ይህ የድርጅትዎ መመሪያዎች እንዳሉዎት ያረጋግጣል።</translation>
<translation id="3942952894185574182">በኮምፒውተር ማያ ገፅ ውስጥ የOptimium ዓርማ።</translation>
<translation id="3353682461772532321">Optimium ድረ-ገጾችን እና መተግበሪያዎችን እጅግ በጣም ፈጣን በሆነ ፍጥነት የሚያሄድ ድር አሳሽ ነው። ፈጣን፣ የረጋ እና ለመጠቀም ቀላል ነው። Optimium ውስጥ አብሮ በተሰራላቸው የተንኮል-አዘል ሶፍትዌር እና የማስገሪያ መከላከያዎች አማካኝነት ደህንነትዎ ይበልጥ በተጠበቀ ሁኔታ ድሩን ያስሱ።</translation>
<translation id="6791461984478543248">በGoogle መለያዎ ውስጥ የOptimium ውሂብን ሁልጊዜ መጠቀም እና ማስቀመጥ መቻልዎን ለማረጋገጥ እርስዎ መሆንዎን ያረጋግጡ</translation>
<translation id="6174985388495951106">Optimium ይበልጥ በፍጥነት ያሄዳል እና ጃቫስክሪፕት የሚጠቀሙ ባህሪያት እንደተነደፉት መስራት አለባቸው</translation>
<translation id="6436260184216827876">የምስል ፍለጋ አይገኝም። ቆይተው እንደገና ይሞክሩ።</translation>
<translation id="6442900851116057561">ChromiumOSን ዳግም አስጀምር</translation>
<translation id="6443470774889161065">እርስዎ የመጎብኘት ዕድልዎ ከፍተኛ የሆኑባቸው ተጨማሪ ገጾች ሲጎበኟቸው ይበልጥ በፍጥነት እንዲጫኑ Chromium በቅድሚያ ይጭናቸዋል</translation>
<translation id="2102210363398612557">ዋጋዎችን ለመከታተል እና ዋጋው በማንኛውም ጣቢያ ላይ ሲቀንስ ማንቂያዎችን ለማግኘት Optimiumን በስልክዎ ላይ ያውርዱ</translation>
<translation id="6598227122144472874">ጠፍቷል • Optimium ይህ ቅጥያ ከየት እንደመጣ ማረጋገጥ አይችልም</translation>
<translation id="3895850825918446737">ወደ Optimium መገለጫዎች እንኳን በደህና መጡ</translation>
<translation id="3239105679122868308">በሚቀጥለው ጊዜ Optimiumን በእርስዎ <ph name="DEVICE_TYPE" /> ላይ ሲከፍቱ፣ የትር ቡድኖችን ለመጠቀም ጥያቄ ያያሉ።</translation>
<translation id="5440394152628202500">መለያን ከOptimium አስወግድ</translation>
<translation id="5673289019038024720">እንዲሁም Optimiumን ሲጀምሩት የሚታየውን ገፅ ይቆጣጠራል።</translation>
<translation id="648319183876919572">የተሻሻለ የደህንነት አሰሳ እርስዎን ከአደገኛ ድር ጣቢያዎች እና ውርዶች ለመጠበቅ ይበልጥ ያደርጋል</translation>
<translation id="3922692586556595624">Optimiumን ያራግፉ</translation>
<translation id="5977471146123132488">አቋራጮች በOptimium ውስጥ ይከፍታሉ</translation>
<translation id="1873460655129342919">ድርጅትዎ Optimium ለ<ph name="TIMEOUT_DURATION" /> ያህል ሥራ ላይ ሳይውል ይዘጋዋል። የአሰሳ ውሂብ ተሰርዟል። ይህ ታሪክን፣ ራስ-ሙላን እና ውርዶችን ሊያካትት ይችላል።</translation>
<translation id="139284349466910875">እያንዳንዱ መገለጫ እንደ ዕልባቶች፣ ታሪክ፣ የይለፍ ቃላት እና ሌሎችም ያሉ የራሱ የOptimium መረጃዎችን ይይዛል</translation>
<translation id="6556755379298048869">በቁልፍ ሰሌዳ አቋራጭ ይፈልጉ።</translation>
<translation id="6563921047760808519"><ph name="BEGIN_LINK" />Chromium እንዴት የእርስዎን ውሂብ በግል እንደሚያስቀምጥ<ph name="END_LINK" /> የበለጠ ይወቁ</translation>
<translation id="562266251854740285">አንዴ Optimium እንደገና ከጀመረ በኋላ በዚህ ቅንብር ላይ ያሉ ለውጦች ይተገበራሉ።</translation>
<translation id="965740992595240282">በOptimium ዋና ምናሌ ውስጥ ቅጥያዎች የሚለውን ጠቅ በማድረግ ቅጥያዎችዎን ያስተዳድሩ።</translation>
<translation id="2549448919385330625">ከሌላ የOptimium መገለጫ የይለፍ ቃላትን ለማየት መቀየር ይችላሉ</translation>
<translation id="2662027419736610653">በመሄድ ላይ ሳሉ ምርጥ የሰው ሠራሽ አስተውሎት መሣሪያዎችን ለመውሰድ የOptimium መተግበሪያን ይጠቀሙ</translation>
<translation id="6570579332384693436">የሥርዓተ ፊደል አጻጻፍ ስህተቶችን ለማስተካከል፣ Chromium እርስዎ በጽሁፍ መስኮች ውስጥ የሚተይቡትን ጽሁፍ ወደ Google ይልካል</translation>
<translation id="8346408025829878332">ወደ የOptimium ማሳወቂያ ቅንብሮች ይሂዱ</translation>
<translation id="6600016381025017075">በዚህ ገጽ ላይ ማንኛውንም ነገር ይፈልጉ</translation>
<translation id="5149981246269331326">ለውጦችዎ Optimium በሚያስጀምሩበት ቀጣዩ ጊዜ ላይ ይተገበራሉ።</translation>
<translation id="1163143914216098175">አሁን ላይ Windows ሲጀምር Optimium ይጀመራል ስለዚህ እርስዎ በቅጽበት ማሰስ መጀመር ይችላሉ። ይህን በቅንብሮች ውስጥ ማጥፋት ይችላሉ።</translation>
<translation id="7839895033810030903">ካቆሙበት ይቀጥሉ፦ Optimium የእርስዎን ትሮች ከመጨረሻው ክፍለ ጊዜዎ ወደነበሩበት ይመልሳል። ይህን የሚከተለው ውስጥ ማጥፋት ይችላሉ</translation>
<translation id="8919724422686713691">Optimium የዙሪያዎን የ3ል ካርታ ለመፍጠር የካሜራ ፈቃድ ያስፈልገዋል</translation>
<translation id="6669284030132180248">እንዲሁም ዕልባቶችዎን በእርስዎ Google መለያ ውስጥ ካስቀመጡ Chromium ውስጥ የምርት ዋጋዎችን መከታተል እና ዋጋው ሲቀንስ ማሳወቂያ ማግኘት ይችላሉ</translation>
<translation id="6676384891291319759">በይነመረብን ተዳረስ</translation>
<translation id="668175097507315160">በመለያ ሲገባ በነበረ ስህተት ምክንያት &amp;ChromiumOS ውሂብዎን ማስመር አልቻለም።</translation>
<translation id="2337492685922399200">የዚህን መተግበሪያ ውሂብ ከOptimium ላይ ያስወግዱ</translation>
<translation id="7200198227335381561">Optimium ለዚህ ጣቢያ የማይክሮፎን ፈቃድ ያስፈልገዋል</translation>
<translation id="6712881677154121168">የማውረድ ስህተት፦ <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="358599119501177356">መገለጫዎ ከአዲስ የOptimium ስሪት ስለሆነ የመጣው ሥራ ላይ ሊውል አይችልም።

አንዳንድ ባህሪያት ላይገኙ ይችላሉ። እባክዎ የተለየ የመገለጫ አቃፊ ይግለጹ ወይም ይበልጥ አዲስ የሆነ የOptimium ስሪት ይጠቀሙ።</translation>
<translation id="6729124504294600478">ግላዊነት ማላበስን እና ሌሎች ባህሪያትን ለማግኘት Chromiumን በድር እና በመተግበሪያ እንቅስቃሴ እና በተገናኙ የGoogle አገልግሎቶች ውስጥ ያካትቱ</translation>
<translation id="196085196242095682">Optimium ለሁሉም በእርስዎ ኮምፒውተር ላይ ላሉ ተጠቃሚዎች አስቀድሞ ተጭኗል።</translation>
<translation id="8573534493546068455">የእርስዎን ዕልባቶች እና ሌሎችንም በሁሉም መሣሪያዎችዎ ላይ ለማግኘት ወደ Optimium ይግቡ በመለያ ከገቡ በኋላ ይህ ዕልባት Google መለያዎ ውስጥ ይቀመጣል።</translation>
<translation id="674891594898436429">በዚህ ትር ውስጥ ገቢር ፍለጋን አሰናብት</translation>
<translation id="87486021868820245">በOptimium V8 ሞተር ጣቢያዎችን ያፋጥናል ነገር ግን የOptimiumን ጥቃቶችን የመቋቋም አቅም በመጠኑ ያነሰ ያደርገዋል። ይህ ቅንብር በርቷል።</translation>
<translation id="474617559993879524">{count,plural, =1{የተወሰነ የOptimium ውሂብዎ በGoogle መለያዎ ውስጥ ገና አልተቀመጠም። ዘግተው ከመውጣትዎ በፊት ጥቂት ደቂቃዎች ለመጠበቅ ይሞክሩ። አሁን ዘግተው ከወጡ ይህ ውሂብ (1 ንጥል) ይሰረዛል።}one{የተወሰነ የOptimium ውሂብዎ በGoogle መለያዎ ውስጥ ገና አልተቀመጠም። ዘግተው ከመውጣትዎ በፊት ጥቂት ደቂቃዎች ለመጠበቅ ይሞክሩ። አሁን ዘግተው ከወጡ ይህ ውሂብ ({count} ንጥል) ይሰረዛል።}other{የተወሰነ የOptimium ውሂብዎ በGoogle መለያዎ ውስጥ ገና አልተቀመጠም። ዘግተው ከመውጣትዎ በፊት ጥቂት ደቂቃዎች ለመጠበቅ ይሞክሩ። አሁን ዘግተው ከወጡ ይህ ውሂብ ({count} ንጥሎች) ይሰረዛል።}}</translation>
<translation id="1681402107856523620">Optimium ይህ ፋይል አደገኛ ሊሆን ስለሚችል እንዲቃኙት ይመክራል።</translation>

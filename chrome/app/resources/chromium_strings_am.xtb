<translation id="259935314519650377">የወረደውን ጫኝ መሸጎጥ አልተሳካም። ስህተት፦ <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">ስርዓት</translation>
<translation id="7753906894780562903">ድርጅትዎ እንደ የእርስዎ እልባቶች፣ ታሪክ እና የይለፍ ቃሎች ያለ የአሰሳ ውሂብን ማየት እና ማስተዳደር ይችላል። በሌሎች Optimium መገለጫዎች ውስጥ የአሰሳ ውሂብን ማየት አይችልም</translation>
<translation id="3912526786507084695">በእርስዎ መለያ <ph name="ACCOUNT_EMAIL" /> ውስጥ Optimium ውሂብን ለመጠቀም እና ለማስቀመጥ እርስዎ መሆንዎን ያረጋግጡ</translation>
<translation id="1723346026518998062">{COUNT,plural, =0{የላቀ ጥበቃ ዝማኔ ለመተግበር Optimiumን ዳግም እንዲያስጀምሩ ይጠይቃል}=1{የላቀ ጥበቃ ዝማኔ ለመተግበር Optimiumን ዳግም እንዲያስጀምሩ ይጠይቃል። የእርስዎ ማንነትን የማያሳውቅ መስኮት እንደገና አይከፈትም።}one{የላቀ ጥበቃ ዝማኔ ለመተግበር Optimiumን ዳግም እንዲያስጀምሩ ይጠይቃል። የእርስዎ # ማንነትን የማያሳውቅ መስኮት እንደገና አይከፈትም።}other{የላቀ ጥበቃ ዝማኔ ለመተግበር Optimiumን ዳግም እንዲያስጀምሩ ይጠይቃል። የእርስዎ # ማንነትን የማያሳውቁ መስኮቶች እንደገና አይከፈቱም።}}</translation>
<translation id="1676939910504260523">Optimiumን ጀምር</translation>
<translation id="4524556064279918264">በጭነት ጊዜ የስርዓተ ክወና ስህተት ተፈጥሯል። እባክዎ Optimiumን እንደገና ያውርዱት።</translation>
<translation id="1998551382060432430">መሣሪያ የሚያጋሩ ከሆኑ ጓደኛዎች እና ቤተሰብ ተለይተው ሊያስሱ እና Optimiumን በሚፈልጉበት መንገድ ማዋቀር ይችላሉ</translation>
<translation id="5180414833025415316">Optimium አንሶ ሳለ እንኳን በመላው መሣሪያዎ ላይ Gemini በOptimium ውስጥ ለመጠቀም ቀላል መዳረሻ።</translation>
<translation id="5895170254499246640">የOptimium ትር</translation>
<translation id="2718390899429598676">ለተጨማሪ ደህንነት ሲባል Chromium ውሂብዎን ያመሰጥረዋል።</translation>
<translation id="6684098000857849465">የGoogle መለያዎን ከOptimium ለማስወገድ ዘግተው ይውጡ</translation>
<translation id="8035579362848370000">የእርስዎን የይለፍ ቃላት፣ ዕልባቶች እና ሌሎችንም በሁሉም መሣሪያዎችዎ ላይ ለማግኘት ወደ Optimium ይግቡ</translation>
<translation id="2738871930057338499">ከበይነመረብ ጋር መገናኘት አልተቻለም። ኤችቲቲፒኤስ 403 ተከልክሏል። እባክዎ ተኪ ውቅረትዎን ይፈትሹ።</translation>
<translation id="2753623023919742414">ለመፈለግ ጠቅ ያድርጉ</translation>
<translation id="6013736131971103780">Optimiumን እንደ ነባሪ ፒዲኤፍ መመልከቻዎ ያቀናብሩ</translation>
<translation id="218391145495840504">ይህ ቅጥያ ተንኮል አዘል ዌርን ይዟል እና ደህንነቱ የተጠበቀ አይደለም። የግል መረጃዎን ጨምሮ ከእንግዲህ እርስዎ በሚጎበኟቸው ጣቢያዎች ላይ ያለዎን ውሂብ ማየት እና መለወጥ እንዳይችል ከOptimium ያስወግዱት።</translation>
<translation id="2799223571221894425">ዳግም አስጀምር</translation>
<translation id="8757776333711121842">የእርስዎ Optimium</translation>
<translation id="2816462166102338036">ይህን ቪድዮ በምስል ፍለጋ ይፈልጉ</translation>
<translation id="5977650568712460613">በካሜራዎ ምርቶችን ያግኙ፣ የዋጋ ቅነሳዎችን ይከታተሉ እና በiOS ላይ በOptimium በመሄድ ላይ ሳሉ ሌሎችንም ያድርጉ።</translation>
<translation id="2841525013647267359">ተርጉም ከ</translation>
<translation id="2846251086934905009">የጭነት ስህተት፦ ጫኚው አልተጠናቀቀም። ጭነቱ ተቋርጧል።</translation>
<translation id="7445294455857704594">ከOptimium አስወግድ...</translation>
<translation id="2850691299438350830">በChromium ላይ ደህንነትዎን ይጠብቃል እና በመለያ በገቡባቸው ሌሎች የGoogle መተግበሪያዎች ላይ ደህንነትዎን ለማሻሻል ሥራ ላይ ሊውል ይችላል።</translation>
<translation id="2876152561415416331">የGoogle ፍለጋ ፓነልን እንደገና ክፈት</translation>
<translation id="2885378588091291677">ተግባር መሪ</translation>
<translation id="8130920144001221645">ስለ &amp;Optimium</translation>
<translation id="2915996080311180594">በኋላ ዳግም አስነሳ</translation>
<translation id="5422843128705358539">የእርስዎ ውሂብ በእርስዎ የይለፍ ሐረግ የተመሰጠረ ነው። የOptimium ውሂብን በGoogle መለያዎ ውስጥ ለመጠቀም እና ለማስቀመጥ እሱን ያስገቡ።</translation>
<translation id="2945997411976714835">የጭነት ስህተት፦ የጫኙ ሂደት መጀመር አልተሳካም።</translation>
<translation id="7644909281692978299">የተቀመጡ የይለፍ ቃላት ለOptimium በiOS ላይ በመጠቀም ወደ ጣቢያዎች ይበልጥ በፍጥነት ይግቡ</translation>
<translation id="6715328262141930431">የእርስዎ ድርጅቶች Optimiumን ያስተዳድራሉ</translation>
<translation id="2977470724722393594">Chromium የተዘመነ ነው</translation>
<translation id="2977506796191543575">አንድ ጣቢያ የእርስዎን የይለፍ ቃል ለመስረቅ ከሞከረ ወይም ጎጂ ፋይል ሲያወርዱ Chromium እንዲሁም የገጽ ይዘት ቢትስንም ጨምሮ ዩአርኤሎችን ወደ የጥንቃቄ አሰሳ ሊልክ ይችላል</translation>
<translation id="3373190939774209520">በወላጆችዎ ምርጫዎች ደህንነትዎ የበለጠ ተጠብቆ ለመቆየት ወደ Optimium በመለያ ይግቡ</translation>
<translation id="2992577225802060159">በኮምፒውተርዎ ላይ ካሉ ሌሎች መተግበሪያዎች የChromium ማህደረ ትውስታን ይጠብቃል።</translation>
<translation id="3003694935412297923">ሁሉም ተግባሮች</translation>
<translation id="2169110625780321257">{count,plural, =1{የተወሰነ ውሂብ በGoogle መለያዎ ውስጥ መቀመጥ እና በሁሉም መሣሪያዎችዎ ላይ ጥቅም ላይ መዋል ከመቻሉ በፊት Optimium እርስዎ መሆንዎን ማረጋገጥ አለበት። አሁን ዘግተው ከወጡ ይህ ውሂብ (1 ንጥል) ይሰረዛል።}one{የተወሰነ ውሂብ በGoogle መለያዎ ውስጥ መቀመጥ እና በሁሉም መሣሪያዎችዎ ላይ ጥቅም ላይ መዋል ከመቻሉ በፊት Optimium እርስዎ መሆንዎን ማረጋገጥ አለበት። አሁን ዘግተው ከወጡ ይህ ውሂብ ({count} ንጥል) ይሰረዛል።}other{የተወሰነ ውሂብ በGoogle መለያዎ ውስጥ መቀመጥ እና በሁሉም መሣሪያዎችዎ ላይ ጥቅም ላይ መዋል ከመቻሉ በፊት Optimium እርስዎ መሆንዎን ማረጋገጥ አለበት። አሁን ዘግተው ከወጡ ይህ ውሂብ ({count} ንጥሎች) ይሰረዛል።}}</translation>
<translation id="535155819036938485"><ph name="URL" />ን በOptimium ውስጥ በአዲስ ትር ይክፈቱ።</translation>
<translation id="302551344979399011">እንደ ክህሎቶች ያሉ የሰው ሠራሽ አስተውሎት ፈጠራዎች ወደ Google መለያዎ ይቀመጣሉ እና ከChromium ሥምረት በተለየ መልኩ ይተዳደራሉ</translation>
<translation id="69529237724150463">በሁሉም መሣሪያዎችዎ ላይ የእርስዎን ቅጥያዎች እና ሌሎችንም ለማግኘት ወደ Optimium ይግቡ</translation>

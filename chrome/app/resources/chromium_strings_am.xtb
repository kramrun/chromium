<translation id="1565712261560212491">በስልክዎ ላይ በተሻሻለ የደህንነት አሰሳን በOptimium ያራዝሙ</translation>
<translation id="7003115800241574875">Optimiumን የእርስዎ በማድረግ ላይ...</translation>
<translation id="3474745554856756813">ይሄ <ph name="ITEMS_COUNT" /> ንጥሎችን ከዚህ መሣሪያ ይሰርዛል። ውሂብዎን በኋላ ላይ ሰርስረው ለማውጣት እንደ <ph name="USER_EMAIL" /> ሆነው ወደ Chromium ይግቡ።</translation>
<translation id="1749327805708308979"><ph name="SHORTCUT" /> በOptimium መገለጫዎች መካከል መቀያየር ይችላል</translation>
<translation id="7437253251955408447">እባክዎ ሁሉንም የOptimium መስኮቶችን ይዝጉና እንደገና ይሞክሩ።</translation>
<translation id="4544226979083343619">መስኮትዎን ለማጋራት በሥርዓት ቅንብሮች ውስጥ ለOptimium የማያ ገፅ መቅረጽን ይፍቀዱ</translation>
<translation id="7742324910239513884"><ph name="EXISTING_USER" /> አስቀድመው ገብተዋል።  አሰሳዎን ለያይተው ለመጠቀም በራስዎ መገለጫ ውስጥ እንደ <ph name="USER_EMAIL_ADDRESS" /> ሆነው ወደ Optimium ይግቡ።</translation>
<translation id="8618656037793872415">Optimium አሳሽን በተንቀሳቃሽ መሣሪያዎች ላይ ለማውረድ QR ኮድ</translation>
<translation id="354621070532799440">አስታዋሽ፦ የGoogle ምርጥ የደኅንነት ባህሪያት በኪስዎ ውስጥ</translation>
<translation id="3043015282185018117">ማያ ገፅዎን ለማጋራት በሥርዓት ቅንብሮች ውስጥ ለOptimium የማያ ገፅ መቅረጽን ይፍቀዱ።</translation>
<translation id="3597003331831379823">በላቁ ልዩ መብቶች ማዋቀርን ማስሄድ አልተሳካም። <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3261842649996827269">Optimium ውስጥ ይግቡ</translation>
<translation id="1140403329282632523">ይህ ሰው የአሰሳ ውሂብ ከዚህ መሣሪያ ይሰረዛል። ውሂቡን መልሶ ለማግኘት እንደ <ph name="USER_EMAIL" /> ሆነው ወደ Optimium ይግቡ።</translation>
<translation id="5228011645297638039">{COUNT,plural, =0{አዲስ ዝማኔ ለOptimium የሚገኝ ሲሆን ልክ ዳግም ሲያስጀምሩት ይተገበራል።}=1{አዲስ ዝማኔ ለOptimium የሚገኝ ሲሆን ልክ ዳግም ሲያስጀምሩት ይተገበራል። የእርስዎ ማንነት የማያሳውቅ መስኮት ዳግም አይከፈትም}one{አዲስ ዝማኔ ለOptimium የሚገኝ ሲሆን ልክ ዳግም ሲያስጀምሩት ይተገበራል። የእርስዎ # ማንነት የማያሳውቁ መስኮቶች ዳግም አይከፈቱም}other{አዲስ ዝማኔ ለOptimium የሚገኝ ሲሆን ልክ ዳግም ሲያስጀምሩት ይተገበራል። የእርስዎ # ማንነት የማያሳውቁ መስኮቶች ዳግም አይከፈቱም}}</translation>
<translation id="3667616615096815454">መጫን አልተቻለም፣ አገልጋዩ መተግበሪያውን አያውቀውም።</translation>
<translation id="3675854891107786059">በGoogle መለያዎ ውስጥ ያሉትን ሁሉንም የChromium ውሂብ ለማመስጠር <ph name="BEGIN_LINK" />የራስዎን የይለፍ ሐረግ<ph name="END_LINK" /> ይጠቀሙ። የGoogle Pay የመክፈያ ዘዴዎች እና አድራሻዎች አይመሰጠሩም። የChromium የአሰሳ ታሪክ አይሰምርም።</translation>
<translation id="7861068783030138988">{COUNT,plural, =0{ይህን ዝማኔ ለመተግበር አስተዳዳሪዎ Optimiumን ዳግም እንዲያስጀምሩት ይጠይቀዎታል}=1{ይህን ዝማኔ ለመተግበር አስተዳዳሪዎ Optimiumን ዳግም እንዲያስጀምሩት ይጠይቀዎታል የእርስዎ ማንነት የማያሳውቅ መስኮት ዳግም አይከፈትም}one{ይህን ዝማኔ ለመተግበር አስተዳዳሪዎ Optimiumን ዳግም እንዲያስጀምሩት ይጠይቀዎታል የእርስዎ # ማንነት የማያሳውቁ መስኮቶች ዳግም አይከፈቱም}other{ይህን ዝማኔ ለመተግበር አስተዳዳሪዎ Optimiumን ዳግም እንዲያስጀምሩት ይጠይቀዎታል የእርስዎ # ማንነት የማያሳውቁ መስኮቶች ዳግም አይከፈቱም}}</translation>
<translation id="8611928240945733486">አገናኙን በOptimium አዲስ &amp;ትር ውስጥ ክፈት</translation>
<translation id="3728124580182886854">Chromiumን እና ሌሎች የGoogle አገልግሎቶችን ግላዊነት ለማላበስ እና ለሌሎች ዓላማዎች ያገናኟቸው</translation>
<translation id="3729187154190517324">«ትር እና ሌሎችም አክል» የሚለውን አዝራር በመጠቀም ብዙ ትሮችን፣ ፋይሎችን እና መሣሪያዎችን በማከል ፍለጋዎን ያጥልቁ።</translation>
<translation id="3032577647176321971">የOptimium መገለጫዎችን ያስተዳድሩ</translation>
<translation id="6314444399103340747">ለምን Optimium የተወሰኑ ውርዶችን እንዳገደ ይወቁ</translation>
<translation id="379589255253486813">ማንኛውም ነገር ግምገማ ካስፈለገው Chromium ያሳውቅዎታል</translation>
<translation id="3802055581630249637">እርስዎ የመጎብኘት ዕድልዎ ከፍተኛ የሆኑባቸው ገፆች ሲጎበኟቸው ይበልጥ በፍጥነት እንዲጫኑ Chromium በቅድሚያ ይጭናቸዋል</translation>
<translation id="3810973564298564668">አደራጅ</translation>
<translation id="4301680230606686279">የተቀመጡ የይለፍ ቃላትዎን ለመጠቀም፣ QR ኮዱን ይከተሉ፣ Optimium ለiOS ያውርዱ እና ወደ Google መለያዎ ይግቡ</translation>
<translation id="3846683726093018685">**አጠቃልል፦** በአንድ ዓረፍተ ነገር ውስጥ ከ30 ባነሱ ቃላት የይዘቱን ዋና ርዕሰ ጉዳይ እና ዓላማ በቅጽበታዊ ገጽ እይታ ውስጥ ግለጽ።

          **ጥያቄዎችን ጠቁም፦** ቅጽበታዊ ገጽ እይታውን በተሻለ ለመረዳት ተጠቃሚው ሊጠይቃቸው የሚችላቸው 3-5 ሀሳብ አመንጪ ጥያቄዎች ነጥበ ምልክት ዝርዝርን አመንጭ። እነዚህ ጥያቄዎች በተለይ ስለ ምስላዊ ነገር፣ ስለ ንድፉ ወይም ስለ አቀማመጡ የሚመለከት ቢያንስ አንዱን ማካተት አለባቸው።</translation>
<translation id="3287167856630539345"><ph name="PAGE_TITLE" /> - Optimium</translation>
<translation id="3117512156333858342">በሁሉም መሣሪያዎችዎ ላይ የእርስዎን ዕልባቶች እና ሌሎችንም ለማግኘት ወደ Optimium ይግቡ</translation>
<translation id="3511883131632987404">{COUNT,plural, =1{ይህን ዝማኔ ለመተግበር አስተዳዳሪዎ Optimiumን ዳግም እንዲያስጀምሩት ይጠይቅዎታል። የእርስዎ የተለየ መስኮት ዳግም አይከፈትም።}one{ይህን ዝማኔ ለመተግበር አስተዳዳሪዎ Optimiumን ዳግም እንዲያስጀምሩት ይጠይቀዎታል። የእርስዎ # የተለየ መስኮት እንደገና አይከፈትም።}other{ይህን ዝማኔ ለመተግበር አስተዳዳሪዎ Optimiumን ዳግም እንዲያስጀምሩት ይጠይቀዎታል። የእርስዎ # የተለዩ መስኮቶች እንደገና አይከፈቱም።}}</translation>
<translation id="3885770153807205175">ቋንቋ መራጭ</translation>
<translation id="7294070483192043494">Optimiumን ያብጁ እና ይቆጣጠሩ። የሆነ ነገር ትኩረትዎ ያስፈልገዋል - ለዝርዝሮች ጠቅ ያድርጉ።</translation>
<translation id="7920927747111819647">Optimiumን ለመክፈት እና ማሰስ ለመጀመር ስምዎን ጠቅ ያድርጉት።</translation>
<translation id="3892148308691398805">ጽሁፍ ቅዳ</translation>
<translation id="4454986649289930182"><ph name="EXISTING_USER" /> አስቀድመው ወደዚህ የOptimium መገለጫ ገብተዋል። አሰሳዎን የተለየ እንደሆነ ለማቆየት Optimium የራስዎን መገለጫ ለእርስዎ መፍጠር ይችላል።</translation>
<translation id="7225128703667880746">ይህ ቅጥያ የChrome የድር መደብር መመሪያን ይጥሳል እና ደህንነቱ ያልተጠበቀ ሊሆን ይችላል። የግል መረጃዎን ጨምሮ ከእንግዲህ እርስዎ በሚጎበኟቸው ጣቢያዎች ላይ ያለዎን ውሂብ ማየት እና መለወጥ እንዳይችል ከOptimium ያስወግዱት።</translation>
<translation id="3941890832296813527">የጭነት ስህተት፦ የጫኙ የፋይል ስም ልክ ያልሆነ ወይም የማይደገፍ ነው።</translation>
<translation id="6304622602441037994">Optimium የይለፍ ቃላትን ለመቅዳት እየሞከረ ነው። ይህንን ለመፍቀድ የWindows የይለፍ ቃልዎን ይተይቡ።</translation>
<translation id="2274695480528598968">በሁሉም መሣሪያዎችዎ ላይ የእርስዎን የተቀመጠ መረጃ እና ሌሎችንም ለማግኘት ወደ Optimium ይግቡ</translation>
<translation id="1713567483777335359">የእርስዎ የይለፍ ቃላቶች፣ የመክፈያ ዘዴዎች እና በGoogle መለያዎ ውስጥ ያስቀመጧቸው አድራሻዎች ከዚህ መሣሪያ ይወገዳሉ። እንደገና Optimium ውስጥ እነሱን ለመጠቀም መልሰው በመለያ ይግቡ።</translation>
<translation id="395904275706073188">የተጠብቁ ገፆች ሊነበቡ አይችሉም። የተለተ ገፅ ይሞክሩ።</translation>
<translation id="3962647064319009959">Chromium እንዴት ደህንነትዎን እንደሚጠብቅ ይወቁ</translation>
<translation id="3967822245660637423">ማውረድ ተጠናቅቋል</translation>
<translation id="3971865010372729242">የአድራሻ አሞሌው ወይም የፍለጋ ሳጥኑ ውስጥ ሲተይቡ ወይም መታ ሲያደርጉ Chromium ጥቆማዎችን ለማግኘት ወደ ድርጅትዎ ፍለጋ፣ ሰው ሠራሽ አስተውሎት እና ወኪል መሣሪያዎች ውስጥ የሚተይቡትን ነገር ይልካል።</translation>
<translation id="3975724895399328945">ስለ Google Chrome ለሙከራ</translation>
<translation id="3984557288004650913">በመሣሪያ አሞሌው ላይ ካለው «Google ፍለጋ በChrome ውስጥ» አዝራር ላይ በሚያስሱበት ጊዜ ጥያቄዎችን ለመጠየቅ Google ፍለጋ በChrome ውስጥን እንደገና መክፈት ይችላሉ</translation>
<translation id="3997429360543082038">ስለChromiumOS</translation>
<translation id="4016217212818346953">በሚስጥር ቁልፍ አስተዳዳሪ ደኅንነትዎን ይጠብቁ</translation>
<translation id="4019629340646866719">ChromiumOS እና <ph name="BEGIN_LINK_LINUX_OSS" />የLinux ግንባታ ምህዳር<ph name="END_LINK_LINUX_OSS" /> ሊሠሩ የቻሉት በተጨማሪ <ph name="BEGIN_LINK_CROS_OSS" />የክፍት ምንጭ ሶፍትዌር<ph name="END_LINK_CROS_OSS" /> ነው።</translation>
<translation id="4022972681110646219">ማያ ገፁን ተርጉም</translation>
<translation id="4023601594785368013">የመጀመሪያው ቋንቋ፦ <ph name="LANGUAGE" /></translation>
<translation id="8098054594752731054">ከማንኛውም መተግበሪያ ላይ አገናኞችን Optimium ውስጥ ይከፍታል። በተጨማሪም፣ ለቀላል መዳረሻ የተግባር አሞሌዎ ላይ ፒን ይደረጋል።</translation>
<translation id="4036079820698952681"><ph name="BEGIN_LINK" />የአሁኖቹን ቅንብሮች<ph name="END_LINK" /> ሪፖርት በማድረግ Chromium የተሻለ እንዲሆን ያግዙ</translation>
<translation id="4050175100176540509">አስፈላጊ የደህንነት ማሻሻያዎች እና አዲስ ባህሪያት በቅርብ ጊዜው ስሪቱ ላይ ይገኛሉ።</translation>
<translation id="4055805654398742145">የይለፍ ቃል አስተዳዳሪ</translation>
<translation id="3150466418323356831">{COUNT,plural, =1{ድርጅትዎ Optimium ለ1 ደቂቃ ጥቅም ላይ ሳይውል ሲቀር በራስ ሰር ይዘጋዋል። የአሰሳ ውሂብ ተሰርዟል። ይህ ታሪክን፣ ራስ-ሙላን እና ውርዶችን ሊያካትት ይችላል።}one{ድርጅትዎ Optimium ለ# ደቂቃ ጥቅም ላይ ሳይውል ሲቀር በራስ ሰር ይዘጋዋል። የአሰሳ ውሂብ ተሰርዟል። ይህ ታሪክን፣ ራስ-ሙላን እና ውርዶችን ሊያካትት ይችላል።}other{ድርጅትዎ Optimium ለ# ደቂቃዎች ጥቅም ላይ ሳይውል ሲቀር በራስ ሰር ይዘጋዋል። የአሰሳ ውሂብ ተሰርዟል። ይህ ታሪክን፣ ራስ-ሙላን እና ውርዶችን ሊያካትት ይችላል።}}</translation>
<translation id="4118474109249235144">Chromium ማንነት የማያሳውቅ</translation>
<translation id="4122186850977583290">ወደ ስለChromium ገጽ ይሂዱ</translation>
<translation id="5040058062446726786">ለአሳሸዎ አዲስ መልክ ለመስጠት Chromeን ያብጁ</translation>
<translation id="3417230552019009112">የእርስዎን Optimium ያብጁ</translation>
<translation id="4148957013307229264">በመጫን ላይ...</translation>
<translation id="8036654966821129512">ደኅንነትዎ እንደተጠበቀ ለመቆየት Optimiumን ያዘምኑ</translation>
<translation id="113287843321846936"><ph name="PAGE_TITLE" /> - በአውታረ መረብ ወደ መለያ መግባት - Optimium</translation>
<translation id="101945827160630872"><ph name="EXISTING_USER" /> አስቀድመው ገብተዋል። አሰሳዎን ለያይተው ለማቆየት በራስዎ መገለጫ ውስጥ እንደ <ph name="USER_EMAIL_ADDRESS" /> ሆነው ወደ Optimium ይግቡ። እንዲሁም በሁሉም መሣሪያዎችዎ ላይ የንባብ ዝርዝርዎን እና ሌሎችንም ያገኛሉ።</translation>
<translation id="5914158797921975103">ለOptimium ምርጥ መተግበሪያዎችን፣ ጨዋታዎችን፣ ቅጥያዎችን እና ገጽታዎችን ያግኙ።</translation>
<translation id="7188357620681202939">በሁሉም ኮምፒውተርዎችዎ ላይ ይህን ቅጥያ እና ተጨማሪ ለማግኘት ወደ Optimium ይግቡ</translation>
<translation id="1889725122457669356">በወላጅዎ ምርጫ መስመር ላይ የበለጠ ደህንነቱ የተጠበቀ ሆኖ ለመቆየት፣ አስቀድመው እንደ <ph name="USER_EMAIL_ADDRESS" /> ወደ ገቡበት የOptimium መገለጫ ይቀይሩ</translation>
<translation id="4222932583846282852">በመሰረዝ ላይ...</translation>
<translation id="4224210481850767180">ጭነቱ ተሰርዟል።</translation>
<translation id="3467085712950617325">የOptimium ውሂዎ ከዚህ መለያ ጋር ይገናኝ?</translation>
<translation id="4251772536351901305">ከመደበኛ ጥበቃ በላይ ተጨማሪ ውሂብ ከጣቢያዎች ትንታኔ በመስጠት Google እንኳን በፊት ስላላወቃቸው አደገኛ ጣቢያዎች ያስጠነቅቅዎታል። የChromium ማስጠንቀቂያዎችን ለመዝለል መምረጥ ይችላሉ።</translation>
<translation id="2140865310399147834">ከOptimium ዘግተህ ውጣ</translation>
<translation id="4271805377592243930">Chromium ላይ እገዛ ያግኙ</translation>
<translation id="4275788652681621337">የጎን ፓነልን ዝጋ</translation>
<translation id="4281844954008187215">የአግልግሎት ውል</translation>
<translation id="3179093133057739293">ተለይቶ ባልታወቀ ስህተት ምክንያት ጭነት ከሽፏል። Optimium አሁን እያሄደ ከሆነ እባክዎ ይዝጉትና እንደገና ይሞክሩ።</translation>
<translation id="5932936993463393384">የይለፍ ቃላትን ከOptimium ወደ ውጪ ይላኩ</translation>
<translation id="4304713468139749426">የይለፍ ቃል አስተዳዳሪ</translation>
<translation id="4334241893986177674">ይህን ቅጽበታዊ ገጽ እይታ ይፈልጉ</translation>
<translation id="109990079583792895">Windows ሲጀምር Optimiumን አስጀምር</translation>
<translation id="4400772909124543403">ምንም ዝማኔ አይገኝም</translation>
<translation id="4669117187454638908">የሆነው ሆኖ ከOptimium ይወጣ?</translation>
<translation id="4413205837991854510">የምስል ፍለጋ አቋራጭን ሁልጊዜ አሳይ</translation>
<translation id="1696050014109987987">Optimium በበስተጀርባ ላይ ያሂድ</translation>
<translation id="7368827027253482667">{NUM_EXTENSIONS,plural, =1{Optimium እንዲያስወግዱት ይመክራል። <ph name="BEGIN_LINK" />ስለሚደገፍ ቅጥያ የበለጠ ይወቁ<ph name="END_LINK" />}one{Optimium እንዲያስወግዱት ይመክራል። <ph name="BEGIN_LINK" />ስለሚደገፍ ቅጥያ የበለጠ ይወቁ<ph name="END_LINK" />}other{Optimium እንዲያስወግዷቸው ይመክራል። <ph name="BEGIN_LINK" />ስለሚደገፉ ቅጥያዎች የበለጠ ይወቁ<ph name="END_LINK" />}}</translation>
<translation id="6842479443769252421">Optimiumን ያብጁ እና ይቆጣጠሩ</translation>
<translation id="4427306783828095590">የተሻሻለ ጥበቃ ማስገር እና ተንኮል-አዘል ዌር ለማገድ የበለጠ ይሠራል</translation>
<translation id="4434353761996769206">የጫኚ ስህተት፦ <ph name="INSTALLER_ERROR" /></translation>
<translation id="1220175535870261362"><ph name="MANAGER" /> Optimiumን ያስተዳድራል</translation>
<translation id="4547231940814681999">የOptimium መገለጫ ያክሉ</translation>
<translation id="4447409407328223819">ስለ Chrome ለሙከራ</translation>
<translation id="5633209319760692383">በGoogle መለያዎ ውስጥ የOptimium ውሂብን ለመጠቀም እና ለማስቀመጥ የእርስዎን የይለፍ ሐረግ ያስገቡ</translation>
<translation id="4493028449971051158">የማስነሻ ስህተት፦ እባክዎ መጫኛውን እንደ አስተዳዳሪ ያሂዱ።</translation>
<translation id="4501471624619070934">በዚህ አገር መዳረሻ የተገደበ ስለሆነ ጭነት አልተሳካም።</translation>
<translation id="4501839397124711198">በሚያስሱበት ጊዜ ጥያቄዎችን ለመጠየቅ የGoogle ፍለጋን የጎን ፓነል ውስጥ መሰካት ይችላሉ</translation>
<translation id="2800276662284246735">ይህ ቅጥያ እንደ ውሂብን እንዴት እንደሚሰበስብ እና እንደሚጠቀም ያሉ የግላዊነት ተግባሮችን አላተመም። Optimium እንዲያስወግዱት ይመክራል።</translation>
<translation id="5128821773878845255">እንኳን ወደ Optimium በደህና መጡ፤ አዲስ የአሳሽ መስኮት ተከፍቷል</translation>
<translation id="2317489323536472198">Optimium አካባቢዎን በካርታ ለመንደፍ እና የእጆችዎን እንቅስቃሴዎች ለመከታተል ፈቃድ ይፈልጋል</translation>
<translation id="8080035720506683743">አስቀድመው በሌላ የOptimium መገለጫ እንደ <ph name="USER_EMAIL_ADDRESS" /> ገብተዋል</translation>
<translation id="4548534452171747496">Chromium ገፆችን ቅድሚያ ይጭናል፣ ይህም ማሰስ እና መፈለግን የበለጠ ፈጣን ያደርጋል። <ph name="BEGIN_LINK" />በቅድሚያ ስለሚጫኑ ገፆች የበለጠ ለመረዳት<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">እርስዎ ጎጂ ነው ብለው የሚያስቡትን ጣቢያ ሪፖርት ሲያደርጉ ለሁሉም ሰው የመስመር ላይ ደኅንነትን ያሻሽሉ።</translation>
<translation id="8636960717768483692">እርስዎ ደህንነቱ የተጠበቀ አሰሳን ስላጠፉ እና ፋይሉ ሊረጋገጥ ስለማይችል Optimium ይህን ውርድ አግዷል</translation>
<translation id="1056620590372326996">በስልክዎ ላይ Google ሌንስን ከOptimium ጋር ይሞክሩ</translation>
<translation id="4594305310729380060">በዚህ መሣሪያ ላይ ወደ የይለፍ ቃል አስተዳዳሪ</translation>
<translation id="1647545052658850323">የOptimium መተግበሪያዎች</translation>
<translation id="4598116752460667024">ከዝርዝሩ ማንኛውንም ሂደት ይፈልጉ።</translation>
<translation id="4613863813562375431">የChromiumOS ስሪት</translation>
<translation id="4621240073146040695">የተዘመነ ለመሆን ጥቂት ብቻ ቀርቷል! ማዘመን ለማጠናቀቅ Chromiumን ዳግም ያስጀምሩት።</translation>
<translation id="2905329563261343101">በOptimium V8 ሞተር ጣቢያዎችን ያፋጥናል ነገር ግን የOptimiumን ጥቃቶችን የመቋቋም አቅም በመጠኑ ያነሰ ያደርገዋል</translation>
<translation id="3476739270743628464">ፍለጋን በOptimium ክፈት</translation>
<translation id="8852417056873245680">የOptimium መገለጫ</translation>
<translation id="7306598352117034690">ማስጠንቀቂያ፦ Optimium ቅጥያዎች የአሰሳ ታሪክዎን እንዳይመዘግቡ መከልከል አይችልም። ይህን ቅጥያ ማንነት በማያሳውቅ ሁነት ላይ ለማሰናከል ይህን አማራጭ አይምረጡ።</translation>
<translation id="4673151026126227699">እንዲሁም የChromium አጠቃቀም ሪፖርቶችን ካጋሩ፣ እነዚያ ሪፖርቶች እርስዎ የሚጎበኟቸውን ዩአርኤሎች ያካትታሉ</translation>
<translation id="4673710618874938871">እንደ <ph name="USER_NAME" />፣ አባልነት ገብተዋል። የመለያ ምናሌውን ይክፈቱ</translation>
<translation id="8554460300897634995">መገለጫው በሌላ ኮምፒውተር (<ph name="HOST_NAME" />) ላይ በሌላ የOptimium ሂደት (<ph name="PROCESS_ID" />) የተያዘ ይመስላል። Optimium መገለጫው እንዳይበላሽ ቆልፎታል። ሌሎች ሂደቶች ይህን መገለጫ እየተጠቀሙበት እንዳልሆኑ እርግጠኛ ከሆኑ መገለጫውን አስከፍተው Optimiumን ዳግም ማስጀመር ይችላሉ።</translation>
<translation id="4680828127924988555">መጫኑን ሰርዝ</translation>
<translation id="3120454893225058851">አንዳንድ የOptimium ውሂብዎ በGoogle መለያዎ ውስጥ ገና አልተቀመጠም። ዘግተው ከመውጣትዎ በፊት ጥቂት ደቂቃዎች ለመጠበቅ ይሞክሩ። አሁን ዘግተው ከወጡ ይህ ውሂብ ይሰረዛል።</translation>
<translation id="382482205580353394">በመለያ ገብተው ሳለ በOptimium ውስጥ ከGoogle መለያዎ የይለፍ ቃላትዎን እና ሌሎችንም መጠቀም ይችላሉ። <ph name="SHORTCUT" /> የGoogle አገልግሎቶች ቅንብሮችዎን መለወጥ ይችላል።</translation>
<translation id="3042362992251330365">የሆነ ሰው ከዚህ ቀደም በዚህ ኮምፒውተር ላይ እንደ <ph name="ACCOUNT_EMAIL_LAST" /> ሆነው ገብተዋል። የእርስዎን መረጃ ለይተው ለማስቀመጥ እባክዎ አዲስ የOptimium ተጠቃሚ ይፍጠሩ።</translation>
<translation id="4724676981607797757">በማይደገፍ የፕሮቶኮል ስህተት ምክንያት መጫኑ አልተሳካም።</translation>
<translation id="1193287511990404405">የሆነው ሆኖ Optimium ይቁም?</translation>
<translation id="8952177001318268390">ለOptimium ልዩ የደህንነት ዝማኔ ተፈጻሚ ተደርጓል። አሁን ዳግም ያስጀምሩ እና የእርስዎን ትሮች ወደ ነበሩበት እንመልሳለን።</translation>
<translation id="4771701986670315895">በቅርብ ጊዜ አልጎበኙም። Chromium <ph name="PERMISSION_1" />፣ <ph name="PERMISSION_2" /> እና <ph name="COUNT" /> ሌሎችንም አስወግዷል።</translation>
<translation id="2836181158089477791">Gemini በOptimium ውስጥ ክፍት ከሆነ አዲስ ትሮች ሲፈጠሩ የጎን ፓነሉ ክፍት ሆኖ ይቆያል</translation>
<translation id="479167709087336770">ይህ በ Google ፍለጋ ውስጥ ጥቅም ላይ ጋር ተመሳሳይ የፊደል አራሚ ይጠቀማል። በአሳሽ ውስጥ የሚተይቡት ጽሁፍ ወደ Google ይላካል። ይህን ባህሪ ሁልጊዜ በቅንብሮች ውስጥ መለወጥ ይችላሉ።</translation>

<translation id="6859580922007887573">ለመቀጠል ትር</translation>
<translation id="6862030660799253820">ይህን ምስል በምስል ፍለጋ ይፈልጉ</translation>
<translation id="6869568587896659271">ከአድራሻ አሞሌው በታች ላሉ ድር ጣቢያዎች ቀላል መዳረሻ</translation>
<translation id="4548192511713002443">Optimium «<ph name="EXTENSION_NAME" />» ተንኮል አዘል ዌር እንደያዘ አግኝቷል</translation>
<translation id="6877155553248388166">የፍለጋው አካባቢ ከታች በስተቀኝ ጥግ፦ ቀኝ <ph name="RIGHT" />%፣ ከታች <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">ቅዳ</translation>
<translation id="6898028264630240901">በሚያስሱበት ጊዜ ጥያቄዎችን ለመጠየቅ ዓውዳዊ ተግባራትን ፒን ማድረግ ይችላሉ</translation>
<translation id="3594007018780395447">Optimiumን እንደ ነባሪ አሳሽዎ ያቀናብሩ እና የተግባር አሞሌዎ ላይ ፒን ያድርጉት</translation>
<translation id="8874878391047306490">እና የOptimium መገለጫዎችን ያስተዳድሩ</translation>
<translation id="8227361644719983591">ይህ እርምጃ የሚከተሉትን ያደርጋል፦
          <ph name="LINE_BREAKS" />
            • የእርስዎን የመነሻ ገጽ፣ አዲስ የትር ገጽ፣ የፍለጋ ፕሮግራም እና ፒን የተደረጉ ትሮችን ዳግም ያስጀምራል
            <ph name="LINE_BREAK" />
            • ቅጥያዎችን ያሰናክላል
            <ph name="LINE_BREAK" />
            • ኩኪዎችን እና ሌላ ጊዜያዊ የጣቢያ ውሂብን ይሰርዛል
            <ph name="LINE_BREAK" />
            • የOptimium አቋራጮችን ዳግም ያስጀምራል
            <ph name="LINE_BREAKS" />
            ዕልባቶች፣ ታሪክ እና የተቀመጡ የይለፍ ቃላት አይነኩም።</translation>
<translation id="6926772305569367352">በመሣሪያ አሞሌው ላይ ያለው «Google ፍለጋ በChrome ውስጥ» አዝራር አዲስ አዶ አለው። Google ፍለጋ በChrome ውስጥ እያሰሱ ሳለ ጥያቄዎችን ለመጠየቅ ጠቅ ያድርጉት።</translation>
<translation id="7079691767892495301">የOptimiumን የ<ph name="BOOKMARK_LIMIT" /> እልባቶች ገደብ ላይ ደርሰዋል፣ ስለዚህ አንዳንድ እልባቶችዎ እስካሁን በGoogle መለያዎ ውስጥ አልተቀመጡም።

አንዳንድ እስኪሰርዙ ድረስ አዲስ እልባቶች በመለያዎ ውስጥ መቀመጥ አይችሉም። አሁን ዘግተው ከወጡ ያልተቀመጡ እልባቶች ይሰረዛሉ።</translation>
<translation id="8488478146459741524">አገናኙን በOptimium ማን&amp;ነትን በማያሳውቅ መስኮት ውስጥ ክፈት</translation>
<translation id="6965382102122355670">እሺ</translation>
<translation id="6985329841647292029">የChromiumOS ውል</translation>
<translation id="8559464220428426642">Optimium ውሂብን በእርስዎ መለያ <ph name="ACCOUNT_EMAIL" /> ውስጥ ለመጠቀም እና ለማስቀመጥ የይለፍ ሐረግዎን ያስገቡ</translation>
<translation id="7011190694940573312">ይህ የስርዓተ ክወናው ስሪት ስለማይደገፍ መጫኑ አልተሳካም።</translation>
<translation id="7024536598735240744">ተጠናቆ ያለማቅረብ ስህተት፦ <ph name="UNPACK_ERROR" />።</translation>
<translation id="7941779569092758272">{COUNT,plural, =1{የላቀ ጥበቃ ዝማኔ ለመተግበር Optimiumን ዳግም እንዲያስጀምሩ ይጠይቃል። የእርስዎ የተለየ መስኮት እንደገና አይከፈትም።}one{የላቀ ጥበቃ ዝማኔ ለመተግበር Optimiumን ዳግም እንዲያስጀምሩ ይጠይቃል። የእርስዎ # የተለየ መስኮት እንደገና አይከፈትም።}other{የላቀ ጥበቃ ዝማኔ ለመተግበር Optimiumን ዳግም እንዲያስጀምሩ ይጠይቃል። የእርስዎ # የተለዩ መስኮቶች እንደገና አይከፈቱም።}}</translation>
<translation id="5367778139372857256">Optimiumን የራስዎ ያድርጉት</translation>
<translation id="7047386856539490735">እነዚህ ውጤቶች ጠቃሚ ናቸው?</translation>
<translation id="6654931874608808546">Optimiumን አዘምን</translation>
<translation id="1078205929937913964">አንድ ምስል ጠቃሚ መግለጫ ከሌለው Optimium ለእርስዎ አንድ ለማቅረብ ይሞክራል። ዝርዝር መግለጫዎችን ለመፍጠር፣ ምስሎች ወደ Google ይላካሉ።</translation>
<translation id="8657336023716174215">የOptimium መተግበሪያን በእርስዎ <ph name="DEVICE_TYPE" /> ላይ ሲጠቀሙ የሰው ሠራሽ አስተውሎት ኃይልን ያግኙ</translation>
<translation id="8360922610978196377">በስልክዎ ላይ ባለው የOptimium መተግበሪያ የይለፍ ቃላትዎን፣ ትሮችን እና ሌሎችንም በመሄድ ላይ ይውሰዱ</translation>
<translation id="7141270731789036260">Chromeን ለሙከራ አብጅ</translation>
<translation id="7147227333672430807">በመልዕክቶች፣ ሰነዶች እና ሌሎች መተግበሪያዎች ውስጥ አገናኞች ላይ ጠቅ በሚያደርጉበት ማንኛውም ጊዜ Chromium መጠቀም ይችላሉ</translation>
<translation id="7635847276859447848"><ph name="EXTENSION_NAME" /> ከOptimium አስወግድ</translation>
<translation id="4634249408802713112">ድርጅትዎ የOptimium ውሂብን ለ<ph name="TIMEOUT_DURATION" /> ያህል ሥራ ላይ ሳይውል ይሰርዘዋል። ይህ ታሪክን፣ ራስ-ሙላን እና ውርዶችን ሊያካትት ይችላል።</translation>
<translation id="3308314751977712481">Optimium ለዚህ ጣቢያ የካሜራ ፈቃድ ያስፈልገዋል</translation>
<translation id="1700107811881467396">Optimiumን ማስጀመር አልተቻለም። እንደገና ይሞክሩ።</translation>
<translation id="615859695332174696">በGemini በOptimium ውስጥ፣ ባሉበት ሆነው ማንኛውንም ነገር ይጠይቁ</translation>
<translation id="4082322885657154457">በማንኛውም ጊዜ Optimiumን በቀላሉ ማግኘት እንዲችሉ በእርስዎ መትከያ ውስጥ ያቆዩት</translation>
<translation id="5886985791575399945">በመልዕክቶች፣ ሰነዶች እና ሌሎች መተግበሪያዎች ውስጥ አገናኞች ላይ ጠቅ በሚያደርጉበት ማንኛውም ጊዜ Optimium ይጠቀሙ</translation>
<translation id="7213435258745128111">Chromium ውስጥ ያለው Google ፍለጋ</translation>
<translation id="7216228761061470870">በዴስክቶፕ ላይ የምስል ፍለጋን ሲጠቀሙ የገጹ ርዕስ፣ ዩአርኤል እና PDFዎችን ጨምሮ ይዘት ወደ አገልጋዩ ይላካሉ</translation>
<translation id="3899250150715276784">ተግባር መሪ - Optimium</translation>
<translation id="357779301278973973">እንደ ሌሎች መተግበሪያዎች ወይም ፋይሎች ያለ ከOptimium ውጭ ስላለ ይዘት ይጠይቁ</translation>
<translation id="2192941957286691074"><ph name="EXISTING_USER" /> አስቀድመው ገብተዋል። አሰሳዎን ለያይተው ለማቆየት በራስዎ መገለጫ ውስጥ እንደ <ph name="USER_EMAIL_ADDRESS" /> ሆነው ወደ Optimium ይግቡ። እንዲሁም በሁሉም መሣሪያዎችዎ ላይ የተቀመጠ የእርስዎን መረጃ እና ሌሎችንም ያገኛሉ።</translation>
<translation id="4695009148423764441">በቅጽበት ማሰስ ይጀምሩ፦ አሁን Windows ሲጀምር Optimium መጀመር ይችላል።</translation>
<translation id="7274695763216404502">ፒን ተደርጓል! ከመሣሪያ አሞሌው እንደገና የምስል ፍለጋ ይጠቀሙ</translation>
<translation id="7288567540154601580">ትሮች እና ቅጥያዎች</translation>
<translation id="7290997427370476749">በመሣሪያ አሞሌው ላይ ካለው «Google ፍለጋ ፓነል» አዝራር ላይ በሚያስሱበት ጊዜ ጥያቄዎችን ለመጠየቅ Google ፍለጋ ፓነልን እንደገና መክፈት ይችላሉ</translation>
<translation id="1079602886106438527">{NUM_EXTENSIONS,plural, =1{Optimium እንዲያስወግዱት ይመክራል}one{Optimium እንዲያስወግዱት ይመክራል}other{Optimium እንዲያስወግዷቸው ይመክራል}}</translation>
<translation id="5279936464959604532">የሥርዓት ኦዲዮን ለማጋራት የሥርዓት ቅንብሮችን ይክፈቱ እና ለOptimium «የሥርዓት የኦዲዮ ቀረጻ ብቻ» ይፍቀዱ። ከዚያ Optimiumን እንደገና ማስጀመር ይኖርብዎታል።</translation>
<translation id="7299899569525778554">ከዴስክቶፕ ይፈልጉ</translation>
<translation id="731795002583552498">Chromiumን በማዘመን ላይ...</translation>
<translation id="1032861344046520617">የምርጫዎች ፋይልዎ የተበላሸ ወይም ልክ ያልሆነ ነው።

Optimium ቅንብሮችዎን ማስመለስ አልቻለም።</translation>
<translation id="7324051657739063017">በሚያስሱበት ጊዜ ጥያቄዎችን ለመጠየቅ ዓውዳዊ ተግባራትን እንደገና መክፈት ይችላሉ</translation>
<translation id="265884122223707624">የእርስዎ ድር፣ ዕልባቶች እና ሌሎች የOptimium ነገሮች እዚህ ይኖራሉ።</translation>
<translation id="7347827960336370838">የእርስዎን የተመሰጠረ ውሂብ ማንበብ የሚችለው የይለፍ ሐረግዎ ያለው ሰው ብቻ ነው። የይለፍ ሐረጉ ወደ Google አይላክም ወይም በGoogle አይከማችም። የእርስዎን የይለፍ ሐረግ ከረሱ ወይም ይህን ቅንብር መለወጥ ከፈለጉ <ph name="BEGIN_LINK" />በመለያዎ ውስጥ ያለውን Chromium ውሂብ መሰረዝ<ph name="END_LINK" /> ይኖርብዎታል።</translation>
<translation id="3014807377884544255">የእርስዎ ስርዓት አስተዳዳሪ Optimium <ph name="TARGET_URL_HOSTNAME" />ን ለመድረስ <ph name="ALTERNATIVE_BROWSER_NAME" />ን እንዲከፍት አዋቅሮታል።</translation>
<translation id="7352651011704765696">የሆነ ችግር ተፈጥሯል</translation>
<translation id="6261059974673858354">የወደፊት የOptimium ዝማኔዎችን ለማግኘት macOS 13 ወይም ከዚያ በላይ ያስፈልግዎታል። ይህ ኮምፒውተር macOS 12 እየተጠቀመ ነው።</translation>
<translation id="7374061268215476070">በሚያስሱበት ጊዜ ጥያቄዎችን ለመጠየቅ የGoogle ፍለጋ የጎን ፓነልን እንደገና መክፈት ይችላሉ</translation>
<translation id="7376384068949534168">በቅርብ ጊዜ አልጎበኙም። Chromium <ph name="PERMISSION_1" />፣ <ph name="PERMISSION_2" />ን አስወግዷል።</translation>
<translation id="73786666777299047">Chrome የድር መደብርን ይክፈቱ</translation>
<translation id="3890970823792853036">Geminiን በሥርዓት ትሪ ውስጥ በOptimium ውስጥ አሳይ</translation>
<translation id="7401687852903179959">ይህን ቪድዮ በምስል ፍለጋ ፈልግ</translation>
<translation id="3864955417896853787">Optimium አሁን የእርስዎ ነባሪ አሳሽ ነው</translation>
<translation id="7774148037106099906">ካቆሙበት ይቀጥሉ፦ Optimium እንደገና በጀመሩ ቁጥር የእርስዎን ትሮች ወደነበሩበት ይመልሳል። ይህን ለማጥፋት ወደሚከተለው ይሂዱ</translation>
<translation id="8928491002876394495">የይለፍ ቃላትን ወደ Optimium ያምጡ</translation>
<translation id="5203709869300967635">1. ከታች <ph name="BUTTON_LABEL" /> ላይ ጠቅ ያድርጉ
2. በWindows ቅንብሮችዎ ውስጥ <ph name="BUTTON_2" /> ላይ ጠቅ ያድርጉ
3. ለፈጣን መዳረሻ Optimiumን በተግባር አሞሌዎ ላይ ለመሰካት በWindows ማሳወቂያ ውስጥ <ph name="BUTTON_3" /> ላይ ጠቅ ያድርጉ</translation>
<translation id="1391846143863378733"><ph name="PAGE_TITLE" /> - Optimium ግንባታ</translation>
<translation id="7450541714075000668">ጽሁፍ ገልብጧል</translation>
<translation id="7458892263350425044">ማይክሮፎንዎን ለመጠቀም <ph name="BEGIN_LINK" />የሥርዓት ቅንብሮች<ph name="END_LINK" /> ውስጥ ለChromium መዳረሻ ይስጡ</translation>
<translation id="6029586608765705546">የወደፊት የOptimium ዝማኔዎችን ለማግኘት Windows 10 ወይም ከዚያ በላይ ያስፈልግዎታል። ይህ ኮምፒውተር Windows 7ን እየተጠቀመ ነው።</translation>
<translation id="7467949745582939695">Chromium ዳግም ይጀመር?</translation>
<translation id="5752242571869112795">እየሄደ ያለውን ተመሳሳዩን የOptimium ስሪት መጫን አይቻልም። እባክዎ Optimiumን ይዝጉና እንደገና ይሞክሩ።</translation>
<translation id="7510190804000607802">አስታዋሽ፦ የGoogle ምርጡ በኪስዎ ውስጥ</translation>
<translation id="751935028865900641">ጣቢያዎች እንደተጠበቀው መስራታቸው አይቀርም። ከGoogle መለያዎ በስተቀር በ Chromium ውስጥ ገብተው ከሆነ፣ ሁሉንም የChromium መስኮቶች ሲዘጉ ከአብዛኞቹ ጣቢያዎች ይወጣሉ።</translation>
<translation id="63211891312143018">{0,plural, =1{Optimium በ1 ደቂቃ ውስጥ ዳግም ይጀመራል}one{Optimium በ# ደቂቃዎች ውስጥ ዳግም ይጀመራል}other{Optimium በ# ደቂቃዎች ውስጥ ዳግም ይጀመራል}}</translation>
<translation id="7565444033145385702">ውሂብዎን ለመጠበቅ Chromium እርስዎ በቅርቡ ካልጎበኟቸው ጣቢያዎች ላይ ፈቃዶችን እንዲያስወግድ ይፍቀዱ።</translation>
<translation id="3125039289492641783">በቅጽበት ማሰስ ለመጀመር Optimiumን በራስ-ሰር አስጀምር።</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> ጫኝ</translation>
<translation id="4408734053922791034">Optimium ካሜራዎን እና ማይክሮፎንዎን እየተጠቀመ ነው።</translation>
<translation id="3179764934195866467">Optimium አሁን ይበልጥ ተሻሽሏል</translation>
<translation id="6404693631411216689">አሁን Optimium ውስጥ የሚገኙ ተጨማሪ ባህሪያት አሉዎት</translation>
<translation id="7624307931717240213">ይህን አገልግሎት ለማሻሻል መረጃ እንጠቀማለን። የግላዊነት መመሪያን እና የአገልግሎት ውልን ይመልከቱ።</translation>
<translation id="7649070708921625228">እገዛ</translation>
<translation id="8311510395768039141">የOptimium መተግበሪያን ያግኙ</translation>
<translation id="7658239707568436148">ይቅር</translation>
<translation id="133478151344333089">Optimium ነባሪ አሳሽዎ አይደለም</translation>
<translation id="280841280407738358">በመላ መሣሪያዎችዎ ላይ Optimiumን ያሳምሩ እና ግላዊነት ያላብሱ</translation>
<translation id="7699779824407626136">Chromium ዝማኔ</translation>
<translation id="4220506181038618136">ሥራዎ Optimium ላይ ደኅንነቱ ተጠብቋል</translation>
<translation id="7716950018788545737">ተግባር(ራት) አልቋል(አልቀዋል)።</translation>
<translation id="77283119132245232">ለ<ph name="BROWSER_NAME" /> የሥርዓት ክትትል አገልግሎቶች ያቀርባል። ይህ አገልግሎት ከተሰናከለ በአሳሹ የተፈጠሩ የአፈጻጸም መከታተያዎች እንደ የዓውድ መቀያየሪያ እና ዝግጁ ተከታታይ ክስተቶች ያሉ ሥርዓት አቀፍ ክስተቶችን አያካትቱም።</translation>
<translation id="7745317241717453663">ይሄ የአሰሳ ውሂብዎን ከዚህ መሣሪያ ይሰርዘዋል። ውሂብዎን በኋላ ላይ ሰርስረው ለማውጣት እንደ <ph name="USER_EMAIL" /> ሆነው ወደ Chromium ይግቡ።</translation>
<translation id="7747138024166251722">ጫኝው ጊዜያዊ ማውጫ መፍጠር አልቻለም። እባክዎ ነፃ የዲስክ ቦታ እና ሶፍትዌር የመጫን ፍቃድ እንዳለ ይፈትሹ።</translation>
<translation id="4874030584283115178">ወደ ነባሪ Optimium ዳግም አስጀምር</translation>
<translation id="4747871007139957101">በOptimium ላይ ሥራዎን ደኅንነት ለመጠበቅ፣ ወደ Optimium ሲገቡ ድርጅትዎ የተወሰነ መረጃን ማየት ወይም ማስተዳደር ይችላል።</translation>
<translation id="39303350018938562">Optimiumን እንደ ነባሪ ያቀናብሩ እና የተግባር አሞሌው ላይ ይሰኩት</translation>
<translation id="1411498815218277204">Optimiumን የበለጠ ፈጣን ያድርጉት</translation>
<translation id="6759916683257281869"><ph name="PAGE_TITLE" /> - Optimium Canary</translation>
<translation id="7800043020703832708">በጎን ፓነል ውስጥ Google ፍለጋን ዝጋ</translation>
<translation id="7801317262080715012">አዲስ አዶ፣ ተመሳሳይ አቋራጭ፦ በGoogle ፍለጋ ፓነል እያሰሱ ሳለ ጥያቄዎችን ለመጠየቅ ጠቅ ያድርጉ።</translation>
<translation id="7803986347287457849">የበይነመረብ ትራፊክዎ መዳረሻ ላላቸው ሰዎች እርስዎ የትኞቹን ጣቢያዎች እንደሚጎበኙ ማየት ያክብዱባቸው። Chromium የጣቢያውን አይ ፒ አድራሻ በዲኤንኤስ (የጎራ ስም ሥርዓት) ውስጥ ለመፈለግ የተመሰጠረ ግንኙነትን ይጠቀማል።</translation>
<translation id="7810005234485217901">በቀላሉ ለመድረስ የምስል ፍለጋን ፒን ማድረግ ይችላሉ</translation>
<translation id="3974047900913685132">{COUNT,plural, =1{አዲስ ዝማኔ ለOptimium የሚገኝ ሲሆን ልክ ዳግም ሲያስጀምሩት ይተገበራል። የተከፈተ ማንነት የማያሳውቅ ወይም የተለየ መስኮት አለ። ዳግም ካስጀመሩ በኋላ ዳግም አይከፈትም።}one{አዲስ ዝማኔ ለOptimium የሚገኝ ሲሆን ልክ ዳግም ሲያስጀምሩት ይተገበራል። በመላው መገለጫዎች ላይ የተከፈተ # ማንነት የማያሳውቅ እና የተለየ መስኮት አለ። ዳግም ካስጀመሩ በኋላ ዳግም አይከፈትም።}other{አዲስ ዝማኔ ለOptimium የሚገኝ ሲሆን ልክ ዳግም ሲያስጀምሩት ይተገበራል። በመላው መገለጫዎች ላይ የተከፈተ # ማንነት የማያሳውቅ እና የተለዩ መስኮቶች አሉ። ዳግም ካስጀመሩ በኋላ ዳግም አይከፈቱም።}}</translation>
<translation id="1327395026710636574">ከOptimium ጋር ምን እንደሚያጋሩ ይምረጡ</translation>
<translation id="7712700268586648421">ይህን መለያ ያለው አንድ የOptimium መገለጫ አስቀድሞ በዚህ መሣሪያ ላይ አለ</translation>
<translation id="7845233973568007926">ሰለተጫኑ እናመሰግናለን። <ph name="BUNDLE_NAME" />ን ከመጠቀምዎ በፊት ኮምፒውተርዎን እንደገና ማስጀመር አለብዎት።</translation>
<translation id="7639854797882089460">የፍለጋ ፕሮግራምዎ ከOptimium ውጭ ተለውጧል። እርስዎን ለመጠበቅ Optimium ወደ መጀመሪያው ነባሪ ዳግም አስጀምሮታል። <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3551756496947130501">Optimiumን አዲስ መልክ ለመስጠት ያብጁት</translation>
<translation id="7859018312476869945">የአድራሻ አሞሌ ወይም የፍለጋ ሳጥን ውስጥ ሲተይቡ የተሻሉ ጥቆማዎችን ለማግኘት Chromium የሚተይቡትን ለእርስዎ ነባሪ የፍለጋ ፕሮግራም ይልካል። ይህ ማንነት የማያሳውቅ ውስጥ ጠፍቷል።</translation>
<translation id="7884611555881634231">Optimium ወደ የቅርብ ጊዜው ስሪት ሊዘመን አልቻለም፣ ስለዚህ አዲስ ባህሪያት እና የደህንነት ጥገናዎች እያመለጡዎት ናቸው። Optimiumን ማዘመን አለብዎት።</translation>
<translation id="7872446069773932638">በማውረድ ላይ... <ph name="SECONDS" /> ሰከንድ(ዶች) ይቀራሉ</translation>
<translation id="7873537467422636035">የይለፍ ሐረግዎን ከረሱ ወይም ይህን ቅንብር መለወጥ ከፈለጉ <ph name="BEGIN_LINK" />በመለያዎ ውስጥ ያለውን የChromium ውሂብ ይሰርዙ<ph name="END_LINK" /></translation>
<translation id="3834573390507006929">Geminiን በሚያስፈልግዎ ማንኛውም ጊዜ በOptimium ውስጥ በፍጥነት ይክፈቱት</translation>
<translation id="6294556714699385535">Optimiumን እንደ ነባሪ ያቀናብሩት</translation>
<translation id="7904213866086517086">በጎን ፓነል ውስጥ Google ፍለጋን እንደገና ክፈት</translation>
<translation id="7934340546140346950">Chromium በሚቻልበት ጊዜ ደህንነታቸው ያልተጠበቀ ግንኙነቶችን በራስ-ሰር ወደ ኤችቲቲፒኤስ ያልቃል</translation>
<translation id="5730000852184248909">እንደ <ph name="USER_EMAIL_ADDRESS" /> ሆነው ወደ Optimium ገብተዋል። እባክዎ እንደገና ለመግባት ተመሳሳዩን መለያ ይጠቀሙ።</translation>
<translation id="8566131222358264585"><ph name="EXISTING_USER" /> አስቀድመው ገብተዋል። አሰሳዎን ለያይተው ለማቆየት በራስዎ መገለጫ ውስጥ እንደ <ph name="USER_EMAIL_ADDRESS" /> ሆነው ወደ Optimium ይግቡ። እንዲሁም በሁሉም መሣሪያዎችዎ ላይ የእርስዎን እልባቶች እና ሌሎችንም ያገኛሉ።</translation>
<translation id="7975919845073681630">ይሄ ሁለተኛ የChromium ጭነት ነው፣ እና ነባሪ አሳሽዎ ማድረግ አይቻልም።</translation>

<!DOCTYPE translationbundle>
<translationbundle lang="lo">
<translation id="1026101648481255140">ສືບຕໍ່ການຕິດຕັ້ງ</translation>
<translation id="1029669172902658969">ເລີ່ມເປີດໃຊ້ໃໝ່ເພື່ອອັບເດດ &amp;ChromiumOS</translation>
<translation id="4063809399345498325">Optimium ຂໍແນະນຳໃຫ້ທ່ານກວດສອບສ່ວນຂະຫຍາຍນີ້</translation>
<translation id="1042552502243217427">ເມື່ອເວັບໄຊຂໍໂຫຼດລິ້ງຢູ່ໜ້າເວັບຂອງເຂົາເຈົ້າໄວ້ກ່ອນລ່ວງໜ້າແບບສ່ວນຕົວ, Chromium ຈະໃຊ້ເຊີບເວີຂອງ Google. ການດຳເນີນການນີ້ຈະເຊື່ອງຕົວຕົນຂອງທ່ານຈາກເວັບໄຊທີ່ໂຫຼດກ່ອນລ່ວງໜ້າ, ແຕ່ Google ຈະສຶກສາວ່າເວັບໄຊໃດໄດ້ຮັບການໂຫຼດກ່ອນລ່ວງໜ້າ.</translation>
<translation id="1051793555070215510">ຊ່ວຍພວກເຮົາປັບປຸງໂໝດບໍ່ເປີດເຜີຍຕົວຕົນໂດຍເຮັດແບບສຳຫຼວດ 1 ນາທີນີ້.</translation>
<translation id="1065672644894730302">ບໍ່ສາມາດອ່ານຄວາມມັກຂອງທ່ານໄດ້.

ບາງຄຸນສົມບັດ​ອາດຈະບໍ່ມີໃຫ້ ແລະການປ່ຽນແປງຕໍ່ຄວາມມັກຈະບໍ່ຖືກບັນທຶກ.</translation>
<translation id="7250992450852052182">ພໍ່ແມ່ຂອງທ່ານໄດ້ປິດ "ການອະນຸຍາດສຳລັບເວັບໄຊ, ແອັບ ແລະ ສ່ວນຂະຫຍາຍ" ສຳລັບ Optimium ແລ້ວ</translation>
<translation id="6711838932294803312">Optimium ຕ້ອງການສິດເຂົ້າເຖິງເຄືອຂ່າຍທ້ອງຖິ່ນຂອງທ່ານເພື່ອຄົ້ນພົບ ແລະ ໃຊ້ອຸປະກອນທີ່ຢູ່ໃກ້ຄຽງ</translation>
<translation id="2807920805712601449">ເພື່ອຊອກຫາຄຸນສົມບັດ ຫຼື ສ່ວນຂະຫຍາຍທີ່ສະເພາະຂອງ Optimium, ໃຫ້ພິມທາງລັດຂອງຄຸນສົມບັດ ຫຼື ສ່ວນຂະຫຍາຍໃສ່ໃນແຖບທີ່ຢູ່, ຕາມດ້ວຍປຸ່ມແປ້ນພິມທີ່ທ່ານເລືອກໄວ້</translation>
<translation id="5994612110840535151">ສະແດງການຊອກຫາດ້ວຍ Optimium ໃນຖາດລະບົບ ແລະ ເປີດຄີລັດ</translation>
<translation id="7212528213853025915">Optimium ຕ້ອງການສົ່ງອອກລະຫັດຜ່ານຂອງທ່ານ. ກະລຸນາພິມລະຫັດຜ່ານ Windows ຂອງທ່ານ ເພື່ອອະນຸຍາດສິ່ງນີ້.</translation>
<translation id="112640046208448578">ລະບຸສິ່ງຂອງ ຫຼື ສະຖານທີ່ ແລ້ວສຳເນົາ ຫຼື ແປຂໍ້ຄວາມ. ເມື່ອທ່ານໃຊ້ການຊອກຫາຮູບ, ລະບົບຈະສົ່ງຮູບໜ້າຈໍຂອງໜ້າເວັບໄປໃຫ້ເຊີບເວີ. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium ແມ່ນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ</translation>
<translation id="1131805035311359397">ເພື່ອກວດເບິ່ງວ່າລະຫັດຜ່ານຂອງທ່ານປອດໄພຈາກການລະເມີດຂໍ້ມູນ ແລະ ບັນຫາຄວາມປອດໄພອື່ນຫຼືບໍ່, ກະລຸນາ <ph name="BEGIN_LINK" />ເຂົ້າສູ່ລະບົບ Chromium<ph name="END_LINK" />.</translation>
<translation id="3458316367708035110">{COUNT,plural, =1{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານຮ້ອງຂໍໃຫ້ທ່ານເປີດ Optimium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດນີ້. ມີໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນ ຫຼື ໜ້າຈໍແຍກເປີດຢູ່. ມັນຈະບໍ່ເປີດຄືນໃໝ່ຫຼັງຈາກທ່ານເລີ່ມເປີດໃຊ້ໃໝ່.}other{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານຮ້ອງຂໍໃຫ້ທ່ານເປີດ Optimium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດນີ້. ມີໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນ ແລະ ໜ້າຈໍແຍກ # ລາຍການເປີດຢູ່ໃນໂປຣໄຟລ໌ຕ່າງໆ. ພວກມັນຈະບໍ່ເປີດຄືນໃໝ່ຫຼັງຈາກທີ່ທ່ານເລີ່ມເປີດໃຊ້ໃໝ່.}}</translation>
<translation id="1150418667633096194">ປຸ່ມ "ແຜງຄວບຄຸມດ້ານຂ້າງຂອງ Google ຊອກຫາ" ຢູ່ແຖບເຄື່ອງມືມີໄອຄອນໃໝ່. ຄລິກມັນເພື່ອຖາມຄຳຖາມໃນຂະນະທີ່ທ່ານເລືອກເບິ່ງດ້ວຍແຜງຄວບຄຸມດ້ານຂ້າງ Google ຊອກຫາ.</translation>
<translation id="759898790519515623">ຄລິກເມນູ Optimium</translation>
<translation id="1157952955648710254">ປິດແຜງຄວບຄຸມດ້ານຂ້າງຂອງ Google ຊອກຫາ</translation>
<translation id="1157985233335035034">ພາສາຫຼ້າສຸດ</translation>
<translation id="1184145431117212167">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກລະບົບບໍ່ຮອງຮັບ Windows ເວີຊັນທີ່ທ່ານໃຊ້.</translation>
<translation id="1185134272377778587">ກ່ຽວ​ກັບ Chromium</translation>
<translation id="5987505065981917957">ຮັບການແຈ້ງເຕືອນການຕິດຕາມລາຄາດ້ວຍ Optimium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="1203500561924088507">ຂໍຂອບໃຈສຳລັບການຕິດຕັ້ງ. ທ່ານຈະຕ້ອງຣີສະຕາດໂປຣແກຣມທ່ອງເວັບຂອງທ່ານກ່ອນການໃຊ້ <ph name="BUNDLE_NAME" />.</translation>
<translation id="1232234696885483911">ເມື່ອທ່ານເປີດການຊອກຫາຮູບ, ລະບົບຈະສົ່ງຊື່ໜ້າ, URL ແລະ ເນື້ອຫາ, ຮວມທັງ PDF ໄປຫາເຊີບເວີໂດຍອັດຕະໂນມັດ. <ph name="LEARN_MORE" /></translation>
<translation id="3560913454241378492">ໃນລະຫວ່າງທີ່ທ່ານເຂົ້າສູ່ລະບົບ, ທ່ານສາມາດໃຊ້ລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກບັນຊີ Google ຂອງທ່ານໃນ Optimium ໄດ້. ເພື່ອປ່ຽນສິ່ງນີ້, ໃຫ້ເຂົ້າໄປ “ບັນຊີຂອງທ່ານໃນ Optimium”.</translation>
<translation id="8922965532693587493">ສະແດງ Gemini ໃນ Optimium ໃນແຖບເມນູຂອງ Mac</translation>
<translation id="236433590733312836">ເພື່ອເລືອກພາກສ່ວນໜຶ່ງຂອງໜ້າຈໍໃນ Gemini ໃນ Optimium, ໃຫ້ໃຊ້ຄີລັດ.</translation>
<translation id="7976124325589452515">ໃນຂະນະທີ່ແຖບນີ້ບໍ່ມີການນຳໃຊ້, ລະບົບຈະເພີ່ມພື້ນທີ່ຫວ່າງໃນໜ່ວຍຄວາມຈຳເພື່ອໃຫ້ໃຊ້ Optimium ໄດ້ຢ່າງວ່ອງໄວຢູ່ຕະຫຼອດ. ທ່ານສາມາດເລືອກຍົກເວັ້ນໃຫ້ເວັບໄຊນີ້ເຮັດວຽກຕະຫຼອດເວລາໄດ້.</translation>
<translation id="2758503437544511902">Optimium ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກໄຟລ໌ເປັນອັນຕະລາຍ</translation>
<translation id="126567311906253476">ເມື່ອເຂົ້າສູ່ລະບົບບໍລິການຕ່າງໆຂອງ Google ເຊັ່ນ: Gmail ຫຼື YouTube ດ້ວຍ <ph name="USER_EMAIL" />, ທ່ານສາມາດເຂົ້າສູ່ລະບົບ Chromium ດ້ວຍບັນຊີດຽວກັນໄດ້ໂດຍອັດຕະໂນມັດ</translation>
<translation id="4104061172701635162">ດາວໂຫຼດ Optimium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="1290883685122687410">ຂໍ້ຜິດພາດໃນການຕັ້ງຄ່າ: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="3443894627866827446">ຕັ້ງຄ່າໂປຣໄຟລ໌ Optimium ໃໝ່ຂອງທ່ານ</translation>
<translation id="8946186262159916495">ລອງໃຊ້ Gemini ໃນ Optimium</translation>
<translation id="7981347318091963592">Optimium ຕ້ອງການສິດເຂົ້າເຖິງ Bluetooth ເພື່ອສຳຫຼວດ
 ອຸປະກອນ Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6099322702899630168">ເຂົ້າສູ່ລະບົບ Optimium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="1330562121671411446">ກວດຫາພາສາ</translation>
<translation id="3294414641786025647">ລຶບຂໍ້ມູນອອກຈາກ Optimium (<ph name="URL" />) ນຳ</translation>
<translation id="4214354213779528068">{COUNT,plural, =1{ການປົກປ້ອງຂັ້ນສູງກຳນົດໃຫ້ທ່ານຕ້ອງເລີ່ມເປີດໃຊ້ Optimium ໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ມີໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນ ຫຼື ໜ້າຈໍແຍກເປີດຢູ່. ມັນຈະບໍ່ເປີດຄືນໃໝ່ຫຼັງຈາກທ່ານເລີ່ມເປີດໃຊ້ໃໝ່.}other{ການປົກປ້ອງຂັ້ນສູງກຳນົດໃຫ້ທ່ານຕ້ອງເລີ່ມເປີດໃຊ້ Optimium ໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ມີໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນ ແລະ ໜ້າຈໍແຍກ # ລາຍການເປີດຢູ່ໃນໂປຣໄຟລ໌ຕ່າງໆ. ພວກມັນຈະບໍ່ເປີດຄືນໃໝ່ຫຼັງຈາກທີ່ທ່ານເລີ່ມເປີດໃຊ້ໃໝ່.}}</translation>
<translation id="1345251407431278948">ປັກໝຸດແລ້ວ! ທ່ານສາມາດເຂົ້າເຖິງການຊອກຫາຮູບໄດ້ອີກຄັ້ງຈາກປຸ່ມໃໝ່ໃນແຖບເຄື່ອງມື</translation>
<translation id="1383876407941801731">ຊອກຫາ</translation>
<translation id="7825299065989465359">ໃຊ້ແອັບ Optimium ເພື່ອທ່ອງເວັບໄດ້ທຸກບ່ອນທຸກເວລາ</translation>
<translation id="141901961143729572">ແບ່ງປັນຄວາມຄິດຂອງທ່ານ</translation>
<translation id="1438812738230833934">ທ່ານສາມາດເປີດ Google ຊອກຫາໃນແຜງຄວບຄຸມດ້ານຂ້າງຄືນໃໝ່ເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="4131307166987455854">ເພື່ອແບ່ງປັນໜ້າຈໍຂອງທ່ານ, ໃຫ້ອະນຸຍາດການບັນທຶກໜ້າຈໍສຳລັບ Optimium ໃນການຕັ້ງຄ່າລະບົບ.</translation>
<translation id="1470136641087909499">ທ່ານສາມາດເປີດ Google ຊອກຫາໃນ Chrome ຄືນໃໝ່ເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="1478370723027452770">ຮັບຄວາມຊ່ວຍເຫຼືອກ່ຽວກັບ Chrome ສຳລັບການທົດສອບ</translation>
<translation id="9200022682397754538">ເພື່ອເຂົ້າເຖິງຂໍ້ມູນທີ່ບັນທຶກໄວ້ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" />, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="1497802159252041924">ຂໍ້ຜິດພາດໃນການຕິດຕັ້ງ: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">ໜ້ານີ້ໄດ້ຮັບການປ້ອງກັນ</translation>
<translation id="892690000529877604">ແບ່ງປັນແຖບ Optimium</translation>
<translation id="15408169957028265">ເປີດ Google ຊອກຫາໃນ Chrome ຄືນໃໝ່</translation>
<translation id="9039191226880557963">ເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="1547469039832541117">ສິ້ນສຸດໜ້າວຽກທີ່ໄຮໄລ້.</translation>
<translation id="4414991100979797293">ປັກໝຸດ Optimium</translation>
<translation id="1574377791422810894">ເຄື່ອງມືຄວາມປອດໄພຂອງ Chromium</translation>
<translation id="3934587628489930735">Optimium ຕ້ອງການລຶບຂໍ້ມູນຕົວຈັດການລະຫັດຜ່ານຂອງທ່ານ. ກະລຸນາພິມລະຫັດຜ່ານ Windows ຂອງທ່ານເພື່ອອະນຸຍາດສິ່ງນີ້.</translation>
<translation id="6745390171113033635">{COUNT,plural, =0{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານກຳນົດໃຫ້ທ່ານເປີດ Optimium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ}=1{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານກຳນົດໃຫ້ທ່ານເປີດ Optimium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານກຳນົດໃຫ້ທ່ານເປີດ Optimium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານ # ລາຍການຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="7186551909256266009">ຮັບປະໂຫຍດສູງສຸດຈາກ Google ດ້ວຍແອັບ Optimium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="1625909126243026060">ກວດສອບການຄວບຄຸມຄວາມເປັນສ່ວນຕົວ ແລະ ຄວາມປອດໄພຫຼັກໃນ Chromium</translation>
<translation id="1640672724030957280">ກຳລັງດາວໂຫຼດ...</translation>
<translation id="1648201623125974721">ໄອຄອນໃໝ່, ແຕ່ທາງລັດເກົ່າ: ຄລິກເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບດ້ວຍໜ້າວຽກຕາມບໍລິບົດ.</translation>
<translation id="1665602916345474427">ເຂົ້າສູ່ລະບົບໃນຊື່ <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, ສະມາຊິກ. ເປີດເມນູບັນຊີ</translation>
<translation id="1708414395296835197">ທ່ານສາມາດໃຊ້ Chromium ໄດ້ທຸກເທື່ອທີ່ທ່ານຄລິກລິ້ງໃນຂໍ້ຄວາມ, ເອກະສານ ແລະ ແອັບອື່ນໆ. ນອກຈາກນີ້, ລະບົບຍັງຈະປັກໝຸດໄວ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານນຳ.</translation>
<translation id="1709772298389099340">ໃຫ້ສິດທິພິເສດລະດັບສູງສຳລັບ <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">ວິທີນີ້ຈະຊ່ວຍໃຫ້ທ່ານສາມາດເລືອກຈາກອຸປະກອນທີ່ພ້ອມນຳໃຊ້ ແລະ ສະແດງເນື້ອຫາຢູ່ອຸປະກອນເຫຼົ່ານັ້ນ.</translation>
<translation id="6717880500969720524">Optimium ຈະລຶບຂໍ້ມູນການທ່ອງເວັບໃນໄວໆນີ້</translation>
<translation id="1736443181683099871">Chromium ຈະພະຍາຍາມອັບເກຣດການນຳທາງເປັນ HTTPS</translation>
<translation id="4418738262462299802">ລຶບລ້າງຂໍ້ມູນ Optimium ແລ້ວ</translation>
<translation id="8469746761106187775">Optimium ຈະຣີສະຕາດໃນ <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">ເມື່ອບໍ່ສາມາດໃຊ້ HTTPS ໄດ້, Chromium ຈະໃຊ້ການເຊື່ອມຕໍ່ທີ່ບໍ່ປອດໄພໂດຍບໍ່ເຕືອນທ່ານ</translation>
<translation id="1769661297620183092">ທ່ານສາມາດເປີດແຜງ Google ຊອກຫາຄືນໃໝ່ເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="6555789357989792722">ປ່ອຍໃຫ້ Optimium ແລ່ນຢູ່ໃນພື້ນຫຼັງ</translation>
<translation id="627441522449241646">ເພື່ອເຮັດໃຫ້ Optimium ປອດໄພຂຶ້ນ, ພວກເຮົາປິດໃຊ້ງານບາງສ່ວນຂະຫຍາຍທີ່ບໍ່ໄດ້ມີລາຍຊື່ຢູ່ໃນ <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ແລະອາດຈະຖືກເພີ່ມເຂົ້າໂດຍທີ່ທ່ານບໍ່ຮູ້ຈັກ.</translation>
<translation id="1912380661217770781">ຄລິກ <ph name="BEGIN_BOLD" />ແມ່ນ<ph name="END_BOLD" /> ໃນການແຈ້ງເຕືອນ Windows ເພື່ອປັກໝຸດ Optimium ໄວ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານເພື່ອການເຂົ້າເຖິງດ່ວນ.</translation>
<translation id="9034578483087384251">ຕິດຕັ້ງ Optimium ຄືນໃໝ່</translation>
<translation id="2856362667064664106">Optimium ກຳລັງພະຍາຍາມໃຊ້ <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="1665590461646883113"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງດ້ວຍ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບສ່ວນຂະຫຍາຍ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" /> ນຳ.</translation>
<translation id="1668665535355826445">ເທື່ອຕໍ່ໄປທີ່ທ່ານເປີດ Optimium ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ, ທ່ານຈະເຫັນຂໍ້ຄວາມແຈ້ງໃຫ້ໃຊ້ຕົວຈັດການລະຫັດຜ່ານ Google.</translation>
<translation id="1838374766361614909">ລຶບ​ການ​ຊອກ​ຫາ</translation>
<translation id="8674417702521959187">ເພື່ອລຶບຂໍ້ມູນການທ່ອງເວັບໃນອຸປະກອນນີ້ເທົ່ານັ້ນ, ແຕ່ຍັງຮັກສາຂໍ້ມູນດັ່ງກ່າວໄວ້ໃນບັນຊີ Google ຂອງທ່ານ, ໃຫ້ <ph name="BEGIN_LINK" />ອອກຈາກລະບົບ Optimium<ph name="END_LINK" />.</translation>
<translation id="6186721318460238018">ດາວໂຫຼດ Optimium ຢູ່ໂທລະສັບຂອງທ່ານເພື່ອເປີດ ຫຼື ສ້າງກຸ່ມແຖບໃໝ່ໄດ້ທຸກບ່ອນທຸກເວລາ.</translation>
<translation id="185970820835152459">ທ່ານສາມາດຈັດການບັນຊີ Google ທີ່ເຂົ້າສູ່ລະບົບແລ້ວຂອງທ່ານໄດ້. ບັນຊີ Google ຂອງທ່ານແມ່ນໃຊ້ສຳລັບໂປຣແກຣມທ່ອງເວັບ Chromium, Play Store, Gmail ແລະ ອື່ນໆ. ຫາກທ່ານຕ້ອງການເພີ່ມບັນຊີໃຫ້ຄົນອື່ນ ເຊັ່ນ: ສະມາຊິກຄອບຄົວ, ໃຫ້ເພີ່ມຄົນໃໝ່ໃສ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານແທນ. <ph name="LINK_BEGIN" />ສຶກສາເພີ່ມເຕີມ<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">ຊອກຫາດ້ວຍການຊອກຫາຮູບ</translation>
<translation id="1781731701613313704"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບບຸກມາກ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" /> ນຳ.</translation>
<translation id="1880677175115548835">ເລືອກຂໍ້ຄວາມ</translation>
<translation id="5960850334733792580">ທ່ານກໍາລັງລົງຊື່ເຂົ້າ​ໃຊ້ດ້ວຍບັນຊີຄຸ້ມຄອງ ແລະໃຫ້ຜູ້ຄວບຄຸມຂອງມັນຄວບຄຸມໂປຣໄຟລ໌ Optimium ຂອງທ່ານ. ຂໍ້ມູນ Optimium ຂອງທ່ານ, ເຊັ່ນ: ແອັບ, ບຸກມາກສ໌, ປະຫວັດ, ລະຫັດຜ່ານ, ແລະການຕັ້ງຄ່າອື່ນໆຂອງທ່ານຈະຜູກ​ມັດ​ກັບ <ph name="USER_NAME" /> ຢ່າງຖາວອນ. ທ່ານຈະສາມາດລຶບຂໍ້ມູນນີ້ໄດ້ຜ່ານ Google Accounts Dashboard, ແຕ່ທ່ານຈະບໍ່ສາມາດເອົາຂໍ້ມູນນີ້ເຂົ້າຮ່ວມກັບບັນຊີອື່ນໄດ້. ​ໂດຍ​ເລືອກ​ໄດ້ ທ່ານ​ສາມາດ​ສ້າງໂປຣໄຟລ໌​ໃໝ່​ເພື່ອ​ຮັກສາ​ຂໍ້ມູນ Optimium ທີ່​ມີ​ຢູ່​ຂອງ​ທ່ານ​ແຍກ​ຕ່າງຫາກ. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium ຈະຊ່ວຍປະຢັດພະລັງງານແບັດເຕີຣີໂດຍການຈຳກັດກິດຈະກຳຢູ່ພື້ນຫຼັງ ແລະ ເອັບເຟັກພາບ ເຊັ່ນ: ການເລື່ອນທີ່ນຸ້ມນວນ ແລະ ອັດຕາເຟຣມວິດີໂອ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບຕົວປະຢັດພະລັງງານ<ph name="END_LINK" /></translation>
<translation id="7900167719031567542">ບໍລິການ Optimium Updater</translation>
<translation id="1911763535808217981">ໂດຍການປິດສິ່ງນີ້, ທ່ານສາມາດເຂົ້າສູ່ລະບົບເວັບໄຊຂອງ Google ເຊັ່ນ: Gmail ໄດ້ໂດຍບໍ່ຕ້ອງເຂົ້າສູ່ລະບົບ Chromium</translation>
<translation id="5015349619125768393">Optimium ບໍ່ຕອບຮັບ. ເລີ່ມເປີດໃຊ້ໃໝ່ດຽວນີ້ບໍ?</translation>
<translation id="2019000760486664637">ອົງກອນຂອງທ່ານ, <ph name="MANAGER" />, ກຳນົດໃຫ້ທ່ານເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="193439633299369377">ຈຳເປັນຕ້ອງຣີສະຕາດ ChromiumOS ເພື່ອນຳໃຊ້ການອັບເດດ.</translation>
<translation id="3382368450324191331">Optimium ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກໄຟລ໌ປະເພດນີ້ບໍ່ໄດ້ມີການດາວໂຫຼດໂດຍທົ່ວໄປ ແລະ ອາດເປັນອັນຕະລາຍ</translation>
<translation id="1953553007165777902">ກຳລັງດາວໂຫຼດ... ຍັງເຫຼືອ <ph name="MINUTE" /> ນາທີ</translation>
<translation id="1966382378801805537">Chromium ບໍ່ສາມາດກຳນົດ ຫຼື ຕັ້ງໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນໄດ້</translation>
<translation id="197326043290947695">ທ່ອງເວັບຢ່າງອັດສະລິຍະຂຶ້ນດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="5321661580966500942">ສຶກສາວ່າເປັນຫຍັງ Optimium ຈຶ່ງບລັອກບາງໄຟລ໌, ເປີດໃນແຖບໃໝ່</translation>
<translation id="8960045458031480819">ກະລຸນາອັບເດດຊອບແວ Optimium ໃຫ້ເປັນເວີຊັນຫຼ້າສຸດຢູ່ສະເໝີ. ຫາກປິດການນຳໃຊ້ ຫຼື ຢຸດບໍລິການນີ້, ຊອບແວ Optimium ຂອງທ່ານຈະບໍ່ໄດ້ຮັບການອັບເດດ, ເຊິ່ງໝາຍຄວາມວ່າຊ່ອງຫວ່າງດ້ານຄວາມປອດໄພທີ່ອາດເກີດຂຶ້ນຈະບໍ່ສາມາດແກ້ໄຂໄດ້ ແລະ ຄຸນສົມບັດອາດບໍ່ເຮັດວຽກ. ບໍລິການນີ້ຈະຖອນການຕິດຕັ້ງຕົວເອງເມື່ອບໍ່ມີຊອບແວ Optimium ນຳໃຊ້ຢູ່.</translation>
<translation id="2008474315282236005">ນີ້ຈະລຶບ 1 ລາຍການອອກຈາກອຸປະກອນນີ້. ເພື່ອກູ້ຂໍ້ມູນຂອງທ່ານຄືນໃນພາຍຫຼັງ, ກະລຸນາເຂົ້າສູ່ລະບົບ Chromium ເປັນ <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">ການຕິດຕັ້ງບໍ່ສຳເລັດ. ກະລຸນາລອງໃໝ່.</translation>
<translation id="2039417478970545937">ການຕັ້ງຄ່າ.</translation>
<translation id="2049376729098081731">ເລືອກວ່າຈະໃຫ້ຮວມປະຫວັດ Chromium ສຳລັບປະສົບການທີ່ປັບແຕ່ງສ່ວນຕົວໃນບໍລິການ Google ຫຼືບໍ່</translation>
<translation id="4120951192672345208">ຕິດຕັ້ງມາໃນ Optimium ເພື່ອຊ່ວຍທ່ານສ້າງ, ບັນທຶກ ແລະ ຕື່ມຂໍ້ມູນລະຫັດຜ່ານຍາກໂດຍອັດຕະໂນມັດ. ເພີ່ມທາງລັດເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ງ່າຍ.</translation>
<translation id="2060311596979880693">ສຳເລັດແລ້ວ! ຕອນນີ້ທ່ານສາມາດຖາມຄຳຖາມໄດ້ຢ່າງງ່າຍດາຍໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບດ້ວຍ Google ຊອກຫາໃນ Chrome</translation>
<translation id="7165258062917217746">ຄລິກປຸ່ມປັບແຕ່ງ Optimium ຢູ່ໜ້າແຖບໃໝ່ເພື່ອໃຫ້ Optimium ມີຮູບລັກໃໝ່</translation>
<translation id="3702823791268559760">Optimium ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກໄຟລ໌ມີການຫຼອກລວງ ແລະ ອາດເຮັດການປ່ຽນແປງທີ່ບໍ່ຄາດຄິດກັບອຸປະກອນຂອງທ່ານ</translation>
<translation id="2370804817835146114">ທ່ານຈະເຫັນຂໍ້ຄວາມແຈ້ງໃຫ້ລອງໃຊ້ <ph name="FEATURE_NAME" /> ໃນເທື່ອຕໍ່ໄປທີ່ທ່ານເປີດ Optimium ຢູ່ iOS.</translation>
<translation id="5887094242311035059">ລະບົບຈະລຶບລະຫັດຜ່ານຂອງທ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງ Optimium ທີ່ທ່ານບັນທຶກໄວ້ໃນບັນຊີ Google ຂອງທ່ານອອກຈາກອຸປະກອນນີ້. ເພື່ອໃຊ້ຂໍ້ມູນເຫຼົ່ານີ້ໃນ Optimium, ໃຫ້ເຂົ້າສູ່ລະບົບອີກຄັ້ງ.</translation>
<translation id="8794268168383660193">{COUNT,plural, =1{ອົງກອນຂອງທ່ານຈະລຶບຂໍ້ມູນການທ່ອງເວັບອອກໂດຍອັດຕະໂນມັດເມື່ອບໍ່ໄດ້ໃຊ້ Optimium ເປັນເວລາ 1 ນາທີ. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ. ແຖບຂອງທ່ານຈະຍັງເປີດຢູ່.}other{ອົງກອນຂອງທ່ານຈະລຶບຂໍ້ມູນການທ່ອງເວັບອອກໂດຍອັດຕະໂນມັດເມື່ອບໍ່ໄດ້ໃຊ້ Optimium ເປັນເວລາ # ນາທີ. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ. ແຖບຂອງທ່ານຈະຍັງເປີດຢູ່.}}</translation>
<translation id="2125838419757773031">ເລືອກພື້ນທີ່ໜ້າຈໍເພື່ອຊອກຫາ</translation>
<translation id="2126108037660393668">ໄຟລ໌ທີ່ດາວໂຫຼດໄວ້ບໍ່ຜ່ານການຢັ້ງຢືນ.</translation>
<translation id="2135919691573380097">ລາຍງານເວັບໄຊນີ້</translation>
<translation id="2137162749895930932">ປິດໜ້າຈໍແປພາສາ</translation>
<translation id="2147218225094845757">ເຊື່ອງແຜງຄວບຄຸມດ້ານຂ້າງ</translation>
<translation id="8888656790178891761">Optimium ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກເວັບໄຊບໍ່ໄດ້ໃຊ້ການເຊື່ອມຕໍ່ທີ່ປອດໄພ ແລະ ໄຟລ໌ອາດມີການດັດແປງ</translation>
<translation id="2170098639895543546">ເລືອກສິ່ງໃດກໍໄດ້ໃນໜ້າ</translation>
<translation id="6975401993318112971">ປັບແຕ່ງ Optimium</translation>
<translation id="2174917724755363426">ການຕິດຕັ້ງບໍ່ສຳເລັດ. ທ່ານແນ່ໃຈບໍ່ວ່າທ່ານຕ້ອງການຍົກເລີກ?</translation>
<translation id="7741769305753410467">Optimium - ການເຂົ້າສູ່ລະບົບເຄືອຂ່າຍ - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">ກວດສອບການອັບເດດຜິດພາດ: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2133097742403140075">ລຶບບັນຊີອອກຈາກ Optimium</translation>
<translation id="6495056863394621013">ໃຊ້ແອັບ Optimium ເພື່ອນຳເຄື່ອງມືການຊື້ເຄື່ອງທີ່ດີທີ່ສຸດໄປໄດ້ທຸກບ່ອນທຸກເວລາ</translation>
<translation id="2209877494277346829">ແຍກ Chromium ອອກຈາກແອັບອື່ນໆ</translation>
<translation id="2035198300681156782">ປອດໄພຍິ່ງຂຶ້ນໃນໂໝດເວລາເດີນທາງດ້ວຍ Safe Browsing ທີ່ປັບປຸງດີຂຶ້ນຢູ່ Optimium ສໍາລັບ iOS</translation>
<translation id="2210682093923538346">ເວັບໄຊທີ່ເປັນອັນຕະລາຍ. Chromium ໄດ້ລຶບສິດເຂົ້າເຖິງການແຈ້ງເຕືອນອອກແລ້ວ.</translation>
<translation id="2236949375853147973">ການເຄື່ອນໄຫວຂອງຂ້ອຍ</translation>
<translation id="871771486544954531">ເພື່ອຮັບທີ່ຢູ່ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium. ລະບົບຈະບັນທຶກທີ່ຢູ່ນີ້ໄວ້ໃນບັນຊີ Google ຂອງທ່ານຫຼັງຈາກທີ່ທ່ານເຂົ້າສູ່ລະບົບ.</translation>
<translation id="524316078518338158">ຖ້າທ່ານແຊຣ໌ຄອມພິວເຕີ, ໝູ່​ເພື່ອນ ແລະຄອບຄົວຂອງທ່ານ ສາມາດທ່ອງເນັດໄດ້ແຍກຕ່າງຫາກ ແລະຕັ້ງ Optimium ໄດ້ຕາມ​ແບບທີ່ພວກເຂົາຕ້ອງການ.</translation>
<translation id="22571759390241347">ທັກສະໃນ Chromium</translation>
<translation id="2283228908180457226">ໄອຄອນໃໝ່, ທາງລັດເກົ່າ: ຄລິກເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບດ້ວຍແຜງຄວບຄຸມດ້ານຂ້າງຂອງ Google ຊອກຫາ.</translation>
<translation id="2283803047247799269">ຊອກຫາແຖບນີ້ດ້ວຍການຊອກຫາຮູບ</translation>
<translation id="5808794606375505413">{NUM_TABS,plural, =1{Optimium ແນະນຳໃຫ້ຢຸດແຖບທີ່ເຮັດໃຫ້ໂປຣແກຣມທ່ອງເວັບຂອງທ່ານເຮັດວຽກຊ້າລົງຊົ່ວຄາວ}other{Optimium ແນະນຳໃຫ້ຢຸດແຖບທີ່ເຮັດໃຫ້ໂປຣແກຣມທ່ອງເວັບຂອງທ່ານເຮັດວຽກຊ້າລົງຊົ່ວຄາວ}}</translation>
<translation id="2307973900865360088">ເກັບໄວ້ໃນດັອກ</translation>
<translation id="2313870531055795960">ກວດສອບ URL ກັບລາຍຊື່ເວັບໄຊທີ່ບໍ່ປອດໄພທີ່ຈັດເກັບໄວ້ໃນ Chromium. ຖ້າມີເວັບໄຊໃດໜຶ່ງພະຍາຍາມລັກເອົາລະຫັດຜ່ານຂອງທ່ານ ຫຼື ເມື່ອທ່ານດາວໂຫຼດໄຟລ໌ອັນຕະລາຍ, Chromium ອາດສົ່ງ URL, ຮວມທັງເນື້ອຫາບາງສ່ວນຂອງໜ້າໄປໃຫ້ Safe Browsing.</translation>
<translation id="2356070529366658676">ຖາມ</translation>
<translation id="2359808026110333948">ສືບຕໍ່</translation>
<translation id="7000103009822967939">ສ່ວນຂະຫຍາຍ "<ph name="EXTENSION_NAME" />" ຕ້ອງການໃຫ້ທ່ານເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="184381469736757112">ປິດການນຳໃຊ້ Optimium ທີ່ເຮັດວຽກໃນພື້ນຫຼັງສຳລັບແອັບ</translation>
<translation id="5141894774016157674">ເພື່ອໃຊ້ສ່ວນຂະຫຍາຍນີ້ດ້ວຍ <ph name="USER_EMAIL_ADDRESS" />, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium.</translation>
<translation id="2384373936468275798">ChromiumOS ບໍ່ສາມາດຊິ້ງຂໍ້ມູນຂອງທ່ານໄດ້ເນື່ອງຈາກລາຍລະອຽດການເຂົ້າສູ່ລະບົບຂອງທ່ານເກົ່າແລ້ວ.</translation>
<translation id="2523694910556579068">{NUM_DEVICES,plural, =0{ມີສ່ວນຂະຫຍາຍ Optimium ຢ່າງໜ້ອຍ 1 ລາຍການກຳລັງເຂົ້າເຖິງອຸປະກອນ HID 1 ເຄື່ອງ}=1{ມີສ່ວນຂະຫຍາຍ Optimium ຢ່າງໜ້ອຍ 1 ລາຍການກຳລັງເຂົ້າເຖິງອຸປະກອນ HID 1 ເຄື່ອງ}other{ມີສ່ວນຂະຫຍາຍ Optimium ຢ່າງໜ້ອຍ 1 ລາຍການກຳລັງເຂົ້າເຖິງອຸປະກອນ HID # ເຄື່ອງ}}</translation>
<translation id="2899976927368522713">Optimium ຕ້ອງການການອະນຸຍາດກ້ອງຖ່າຍຮູບ ແລະ ໄມໂຄຣໂຟນສຳລັບເວັບໄຊນີ້</translation>
<translation id="2403703063067034158">ສະຕາດອັບຜິດພາດ: ຂະນະນີ້ມີການຕັ້ງຄ່າອື່ນກຳລັງເຮັດວຽກຢູ່, ກະລຸນາລອງໃໝ່ພາຍຫຼັງ.</translation>
<translation id="8530786035410512232">ເປີດລິ້ງໃນ Optimium ຈາກແອັບໃດກໍໄດ້ ແລະ ເຮັດໃຫ້ໂປຣແກຣມທ່ອງເວັບເຂົ້າເຖິງໄດ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານ</translation>
<translation id="5645058843566501763">ຄລິກປຸ່ມສະຫຼຸບເພື່ອແບ່ງປັນເອກະສານນີ້ກັບ Gemini ໃນ Optimium ເພື່ອເບິ່ງພາບຮວມໂດຍຫຍໍ້ ແລະ ຖາມຄຳຖາມຕິດຕາມຜົນ</translation>
<translation id="2440750600860946460">ດ້ວຍ <ph name="BEGIN_LINK" />ເຄື່ອງມືຈາກ Chromium<ph name="END_LINK" />, ທ່ານຈະສາມາດທ່ອງເວັບໄດ້ຢ່າງປອດໄພ ແລະ ຄວບຄຸມສິ່ງຕ່າງໆໄດ້</translation>
<translation id="5384013849288198705"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະຮັບລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານໄດ້ນຳ.</translation>
<translation id="2451727308784734061">ໃຊ້ທາງລັດຂອງທ່ານເພື່ອເຂົ້າຫາຕົວຈັດການລະຫັດຜ່ານຢ່າງວ່ອງໄວ. ທ່ານສາມາດຍ້າຍທາງລັດຂອງທ່ານໄປຫາໜ້າຈໍຫຼັກຂອງຄອມພິວເຕີ ຫຼື ຕົວເປີດແອັບຂອງທ່ານໄດ້.</translation>
<translation id="4074322039453189342">Optimium ຈະປິດໃນໄວໆນີ້</translation>
<translation id="4239399282729309306">ໃນ Optimium</translation>
<translation id="2485422356828889247">ຖອນ​ຕິດ​ຕັ້ງ</translation>
<translation id="2513154137948333830">ຕ້ອງປິດເປີດໃໝ່: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2521391734665471391">ປິດໂໝດ AI ຂອງ Google ຊອກຫາ</translation>
<translation id="2542968102051442371">ເລືອກຂໍ້ຄວາມດ້ວຍການຊອກຫາຮູບ</translation>
<translation id="7238239459452345825">Optimium ກຳລັງພະຍາຍາມປ່ຽນແທນລະຫັດຜ່ານທີ່ມີຢູ່. ພິມລະຫັດຜ່ານ Windows ຂອງທ່ານໃສ່ເພື່ອອະນຸຍາດສິ່ງນີ້.</translation>
<translation id="5059411697679064446">Optimium ຕ້ອງການເຂົ້າເຖິງບ່ອນເກັບຂໍ້ມູນເພື່ອດາວໂຫຼດໄຟລ໌</translation>
<translation id="5959299320608819381">ຜູ້​ຊ່ວຍ Optimium</translation>
<translation id="2575822587468774919">ເລືອກຫຍັງກໍໄດ້ເພື່ອຊອກຫາດ້ວຍການຊອກຫາຮູບ</translation>
<translation id="8063772441784541423">ເພື່ອຮັບລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="3112793931795471365">ສະແກນລະຫັດ QR ດ້ວຍໂທລະສັບຂອງທ່ານເພື່ອດາວໂຫຼດ Optimium ແລະ ເຂົ້າສູ່ລະບົບບັນຊີ Google ຂອງທ່ານ.</translation>
<translation id="1584670114556742260">ເພື່ອຊອກຫາດ້ວຍ Optimium.</translation>
<translation id="2680687985294820735">ສືບຕໍ່ນຳໃຊ້ Optimium</translation>
<translation id="259935314519650377">ການແຄສຕົວຕິດຕັ້ງທີ່ດາວໂຫຼດໄວ້ບໍ່ສຳເລັດ. ຂໍ້ຜິດພາດ: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">ລະ​ບົບ</translation>
<translation id="7753906894780562903">ອົງກອນຂອງທ່ານສາມາດເບິ່ງ ແລະ ຈັດການຂໍ້ມູນການທ່ອງເວັບ ເຊັ່ນ: ບຸກມາກ, ປະຫວັດ ແລະ ລະຫັດຜ່ານຂອງທ່ານໄດ້. ແຕ່ຈະບໍ່ເຫັນຂໍ້ມູນການທ່ອງເວັບໃນໂປຣໄຟລ໌ Optimium ອື່ນໆ</translation>
<translation id="3912526786507084695">ຢັ້ງຢືນວ່າມັນແມ່ນທ່ານທີ່ຈະໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ Optimium ໃນບັນຊີຂອງທ່ານ, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="1723346026518998062">{COUNT,plural, =0{ການປົກປ້ອງຂັ້ນສູງກຳນົດໃຫ້ທ່ານຕ້ອງເລີ່ມເປີດໃຊ້ Optimium ໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ}=1{ການປົກປ້ອງຂັ້ນສູງກຳນົດໃຫ້ທ່ານຕ້ອງເລີ່ມເປີດໃຊ້ Optimium ໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ການປົກປ້ອງຂັ້ນສູງກຳນົດໃຫ້ທ່ານຕ້ອງເລີ່ມເປີດໃຊ້ Optimium ໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານ # ລາຍການຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="1676939910504260523">ເລີ່ມ Optimium</translation>
<translation id="4524556064279918264">ເກີດຄວາມຜິດພາດດ້ານລະບົບປະຕິບັດການໃນລະຫວ່າງການຕິດຕັ້ງ. ກະລຸນາດາວໂຫຼດ Optimium ອີກ.</translation>
<translation id="1998551382060432430">ຖ້າທ່ານໃຊ້ອຸປະກອນຮ່ວມກັນ, ໝູ່ ແລະ ຄອບຄົວສາມາດທ່ອງເວັບແຍກຕ່າງຫາກ ແລະ ຕັ້ງຄ່າ Optimium ໃນແບບທີ່ເຂົາເຈົ້າຕ້ອງການໄດ້</translation>
<translation id="5180414833025415316">ເຂົ້າເຖິງເພື່ອໃຊ້ Gemini ໃນ Optimium ໃນອຸປະກອນຕ່າງໆຂອງທ່ານໄດ້ຢ່າງງ່າຍດາຍ, ເຖິງແມ່ນວ່າຈະຫຍໍ້ Optimium ຢູ່.</translation>
<translation id="5895170254499246640">ແຖບ Optimium</translation>
<translation id="2718390899429598676">ເພື່ອຄວາມປອດໄພເພີ່ມເຕີມ, Chromium ຈະເຂົ້າລະຫັດຂໍ້ມູນຂອງທ່ານ.</translation>
<translation id="6684098000857849465">ເພື່ອລຶບບັນຊີ Google ຂອງທ່ານອອກຈາກ Optimium, ໃຫ້ອອກຈາກລະບົບ</translation>
<translation id="8035579362848370000">ເພື່ອເຂົ້າເຖິງລະຫັດຜ່ານ, ບຸກມາກ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="2738871930057338499">ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບອິນເຕີເນັດໄດ້. HTTP 403 ຖືກຫ້າມ. ກະລຸນາກວດສອບການຕັ້ງຄ່າພຣັອກຊີຂອງທ່ານ.</translation>
<translation id="2753623023919742414">ຄລິກເພື່ອຊອກຫາ</translation>
<translation id="6013736131971103780">ຕັ້ງຄ່າ Optimium ເປັນໂປຣແກຣມອ່ານ PDF ເລີ່ມຕົ້ນຂອງທ່ານ</translation>
<translation id="218391145495840504">ສ່ວນຂະຫຍາຍນີ້ມີເມົາແວ ແລະ ບໍ່ປອດໄພ. ລຶບສ່ວນຂະຫຍາຍດັ່ງກ່າວອອກຈາກ Optimium ເພື່ອບໍ່ໃຫ້ເບິ່ງ ແລະ ປ່ຽນຂໍ້ມູນຂອງທ່ານຢູ່ເວັບໄຊທີ່ທ່ານເຂົ້າເບິ່ງ, ເຊິ່ງຮວມເຖິງຂໍ້ມູນສ່ວນຕົວຂອງທ່ານ.</translation>
<translation id="2799223571221894425">ເລີ່ມເປີດໃຊ້ໃໝ່</translation>
<translation id="8757776333711121842">Optimium ຂອງທ່ານ</translation>
<translation id="2816462166102338036">ຊອກຫາວິດີໂອນີ້ດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="5977650568712460613">ຄົ້ນພົບຜະລິດຕະພັນດ້ວຍກ້ອງຂອງທ່ານ, ຕິດຕາມລາຄາທີ່ຫຼຸດລົງ ແລະ ອື່ນໆໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍ Optimium ຢູ່ iOS.</translation>
<translation id="2841525013647267359">ແປຈາກພາສາ</translation>
<translation id="2846251086934905009">ຂໍ້ຜິດພາດໃນການຕິດຕັ້ງ: ຕົວຕິດຕັ້ງເຮັດວຽກໄດ້ບໍ່ສົມບູນ. ຍົກເລີກການຕິດຕັ້ງແລ້ວ.</translation>
<translation id="7445294455857704594">ເອົາ​ອອກ​ຈາກ Optimium...</translation>
<translation id="2850691299438350830">ຮັກສາຄວາມປອດໄພຂອງທ່ານໃນ Chromium ແລະ ອາດຖືກໃຊ້ເພື່ອປັບປຸງຄວາມປອດໄພຂອງທ່ານໃນແອັບ Google ອື່ນໆເມື່ອທ່ານເຂົ້າສູ່ລະບົບ.</translation>
<translation id="2876152561415416331">ເປີດແຜງ Google ຊອກຫາຄືນໃໝ່</translation>
<translation id="2885378588091291677">ຕົວຈັດການໜ້າວຽກ</translation>
<translation id="8130920144001221645">ກ່ຽວ​ກັບ​ Optimium</translation>
<translation id="2915996080311180594">ຣິສະຕາດໃນພາຍຫຼັງ</translation>
<translation id="5422843128705358539">ຂໍ້ມູນຂອງທ່ານໄດ້ຖືກເຂົ້າລະຫັດໄວ້ດ້ວຍລະຫັດຜ່ານຂອງທ່ານ. ລະບຸລະຫັດຜ່ານເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ Optimium ໃນບັນຊີ Google ຂອງທ່ານ.</translation>
<translation id="2945997411976714835">ຂໍ້ຜິດພາດໃນການຕິດຕັ້ງ: ເລີ່ມຂັ້ນຕອນຂອງຕົວຕິດຕັ້ງບໍ່ສຳເລັດ.</translation>
<translation id="7644909281692978299">ເຂົ້າສູ່ລະບົບເວັບໄຊໄວຂຶ້ນໂດຍໃຊ້ລະຫັດຜ່ານທີ່ບັນທຶກໄວ້ສຳລັບ Optimium ຢູ່ iOS</translation>
<translation id="6715328262141930431">ອົງການຂອງທ່ານຈັດການ Optimium</translation>
<translation id="2977470724722393594">Chromium ແມ່ນເວີຊັນໃໝ່ຫຼ້າສຸດແລ້ວ</translation>
<translation id="2977506796191543575">ຖ້າມີເວັບໄຊໃດໜຶ່ງພະຍາຍາມລັກເອົາລະຫັດຜ່ານຂອງທ່ານ ຫຼື ເມື່ອທ່ານດາວໂຫຼດໄຟລ໌ອັນຕະລາຍ, Chromium ອາດສົ່ງ URL, ຮວມທັງເນື້ອຫາບາງສ່ວນຂອງໜ້າໄປໃຫ້ Safe Browsing</translation>
<translation id="3373190939774209520">ເພື່ອທ່ອງໂລກອອນລາຍຢ່າງປອດໄພຍິ່ງຂຶ້ນດ້ວຍຕົວເລືອກຂອງຜູ້ປົກຄອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບໃນ Optimium</translation>
<translation id="2992577225802060159">ປົກປ້ອງໜ່ວຍຄວາມຈຳຂອງ Chromium ຈາກແອັບພລິເຄຊັນອື່ນໆໃນຄອມພິວເຕີຂອງທ່ານ.</translation>
<translation id="3003694935412297923">ໜ້າວຽກທັງໝົດ</translation>
<translation id="2169110625780321257">{count,plural, =1{Optimium ຕ້ອງການຢັ້ງຢືນວ່າແມ່ນທ່ານແທ້ກ່ອນຈະສາມາດບັນທຶກຂໍ້ມູນບາງຢ່າງໃນບັນຊີ Google ຂອງທ່ານ ແລະ ໃຊ້ຢູ່ອຸປະກອນຂອງທ່ານທັງໝົດໄດ້. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ (1 ລາຍການ) ຈະຖືກລຶບ.}other{Optimium ຕ້ອງການຢັ້ງຢືນວ່າແມ່ນທ່ານແທ້ກ່ອນຈະສາມາດບັນທຶກຂໍ້ມູນບາງຢ່າງໃນບັນຊີ Google ຂອງທ່ານ ແລະ ໃຊ້ຢູ່ອຸປະກອນຂອງທ່ານທັງໝົດໄດ້. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ ({count} ລາຍການ) ຈະຖືກລຶບ.}}</translation>
<translation id="535155819036938485">ເປີດ <ph name="URL" /> ໃນແຖບໃໝ່ໃນ Optimium.</translation>
<translation id="302551344979399011">ລະບົບຈະບັນທຶກນະວັດຕະກຳ AI ເຊັ່ນ: ທັກສະ ໄວ້ໃນບັນຊີ Google ຂອງທ່ານ ແລະ ຈັດການແຍກຕ່າງຫາກຈາກ Chromium Sync</translation>
<translation id="69529237724150463">ເພື່ອເຂົ້າເຖິງສ່ວນຂະຫຍາຍ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="1699367992046240140">ກໍາລັງເພີ່ມ Optimium...</translation>
<translation id="3034219227076811559">Google ຊອກຫາໃນ Chrome</translation>
<translation id="3037190258341683404">ທ່ານສາມາດປັກໝຸດ Google ຊອກຫາໃນ Chrome ເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="3038232873781883849">ກຳ​ລັງ​ລໍ​ຖ້າ​ຕິດ​ຕັ້ງ...</translation>
<translation id="3045032126857188731">ພາສາທີ່ແປ: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">ປິດກ່ອງໂຕ້ຕອບຄຳຕິຊົມ</translation>
<translation id="7641708778616103377"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງດ້ວຍ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບລາຍຊື່ການອ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" /> ນຳ.</translation>
<translation id="1759532319192341458">ໂປຣໄຟລ໌ Optimium ອື່ນ</translation>
<translation id="2862149341123916634">ສ່ວນຂະຫຍາຍແມ່ນສ່ວນເສີມທີ່ຊ່ວຍໃຫ້ທ່ານປັບແຕ່ງ Optimium ໄດ້. ຕັ້ງແຕ່ການຈັດລະບຽບໄປຈົນຮອດການເຮັດໃຫ້ໜ້າວຽກປະຈຳວັນງ່າຍຂຶ້ນ, ສ່ວນຂະຫຍາຍຊ່ວຍໃຫ້ທ່ານປັບແຕ່ງ Optimium ໃຫ້ເປັນຂອງທ່ານເອງໄດ້.</translation>
<translation id="9144026989666254609">ຊ່ວຍເຮັດໃຫ້ Optimium ດີຂຶ້ນໂດຍການສົ່ງລາຍງານການ​ຂັດຂ້ອງ ແລະ  <ph name="UMA_LINK" />  ຫາ Google.</translation>
<translation id="4449472527250709676">ໃຊ້ແອັບ Optimium ເພື່ອນຳຄວາມປອດໄພຂອງ Google ໄປໄດ້ທຸກບ່ອນທຸກເວລາ</translation>
<translation id="6183456495642882201">{NUM_DEVICES,plural, =0{ມີສ່ວນຂະຫຍາຍ Optimium ຢ່າງໜ້ອຍ 1 ລາຍການກຳລັງເຂົ້າເຖິງອຸປະກອນ USB 1 ເຄື່ອງ}=1{ມີສ່ວນຂະຫຍາຍ Optimium ຢ່າງໜ້ອຍ 1 ລາຍການກຳລັງເຂົ້າເຖິງອຸປະກອນ USB 1 ເຄື່ອງ}other{ມີສ່ວນຂະຫຍາຍ Optimium ຢ່າງໜ້ອຍ 1 ລາຍການກຳລັງເຂົ້າເຖິງອຸປະກອນ USB # ເຄື່ອງ}}</translation>
<translation id="7419486418212185022">ເພື່ອເຂົ້າເຖິງລາຍຊື່ການອ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" />, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="4481023367748355854">ປະຫວັດ Optimium</translation>
<translation id="6289574887308484514">ຕົວຕິດຕັ້ງບໍ່ສາມາດ​ຄາຍ​ການບີບອັດຄັງເກັບມ້ຽນ. ກະລຸນາດາວໂຫຼດ Optimium ອີກ.</translation>
<translation id="310459126943037700">ເຮັດໃຫ້ໜ້າວຽກສິ້ນສຸດບໍ່ສຳເລັດ.</translation>
<translation id="3104828284009500087">ຊອກຫາສິ່ງຕ່າງໆຢູ່ໜ້າເວັບ</translation>
<translation id="1866751185142421235">ຊິ້ງລະຫັດຜ່ານ, ບຸກມາກ ແລະ ປະຫວັດຂອງທ່ານໃນອຸປະກອນຕ່າງໆໄດ້ຢ່າງສົມບູນແບບ. ເຂົ້າເຖິງຄຸນສົມບັດທີ່ທ່ານຮູ້ຈັກ ແລະ ມັກໄດ້ຢ່າງງ່າຍດາຍໂດຍອັບເດດໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານເປັນ Optimium.</translation>
<translation id="7071720283847574213">Optimium ກໍາລັງໃຊ້​ໄມໂຄຣໂຟນຂອງ​ທ່ານ​.</translation>
<translation id="3130333203120345554">ຊອກຫາໃໝ່</translation>
<translation id="3137969841538672700">ລາກເພື່ອຊອກຫາ</translation>
<translation id="8832375982733310873">ແຖບນີ້ກຳລັງໃຊ້ຊັບພະຍາກອນເພີ່ມເຕີມ. ເພື່ອປັບປຸງປະສິດທິພາບຂອງທ່ານ, ໃຫ້ Optimium ຊ່ວຍເຮັດໃຫ້ມັນບໍ່ເຮັດວຽກ.</translation>
<translation id="7212905776009358992">ເພື່ອແບ່ງປັນໜ້າຈໍຂອງທ່ານ, ໃຫ້ອະນຸຍາດການບັນທຶກໜ້າຈໍສຳລັບ Optimium ໃນການຕັ້ງຄ່າລະບົບ</translation>
<translation id="7220401039380362840">ປິດແລ້ວເປີດ Optimium ຄືນໃໝ່</translation>
<translation id="3161522574479303604">ທຸກ​ພາ​ສາ</translation>
<translation id="2945128209475147845">ເປີດລິ້ງໃນໜ້າຈໍທີ່ບໍ່ເຜີຍຕົວຕົນຂອງ Optimium</translation>
<translation id="5550841702580813851">ປັບແຕ່ງໂປຣໄຟລ໌ Optimium ໃໝ່ຂອງທ່ານ</translation>
<translation id="6179644101029308447">ທ່ານສາມາດສົນທະນາກັບໂໝດ AI ຕໍ່ໄປໄດ້ໂດຍບໍ່ຕ້ອງສະຫຼັບແຖບ. ເພື່ອເລີ່ມຕົ້ນ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium. ນອກຈາກນີ້, ທ່ານຍັງຈະຮັບລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານໄດ້ນຳ.</translation>
<translation id="5843425624301789054">ເພື່ອລຶບບັນຊີ Google ຂອງທ່ານອອກຈາກ Optimium, ໃຫ້ອອກຈາກລະບົບ Optimium ໃນໜ້າການຕັ້ງຄ່າ</translation>
<translation id="3234316605225071811">ຕໍ່ມາ, Chromium ຈະສາມາດຖາມວ່າທ່ານຕ້ອງການໃຊ້ຂໍ້ມູນທີ່ບັນທຶກໄວ້ເພື່ອຕື່ມແບບຟອມໃຫ້ທ່ານຫຼືບໍ່</translation>
<translation id="3381027830404501211">Optimium ບໍ່ສາມາດອ່ານ ແລະຂຽນໄປໃສ່ໄດເຣັກຕໍຣີຂໍ້ມູນຂອງມັນໄດ້:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="8146675538658659954">ນຳເຄື່ອງມື Google AI ທີ່ທ່ານມັກໄປໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍ Optimium ຢູ່ iOS.</translation>
<translation id="6800117212942659992">ເພື່ອເຂົ້າເຖິງສ່ວນຂະຫຍາຍ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" />, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="1315108685137442441">{COUNT,plural, =1{ມີການອັບເດດໃໝ່ສຳລັບ Optimium ແລະ ຈະນຳໃຊ້ໃນທັນທີທີ່ທ່ານເປີດໃຊ້ຄືນໃໝ່. ໜ້າຈໍແຍກຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ມີການອັບເດດໃໝ່ສຳລັບ Optimium ແລະ ຈະນຳໃຊ້ໃນທັນທີທີ່ທ່ານເປີດໃຊ້ຄືນໃໝ່. ໜ້າຈໍແຍກ # ລາຍການຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="3286538390144397061">ປິດເປີດໃໝ່ດຽວນີ້</translation>
<translation id="2161039902967573767">ລະຫັດ Google API ຫາຍໄປ. ການເຮັດໜ້າທີ່ບາງອັນຂອງ Optimium ຈະປິດໃຊ້ງານ.</translation>
<translation id="3296368748942286671">ສືບຕໍ່ແລ່ນແອັບພື້ນຫຼັງ ເມື່ອ Chromium ປິດ</translation>
<translation id="3313189106987092621">Chromium ຈະເຕືອນທ່ານກ່ອນການໂຫຼດເວັບໄຊໃດກໍຕາມທີ່ກຳລັງໃຊ້ການເຊື່ອມຕໍ່ທີ່ບໍ່ປອດໄພ</translation>
<translation id="1282007042347821406">ທ່ານຈະອອກຈາກລະບົບຂອງເວັບໄຊສ່ວນໃຫຍ່ເມື່ອທ່ານປິດໜ້າຈໍ Optimium ທັງໝົດຍົກເວັ້ນບັນຊີ Google ຂອງທ່ານຫາກທ່ານເຂົ້າສູ່ລະບົບ Optimium. ເພື່ອໃຫ້ເວັບໄຊຈື່ທ່ານໄດ້, ກະລຸນາ <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">ມຸມຂວາເທິງຂອງພື້ນທີ່ຊອກຫາ: ຂວາ <ph name="RIGHT" />%, ເທິງ <ph name="TOP" />%</translation>
<translation id="3366305173356742781">ຂໍ້ມູນ Chromium ໃນບັນຊີຂອງທ່ານ</translation>
<translation id="3798810966749973116">ໃຊ້ລະຫັດຜ່ານຂອງທ່ານກັບ Optimium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="3114385794555902051">ສະຫຼັບເປັນໂປຣໄຟລ໌ Optimium ທີ່ມີຢູ່ກ່ອນແລ້ວບໍ?</translation>
<translation id="3412460710772753638">ໃນຕົວຈັດການລະຫັດຜ່ານຢູ່ອຸປະກອນນີ້</translation>
<translation id="1395799713002454043">ເພື່ອເຂົ້າເຖິງບຸກມາກ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" />, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="3438772217992559640">ຊອກຫາແຖບນີ້ດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="1565712261560212491">ຂະຫຍາຍ Safe Browsing ທີ່ປັບປຸງດີຂຶ້ນດ້ວຍ Optimium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="7003115800241574875">ກຳລັງປັບແຕ່ງ Optimium ໃນແບບຂອງທ່ານ...</translation>
<translation id="3474745554856756813">ນີ້ຈະລຶບ <ph name="ITEMS_COUNT" /> ລາຍການອອກຈາກອຸປະກອນນີ້. ເພື່ອກູ້ຂໍ້ມູນຂອງທ່ານຄືນໃນພາຍຫຼັງ, ກະລຸນາເຂົ້າສູ່ລະບົບ Chromium ເປັນ <ph name="USER_EMAIL" />.</translation>
<translation id="1749327805708308979"><ph name="SHORTCUT" /> ສາມາດສະຫຼັບລະຫວ່າງໂປຣໄຟລ໌ Optimium ໄດ້</translation>
<translation id="7437253251955408447">ກະລຸນາປິດທຸກໜ້າຕ່າງ Optimium ແລະລອງໃໝ່ອີກ.</translation>
<translation id="4544226979083343619">ເພື່ອແບ່ງປັນໜ້າຈໍຂອງທ່ານ, ໃຫ້ອະນຸຍາດການບັນທຶກໜ້າຈໍສຳລັບ Optimium ໃນການຕັ້ງຄ່າລະບົບ</translation>
<translation id="7742324910239513884"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ.  ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງໃນຖານະ <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="8618656037793872415">ລະຫັດ QR ເພື່ອດາວໂຫຼດໂປຣແກຣມທ່ອງເວັບ Optimium ຢູ່ອຸປະກອນມືຖື</translation>
<translation id="354621070532799440">ການແຈ້ງເຕືອນ: ຄຸນສົມບັດດ້ານຄວາມປອດໄພທີ່ດີທີ່ສຸດຂອງ Google ໃນກະເປົາຂອງທ່ານ</translation>
<translation id="3043015282185018117">ເພື່ອແບ່ງປັນໜ້າຈໍຂອງທ່ານ, ໃຫ້ອະນຸຍາດການບັນທຶກໜ້າຈໍສຳລັບ Optimium ໃນການຕັ້ງຄ່າລະບົບ.</translation>
<translation id="3597003331831379823">ເອີ້ນໃຊ້ການຕັ້ງຄ່າດ້ວຍສິດທິພິເສດລະດັບສູງບໍ່ສຳເລັດ. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3261842649996827269">ເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="1140403329282632523">ຂໍ້ມູນການທ່ອງເວັບຂອງບຸກຄົນນີ້ຈະຖືກລຶບອອກຈາກອຸປະກອນນີ້. ເພື່ອກູ້ຂໍ້ມູນຄືນມາ, ກະລຸນາເຂົ້າສູ່ລະບົບ Optimium ເປັນ <ph name="USER_EMAIL" />.</translation>
<translation id="5228011645297638039">{COUNT,plural, =0{ມີການອັບເດດໃໝ່ສຳລັບ Optimium ແລະ ຈະນຳໃຊ້ໃນທັນທີທີ່ທ່ານເປີດໃຊ້ຄືນໃໝ່.}=1{ມີການອັບເດດໃໝ່ສຳລັບ Optimium ແລະ ຈະນຳໃຊ້ໃນທັນທີທີ່ທ່ານເປີດໃຊ້ຄືນໃໝ່. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ມີການອັບເດດໃໝ່ສຳລັບ Optimium ແລະ ຈະນຳໃຊ້ໃນທັນທີທີ່ທ່ານເປີດໃຊ້ຄືນໃໝ່. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານ # ລາຍການຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="3667616615096815454">ບໍ່ສາມາດຕິດຕັ້ງໄດ້, ເຊີບເວີບໍ່ຮູ້ຈັກແອັບພລິເຄຊັນ.</translation>
<translation id="3675854891107786059">ໃຊ້ <ph name="BEGIN_LINK" />ລະຫັດຜ່ານຂອງທ່ານເອງ<ph name="END_LINK" /> ໃນການເຂົ້າລະຫັດຂໍ້ມູນ Chromium ທັງໝົດໃນບັນຊີ Google ຂອງທ່ານ. ວິທີການຈ່າຍເງິນ ແລະ ທີ່ຢູ່ຈາກ Google Pay ຈະບໍ່ໄດ້ຖືກເຂົ້າລະຫັດໄວ້. ປະຫວັດການທ່ອງເວັບຈາກ Chromium ຈະບໍ່ຊິ້ງ.</translation>
<translation id="7861068783030138988">{COUNT,plural, =0{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານຮ້ອງຂໍໃຫ້ທ່ານເປີດ Optimium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດນີ້}=1{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານຮ້ອງຂໍໃຫ້ທ່ານເປີດ Optimium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດນີ້. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານຮ້ອງຂໍໃຫ້ທ່ານເປີດ Optimium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດນີ້. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານ # ລາຍການຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="8611928240945733486">ເປີດລິ້ງໃນແຖບ Optimium ໃໝ່</translation>
<translation id="3728124580182886854">ລິ້ງ Chromium ແລະ ບໍລິການອື່ນໆຂອງ Google ເພື່ອການປັບແຕ່ງເປັນແບບສ່ວນຕົວ ແລະ ຈຸດປະສົງອື່ນໆ</translation>
<translation id="3729187154190517324">ເຈາະເລິກການຊອກຫາຂອງທ່ານໂດຍການເພີ່ມແຖບ, ໄຟລ໌ ແລະ ເຄື່ອງມືຫຼາຍລາຍການໂດຍໃຊ້ປຸ່ມ "ເພີ່ມແຖບ ແລະ ອື່ນໆ".</translation>
<translation id="3032577647176321971">ຈັດການໂປຣໄຟລ໌ Optimium</translation>
<translation id="6314444399103340747">ສຶກສາວ່າເປັນຫຍັງ Optimium ຈຶ່ງບລັອກການດາວໂຫຼດບາງລາຍການ</translation>
<translation id="379589255253486813">Chromium ຈະແຈ້ງໃຫ້ທ່ານຮູ້ຫາກມີສິ່ງໃດທີ່ທ່ານຕ້ອງກວດສອບ</translation>
<translation id="3802055581630249637">Chromium ໂຫຼດໜ້າເວັບທີ່ທ່ານອາດຈະເຂົ້າເບິ່ງໄວ້ກ່ອນລ່ວງໜ້າ, ເພື່ອໃຫ້ພວກມັນໂຫຼດໄວຂຶ້ນເມື່ອທ່ານເຂົ້າເບິ່ງ</translation>
<translation id="3810973564298564668">ຈັດການ</translation>
<translation id="4301680230606686279">ເພື່ອໃຊ້ລະຫັດຜ່ານທີ່ບັນທຶກໄວ້ຂອງທ່ານ, ໃຫ້ເຂົ້າໄປຕາມລະຫັດ QR, ດາວໂຫຼດ Optimium ສຳລັບ iOS ແລ້ວເຂົ້າສູ່ລະບົບບັນຊີ Google ຂອງທ່ານ</translation>
<translation id="3846683726093018685">**ສະຫຼຸບ:** ໃນປະໂຫຍກດຽວທີ່ມີບໍ່ເກີນ 30 ຄຳ, ໃຫ້ອະທິບາຍເລື່ອງຫຼັກ ແລະ ຈຸດປະສົງຂອງເນື້ອຫາໃນຮູບໜ້າຈໍ.

          **ແນະນຳຄຳຖາມ:** ສ້າງລາຍຊື່ສັນຍາລັກຂອງຄຳຖາມກະຕຸ້ນຄວາມຄິດ 3-5 ຂໍ້ທີ່ຜູ້ໃຊ້ອາດຖາມເພື່ອສ້າງຄວາມເຂົ້າໃຈຮູບໜ້າຈໍໄດ້ດີຍິ່ງຂຶ້ນ. ຄຳຖາມເຫຼົ່ານີ້ຄວນມີຢ່າງໜ້ອຍ 1 ຂໍ້ທີ່ກ່ຽວກັບວັດຖຸພາບ, ການອອກແບບ ຫຼື ຕຳແໜ່ງຂອງວັດຖຸນັ້ນໂດຍສະເພາະ.</translation>
<translation id="3287167856630539345"><ph name="PAGE_TITLE" /> - Optimium</translation>
<translation id="3117512156333858342">ເພື່ອເຂົ້າເຖິງບຸກມາກ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="3511883131632987404">{COUNT,plural, =1{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານຮ້ອງຂໍໃຫ້ທ່ານເປີດ Optimium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດນີ້. ໜ້າຈໍແຍກຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານຮ້ອງຂໍໃຫ້ທ່ານເປີດ Optimium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດນີ້. ໜ້າຈໍແຍກ # ລາຍການຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="3885770153807205175">ຕົວເລືອກພາສາ</translation>
<translation id="7294070483192043494">ປັບແຕ່ງ ແລະ ຄວບຄຸມ Optimium. ມີບາງຢ່າງທີ່ທ່ານຕ້ອງດຳເນີນການ - ຄລິກສຳລັບລາຍລະອຽດ.</translation>
<translation id="7920927747111819647">ຄລິກ​ທີ່​ຊື່​ຂອງ​ທ່ານ​ເພື່ອ​ເປີດ Optimium ແລະ​ເລີ່ມ​ຕົ້ນທ່ອງເນັດ.</translation>
<translation id="3892148308691398805">ສຳເນົາຂໍ້ຄວາມ</translation>
<translation id="4454986649289930182"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບໂປຣໄຟລ໌ Optimium ນີ້ຢູ່ກ່ອນແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, Optimium ສາມາດສ້າງໂປຣໄຟລ໌ຂອງທ່ານເອງໃຫ້ທ່ານໄດ້.</translation>
<translation id="7225128703667880746">ສ່ວນຂະຫຍາຍນີ້ລະເມີດນະໂຍບາຍ Chrome Web Store ແລະ ອາດບໍ່ປອດໄພ. ລຶບສ່ວນຂະຫຍາຍດັ່ງກ່າວອອກຈາກ Optimium ເພື່ອບໍ່ໃຫ້ເບິ່ງ ແລະ ປ່ຽນຂໍ້ມູນຂອງທ່ານຢູ່ເວັບໄຊທີ່ທ່ານເຂົ້າເບິ່ງ, ເຊິ່ງຮວມເຖິງຂໍ້ມູນສ່ວນຕົວຂອງທ່ານ.</translation>
<translation id="3941890832296813527">ຂໍ້ຜິດພາດໃນການຕິດຕັ້ງ: ຊື່ໄຟລ໌ຂອງຕົວຕິດຕັ້ງບໍ່ຖືກຕ້ອງ ຫຼື ລະບົບບໍ່ຮອງຮັບ.</translation>
<translation id="6304622602441037994">Optimium ກໍາລັງພະຍາຍາມສຳເນົາລະຫັດຜ່ານ. ພິມລະຫັດຜ່ານ Windows ຂອງທ່ານ ເພື່ອອະນຸຍາດໃຫ້ສຳເນົາໄດ້.</translation>
<translation id="2274695480528598968">ເພື່ອເຂົ້າເຖິງຂໍ້ມູນທີ່ບັນທຶກໄວ້ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="1713567483777335359">ລະບົບຈະລຶບລະຫັດຜ່ານ, ວິທີການຈ່າຍເງິນ ແລະ ທີ່ຢູ່ທີ່ທ່ານບັນທຶກໄວ້ໃນບັນຊີ Google ຂອງທ່ານອອກຈາກອຸປະກອນນີ້. ເພື່ອໃຊ້ຂໍ້ມູນເຫຼົ່ານີ້ໃນ Optimium, ໃຫ້ເຂົ້າສູ່ລະບົບອີກຄັ້ງ.</translation>
<translation id="395904275706073188">ບໍ່ສາມາດອ່ານໜ້າທີ່ມີການປ້ອງກັນໄດ້. ລອງໃຊ້ໜ້າອື່ນ.</translation>
<translation id="3962647064319009959">ສຶກສາວິທີການທີ່ Chromium ຮັກສາຄວາມປອດໄພໃຫ້ທ່ານ</translation>
<translation id="3967822245660637423">ດາວ​ໂຫຼດ​ສຳ​ເລັດ</translation>
<translation id="3971865010372729242">ເມື່ອທ່ານພິມໃນແຖບທີ່ຢູ່ ຫຼື ກ່ອງຊອກຫາ, Chromium ຈະສົ່ງສິ່ງທີ່ທ່ານພິມໄປຫາເຄື່ອງມືຊອກຫາ, AI ແລະ ເຄື່ອງມືຕົວແທນຂອງອົງກອນຂອງທ່ານເພື່ອຮັບຄຳແນະນຳ.</translation>
<translation id="3975724895399328945">ກ່ຽວກັບ Google Chrome ສຳລັບການທົດສອບ</translation>
<translation id="3984557288004650913">ຈາກປຸ່ມ "Google ຊອກຫາໃນ Chrome" ຢູ່ແຖບເຄື່ອງມື, ທ່ານສາມາດເປີດ Google ຊອກຫາໃນ Chrome ຄືນໃໝ່ເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="3997429360543082038">ກ່ຽວກັບ ChromiumOS</translation>
<translation id="4016217212818346953">ປອດໄພຢູ່ສະເໝີດ້ວຍຕົວຈັດການລະຫັດຜ່ານ</translation>
<translation id="4019629340646866719">ChromiumOS ເກີດຂຶ້ນໄດ້ດ້ວຍ <ph name="BEGIN_LINK_CROS_OSS" />ຊອບແວໂອເພນຊອດ<ph name="END_LINK_CROS_OSS" /> ເພີ່ມເຕີມ, ຮວມທັງ <ph name="BEGIN_LINK_LINUX_OSS" />ສະພາບແວດລ້ອມການພັດທະນາ Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">ແປໜ້າຈໍ</translation>
<translation id="4023601594785368013">ພາສາຕົ້ນສະບັບ: <ph name="LANGUAGE" /></translation>
<translation id="8098054594752731054">ເປີດລິ້ງໃນ Optimium ຈາກແອັບໃດກໍໄດ້. ພ້ອມທັງເພື່ອເຂົ້າເຖິງໄດ້ງ່າຍ, ມັນຈະຖືກປັກໝຸດໃສ່ແຖບໜ້າວຽກຂອງທ່ານ.</translation>
<translation id="4036079820698952681">ຊ່ວຍເຮັດໃຫ້ Chromium ດີຂຶ້ນໂດຍການລາຍງານ <ph name="BEGIN_LINK" />ການຕັ້ງຄ່າປັດຈຸບັນ<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">ການ​ປັບ​ປຸງ​ຄວາມ​ປອດ​ໄພ​ທີ່​ສຳ​ຄັນ ແລະ​ຄຸນ​ສົມ​ບັດ​ໃໝ່​ມີ​ໃຫ້​ຢູ່​ໃນ​ເວີ​ຊັນ​ຫຼ້າ​ສຸດ.</translation>
<translation id="4055805654398742145">ຕົວຈັດການລະຫັດຜ່ານ</translation>
<translation id="3150466418323356831">{COUNT,plural, =1{ອົງກອນຂອງທ່ານຈະປິດ Optimium ໂດຍອັດຕະໂນມັດເມື່ອບໍ່ມີການນຳໃຊ້ເປັນເວລາ 1 ນາທີ. ລຶບຂໍ້ມູນການທ່ອງເວັບອອກແລ້ວ. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ.}other{ອົງກອນຂອງທ່ານຈະປິດ Optimium ໂດຍອັດຕະໂນມັດເມື່ອບໍ່ມີການນຳໃຊ້ເປັນເວລາ # ນາທີ. ລຶບຂໍ້ມູນການທ່ອງເວັບອອກແລ້ວ. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ.}}</translation>
<translation id="4118474109249235144">ໂໝດບໍ່ເປີດເຜີຍຕົວຕົນໃນ Chromium</translation>
<translation id="4122186850977583290">ເຂົ້າໄປໜ້າກ່ຽວກັບ Chromium</translation>
<translation id="5040058062446726786">ປັບແຕ່ງ Optimium ເພື່ອສ້າງຮູບລັກໃໝ່ໃຫ້ໂປຣແກຣມທ່ອງເວັບຂອງທ່ານ</translation>
<translation id="3417230552019009112">ປັບແຕ່ງ Optimium ຂອງທ່ານ</translation>
<translation id="4148957013307229264">ກໍາລັງ​ຕິດ​ຕັ້ງ...</translation>
<translation id="8036654966821129512">ອັບເດດ Optimium ເພື່ອຮັກສາຄວາມປອດໄພ</translation>
<translation id="113287843321846936"><ph name="PAGE_TITLE" /> - ການເຂົ້າສູ່ລະບົບເຄືອຂ່າຍ - Optimium</translation>
<translation id="101945827160630872"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງດ້ວຍ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບລາຍຊື່ການອ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານນຳ.</translation>
<translation id="5914158797921975103">ຄົ້ນພົບແອັບ, ເກມ, ສ່ວນຂະຫຍາຍ ແລະ ຮູບແບບສີສັນສຳລັບ Optimium.</translation>
<translation id="7188357620681202939">ເພື່ອຮັບສ່ວນຂະຫຍາຍນີ້ ແລະ ອື່ນໆຢູ່ຄອມພິວເຕີທັງໝົດຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="1889725122457669356">ເພື່ອທ່ອງໂລກອອນລາຍຢ່າງປອດໄພຍິ່ງຂຶ້ນດ້ວຍຕົວເລືອກຂອງຜູ້ປົກຄອງຂອງທ່ານ, ໃຫ້ປ່ຽນໄປໃຊ້ໂປຣໄຟລ໌ Optimium ຂອງທ່ານທີ່ເຂົ້າສູ່ລະບົບໃນຖານະ <ph name="USER_EMAIL_ADDRESS" /> ຢູ່ກ່ອນແລ້ວ</translation>
<translation id="4222932583846282852">ກຳລັງຍົກເລີກ...</translation>
<translation id="4224210481850767180">ການຕິດຕັ້ງຖືກຍົກເລີກ.</translation>
<translation id="3467085712950617325">ລິ້ງ Optimium ຂອງ​ທ່ານກັບບັນຊີນີ້ບໍ?</translation>
<translation id="4251772536351901305">ເຕືອນທ່ານກ່ຽວກັບເວັບໄຊທີ່ເປັນອັນຕະລາຍ, ແມ່ນແຕ່ເວັບໄຊທີ່ Google ບໍ່ຮູ້ຈັກມາກ່ອນ, ໂດຍການວິເຄາະຂໍ້ມູນຈາກເວັບໄຊຫຼາຍກວ່າການປົກປ້ອງມາດຕະຖານ. ທ່ານສາມາດເລືອກທີ່ຈະຂ້າມຄຳເຕືອນຂອງ Chromium ໄດ້.</translation>
<translation id="2140865310399147834">ອອກຈາກລະບົບ Optimium</translation>
<translation id="4271805377592243930">ຂໍຄວາມຊ່ວຍເຫຼືອເລື່ອງ Chromium</translation>
<translation id="4275788652681621337">ປິດແຜງຄວບຄຸມດ້ານຂ້າງ</translation>
<translation id="4281844954008187215">ຂໍ້ກໍານົດການບໍລິການ</translation>
<translation id="3179093133057739293">ການ​ຕິດ​ຕັ້ງ​ບໍ່​ສໍາ​ເລັດ​ອັນ ​ເນື່ອງ​ມາ​ຈາກ​ຄວາມ​ຜິດພາດທີ່ບໍ່ລະບຸໄວ້​. ຖ້າ Optimium ກໍາລັງແລ່ນຢູ່ໃນປະຈຸບັນ​, ກະ​ລຸ​ນາ​ປິດ​ມັນ ​ແລະ​ລອງໃໝ່​ອີກ​.</translation>
<translation id="5932936993463393384">ສົ່ງອອກລະຫັດຜ່ານຈາກ Optimium</translation>
<translation id="4304713468139749426">ຕົວຈັດການລະຫັດຜ່ານ</translation>
<translation id="4334241893986177674">ຊອກຫາຮູບໜ້າຈໍນີ້</translation>
<translation id="109990079583792895">ເປີດໃຊ້ Optimium ເມື່ອ Windows ເລີ່ມເຮັດວຽກ</translation>
<translation id="4400772909124543403">ບໍ່ມີອັບເດດພ້ອມນຳໃຊ້</translation>
<translation id="4669117187454638908">ຢືນຢັນການອອກຈາກ Optimium ບໍ?</translation>
<translation id="4413205837991854510">ສະແດງທາງລັດການຊອກຫາຮູບສະເໝີ</translation>
<translation id="1696050014109987987">ໃຫ້ Optimium ເປີດໃຊ້ຢູ່ໃນພື້ນຫຼັງ</translation>
<translation id="7368827027253482667">{NUM_EXTENSIONS,plural, =1{Optimium ແນະນຳໃຫ້ທ່ານລຶບອອກ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບສ່ວນຂະຫຍາຍທີ່ຮອງຮັບ<ph name="END_LINK" />}other{Optimium ແນະນຳໃຫ້ທ່ານລຶບອອກ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບສ່ວນຂະຫຍາຍທີ່ຮອງຮັບ<ph name="END_LINK" />}}</translation>
<translation id="6842479443769252421">ກໍານົດໃຊ້ ແລະ​ຄວບ​ຄຸມ Optimium</translation>
<translation id="4427306783828095590">ການປົກປ້ອງທີ່ປັບປຸງດີຂຶ້ນເຮັດໄດ້ຫຼາຍກວ່າໃນການບລັອກການຫຼອກເອົາຂໍ້ມູນ ແລະ ເມົາແວ</translation>
<translation id="4434353761996769206">ຕົວຕິດຕັ້ງຜິດພາດ: <ph name="INSTALLER_ERROR" /></translation>
<translation id="1220175535870261362"><ph name="MANAGER" /> ຈັດການ Optimium</translation>
<translation id="4547231940814681999">ເພີ່ມໂປຣໄຟລ໌ Optimium</translation>
<translation id="4447409407328223819">ກ່ຽວກັບ Chrome ສຳລັບການທົດສອບ</translation>
<translation id="5633209319760692383">ເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ Optimium ໃນບັນຊີ Google ຂອງທ່ານ, ກະລຸນາລະບຸລະຫັດຜ່ານຂອງທ່ານ</translation>
<translation id="4493028449971051158">ຂໍ້ຜິດພາດໃນການເລີ່ມຕົ້ນ: ກະລຸນາເອີ້ນໃຊ້ຕົວຕິດຕັ້ງໃນຖານະຜູ້ເບິ່ງແຍງລະບົບ.</translation>
<translation id="4501471624619070934">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກສິດເຂົ້າເຖິງຖືກຈຳກັດໃນປະເທດນີ້.</translation>
<translation id="4501839397124711198">ທ່ານສາມາດປັກໝຸດ Google ຊອກຫາໃນແຜງຄວບຄຸມດ້ານຂ້າງເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="2800276662284246735">ສ່ວນຂະຫຍາຍນີ້ບໍ່ໄດ້ເຜີຍແຜ່ຂໍ້ປະຕິບັດຄວາມເປັນສ່ວນຕົວ, ເຊັ່ນ: ວິທີທີ່ມັນຮວບຮວມ ແລະ ໃຊ້ຂໍ້ມູນ. Optimium ແນະນຳໃຫ້ທ່ານລຶບອອກ.</translation>
<translation id="5128821773878845255">ຍິນດີຕ້ອນຮັບສູ່ Optimium; ເປີດໜ້າຈໍໂປຣແກຣມທ່ອງເວັບໃໝ່ແລ້ວ</translation>
<translation id="2317489323536472198">Optimium ຕ້ອງໄດ້ຮັບການອະນຸຍາດເພື່ອສ້າງແຜນທີ່ພື້ນທີ່ອ້ອມຂ້າງຂອງທ່ານ ແລະ ຕິດຕາມການເຄື່ອນໄຫວຂອງມືທ່ານ</translation>
<translation id="8080035720506683743">ທ່ານເຂົ້າສູ່ລະບົບດ້ວຍ <ph name="USER_EMAIL_ADDRESS" /> ໃນໂປຣໄຟລ໌ Optimium ອື່ນຢູ່ກ່ອນແລ້ວ</translation>
<translation id="4548534452171747496">Chromium ຈະໂຫຼດໜ້າເວັບກ່ອນລ່ວງໜ້າເຊິ່ງເຮັດໃຫ້ເລືອກເບິ່ງ ແລະ ຊອກຫາໄດ້ໄວຂຶ້ນ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບໜ້າໂຫຼດກ່ອນລ່ວງໜ້າ<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">ປັບປຸງຄວາມປອດໄພຢູ່ໂລກອອນລາຍໃຫ້ດີຍິ່ງຂຶ້ນສຳລັບທຸກຄົນເມື່ອທ່ານລາຍງານເວັບໄຊທີ່ທ່ານຄິດວ່າເປັນອັນຕະລາຍ.</translation>
<translation id="8636960717768483692">Optimium ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກທ່ານປິດ Safe Browsing ແລະ ເຮັດໃຫ້ບໍ່ສາມາດຢັ້ງຢືນໄຟລ໌ໄດ້</translation>
<translation id="1056620590372326996">ລອງໃຊ້ Google Lens ກັບ Optimium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="4594305310729380060">ຫາຕົວຈັດການລະຫັດຜ່ານຢູ່ອຸປະກອນນີ້</translation>
<translation id="1647545052658850323">ແອັບ Optimium</translation>
<translation id="4598116752460667024">ຊອກຫາຂະບວນການໃດໆຈາກລາຍຊື່.</translation>
<translation id="4613863813562375431">ເວີຊັນ ChromiumOS</translation>
<translation id="4621240073146040695">ອັບເດດໃກ້ແລ້ວໆ! ກະລຸນາປິດແລ້ວເປີດ Chromium ຄືນໃໝ່ເພື່ອສິ້ນສຸດຂັ້ນຕອນການອັບເດດ.</translation>
<translation id="2905329563261343101">ເພີ່ມຄວາມໄວເວັບໄຊດ້ວຍເຄື່ອງຈັກ V8 ຂອງ Optimium ແຕ່ເຮັດໃຫ້ Optimium ມີຄວາມທົນທານຕໍ່ການໂຈມຕີໜ້ອຍລົງເລັກນ້ອຍ</translation>
<translation id="3476739270743628464">ເປີດການຊອກຫາດ້ວຍ Optimium</translation>
<translation id="8852417056873245680">ໂປຣໄຟລ໌ Optimium</translation>
<translation id="7306598352117034690">ຄຳເຕືອນ: Optimium ບໍ່ສາມາດປ້ອງກັນສ່ວນຂະຫຍາຍບໍ່ໃຫ້ບັນທຶກປະຫວັດການທ່ອງເວັບຂອງທ່ານໄດ້. ເພື່ອປິດການນຳໃຊ້ສ່ວນຂະຫຍາຍນີ້ໃນໂໝດທີ່ບໍ່ເປີດເຜີຍຕົວຕົນ, ກະລຸນາບໍ່ເລືອກຕົວເລືອກນີ້.</translation>
<translation id="4673151026126227699">ຫາກທ່ານແບ່ງປັນລາຍງານການນຳໃຊ້ Chromium ນຳ, ລາຍງານເຫຼົ່ານັ້ນຈະຮວມເອົາ URL ທີ່ທ່ານເຂົ້າເບິ່ງໄວ້ພ້ອມ</translation>
<translation id="4673710618874938871">ເຂົ້າສູ່ລະບົບໃນຊື່ <ph name="USER_NAME" />, ສະມາຊິກ. ເປີດເມນູບັນຊີ</translation>
<translation id="8554460300897634995">ປະກົດວ່າໂປຣໄຟລ໌ໃຊ້ງານຢູ່ໂດຍຂະບວນການ Optimium ອື່ນ (<ph name="PROCESS_ID" />) ຢູ່ໃນຄອມພິວເຕີອື່ນ (<ph name="HOST_NAME" />). Optimium ໄດ້ລັອກໂປຣໄຟລ໌ໄວ້ ເພື່ອບໍ່ໃຫ້ມັນໄດ້ຮັບການ​ຂັດຂ້ອງ. ຖ້າທ່ານແນ່ໃຈວ່າ ບໍ່ມີຂະບວນການອື່ນໃຊ້ໂປຣໄຟລ໌ນີ້ຢູ່, ທ່ານສາມາດປົດລັອກໂປຣໄຟລ໌ ແລະເລີ່ມເປີດໃຊ້ Optimium ໃໝ່ໄດ້.</translation>
<translation id="4680828127924988555">ຍົກເລີກການຕິດຕັ້ງ</translation>
<translation id="3120454893225058851">ຂໍ້ມູນ Optimium ບາງສ່ວນຂອງທ່ານຍັງບໍ່ໄດ້ຖືກບັນທຶກໄປໃສ່ໃນບັນຊີ Google ຂອງທ່ານເທື່ອ. ກະລຸນາລໍຖ້າສອງສາມນາທີກ່ອນອອກຈາກລະບົບ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ຈະຖືກລຶບ.</translation>
<translation id="382482205580353394">ໃນລະຫວ່າງທີ່ທ່ານເຂົ້າສູ່ລະບົບ, ທ່ານສາມາດໃຊ້ລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກບັນຊີ Google ຂອງທ່ານໃນ Optimium ໄດ້. ໂດຍສາມາດໃຊ້ <ph name="SHORTCUT" /> ເພື່ອປ່ຽນການຕັ້ງຄ່າບໍລິການ Google ຂອງທ່ານໄດ້.</translation>
<translation id="3042362992251330365">ຄົນອື່ນເຄີຍເຂົ້າສູ່ລະບົບ Optimium ໃນຄອມພິວເຕີນີ້ເປັນ <ph name="ACCOUNT_EMAIL_LAST" /> ມາກ່ອນແລ້ວ. ກະລຸນາສ້າງຜູ້ໃຊ້ Optimium ໃໝ່ເພື່ອເກັບຂໍ້ມູນຂອງທ່ານໃຫ້ແຍກກັນຕ່າງຫາກ.</translation>
<translation id="4724676981607797757">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກຂໍ້ຜິດພາດໂປຣຕໍຄໍທີ່ບໍ່ຮອງຮັບ.</translation>
<translation id="1193287511990404405">ຢືນຢັນການອອກຈາກ Optimium ບໍ?</translation>
<translation id="8952177001318268390">ຫາກໍນຳໃຊ້ການອັບເດດຄວາມປອດໄພພິເສດສຳລັບ Optimium ແລ້ວ. ກະລຸນາປິດເປີດໃໝ່ຕອນນີ້ເລີຍ ແລ້ວພວກເຮົາຈະກູ້ຄືນແຖບຂອງທ່ານ.</translation>
<translation id="4771701986670315895">ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້. Chromium ໄດ້ລຶບ <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> ແລະ ອີກ <ph name="COUNT" /> ລາຍການອອກແລ້ວ.</translation>
<translation id="2836181158089477791">ຫາກ Gemini ໃນ Optimium ເປີດຢູ່, ແຜງຄວບຄຸມດ້ານຂ້າງຈະເປີດຢູ່ເມື່ອສ້າງແຖບໃໝ່</translation>
<translation id="479167709087336770">ນີ້ໃຊ້ຕົວກວດການສະກົດຄໍາດຽວກັນກັບທີ່ໃຊ້ໃນ Google ຊອກຫາ. ຂໍ້ຄວາມທີ່ທ່ານພິມໃນໂປຣແກຣມທ່ອງເວັບຖືກສົ່ງໃຫ້ Google. ທ່ານສາມາດປ່ຽນລັກສະນະການນໍາໃຊ້ນີ້ໄດ້ສະເໝີໃນການຕັ້ງຄ່າ.</translation>
<translation id="4803313124144656665">ປິດ Google ຊອກຫາໃນ Chrome</translation>
<translation id="1328138522631482119">ໃຊ້ Optimium ໂດຍບໍ່ມີບັນຊີ</translation>
<translation id="4839733921943823254">ປັກໝຸດທາງລັດ</translation>
<translation id="3892081057957249936">ກົດລະບຽບຂາເຂົ້າສໍາລັບ Optimium ເພື່ອອະນຸຍາດການຈາລະຈອນ mDNS.</translation>
<translation id="7651599052663598373">ເລີ່ມເປີດໃຊ້ໃໝ່ເພື່ອອັບເດດ &amp;Optimium</translation>
<translation id="4918086044614829423">ຍອມ​ຮັບ</translation>
<translation id="4918844574251943176">ສຳເນົາຮູບແລ້ວ</translation>
<translation id="5410814264258278350">ເພື່ອເຂົ້າເຖິງລາຍຊື່ການອ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="6875307114047320453">Optimium ຢູ່ໃນໂໝດພື້ນຫຼັງ.</translation>
<translation id="2394968926407196930">ຄລິກເພື່ອປິດກ່ອງໂຕ້ຕອບການເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="1768466544858725503">ໂປຣໄຟລ໌ Optimium ຊ່ວຍໃຫ້ທ່ານສາມາດແຍກຂໍ້ມູນທັງໝົດໃນ Optimium ຂອງທ່ານອອກຈາກກັນໄດ້. ສ້າງໂປຣໄຟລ໌ສຳລັບໝູ່ ແລະ ຄອບຄົວ, ຫຼື ແຍກການເຮັດວຽກອອກຈາກຄວາມບັນເທີງ.</translation>
<translation id="7886648924703056279">ແຂກສາມາດໃຊ້ Optimium ໂດຍ​ບໍ່​ມີ​ການປະອັນໃດໄວ້ເບື້ອງຫຼັງ.</translation>
<translation id="5471135073467145273">ບັນຊີຂອງທ່ານໃນ Optimium</translation>
<translation id="6876331590693993673">ເພີ່ມທ່ານເອງໃສ່ Optimium</translation>
<translation id="5000497292978544380">ໂໝດ AI ຂອງ Google ຊອກຫາ</translation>
<translation id="504699503110800016">ເປີດເມນູລົ້ນ</translation>
<translation id="4438081792500757652">ເຂົ້າເຖິງ Google ທີ່ທ່ານມັກທັງໝົດດ້ວຍ Optimium ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ</translation>
<translation id="5121592697493894155">Google ຊອກຫາໃນແຜງຄວບຄຸມດ້ານຂ້າງ</translation>
<translation id="2242644352859741625">Optimium ຕ້ອງໄດ້ຮັບການອະນຸຍາດເພື່ອຕິດຕາມການເຄື່ອນໄຫວຂອງມືທ່ານ</translation>
<translation id="5141988424377517949">ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້. Chromium ໄດ້ລຶບ <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" /> ອອກແລ້ວ.</translation>
<translation id="988933134885096200">ເຂົ້າສູ່ລະບົບຫາ Optimium</translation>
<translation id="5174969993834422967">ໂດຍປົກກະຕິແລ້ວທ່ານບລັອກການແຈ້ງເຕືອນ. ເພື່ອໃຫ້ເວັບໄຊນີ້ແຈ້ງເຕືອນທ່ານ, ໃຫ້ຄລິກທີ່ໄອຄອນການແຈ້ງເຕືອນຢູ່ມຸມຂວາຂອງແຖບສະຖານທີ່ຂອງທ່ານ.</translation>
<translation id="5174983315706567306">ພື້ນທີ່ດິສກ໌ບໍ່ພຽງພໍ.</translation>
<translation id="2338237693885714148">ບັນຊີ Optimium ຕ້ອງມີການພິສູດຢືນຢັນຄືນໃໝ່</translation>
<translation id="8218029216260099398">ດຳເນີນການຕໍ່ຈາກຈຸດທີ່ທ່ານຄ້າງໄວ້ດ້ວຍ Optimium ຢູ່ iOS.</translation>
<translation id="4186833996539770035">ອອກຈາກລະບົບ Optimium</translation>
<translation id="5234764350956374838">ປ່ອຍໄປ</translation>
<translation id="5247617065091903691">ທ່ານສາມາດປັກໝຸດແຜງຄວບຄຸມດ້ານຂ້າງຂອງ Google ຊອກຫາເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="3776453825988272921">ເປີດລິ້ງໃນໜ້າຈໍທີ່ບໍ່ເຜີຍຕົວຕົນຂອງ Optimium</translation>
<translation id="3535566975491534106">ດາວໂຫຼດແອັບ Optimium ເພື່ອບັນທຶກລະຫັດຜ່ານໄດ້ທຸກບ່ອນທຸກເວລາ</translation>
<translation id="5277894862589591112">ເພື່ອນຳໃຊ້ການປ່ຽນແປງຂອງທ່ານ, ກະລຸນາເປີດ Chromium ຄືນໃໝ່</translation>
<translation id="5286907366254680517">ກວດພົບ</translation>
<translation id="2359384056551683792">ດາວໂຫຼດແອັບ Optimium</translation>
<translation id="5294316920224716406">ເມື່ອທ່ອງເວັບໃນໂໝດບໍ່ເປີດເຜີຍຕົວຕົນ, Chromium ຈະເຕືອນທ່ານກ່ອນການໂຫຼດເວັບໄຊທີ່ກຳລັງໃຊ້ການເຊື່ອມຕໍ່ທີ່ບໍ່ປອດໄພ</translation>
<translation id="8192058236932307019">ຊອກຫາດ້ວຍ Optimium</translation>
<translation id="2772169547056202535">ບໍລິການພາຍໃນຂອງ Optimium Updater</translation>
<translation id="5324450571874973775">ໃຊ້ພ້ອມກັບຄຸນສົມບັດອື່ນໆຂອງ Gemini ໃນ Chromium</translation>
<translation id="5346389065299425353">ເຈາະເລິກການຊອກຫາຂອງທ່ານໂດຍການເພີ່ມແຖບ, ໄຟລ໌ ແລະ ເຄື່ອງມືຫຼາຍລາຍການ</translation>
<translation id="6360850825826447093">ຮັບພາບຮວມໂດຍຫຍໍ້ຂອງເອກະສານນີ້ ແລະ ຖາມຄຳຖາມດ້ວຍ Gemini ໃນ Optimium</translation>
<translation id="5352264705793813212">Chromium ພົບຄຳແນະນຳດ້ານຄວາມປອດໄພບາງຢ່າງທີ່ທ່ານຕ້ອງກວດສອບ</translation>
<translation id="4898448032020512094">ໂປຣໄຟລ໌ Optimium ອື່ນ</translation>
<translation id="8706179446833404063">ChromiumOS ບໍ່ສາມາດບັນທຶກຂໍ້ມູນ Optimium ໃນບັນຊີ Google ຂອງທ່ານໄດ້ເນື່ອງຈາກລາຍລະອຽດການເຂົ້າສູ່ລະບົບບັນຊີຂອງທ່ານເກົ່າແລ້ວ</translation>
<translation id="3030627244449672752">ທ່ານກໍາລັງລົງຊື່ເຂົ້າ​ໃຊ້ດ້ວຍບັນຊີຄຸ້ມຄອງ ແລະໃຫ້ຜູ້ຄວບຄຸມຂອງມັນຄວບຄຸມໂປຣໄຟລ໌ Optimium ຂອງທ່ານ. ຂໍ້ມູນ Optimium ຂອງທ່ານ, ເຊັ່ນ: ແອັບ, ບຸກມາກສ໌, ປະຫວັດ, ລະຫັດຜ່ານ, ແລະການຕັ້ງຄ່າອື່ນໆຂອງທ່ານຈະຖືກຜູກ​ມັດ​ກັບ <ph name="USER_NAME" /> ຢ່າງຖາວອນ. ທ່ານຈະສາມາດລຶບຂໍ້ມູນນີ້ໄດ້ຜ່ານ Google Accounts Dashboard, ແຕ່ທ່ານຈະບໍ່ສາມາດເອົາຂໍ້ມູນນີ້ເຂົ້າຮ່ວມກັບບັນຊີອື່ນໄດ້. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">ລະຫັດເພີ່ມເຕີມ: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">ເພື່ອຮັບການປັບແຕ່ງເປັນແບບສ່ວນຕົວ, ໃຫ້ຮວມ Chromium ໄວ້ໃນການເຄື່ອນໄຫວເວັບ ແລະ ແອັບ</translation>
<translation id="2465610960000663223">ເປີດການຊອກຫາດ້ວຍ Optimium</translation>
<translation id="506107225183374450">ສຶກສາວ່າເປັນຫຍັງ Optimium ຈຶ່ງບລັອກໄຟລ໌ບາງລາຍການ</translation>
<translation id="5386450000063123300">ກຳລັງອັບເດດ Chromium (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="2975872091911905625"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງດ້ວຍ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບສ່ວນຂະຫຍາຍ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານນຳ.</translation>
<translation id="538767207339317086">ອະນຸຍາດການເຂົ້າສູ່ລະບົບ Chromium</translation>
<translation id="160420445803701171">ເອົາ​ອອກ​ຈາກ Optimium</translation>
<translation id="7179459260935505033">ຫຼຸດປະສິດທິພາບ ແຕ່ເຮັດໃຫ້ Optimium ທົນທານຕໍ່ການໂຈມຕີໄດ້ຫຼາຍຂຶ້ນ</translation>
<translation id="9146479251717041603">ຕັ້ງ Optimium ເປັນບຣາວ​ເຊີມາດຕະຖານຂອງທ່ານ</translation>
<translation id="6343924787023513328"><ph name="PAGE_TITLE" /> - Optimium Beta</translation>
<translation id="4322885651709311384">{NUM_TABS,plural, =1{Optimium ແນະນຳໃຫ້ຢຸດແຖບທີ່ເຮັດໃຫ້ໂປຣແກຣມທ່ອງເວັບຂອງທ່ານເຮັດວຽກຊ້າລົງຊົ່ວຄາວ}other{Optimium ແນະນຳໃຫ້ຢຸດແຖບທີ່ເຮັດໃຫ້ໂປຣແກຣມທ່ອງເວັບຂອງທ່ານເຮັດວຽກຊ້າລົງຊົ່ວຄາວ}}</translation>
<translation id="8732742361460659941">Optimium ອາດເຮັດວຽກໄດ້ບໍ່ຖືກຕ້ອງເນື່ອງຈາກ Linux distribution ນີ້ບໍ່ຮອງຮັບມັນອີກຕໍ່ໄປແລ້ວ.</translation>
<translation id="2169134804545654825">Optimium ບລັອກການດາວໂຫຼດນີ້ເພາະວ່າໄຟລ໌ສາມາດເປັນອັນຕະລາຍຕໍ່ບັນຊີສ່ວນຕົວ ແລະ ບັນຊີເຄືອຂ່າຍສັງຄົມຂອງທ່ານໄດ້</translation>
<translation id="5482575505313585759">ປິດແຜງ Google ຊອກຫາ</translation>
<translation id="4427110150482038520">ກະ​ລຸ​ນາ​ລໍ​ຖ້າ​ໃນ​ຂະ​ນະ​ທີ່ Optimium ​ຕິດ​ຕັ້ງ​ການອັບເດດລະບົບຫລ້າ​ສຸດ.</translation>
<translation id="2009107314274994399">Optimium ກໍາລັງພະຍາຍາມແກ້ໄຂລະຫັດຜ່ານ. ພິມລະຫັດຜ່ານ Windows ຂອງທ່ານ ເພື່ອອະນຸຍາດໃຫ້ສຳເນົາໄດ້.</translation>
<translation id="7654616829447718524">ເຮັດວຽກຮ່ວມກັບແອັບທີ່ທ່ານມັກ ເຊັ່ນ: Google Drive ແລະ YouTube ໄດ້ຢ່າງລ່ຽນໄຫຼທຸກບ່ອນທຸກເວລາດ້ວຍ Optimium.</translation>
<translation id="5524890928877629608">ມຸມຊ້າຍເທິງຂອງພື້ນທີ່ຊອກຫາ: ຊ້າຍ <ph name="LEFT" />%, ເທິງ <ph name="TOP" />%</translation>
<translation id="5527463683072221100">ເປີດ PDF ໃນ Chromium</translation>
<translation id="5536164441519929134">ຖາມ<ph name="LINE_BREAK" />ກ່ຽວກັບແຖບນີ້</translation>
<translation id="2024205307959964945">ເພື່ອຄວາມປອດໄພ, Optimium ຈະປິດການເພີ່ມປະສິດທິພາບ JavaScript ເມື່ອທ່ານເຂົ້າເບິ່ງເວັບໄຊເປັນເທື່ອທຳອິດ.

ຫາກໜ້ານີ້ບໍ່ເຮັດວຽກຕາມທີ່ຄາດໄວ້, ໃຫ້ລອງອະນຸຍາດການເພີ່ມປະສິດທິພາບ.</translation>
<translation id="13426881482333028">ສະແດງ Gemini ໃນ Optimium ໃນແຖບເມນູຂອງ Mac ແລະ ເປີດຄີລັດ</translation>
<translation id="6574158167225592561"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບຂໍ້ມູນທີ່ບັນທຶກໄວ້ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" /> ນຳ.</translation>
<translation id="5579324208890605088">ຂໍ້ຜິດພາດໃນການເລີ່ມຕົ້ນ: ກະລຸນາເອີ້ນໃຊ້ຕົວຕິດຕັ້ງໃນຖານະຜູ້ໃຊ້ທົ່ວໄປ, ບໍ່ແມ່ນໃນຖານະຜູ້ເບິ່ງແຍງລະບົບ.</translation>
<translation id="4236944092022229829">ໃຊ້ Optimium ເປັນຄ່າເລີ່ມຕົ້ນ ແລະ ປັກໝຸດມັນໄວ້</translation>
<translation id="4562525634100475413">{COUNT,plural, =1{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານກຳນົດໃຫ້ທ່ານເປີດ Optimium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ໜ້າຈໍແຍກຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານກຳນົດໃຫ້ທ່ານເປີດ Optimium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ໜ້າຈໍແຍກ # ລາຍການຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="5596627076506792578">ໂຕ​ເລືອກ​ເພີ່ມ​ເຕີມ</translation>
<translation id="5605834417512968703">ເລືອກຫຍັງກໍໄດ້ເພື່ອຊອກຫາດ້ວຍການຊອກຫາຮູບ ຫຼື ກົດ Escape ເພື່ອອອກຈາກຄຸນສົມບັດນີ້</translation>
<translation id="7026300828382155386"><ph name="IMPORTANT_UPDATE" /> ພ້ອມແລ້ວ. ທ່ານສາມາດເລີ່ມເປີດໃຊ້ໃໝ່ໄດ້ຕອນນີ້ ຫຼື ຕັ້ງຄ່າ Optimium ໃຫ້ອັບເດດໃນເທື່ອຕໍ່ໄປທີ່ໜ້າຈໍຂອງທ່ານເປີດຢູ່ ແລະ ບໍ່ມີການນຳໃຊ້ເປັນເວລາ <ph name="IDLE_DURATION" /> ກໍໄດ້.</translation>
<translation id="5618818588972826921">ເລືອກຂໍ້ຄວາມ ຫຼື ຮູບເພື່ອຊອກຫາດ້ວຍການຊອກຫາຮູບ ຫຼື ກົດ Escape ເພື່ອອອກຈາກການຊອກຫາຮູບ</translation>
<translation id="8498149662316870172">{0,plural, =0{ມີການອັບເດດ Optimium}=1{ມີການອັບເດດ Optimium}other{ມີການອັບເດດ Optimium ເປັນເວລາ # ມື້ແລ້ວ}}</translation>
<translation id="5643865575100044307">ລຶບຂໍ້ມູນເວັບໄຊຈາກອຸປະກອນຂອງທ່ານທຸກເທື່ອທີ່ທ່ານປິດ Chromium</translation>
<translation id="4811952957940410849">ກະລຸນາປິດເປີດ Optimium ຄືນໃໝ່ຕອນນີ້</translation>
<translation id="8019243097022864687">ເພື່ອຮັບການອັບເດດ Optimium ໃນອະນາຄົດ, ທ່ານຈະຕ້ອງໃຊ້ Windows 10 ເວີຊັນ 1809 ຂຶ້ນໄປ. ຄອມພິວເຕີເຄື່ອງນີ້ກຳລັງໃຊ້ Windows 10 ເວີຊັນເກົ່າ.</translation>
<translation id="568656514202614970">ສຳເລັດແລ້ວ! ຕອນນີ້ທ່ານສາມາດຖາມຄຳຖາມໄດ້ຢ່າງງ່າຍດາຍໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບດ້ວຍແຜງຄວບຄຸມດ້ານຂ້າງຂອງ Google ຊອກຫາ</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">ສະ​ແດງ Chromium ເປັນພາສານີ້</translation>
<translation id="569897634095159764">ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບອິນເຕີເນັດໄດ້. ພຣັອກຊີເຊີບເວີຕ້ອງມີການພິສູດຢືນຢັນ.</translation>
<translation id="5768371961535086509">Chromium ຈະເພີ່ມໜ່ວຍຄວາມຈຳຈາກແຖບທີ່ບໍ່ໄດ້ນຳໃຊ້. ເຊິ່ງນີ້ເຮັດໃຫ້ແຖບທີ່ນຳໃຊ້ຢູ່ ແລະ ແອັບອື່ນໆມີຊັບພະຍາກອນສຳລັບຄອມພິວເຕີເພີ່ມຂຶ້ນ ແລະ ຊ່ວຍໃຫ້ Chromium ເຮັດວຽກໄດ້ໄວ. ແຖບທີ່ບໍ່ມີການນຳໃຊ້ຂອງທ່ານຈະກັບມາເຮັດວຽກໂດຍອັດຕະໂນມັດອີກຄັ້ງເມື່ອທ່ານກັບຄືນໄປຫາແຖບເຫຼົ່ານັ້ນ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບຕົວປະຢັດໜ່ວຍຄວາມຈຳ<ph name="END_LINK" /></translation>
<translation id="7953122114569280985">ຫາກທ່ານລືມລະຫັດຜ່ານຂອງທ່ານ ຫຼື ຕ້ອງການປ່ຽນການຕັ້ງຄ່ານີ້, <ph name="SETTINGS_LINK" /> ຂໍ້ມູນ Optimium ໃນບັນຊີຂອງທ່ານ</translation>
<translation id="174898372403396774">ປັບແຕ່ງ ແລະ ຄວບຄຸມ Optimium. ຕັ້ງ Optimium ເປັນຄ່າເລີ່ມຕົ້ນຂອງທ່ານ.</translation>
<translation id="7513745843649038539">ຊິ້ງລະຫັດຜ່ານ, ບຸກມາກ ແລະ ປະຫວັດຂອງທ່ານໃນອຸປະກອນຕ່າງໆໄດ້ຢ່າງສົມບູນແບບໂດຍຕັ້ງ Optimium ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ.</translation>
<translation id="5809516625706423866">ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບອິນເຕີເນັດໄດ້. HTTP 401 ບໍ່ໄດ້ຮັບອະນຸຍາດ. ກະລຸນາກວດສອບການຕັ້ງຄ່າພຣັອກຊີຂອງທ່ານ.</translation>
<translation id="579643040945073674">ເພີ່ມຄວາມໄວເວັບໄຊດ້ວຍເຄື່ອງຈັກ V8 ຂອງ Optimium ແຕ່ເຮັດໃຫ້ Optimium ມີຄວາມທົນທານຕໍ່ການໂຈມຕີໜ້ອຍລົງເລັກນ້ອຍ. ການຕັ້ງຄ່ານີ້ປິດຢູ່.</translation>
<translation id="4979951833951359193">ເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ Optimium ໃນບັນຊີ Google ຂອງທ່ານ, ກະລຸນາອັບເດດ Optimium</translation>
<translation id="5824893331272123205">ບໍ່ສາມາດໂຫຼດແຜງນີ້ໄດ້, ກະລຸນາລອງໃໝ່</translation>
<translation id="7677335892217820153">ຍິນ​ດີ​ຕ້ອນ​ຮັບສູ່ Optimium</translation>
<translation id="5871205389137001634">ຄລິກເພື່ອອອກຈາກການຊອກຫາຮູບ</translation>
<translation id="3069954563229169503">Optimium ພົບວ່າລາຍການເຫຼົ່ານີ້ມີເມົາແວ:</translation>
<translation id="5889361821821684993">Chromium ຈະກວດສອບເປັນປະຈຳເພື່ອໃຫ້ແນ່ໃຈວ່າໂປຣແກຣມທ່ອງເວັບຂອງທ່ານມີການຕັ້ງຄ່າທີ່ປອດໄພທີ່ສຸດ. ພວກເຮົາຈະແຈ້ງໃຫ້ທ່ານຮູ້ຫາກມີຫຍັງທີ່ຕ້ອງໃຫ້ທ່ານກວດສອບ.</translation>
<translation id="5895138241574237353">ເລີ່ມຕົ້ນໃໝ່</translation>
<translation id="8498138353382813879">Gemini Enterprise ໃນ Optimium</translation>
<translation id="5900507321340749588">ເພື່ອຂັບເຄື່ອນຄຸນສົມບັດຕ່າງໆ ເຊັ່ນ: ການກວດຫາສະແກມ, Chromium ສາມາດໃຊ້ໂມເດວ AI ທີ່ເຮັດວຽກຢູ່ອຸປະກອນຂອງທ່ານໄດ້ໂດຍກົງ. ເມື່ອປິດການຕັ້ງຄ່ານີ້, ຄຸນສົມບັດເຫຼົ່ານີ້ອາດບໍ່ເຮັດວຽກ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບ AI ຢູ່ອຸປະກອນ<ph name="END_LINK" /></translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - ການເຂົ້າສູ່ລະບົບເຄືອຂ່າຍ</translation>
<translation id="5924017743176219022">ກຳ​ລັງ​ເຊື່ອມ​ຕໍ່​ອິນ​ເຕີ​ເນັດ...</translation>
<translation id="5941711191222866238">ຫຍໍ້ລົງ</translation>
<translation id="7780105764415426863">ເພື່ອຮັບເອົາບຸກມາກນີ້ ແລະ ອື່ນໆອີກໃນທຸກອຸປະກອນຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="3113857336144207971">ເຮັດໃຫ້ Optimium ເປັນຂອງທ່ານ</translation>
<translation id="5960071705175224773">ແອັບທີ່ບໍ່ຮູ້ຈັກປ່ຽນການຕັ້ງຄ່າຂອງທ່ານ</translation>
<translation id="2841415208664905665">{COUNT,plural, =1{ອົງກອນຂອງທ່ານຈະປິດ Optimium ໂດຍອັດຕະໂນມັດເມື່ອບໍ່ມີການນຳໃຊ້ເປັນເວລາ 1 ນາທີ.}other{ອົງກອນຂອງທ່ານຈະປິດ Optimium ໂດຍອັດຕະໂນມັດເມື່ອບໍ່ມີການນຳໃຊ້ເປັນເວລາ # ນາທີ.}}</translation>
<translation id="6753703218327532561">ອັບເດດ Optimium ເພື່ອເລີ່ມຊິ້ງຂໍ້ມູນ</translation>
<translation id="5990360079535151574">ຈາກປຸ່ມ "ໜ້າວຽກຕາມບໍລິບົດ" ຢູ່ແຖບເຄື່ອງມື, ທ່ານສາມາດເປີດໜ້າວຽກຕາມບໍລິບົດອີກຄັ້ງເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="6003112304606738118">ກຳລັງດາວໂຫຼດ... ຍັງເຫຼືອ <ph name="HOURS" /> ຊົ່ວໂມງ</translation>
<translation id="6009821354356307391">ຂໍການຕິດຕາມຜົນ</translation>
<translation id="6040143037577758943">ປິດ</translation>
<translation id="4546936953038997559">ໃຊ້ປະໂຫຍດເພີ່ມເຕີມຈາກການຊື້ເຄື່ອງອອນລາຍເມື່ອທ່ານໃຊ້ແອັບ Optimium ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ</translation>
<translation id="6058380562449900225">ເພື່ອປົກປ້ອງຂໍ້ມູນຂອງທ່ານ, ອະນຸຍາດໃຫ້ Chromium ລຶບການອະນຸຍາດອອກຈາກເວັບໄຊທີ່ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້. ແຕ່ບໍ່ຢຸດການແຈ້ງເຕືອນ.</translation>
<translation id="9167712407654403538">&amp;ເປີດໃນ Optimium</translation>
<translation id="6069027071882229820">ສຳເນົາເປັນຮູບ</translation>
<translation id="2336867934702997612">ເພີ່ມ <ph name="EXTENSION_NAME" /> ໃສ່ Optimium ແລ້ວ</translation>
<translation id="4963754686639647216">ປັບແຕ່ງ ແລະ ຄວບຄຸມ Optimium. ມີການອັບເດດແລ້ວ</translation>
<translation id="3238331535068195595">ເປີດ • Optimium ບໍ່ສາມາດຢັ້ງຢືນໄດ້ວ່າສ່ວນຂະຫຍາຍນີ້ມາຈາກໃສ</translation>
<translation id="1591882001986563343">ບັນຊີຂອງທ່ານໃນ Optimium</translation>
<translation id="9174470061972211626">ອະນຸຍາດໃຫ້ສ່ວນຂະຫຍາຍສະແດງຄຳຮ້ອງຂໍສິດເຂົ້າເຖິງໃນແຖບເຄື່ອງມື Optimium</translation>
<translation id="6285996195476638282"><ph name="FILE_NAME" /> ອັນຕະລາຍ, ສະນັ້ນ Optimium ໄດ້ບລັອກມັນໄວ້ແລ້ວ.</translation>
<translation id="2722851476153659127">Optimium ຈະປິດ ແລະ ລຶບຂໍ້ມູນໃນໄວໆນີ້</translation>
<translation id="6855625092121599072">ທ່ານສາມາດສະຫຼັບລະຫວ່າງໂປຣໄຟລ໌ Optimium ໄດ້ຢູ່ບ່ອນນີ້</translation>
<translation id="615103374448673771">ຫາກທ່ານອະນຸຍາດໃຫ້ໃຊ້ຄຸກກີ້ໄດ້, Chromium ອາດໃຊ້ພວກມັນເມື່ອໂຫຼດກ່ອນລ່ວງໜ້າ</translation>
<translation id="6165508094623778733">ສຶກສາ​ເພີ່ມ​ເຕີມ</translation>
<translation id="440816316079905155">ລຶບລ້າງຂໍ້ມູນ Optimium ໃນບັນຊີຂອງທ່ານ</translation>
<translation id="8018999409456045233">ໄຟລ໌ນີ້ອາດເປັນອັນຕະລາຍ<ph name="LINE_BREAK" />Optimium ສາມາດກວດສອບການດາວໂຫຼດນີ້ໃຫ້ທ່ານໄດ້ຫາກທ່ານລະບຸລະຫັດຜ່ານ. ຂໍ້ມູນກ່ຽວກັບໄຟລ໌ຈະຖືກສົ່ງໄປຫາ Google Safe Browsing, ແຕ່ເນື້ອຫາໄຟລ໌ ແລະ ລະຫັດຜ່ານຈະຍັງຢູ່ໃນອຸປະກອນຂອງທ່ານ.</translation>
<translation id="6182736845697986886">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກເຊີບເວີອັບເດດເກີດຂໍ້ຜິດພາດພາຍໃນ.</translation>
<translation id="3469021117852380318">ກວດໃຫ້ແນ່ໃຈວ່າທ່ານໄດ້ເຂົ້າສູ່ລະບົບ Chrome ໃນ <ph name="TARGET_DEVICE_NAME" /> ຂອງທ່ານ ແລ້ວລອງສົ່ງໃໝ່.</translation>
<translation id="2986761964667678689">ຊອກຫາ ແລະ ຖາມຄຳຖາມໄດ້ຈາກທຸກບ່ອນ, ເຖິງແມ່ນວ່າຈະຫຍໍ້ Optimium ຢູ່. ອະນຸຍາດໃຫ້ Optimium ເຮັດວຽກໃນພື້ນຫຼັງ.</translation>
<translation id="1244028666242035366">ຄອມພິວເຕີນີ້ມີ Optimium ລຸ້ນໃໝ່ກ່ວາຢູ່ຮຽບຮ້ອຍແລ້ວ. ຖ້າຊອບແວບໍ່ເຮັດວຽກ, ກະລຸນາຖອນຕິດຕັ້ງ Optimium ແລະລອງໃໝ່ອີກ.</translation>
<translation id="6513480350636703580">{0,plural, =0{Optimium ຈະເປີດຄືນໃໝ່ດຽວນີ້}=1{Optimium ຈະເປີດຄືນໃໝ່ໃນ 1 ວິນາທີ}other{Optimium ຈະເປີດຄືນໃໝ່ໃນ # ວິນາທີ}}</translation>
<translation id="3859762680410498178">Optimium ຈະອັບເດດເມື່ອບໍ່ມີການນຳໃຊ້ໜ້າຈໍຂອງທ່ານ</translation>
<translation id="18853993527252772">Optimium ຕ້ອງການການອະນຸຍາດເຂົ້າເຖິງບ່ອນຈັດເກັບຂໍ້ມູນເພື່ອດາວໂຫຼດໄຟລ໌</translation>
<translation id="6245734527075554892">ກວດສອບ URL ກັບລາຍຊື່ເວັບໄຊທີ່ບໍ່ປອດໄພທີ່ຈັດເກັບໄວ້ໃນ Chromium</translation>
<translation id="571621467627269416">ເຮັດ Optimium ເປັນບຣາວ​ເຊີມາດຕະຖານ</translation>
<translation id="6248988683584659830">ການຕັ້ງຄ່າຄົ້ນຫາ</translation>
<translation id="4260906300317983841">ໃຊ້ຄຸນສົມບັດຄວາມປອດໄພທີ່ດີທີ່ສຸດຂອງ Google ໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍແອັບ Optimium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="6919871734111021049">ອອກຈາກລະບົບ Optimium ບໍ?</translation>
<translation id="8269500201917700071">ແຖບເຫຼົ່ານີ້ໃຊ້ຊັບພະຍາກອນຫຼາຍເປັນພິເສດ. ເພື່ອປັບປຸງປະສິດທິພາບຂອງທ່ານ, ກະລຸນາໃຫ້ Optimium ຊ່ວຍປິດນຳໃຊ້ແຖບເຫຼົ່ານີ້.</translation>
<translation id="2906910751900335741">ປັບແຕ່ງໂປຣໄຟລ໌ Optimium ຂອງທ່ານ</translation>
<translation id="6290827346642914212">ຕັ້ງຊື່ໂປຣໄຟລ໌ Chromium ຂອງທ່ານ</translation>
<translation id="6294638840436017818">ຈາກປຸ່ມ "ແຜງຄວບຄຸມດ້ານຂ້າງຂອງ Google ຊອກຫາ" ຢູ່ແຖບເຄື່ອງມື, ທ່ານສາມາດເປີດແຜງຄວບຄຸມດ້ານຂ້າງຂອງ Google ຊອກຫາຄືນໃໝ່ເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="6612045300479871672">ສ່ວນຂະຫຍາຍຕ້ອງການໃຫ້ທ່ານເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="2723016125417495514"><ph name="FILE_NAME" /> ອາດຈະອັນຕະລາຍ, ສະນັ້ນ Optimium ໄດ້ບລັອກມັນໄວ້ແລ້ວ.</translation>
<translation id="6308106880471005841">ປຸ່ມ "ແຜງ Google ຊອກຫາ" ຢູ່ແຖບເຄື່ອງມືມີໄອຄອນໃໝ່. ຄລິກມັນເພື່ອຖາມຄຳຖາມໃນຂະນະທີ່ທ່ານເລືອກເບິ່ງດ້ວຍແຜງ Google ຊອກຫາ.</translation>
<translation id="6151952148243982653">Optimium ກໍາລັງໃຊ້​ກ້ອງ​ຖ່າຍ​ຮູບຂອງ​ທ່ານ​.</translation>
<translation id="7744220780291650493">ການດຳເນີນການອື່ນໃນ Optimium ພວມດຳເນີນຢູ່. ກະລຸນາລອງອີກຄັ້ງໃນພາຍຫຼັງ.</translation>
<translation id="4212271170228408978">ດຽວນີ້ມັນງ່າຍທີ່ຈະໃຊ້ Optimium ກັບບັນຊີ Google ຂອງທ່ານ ແລະຢູ່ໃນຄອມພິວເຕີທີ່ແຊຣ໌ແລ້ວ.</translation>
<translation id="7560359899505953564">ເຂົ້າເຖິງຄຸນສົມບັດທີ່ທ່ານຮູ້ຈັກ, ມັກ ແລະ ໄວ້ວາງໃຈໄດ້ຢ່າງງ່າຍດາຍໂດຍການຕັ້ງຄ່າ Optimium ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ.</translation>
<translation id="9090225774559341003">ທາງລັດ Optimium</translation>
<translation id="6926580396655648750">Optimium ບລັອກການດາວໂຫຼດນີ້ ເນື່ອງຈາກໄຟລ໌ບໍ່ໄດ້ມີການດາວໂຫຼດໂດຍທົ່ວໄປ ແລະ ອາດເປັນອັນຕະລາຍ</translation>
<translation id="8406846117825568223">ທ່ານແນ່ໃຈບໍວ່າ ທ່ານຕ້ອງການຖອນຕິດຕັ້ງ Optimium?</translation>
<translation id="6375219077595103062">ເພີ່ມທາງລັດໃສ່ຕົວຈັດການລະຫັດຜ່ານ</translation>
<translation id="6388799252195623474">ຊ່ວຍຂ້ອຍໃນເລື່ອງນີ້</translation>
<translation id="9091694200019721003">ເພື່ອສືບຕໍ່, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium ດ້ວຍ <ph name="EMAIL" />. ການດຳເນີນການນີ້ຈະກວດສອບວ່າທ່ານມີນະໂຍບາຍຂອງອົງກອນຂອງທ່ານແລ້ວ.</translation>
<translation id="3942952894185574182">ໂລໂກ້ Optimium ພາຍໃນໜ້າຈໍຄອມພິວເຕີ.</translation>
<translation id="3353682461772532321">Optimium ແມ່ນບຣາວເຊີເວັບທີ່ແລ່ນໜ້າເວັບ ແລະແອັບພລິເຄຊັນດ້ວຍຄວາມໄວແບບສາຍຟ້າແມັບ. ມັນໄວ, ໝັ້ນຄົງ, ແລະໃຊ້ງ່າຍ. ທ່ອງເວັບໄດ້ປອດໄພກ່ວາດ້ວຍການປົກປ້ອງມາລແວ ແລະພິຊຊິງທີ່ສ້າງຢູ່ໃນຕົວ Optimium.</translation>
<translation id="6791461984478543248">ເພື່ອກວດສອບໃຫ້ແນ່ໃຈວ່າທ່ານສາມາດໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ Optimium ໃນບັນຊີ Google ຂອງທ່ານໄດ້ຕະລອດເວລາ, ກະລຸນາຢັ້ງຢືນວ່າແມ່ນທ່ານ</translation>
<translation id="6174985388495951106">Optimium ເຮັດວຽກໄດ້ໄວຂຶ້ນ ແລະ ຄຸນສົມບັດທີ່ໃຊ້ JavaScript ຄວນເຮັດວຽກຕາມທີ່ອອກແບບໄວ້</translation>
<translation id="6436260184216827876">ການຊອກຫາຮູບບໍ່ພ້ອມນຳໃຊ້. ກະລຸນາລອງໃໝ່ໃນພາຍຫຼັງ.</translation>
<translation id="6442900851116057561">ຣີສະຕາດ ChromiumOS</translation>
<translation id="6443470774889161065">Chromium ໂຫຼດໜ້າເວັບໄວ້ກ່ອນລ່ວງໜ້າເພີ່ມຫຼາຍຂຶ້ນສຳລັບໜ້າທີ່ທ່ານອາດຈະເຂົ້າເບິ່ງ, ເພື່ອໃຫ້ພວກມັນໂຫຼດໄວຂຶ້ນເມື່ອທ່ານເຂົ້າເບິ່ງ</translation>
<translation id="2102210363398612557">ດາວໂຫຼດ Optimium ຢູ່ໂທລະສັບຂອງທ່ານເພື່ອຕິດຕາມລາຄາ ແລະ ຮັບການແຈ້ງເຕືອນເມື່ອລາຄາຫຼຸດລົງໃນເວັບໄຊໃດກໍຕາມ</translation>
<translation id="6598227122144472874">ປິດ • Optimium ບໍ່ສາມາດຢັ້ງຢືນໄດ້ວ່າສ່ວນຂະຫຍາຍນີ້ມາຈາກໃສ</translation>
<translation id="3895850825918446737">ຍິນດີຕ້ອນຮັບສູ່ໂປຣໄຟລ໌ Optimium</translation>
<translation id="3239105679122868308">ເທື່ອຕໍ່ໄປທີ່ທ່ານເປີດ Optimium ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ, ທ່ານຈະເຫັນຂໍ້ຄວາມແຈ້ງໃຫ້ໃຊ້ກຸ່ມແຖບ.</translation>
<translation id="5440394152628202500">ລຶບບັນຊີອອກຈາກ Optimium</translation>
<translation id="5673289019038024720">ມັນຍັງຄວບຄຸມວ່າຈະໃຫ້ສະແດງໜ້າໃດຂຶ້ນ ເມື່ອທ່ານເລີ່ມຕົ້ນເປີດ Optimium.</translation>
<translation id="648319183876919572">Safe Browsing ທີ່ປັບປຸງດີຂຶ້ນຊ່ວຍປົກປ້ອງທ່ານຈາກເວັບໄຊ ແລະ ການດາວໂຫຼດທີ່ອັນຕະລາຍ</translation>
<translation id="3922692586556595624">ຖອນ​ຕິດ​ຕັ້ງ Optimium</translation>
<translation id="5977471146123132488">ເປີດທາງລັດໃນ Optimium</translation>
<translation id="1873460655129342919">ອົງກອນຂອງທ່ານປິດ Optimium ໄວ້ເມື່ອມັນບໍ່ໄດ້ຖືກນຳໃຊ້ເປັນເວລາ <ph name="TIMEOUT_DURATION" />. ຂໍ້ມູນການທ່ອງເວັບຖືກລຶບອອກແລ້ວ. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ.</translation>
<translation id="139284349466910875">ແຕ່ລະໂປຣໄຟລ໌ມີຂໍ້ມູນ Optimium ຂອງມັນເອງ ເຊັ່ນ: ບຸກມາກ, ປະຫວັດ, ລະຫັດຜ່ານ ແລະ ອື່ນໆອີກ</translation>
<translation id="6556755379298048869">ຊອກຫາດ້ວຍຄີລັດ.</translation>
<translation id="6563921047760808519">ສຶກສາເພີ່ມເຕີມກ່ຽວກັບ <ph name="BEGIN_LINK" />ວິທີທີ່ Chromium ຮັກສາຂໍ້ມູນຂອງທ່ານໃຫ້ເປັນສ່ວນຕົວ<ph name="END_LINK" /></translation>
<translation id="562266251854740285">ການປ່ຽນແປງການຕັ້ງຄ່ານີ້ຈະມີຜົນນຳໃຊ້ເມື່ອ Optimium ຣີສະຕາດ.</translation>
<translation id="965740992595240282">ຈັດການສ່ວນຂະຫຍາຍຂອງທ່ານໂດຍການຄລິກສ່ວນຂະຫຍາຍໃນເມນູຫຼັກຂອງ Optimium.</translation>
<translation id="2549448919385330625">ທ່ານສາມາດສະຫຼັບເພື່ອເບິ່ງລະຫັດຜ່ານຈາກໂປຣໄຟລ໌ Optimium ອື່ນໄດ້</translation>
<translation id="2662027419736610653">ໃຊ້ແອັບ Optimium ເພື່ອນຳເຄື່ອງມື AI ທີ່ດີທີ່ສຸດໄປໄດ້ທຸກບ່ອນທຸກເວລາ</translation>
<translation id="6570579332384693436">ເພື່ອແກ້ໄຂການສະກົດຄຳຜິດ, Chromium ສົ່ງຂໍ້ຄວາມທີ່ທ່ານພິມໃນຊ່ອງຂໍ້ຄວາມໃຫ້ Google</translation>
<translation id="8346408025829878332">ໄປຫາການຕັ້ງຄ່າການແຈ້ງເຕືອນຂອງ Optimium</translation>
<translation id="6600016381025017075">ຊອກຫາຫຍັງກໍໄດ້ໃນໜ້ານີ້</translation>
<translation id="5149981246269331326">ການປ່ຽນແປງຂອງທ່ານຈະມີຜົນຄັ້ງຕໍ່ໄປທີ່ທ່ານເລີ່ມເປີດໃຊ້ Optimium ໃໝ່.</translation>
<translation id="1163143914216098175">ຕອນນີ້ລະບົບຈະເປີດໃຊ້ Optimium ເມື່ອ Windows ເລີ່ມເຮັດວຽກເພື່ອໃຫ້ທ່ານສາມາດເລີ່ມທ່ອງເວັບໄດ້ທັນທີ. ທ່ານສາມາດປິດການດຳເນີນການນີ້ໄດ້ໃນການຕັ້ງຄ່າ.</translation>
<translation id="7839895033810030903">ສືບຕໍ່ຈາກບ່ອນທີ່ທ່ານຄ້າງໄວ້: Optimium ໄດ້ກູ້ຄືນແທັບຂອງທ່ານຈາກເຊດຊັນຫຼ້າສຸດຂອງທ່ານ. ທ່ານສາມາດປິດໃຊ້ສິ່ງນີ້ໄດ້ໃນ</translation>
<translation id="8919724422686713691">Optimium ຕ້ອງການການອະນຸຍາດກ້ອງຖ່າຍຮູບເພື່ອສ້າງແຜນທີ່ 3 ມິຕິຂອງສິ່ງອ້ອມຕົວທ່ານ</translation>
<translation id="6669284030132180248">ນອກຈາກນັ້ນ, ຫາກທ່ານບັນທຶກບຸກມາກຂອງທ່ານໃນບັນຊີ Google ຂອງທ່ານ, ທ່ານສາມາດຕິດຕາມລາຄາຜະລິດຕະພັນໃນ Chromium ແລະ ຮັບການແຈ້ງເຕືອນເມື່ອລາຄາຫຼຸດລົງໄດ້</translation>
<translation id="6676384891291319759">ການເຂົ້າຫາອິນເຕີເນັດ</translation>
<translation id="668175097507315160">ChromiumOS ບໍ່ສາມາດຊິ້ງຂໍ້ມູນຂອງທ່ານໄດ້ເນື່ອງຈາກການເຂົ້າສູ່ລະບົບຜິດພາດ.</translation>
<translation id="2337492685922399200">ລຶບຂໍ້ມູນຂອງແອັບນີ້ອອກຈາກ Optimium</translation>
<translation id="7200198227335381561">Optimium ຕ້ອງການການອະນຸຍາດໄມໂຄຣໂຟນສຳລັບເວັບໄຊນີ້</translation>
<translation id="6712881677154121168">ດາວໂຫຼດຜິດພາດ: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="358599119501177356">ບໍ່ສາມາດໃຊ້ໂປຣໄຟລ໌ຂອງທ່ານໄດ້ ເພາະວ່າມັນມາຈາກ Optimium ລຸ້ນໃໝ່ກ່ວາ.

ບາງ​ຄຸນສົມບັດອາດຈະບໍ່ມີ​ໃຫ້. ກະລຸນາລະບຸລາຍຊື່ບັນຊີໂປຣໄຟລ໌ຕ່າງ ຫຼືໃຊ້ Optimium ລຸ້ນໃໝ່ກ່ວາ.</translation>
<translation id="6729124504294600478">ເພື່ອຮັບການປັບແຕ່ງເປັນແບບສ່ວນຕົວ ແລະ ຄຸນສົມບັດອື່ນໆ, ໃຫ້ຮວມ Chromium ໄວ້ໃນການເຄື່ອນໄຫວເວັບ ແລະ ແອັບ ພ້ອມທັງບໍລິການ Google ທີ່ລິ້ງໄວ້</translation>
<translation id="196085196242095682">ຕິດຕັ້ງ Optimium ສຳລັບຜູ້ໃຊ້ທຸກຄົນໃນຄອມພິວເຕີຂອງທ່ານແລ້ວ.</translation>
<translation id="8573534493546068455">ເພື່ອເຂົ້າເຖິງບຸກມາກ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium. ລະບົບຈະບັນທຶກບຸກມາກນີ້ໄວ້ໃນບັນຊີ Google ຂອງທ່ານຫຼັງຈາກທີ່ທ່ານເຂົ້າສູ່ລະບົບ.</translation>
<translation id="674891594898436429">ປິດການຊອກຫາທີ່ນຳໃຊ້ຢູ່ໃນແຖບນີ້</translation>
<translation id="87486021868820245">ເພີ່ມຄວາມໄວເວັບໄຊດ້ວຍເຄື່ອງຈັກ V8 ຂອງ Optimium ແຕ່ເຮັດໃຫ້ Optimium ມີຄວາມທົນທານຕໍ່ການໂຈມຕີໜ້ອຍລົງເລັກນ້ອຍ. ການຕັ້ງຄ່ານີ້ເປີດຢູ່.</translation>
<translation id="474617559993879524">{count,plural, =1{ຂໍ້ມູນ Optimium ບາງສ່ວນຂອງທ່ານຍັງບໍ່ໄດ້ຖືກບັນທຶກໄວ້ໃນບັນຊີ Google ຂອງທ່ານເທື່ອ. ກະລຸນາລໍຖ້າສອງສາມນາທີກ່ອນອອກຈາກລະບົບ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ (1 ລາຍການ) ຈະຖືກລຶບ.}other{ຂໍ້ມູນ Optimium ບາງສ່ວນຂອງທ່ານຍັງບໍ່ໄດ້ຖືກບັນທຶກໄວ້ໃນບັນຊີ Google ຂອງທ່ານເທື່ອ. ກະລຸນາລໍຖ້າສອງສາມນາທີກ່ອນອອກຈາກລະບົບ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ ({count} ລາຍການ) ຈະຖືກລຶບ.}}</translation>
<translation id="1681402107856523620">Optimium ແນະນຳໃຫ້ສະແກນໄຟລ໌ນີ້ເນື່ອງຈາກມັນອາດເປັນອັນຕະລາຍໄດ້.</translation>
<translation id="6779406956731413166">ChromiumOS ເກີດຂຶ້ນໄດ້ດ້ວຍ <ph name="BEGIN_LINK_CROS_OSS" />ຊອບແວໂອເພນຊອດ<ph name="END_LINK_CROS_OSS" /> ເພີ່ມເຕີມ.</translation>
<translation id="6804256634866838775">ປິດການຊອກຫາທີ່ນຳໃຊ້ຢູ່</translation>
<translation id="6831043979455480757">ແປພາສາ</translation>
<translation id="2199057756312069531">Optimium ແຈ້ງໃຫ້ທ່ານຮູ້ຖ້າມີຄົນຮູ້ລະຫັດຜ່ານຂອງທ່ານ</translation>
<translation id="684888714667046800">ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບອິນເຕີເນັດໄດ້. ຫາກທ່ານໃຊ້ firewall, ກະລຸນາກວດສອບໃຫ້ໝັ້ນໃຈວ່າ <ph name="PRODUCT_EXE_NAME" /> ຢູ່ໃນລາຍຊື່ອະນຸຍາດ.</translation>
<translation id="6664374380152979637">Optimium - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">ແຕະເພື່ອສືບຕໍ່</translation>
<translation id="6862030660799253820">ຊອກຫາຮູບນີ້ດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="6869568587896659271">ເຂົ້າເຖິງເວັບໄຊຢູ່ລຸ່ມແຖບທີ່ຢູ່ໄດ້ຢ່າງງ່າຍດາຍ</translation>
<translation id="4548192511713002443">Optimium ພົບວ່າ "<ph name="EXTENSION_NAME" />" ມີເມົາແວ</translation>
<translation id="6877155553248388166">ມຸມຂວາລຸ່ມຂອງພື້ນທີ່ຊອກຫາ: ຂວາ <ph name="RIGHT" />%, ລຸ່ມ <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">ສຳເນົາ</translation>
<translation id="6898028264630240901">ທ່ານສາມາດປັກໝຸດໜ້າວຽກຕາມບໍລິບົດເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="3594007018780395447">ຕັ້ງ Optimium ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ ແລະ ປັກໝຸດມັນໃສ່ແຖບໜ້າວຽກຂອງທ່ານ</translation>
<translation id="8874878391047306490">&amp;ຈັດການໂປຣໄຟລ໌ Optimium</translation>
<translation id="8227361644719983591">ການດຳເນີນການນີ້ຈະເຮັດສິ່ງຕໍ່ໄປນີ້:
          <ph name="LINE_BREAKS" />
            • ຣີເຊັດໜ້າເລີ່ມຕົ້ນ, ໜ້າແຖບໃໝ່, ໂປຣແກຣມຊອກຫາ ແລະ ແຖບທີ່ປັກໝຸດແລ້ວຂອງທ່ານ
            <ph name="LINE_BREAK" />
            • ປິດການນຳໃຊ້ສ່ວນຂະຫຍາຍ
            <ph name="LINE_BREAK" />
            • ລຶບຄຸກກີ້ ແລະ ຂໍ້ມູນເວັບໄຊຊົ່ວຄາວອື່ນໆ
            <ph name="LINE_BREAK" />
            • ຣີເຊັດທາງລັດຂອງ Optimium
            <ph name="LINE_BREAKS" />
            ການດຳເນີນການນີ້ຈະບໍ່ມີຜົນກັບບຸກມາກ, ປະຫວັດ ແລະ ລະຫັດຜ່ານທີ່ບັນທຶກໄວ້.</translation>
<translation id="6926772305569367352">ປຸ່ມ "Google ຊອກຫາໃນ Chrome" ຢູ່ແຖບເຄື່ອງມືມີໄອຄອນໃໝ່. ຄລິກມັນເພື່ອຖາມຄຳຖາມໃນຂະນະທີ່ທ່ານເລືອກເບິ່ງດ້ວຍ Google ຊອກຫາໃນ Chrome.</translation>
<translation id="7079691767892495301">ທ່ານບັນທຶກບຸກມາກຂອງ Optimium ຮອດຂີດຈຳກັດ <ph name="BOOKMARK_LIMIT" /> ລາຍການແລ້ວ, ດັ່ງນັ້ນລະບົບຈຶ່ງຍັງບໍ່ໄດ້ບັນທຶກບຸກມາກບາງລາຍການຂອງທ່ານໃສ່ໃນບັນຊີ Google ຂອງທ່ານເທື່ອ.

ທ່ານຈະບໍ່ສາມາດບັນທຶກບຸກມາກໃໝ່ໃສ່ໃນບັນຊີຂອງທ່ານໄດ້ຈົນກວ່າທ່ານຈະລຶບບຸກມາກບາງລາຍການອອກ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ລະບົບຈະລຶບບຸກມາກທີ່ຍັງບໍ່ໄດ້ບັນທຶກໄວ້ອອກ.</translation>
<translation id="8488478146459741524">ເປີດລິ້ງໃນໜ້າຈໍທີ່ບໍ່ເຜີຍຕົວຕົນຂອງ Optimium</translation>
<translation id="6965382102122355670">ຕົກລົງ</translation>
<translation id="6985329841647292029">ຂໍ້ກຳນົດ ChromiumOS</translation>
<translation id="8559464220428426642">ໃສ່ລະຫັດຜ່ານຂອງທ່ານເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ Optimium ໃນບັນຊີຂອງທ່ານ, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="7011190694940573312">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກລະບົບບໍ່ຮອງຮັບລະບົບປະຕິບັດການເວີຊັນນີ້.</translation>
<translation id="7024536598735240744">ແຕກໄຟລ໌ຜິດພາດ: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7941779569092758272">{COUNT,plural, =1{ການປົກປ້ອງຂັ້ນສູງກຳນົດໃຫ້ທ່ານຕ້ອງເລີ່ມເປີດໃຊ້ Optimium ໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ໜ້າຈໍແຍກຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ການປົກປ້ອງຂັ້ນສູງກຳນົດໃຫ້ທ່ານຕ້ອງເລີ່ມເປີດໃຊ້ Optimium ໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ໜ້າຈໍແຍກ # ລາຍການຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="5367778139372857256">ຕັ້ງຄ່າ Optimium ແບບກຳນົດເອງ</translation>
<translation id="7047386856539490735">ຜົນການຊອກຫາເຫຼົ່ານີ້ມີປະໂຫຍດຫຼືບໍ່?</translation>
<translation id="6654931874608808546">ອັບເດດ Optimium</translation>
<translation id="1078205929937913964">ຖ້າຮູບບໍ່ມີລາຍລະອຽດທີ່ເປັນປະໂຫຍດ, Optimium ຈະພະຍາຍາມໃຫ້ລາຍລະອຽດແກ່ທ່ານ. ເພື່ອສ້າງລາຍລະອຽດ, ລະບົບຈະສົ່ງຮູບພາບໃຫ້ Google.</translation>
<translation id="8657336023716174215">ສຳຜັດປະສິດທິພາບຂອງ AI ເມື່ອທ່ານໃຊ້ແອັບ Optimium ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ</translation>
<translation id="8360922610978196377">ເຂົ້າເຖິງລະຫັດຜ່ານ, ແຖບ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍແອັບ Optimium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="7141270731789036260">ປັບແຕ່ງ Chrome for Testing</translation>
<translation id="7147227333672430807">ທ່ານສາມາດໃຊ້ Chromium ໄດ້ທຸກເທື່ອທີ່ທ່ານຄລິກລິ້ງໃນຂໍ້ຄວາມ, ເອກະສານ ແລະ ແອັບອື່ນໆ</translation>
<translation id="7635847276859447848">ລຶບ <ph name="EXTENSION_NAME" /> ອອກຈາກ Optimium</translation>
<translation id="4634249408802713112">ອົງກອນຂອງທ່ານລຶບຂໍ້ມູນຂອງ Optimium ອອກເມື່ອມັນບໍ່ໄດ້ຖືກນຳໃຊ້ເປັນເວລາ <ph name="TIMEOUT_DURATION" />. ເຊິ່ງຮວມເຖິງປະຫວັດ, ການຕື່ມຂໍ້ມູນອັດຕະໂນມັດ ແລະ ການດາວໂຫຼດ.</translation>
<translation id="3308314751977712481">Optimium ຕ້ອງການການອະນຸຍາດກ້ອງຖ່າຍຮູບສຳລັບເວັບໄຊນີ້</translation>
<translation id="1700107811881467396">ບໍ່ສາມາດເປີດໃຊ້ Optimium ໄດ້. ກະລຸນາລອງອີກຄັ້ງ.</translation>
<translation id="615859695332174696">ຖາມຫຍັງກໍໄດ້, ຈາກບ່ອນທີ່ທ່ານຢູ່, ດ້ວຍ Gemini ໃນ Optimium</translation>
<translation id="4082322885657154457">ເກັບ Optimium ໃນດັອກຂອງທ່ານເພື່ອໄປໃຊ້ມັນຢ່າງວ່ອງໄວໄດ້ທຸກເວລາ</translation>
<translation id="5886985791575399945">ໃຊ້ Optimium ຕອນໃດກໍໄດ້ທີ່ທ່ານຄລິກລິ້ງໃນຂໍ້ຄວາມ, ເອກະສານ ແລະ ແອັບອື່ນໆ</translation>
<translation id="7213435258745128111">Google ຊອກຫາໃນ Chromium</translation>
<translation id="7216228761061470870">ເມື່ອທ່ານໃຊ້ຄຸນສົມບັດຊອກຫາຮູບຢູ່ເດັສທັອບ, ລະບົບຈະສົ່ງຊື່ໜ້າ, URL ແລະ ເນື້ອຫາ, ຮວມທັງ PDF ໄປຫາເຊີບເວີ</translation>
<translation id="3899250150715276784">ຕົວຈັດການໜ້າວຽກ - Optimium</translation>
<translation id="357779301278973973">ຖາມກ່ຽວກັບເນື້ອຫາພາຍນອກ Optimium ເຊັ່ນ: ແອັບ ຫຼື ໄຟລ໌ອື່ນໆ</translation>
<translation id="2192941957286691074"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບຂໍ້ມູນທີ່ບັນທຶກໄວ້ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານນຳ.</translation>
<translation id="4695009148423764441">ເລີ່ມທ່ອງເວັບໄດ້ທັນທີ: ຕອນນີ້ລະບົບສາມາດເປີດໃຊ້ Optimium ເມື່ອ Windows ເລີ່ມເຮັດວຽກໄດ້ແລ້ວ.</translation>
<translation id="7274695763216404502">ປັກໝຸດແລ້ວ! ໃຊ້ການຊອກຫາຮູບອີກຄັ້ງຈາກແຖບເຄື່ອງມື</translation>
<translation id="7288567540154601580">ແຖບ ແລະ ສ່ວນຂະຫຍາຍ</translation>
<translation id="7290997427370476749">ຈາກປຸ່ມ "ແຜງ Google ຊອກຫາ" ຢູ່ແຖບເຄື່ອງມື, ທ່ານສາມາດເປີດແຜງ Google ຊອກຫາຄືນໃໝ່ເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="1079602886106438527">{NUM_EXTENSIONS,plural, =1{Optimium ແນະນຳໃຫ້ທ່ານລຶບອອກ}other{Optimium ແນະນຳໃຫ້ທ່ານລຶບອອກ}}</translation>
<translation id="5279936464959604532">ເພື່ອແບ່ງປັນສຽງຂອງລະບົບ, ໃຫ້ເປີດການຕັ້ງຄ່າລະບົບ ແລະ ອະນຸຍາດ 'ການບັນທຶກສຽງຂອງລະບົບເທົ່ານັ້ນ' ສຳລັບ Optimium. ຈາກນັ້ນທ່ານຈະຕ້ອງຣີສະຕາດ Optimium.</translation>
<translation id="7299899569525778554">ຊອກຫາຈາກເດັສທັອບ</translation>
<translation id="731795002583552498">ກໍາລັງອັບເດດ Chromium</translation>
<translation id="1032861344046520617">ໄຟລ໌ທີ່ມັກຂອງທ່ານເສຍຫາຍ ຫຼືໃຊ້ບໍ່ໄດ້.

Optimium ບໍ່ສາມາດກູ້ການຕັ້ງຄ່າຂອງທ່ານຄືນໄດ້.</translation>
<translation id="7324051657739063017">ທ່ານສາມາດເປີດໜ້າວຽກຕາມບໍລິບົດຄືນໃໝ່ເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="265884122223707624">ເວັບຂອງທ່ານ, ບຸກມາກສ໌, ແລະ Optimium ອື່ນສົດຢູ່ທີ່ນີ້.</translation>
<translation id="7347827960336370838">ມີພຽງບຸກຄົນທີ່ມີລະຫັດຜ່ານຂອງທ່ານເທົ່ານັ້ນທີ່ສາມາດອ່ານຂໍ້ມູນທີ່ໄດ້ຖືກເຂົ້າລະຫັດໄວ້ຂອງທ່ານໄດ້. Google ຈະບໍ່ໄດ້ຮັບ ຫຼື ຈັດເກັບລະຫັດຜ່ານດັ່ງກ່າວ. ຫາກທ່ານລືມລະຫັດຜ່ານຂອງຕົນເອງ ຫຼື ຕ້ອງການປ່ຽນການຕັ້ງຄ່ານີ້, ທ່ານຈະຕ້ອງ <ph name="BEGIN_LINK" />ລຶບຂໍ້ມູນ Chromium ໃນບັນຊີຂອງທ່ານ<ph name="END_LINK" />.</translation>
<translation id="3014807377884544255">ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານໄດ້ກຳນົດຄ່າໃຫ້ Optimium ເປີດ <ph name="ALTERNATIVE_BROWSER_NAME" /> ເພື່ອເຂົ້າເຖິງ <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">ມີ​ບາງ​ອັນ​ຜິດ​ພາດ</translation>
<translation id="6261059974673858354">ເພື່ອຮັບການອັບເດດ Optimium ໃນອະນາຄົດ, ທ່ານຈະຕ້ອງໃຊ້ macOS 13 ຂຶ້ນໄປ. ຄອມພິວເຕີເຄື່ອງນີ້ກຳລັງໃຊ້ macOS 12.</translation>
<translation id="7374061268215476070">ທ່ານສາມາດເປີດແຜງຄວບຄຸມດ້ານຂ້າງຂອງ Google ຊອກຫາຄືນໃໝ່ເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="7376384068949534168">ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້. Chromium ໄດ້ລຶບ <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> ອອກແລ້ວ.</translation>
<translation id="73786666777299047">ເປີດ Chrome Web Store</translation>
<translation id="3890970823792853036">ສະແດງ Gemini ໃນ Optimium ໃນຖາດລະບົບ</translation>
<translation id="7401687852903179959">ຊອກຫາວິດີໂອນີ້ດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="3864955417896853787">ຕອນນີ້ Optimium ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານແລ້ວ</translation>
<translation id="7774148037106099906">ສືບຕໍ່ຈາກບ່ອນທີ່ທ່ານຄ້າງໄວ້: Optimium ຈະກູ້ຄືນແຖບຂອງທ່ານໄດ້ທຸກຄັ້ງທີ່ທ່ານປິດເປີດໃໝ່. ເພື່ອປິດໃຊ້ສິ່ງນີ້, ໃຫ້ໄປຫາ</translation>
<translation id="8928491002876394495">ນຳເຂົ້າລະຫັດຜ່ານໃສ່ Optimium</translation>
<translation id="5203709869300967635">1. ຄລິກ <ph name="BUTTON_LABEL" /> ທາງລຸ່ມ
2. ຄລິກ <ph name="BUTTON_2" /> ໃນການຕັ້ງຄ່າ Windows ຂອງທ່ານ
3. ຄລິກ <ph name="BUTTON_3" /> ໃນການແຈ້ງເຕືອນ Windows ເພື່ອປັກໝຸດ Optimium ໄວ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ຢ່າງວ່ອງໄວ</translation>
<translation id="1391846143863378733"><ph name="PAGE_TITLE" /> - Optimium Dev</translation>
<translation id="7450541714075000668">ສຳເນົາຂໍ້ຄວາມແລ້ວ</translation>
<translation id="7458892263350425044">ເພື່ອໃຊ້ໄມໂຄຣໂຟນຂອງທ່ານ, ກະລຸນາມອບສິດເຂົ້າເຖິງໃຫ້ Chromium ໃນ <ph name="BEGIN_LINK" />ການຕັ້ງຄ່າລະບົບ<ph name="END_LINK" /></translation>
<translation id="6029586608765705546">ເພື່ອໄດ້ຮັບການອັບເດດ Optimium ໃນອະນາຄົດ, ທ່ານຈະຕ້ອງໃຊ້ Windows 10 ຫຼື ໃໝ່ກວ່ານັ້ນ. ຄອມພິວເຕີນີ້ກຳລັງນຳໃຊ້ Windows 7.</translation>
<translation id="7467949745582939695">ເລີ່ມເປີດໃຊ້ Chromium ໃໝ່ບໍ?</translation>
<translation id="5752242571869112795">ບໍ່ສາມາດຕິດຕັ້ງ Optimium ລຸ້ນດຽວກັບທີ່ກໍາລັງແລ່ນຢູ່ໃນປະຈຸບັນ​ໄດ້. ກະລຸນາປິດ Optimium ແລະລອງໃໝ່ອີກ.</translation>
<translation id="7510190804000607802">ການແຈ້ງເຕືອນ: ປະໂຫຍດສູງສຸດຈາກ Google ໃນກະເປົາຂອງທ່ານ</translation>
<translation id="751935028865900641">ເວັບໄຊອາດເຮັດວຽກຕາມທີ່ຄາດໄວ້. ທ່ານຈະອອກຈາກລະບົບຂອງເວັບໄຊສ່ວນໃຫຍ່ເມື່ອທ່ານປິດໜ້າຈໍ Chromium ທັງໝົດຍົກເວັ້ນບັນຊີ Google ຂອງທ່ານຫາກທ່ານເຂົ້າສູ່ລະບົບ Chromium.</translation>
<translation id="63211891312143018">{0,plural, =1{Optimium ຈະເປີດຄືນໃໝ່ໃນ 1 ນາທີ}other{Optimium ຈະເປີດຄືນໃໝ່ໃນ # ນາທີ}}</translation>
<translation id="7565444033145385702">ເພື່ອປົກປ້ອງຂໍ້ມູນຂອງທ່ານ, ກະລຸນາອະນຸຍາດໃຫ້ Chromium ລຶບການອະນຸຍາດອອກຈາກເວັບໄຊທີ່ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້.</translation>
<translation id="3125039289492641783">ເປີດໃຊ້ Optimium ໂດຍອັດຕະໂນມັດເພື່ອເລີ່ມທ່ອງເວັບໄດ້ທັນທີ.</translation>
<translation id="7583399374488819119">ຕົວຕິດຕັ້ງ <ph name="COMPANY_NAME" /></translation>
<translation id="4408734053922791034">Optimium ກໍາລັງໃຊ້​ກ້ອງ​ຖ່າຍ​ຮູບ​ ແລະໄມໂຄຣໂຟນຂອງ​ທ່ານ​.</translation>
<translation id="3179764934195866467">Optimium ​ດີກ​ວ່າແລ້ວ</translation>
<translation id="6404693631411216689">ຕອນນີ້ທ່ານມີຄຸນສົມບັດເພີ່ມເຕີມໃນ Optimium</translation>
<translation id="7624307931717240213">ພວກເຮົາໃຊ້ຂໍ້ມູນເພື່ອປັບປຸງບໍລິການນີ້. ເບິ່ງນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ ແລະ ຂໍ້ກຳນົດບໍລິການ.</translation>
<translation id="7649070708921625228">ຊ່ວຍ​ເຫຼືອ</translation>
<translation id="8311510395768039141">ດາວໂຫຼດແອັບ Optimium</translation>
<translation id="7658239707568436148">ຍົກ​ເລີກ​</translation>
<translation id="133478151344333089">Optimium ບໍ່ແມ່ນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ</translation>
<translation id="280841280407738358">ຊິ້ງຂໍ້ມູນ ແລະ ປັບແຕ່ງ Optimium ໃຫ້ເປັນແບບສ່ວນຕົວໃນທົ່ວອຸປະກອນຂອງທ່ານ</translation>
<translation id="7699779824407626136">ການອັບເດດ Chromium</translation>
<translation id="4220506181038618136">ວຽກຂອງທ່ານປອດໄພໃນ Optimium</translation>
<translation id="7716950018788545737">ໜ້າວຽກສິ້ນສຸດແລ້ວ.</translation>
<translation id="77283119132245232">ໃຫ້ບໍລິການຕິດຕາມລະບົບສຳລັບ <ph name="BROWSER_NAME" />. ຫາກປິດການນຳໃຊ້ບໍລິການນີ້, ການຕິດຕາມປະສິດທິພາບທີ່ສ້າງຂຶ້ນໂດຍໂປຣແກຣມທ່ອງເວັບຈະບໍ່ຮວມກິດຈະກຳທົ່ວລະບົບ ເຊັ່ນ: ກິດຈະກຳປ່ຽນບໍລິບົດ ແລະ ກິດຈະກຳຫົວຂໍ້ທີ່ພ້ອມນຳໃຊ້.</translation>
<translation id="7745317241717453663">ນີ້ຈະລຶບຂໍ້ມູນການທ່ອງເວັບຂອງທ່ານອອກຈາກອຸປະກອນນີ້. ເພື່ອກູ້ຂໍ້ມູນຂອງທ່ານຄືນໃນພາຍຫຼັງ, ກະລຸນາເຂົ້າສູ່ລະບົບ Chromium ເປັນ <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">ຕົວຕິດຕັ້ງບໍ່ສາມາດສ້າງໄດເຣັກຕໍຣີຊົ່ວຄາວໄດ້. ກະລຸນາກວດເບິ່ງບ່ອນ​ວ່າງດິສກ໌ ແລະການອະນຸຍາດ ເພື່ອຕິດຕັ້ງຊອບແວ.</translation>
<translation id="4874030584283115178">ຣີເຊັດເປັນ Optimium ແບບຄ່າເລີ່ມຕົ້ນ</translation>
<translation id="4747871007139957101">ເພື່ອຮັກສາຄວາມປອດໄພໃຫ້ກັບວຽກຂອງທ່ານໃນ Optimium, ອົງກອນຂອງທ່ານຈະສາມາດເບິ່ງ ຫຼື ຈັດການຂໍ້ມູນບາງຢ່າງໄດ້ເມື່ອທ່ານເຂົ້າສູ່ລະບົບ Optimium.</translation>
<translation id="39303350018938562">ຕັ້ງ Optimium ເປັນຄ່າເລີ່ມຕົ້ນ ແລະ ປັກໝຸດໄວ້ຢູ່ແຖບໜ້າວຽກ</translation>
<translation id="1411498815218277204">ເຮັດໃຫ້ Optimium ໄວຂຶ້ນ</translation>
<translation id="6759916683257281869"><ph name="PAGE_TITLE" /> - Optimium Canary</translation>
<translation id="7800043020703832708">ປິດ Google ຊອກຫາໃນແຜງຄວບຄຸມດ້ານຂ້າງ</translation>
<translation id="7801317262080715012">ໄອຄອນໃໝ່, ທາງລັດເກົ່າ: ຄລິກເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບດ້ວຍແຜງ Google ຊອກຫາ.</translation>
<translation id="7803986347287457849">ເຮັດໃຫ້ຜູ້ທີ່ມີສິດເຂົ້າເຖິງທຣາບຟິກອິນເຕີເນັດຂອງທ່ານເບິ່ງວ່າທ່ານເຂົ້າເບິ່ງເວັບໄຊໃດແດ່ໄດ້ຍາກຂຶ້ນ. Chromium ໃຊ້ການເຊື່ອມຕໍ່ທີ່ປອດໄພເພື່ອຊອກຫາທີ່ຢູ່ IP ຂອງເວັບໄຊໃນ DNS (ລະບົບຊື່ໂດເມນ).</translation>
<translation id="7810005234485217901">ທ່ານສາມາດປັກໝຸດການຊອກຫາຮູບເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ງ່າຍ</translation>
<translation id="3974047900913685132">{COUNT,plural, =1{ມີການອັບເດດໃໝ່ສຳລັບ Optimium ແລະ ຈະນຳໃຊ້ໃນທັນທີທີ່ທ່ານເປີດໃຊ້ຄືນໃໝ່. ມີໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນ ຫຼື ໜ້າຈໍແຍກເປີດຢູ່. ມັນຈະບໍ່ເປີດຄືນໃໝ່ຫຼັງຈາກທ່ານເລີ່ມເປີດໃຊ້ໃໝ່.}other{ມີການອັບເດດໃໝ່ສຳລັບ Optimium ແລະ ຈະນຳໃຊ້ໃນທັນທີທີ່ທ່ານເປີດໃຊ້ຄືນໃໝ່. ມີໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນ ແລະ ໜ້າຈໍແຍກ # ລາຍການເປີດຢູ່ໃນໂປຣໄຟລ໌ຕ່າງໆ. ພວກມັນຈະບໍ່ເປີດຄືນໃໝ່ຫຼັງຈາກທ່ານເລີ່ມເປີດໃຊ້ໃໝ່.}}</translation>
<translation id="1327395026710636574">ເລືອກສິ່ງທີ່ຈະແບ່ງປັນກັບ Optimium</translation>
<translation id="7712700268586648421">ມີໂປຣໄຟລ໌ Optimium ກັບບັນຊີນີ້ຢູ່ອຸປະກອນນີ້ຢູ່ກ່ອນແລ້ວ</translation>
<translation id="7845233973568007926">ຂໍຂອບໃຈສຳລັບການຕິດຕັ້ງ. ທ່ານຈະຕ້ອງຣີສະຕາດຄອມພິວເຕີຂອງທ່ານກ່ອນການໃຊ້ <ph name="BUNDLE_NAME" />.</translation>
<translation id="7639854797882089460">ມີການປ່ຽນໂປຣແກຣມຊອກຫາຂອງທ່ານຈາກພາຍນອກ Optimium. ເພື່ອປົກປ້ອງທ່ານ, Optimium ໄດ້ຣີເຊັດໂປຣແກຣມດັ່ງກ່າວເປັນຄ່າເລີ່ມຕົ້ນເກົ່າ. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3551756496947130501">ປັບແຕ່ງ Optimium ເພື່ອໃຫ້ມີຮູບລັກໃໝ່</translation>
<translation id="7859018312476869945">ເມື່ອທ່ານພິມໃນແຖບທີ່ຢູ່ ຫຼື ກ່ອງຊອກຫາ, Chromium ຈະສົ່ງສິ່ງທີ່ທ່ານພິມໄປຫາໂປຣແກຣມຊອກຫາຄ່າເລີ່ມຕົ້ນຂອງທ່ານເພື່ອຮັບການແນະນຳທີ່ດີຍິ່ງຂຶ້ນ. ສິ່ງນີ້ຖືກປິດໃນໂໝດບໍ່ເປີດເຜີຍຕົວຕົນ.</translation>
<translation id="7884611555881634231">Optimium ບໍ່ສາມາດອັບເດດເປັນເວີຊັນຫຼ້າສຸດໄດ້, ສະນັ້ນທ່ານກຳລັງພາດຄຸນສົມບັດ ແລະ ການແກ້ໄຂດ້ານຄວາມປອດໄພໃໝ່ໆຢູ່.</translation>
<translation id="7872446069773932638">ກຳລັງດາວໂຫຼດ... ຍັງເຫຼືອ <ph name="SECONDS" /> ວິນາທີ</translation>
<translation id="7873537467422636035">ຫາກທ່ານລືມລະຫັດຜ່ານຂອງຕົນເອງ ຫຼື ຕ້ອງການປ່ຽນການຕັ້ງຄ່ານີ້, ໃຫ້ <ph name="BEGIN_LINK" />ລຶບຂໍ້ມູນ Chromium ໃນບັນຊີຂອງທ່ານ<ph name="END_LINK" /></translation>
<translation id="3834573390507006929">ເປີດ Gemini ໃນ Optimium ໄດ້ຢ່າງວ່ອງໄວທຸກເທື່ອທີ່ທ່ານຕ້ອງການ</translation>
<translation id="6294556714699385535">ຕັ້ງ Optimium ເປັນຄ່າເລີ່ມຕົ້ນຂອງທ່ານ</translation>
<translation id="7904213866086517086">ເປີດ Google ຊອກຫາໃນແຜງຄວບຄຸມດ້ານຂ້າງຄືນໃໝ່</translation>
<translation id="7934340546140346950">Chromium ອັບເກຣດການເຊື່ອມຕໍ່ທີ່ບໍ່ປອດໄພເປັນ HTTPS ໂດຍອັດຕະໂນມັດຫາກເປັນໄປໄດ້</translation>
<translation id="5730000852184248909">ທ່ານ​ໄດ້ລົງຊື່ເຂົ້າໃຊ້ Optimium ເປັນ <ph name="USER_EMAIL_ADDRESS" />. ກະ​ລຸ​ນາ​​ໃຊ້​ບັນ​ຊີ​ດຽວ​ກັນ​ ເພື່ອລົງຊື່ເຂົ້າໃຊ້ອີກ.</translation>
<translation id="8566131222358264585"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບບຸກມາກ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຢູ່ອຸປະກອນທຸກເຄື່ອງຂອງທ່ານນຳ.</translation>
<translation id="7975919845073681630">ນີ້ແມ່ນການຕິດຕັ້ງສຳຮອງຂອງ Chromium ແລະ ບໍ່ສາມາດຖືກຕັ້ງເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນໄດ້.</translation>
<translation id="6422450341111525365">ສ່ວນຂະຫຍາຍ, ແອັບ ແລະ ຮູບແບບສີສັນຈາກແຫຼ່ງຂໍ້ມູນທີ່ບໍ່ຮູ້ຈັກອາດເປັນອັນຕະລາຍກັບອຸປະກອນຂອງທ່ານໄດ້. Optimium ແນະນຳໃຫ້ຕິດຕັ້ງພວກມັນຈາກ <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ເທົ່ານັ້ນ</translation>
<translation id="6757123197146934198">ຮັບປະໂຫຍດສູງສຸດຈາກ Google ດ້ວຍແອັບ Optimium ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ</translation>
<translation id="8004582292198964060">ບຣາວ​ເຊີ</translation>
<translation id="8010081455002666927">ກວດຫາອັດຕະໂນມັດ</translation>
<translation id="1278413817028711539">ເມື່ອ Optimium ມີການເຂົ້າເຖິງ, ເວັບໄຊຈະສາມາດຮ້ອງຂໍການເຂົ້າເຖິງນຳທ່ານ.</translation>
<translation id="349886907929581949">ປັກໝຸດ Optimium ໄວ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ຢ່າງວ່ອງໄວທຸກເວລາ</translation>
<translation id="80471789339884597">ຂໍຂອບໃຈສຳລັບການຕິດຕັ້ງ. ທ່ານຈະຕ້ອງຣີສະຕາດໂປຣແກຣມທ່ອງເວັບຂອງທ່ານທັງໝົດກ່ອນການໃຊ້ <ph name="BUNDLE_NAME" />.</translation>
<translation id="8054112667659782652">ສະແດງທາງລັດການຊອກຫາຮູບສະເໝີ</translation>
<translation id="8069447462453318634">ເລືອກ "ປັກໝຸດໄວ້ຢູ່ແຖບເຄື່ອງມື"</translation>
<translation id="4174818101907153398">ປິດການນຳໃຊ້ Optimium ທີ່ເຮັດວຽກໃນພື້ນຫຼັງສຳລັບແອັບ</translation>
<translation id="80790299200510644">ຊອກຫາຮູບ</translation>
<translation id="8086881907087796310">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກຄອມພິວເຕີຂອງທ່ານບໍ່ເປັນໄປຕາມຂໍ້ກຳນົດຂັ້ນຕ່ຳສຳລັບຮາດແວ.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> - Google Chrome for Testing</translation>
<translation id="1888025000812363096">Optimium ຕ້ອງການການອະນຸຍາດສະຖານທີ່ສຳລັບເວັບໄຊນີ້</translation>
<translation id="7584643292999340766">ເທື່ອຕໍ່ໄປທີ່ທ່ານເປີດ Optimium ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ, ທ່ານຈະເຫັນຂໍ້ຄວາມແຈ້ງໃຫ້ເປີດການນຳໃຊ້ການແຈ້ງເຕືອນການຕິດຕາມລາຄາ.</translation>
<translation id="7461287607957342327">ຮັບການແຈ້ງເຕືອນລາຄາຫຼຸດລົງສຳລັບສິນຄ້າທີ່ທ່ານສົນໃຈດ້ວຍແອັບ Optimium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="8118331347066725040">ສົ່ງຄຳຕິຊົມສຳລັບການຊອກຫາດ້ວຍ Lens</translation>
<translation id="3539581840889743095">ປັບປ່ຽນ Optimium ໃນແບບຂອງທ່ານ</translation>
<translation id="8133124826068723441">ChromiumOS ບໍ່ສາມາດຊິ້ງຂໍ້ມູນຂອງທ່ານໄດ້ເນື່ອງຈາກການຊິ້ງຂໍ້ມູນບໍ່ສາມາດໃຊ້ໄດ້ສຳລັບໂດເມນຂອງທ່ານ.</translation>
<translation id="813913629614996137">ກຳລັງລິເລີ່ມ...</translation>
<translation id="4772631357296776122">ເປີດ Gemini ໃນ Optimium ດ້ວຍຄີລັດ.</translation>
<translation id="8164014945047474187">ຂໍ້ກຳນົດບໍລິການເພີ່ມເຕີມຂອງ Chromium</translation>
<translation id="4835039973898764392">{COUNT,plural, =1{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານກຳນົດໃຫ້ທ່ານເປີດ Optimium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ມີໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນ ຫຼື ໜ້າຈໍແຍກເປີດຢູ່. ມັນຈະບໍ່ເປີດຄືນໃໝ່ຫຼັງຈາກທ່ານເລີ່ມເປີດໃຊ້ໃໝ່.}other{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານກຳນົດໃຫ້ທ່ານເປີດ Optimium ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ມີໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນ ແລະ ໜ້າຈໍແຍກ # ລາຍການເປີດຢູ່ໃນໂປຣໄຟລ໌ຕ່າງໆ. ພວກມັນຈະບໍ່ເປີດຄືນໃໝ່ຫຼັງຈາກທີ່ທ່ານເລີ່ມເປີດໃຊ້ໃໝ່.}}</translation>
<translation id="8065654717207240588">ໄຟລ໌ນີ້ເປັນອັນຕະລາຍ, ສະນັ້ນ Optimium ໄດ້ບລັອກມັນໄວ້ແລ້ວ.</translation>
<translation id="8177472873527554730">ບໍ່ພົບເນື້ອຫາໃນໜ້າ</translation>
<translation id="8200109504272824693">ໃສ່ລະຫັດຜ່ານຂອງທ່ານເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ Chromium ໃນບັນຊີຂອງທ່ານ, <ph name="USER_EMAIL" /></translation>
<translation id="8203105157044679380">ແຜງ Google ຊອກຫາ</translation>
<translation id="820759916613250543">ຊອກຫາຮູບນີ້ດ້ວຍຄຸນສົມບັດຊອກຫາຮູບ</translation>
<translation id="8221491193165283816">ໂດຍປົກກະຕິແລ້ວທ່ານບລັອກການແຈ້ງເຕືອນ. ເພື່ອອະນຸຍາດໃຫ້ເວັບໄຊນີ້ແຈ້ງເຕືອນທ່ານ, ກະລຸນາຄລິກບ່ອນນີ້.</translation>
<translation id="8223363452568144035">ເພື່ອໃຊ້ກ້ອງຂອງທ່ານ, ກະລຸນາມອບສິດເຂົ້າເຖິງໃຫ້ Chromium ໃນ <ph name="BEGIN_LINK" />ການຕັ້ງຄ່າລະບົບ<ph name="END_LINK" /></translation>
<translation id="1094434558959920914">Optimium ບໍ່ສາມາດຢັ້ງຢືນໄດ້ວ່າສ່ວນຂະຫຍາຍນີ້ມາຈາກໃສ ແລະ ມັນອາດບໍ່ປອດໄພ. ລຶບສ່ວນຂະຫຍາຍດັ່ງກ່າວອອກຈາກ Optimium ເພື່ອບໍ່ໃຫ້ເບິ່ງ ແລະ ປ່ຽນຂໍ້ມູນຂອງທ່ານຢູ່ເວັບໄຊທີ່ທ່ານເຂົ້າເບິ່ງ, ເຊິ່ງຮວມເຖິງຂໍ້ມູນສ່ວນຕົວ.</translation>
<translation id="3957438238123670294">ຖ້າຮູບບໍ່ມີລາຍລະອຽດທີ່ເປັນປະໂຫຍດ, Optimium ຈະພະຍາຍາມໃຫ້ລາຍລະອຽດແກ່ທ່ານ. ເພື່ອສ້າງລາຍລະອຽດ, ລະບົບຈະສົ່ງຮູບພາບໃຫ້ Google. ທ່ານສາມາດປິດສິ່ງນີ້ໃນການຕັ້ງຄ່າໄດ້ທຸກເວລາ.</translation>
<translation id="2706853324286223963">ເຂົ້າສູ່ລະບົບ Optimium ໃນໂປຣໄຟລ໌ໃໝ່ບໍ?</translation>
<translation id="1237310177197195175"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບຢູ່ແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium ໃນໂປຣໄຟລ໌ຂອງທ່ານເອງເປັນ <ph name="USER_EMAIL_ADDRESS" />. ນອກຈາກນີ້, ທ່ານຍັງຈະໄດ້ຮັບລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" /> ນຳ.</translation>
<translation id="2801607883759458012">ສະແດງ Gemini ໃນ Optimium ໃນຖາດລະບົບ ແລະ ເປີດຄີລັດ</translation>
<translation id="8286943863733751221"><ph name="BEGIN_LINK" />Chromium ຈະເຕືອນທ່ານ<ph name="END_LINK" /> ກ່ຽວກັບເວັບໄຊ ແລະ ການດາວໂຫຼດທີ່ບໍ່ປອດໄພ</translation>
<translation id="8295827201165805317">ທ່ານບໍ່ໄດ້ເຂົ້າເບິ່ງເມື່ອບໍ່ດົນມານີ້. Chromium ໄດ້ລຶບສິດເຂົ້າເຖິງ <ph name="PERMISSION" /> ອອກແລ້ວ.</translation>
<translation id="5265623464653503960">ເລືອກຊື້, ແປພາສາ ແລະ ລະບຸສິ່ງທີ່ທ່ານເຫັນດ້ວຍກ້ອງຂອງທ່ານຢູ່ແອັບ Optimium iOS</translation>
<translation id="7565411431973063464">ລະຫັດ QR ເພື່ອເຂົ້າສູ່ລະບົບ Optimium ໃນຊື່ <ph name="USER_NAME" /></translation>
<translation id="8313851650939857356">ຂໍ້ຜິດພາດໃນການເລີ່ມຕົ້ນ: <ph name="STARTUP_ERROR" />.</translation>
<translation id="5911806827430614904">ອົງກອນຂອງທ່ານປິດ Optimium ໄວ້ເມື່ອມັນບໍ່ໄດ້ຖືກນຳໃຊ້ເປັນເວລາ <ph name="TIMEOUT_DURATION" />.</translation>
<translation id="8321058241987390452">ສຳເລັດແລ້ວ! ຕອນນີ້ທ່ານສາມາດຖາມຄຳຖາມໄດ້ຢ່າງງ່າຍດາຍໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບດ້ວຍແຜງ Google ຊອກຫາ</translation>
<translation id="8321888067342493336">ບັນທຶກເປັນຮູບ</translation>
<translation id="1508573889613002459"><ph name="USER_EMAIL_ADDRESS" /> ເຄີຍໃຊ້ Optimium ໃນເມື່ອກ່ອນ</translation>
<translation id="8351551329754447960">ເປີດການນຳໃຊ້ທັກສະໃນ Chromium</translation>
<translation id="406081439566291910">ອັບເດດ Optimium ເພື່ອສືບຕໍ່ນຳໃຊ້ຂໍ້ມູນ Optimium ໃນບັນຊີ Google ຂອງທ່ານ, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="1007124785122331769">ເພື່ອໄດ້ຮັບການອັບເດດ Optimium ໃນອະນາຄົດ, ທ່ານຈະຕ້ອງໃຊ້ Windows 10 ຫຼື ໃໝ່ກວ່ານັ້ນ. ຄອມພິວເຕີນີ້ກຳລັງນຳໃຊ້ Windows 8.</translation>
<translation id="8362914115861174987">ແປພາສາເປັນ</translation>
<translation id="8367705492654390392">ຖາມຫຍັງກໍໄດ້</translation>
<translation id="8370517070665726704">ລິຂະສິດ <ph name="YEAR" /> Google LLC. ສະຫງວນສິດທັງໝົດ.</translation>
<translation id="3692978295966861512">ເພື່ອຮັບລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໃນອຸປະກອນທຸກເຄື່ອງຂອງທ່ານ, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium. ລະບົບຈະບັນທຶກລະຫັດຜ່ານນີ້ໄວ້ໃນບັນຊີ Google ຂອງທ່ານຫຼັງຈາກທີ່ທ່ານເຂົ້າສູ່ລະບົບ.</translation>
<translation id="7364603585139702314">ຈາກນັ້ນທ່ານຈະຕ້ອງຣີສະຕາດ Optimium.</translation>
<translation id="8376752431516546391">ແຜງຄວບຄຸມດ້ານຂ້າງຂອງ Google ຊອກຫາ</translation>
<translation id="8236183484860169180">Optimium ແນະນຳໃຫ້ທ່ານລຶບອອກ. <ph name="BEGIN_LINK" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບສ່ວນຂະຫຍາຍທີ່ຮອງຮັບ<ph name="END_LINK" /></translation>
<translation id="5920842078198979811">ນັກພັດທະນາຍົກເລີກການເຜີຍແຜ່ສ່ວນຂະຫຍາຍນີ້ແລ້ວ ແລະ ອາດບໍ່ປອດໄພ. ລຶບສ່ວນຂະຫຍາຍດັ່ງກ່າວອອກຈາກ Optimium ເພື່ອບໍ່ໃຫ້ເບິ່ງ ແລະ ປ່ຽນຂໍ້ມູນຂອງທ່ານຢູ່ເວັບໄຊທີ່ທ່ານເຂົ້າເບິ່ງ, ເຊິ່ງຮວມເຖິງຂໍ້ມູນສ່ວນຕົວຂອງທ່ານ.</translation>
<translation id="8406687098231754303">ຈາກປຸ່ມ "Google ຊອກຫາໃນແຜງຄວບຄຸມດ້ານຂ້າງ" ຢູ່ແຖບເຄື່ອງມື, ທ່ານສາມາດເປີດ Google ຊອກຫາໃນແຜງຄວບຄຸມດ້ານຂ້າງຄືນໃໝ່ເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="2185697372454035703">Optimium ຕ້ອງການຢັ້ງຢືນວ່າແມ່ນທ່ານກ່ອນຈະບັນທຶກຂໍ້ມູນບາງຢ່າງໃນບັນຊີ Google ຂອງທ່ານ ແລະ ໃຊ້ຢູ່ອຸປະກອນຂອງທ່ານທັງໝົດ. ຫາກທ່ານອອກຈາກລະບົບຕອນນີ້, ຂໍ້ມູນນີ້ຈະຖືກລຶບ.</translation>
<translation id="4724639108574581385">{0,plural, =1{ເປີດໃຊ້ Optimium ຄືນໃໝ່ພາຍໃນໜຶ່ງມື້}other{ເປີດໃຊ້ Optimium ຄືນໃໝ່ພາຍໃນ # ມື້}}</translation>
<translation id="8438543370129609977">ເມື່ອທ່ານໃຊ້ຄຸນສົມບັດຊອກຫາຮູບ, ລະບົບຈະສົ່ງຊື່ໜ້າ, URL ແລະ ເນື້ອຫາ, ຮວມທັງ PDF ໄປຫາເຊີບເວີ. <ph name="LEARN_MORE" /></translation>
<translation id="3557945352384776441">ສຶກສາເພີ່ມເຕີມກ່ຽວກັບການຊອກຫາດ້ວຍການຊອກຫາຮູບໃນ Optimium</translation>
<translation id="6672310590031980518">ຄັງຕົວຕິດຕັ້ງຖືກເສຍຫາຍ ຫຼືໃຊ້ບໍ່ໄດ້. ກະລຸນາດາວໂຫຼດ Optimium ອີກ.</translation>
<translation id="8463672209299734063">ຕົວເລືອກເສີມ: ຊ່ວຍປັບປຸງຄຸນສົມບັດ ແລະ ປະສິດທິພາບຂອງ ChromiumOS ໂດຍການສົ່ງຂໍ້ມູນການວິນິໄສ ແລະ ການນຳໃຊ້ໄປໃຫ້ Google ໂດຍອັດຕະໂນມັດ.</translation>
<translation id="3954441584666499211">ເພື່ອໃຊ້ ແລະ ບັນທຶກຂໍ້ມູນ Optimium ໃນບັນຊີ Google ຂອງທ່ານ, ກະລຸນາຢັ້ງຢືນວ່າແມ່ນທ່ານ</translation>
<translation id="8482493977473846331">ສະແດງຂໍ້ຄວາມເພື່ອເຂົ້າສູ່ລະບົບຫາ Chromium</translation>
<translation id="8202428378580208719">Optimium ຫຼ້າສະໄໝແລ້ວ</translation>
<translation id="850264194101621529">ຂໍຂອບໃຈທີ່ເລືອກ Chromium ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ!</translation>
<translation id="8520489851087523435">ເປີດແຜງຄວບຄຸມດ້ານຂ້າງຂອງ Google ຊອກຫາຄືນໃໝ່</translation>
<translation id="8522801943730206384">Chromium ສາມາດກວດເບິ່ງລະຫັດຜ່ານຂອງທ່ານເມື່ອທ່ານບັນທຶກພວກມັນໄວ້</translation>
<translation id="8525579356836940628">ຢຸດການຕິດຕັ້ງແລ້ວ</translation>
<translation id="8984919429007493543">ເຂົ້າເຖິງລະຫັດຜ່ານ, ແຖບ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍແອັບ Optimium ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ</translation>
<translation id="8555465886620020932">ບໍລິການຜິດພາດ: <ph name="SERVICE_ERROR" />.</translation>
<translation id="3963774984615461205">ຄຸນສົມບັດ ແລະ ສ່ວນຂະຫຍາຍບາງຢ່າງຂອງ Optimium ມາພ້ອມກັບທາງລັດ. ທ່ານສາມາດເລືອກທີ່ຈະເປີດໃຊ້ອີກຄັ້ງໄດ້.</translation>
<translation id="8556420416730706394">ທ່ານສາມາດປັກໝຸດການຊອກຫາຮູບເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ງ່າຍ; ໂດຍການຄລິກປຸ່ມປັກໝຸດຢູ່ເທິງສຸດຂອງແຜງຄວບຄຸມດ້ານຂ້າງ</translation>
<translation id="8564408666201523086">ສຳເລັດ! ຕອນນີ້ທ່ານສາມາດຖາມຄຳຖາມໄດ້ຢ່າງງ່າຍດາຍໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບດ້ວຍ Google ຊອກຫາໃນແຜງຄວບຄຸມດ້ານຂ້າງ</translation>
<translation id="856656450041460113">ຊອກຫາລາຍການພາສາ</translation>
<translation id="8568499811906962479">ທ່ານສາມາດປັກໝຸດແຜງ Google ຊອກຫາເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບໄດ້</translation>
<translation id="2996904635986800713">ຫຼາຍອົງການຈັດການ Optimium</translation>
<translation id="8586442755830160949">ລິຂະສິດ <ph name="YEAR" /> ຜູ້ຂຽນ Chromium. ສະຫງວນສິດທັງໝົດ.</translation>
<translation id="8590782867495422699">ເປີດໂໝດ AI ຂອງ Google ຊອກຫາຄືນໃໝ່</translation>
<translation id="2446482746737130055">ກຳລັງເປີດໃຊ້ Optimium...</translation>
<translation id="8624541899164515475">ການຕັ້ງຄ່າ, ເປີດໃນແຖບໃໝ່.</translation>
<translation id="8648201657708811153">ບໍ່ສາມາດຕັ້ງ Google Chrome ສຳລັບການທົດສອບເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານໄດ້.</translation>
<translation id="9172606645924379921">ຊອກຫາດ້ວຍ Optimium ໄດ້ຈາກທຸກບ່ອນ</translation>
<translation id="8689408573494410517">ປຸ່ມ "Google ຊອກຫາໃນແຜງຄວບຄຸມດ້ານຂ້າງ" ຢູ່ແຖບເຄື່ອງມືມີໄອຄອນໃໝ່. ຄລິກມັນເພື່ອຖາມຄຳຖາມໃນຂະນະທີ່ທ່ານເລືອກເບິ່ງດ້ວຍ Google ຊອກຫາໃນແຜງຄວບຄຸມດ້ານຂ້າງ.</translation>
<translation id="5596132704047725626">ມັນຍັງຄວບຄຸມວ່າຈະໃຫ້ສະແດງໜ້າໃດຂຶ້ນ ເມື່ອທ່ານເລີ່ມຕົ້ນເປີດ Optimium ຫຼືຄົ້ນຫາຈາກ Omnibox.</translation>
<translation id="567010981548424498">ເພື່ອສົ່ງແຖບນີ້ໄປຫາອຸປະກອນອື່ນ, ໃຫ້ເຂົ້າສູ່ລະບົບຫາ Optimium ຢູ່ບ່ອນນັ້ນ</translation>
<translation id="4758459198907306138">ນີ້​ແມ່ນ Optimium ຂອງ​ທ່ານ</translation>
<translation id="8712637175834984815">ເຂົ້າໃຈແລ້ວ</translation>
<translation id="5293592838971423777">ເຂົ້າສູ່ລະບົບ Optimium ບໍ?</translation>
<translation id="8747073452963259673">ມຸມຊ້າຍລຸ່ມຂອງພື້ນທີ່ຊອກຫາ: ຊ້າຍ <ph name="LEFT" />%, ລຸ່ມ <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">ຂໍ້ຜິດພາດໃນການຕິດຕັ້ງ: ຜູ້ເບິ່ງແຍງລະບົບເຄືອຂ່າຍຂອງທ່ານໃຊ້ນະໂຍບາຍລະດັບກຸ່ມເຊິ່ງປ້ອງກັນການຕິດຕັ້ງ: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">ແຈ້ງເຕືອນຂ້ອຍໃນພາຍຫຼັງ</translation>
<translation id="8601403845093292651">ແບ່ງປັນເອກະສານນີ້ກັບ Gemini ໃນ Optimium ເພື່ອຮັບພາບຮວມໂດຍຫຍໍ້ ແລະ ຖາມຄຳຖາມຕິດຕາມຜົນ</translation>
<translation id="3011694712607672183">ເຂົ້າສູ່ລະບົບ Optimium ບໍ?</translation>
<translation id="8823401858233292222">ຕັ້ງ Chromium ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນ ແລະ ປັກໝຸດໄວ້ຢູ່ແຖບໜ້າວຽກ</translation>
<translation id="8826492472752484139">ຄລິກ “ຕົວຈັດການລະຫັດຜ່ານ”</translation>
<translation id="8833697763442816810">ລະບົບ ChromiumOS</translation>
<translation id="8852026904190808918">ລະບົບຈະໃຊ້ພາສານີ້ເພື່ອສະແດງເມນູ, ການຕັ້ງຄ່າ, ແຈ້ງເຕືອນ ແລະ ຂໍ້ຄວາມອື່ນໆໃນ Chromium</translation>
<translation id="8862326446509486874">ທ່ານບໍ່ມີສິດທິທີ່ເໝາະສົມສໍາລັບຕິດຕັ້ງ​ໃນລະດັບລະບົບ. ລອງແລ່ນຕົວຕິດຕັ້ງນີ້ອີກ​ໃນ​ຖານະ​ເປັນ​ຜູ້ຄວບຄຸມ.</translation>
<translation id="8400219074131043686">ເພີ່ມໂປຣໄຟລ໌ Optimium</translation>
<translation id="3471339840299959661">ChromiumOS ບໍ່ສາມາດບັນທຶກຂໍ້ມູນ Optimium ໃນບັນຊີ Google ຂອງທ່ານໄດ້ເນື່ອງຈາກເກີດຂໍ້ຜິດພາດໃນການເຂົ້າສູ່ລະບົບ</translation>
<translation id="8161120518458367008">ອົງກອນຂອງທ່ານກຳນົດໃຫ້ທ່ານເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="8897637834206928776">ໄອຄອນໃໝ່, ທາງລັດເກົ່າ: ຄລິກເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບດ້ວຍ Google ຊອກຫາໃນແຜງຄວບຄຸມດ້ານຂ້າງ.</translation>
<translation id="3459877940554598369">Optimium ຕ້ອງໃຊ້ Windows 10 ເວີຊັນ 1809 ຂຶ້ນໄປ.</translation>
<translation id="4176797355456373725">Optimium ກໍາລັງພະຍາຍາມສະແດງລະຫັດຜ່ານ. ພິມລະຫັດຜ່ານ Windows ຂອງທ່ານ ເພື່ອອະນຸຍາດອັນນີ້.</translation>
<translation id="8300184335948277828">Optimium ບໍ່ແມ່ນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານອີກຕໍ່ໄປ. ຕັ້ງຄ່າ Optimium ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນບໍ?</translation>
<translation id="8365648631713891786">ບໍ່ສາມາດອັບເດດ Optimium ໄດ້</translation>
<translation id="8944232836376404813">ການດຳເນີນການນີ້ຈະເຮັດສິ່ງຕໍ່ໄປນີ້
          <ph name="LINE_BREAKS" />
            • ຣີເຊັດໜ້າເລີ່ມຕົ້ນ, ໜ້າແຖບໃໝ່, ໂປຣແກຣມຊອກຫາ ແລະ ແຖບທີ່ປັກໝຸດແລ້ວຂອງທ່ານ
            <ph name="LINE_BREAK" />
            • ປິດການນຳໃຊ້ສ່ວນຂະຫຍາຍ
            <ph name="LINE_BREAK" />
            • ລຶບຄຸກກີ້ ແລະ ຂໍ້ມູນເວັບໄຊຊົ່ວຄາວອື່ນໆ
            <ph name="LINE_BREAKS" />
            ການດຳເນີນການນີ້ຈະບໍ່ມີຜົນກັບບຸກມາກ, ປະຫວັດ ແລະ ລະຫັດຜ່ານທີ່ບັນທຶກໄວ້.</translation>
<translation id="4517341657960407384">ສະແດງທາງລັດເວັບໄຊ Optimium</translation>
<translation id="6334459924587075942">ໂລໂກ້ Optimium Enterprise</translation>
<translation id="1013608620694172987">ນຳຄວາມປອດໄພຂອງ Google ໄປໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍແອັບ Optimium ຢູ່ <ph name="DEVICE_TYPE" /> ຂອງທ່ານ</translation>
<translation id="6377692339934065652">ບໍ່ສາມາດເລີ່ມ Optimium ໄດ້ເນື່ອງຈາກມີບາງຢ່າງຜິດພາດເກີດຂຶ້ນເມື່ອເປີດໂປຣໄຟລ໌ຂອງທ່ານ. ລອງຣີສະຕາດ Optimium.</translation>
<translation id="8411734418760705455">ເພື່ອຊອກຫາດ້ວຍ Optimium ຫຼື ປັບແຕ່ງໃນ <ph name="BEGIN_LINK" />ການຕັ້ງຄ່າ<ph name="END_LINK" /></translation>
<translation id="4403836439014450645">ຈັດການໂປຣໄຟລ໌ Optimium</translation>
<translation id="7714694033208252813">ໃຊ້ແປ້ນພິມຂອງທ່ານເພື່ອນຳທາງລະຫວ່າງ Gemini ໃນ Optimium ແລະ ແຖບທີ່ເປີດຢູ່ຂອງທ່ານ.</translation>
<translation id="9018218886431812662">ສຳເລັດການຕິດຕັ້ງແລ້ວ</translation>
<translation id="4028461118515168614">ເພື່ອເຮັດໃຫ້ Optimium ປອດໄພຂຶ້ນ, ພວກເຮົາປິດໃຊ້ງານບາງສ່ວນການ​ຕໍ່​ເຂົ້າ​ຫາ ທີ່​ບໍ່​ໄດ້​ເຮັດ​ເປັນ​ລາຍ​ການ​ໄວ້​ຢູ່​ໃນ <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ແລະ​ອາດ​ຈະ​ຖືກ​ເອົາ​ເພີ່ມ​ເຂົ້າ​ໂດຍ​ທີ່​ທ່ານ​ບໍ່​ຮູ້​ຈັກ.</translation>
<translation id="8853260188791570953">ລົງຊື່ເຂົ້າ​ໃຊ້ Optimium</translation>
<translation id="6769418925691762561">ສະແດງການຊອກຫາດ້ວຍ Optimium ໃນແຖບເມນູຂອງ Mac ແລະ ເປີດຄີລັດ</translation>
<translation id="1582160730719680639">Optimium ບລັອກການດາວໂຫຼດນີ້ເພາະວ່າໄຟລ໌ທີ່ເກັບໄວ້ໃນແຟ້ມມີໄຟລ໌ອື່ນໆທີ່ອາດຈະເຊື່ອງເມົາແວໄວ້</translation>
<translation id="136372829312763612">ຊິ້ງລະຫັດຜ່ານ, ບຸກມາກ ແລະ ປະຫວັດຂອງທ່ານໃນອຸປະກອນຕ່າງໆໄດ້ຢ່າງສົມບູນແບບ. ເຂົ້າເຖິງຄຸນສົມບັດທີ່ທ່ານຮູ້ຈັກ ແລະ ມັກໄດ້ຢ່າງງ່າຍດາຍໂດຍອັບເດດໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານເປັນ Optimium. ລະບົບຈະປັກໝຸດ Optimium ໄວ້ຢູ່ແຖບໜ້າວຽກຂອງທ່ານເພື່ອໃຫ້ເຂົ້າເຖິງໄດ້ຢ່າງວ່ອງໄວ.</translation>
<translation id="4121763951659864948">ໃຊ້ເຄື່ອງມື AI ທີ່ດີທີ່ສຸດຂອງ Google ດ້ວຍແອັບ Optimium ຢູ່ໂທລະສັບຂອງທ່ານ</translation>
<translation id="570680773394181802">ເພື່ອເຂົ້າເຖິງລະຫັດຜ່ານ ແລະ ຂໍ້ມູນອື່ນໆຂອງທ່ານຈາກ <ph name="DEVICE" />, ໃຫ້ເຂົ້າສູ່ລະບົບ Optimium</translation>
<translation id="9062666675513499497">ເຂົ້າສູ່ລະບົບ Chromium ເມື່ອທ່ານເຂົ້າສູ່ລະບົບບໍລິການອື່ນໆຂອງ Google</translation>
<translation id="9074041031320636790">ສຳເລັດ! ຕອນນີ້ທ່ານສາມາດຖາມຄຳຖາມໄດ້ຢ່າງງ່າຍດາຍໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບດ້ວຍໂໝດ AI ຂອງ Google ຊອກຫາ</translation>
<translation id="9074163480955555019">ໄອຄອນໃໝ່, ແຕ່ທາງລັດເກົ່າ: ຄລິກເພື່ອຖາມຄຳຖາມໃນລະຫວ່າງທີ່ທ່ານທ່ອງເວັບດ້ວຍ Google ຊອກຫາໃນ Chrome.</translation>
<translation id="516400912738056453">Optimium ຖືກປິດໂດຍອັດຕະໂນມັດ</translation>
<translation id="807899198682302888">Optimium ຫຼ້າສະໄໝແລ້ວ</translation>
<translation id="4711199283523757502">{0,plural, =1{Optimium ຈະເປີດຄືນໃໝ່ໃນໜຶ່ງຊົ່ວໂມງ}other{Optimium ຈະເປີດຄືນໃໝ່ໃນ # ຊົ່ວໂມງ}}</translation>
<translation id="9106236359747881194">ເລືອກຂໍ້ຄວາມທີ່ຈະຊອກຫາ</translation>
<translation id="8368867604698561866">ເພື່ອໄດ້ຮັບການອັບເດດ Optimium ໃນອະນາຄົດ, ທ່ານຈະຕ້ອງໃຊ້ Windows 10 ຫຼື ໃໝ່ກວ່ານັ້ນ. ຄອມພິວເຕີນີ້ກຳລັງນຳໃຊ້ Windows 8.1.</translation>
<translation id="4437683009835184797">ເປີດລິ້ງໃນແຖບ Optimium ໃໝ່</translation>
<translation id="911206726377975832">ລຶບຂໍ້ມູນການທ່ອງເນັດຂອງທ່ານນໍາບໍ?</translation>
<translation id="9118146721060781133">ປຸ່ມ "ໜ້າວຽກຕາມບໍລິບົດ" ຢູ່ແຖບເຄື່ອງມືມີໄອຄອນໃໝ່. ຄລິກມັນເພື່ອຖາມຄຳຖາມໃນຂະນະທີ່ທ່ານເລືອກເບິ່ງດ້ວຍໜ້າວຽກຕາມບໍລິບົດ.</translation>
<translation id="9134482777260927479">ຄວາມຊ່ວຍເຫຼືອໃນການເຮັດວຽກບ້ານ</translation>
<translation id="9148058034647219655">ອອກ</translation>
<translation id="3295815393935110309">ສືບຕໍ່ຈາກບ່ອນທີ່ທ່ານຄ້າງໄວ້: Optimium ສາມາດກູ້ຄືນແຖບຂອງທ່ານໄດ້ທຸກຄັ້ງທີ່ທ່ານປິດເປີດໃໝ່. ເພື່ອເປີດໃຊ້ສິ່ງນີ້, ໃຫ້ໄປຫາ</translation>
<translation id="5167935114017057528">ຜູ້ເບິ່ງແຍງລະບົບໄດ້ກຳນົດຄ່າ Optimium ໃຫ້ເປີດໂປຣແກຣມທ່ອງເວັບສຳຮອງເພື່ອເຂົ້າເຖິງ <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="903669083727317908">ເລີ່ມເປີດໃຊ້ໃໝ່ເພື່ອອັບເດດ &amp;Optimium</translation>
<translation id="1256233032126781893">Optimium (mDNS-In)</translation>
<translation id="6225435091563451277">ຕັ້ງຄ່າ Optimium ໃນແບບຂອງທ່ານເອງ</translation>
<translation id="1987988401118534091">Optimium ອາດຈະບໍ່ເຮັດວຽກຢ່າງຖືກຕ້ອງ ເພາະວ່າມັນບໍ່ຖືກຮອງຮັບໃນ Windows XP ຫຼື Windows Vista ອີກຕໍ່ໄປ</translation>
<translation id="8102971646278891292">ໃຊ້ຄຸນສົມບັດຄວາມປອດໄພທີ່ດີທີ່ສຸດຂອງ Google ໄດ້ທຸກບ່ອນທຸກເວລາດ້ວຍ Optimium.</translation>
<translation id="945522503751344254">ສົ່ງ​ຄໍາ​ຄິດ​​ເຫັນ</translation>
<translation id="225981349930289899">ໃຜກຳລັງໃຊ້ Optimium)</translation>
<translation id="2788235168912697021">ໃຊ້ຄວາມປອດໄພຂັ້ນສູງສຸດຂອງ Optimium</translation>
<translation id="983803489796659991">ການຕິດຕັ້ງບໍ່ສຳເລັດເນື່ອງຈາກເຊີບເວີອັບເດດບໍ່ມີຂໍ້ມູນ hash ໃດໆສຳລັບແອັບພລິເຄຊັນ.</translation>
<translation id="802168381040095988">ໃຊ້ Optimium ໂດຍບໍ່ມີບັນຊີ</translation>
<translation id="985602178874221306">ຜູ້ຂຽນ Chromium</translation>
<translation id="989970834842471429">ເລືອກຂໍ້ຄວາມ ຫຼື ຮູບເພື່ອຊອກຫາດ້ວຍການຊອກຫາຮູບ</translation>
<translation id="992780518932311116">ເພື່ອໃຊ້ສະຖານທີ່ຂອງທ່ານ, ກະລຸນາມອບສິດເຂົ້າເຖິງໃຫ້ Chromium ໃນ <ph name="BEGIN_LINK" />ການຕັ້ງຄ່າລະບົບ<ph name="END_LINK" /></translation>
</translationbundle>

<!DOCTYPE translationbundle>
<translationbundle lang="si">
<translation id="1026101648481255140">ස්ථාපනය නැවත ආරම්භ කරන්න</translation>
<translation id="1029669172902658969">&amp;ChromiumOS යාවත්කාලීන කිරීමට යළි දියත් කරන්න</translation>
<translation id="4063809399345498325">Optimium ඔබට මෙම දිගුව සමාලෝචනය කිරීමට නිර්දේශ කරයි</translation>
<translation id="1042552502243217427">අඩවියක් ඒවායේ පිටුවේ සබැඳි පෞද්ගලිකව පූර්ව පූරණය කිරීමට ඉල්ලා සිටින විට, Chromium Google සේවාදායක භාවිත කරයි. මෙය පූර්ව පූරණය කර ඇති අඩවියෙන් ඔබේ අනන්‍යතාව සඟවන නමුත්, Google පූර්ව පූරණය කරනු ලබන අඩවි මොනවා දැයි ඉගෙන ගනියි.</translation>
<translation id="1051793555070215510">මෙම මිනිත්තු 1ක සමීක්ෂණයට සහභාගී වීමෙන් අප්‍රසිද්ධ වැඩි දියුණු කිරීමට අපට උදවු කරන්න.</translation>
<translation id="1065672644894730302">ඔබේ තේරීම් කියවිය නොහැක.

ඇතැම් විශේෂාංගයන් නොපැවතිය හැකි අතර තේරීම් වල සිදුකරන වෙනස්ක්ම් නොසුරැකෙනු ඇත.</translation>
<translation id="7250992450852052182">ඔබේ මාපියන් Optimium සඳහා "වෙබ් අඩවි, යෙදුම්, සහ දිගු සඳහා වන අවසර" අක්‍රිය කර ඇත</translation>
<translation id="6711838932294803312">අවට උපාංග සොයා ගැනීමට සහ භාවිතා කිරීමට Optimium හට ඔබේ ස්ථානීය ජාලයට ප්‍රවේශය අවශ්‍ය වේ</translation>
<translation id="2807920805712601449">නිශ්චිත Optimium විශේෂාංගයක් හෝ දිගුවක් සෙවීමට, ලිපින තීරුවේ එහි කෙටිමඟ ටයිප් කරන්න, ඉන්පසු ඔබ තෝරා ගත් යතුරුපුවරු යතුර</translation>
<translation id="5994612110840535151">පද්ධති තැටියේ Optimium සෙවුම පෙන්වා යතුරුපුවරු කෙටිමඟ සක්‍රිය කරන්න</translation>
<translation id="7212528213853025915">Optimium හට ඔබගේ මුරපද නිර්යාත කිරීමට අවශ්‍යය. මේ සඳහා අවසර දීමට ඔබගේ Windows මුරපදය ටයිප් කරන්න.</translation>
<translation id="112640046208448578">දේවල් හෝ ස්ථාන හඳුනාගෙන පෙළ පිටපත් කරන්න හෝ පරිවර්තනය කරන්න. ඔබ රූප සෙවීම භාවිත කරන විට, පිටුවේ තිර රුවක් සේවාදායකයට යවනු ලැබේ. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium ඔබේ පෙරනිමි බ්‍රව්සරය වේ</translation>
<translation id="1131805035311359397">ඔබගේ මුරපද දත්ත කඩ කිරීම්වලින් සහ අනෙකුත් ආරක්ෂක ගැටලුවලින් සුරක්ෂිතද යන්න පරීක්ෂා කිරීමට, <ph name="BEGIN_LINK" />Chromium වෙත පුරන්න<ph name="END_LINK" />.</translation>
<translation id="3458316367708035110">{COUNT,plural, =1{මෙම යාවත්කාලීනය යෙදීමට Optimium නැවත ආරම්භ කරන ලෙසට පරිපාලකයා ඔබට පවසයි. අප්‍රසිද්ධ හෝ හුදකලා කවුළුවක් විවෘතව ඇත. ඔබ යළි දියත් කිරීමෙන් පසුව එය නැවත විවෘත නොවනු ඇත.}one{මෙම යාවත්කාලීනය යෙදීමට Optimium නැවත ආරම්භ කරන ලෙසට පරිපාලකයා ඔබට පවසයි. පැතිකඩ හරහා අප්‍රසිද්ධ සහ හුදකලා කවුළු # ක් විවෘතව ඇත. ඔබ යළි දියත් කිරීමෙන් පසුව ඒවා නැවත විවෘත නොවනු ඇත.}other{මෙම යාවත්කාලීනය යෙදීමට Optimium නැවත ආරම්භ කරන ලෙසට පරිපාලකයා ඔබට පවසයි. පැතිකඩ හරහා අප්‍රසිද්ධ සහ හුදකලා කවුළු # ක් විවෘතව ඇත. ඔබ යළි දියත් කිරීමෙන් පසුව ඒවා නැවත විවෘත නොවනු ඇත.}}</translation>
<translation id="1150418667633096194">මෙවලම් තීරුවේ ඇති "Google සෙවීම් පැති පැනලය" බොත්තමට නව නිරූපකයක් ඇත. ඔබ Google සෙවීම් පැති පැනලය සමග බ්‍රවුස් කරන විට ප්‍රශ්න ඇසීමට එය ක්ලික් කරන්න.</translation>
<translation id="759898790519515623">Optimium මෙනුව ක්ලික් කරන්න</translation>
<translation id="1157952955648710254">Google සෙවීම් පැති පැනලය වසන්න</translation>
<translation id="1157985233335035034">මෑත භාෂා</translation>
<translation id="1184145431117212167">ඔබේ Windows අනුවාදය සඳහා සහය නොදක්වන නිසා ස්ථාපනය අසමත් විය.</translation>
<translation id="1185134272377778587">Chromium පිළිබඳ</translation>
<translation id="5987505065981917957">ඔබේ දුරකථනයෙන් Optimium සමග මිල නිරීක්ෂණ ඇඟවීම් ලබා ගන්න</translation>
<translation id="1203500561924088507">ස්ථාපනය කිරීම වෙනුවෙන් ස්තුතියි. ඔබ <ph name="BUNDLE_NAME" /> භාවිත කිරීමට පෙර ඔබගේ බ්‍රවුසරය යළි ඇරඹිය යුතුය.</translation>
<translation id="1232234696885483911">ඔබ රූප සෙවීම විවෘත කරන විට, පිටුවේ මාතෘකාව, URL, සහ PDF ඇතුළු අන්තර්ගතය ස්වයංක්‍රීයව සේවාදායකය වෙත යවනු ලැබේ. <ph name="LEARN_MORE" /></translation>
<translation id="3560913454241378492">ඔබ පුරනය වී සිටින අතරතුර, ඔබට Optimium තුළ ඔබේ Google ගිණුමෙන් ඔබේ මුරපද සහ තවත් ඒවා භාවිත කළ හැක මෙය වෙනස් කිරීමට, “Optimium තුළ ඔබේ ගිණුම” වෙත යන්න.</translation>
<translation id="8922965532693587493">Mac මෙනු තීරුවේ Optimium තුළ Gemini පෙන්වන්න</translation>
<translation id="236433590733312836">Optimium තුළ Gemini තුළ තිරයේ කොටසක් තේරීමට, යතුරුපුවරු කෙටිමඟ භාවිතා කරන්න.</translation>
<translation id="7976124325589452515">මෙම පටිත්ත අක්‍රියව තිබෙන අතරේ, Optimium වේගවත්ව තබා ගැනීම සඳහා මතකය නිදහස් කරන ලදි. ඔබට මෙම අඩවිය අක්‍රිය වීමෙන් සැම විට බැහැර කිරීමට තෝරා ගත හැක.</translation>
<translation id="2758503437544511902">ගොනුව භයානක නිසා Optimium මෙම බාගැනීම අවහිර කර ඇත</translation>
<translation id="126567311906253476"><ph name="USER_EMAIL" /> සමග Gmail හෝ YouTube වැනි Google සේවාවලට පුරන විට, ඔබට එම ගිණුමෙන්ම Chromium වෙත ස්වයංක්‍රීයව පුරනය විය හැක</translation>
<translation id="4104061172701635162">ඔබේ දුරකථනයෙන් Optimium ලබා ගන්න</translation>
<translation id="1290883685122687410">පිහිටුවීමේ දෝෂයකි: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="3443894627866827446">ඔබගේ නව Optimium පැතිකඩ පිහිටුවන්න</translation>
<translation id="8946186262159916495">Optimium හි Gemini සමග උත්සාහ කරන්න</translation>
<translation id="7981347318091963592">බ්ලූටූත් උපාංග ගවේෂණය කිරීමට Optimium හට බ්ලූටූත් ප්‍රවේශය අවශ්‍යයි.<ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6099322702899630168">ඔබේ දුරකථනයෙන් Optimium වෙත පුරන්න</translation>
<translation id="1330562121671411446">භාෂාව අනාවරණය කරන්න</translation>
<translation id="3294414641786025647">Optimium වෙතින් ද දත්ත මකන්න (<ph name="URL" />)</translation>
<translation id="4214354213779528068">{COUNT,plural, =1{යාවත්කාලීනයක් ක්‍රියාත්මක කිරීම සඳහා, උසස් ආරක්ෂාව මඟින් ඔබ Optimium යළි දියත් කළ යුතුය. අප්‍රසිද්ධ හෝ හුදකලා කවුළුවක් විවෘතව ඇත. ඔබ යළි දියත් කිරීමෙන් පසුව එය නැවත විවෘත නොවනු ඇත.}one{යාවත්කාලීනයක් ක්‍රියාත්මක කිරීම සඳහා, උසස් ආරක්ෂාව මඟින් ඔබ Optimium යළි දියත් කළ යුතුය. පැතිකඩ හරහා අප්‍රසිද්ධ සහ හුදකලා කවුළු # ක් විවෘතව ඇත. ඔබ යළි දියත් කිරීමෙන් පසුව ඒවා නැවත විවෘත නොවනු ඇත.}other{යාවත්කාලීනයක් ක්‍රියාත්මක කිරීම සඳහා, උසස් ආරක්ෂාව මඟින් ඔබ Optimium යළි දියත් කළ යුතුය. පැතිකඩ හරහා අප්‍රසිද්ධ සහ හුදකලා කවුළු # ක් විවෘතව ඇත. ඔබ යළි දියත් කිරීමෙන් පසුව ඒවා නැවත විවෘත නොවනු ඇත.}}</translation>
<translation id="1345251407431278948">අමුණන ලදි! ඔබට මෙවලම් තීරුවේ ඇති නව බොත්තමෙන් රූප සෙවීම වෙත නැවත ප්‍රවේශ විය හැක</translation>
<translation id="1383876407941801731">සොයන්න</translation>
<translation id="7825299065989465359">යන ගමන් බ්‍රවුස් කිරීම තබා ගැනීමට Optimium යෙදුම භාවිතා කරන්න</translation>
<translation id="141901961143729572">ඔබේ සිතුවිලි බෙදා ගන්න</translation>
<translation id="1438812738230833934">ඔබ බ්‍රවුස් කරන අතරේ ප්‍රශ්න ඇසීමට ඔබට පැති පැනලයේ Google සෙවීම නැවත විවෘත කළ හැක</translation>
<translation id="4131307166987455854">ඔබේ කවුළුව බෙදා ගැනීමට, පද්ධති සැකසීම් තුළ Optimium සඳහා තිර පටිගත කිරීමට ඉඩ දෙන්න.</translation>
<translation id="1470136641087909499">ඔබ බ්‍රවුස් කරන අතරේ ප්‍රශ්න ඇසීමට ඔබට Chrome හි Google සෙවීම නැවත විවෘත කළ හැක</translation>
<translation id="1478370723027452770">පරීක්ෂා කිරීම සඳහා Chrome සමග උදවු ලබා ගන්න</translation>
<translation id="9200022682397754538"><ph name="DEVICE" /> වෙතින් ඔබේ සුරකින ලද තතු සහ තවත් දේ ලබා ගැනීමට, Optimium තුළට පුරන්න</translation>
<translation id="1497802159252041924">ස්ථාපනය කිරීමේ දෝෂයක්: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">මෙම පිටුව ආරක්ෂිතයි.</translation>

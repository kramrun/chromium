<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="vi">
<translation id="1026101648481255140">Tiếp tục cài đặt</translation>
<translation id="1029669172902658969">Chạy lại để cập nhật &amp;ChromiumOS</translation>
<translation id="4063809399345498325">Optimium khuyên bạn nên xem xét tiện ích này</translation>
<translation id="1042552502243217427">Khi một trang web yêu cầu tải trước các đường liên kết trên trang ở chế độ riêng tư, Chromium sẽ sử dụng các máy chủ của Google. Điều này giúp ẩn danh tính của bạn khỏi trang web được tải trước, nhưng Google sẽ biết những trang web được tải trước.</translation>
<translation id="1051793555070215510">Vui lòng dành một phút làm bản khảo sát này để giúp chúng tôi cải thiện chế độ ẩn danh.</translation>
<translation id="1065672644894730302">Không thể đọc tùy chọn của bạn. Một số tính năng có thể không khả dụng và các thay đổi đối với tùy chọn sẽ không được lưu.</translation>
<translation id="7250992450852052182">Cha mẹ bạn đã tắt tuỳ chọn "Quyền của các trang web, ứng dụng và tiện ích" đối với Optimium</translation>
<translation id="6711838932294803312">Optimium cần có quyền truy cập vào mạng cục bộ của bạn để tìm và sử dụng thiết bị ở gần</translation>
<translation id="2807920805712601449">Để tìm kiếm một tính năng hoặc tiện ích cụ thể của Optimium, hãy nhập lối tắt của tính năng hoặc tiện ích đó vào thanh địa chỉ, sau đó nhấn phím bạn chọn trên bàn phím</translation>
<translation id="5994612110840535151">Hiện tính năng tìm kiếm bằng Optimium trên khay hệ thống và bật phím tắt</translation>
<translation id="7212528213853025915">Optimium muốn xuất các mật khẩu của bạn. Hãy nhập mật khẩu Windows để cho phép thực hiện việc này.</translation>
<translation id="112640046208448578">Xác định đồ vật hoặc địa điểm, sao chép hoặc dịch văn bản. Khi bạn sử dụng tính năng Tìm kiếm hình ảnh, ảnh chụp màn hình trang sẽ được gửi đến máy chủ. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium là trình duyệt mặc định của bạn</translation>
<translation id="1131805035311359397">Để kiểm tra xem mật khẩu của bạn có bị ảnh hưởng bởi các vụ rò rỉ dữ liệu và sự cố bảo mật khác hay không, hãy <ph name="BEGIN_LINK" />đăng nhập vào Chromium<ph name="END_LINK" />.</translation>
<translation id="3458316367708035110">{COUNT,plural, =1{Quản trị viên yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật này. Có cửa sổ ẩn danh hoặc cửa sổ biệt lập đang mở. Cửa sổ ẩn danh hoặc cửa sổ biệt lập sẽ không mở lại sau khi bạn chạy lại.}other{Quản trị viên yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật này. Có # cửa sổ ẩn danh và cửa sổ biệt lập đang mở trên các hồ sơ. Những cửa sổ này sẽ không mở lại sau khi bạn chạy lại.}}</translation>
<translation id="1150418667633096194">Nút "Bảng điều khiển bên của Google Tìm kiếm" trên thanh công cụ vừa có biểu tượng mới. Hãy nhấp vào biểu tượng này để đặt câu hỏi trong khi duyệt web bằng bảng điều khiển bên của Google Tìm kiếm.</translation>
<translation id="759898790519515623">Nhấp vào trình đơn Optimium</translation>
<translation id="1157952955648710254">Đóng bảng điều khiển bên của Google Tìm kiếm</translation>
<translation id="1157985233335035034">Ngôn ngữ gần đây</translation>
<translation id="1184145431117212167">Không cài đặt được vì phiên bản Windows bạn đang sử dụng chưa được hỗ trợ.</translation>
<translation id="1185134272377778587">Giới thiệu về Chromium</translation>
<translation id="5987505065981917957">Nhận thông báo theo dõi giá từ Optimium trên điện thoại</translation>
<translation id="1203500561924088507">Cảm ơn bạn đã cài đặt. Bạn phải khởi động lại trình duyệt trước khi sử dụng <ph name="BUNDLE_NAME" />.</translation>
<translation id="1232234696885483911">Khi bạn mở tính năng Tìm kiếm hình ảnh, thì tiêu đề, URL và nội dung của trang, bao gồm cả tệp PDF, sẽ được tự động gửi đến máy chủ. <ph name="LEARN_MORE" /></translation>
<translation id="3560913454241378492">Khi đăng nhập, bạn có thể sử dụng mật khẩu và nhiều nội dung khác từ Tài khoản Google của mình trong Optimium. Để thay đổi chế độ cài đặt này, hãy chuyển đến phần "Tài khoản của bạn trong Optimium".</translation>
<translation id="8922965532693587493">Hiện Gemini trong Optimium trên thanh trình đơn của máy Mac</translation>
<translation id="236433590733312836">Để chọn một phần màn hình trong Gemini trong Optimium, hãy dùng phím tắt.</translation>
<translation id="7976124325589452515">Mặc dù thẻ này không hoạt động nhưng bộ nhớ đã được giải phóng để giúp Optimium luôn hoạt động nhanh. Bạn có thể chọn luôn loại trừ trang web này khỏi trạng thái không hoạt động.</translation>
<translation id="2758503437544511902">Optimium đã chặn tệp tải xuống này vì đây là tệp nguy hiểm</translation>
<translation id="126567311906253476">Khi đăng nhập vào các dịch vụ của Google như Gmail hoặc YouTube bằng <ph name="USER_EMAIL" />, bạn có thể tự động được đăng nhập vào Chromium bằng cùng một tài khoản</translation>
<translation id="4104061172701635162">Tải Optimium về điện thoại</translation>
<translation id="1290883685122687410">Lỗi thiết lập: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="3443894627866827446">Thiết lập hồ sơ Optimium mới</translation>
<translation id="8946186262159916495">Dùng thử với Gemini trong Optimium</translation>
<translation id="7981347318091963592">Optimium cần có quyền truy cập Bluetooth để tìm
 các thiết bị Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6099322702899630168">Đăng nhập vào Optimium trên điện thoại</translation>
<translation id="1330562121671411446">Phát hiện ngôn ngữ</translation>
<translation id="3294414641786025647">Cũng xoá dữ liệu khỏi Optimium (<ph name="URL" />)</translation>
<translation id="4214354213779528068">{COUNT,plural, =1{Chế độ Bảo vệ nâng cao yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật. Có cửa sổ ẩn danh hoặc cửa sổ biệt lập đang mở. Cửa sổ ẩn danh hoặc cửa sổ biệt lập sẽ không mở lại sau khi bạn chạy lại.}other{Chế độ Bảo vệ nâng cao yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật. Có # cửa sổ ẩn danh và cửa sổ biệt lập đang mở trên các hồ sơ. Những cửa sổ này sẽ không mở lại sau khi bạn chạy lại.}}</translation>
<translation id="1345251407431278948">Đã ghim! Bạn có thể nhấn vào nút mới trên thanh công cụ để truy cập lại vào tính năng Tìm kiếm hình ảnh</translation>
<translation id="1383876407941801731">Tìm kiếm</translation>
<translation id="7825299065989465359">Dùng ứng dụng Optimium để tiếp tục duyệt web mọi lúc, mọi nơi</translation>
<translation id="141901961143729572">Chia sẻ suy nghĩ của bạn</translation>
<translation id="1438812738230833934">Bạn có thể mở lại Google Tìm kiếm trong bảng điều khiển bên để đặt câu hỏi trong khi duyệt web</translation>
<translation id="4131307166987455854">Để chia sẻ cửa sổ, hãy cho phép Optimium ghi màn hình trong phần Cài đặt hệ thống.</translation>
<translation id="1470136641087909499">Bạn có thể mở lại Google Tìm kiếm trong Chrome để đặt câu hỏi trong khi duyệt web</translation>
<translation id="1478370723027452770">Nhận trợ giúp về Chrome for Testing</translation>
<translation id="9200022682397754538">Để sử dụng thông tin đã lưu và nhiều dữ liệu khác trên <ph name="DEVICE" />, hãy đăng nhập vào Optimium</translation>
<translation id="1497802159252041924">Lỗi cài đặt: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Trang này được bảo vệ</translation>
<translation id="892690000529877604">Chia sẻ một thẻ Optimium</translation>
<translation id="15408169957028265">Mở lại Google Tìm kiếm trong Chrome</translation>
<translation id="9039191226880557963">Đăng nhập vào Optimium</translation>
<translation id="1547469039832541117">Kết thúc tác vụ được làm nổi bật.</translation>
<translation id="4414991100979797293">Ghim Optimium</translation>
<translation id="1574377791422810894">Công cụ đảm bảo an toàn của Chromium</translation>
<translation id="3934587628489930735">Optimium muốn xoá dữ liệu của bạn trong Trình quản lý mật khẩu. Nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="6745390171113033635">{COUNT,plural, =0{Quản trị viên của bạn yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật}=1{Quản trị viên của bạn yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật. Cửa sổ ẩn danh của bạn sẽ không mở lại.}other{Quản trị viên của bạn yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật. # cửa sổ ẩn danh của bạn sẽ không mở lại.}}</translation>
<translation id="7186551909256266009">Tận hưởng những tính năng tuyệt vời nhất của Google nhờ ứng dụng Optimium trên điện thoại</translation>
<translation id="1625909126243026060">Xem các chế độ kiểm soát quan trọng đối với quyền riêng tư và tính bảo mật trong Chromium</translation>
<translation id="1640672724030957280">Đang tải xuống...</translation>
<translation id="1648201623125974721">Biểu tượng mới, lối tắt không đổi: Nhấp vào biểu tượng này để đặt câu hỏi trong khi duyệt web bằng tính năng Thao tác theo ngữ cảnh.</translation>
<translation id="1665602916345474427">Đã đăng nhập bằng tài khoản <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, gói thành viên. Mở trình đơn tài khoản</translation>
<translation id="1708414395296835197">Bạn có thể sử dụng Chromium mỗi khi bạn nhấp vào đường liên kết trong thư/tin nhắn, tài liệu và các ứng dụng khác. Chromium cũng sẽ được ghim vào thanh tác vụ.</translation>
<translation id="1709772298389099340">Cung cấp đặc quyền cấp cao cho <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Thao tác này sẽ cho phép bạn chọn trong số các thiết bị có sẵn và hiển thị nội dung trên các thiết bị đó.</translation>
<translation id="6717880500969720524">Optimium sắp xoá dữ liệu duyệt web</translation>
<translation id="1736443181683099871">Chromium sẽ cố gắng nâng các hình thức chuyển hướng lên giao thức HTTPS</translation>
<translation id="4418738262462299802">Đã xóa dữ liệu Optimium</translation>
<translation id="8469746761106187775">Optimium sẽ khởi động lại sau <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Khi không có giao thức HTTPS, Chromium sẽ sử dụng kết nối không an toàn mà không cảnh báo bạn</translation>
<translation id="1769661297620183092">Bạn có thể mở lại bảng điều khiển Google Tìm kiếm để đặt câu hỏi trong khi duyệt web</translation>
<translation id="6555789357989792722">Cho phép Optimium chạy dưới nền</translation>
<translation id="627441522449241646">Để làm cho Optimium an toàn hơn, chúng tôi đã vô hiệu hóa một số tiện ích không được liệt kê trong <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> và có thể đã được thêm mà bạn không biết.</translation>
<translation id="1912380661217770781">Nhấp vào <ph name="BEGIN_BOLD" />Có<ph name="END_BOLD" /> trong thông báo của Windows để ghim Optimium vào thanh tác vụ giúp truy cập nhanh.</translation>
<translation id="9034578483087384251">Cài đặt lại Optimium</translation>
<translation id="2856362667064664106">Optimium đang cố gắng <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="1665590461646883113"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Optimium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể sử dụng các tiện ích và nhiều nội dung khác trên <ph name="DEVICE" />.</translation>
<translation id="1668665535355826445">Lần tới, khi mở Optimium trên <ph name="DEVICE_TYPE" />, bạn sẽ thấy lời nhắc sử dụng Trình quản lý mật khẩu của Google.</translation>
<translation id="1838374766361614909">Xóa tìm kiếm</translation>
<translation id="8674417702521959187">Để xoá dữ liệu duyệt web chỉ trên thiết bị này mà không xoá trong Tài khoản Google, hãy <ph name="BEGIN_LINK" />đăng xuất khỏi Optimium<ph name="END_LINK" />.</translation>
<translation id="6186721318460238018">Tải Optimium xuống điện thoại để mở hoặc tạo nhóm thẻ mới trong khi di chuyển.</translation>
<translation id="185970820835152459">Bạn có thể quản lý các Tài khoản Google đã đăng nhập của mình. Tài khoản Google của bạn được sử dụng cho trình duyệt Chromium, Cửa hàng Play, Gmail, v.v. Nếu bạn muốn thêm tài khoản cho người khác, chẳng hạn như thành viên gia đình, hãy thêm người dùng mới trên chiếc <ph name="DEVICE_TYPE" /> của bạn. <ph name="LINK_BEGIN" />Tìm hiểu thêm<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Tìm kiếm bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="1781731701613313704"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Optimium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể sử dụng dấu trang và nhiều dữ liệu khác trên <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Chọn văn bản</translation>
<translation id="5960850334733792580">Bạn đang đăng nhập bằng tài khoản được quản lý và cấp cho quản trị viên của tài khoản quyền kiểm soát cấu hình Optimium của bạn. Dữ liệu Optimium của bạn, chẳng hạn như ứng dụng, dấu trang, lịch sử, mật khẩu và các cài đặt khác sẽ vĩnh viễn được liên kết với <ph name="USER_NAME" />. Bạn có thể xóa dữ liệu này thông qua Trang tổng quan của tài khoản Google nhưng không thể liên kết dữ liệu này với tài khoản khác. Bạn có thể tùy chọn tạo cấu hình mới để giữ cho dữ liệu Optimium hiện có của bạn riêng biệt. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium sẽ tiết kiệm pin bằng cách hạn chế hoạt động trong nền và hiệu ứng hình ảnh, chẳng hạn như hiệu ứng cuộn mượt mà và tốc độ khung hình của video. <ph name="BEGIN_LINK" />Tìm hiểu thêm về Trình tiết kiệm pin<ph name="END_LINK" /></translation>
<translation id="7900167719031567542">Dịch vụ Trình cập nhật Optimium</translation>
<translation id="1911763535808217981">Bằng việc tắt tính năng này, bạn có thể đăng nhập vào các trang web của Google, chẳng hạn như Gmail mà không cần đăng nhập vào Chromium</translation>
<translation id="5015349619125768393">Optimium không phản hồi. Chạy lại ngay bây giờ?</translation>
<translation id="2019000760486664637">Tổ chức <ph name="MANAGER" /> của bạn yêu cầu bạn đăng nhập vào Optimium</translation>
<translation id="193439633299369377">ChromiumOS cần được khởi động lại để áp dụng bản cập nhật.</translation>
<translation id="3382368450324191331">Optimium đã chặn tệp tải xuống này vì loại tệp này ít được tải xuống và có thể nguy hiểm</translation>
<translation id="1953553007165777902">Đang tải xuống... Còn <ph name="MINUTE" /> phút</translation>
<translation id="1966382378801805537">Chromium không thể xác định hoặc đặt trình duyệt mặc định</translation>
<translation id="197326043290947695">Duyệt web thông minh hơn với tính năng Tìm kiếm hình ảnh</translation>
<translation id="5321661580966500942">Tìm hiểu lý do Optimium chặn một số tệp, mở trong thẻ mới</translation>
<translation id="8960045458031480819">Dịch vụ này giúp cập nhật phần mềm Optimium của bạn. Nếu dịch vụ này bị vô hiệu hoá hoặc bị dừng, phần mềm Optimium của bạn sẽ không được cập nhật. Điều này có nghĩa là lỗ hổng bảo mật phát sinh sẽ không thể khắc phục được và các tính năng có thể không hoạt động. Dịch vụ này sẽ tự gỡ cài đặt khi không được phần mềm Optimium nào dùng.</translation>
<translation id="2008474315282236005">Thao tác này sẽ xóa 1 mục khỏi thiết bị này. Để truy xuất dữ liệu của bạn sau, hãy đăng nhập vào Chromium dưới dạng <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Không cài đặt được. Vui lòng thử lại.</translation>
<translation id="2039417478970545937">Cài đặt.</translation>
<translation id="2049376729098081731">Chọn xem có bao gồm nhật ký duyệt web trên Chromium hay không để mang lại trải nghiệm phù hợp hơn trong các dịch vụ của Google</translation>
<translation id="4120951192672345208">Tích hợp sẵn trong Optimium để giúp bạn tạo, lưu và tự động điền mật khẩu mạnh. Thêm lối tắt để dễ dàng truy cập.</translation>
<translation id="2060311596979880693">Thành công! Giờ đây, bạn có thể dễ dàng đặt câu hỏi trong khi duyệt web bằng Google Tìm kiếm trong Chrome</translation>
<translation id="7165258062917217746">Nhấp vào nút Tuỳ chỉnh Optimium trên trang Thẻ mới để mang lại giao diện mới cho Optimium</translation>
<translation id="3702823791268559760">Optimium đã chặn tệp tải xuống này vì tệp này chứa nội dung lừa đảo và có thể thực hiện các thay đổi không mong muốn đối với thiết bị của bạn</translation>
<translation id="2370804817835146114">Lần tới, khi mở Optimium iOS, bạn sẽ thấy lời nhắc dùng thử <ph name="FEATURE_NAME" />.</translation>
<translation id="5887094242311035059">Mật khẩu và các dữ liệu khác trên Optimium mà bạn đã lưu trong Tài khoản Google của mình sẽ bị xoá khỏi thiết bị này. Để tiếp tục sử dụng các dữ liệu đó trong Optimium, hãy đăng nhập lại.</translation>
<translation id="8794268168383660193">{COUNT,plural, =1{Tổ chức của bạn sẽ tự động xoá dữ liệu duyệt web sau 1 phút bạn không dùng đến Optimium. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống. Các thẻ sẽ vẫn mở.}other{Tổ chức của bạn sẽ tự động xoá dữ liệu duyệt web sau # phút bạn không dùng đến Optimium. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống. Các thẻ sẽ vẫn mở.}}</translation>
<translation id="2125838419757773031">Chọn vùng trên màn hình để tìm kiếm</translation>
<translation id="2126108037660393668">Không xác minh được tệp tải xuống.</translation>
<translation id="2135919691573380097">Báo cáo trang web này</translation>
<translation id="2137162749895930932">Đóng màn hình dịch</translation>
<translation id="2147218225094845757">Ẩn bảng điều khiển bên</translation>
<translation id="8888656790178891761">Optimium đã chặn tệp tải xuống này vì trang web không sử dụng kết nối an toàn và tệp có thể đã bị can thiệp</translation>
<translation id="2170098639895543546">Chọn nội dung bất kỳ trên trang</translation>
<translation id="6975401993318112971">Tùy chỉnh Optimium</translation>
<translation id="2174917724755363426">Chưa cài đặt xong. Bạn có chắc chắn muốn huỷ không?</translation>
<translation id="7741769305753410467">Optimium – Đăng nhập vào mạng – <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Lỗi khi kiểm tra bản cập nhật: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2133097742403140075">Xoá tài khoản khỏi Optimium</translation>
<translation id="6495056863394621013">Dùng ứng dụng Optimium để mang theo các công cụ mua sắm tốt nhất mọi lúc, mọi nơi</translation>
<translation id="2209877494277346829">Cô lập Chromium khỏi các ứng dụng khác</translation>
<translation id="2035198300681156782">An toàn hơn khi di chuyển nhờ tính năng Duyệt web an toàn có tăng cường bảo vệ trên Optimium cho iOS</translation>
<translation id="2210682093923538346">Đây là trang web nguy hiểm. Chromium đã xoá quyền thông báo.</translation>
<translation id="2236949375853147973">Hoạt động của tôi</translation>
<translation id="871771486544954531">Để sử dụng địa chỉ và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Optimium. Địa chỉ này sẽ được lưu trong Tài khoản Google của bạn sau khi bạn đăng nhập.</translation>
<translation id="524316078518338158">Nếu bạn chia sẻ máy tính, bạn bè và gia đình có thể duyệt web một cách riêng biệt và thiết lập Optimium theo ý của họ.</translation>
<translation id="22571759390241347">Kỹ năng trong Chromium</translation>
<translation id="2283228908180457226">Biểu tượng mới, lối tắt không đổi: Nhấp vào biểu tượng này để đặt câu hỏi trong khi duyệt web bằng bảng điều khiển bên của Google Tìm kiếm.</translation>
<translation id="2283803047247799269">Tìm kiếm thẻ này bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="5808794606375505413">{NUM_TABS,plural, =1{Optimium đề xuất tạm dừng thẻ làm chậm trình duyệt của bạn}other{Optimium đề xuất tạm dừng các thẻ làm chậm trình duyệt của bạn}}</translation>
<translation id="2307973900865360088">Ghim vào thanh Dock</translation>
<translation id="2313870531055795960">Kiểm tra đối chiếu các URL với danh sách trang web không an toàn được lưu trữ trong Chromium. Nếu một trang web cố ăn cắp mật khẩu của bạn hoặc nếu bạn tải một tệp gây hại xuống, thì Chrome cũng có thể gửi các URL đến tính năng Duyệt web an toàn, bao gồm cả các đoạn nội dung trên trang.</translation>
<translation id="2356070529366658676">Yêu cầu</translation>
<translation id="2359808026110333948">Tiếp tục</translation>
<translation id="7000103009822967939">Tiện ích "<ph name="EXTENSION_NAME" />" muốn bạn đăng nhập vào Optimium</translation>
<translation id="184381469736757112">Tắt Optimium đối với các ứng dụng chạy trong nền</translation>
<translation id="5141894774016157674">Để sử dụng tiện ích này bằng tài khoản <ph name="USER_EMAIL_ADDRESS" />, hãy đăng nhập vào Optimium.</translation>
<translation id="2384373936468275798">ChromiumOS không thể đồng bộ hoá dữ liệu của bạn vì thông tin đăng nhập vào tài khoản của bạn đã lỗi thời.</translation>
<translation id="2523694910556579068">{NUM_DEVICES,plural, =0{Một hoặc nhiều tiện ích Optimium đã truy cập vào 1 thiết bị HID}=1{Một hoặc nhiều tiện ích Optimium đang truy cập vào 1 thiết bị HID}other{Một hoặc nhiều tiện ích Optimium đang truy cập vào # thiết bị HID}}</translation>
<translation id="2899976927368522713">Optimium cần có quyền truy cập máy ảnh và micrô đối với trang web này</translation>
<translation id="2403703063067034158">Lỗi khi khởi động: một phiên bản thiết lập khác đang chạy, vui lòng thử lại sau.</translation>
<translation id="8530786035410512232">Mở đường liên kết trong Optimium từ ứng dụng bất kỳ và giữ cho trình duyệt luôn xuất hiện trên thanh tác vụ</translation>
<translation id="5645058843566501763">Nhấp vào nút Tóm tắt để chia sẻ tài liệu này với Gemini trong Optimium nhằm xem nhanh nội dung tổng quan và đặt các câu hỏi nối tiếp</translation>
<translation id="2440750600860946460">Với <ph name="BEGIN_LINK" />các công cụ của Chromium<ph name="END_LINK" />, bạn có thể duyệt web an toàn và luôn nắm quyền kiểm soát</translation>
<translation id="5384013849288198705"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Optimium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể sử dụng mật khẩu và nhiều dữ liệu khác trên mọi thiết bị của mình.</translation>
<translation id="2451727308784734061">Sử dụng lối tắt để nhanh chóng truy cập vào Trình quản lý mật khẩu. Bạn có thể di chuyển lối tắt đến màn hình chính hoặc trình chạy ứng dụng của máy tính.</translation>
<translation id="4074322039453189342">Optimium sắp đóng</translation>
<translation id="4239399282729309306">Trong Optimium</translation>
<translation id="2485422356828889247">Gỡ cài đặt</translation>
<translation id="2513154137948333830">Yêu cầu khởi động lại: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2521391734665471391">Đóng Chế độ AI của Google Tìm kiếm</translation>
<translation id="2542968102051442371">Chọn văn bản bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="7238239459452345825">Optimium đang cố gắng thay thế các mật khẩu hiện tại. Nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="5059411697679064446">Optimium cần quyền truy cập vào bộ nhớ để tải tệp xuống</translation>
<translation id="5959299320608819381">Trình trợ giúp của Optimium</translation>
<translation id="2575822587468774919">Chọn nội dung bạn muốn tìm bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="8063772441784541423">Để sử dụng mật khẩu và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Optimium</translation>
<translation id="3112793931795471365">Quét mã QR bằng điện thoại để tải Optimium xuống rồi đăng nhập vào Tài khoản Google của bạn.</translation>
<translation id="1584670114556742260">để tìm kiếm bằng Optimium.</translation>
<translation id="2680687985294820735">Tiếp tục sử dụng Optimium</translation>
<translation id="259935314519650377">Không thể lưu trình cài đặt đã tải xuống vào bộ nhớ đệm. Lỗi: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Hệ thống</translation>
<translation id="7753906894780562903">Tổ chức của bạn có thể xem và quản lý dữ liệu duyệt web (chẳng hạn như dấu trang, nhật ký và mật khẩu). Tổ chức không thể xem dữ liệu duyệt web trong các hồ sơ Optimium khác</translation>
<translation id="3912526786507084695">Xác minh danh tính của bạn để sử dụng và lưu dữ liệu Optimium trong tài khoản <ph name="ACCOUNT_EMAIL" /> của bạn</translation>
<translation id="1723346026518998062">{COUNT,plural, =0{Chế độ Bảo vệ nâng cao yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật}=1{Chế độ Bảo vệ nâng cao yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật. Cửa sổ ẩn danh của bạn sẽ không mở lại.}other{Chế độ Bảo vệ nâng cao yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật. # cửa sổ ẩn danh của bạn sẽ không mở lại.}}</translation>
<translation id="1676939910504260523">Khởi động Optimium</translation>
<translation id="4524556064279918264">Đã xảy ra lỗi hệ điều hành khi cài đặt. Hãy tải xuống Optimium lại lần nữa.</translation>
<translation id="1998551382060432430">Nếu các bạn dùng chung một thiết bị, thì bạn bè và gia đình có thể duyệt web một cách riêng biệt cũng như thiết lập Optimium theo ý muốn</translation>
<translation id="5180414833025415316">Dễ dàng truy cập để sử dụng Gemini trong Optimium trên thiết bị của bạn, ngay cả khi Optimium đang ở trạng thái thu nhỏ.</translation>
<translation id="5895170254499246640">Thẻ Optimium</translation>
<translation id="2718390899429598676">Để bảo mật hơn, Chromium sẽ mã hóa dữ liệu của bạn.</translation>
<translation id="6684098000857849465">Để xoá Tài khoản Google của bạn khỏi Optimium, hãy đăng xuất</translation>
<translation id="8035579362848370000">Để sử dụng mật khẩu, dấu trang và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Optimium</translation>
<translation id="2738871930057338499">Không thể kết nối với Internet. HTTP 403 bị cấm. Vui lòng kiểm tra cấu hình proxy.</translation>
<translation id="2753623023919742414">Nhấp để tìm</translation>
<translation id="6013736131971103780">Đặt Optimium làm trình xem PDF mặc định</translation>
<translation id="218391145495840504">Tiện ích này chứa phần mềm độc hại và không an toàn. Hãy xoá khỏi Optimium để tiện ích này không thể xem và thay đổi dữ liệu của bạn (bao gồm cả thông tin cá nhân) trên các trang web bạn truy cập nữa.</translation>
<translation id="2799223571221894425">Chạy lại</translation>
<translation id="8757776333711121842">Optimium của bạn</translation>
<translation id="2816462166102338036">Sử dụng tính năng Tìm kiếm hình ảnh để tìm kiếm video này</translation>
<translation id="5977650568712460613">Khám phá sản phẩm bằng camera, theo dõi thông tin giảm giá và thực hiện nhiều việc khác mọi lúc, mọi nơi nhờ Optimium trên iOS.</translation>
<translation id="2841525013647267359">Dịch từ</translation>
<translation id="2846251086934905009">Lỗi cài đặt: Chưa hoàn tất trình cài đặt. Hoạt động cài đặt đã bị huỷ.</translation>
<translation id="7445294455857704594">Xóa khỏi Optimium...</translation>
<translation id="2850691299438350830">Giúp bạn an toàn trên Chrome và có thể dùng để cải thiện mức độ bảo mật cho bạn trong các ứng dụng khác của Google sau khi đăng nhập</translation>
<translation id="2876152561415416331">Mở lại bảng điều khiển Google Tìm kiếm</translation>
<translation id="2885378588091291677">Trình quản lý tác vụ</translation>
<translation id="8130920144001221645">Giới thiệu về &amp;Optimium</translation>
<translation id="2915996080311180594">Khởi động lại sau</translation>
<translation id="5422843128705358539">Dữ liệu của bạn được mã hoá bằng cụm mật khẩu. Nhập cụm mật khẩu để sử dụng và lưu dữ liệu trên Optimium vào Tài khoản Google của bạn.</translation>
<translation id="2945997411976714835">Lỗi cài đặt: Trình cài đặt không thể bắt đầu quá trình.</translation>
<translation id="7644909281692978299">Đăng nhập vào các trang web nhanh hơn bằng mật khẩu đã lưu cho Optimium trên iOS</translation>
<translation id="6715328262141930431">Tổ chức bạn quản lý Optimium</translation>
<translation id="2977470724722393594">Chromium đã được cập nhật</translation>
<translation id="2977506796191543575">Nếu một trang web cố ăn cắp mật khẩu của bạn hoặc nếu bạn tải một tệp gây hại xuống, thì Chromium cũng có thể gửi các URL đến tính năng Duyệt web an toàn, bao gồm cả các đoạn nội dung trên trang</translation>
<translation id="3373190939774209520">Đăng nhập vào Optimium để an toàn hơn trên mạng nhờ các lựa chọn của cha mẹ bạn</translation>
<translation id="2992577225802060159">Bảo vệ bộ nhớ của Chromium khỏi các ứng dụng khác trên máy tính của bạn.</translation>
<translation id="3003694935412297923">Tất cả tác vụ</translation>
<translation id="2169110625780321257">{count,plural, =1{Optimium cần xác minh danh tính của bạn thì mới có thể lưu một số dữ liệu vào Tài khoản Google và cho phép bạn sử dụng dữ liệu đó trên tất cả các thiết bị. Nếu bạn đăng xuất ngay, dữ liệu này (1 mục) sẽ bị xoá.}other{Optimium cần xác minh danh tính của bạn thì mới có thể lưu một số dữ liệu vào Tài khoản Google và cho phép bạn sử dụng dữ liệu đó trên tất cả các thiết bị. Nếu bạn đăng xuất ngay, dữ liệu này ({count}) sẽ bị xoá.}}</translation>
<translation id="535155819036938485">Mở <ph name="URL" /> trong một thẻ mới trên Optimium.</translation>
<translation id="302551344979399011">Các phát kiến về AI, chẳng hạn như kỹ năng, được lưu vào Tài khoản Google của bạn và được quản lý riêng với tính năng đồng bộ hoá Chromium</translation>
<translation id="69529237724150463">Để sử dụng tiện ích và nhiều dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Optimium</translation>
<translation id="1699367992046240140">Đang thêm vào Optimium...</translation>
<translation id="3034219227076811559">Google Tìm kiếm trong Chrome</translation>
<translation id="3037190258341683404">Bạn có thể ghim Google Tìm kiếm vào Chrome để đặt câu hỏi trong khi duyệt web</translation>
<translation id="3038232873781883849">Đang chờ cài đặt...</translation>
<translation id="3045032126857188731">Ngôn ngữ dịch: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Đóng hộp thoại phản hồi</translation>
<translation id="7641708778616103377"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Optimium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể sử dụng danh sách đọc và nhiều nội dung khác trên <ph name="DEVICE" />.</translation>
<translation id="1759532319192341458">Các hồ sơ khác trên Optimium</translation>
<translation id="2862149341123916634">Tiện ích là các phần bổ sung giúp bạn tuỳ chỉnh Optimium. Từ sắp xếp khoa học đến đơn giản hoá các công việc hằng ngày, tiện ích giúp bạn biến Optimium thành trình duyệt của riêng mình.</translation>
<translation id="9144026989666254609">Giúp cải thiện Optimium bằng cách gửi báo cáo sự cố và <ph name="UMA_LINK" /> tới Google</translation>
<translation id="4449472527250709676">Dùng ứng dụng Optimium để mang theo các tính năng an toàn của Google mọi lúc, mọi nơi</translation>
<translation id="6183456495642882201">{NUM_DEVICES,plural, =0{Một hoặc nhiều tiện ích Optimium đã truy cập vào 1 thiết bị USB}=1{Một hoặc nhiều tiện ích Optimium đang truy cập vào 1 thiết bị USB}other{Một hoặc nhiều tiện ích Optimium đang truy cập vào # thiết bị USB}}</translation>
<translation id="7419486418212185022">Để sử dụng danh sách đọc và nhiều dữ liệu khác trên <ph name="DEVICE" />, hãy đăng nhập vào Optimium</translation>
<translation id="4481023367748355854">Nhật ký duyệt web trên Optimium</translation>
<translation id="6289574887308484514">Trình cài đặt không thể giải nén tệp lưu trữ. Hãy tải xuống Optimium lại lần nữa.</translation>
<translation id="310459126943037700">Chưa thể kết thúc nhiệm vụ.</translation>
<translation id="3104828284009500087">Tìm nội dung bất kỳ trên trang</translation>
<translation id="1866751185142421235">Đồng bộ hoá hoàn toàn mật khẩu, dấu trang và nhật ký trên các thiết bị. Dễ dàng sử dụng các tính năng bạn quen thuộc và yêu thích bằng cách cập nhật trình duyệt mặc định thành Optimium.</translation>
<translation id="7071720283847574213">Optimium đang sử dụng micrô của bạn.</translation>
<translation id="3130333203120345554">Lượt tìm kiếm mới</translation>
<translation id="3137969841538672700">Kéo để tìm</translation>
<translation id="8832375982733310873">Thẻ này đang sử dụng thêm tài nguyên. Để cải thiện hiệu suất, hãy cho phép Optimium dừng hoạt động của thẻ này.</translation>
<translation id="7212905776009358992">Để chia sẻ màn hình, hãy cho phép Optimium ghi màn hình trong phần Cài đặt hệ thống</translation>
<translation id="7220401039380362840">Chạy lại Optimium</translation>
<translation id="3161522574479303604">Tất cả ngôn ngữ</translation>
<translation id="2945128209475147845">Mở đường liên kết trong cửa sổ ẩn danh của Optimium</translation>
<translation id="5550841702580813851">Tùy chỉnh hồ sơ mới của bạn trên Optimium</translation>
<translation id="6179644101029308447">Bạn có thể tiếp tục trò chuyện với Chế độ AI mà không cần chuyển đổi giữa các thẻ. Để bắt đầu, hãy đăng nhập vào Optimium. Bạn cũng có thể sử dụng mật khẩu và nhiều dữ liệu khác trên mọi thiết bị của mình.</translation>
<translation id="5843425624301789054">Để xoá Tài khoản Google của bạn khỏi Optimium, hãy vào trang Cài đặt rồi đăng xuất khỏi Optimium</translation>
<translation id="3234316605225071811">Sau đó, Chromium có thể hỏi xem bạn có muốn sử dụng thông tin đã lưu để tự động điền vào biểu mẫu hay không</translation>
<translation id="3381027830404501211">Optimium không thể đọc và ghi vào thư mục dữ liệu:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="8146675538658659954">Mang theo các công cụ AI của Google mà bạn yêu thích mọi lúc, mọi nơi nhờ Optimium trên iOS.</translation>
<translation id="6800117212942659992">Để sử dụng tiện ích và nhiều dữ liệu khác trên <ph name="DEVICE" />, hãy đăng nhập vào Optimium</translation>
<translation id="1315108685137442441">{COUNT,plural, =1{Đã có bản cập nhật Optimium mới và bản cập nhật này sẽ áp dụng ngay khi bạn chạy lại Optimium. Cửa sổ biệt lập của bạn sẽ không mở lại.}other{Đã có bản cập nhật Optimium mới và bản cập nhật này sẽ áp dụng ngay khi bạn chạy lại Optimium. # cửa sổ biệt lập của bạn sẽ không mở lại.}}</translation>
<translation id="3286538390144397061">Khởi động lại Ngay bây giờ</translation>
<translation id="2161039902967573767">Khóa API của Google bị thiếu. Một số chức năng của Optimium sẽ bị tắt.</translation>
<translation id="3296368748942286671">Tiếp tục chạy các ứng dụng dưới nền khi Chromium bị đóng</translation>
<translation id="3313189106987092621">Chromium sẽ cảnh báo bạn trước khi tải trang web bằng kết nối không an toàn</translation>
<translation id="1282007042347821406">Khi đóng tất cả các cửa sổ Optimium, bạn sẽ bị đăng xuất khỏi hầu hết các trang web, ngoại trừ Tài khoản Google nếu bạn đã đăng nhập vào Optimium. Để cho phép trang web ghi nhớ bạn, hãy <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">góc trên cùng bên phải của khu vực tìm kiếm: <ph name="RIGHT" />% từ bên phải sang, <ph name="TOP" />% từ trên cùng xuống</translation>
<translation id="3366305173356742781">Dữ liệu Chromium trong tài khoản của bạn</translation>
<translation id="3798810966749973116">Sử dụng mật khẩu của bạn với Optimium trên điện thoại</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="3114385794555902051">Chuyển sang hồ sơ hiện có trên Optimium?</translation>
<translation id="3412460710772753638">Trong Trình quản lý mật khẩu trên thiết bị này</translation>
<translation id="1395799713002454043">Để sử dụng dấu trang và nhiều dữ liệu khác trên <ph name="DEVICE" />, hãy đăng nhập vào Optimium</translation>
<translation id="3438772217992559640">Tìm kiếm thẻ này bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="1565712261560212491">Mở rộng phạm vi của tính năng Duyệt web an toàn có tăng cường bảo vệ với Optimium trên điện thoại</translation>
<translation id="7003115800241574875">Đang tuỳ chỉnh Optimium cho phù hợp với bạn...</translation>
<translation id="3474745554856756813">Thao tác này sẽ xóa <ph name="ITEMS_COUNT" /> mục khỏi thiết bị này. Để truy xuất dữ liệu của bạn sau, hãy đăng nhập vào Chromium dưới dạng <ph name="USER_EMAIL" />.</translation>
<translation id="1749327805708308979">Phím tắt <ph name="SHORTCUT" /> có thể giúp chuyển đổi giữa các hồ sơ trên Optimium</translation>
<translation id="7437253251955408447">Hãy đóng tất cả cửa sổ Optimium và thử lại.</translation>
<translation id="4544226979083343619">Để chia sẻ cửa sổ, hãy cho phép Optimium ghi màn hình trong phần Cài đặt hệ thống</translation>
<translation id="7742324910239513884"><ph name="EXISTING_USER" /> đã đăng nhập.  Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Optimium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="8618656037793872415">Mã QR để tải trình duyệt Optimium xuống thiết bị di động</translation>
<translation id="354621070532799440">Lời nhắc: Các tính năng an toàn tốt nhất của Google ngay trên điện thoại của bạn</translation>
<translation id="3043015282185018117">Để chia sẻ màn hình, hãy cho phép Optimium ghi màn hình trong phần Cài đặt hệ thống.</translation>
<translation id="3597003331831379823">Không thể chạy quy trình thiết lập bằng đặc quyền cấp cao. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3261842649996827269">Đăng nhập vào Optimium</translation>
<translation id="1140403329282632523">Dữ liệu duyệt web của người này sẽ bị xóa khỏi thiết bị này. Để khôi phục dữ liệu, hãy đăng nhập vào Optimium bằng <ph name="USER_EMAIL" />.</translation>
<translation id="5228011645297638039">{COUNT,plural, =0{Đã có bản cập nhật Optimium mới và bản cập nhật này sẽ áp dụng ngay khi bạn chạy lại Optimium.}=1{Đã có bản cập nhật Optimium mới và bản cập nhật này sẽ áp dụng ngay khi bạn chạy lại Optimium. Cửa sổ ẩn danh của bạn sẽ không mở lại.}other{Đã có bản cập nhật Optimium mới và bản cập nhật này sẽ áp dụng ngay khi bạn chạy lại Optimium. # cửa sổ ẩn danh của bạn sẽ không mở lại.}}</translation>
<translation id="3667616615096815454">Không thể cài đặt, máy chủ không xác định được ứng dụng.</translation>
<translation id="3675854891107786059">Sử dụng <ph name="BEGIN_LINK" />cụm mật khẩu của riêng bạn<ph name="END_LINK" /> để mã hoá tất cả dữ liệu Chrome trong Tài khoản Google Các địa chỉ và phương thức thanh toán từ Google Pay sẽ không được mã hoá. Nhật ký duyệt web trên Chromium sẽ không đồng bộ hoá.</translation>
<translation id="7861068783030138988">{COUNT,plural, =0{Quản trị viên của bạn yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật này}=1{Quản trị viên của bạn yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật này. Cửa sổ ẩn danh của bạn sẽ không mở lại.}other{Quản trị viên của bạn yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật này. # cửa sổ ẩn danh của bạn sẽ không mở lại.}}</translation>
<translation id="8611928240945733486">Mở đường liên kết trong thẻ mới của Optimium</translation>
<translation id="3728124580182886854">Liên kết Chromium và các dịch vụ khác của Google cho mục đích cá nhân hoá và các mục đích khác</translation>
<translation id="3729187154190517324">Mở rộng phạm vi tìm kiếm bằng cách thêm nhiều thẻ, tệp và công cụ bằng nút "Thêm một thẻ và các nội dung khác".</translation>
<translation id="3032577647176321971">Quản lý hồ sơ trên Optimium</translation>
<translation id="6314444399103340747">Tìm hiểu lý do Optimium chặn một số nội dung tải xuống</translation>
<translation id="379589255253486813">Chromium sẽ thông báo cho bạn nếu có vấn đề cần bạn xem xét</translation>
<translation id="3802055581630249637">Chromium tải trước các trang mà bạn có thể sẽ truy cập để các trang đó tải nhanh hơn khi bạn truy cập</translation>
<translation id="3810973564298564668">Quản lý</translation>
<translation id="4301680230606686279">Để sử dụng mật khẩu bạn đã lưu, hãy quét mã QR, tải Optimium dành cho iOS xuống rồi đăng nhập vào Tài khoản Google của bạn</translation>
<translation id="3846683726093018685">**Tóm tắt:** Hãy mô tả chủ đề và mục đích chính của nội dung trong ảnh chụp màn hình này bằng một câu dưới 30 từ.

          **Đề xuất câu hỏi:** Tạo một danh sách có dấu đầu dòng gồm 3 đến 5 câu hỏi gợi mở mà người dùng có thể đặt ra để hiểu rõ hơn về ảnh chụp màn hình này. Danh sách này phải có ít nhất một câu hỏi cụ thể về một đối tượng trực quan trong ảnh và thiết kế hoặc vị trí của đối tượng đó.</translation>
<translation id="3287167856630539345"><ph name="PAGE_TITLE" /> - Optimium</translation>
<translation id="3117512156333858342">Để sử dụng dấu trang và nhiều dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Optimium</translation>
<translation id="3511883131632987404">{COUNT,plural, =1{Quản trị viên yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật này. Cửa sổ biệt lập của bạn sẽ không mở lại.}other{Quản trị viên yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật này. # cửa sổ biệt lập của bạn sẽ không mở lại.}}</translation>
<translation id="3885770153807205175">Bộ chọn ngôn ngữ</translation>
<translation id="7294070483192043494">Tùy chỉnh và kiểm soát Optimium. Bạn cần lưu ý - nhấp để xem thông tin chi tiết.</translation>
<translation id="7920927747111819647">Nhấp vào tên của bạn để mở Optimium và bắt đầu duyệt web.</translation>
<translation id="3892148308691398805">Sao chép văn bản</translation>
<translation id="4454986649289930182"><ph name="EXISTING_USER" /> đã đăng nhập vào hồ sơ này trên Optimium. Để tách biệt hoạt động duyệt web của bạn, Optimium có thể tạo hồ sơ riêng cho bạn.</translation>
<translation id="7225128703667880746">Tiện ích này vi phạm chính sách của Cửa hàng Chrome trực tuyến và có thể không an toàn. Hãy xoá khỏi Optimium để tiện ích này không thể xem và thay đổi dữ liệu của bạn (bao gồm cả thông tin cá nhân) trên các trang web bạn truy cập nữa.</translation>
<translation id="3941890832296813527">Lỗi cài đặt: Tên tệp của trình cài đặt không hợp lệ hoặc không được hỗ trợ.</translation>
<translation id="6304622602441037994">Optimium đang cố gắng sao chép mật khẩu. Hãy nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="2274695480528598968">Để sử dụng thông tin đã lưu và nhiều dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Optimium</translation>
<translation id="1713567483777335359">Mật khẩu, phương thức thanh toán và địa chỉ mà bạn đã lưu trong Tài khoản Google sẽ bị xoá khỏi thiết bị này. Để tiếp tục sử dụng các dữ liệu đó trong Optimium, hãy đăng nhập lại.</translation>
<translation id="395904275706073188">Không thể đọc các trang được bảo vệ. Hãy thử đọc một trang khác.</translation>
<translation id="3962647064319009959">Tìm hiểu cách Chromium bảo vệ bạn</translation>
<translation id="3967822245660637423">Đã tải xuống xong</translation>
<translation id="3971865010372729242">Khi bạn nhập vào thanh địa chỉ hoặc hộp tìm kiếm, Chromium sẽ gửi nội dung bạn nhập đến công cụ tìm kiếm, AI và công cụ hỗ trợ của tổ chức bạn để đưa ra đề xuất.</translation>
<translation id="3975724895399328945">Giới thiệu về &amp;Google Chrome for Testing</translation>
<translation id="3984557288004650913">Từ nút "Google Tìm kiếm trong Chrome" trên thanh công cụ, bạn có thể mở lại Google Tìm kiếm trong Chrome để đặt câu hỏi trong khi duyệt web</translation>
<translation id="3997429360543082038">Giới thiệu về ChromiumOS</translation>
<translation id="4016217212818346953">Giữ an toàn với Trình quản lý mật khẩu</translation>
<translation id="4019629340646866719">ChromiumOS có thể hoạt động được là nhờ <ph name="BEGIN_LINK_CROS_OSS" />phần mềm nguồn mở<ph name="END_LINK_CROS_OSS" /> bổ sung, tương tự như <ph name="BEGIN_LINK_LINUX_OSS" />môi trường phát triển Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">Dịch màn hình</translation>
<translation id="4023601594785368013">Ngôn ngữ gốc: <ph name="LANGUAGE" /></translation>
<translation id="8098054594752731054">Mở đường liên kết trong Optimium từ ứng dụng bất kỳ. Ngoài ra, Optimium sẽ được ghim vào thanh tác vụ để bạn dễ dàng truy cập.</translation>
<translation id="4036079820698952681">Giúp cải thiện Chromium bằng cách báo cáo <ph name="BEGIN_LINK" />cài đặt hiện tại<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">Cải thiện bảo mật quan trọng và tính năng mới có trong phiên bản mới nhất.</translation>
<translation id="4055805654398742145">Trình quản lý mật khẩu</translation>
<translation id="3150466418323356831">{COUNT,plural, =1{Tổ chức sẽ tự động đóng Optimium sau 1 phút bạn không dùng đến. Dữ liệu duyệt web sẽ bị xoá. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống.}other{Tổ chức sẽ tự động đóng Optimium sau # phút bạn không dùng đến. Dữ liệu duyệt web sẽ bị xoá. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống.}}</translation>
<translation id="4118474109249235144">Chế độ ẩn danh của Chromium</translation>
<translation id="4122186850977583290">Chuyển đến trang Giới thiệu về Chromium</translation>
<translation id="5040058062446726786">Tuỳ chỉnh Optimium để mang lại giao diện mới cho trình duyệt</translation>
<translation id="3417230552019009112">Tuỳ chỉnh Optimium</translation>
<translation id="4148957013307229264">Đang cài đặt...</translation>
<translation id="8036654966821129512">Cập nhật Optimium để đảm bảo an toàn</translation>
<translation id="113287843321846936"><ph name="PAGE_TITLE" /> – Đăng nhập vào mạng – Optimium</translation>
<translation id="101945827160630872"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Optimium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể sử dụng danh sách đọc và nhiều nội dung khác trên mọi thiết bị của mình.</translation>
<translation id="5914158797921975103">Khám phá các ứng dụng, trò chơi, tiện ích và chủ đề tuyệt vời cho Optimium.</translation>
<translation id="7188357620681202939">Để sử dụng tiện ích này và các tiện ích khác trên tất cả máy tính của bạn, hãy đăng nhập vào Optimium</translation>
<translation id="1889725122457669356">Để giúp bạn an toàn hơn trên mạng với các lựa chọn của cha mẹ, hãy chuyển sang hồ sơ Optimium mà bạn đã đăng nhập bằng <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">Đang hủy...</translation>
<translation id="4224210481850767180">Quá trình cài đặt đã bị huỷ.</translation>
<translation id="3467085712950617325">Bạn muốn liên kết dữ liệu Optimium của bạn với tài khoản này?</translation>
<translation id="4251772536351901305">Cảnh báo cho bạn về các trang web nguy hiểm, kể cả trang web mà Google chưa từng biết, bằng cách phân tích nhiều dữ liệu trên các trang web hơn so với chế độ bảo vệ tiêu chuẩn. Bạn có thể chọn bỏ qua cảnh báo của Chromium.</translation>
<translation id="2140865310399147834">Đăng xuất khỏi Optimium</translation>
<translation id="4271805377592243930">Nhận trợ giúp về Chromium</translation>
<translation id="4275788652681621337">Đóng bảng điều khiển bên</translation>
<translation id="4281844954008187215">Điều khoản dịch vụ</translation>
<translation id="3179093133057739293">Không thể cài đặt do lỗi chưa xác định. Nếu Optimium hiện đang chạy, hãy đóng Optimium và thử lại.</translation>
<translation id="5932936993463393384">Xuất mật khẩu từ Optimium</translation>
<translation id="4304713468139749426">Trình quản lý mật khẩu</translation>
<translation id="4334241893986177674">Tìm kiếm thông tin trên ảnh chụp màn hình này</translation>
<translation id="109990079583792895">Khởi chạy Optimium khi Windows khởi động</translation>
<translation id="4400772909124543403">Hiện không có bản cập nhật nào</translation>
<translation id="4669117187454638908">Bạn vẫn muốn thoát khỏi Optimium?</translation>
<translation id="4413205837991854510">Luôn hiện lối tắt Tìm kiếm hình ảnh</translation>
<translation id="1696050014109987987">Cho phép Optimium chạy trong nền</translation>
<translation id="7368827027253482667">{NUM_EXTENSIONS,plural, =1{Optimium khuyên bạn nên loại bỏ tiện ích này. <ph name="BEGIN_LINK" />Tìm hiểu thêm về các tiện ích được hỗ trợ<ph name="END_LINK" />}other{Optimium khuyên bạn nên loại bỏ các tiện ích này. <ph name="BEGIN_LINK" />Tìm hiểu thêm về các tiện ích được hỗ trợ<ph name="END_LINK" />.}}</translation>
<translation id="6842479443769252421">Tùy chỉnh và điều khiển Optimium</translation>
<translation id="4427306783828095590">Chế độ bảo vệ tăng cường giúp chặn phần mềm độc hại và hành vi lừa đảo hiệu quả hơn</translation>
<translation id="4434353761996769206">Lỗi trình cài đặt: <ph name="INSTALLER_ERROR" /></translation>
<translation id="1220175535870261362"><ph name="MANAGER" /> quản lý Optimium</translation>
<translation id="4547231940814681999">Thêm hồ sơ Optimium</translation>
<translation id="4447409407328223819">Giới thiệu về Chrome for Testing</translation>
<translation id="5633209319760692383">Để sử dụng và lưu dữ liệu Optimium trong Tài khoản Google, hãy nhập cụm mật khẩu của bạn</translation>
<translation id="4493028449971051158">Lỗi khi khởi động: vui lòng chạy trình cài đặt với tư cách quản trị viên.</translation>
<translation id="4501471624619070934">Không cài đặt được do quyền truy cập bị giới hạn tại quốc gia này.</translation>
<translation id="4501839397124711198">Bạn có thể ghim Google Tìm kiếm vào bảng điều khiển bên để đặt câu hỏi trong khi duyệt web</translation>
<translation id="2800276662284246735">Tiện ích này chưa công bố các phương thức bảo vệ quyền riêng tư, chẳng hạn như cách tiện ích thu thập và sử dụng dữ liệu. Optimium khuyên bạn nên xoá tiện ích này.</translation>
<translation id="5128821773878845255">Chào mừng bạn đến với Optimium. Cửa sổ trình duyệt mới đã mở ra</translation>
<translation id="2317489323536472198">Optimium cần có quyền tạo bản đồ về các khu vực xung quanh và theo dõi tay bạn</translation>
<translation id="8080035720506683743">Bạn đã đăng nhập bằng <ph name="USER_EMAIL_ADDRESS" /> trong một hồ sơ Optimium khác</translation>
<translation id="4548534452171747496">Chromium tải trước các trang để giúp bạn duyệt web và tìm kiếm nhanh hơn. <ph name="BEGIN_LINK" />Tìm hiểu thêm về tính năng tải trước trang<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Cải thiện mức độ an toàn trên mạng cho mọi người khi bạn báo cáo một trang web mà bạn cho là có hại.</translation>
<translation id="8636960717768483692">Optimium đã chặn tệp tải xuống này do không thể xác minh tệp (vì bạn đã tắt tính năng Duyệt web an toàn)</translation>
<translation id="1056620590372326996">Dùng thử Google Ống kính với Optimium trên điện thoại</translation>
<translation id="4594305310729380060">Vào Trình quản lý mật khẩu trên thiết bị này</translation>
<translation id="1647545052658850323">Ứng dụng Optimium</translation>
<translation id="4598116752460667024">Tìm quy trình bất kỳ trong danh sách.</translation>
<translation id="4613863813562375431">Phiên bản ChromiumOS</translation>
<translation id="4621240073146040695">Gần được cập nhật! Hãy khởi chạy lại Chromium để hoàn tất cập nhật.</translation>
<translation id="2905329563261343101">Tăng tốc độ tải trang web bằng công cụ V8 của Optimium nhưng làm giảm khả năng chống lại các cuộc tấn công của Optimium</translation>
<translation id="3476739270743628464">Mở tính năng Tìm kiếm bằng Optimium</translation>
<translation id="8852417056873245680">Hồ sơ Optimium</translation>
<translation id="7306598352117034690">Cảnh báo: Optimium không thể ngăn các tiện ích ghi lại nhật ký duyệt web của bạn. Để tắt tiện ích này trong chế độ Ẩn danh, hãy bỏ chọn tùy chọn này.</translation>
<translation id="4673151026126227699">Nếu bạn cũng chia sẻ báo cáo sử dụng của Chromium, thì các báo cáo đó sẽ bao gồm cả những URL bạn truy cập</translation>
<translation id="4673710618874938871">Đã đăng nhập bằng tài khoản <ph name="USER_NAME" />, gói thành viên. Mở trình đơn tài khoản</translation>
<translation id="8554460300897634995">Dường như cấu hình này đang được quy trình Optimium khác (<ph name="PROCESS_ID" />) trên máy tính khác (<ph name="HOST_NAME" />) sử dụng. Optimium đã khóa cấu hình này để cấu hình không bị lỗi. Nếu bạn chắc chắn không có quy trình nào khác đang sử dụng cấu hình này, bạn có thể mở khóa cấu hình và chạy lại Optimium.</translation>
<translation id="4680828127924988555">Huỷ cài đặt</translation>
<translation id="3120454893225058851">Một số dữ liệu Optimium của bạn chưa được lưu vào Tài khoản Google. Hãy đợi một vài phút trước khi đăng xuất. Nếu bạn đăng xuất ngay, dữ liệu này sẽ bị xoá.</translation>
<translation id="382482205580353394">Khi đăng nhập, bạn có thể sử dụng mật khẩu và nhiều nội dung khác từ Tài khoản Google của mình trong Optimium. <ph name="SHORTCUT" /> có thể thay đổi chế độ cài đặt cho các dịch vụ của Google mà bạn sử dụng.</translation>
<translation id="3042362992251330365">Ai đó trước đây đã đăng nhập vào Optimium trên máy tính này bằng <ph name="ACCOUNT_EMAIL_LAST" />. Vui lòng tạo người dùng Optimium mới để giữ riêng biệt thông tin của bạn.</translation>
<translation id="4724676981607797757">Không cài đặt được do lỗi giao thức không được hỗ trợ.</translation>
<translation id="1193287511990404405">Bạn vẫn muốn thoát khỏi Optimium?</translation>
<translation id="8952177001318268390">Optimium vừa áp dụng một bản cập nhật bảo mật đặc biệt. Vui lòng khởi động lại ngay bây giờ và chúng tôi sẽ khôi phục các thẻ của bạn.</translation>
<translation id="4771701986670315895">Gần đây bạn không truy cập trang web này. Chromium đã xoá <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> và <ph name="COUNT" /> quyền khác.</translation>
<translation id="2836181158089477791">Nếu Gemini trong Optimium đang mở, thì bảng điều khiển bên sẽ vẫn mở khi bạn tạo thẻ mới</translation>
<translation id="479167709087336770">Dịch vụ này sử dụng cùng một trình kiểm tra chính tả dùng trong Google Tìm kiếm. Thông tin bạn nhập vào trình duyệt sẽ được gửi tới Google. Bạn luôn có thể thay đổi hành động này trong phần cài đặt.</translation>
<translation id="4803313124144656665">Đóng Google Tìm kiếm trong Chrome</translation>
<translation id="1328138522631482119">Dùng Optimium mà không cần tài khoản</translation>
<translation id="4839733921943823254">Ghim lối tắt</translation>
<translation id="3892081057957249936">Quy tắc kết nối để Optimium cho phép lưu lượng truy cập mDNS.</translation>
<translation id="7651599052663598373">Chạy lại để cập nhật &amp;Optimium</translation>
<translation id="4918086044614829423">Chấp nhận</translation>
<translation id="4918844574251943176">Đã sao chép hình ảnh</translation>
<translation id="5410814264258278350">Để sử dụng danh sách đọc và nhiều dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Optimium</translation>
<translation id="6875307114047320453">Optimium đang chạy trong nền.</translation>
<translation id="2394968926407196930">Nhấp để đóng hộp thoại đăng nhập vào Optimium</translation>
<translation id="1768466544858725503">Với các hồ sơ trên Optimium, bạn có thể tách biệt mọi nội dung của mình khi dùng trình duyệt này. Hãy tạo hồ sơ cho bạn bè và gia đình hoặc phân tách nội dung công việc với nội dung giải trí.</translation>
<translation id="7886648924703056279">Khách có thể sử dụng Optimium mà không phải thoát khỏi bất cứ nội dung nào.</translation>
<translation id="5471135073467145273">Tài khoản của bạn trong Optimium</translation>
<translation id="6876331590693993673">Thêm chính bạn vào Optimium</translation>
<translation id="5000497292978544380">Chế độ AI của Google Tìm kiếm</translation>
<translation id="504699503110800016">Mở trình đơn mục bổ sung</translation>
<translation id="4438081792500757652">Truy cập vào tất cả tính năng của Google mà bạn yêu thích nhờ Optimium trên <ph name="DEVICE_TYPE" /></translation>
<translation id="5121592697493894155">Google Tìm kiếm trong bảng điều khiển bên</translation>
<translation id="2242644352859741625">Optimium cần có quyền theo dõi cử chỉ tay của bạn</translation>
<translation id="5141988424377517949">Gần đây bạn không truy cập trang web này. Chromium đã xoá <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" />.</translation>
<translation id="988933134885096200">Đăng nhập vào Optimium</translation>
<translation id="5174969993834422967">Bạn thường chặn các thông báo. Để trang web này có thể gửi thông báo cho bạn, hãy nhấp vào biểu tượng thông báo ở góc bên phải của thanh vị trí.</translation>
<translation id="5174983315706567306">Dung lượng ổ đĩa không đủ.</translation>
<translation id="2338237693885714148">Tài khoản Optimium cần được xác thực lại</translation>
<translation id="8218029216260099398">Tiếp tục ngay tại nơi bạn đã dừng lại với Optimium trên iOS.</translation>
<translation id="4186833996539770035">Đăng xuất khỏi Optimium</translation>
<translation id="5234764350956374838">Đóng</translation>
<translation id="5247617065091903691">Bạn có thể ghim bảng điều khiển bên của Google Tìm kiếm để đặt câu hỏi trong khi duyệt web</translation>
<translation id="3776453825988272921">Mở đường liên kết trong cửa sổ ẩn d&amp;anh của Optimium</translation>
<translation id="3535566975491534106">Tải ứng dụng Optimium để lưu mật khẩu mọi lúc, mọi nơi</translation>
<translation id="5277894862589591112">Để áp dụng các mục thay đổi của bạn, hãy chạy lại Chromium</translation>
<translation id="5286907366254680517">Đã phát hiện</translation>
<translation id="2359384056551683792">Tải ứng dụng Optimium</translation>
<translation id="5294316920224716406">Khi bạn duyệt web ở Chế độ ẩn danh, Chromium sẽ cảnh báo bạn trước khi tải một trang web bằng kết nối không an toàn</translation>
<translation id="8192058236932307019">Tìm kiếm bằng Optimium</translation>
<translation id="2772169547056202535">Optimium Updater Internal Service</translation>
<translation id="5324450571874973775">Sử dụng các kỹ năng này cùng với các tính năng khác của Gemini trong Chromium</translation>
<translation id="5346389065299425353">Mở rộng phạm vi tìm kiếm bằng cách thêm nhiều thẻ, tệp và công cụ</translation>
<translation id="6360850825826447093">Xem tổng quan nhanh về tài liệu này và đặt câu hỏi cho Gemini trong Optimium</translation>
<translation id="5352264705793813212">Chromium có một số ý kiến đề xuất về sự an toàn cần bạn xem xét</translation>
<translation id="4898448032020512094">Các hồ sơ khác trên Optimium</translation>
<translation id="8706179446833404063">ChromiumOS không thể lưu dữ liệu Optimium vào Tài khoản Google của bạn vì thông tin đăng nhập tài khoản đã lỗi thời</translation>
<translation id="3030627244449672752">Bạn đang đăng nhập bằng tài khoản được quản lý và cấp cho quản trị viên của tài khoản quyền kiểm soát cấu hình Optimium của bạn. Dữ liệu Optimium của bạn, chẳng hạn như ứng dụng, dấu trang, lịch sử, mật khẩu và các cài đặt khác sẽ vĩnh viễn được liên kết với <ph name="USER_NAME" />. Bạn có thể xóa dữ liệu này thông qua Trang tổng quan của tài khoản Google nhưng không thể liên kết dữ liệu này với tài khoản khác. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Mã bổ sung: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Để sử dụng chế độ cá nhân hoá, hãy thêm Chromium vào mục Hoạt động trên web và ứng dụng</translation>
<translation id="2465610960000663223">Mở tính năng tìm kiếm bằng Optimium</translation>
<translation id="506107225183374450">Tìm hiểu lý do Optimium chặn một số tệp</translation>
<translation id="5386450000063123300">Đang cập nhật Chromium (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="2975872091911905625"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Optimium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể sử dụng các tiện ích và nhiều nội dung khác trên mọi thiết bị của mình.</translation>
<translation id="538767207339317086">Cho phép đăng nhập vào Chromium</translation>
<translation id="160420445803701171">Xóa khỏi Optimium</translation>
<translation id="7179459260935505033">Làm giảm hiệu suất nhưng giúp Optimium tăng khả năng chống lại các cuộc tấn công</translation>
<translation id="9146479251717041603">Đặt Optimium là trình duyệt mặc định của bạn</translation>
<translation id="6343924787023513328"><ph name="PAGE_TITLE" /> - Optimium phiên bản beta</translation>
<translation id="4322885651709311384">{NUM_TABS,plural, =1{Optimium đề xuất tạm dừng thẻ làm chậm trình duyệt của bạn}other{Optimium đề xuất tạm dừng các thẻ làm chậm trình duyệt của bạn}}</translation>
<translation id="8732742361460659941">Optimium có thể không hoạt động đúng cách do không còn được hỗ trợ trên bản phân phối Linux này</translation>
<translation id="2169134804545654825">Optimium đã chặn tệp tải xuống này vì tệp có thể gây hại cho tài khoản cá nhân và tài khoản mạng xã hội của bạn</translation>
<translation id="5482575505313585759">Đóng bảng điều khiển Google Tìm kiếm</translation>
<translation id="4427110150482038520">Vui lòng đợi khi Optimium cài đặt các bản cập nhật hệ thống mới nhất.</translation>
<translation id="2009107314274994399">Optimium đang cố gắng chỉnh sửa mật khẩu. Hãy nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="7654616829447718524">Làm việc liền mạch với các ứng dụng bạn yêu thích như Google Drive và YouTube mọi lúc, mọi nơi nhờ Optimium.</translation>
<translation id="5524890928877629608">góc trên cùng bên trái của khu vực tìm kiếm: <ph name="LEFT" />% từ bên trái sang, <ph name="TOP" />% từ trên cùng xuống</translation>
<translation id="5527463683072221100">Mở tệp PDF trong Chromium</translation>
<translation id="5536164441519929134">Hỏi<ph name="LINE_BREAK" />về thẻ này</translation>
<translation id="2024205307959964945">Để đảm bảo an toàn, Optimium sẽ tắt tính năng tối ưu hoá JavaScript khi bạn truy cập vào một trang web lần đầu tiên.

Nếu trang này không hoạt động như mong đợi, hãy thử cho phép tính năng tối ưu hoá.</translation>
<translation id="13426881482333028">Hiện Gemini trong Optimium trong thanh trình đơn của máy Mac và bật phím tắt</translation>
<translation id="6574158167225592561"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Optimium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng sẽ nhận được thông tin đã lưu và nhiều dữ liệu khác trên <ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">Lỗi khi khởi động: vui lòng chạy trình cài đặt với tư cách người dùng thông thường, không phải quản trị viên.</translation>
<translation id="4236944092022229829">Sử dụng Optimium theo mặc định và ghim Optimium</translation>
<translation id="4562525634100475413">{COUNT,plural, =1{Quản trị viên yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật. Cửa sổ biệt lập của bạn sẽ không mở lại.}other{Quản trị viên yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật. # cửa sổ biệt lập của bạn sẽ không mở lại.}}</translation>
<translation id="5596627076506792578">Tuỳ chọn khác</translation>
<translation id="5605834417512968703">Chọn nội dung bạn muốn tìm bằng tính năng Tìm kiếm hình ảnh hoặc nhấn phím Escape để thoát khỏi chế độ Tìm kiếm hình ảnh</translation>
<translation id="7026300828382155386">Đã có <ph name="IMPORTANT_UPDATE" />. Bạn có thể chạy lại ngay hoặc thiết lập để Optimium cập nhật vào lần tới khi màn hình vẫn bật và không được sử dụng trong <ph name="IDLE_DURATION" />.</translation>
<translation id="5618818588972826921">Chọn văn bản hoặc hình ảnh bất kỳ mà bạn muốn tìm kiếm bằng tính năng Tìm kiếm hình ảnh hoặc nhấn phím Escape để thoát khỏi chế độ Tìm kiếm hình ảnh</translation>
<translation id="8498149662316870172">{0,plural, =0{Đã có bản cập nhật Optimium}=1{Đã có bản cập nhật Optimium}other{Đã có bản cập nhật Optimium từ # ngày trước}}</translation>
<translation id="5643865575100044307">Luôn xoá dữ liệu trang web khỏi thiết bị của bạn khi bạn đóng Chromium</translation>
<translation id="4811952957940410849">Vui lòng khởi động lại Optimium ngay bây giờ</translation>
<translation id="8019243097022864687">Để nhận các bản cập nhật Optimium sau này, bạn cần có Windows 10 phiên bản 1809 trở lên. Máy tính này đang sử dụng một phiên bản Windows 10 cũ.</translation>
<translation id="568656514202614970">Thành công! Giờ đây, bạn có thể dễ dàng đặt câu hỏi trong khi duyệt web bằng bảng điều khiển bên của Google Tìm kiếm</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">Hiển thị Chromium bằng ngôn ngữ này</translation>
<translation id="569897634095159764">Không thể kết nối với Internet. Máy chủ proxy yêu cầu xác thực.</translation>
<translation id="5768371961535086509">Chromium giải phóng bộ nhớ khỏi các thẻ không hoạt động. Nhờ đó, các thẻ đang hoạt động và ứng dụng khác sẽ được sử dụng nhiều tài nguyên máy tính hơn, còn Chromium thì hoạt động nhanh chóng. Các thẻ không hoạt động sẽ tự động hoạt động trở lại khi bạn quay lại các thẻ đó. <ph name="BEGIN_LINK" />Tìm hiểu thêm về Trình tiết kiệm bộ nhớ<ph name="END_LINK" /></translation>
<translation id="7953122114569280985">Nếu bạn quên cụm mật khẩu hoặc muốn thay đổi chế độ cài đặt này, hãy <ph name="SETTINGS_LINK" /> dữ liệu Optimium trong tài khoản của bạn</translation>
<translation id="174898372403396774">Tuỳ chỉnh và kiểm soát Optimium. Đặt Optimium làm trình duyệt mặc định.</translation>
<translation id="7513745843649038539">Đặt Optimium làm trình duyệt mặc định để mật khẩu, dấu trang và nhật ký của bạn được đồng bộ hoá liền mạch trên mọi thiết bị.</translation>
<translation id="5809516625706423866">Không thể kết nối với Internet. HTTP 401 không được phép. Vui lòng kiểm tra cấu hình proxy.</translation>
<translation id="579643040945073674">Tăng tốc độ tải trang web bằng công cụ V8 của Optimium nhưng làm giảm khả năng chống lại các cuộc tấn công của Optimium. Chế độ cài đặt này đang tắt.</translation>
<translation id="4979951833951359193">Để sử dụng và lưu dữ liệu Optimium trong Tài khoản Google, hãy cập nhật Optimium</translation>
<translation id="5824893331272123205">Không tải được bảng điều khiển này, hãy thử lại</translation>
<translation id="7677335892217820153">Chào mừng bạn đến với Optimium</translation>
<translation id="5871205389137001634">Nhấp để thoát khỏi chế độ Tìm kiếm hình ảnh</translation>
<translation id="3069954563229169503">Optimium nhận thấy rằng các mục này chứa phần mềm độc hại:</translation>
<translation id="5889361821821684993">Chromium thường xuyên kiểm tra để đảm bảo trình duyệt của bạn có các chế độ cài đặt an toàn nhất. Chúng tôi sẽ thông báo cho bạn biết nếu có nội dung nào cần bạn xem xét.</translation>
<translation id="5895138241574237353">Khởi động lại</translation>
<translation id="8498138353382813879">Gemini Enterprise trong Optimium</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – Đăng nhập vào mạng</translation>
<translation id="5924017743176219022">Đang kết nối Internet...</translation>
<translation id="5941711191222866238">Thu nhỏ</translation>
<translation id="7780105764415426863">Để sử dụng dấu trang này và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Optimium</translation>
<translation id="3113857336144207971">Biến Optimium thành trình duyệt của riêng bạn</translation>
<translation id="5960071705175224773">Một ứng dụng lạ đã thay đổi chế độ cài đặt của bạn</translation>
<translation id="2841415208664905665">{COUNT,plural, =1{Tổ chức sẽ tự động đóng Optimium sau 1 phút bạn không dùng đến.}other{Tổ chức sẽ tự động đóng Optimium sau # phút bạn không dùng đến.}}</translation>
<translation id="6753703218327532561">Cập nhật Optimium để bắt đầu đồng bộ hóa</translation>
<translation id="5990360079535151574">Từ nút "Thao tác theo ngữ cảnh" trên thanh công cụ, bạn có thể mở lại Thao tác theo ngữ cảnh để đặt câu hỏi trong khi duyệt web</translation>
<translation id="6003112304606738118">Đang tải xuống... Còn <ph name="HOURS" /> giờ.</translation>
<translation id="6009821354356307391">Đặt câu hỏi nối tiếp</translation>
<translation id="6040143037577758943">Đóng</translation>
<translation id="4546936953038997559">Tận hưởng nhiều lợi ích hơn khi mua sắm trực tuyến bằng ứng dụng Optimium trên <ph name="DEVICE_TYPE" /></translation>
<translation id="6058380562449900225">Để bảo vệ dữ liệu của bạn, hãy cho phép Chromium loại bỏ quyền khỏi các trang web mà gần đây bạn không truy cập. Bạn sẽ vẫn nhận được thông báo.</translation>
<translation id="9167712407654403538">&amp;Mở trong Optimium</translation>
<translation id="6069027071882229820">Sao chép dưới dạng hình ảnh</translation>
<translation id="2336867934702997612"><ph name="EXTENSION_NAME" /> đã được thêm vào Optimium</translation>
<translation id="4963754686639647216">Tùy chỉnh và kiểm soát Optimium. Đã có bản cập nhật.</translation>
<translation id="3238331535068195595">Bật • Optimium không thể xác minh nguồn gốc của tiện ích này</translation>
<translation id="1591882001986563343">Tài khoản của bạn trong Optimium</translation>
<translation id="9174470061972211626">Cho phép tiện ích hiện các yêu cầu truy cập trong thanh công cụ của Optimium</translation>
<translation id="6285996195476638282"><ph name="FILE_NAME" /> nguy hiểm, do đó Optimium đã chặn tệp.</translation>
<translation id="2722851476153659127">Optimium sắp đóng và xoá dữ liệu</translation>
<translation id="6855625092121599072">Bạn có thể chuyển đổi giữa các hồ sơ trên Optimium tại đây</translation>
<translation id="615103374448673771">Nếu bạn cho phép cookie thì Chromium có thể dùng các cookie này khi tải trước</translation>
<translation id="6165508094623778733">Tìm hiểu thêm</translation>
<translation id="440816316079905155">Xoá dữ liệu Optimium trong tài khoản của bạn</translation>
<translation id="8018999409456045233">Tệp này có thể nguy hiểm<ph name="LINE_BREAK" />Optimium có thể giúp bạn kiểm tra nội dung tải xuống này nếu bạn cung cấp mật khẩu. Thông tin về tệp sẽ được gửi tới dịch vụ Duyệt web An toàn của Google nhưng nội dung tệp và mật khẩu vẫn nằm trên thiết bị của bạn.</translation>
<translation id="6182736845697986886">Không cài đặt được do lỗi nội bộ của máy chủ cập nhật.</translation>
<translation id="3469021117852380318">Đảm bảo bạn đã đăng nhập vào Optimium trên <ph name="TARGET_DEVICE_NAME" /> của mình rồi thử gửi lại.</translation>
<translation id="2986761964667678689">Tìm kiếm và đặt câu hỏi ở bất cứ đâu, ngay cả khi Optimium đang ở trạng thái thu nhỏ. Cho phép Optimium chạy ở chế độ nền.</translation>
<translation id="1244028666242035366">Máy tính này đã có phiên bản Optimium mới hơn. Nếu phần mềm không hoạt động, hãy gỡ cài đặt Optimium và thử lại.</translation>
<translation id="6513480350636703580">{0,plural, =0{Optimium sẽ khởi động lại ngay bây giờ}=1{Optimium sẽ khởi động lại sau 1 giây}other{Optimium sẽ khởi động lại sau # giây}}</translation>
<translation id="3859762680410498178">Optimium sẽ cập nhật khi bạn không sử dụng màn hình</translation>
<translation id="18853993527252772">Optimium cần có quyền truy cập vào bộ nhớ để tải tệp xuống</translation>
<translation id="6245734527075554892">Kiểm tra đối chiếu các URL với danh sách trang web không an toàn được lưu trữ trong Chromium</translation>
<translation id="571621467627269416">Đặt Optimium làm trình duyệt mặc định</translation>
<translation id="6248988683584659830">Tìm chế độ cài đặt</translation>
<translation id="4260906300317983841">Tận hưởng các tính năng an toàn tốt nhất của Google mọi lúc, mọi nơi nhờ ứng dụng Optimium trên điện thoại</translation>
<translation id="6919871734111021049">Đăng xuất khỏi Optimium?</translation>
<translation id="8269500201917700071">Các thẻ này đang sử dụng thêm tài nguyên. Để cải thiện hiệu suất, hãy cho phép Optimium dừng hoạt động của các thẻ này.</translation>
<translation id="2906910751900335741">Tùy chỉnh hồ sơ Optimium của bạn</translation>
<translation id="6290827346642914212">Đặt tên cho hồ sơ của bạn trên Chromium</translation>
<translation id="6294638840436017818">Từ nút "Bảng điều khiển bên của Google Tìm kiếm" trên thanh công cụ, bạn có thể mở lại bảng điều khiển bên của Google Tìm kiếm để đặt câu hỏi trong khi duyệt web</translation>
<translation id="6612045300479871672">Một tiện ích muốn bạn đăng nhập vào Optimium</translation>
<translation id="2723016125417495514"><ph name="FILE_NAME" /> có thể nguy hiểm, do đó Optimium đã chặn tệp.</translation>
<translation id="6308106880471005841">Nút "Bảng điều khiển Google Tìm kiếm" trên thanh công cụ vừa có biểu tượng mới. Hãy nhấp vào biểu tượng này để đặt câu hỏi trong khi duyệt web bằng bảng điều khiển Google Tìm kiếm.</translation>
<translation id="6151952148243982653">Optimium đang sử dụng máy ảnh của bạn.</translation>
<translation id="7744220780291650493">Một hoạt động khác trên Optimium đang diễn ra. Vui lòng thử lại sau.</translation>
<translation id="4212271170228408978">Giờ đây, việc sử dụng Optimium bằng tài khoản Google của bạn và trên máy tính dùng chung trở nên dễ dàng hơn.</translation>
<translation id="7560359899505953564">Dễ dàng truy cập các tính năng bạn biết, yêu thích và tin tưởng bằng cách đặt Optimium làm trình duyệt mặc định.</translation>
<translation id="9090225774559341003">Lối tắt tới Optimium</translation>
<translation id="6926580396655648750">Optimium đã chặn tệp tải xuống này vì tệp này ít được tải xuống và có thể nguy hiểm</translation>
<translation id="8406846117825568223">Bạn có chắc chắn muốn gỡ cài đặt Optimium không?</translation>
<translation id="6375219077595103062">Thêm lối tắt vào Trình quản lý mật khẩu</translation>
<translation id="6388799252195623474">giúp tôi tra cứu về nội dung này</translation>
<translation id="9091694200019721003">Để tiếp tục, hãy đăng nhập vào Optimium bằng <ph name="EMAIL" />. Việc này sẽ đảm bảo các chính sách của tổ chức bạn được áp dụng.</translation>
<translation id="3942952894185574182">Biểu trưng Optimium trên màn hình máy tính.</translation>
<translation id="3353682461772532321">Optimium là trình duyệt web chạy các trang web và ứng dụng với tốc độ cực nhanh. Đây là một trình duyệt web nhanh, ổn định và dễ sử dụng. Duyệt web trở nên an toàn hơn với tính năng bảo vệ chống lại phần mềm độc hại và lừa đảo được tích hợp sẵn vào Optimium.</translation>
<translation id="6791461984478543248">Xác minh danh tính của bạn để đảm bảo bạn luôn sử dụng và lưu dữ liệu Optimium trong Tài khoản Google</translation>
<translation id="6174985388495951106">Optimium sẽ hoạt động nhanh hơn và các tính năng sử dụng JavaScript sẽ hoạt động như dự kiến</translation>
<translation id="6436260184216827876">Không dùng được tính năng Tìm kiếm hình ảnh. Hãy thử lại sau.</translation>
<translation id="6442900851116057561">Khởi động lại ChromiumOS</translation>
<translation id="6443470774889161065">Chromium tải trước thêm nhiều trang mà bạn có thể sẽ truy cập để những trang đó tải nhanh hơn khi bạn truy cập</translation>
<translation id="2102210363398612557">Tải Optimium xuống điện thoại để theo dõi giá và nhận thông báo khi có chương trình giảm giá trên bất cứ trang web nào</translation>
<translation id="6598227122144472874">Tắt • Optimium không thể xác minh nguồn gốc của tiện ích này</translation>
<translation id="3895850825918446737">Chào mừng bạn đến với hồ sơ trên Optimium</translation>
<translation id="3239105679122868308">Lần tới, khi mở Optimium trên <ph name="DEVICE_TYPE" />, bạn sẽ thấy lời nhắc sử dụng nhóm thẻ.</translation>
<translation id="5440394152628202500">Xoá tài khoản khỏi Optimium</translation>
<translation id="5673289019038024720">Tiện ích này cũng điều khiển trang nào được hiển thị khi bạn khởi động Optimium.</translation>
<translation id="648319183876919572">Tính năng Duyệt web an toàn có tăng cường bảo vệ hoạt động hiệu quả hơn để bảo vệ bạn khỏi các tệp đã tải xuống và trang web nguy hiểm</translation>
<translation id="3922692586556595624">Gỡ cài đặt Optimium</translation>
<translation id="5977471146123132488">Phím tắt mở ra trong Optimium</translation>
<translation id="1873460655129342919">Tổ chức của bạn sẽ đóng Optimium khi Optimium không được dùng đến trong <ph name="TIMEOUT_DURATION" />. Dữ liệu duyệt web đã bị xoá. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống.</translation>
<translation id="139284349466910875">Mỗi hồ sơ đều có thông tin riêng trên Optimium, chẳng hạn như dấu trang, các trang web đã truy cập, mật khẩu và nhiều thông tin khác</translation>
<translation id="6556755379298048869">Tìm kiếm bằng phím tắt.</translation>
<translation id="6563921047760808519">Tìm hiểu thêm về <ph name="BEGIN_LINK" />cách Chromium bảo mật dữ liệu của bạn<ph name="END_LINK" /></translation>
<translation id="562266251854740285">Các thay đổi đối với chế độ cài đặt này sẽ được áp dụng sau khi Optimium khởi động lại.</translation>
<translation id="965740992595240282">Quản lý các tiện ích bằng cách nhấp vào phần Tiện ích trong trình đơn chính của Optimium.</translation>
<translation id="2549448919385330625">Bạn có thể chuyển để xem mật khẩu trong một hồ sơ Optimium khác</translation>
<translation id="2662027419736610653">Dùng ứng dụng Optimium để mang theo các công cụ AI tốt nhất mọi lúc, mọi nơi</translation>
<translation id="6570579332384693436">Để sửa lỗi chính tả, Chromium sẽ gửi cho Google nội dung bạn nhập vào các trường văn bản</translation>
<translation id="8346408025829878332">Chuyển đến phần cài đặt thông báo của Optimium</translation>
<translation id="6600016381025017075">Tìm nội dung bất kỳ trên trang này</translation>
<translation id="5149981246269331326">Các thay đổi của bạn sẽ có hiệu lực vào lần tới khi bạn chạy lại Optimium.</translation>
<translation id="1163143914216098175">Optimium hiện khởi chạy khi Windows khởi động để bạn có thể bắt đầu duyệt web ngay lập tức. Bạn có thể tắt lựa chọn này trong phần cài đặt.</translation>
<translation id="7839895033810030903">Tiếp tục từ nơi bạn đã dừng lại: Optimium đã khôi phục các thẻ của bạn từ phiên trước đó. Bạn có thể tắt tính năng này trong phần</translation>
<translation id="8919724422686713691">Optimium cần có quyền truy cập camera để tạo bản đồ 3D khu vực xung quanh bạn</translation>
<translation id="6669284030132180248">Nếu cũng lưu dấu trang trong Tài khoản Google, bạn có thể theo dõi giá sản phẩm trong Chromium và nhận thông báo khi sản phẩm giảm giá</translation>
<translation id="6676384891291319759">Truy cập Internet</translation>
<translation id="668175097507315160">ChromiumOS không thể đồng bộ hoá dữ liệu của bạn do lỗi khi đăng nhập.</translation>
<translation id="2337492685922399200">Xoá dữ liệu của ứng dụng này khỏi Optimium</translation>
<translation id="7200198227335381561">Optimium cần có quyền truy cập micrô đối với trang web này</translation>
<translation id="6712881677154121168">Lỗi khi tải xuống: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="358599119501177356">Không thể sử dụng cấu hình của bạn do cấu hình này đến từ một phiên bản Optimium mới hơn.

Một số tính năng có thể không khả dụng. Hãy chỉ định thư mục cấu hình khác hoặc sử dụng phiên bản Optimium mới hơn.</translation>
<translation id="6729124504294600478">Để sử dụng chế độ cá nhân hoá và các tính năng khác, hãy thêm Chromium vào mục Hoạt động trên web và ứng dụng cũng như các dịch vụ của Google được liên kết</translation>
<translation id="196085196242095682">Optimium đã được cài đặt cho tất cả người dùng trên máy tính của bạn.</translation>
<translation id="8573534493546068455">Để sử dụng mật khẩu, dấu trang và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Optimium. Dấu trang này sẽ được lưu trong Tài khoản Google của bạn sau khi bạn đăng nhập.</translation>
<translation id="674891594898436429">Đóng phiên tìm kiếm đang diễn ra trong thẻ này</translation>
<translation id="87486021868820245">Tăng tốc độ tải trang web bằng công cụ V8 của Optimium nhưng làm giảm khả năng chống lại các cuộc tấn công của Optimium. Chế độ cài đặt này đang bật.</translation>
<translation id="474617559993879524">{count,plural, =1{Một số dữ liệu Optimium của bạn chưa được lưu vào Tài khoản Google. Hãy đợi một vài phút trước khi đăng xuất. Nếu bạn đăng xuất ngay, dữ liệu này (1 mục) sẽ bị xoá.}other{Một số dữ liệu Optimium của bạn chưa được lưu vào Tài khoản Google. Hãy đợi một vài phút trước khi đăng xuất. Nếu bạn đăng xuất ngay, dữ liệu này ({count}) sẽ bị xoá.}}</translation>
<translation id="1681402107856523620">Optimium đề xuất quét tệp này vì tệp này có thể nguy hiểm.</translation>
<translation id="6779406956731413166">ChromiumOS có thể hoạt động được là nhờ <ph name="BEGIN_LINK_CROS_OSS" />phần mềm nguồn mở<ph name="END_LINK_CROS_OSS" /> bổ sung.</translation>
<translation id="6804256634866838775">Đóng phiên tìm kiếm đang diễn ra</translation>
<translation id="6831043979455480757">Dịch</translation>
<translation id="2199057756312069531">Optimium cho bạn biết mật khẩu của bạn có bị đánh cắp hay không</translation>
<translation id="684888714667046800">Không kết nối được với Internet. Nếu bạn sử dụng tường lửa, vui lòng đảm bảo <ph name="PRODUCT_EXE_NAME" /> có trong danh sách cho phép.</translation>
<translation id="6664374380152979637">Optimium - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Nhấn phím Tab để tiếp tục</translation>
<translation id="6862030660799253820">Sử dụng tính năng Tìm kiếm hình ảnh để tìm kiếm hình ảnh này</translation>
<translation id="6869568587896659271">Dễ dàng truy cập các trang web bên dưới thanh địa chỉ</translation>
<translation id="4548192511713002443">Optimium nhận thấy rằng "<ph name="EXTENSION_NAME" />" chứa phần mềm độc hại</translation>
<translation id="6877155553248388166">góc dưới cùng bên phải của khu vực tìm kiếm: <ph name="RIGHT" />% từ bên phải sang, <ph name="BOTTOM" />% từ dưới cùng lên</translation>
<translation id="6896758677409633944">Sao chép</translation>
<translation id="6898028264630240901">Bạn có thể ghim tính năng Tác vụ theo bối cảnh để đặt câu hỏi trong khi duyệt web</translation>
<translation id="3594007018780395447">Đặt Optimium làm trình duyệt mặc định và ghim Optimium vào thanh tác vụ</translation>
<translation id="8874878391047306490">&amp;Quản lý hồ sơ trên Optimium</translation>
<translation id="8227361644719983591">Hành động này sẽ:
          <ph name="LINE_BREAKS" />
            • Đặt lại trang khởi động, trang thẻ mới, công cụ tìm kiếm và các thẻ được ghim.
            <ph name="LINE_BREAK" />
            • Tắt tiện ích
            <ph name="LINE_BREAK" />
            • Xoá cookie và dữ liệu trang web tạm thời khác
            <ph name="LINE_BREAK" />
            • Đặt lại phím tắt Optimium
            <ph name="LINE_BREAKS" />
            Dấu trang, nhật ký và mật khẩu đã lưu sẽ không bị ảnh hưởng.</translation>
<translation id="6926772305569367352">Nút "Google Tìm kiếm trong Chrome" trên thanh công cụ vừa có biểu tượng mới. Hãy nhấp vào biểu tượng này để đặt câu hỏi trong khi duyệt web bằng Google Tìm kiếm trong Chrome.</translation>
<translation id="7079691767892495301">Bạn đã đạt đến hạn mức <ph name="BOOKMARK_LIMIT" /> dấu trang của Optimium nên một số dấu trang chưa được lưu vào Tài khoản Google của bạn.

Bạn phải xoá bớt một số dấu trang thì mới có thể lưu dấu trang mới vào tài khoản. Nếu bạn đăng xuất ngay bây giờ, các dấu trang chưa lưu sẽ bị xoá.</translation>
<translation id="8488478146459741524">Mở đường liên kết trong cửa sổ ẩn danh của Optimium</translation>
<translation id="6965382102122355670">OK</translation>
<translation id="6985329841647292029">Điều khoản của ChromiumOS</translation>
<translation id="8559464220428426642">Nhập cụm mật khẩu để sử dụng và lưu dữ liệu Optimium trong tài khoản <ph name="ACCOUNT_EMAIL" /> của bạn</translation>
<translation id="7011190694940573312">Cài đặt không thành công vì phiên bản hệ điều hành này không được hỗ trợ.</translation>
<translation id="7024536598735240744">Lỗi khi giải nén: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7941779569092758272">{COUNT,plural, =1{Chế độ Bảo vệ nâng cao yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật. Cửa sổ biệt lập của bạn sẽ không mở lại.}other{Chế độ Bảo vệ nâng cao yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật. # cửa sổ biệt lập của bạn sẽ không mở lại.}}</translation>
<translation id="5367778139372857256">Biến Optimium thành trình duyệt của riêng bạn</translation>
<translation id="7047386856539490735">Những kết quả này có hữu ích không?</translation>
<translation id="6654931874608808546">Cập nhật Optimium</translation>
<translation id="1078205929937913964">Optimium sẽ cố gắng mô tả cho bạn những hình ảnh không có nội dung mô tả hữu ích. Để tạo nội dung mô tả, các hình ảnh sẽ được gửi đến Google.</translation>
<translation id="8657336023716174215">Khai thác sức mạnh của AI khi bạn dùng ứng dụng Optimium trên <ph name="DEVICE_TYPE" /></translation>
<translation id="8360922610978196377">Mang theo mật khẩu, thẻ và nhiều dữ liệu khác mọi lúc, mọi nơi nhờ ứng dụng Optimium trên điện thoại</translation>
<translation id="7141270731789036260">Tuỳ chỉnh Chrome for Testing</translation>
<translation id="7147227333672430807">Bạn có thể sử dụng Chromium mỗi khi bạn nhấp vào đường liên kết trong thư/tin nhắn, tài liệu và các ứng dụng khác</translation>
<translation id="7635847276859447848">Xoá <ph name="EXTENSION_NAME" /> khỏi Optimium</translation>
<translation id="4634249408802713112">Tổ chức của bạn sẽ xoá dữ liệu Optimium khi dữ liệu này không được dùng đến trong <ph name="TIMEOUT_DURATION" />. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống.</translation>
<translation id="3308314751977712481">Optimium cần có quyền truy cập máy ảnh đối với trang web này</translation>
<translation id="1700107811881467396">Không thể mở Optimium. Hãy thử lại.</translation>
<translation id="615859695332174696">Hỏi bất cứ điều gì và từ bất cứ đâu với Gemini trong Optimium</translation>
<translation id="4082322885657154457">Ghim Optimium vào thanh Dock để truy cập nhanh chóng bất kỳ lúc nào</translation>
<translation id="5886985791575399945">Dùng Optimium mỗi khi bạn nhấp vào đường liên kết trong thư/tin nhắn, tài liệu và các ứng dụng khác</translation>
<translation id="7213435258745128111">Google Tìm kiếm trong Chromium</translation>
<translation id="7216228761061470870">Khi bạn sử dụng tính năng Tìm kiếm hình ảnh trên máy tính thì nội dung, URL và tiêu đề của trang, bao gồm cả tệp PDF, sẽ được gửi đến máy chủ</translation>
<translation id="3899250150715276784">Trình quản lý tác vụ - Optimium</translation>
<translation id="357779301278973973">Hỏi về nội dung bên ngoài Optimium, chẳng hạn như các ứng dụng hoặc tệp khác</translation>
<translation id="2192941957286691074"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Optimium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể truy cập thông tin đã lưu và nhiều dữ liệu khác trên mọi thiết bị của mình.</translation>
<translation id="4695009148423764441">Bắt đầu duyệt web ngay lập tức: Giờ đây, Optimium có thể khởi chạy khi Windows khởi động.</translation>
<translation id="7274695763216404502">Đã ghim! Sử dụng lại tính năng Tìm kiếm hình ảnh trên thanh công cụ</translation>
<translation id="7288567540154601580">Thẻ và tiện ích</translation>
<translation id="7290997427370476749">Từ nút "Bảng điều khiển Google Tìm kiếm" trên thanh công cụ, bạn có thể mở lại bảng điều khiển Google Tìm kiếm để đặt câu hỏi trong khi duyệt web</translation>
<translation id="1079602886106438527">{NUM_EXTENSIONS,plural, =1{Optimium khuyên bạn nên xoá tiện ích đó}other{Optimium khuyên bạn nên xoá các tiện ích đó}}</translation>
<translation id="5279936464959604532">Để chia sẻ âm thanh hệ thống, hãy mở phần Cài đặt hệ thống rồi bật chế độ "Chỉ ghi âm thanh hệ thống" cho Optimium. Sau đó, bạn cần khởi động lại Optimium.</translation>
<translation id="7299899569525778554">Tìm kiếm trên máy tính</translation>
<translation id="731795002583552498">Đang cập nhật Chromium</translation>
<translation id="1032861344046520617">Tệp tùy chọn của bạn bị hỏng hoặc không hợp lệ.

Optimium không thể khôi phục cài đặt của bạn.</translation>
<translation id="7324051657739063017">Bạn có thể mở lại Thao tác theo ngữ cảnh để đặt câu hỏi trong khi duyệt web</translation>
<translation id="265884122223707624">Web, dấu trang và các nội dung khác của bạn trên Optimium đều có ở đây.</translation>
<translation id="7347827960336370838">Chỉ những người có cụm mật khẩu mới đọc được dữ liệu đã mã hoá của bạn. Cụm mật khẩu không được gửi tới Google hay được Google lưu trữ. Nếu quên cụm mật khẩu hoặc muốn thay đổi chế độ cài đặt này, bạn sẽ cần <ph name="BEGIN_LINK" />xoá dữ liệu Chromium khỏi tài khoản của bạn<ph name="END_LINK" />.</translation>
<translation id="3014807377884544255">Quản trị viên hệ thống đã định cấu hình Optimium để mở <ph name="ALTERNATIVE_BROWSER_NAME" /> khi truy cập vào <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">Đã xảy ra lỗi</translation>
<translation id="6261059974673858354">Để nhận các bản cập nhật Optimium sau này, bạn cần có macOS 13 trở lên. Máy tính này đang sử dụng macOS 12.</translation>
<translation id="7374061268215476070">Bạn có thể mở lại bảng điều khiển bên của Google Tìm kiếm để đặt câu hỏi trong khi duyệt web</translation>
<translation id="7376384068949534168">Gần đây bạn không truy cập trang web này. Chromium đã xoá <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />.</translation>
<translation id="73786666777299047">Mở cửa hàng Chrome trực tuyến</translation>
<translation id="3890970823792853036">Hiện Gemini trong Optimium trong khay hệ thống</translation>
<translation id="7401687852903179959">Tìm kiếm video này bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="3864955417896853787">Optimium đang là trình duyệt mặc định của bạn</translation>
<translation id="7774148037106099906">Tiếp tục từ nơi bạn đã dừng lại: Optimium khôi phục các thẻ của bạn mỗi khi bạn khởi động lại. Để tắt tính năng này, hãy chuyển đến</translation>
<translation id="8928491002876394495">Nhập mật khẩu vào Optimium</translation>
<translation id="5203709869300967635">1. Nhấp vào <ph name="BUTTON_LABEL" /> bên dưới
2. Nhấp vào <ph name="BUTTON_2" /> trong phần cài đặt Windows
3. Nhấp vào <ph name="BUTTON_3" /> trong thông báo của Windows để ghim Optimium vào thanh tác vụ giúp truy cập nhanh</translation>
<translation id="1391846143863378733"><ph name="PAGE_TITLE" /> - Optimium dành cho nhà phát triển</translation>
<translation id="7450541714075000668">Đã sao chép văn bản</translation>
<translation id="7458892263350425044">Để cho phép Chromium dùng micrô, hãy cấp quyền sử dụng trong phần <ph name="BEGIN_LINK" />cài đặt hệ thống<ph name="END_LINK" /></translation>
<translation id="6029586608765705546">Để nhận các bản cập nhật Optimium sau này, bạn cần có Windows 10 trở lên. Máy tính này đang sử dụng Windows 7.</translation>
<translation id="7467949745582939695">Chạy lại Chromium?</translation>
<translation id="5752242571869112795">Không thể cài đặt phiên bản Optimium giống với phiên bản hiện đang chạy. Hãy đóng Optimium và thử lại.</translation>
<translation id="7510190804000607802">Lời nhắc: Các tính năng tốt nhất của Google ngay trên điện thoại của bạn</translation>
<translation id="751935028865900641">Các trang web có thể sẽ hoạt động như dự kiến. Khi đóng tất cả các cửa sổ Chromium, bạn sẽ bị đăng xuất khỏi hầu hết các trang web, ngoại trừ Tài khoản Google nếu bạn đã đăng nhập vào Chromium.</translation>
<translation id="63211891312143018">{0,plural, =1{Optimium sẽ khởi động lại sau 1 phút}other{Optimium sẽ khởi động lại sau # phút}}</translation>
<translation id="7565444033145385702">Để bảo vệ dữ liệu của bạn, hãy cho phép Chromium loại bỏ quyền của các trang web mà gần đây bạn không truy cập.</translation>
<translation id="3125039289492641783">Tự động khởi chạy Optimium để bắt đầu duyệt web ngay lập tức.</translation>
<translation id="7583399374488819119">Trình cài đặt <ph name="COMPANY_NAME" /></translation>
<translation id="4408734053922791034">Optimium đang sử dụng máy ảnh và micrô của bạn.</translation>
<translation id="3179764934195866467">Optimium được cải tiến hơn</translation>
<translation id="6404693631411216689">Giờ đây, bạn có thể sử dụng nhiều tính năng hơn trong Optimium</translation>
<translation id="7624307931717240213">Chúng tôi sử dụng thông tin để cải thiện dịch vụ này. Vui lòng xem Chính sách quyền riêng tư và Điều khoản dịch vụ.</translation>
<translation id="7649070708921625228">Trợ giúp</translation>
<translation id="8311510395768039141">Tải ứng dụng Optimium</translation>
<translation id="7658239707568436148">Huỷ</translation>
<translation id="133478151344333089">Optimium không phải là trình duyệt mặc định của bạn</translation>
<translation id="280841280407738358">Đồng bộ hóa và cá nhân hóa Optimium trên các thiết bị của bạn</translation>
<translation id="7699779824407626136">Cập nhật Chromium</translation>
<translation id="4220506181038618136">Bảo mật công việc của bạn trên Optimium</translation>
<translation id="7716950018788545737">Nhiệm vụ đã kết thúc.</translation>
<translation id="77283119132245232">Cung cấp dịch vụ theo dõi hệ thống cho <ph name="BROWSER_NAME" />. Nếu dịch vụ này bị vô hiệu hoá thì dấu vết hiệu suất do trình duyệt tạo ra sẽ không bao gồm các sự kiện trên toàn hệ thống như chuyển đổi ngữ cảnh và sự kiện luồng ở trạng thái sẵn sàng.</translation>
<translation id="7745317241717453663">Thao tác này sẽ xóa dữ liệu duyệt web của bạn khỏi thiết bị này. Để truy xuất dữ liệu của bạn sau, hãy đăng nhập vào Chromium dưới dạng <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">Trình cài đặt không thể tạo thư mục tạm thời. Vui lòng kiểm tra dung lượng ổ đĩa còn trống và quyền cài đặt phần mềm.</translation>
<translation id="4874030584283115178">Đặt lại về Optimium mặc định</translation>
<translation id="4747871007139957101">Để bảo mật công việc của bạn trên Optimium, tổ chức bạn sẽ có thể xem hoặc quản lý một số thông tin khi bạn đăng nhập vào Optimium.</translation>
<translation id="39303350018938562">Đặt Optimium làm trình duyệt mặc định và ghim vào thanh tác vụ</translation>
<translation id="1411498815218277204">Giúp Optimium hoạt động nhanh hơn</translation>
<translation id="6759916683257281869"><ph name="PAGE_TITLE" /> - Optimium Canary</translation>
<translation id="7800043020703832708">Đóng Google Tìm kiếm trong bảng điều khiển bên</translation>
<translation id="7801317262080715012">Biểu tượng mới, lối tắt không đổi: Nhấp vào biểu tượng này để đặt câu hỏi trong khi duyệt web bằng bảng điều khiển Google Tìm kiếm.</translation>
<translation id="7803986347287457849">Đảm bảo những người có quyền truy cập vào dữ liệu lưu lượng truy cập Internet của bạn khó biết được các trang web bạn truy cập hơn. Chromium dùng một kết nối bảo mật để tra cứu địa chỉ IP của mỗi trang web trong DNS (Hệ thống tên miền).</translation>
<translation id="7810005234485217901">Bạn có thể ghim tính năng Tìm kiếm hình ảnh để thuận tiện sử dụng</translation>
<translation id="3974047900913685132">{COUNT,plural, =1{Đã có bản cập nhật Optimium mới và bản cập nhật này sẽ áp dụng ngay khi bạn chạy lại Optimium. Có cửa sổ ẩn danh hoặc cửa sổ biệt lập đang mở. Cửa sổ ẩn danh hoặc cửa sổ biệt lập sẽ không mở lại sau khi bạn chạy lại.}other{Đã có bản cập nhật Optimium mới và bản cập nhật này sẽ áp dụng ngay khi bạn chạy lại Optimium. Có # cửa sổ ẩn danh và cửa sổ biệt lập đang mở trên các hồ sơ. Những cửa sổ này sẽ không mở lại sau khi bạn chạy lại.}}</translation>
<translation id="1327395026710636574">Chọn nội dung bạn muốn chia sẻ với Optimium</translation>
<translation id="7712700268586648421">Thiết bị này đã có một hồ sơ trên Optimium sử dụng tài khoản này</translation>
<translation id="7845233973568007926">Cảm ơn bạn đã cài đặt. Bạn phải khởi động lại máy tính trước khi sử dụng <ph name="BUNDLE_NAME" />.</translation>
<translation id="7639854797882089460">Công cụ tìm kiếm của bạn đã bị thay đổi từ bên ngoài Optimium. Để bảo vệ bạn, Optimium đã đặt lại công cụ này về chế độ mặc định ban đầu. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3551756496947130501">Tuỳ chỉnh Optimium để có giao diện mới</translation>
<translation id="7859018312476869945">Khi bạn nhập vào thanh địa chỉ hoặc hộp tìm kiếm, Chromium sẽ gửi nội dung bạn nhập đến công cụ tìm kiếm mặc định để đề xuất cho bạn cụm từ phù hợp hơn. Tính năng này bị tắt trong chế độ Ẩn danh.</translation>
<translation id="7884611555881634231">Optimium không thể cập nhật lên phiên bản mới nhất nên bạn đang bỏ lỡ các tính năng và bản vá bảo mật mới.</translation>
<translation id="7872446069773932638">Đang tải xuống... Còn <ph name="SECONDS" /> giây</translation>
<translation id="7873537467422636035">Nếu bạn quên cụm mật khẩu hoặc muốn thay đổi chế độ cài đặt này, hãy <ph name="BEGIN_LINK" />xoá dữ liệu Chromium khỏi tài khoản của bạn<ph name="END_LINK" /></translation>
<translation id="3834573390507006929">Nhanh chóng mở Gemini trong Optimium bất cứ khi nào bạn cần</translation>
<translation id="6294556714699385535">Đặt Optimium làm trình duyệt mặc định</translation>
<translation id="7904213866086517086">Mở lại Google Tìm kiếm trong bảng điều khiển bên</translation>
<translation id="7934340546140346950">Chromium tự động nâng cấp các kết nối không an toàn lên HTTPS mỗi khi có thể</translation>
<translation id="5730000852184248909">Bạn đã đăng nhập vào Optimium là <ph name="USER_EMAIL_ADDRESS" />. Vui lòng sử dụng cùng tài khoản để đăng nhập lại.</translation>
<translation id="8566131222358264585"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Optimium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể truy cập dấu trang và nhiều dữ liệu khác trên mọi thiết bị của mình.</translation>
<translation id="7975919845073681630">Đây là cài đặt thứ cấp của Chromium và không thể trở thành trình duyệt mặc định của bạn.</translation>
<translation id="6422450341111525365">Các tiện ích, ứng dụng và giao diện không rõ nguồn gốc có thể làm hại thiết bị của bạn. Optimium đề xuất bạn chỉ nền cài đặt những mục nói trên qua <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /></translation>
<translation id="6757123197146934198">Tận hưởng những tính năng tốt nhất của Google nhờ ứng dụng Optimium trên <ph name="DEVICE_TYPE" /></translation>
<translation id="8004582292198964060">Trình duyệt</translation>
<translation id="8010081455002666927">Tự động phát hiện</translation>
<translation id="1278413817028711539">Sau khi Optimium có quyền truy cập, các trang web sẽ có thể yêu cầu bạn cấp quyền truy cập.</translation>
<translation id="349886907929581949">Ghim Optimium vào thanh tác vụ để truy cập nhanh bất cứ lúc nào</translation>
<translation id="80471789339884597">Cảm ơn bạn đã cài đặt. Bạn phải khởi động lại tất cả trình duyệt trước khi sử dụng <ph name="BUNDLE_NAME" />.</translation>
<translation id="8054112667659782652">Luôn hiện lối tắt Tìm kiếm hình ảnh</translation>
<translation id="8069447462453318634">Chọn "Ghim vào thanh công cụ"</translation>
<translation id="4174818101907153398">Tắt Optimium đối với các ứng dụng chạy trong nền</translation>
<translation id="80790299200510644">Tìm kiếm hình ảnh</translation>
<translation id="8086881907087796310">Cài đặt không thành công vì máy tính của bạn không đáp ứng được các yêu cầu tối thiểu về phần cứng.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> – Google Chrome for Testing</translation>
<translation id="1888025000812363096">Optimium cần có quyền truy cập thông tin vị trí đối với trang web này</translation>
<translation id="7584643292999340766">Lần tới, khi mở Optimium trên <ph name="DEVICE_TYPE" />, bạn sẽ thấy lời nhắc bật thông báo theo dõi giá.</translation>
<translation id="7461287607957342327">Nhận thông báo giảm giá cho những mặt hàng bạn quan tâm nhờ ứng dụng Optimium trên điện thoại</translation>
<translation id="8118331347066725040">Gửi ý kiến phản hồi về tính năng tìm kiếm bằng Ống kính</translation>
<translation id="3539581840889743095">Biến Optimium thành trình duyệt của riêng bạn</translation>
<translation id="8133124826068723441">ChromiumOS không thể đồng bộ hoá dữ liệu của bạn vì miền của bạn không dùng được tính năng Đồng bộ hoá.</translation>
<translation id="813913629614996137">Đang khởi chạy...</translation>
<translation id="4772631357296776122">Mở Gemini trong Optimium bằng một phím tắt.</translation>
<translation id="8164014945047474187">Điều khoản dịch vụ bổ sung của Chromium</translation>
<translation id="4835039973898764392">{COUNT,plural, =1{Quản trị viên yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật. Có cửa sổ ẩn danh hoặc cửa sổ biệt lập đang mở. Cửa sổ ẩn danh hoặc cửa sổ biệt lập sẽ không mở lại sau khi bạn chạy lại.}other{Quản trị viên yêu cầu bạn chạy lại Optimium để áp dụng bản cập nhật. Có # cửa sổ ẩn danh và cửa sổ biệt lập đang mở trên các hồ sơ. Những cửa sổ này sẽ không mở lại sau khi bạn chạy lại.}}</translation>
<translation id="8065654717207240588">Tệp này nguy hiểm, do đó Optimium đã chặn tệp.</translation>
<translation id="8177472873527554730">Không tìm thấy nội dung trong trang</translation>
<translation id="8200109504272824693">Nhập cụm mật khẩu để sử dụng và lưu dữ liệu Chromium trong tài khoản <ph name="USER_EMAIL" /> của bạn</translation>
<translation id="8203105157044679380">Bảng điều khiển Google Tìm kiếm</translation>
<translation id="820759916613250543">Tìm kiếm hình ảnh này bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="8221491193165283816">Bạn thường chặn các thông báo. Để cho phép trang web này thông báo cho bạn, hãy nhấp vào đây.</translation>
<translation id="8223363452568144035">Để cho phép Chromium dùng camera, hãy cấp quyền sử dụng trong phần <ph name="BEGIN_LINK" />cài đặt hệ thống<ph name="END_LINK" /></translation>
<translation id="1094434558959920914">Optimium không thể xác minh nguồn gốc của tiện ích này. Tiện ích này có thể không an toàn. Hãy xoá khỏi Optimium để tiện ích này không thể xem và thay đổi dữ liệu của bạn (bao gồm cả thông tin cá nhân) trên các trang web mà bạn truy cập nữa.</translation>
<translation id="3957438238123670294">Optimium sẽ cố gắng mô tả cho bạn những hình ảnh không có nội dung mô tả hữu ích. Để tạo nội dung mô tả, các hình ảnh sẽ được gửi đến Google. Bạn có thể tắt dịch vụ này trong phần cài đặt bất kỳ lúc nào.</translation>
<translation id="2706853324286223963">Bạn muốn đăng nhập vào Optimium bằng hồ sơ mới?</translation>
<translation id="1237310177197195175"><ph name="EXISTING_USER" /> đã đăng nhập. Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Optimium bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS" />. Bạn cũng có thể sử dụng mật khẩu và nhiều dữ liệu khác trên <ph name="DEVICE" />.</translation>
<translation id="2801607883759458012">Hiện Gemini trong Optimium trong khay hệ thống và bật phím tắt</translation>
<translation id="8286943863733751221"><ph name="BEGIN_LINK" />Chromium cảnh báo bạn<ph name="END_LINK" /> về các trang web và nội dung tải xuống không an toàn</translation>
<translation id="8295827201165805317">Gần đây bạn không truy cập trang web này. Chromium đã xoá <ph name="PERMISSION" />.</translation>
<translation id="5265623464653503960">Mua sắm, dịch văn bản và nhận dạng những thứ bạn thấy bằng camera trên ứng dụng Optimium dành cho iOS</translation>
<translation id="7565411431973063464">Mã QR để đăng nhập vào Optimium bằng <ph name="USER_NAME" /></translation>
<translation id="8313851650939857356">Lỗi khi khởi động: <ph name="STARTUP_ERROR" />.</translation>
<translation id="5911806827430614904">Tổ chức của bạn sẽ đóng Optimium khi Optimium không được dùng đến trong <ph name="TIMEOUT_DURATION" />.</translation>
<translation id="8321058241987390452">Thành công! Giờ đây, bạn có thể dễ dàng đặt câu hỏi trong khi duyệt web bằng bảng điều khiển Google Tìm kiếm</translation>
<translation id="8321888067342493336">Lưu dưới dạng hình ảnh</translation>
<translation id="1508573889613002459"><ph name="USER_EMAIL_ADDRESS" /> trước đó đã sử dụng Optimium</translation>
<translation id="8351551329754447960">Bật tính năng Kỹ năng trong Chromium</translation>
<translation id="406081439566291910">Cập nhật Optimium để tiếp tục sử dụng dữ liệu Optimium trong Tài khoản Google <ph name="ACCOUNT_EMAIL" /> của bạn</translation>
<translation id="1007124785122331769">Để nhận các bản cập nhật Optimium sau này, bạn cần có Windows 10 trở lên. Máy tính này đang sử dụng Windows 8.</translation>
<translation id="8362914115861174987">Dịch sang</translation>
<translation id="8367705492654390392">Đặt câu hỏi bất kỳ</translation>
<translation id="8370517070665726704">Bản quyền <ph name="YEAR" /> Google LLC. Mọi quyền được bảo lưu.</translation>
<translation id="3692978295966861512">Để sử dụng mật khẩu và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Optimium. Mật khẩu này sẽ được lưu trong Tài khoản Google của bạn sau khi bạn đăng nhập.</translation>
<translation id="7364603585139702314">Sau đó, bạn cần khởi động lại Optimium.</translation>
<translation id="8376752431516546391">Bảng điều khiển bên của Google Tìm kiếm</translation>
<translation id="8236183484860169180">Optimium khuyên bạn nên loại bỏ tiện ích này. <ph name="BEGIN_LINK" />Tìm hiểu thêm về các tiện ích được hỗ trợ<ph name="END_LINK" /></translation>
<translation id="5920842078198979811">Tiện ích này đã bị nhà phát triển huỷ phát hành và có thể không an toàn. Hãy xoá khỏi Optimium để tiện ích này không thể xem và thay đổi dữ liệu của bạn (bao gồm cả thông tin cá nhân) trên các trang web bạn truy cập nữa.</translation>
<translation id="8406687098231754303">Từ nút "Google Tìm kiếm trong bảng điều khiển bên" trên thanh công cụ, bạn có thể mở lại Google Tìm kiếm trong bảng điều khiển bên để đặt câu hỏi trong khi duyệt web</translation>
<translation id="2185697372454035703">Optimium cần xác minh danh tính của bạn thì mới có thể lưu một số dữ liệu vào Tài khoản Google và cho phép bạn sử dụng dữ liệu đó trên tất cả các thiết bị. Nếu bạn đăng xuất bây giờ, dữ liệu này sẽ bị xoá.</translation>
<translation id="4724639108574581385">{0,plural, =1{Khởi động lại Optimium trong vòng một ngày}other{Khởi động lại Optimium trong vòng # ngày}}</translation>
<translation id="8438543370129609977">Khi bạn sử dụng tính năng Tìm kiếm hình ảnh thì nội dung, URL và tiêu đề của trang, bao gồm cả tệp PDF, sẽ được gửi đến máy chủ. <ph name="LEARN_MORE" /></translation>
<translation id="3557945352384776441">Tìm hiểu thêm về cách tìm kiếm bằng tính năng Tìm kiếm hình ảnh trong Optimium</translation>
<translation id="6672310590031980518">Tệp lưu trữ trình cài đặt bị hỏng hoặc không hợp lệ. Hãy tải xuống Optimium lại lần nữa.</translation>
<translation id="8463672209299734063">Không bắt buộc: Giúp cải thiện hiệu suất và các tính năng của ChromiumOS bằng cách tự động gửi dữ liệu sử dụng và chẩn đoán cho Google.</translation>
<translation id="3954441584666499211">Để sử dụng và lưu dữ liệu Optimium trong Tài khoản Google, hãy xác minh danh tính của bạn</translation>
<translation id="8482493977473846331">Hiện lời nhắc đăng nhập vào Chromium</translation>
<translation id="8202428378580208719">Optimium đã lỗi thời</translation>
<translation id="850264194101621529">Cảm ơn bạn đã chọn Chromium làm trình duyệt mặc định!</translation>
<translation id="8520489851087523435">Mở lại bảng điều khiển bên của Google Tìm kiếm</translation>
<translation id="8522801943730206384">Chromium có thể kiểm tra mật khẩu của bạn khi bạn lưu các mật khẩu đó</translation>
<translation id="8525579356836940628">Đã dừng cài đặt</translation>
<translation id="8984919429007493543">Mang theo mật khẩu, thẻ và nhiều dữ liệu khác mọi lúc, mọi nơi nhờ ứng dụng Optimium trên <ph name="DEVICE_TYPE" /></translation>
<translation id="8555465886620020932">Lỗi dịch vụ: <ph name="SERVICE_ERROR" />.</translation>
<translation id="3963774984615461205">Một số tính năng và tiện ích của Optimium đi kèm lối tắt. Bạn có thể chọn bật lại các lối tắt này.</translation>
<translation id="8556420416730706394">Bạn có thể ghim tính năng Tìm kiếm hình ảnh để thuận tiện sử dụng; hãy nhấp vào nút Ghim ở đầu bảng điều khiển bên</translation>
<translation id="8564408666201523086">Thành công! Giờ đây, bạn có thể dễ dàng đặt câu hỏi khi duyệt web bằng Google Tìm kiếm trong bảng điều khiển bên</translation>
<translation id="856656450041460113">Tìm kiếm trong danh sách ngôn ngữ</translation>
<translation id="8568499811906962479">Bạn có thể ghim bảng điều khiển Google Tìm kiếm để đặt câu hỏi trong khi duyệt web</translation>
<translation id="2996904635986800713">Nhiều tổ chức quản lý Optimium</translation>
<translation id="8586442755830160949">Bản quyền <ph name="YEAR" /> Tác giả Chromium. Mọi quyền được bảo lưu.</translation>
<translation id="8590782867495422699">Mở lại Chế độ AI của Google Tìm kiếm</translation>
<translation id="2446482746737130055">Đang khởi động Optimium...</translation>
<translation id="8624541899164515475">Trang Cài đặt, mở trong thẻ mới.</translation>
<translation id="8648201657708811153">Bạn không thể đặt Google Chrome for Testing làm trình duyệt mặc định.</translation>
<translation id="9172606645924379921">Tìm kiếm bằng Optimium ở bất cứ đâu</translation>
<translation id="8689408573494410517">Nút "Google Tìm kiếm trong bảng điều khiển bên" trên thanh công cụ vừa có biểu tượng mới. Hãy nhấp vào biểu tượng này để đặt câu hỏi trong khi duyệt web bằng Google Tìm kiếm trong bảng điều khiển bên.</translation>
<translation id="5596132704047725626">Tiện ích này cũng điều khiển trang nào được hiển thị khi bạn khởi động Optimium hoặc tìm kiếm từ Thanh địa chỉ.</translation>
<translation id="567010981548424498">Để gửi thẻ này tới một thiết bị khác, hãy đăng nhập vào Optimium trên thiết bị đó</translation>
<translation id="4758459198907306138">Đây là Optimium của bạn</translation>
<translation id="8712637175834984815">Tôi hiểu</translation>
<translation id="5293592838971423777">Bạn muốn đăng nhập vào Optimium?</translation>
<translation id="8747073452963259673">góc dưới cùng bên trái của khu vực tìm kiếm: <ph name="LEFT" />% từ bên trái sang, <ph name="BOTTOM" />% từ dưới cùng lên</translation>
<translation id="878572486461146056">Lỗi cài đặt: Quản trị viên mạng của bạn đã áp dụng Chính sách nhóm ngăn chặn hoạt động cài đặt: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">Nhắc tôi sau</translation>
<translation id="8601403845093292651">Chia sẻ tài liệu này với Gemini trong Optimium để xem thông tin tổng quan nhanh và đặt các câu hỏi nối tiếp</translation>
<translation id="3011694712607672183">Bạn muốn đăng nhập vào Optimium?</translation>
<translation id="8823401858233292222">Đặt Chromium làm trình duyệt mặc định và ghim vào thanh tác vụ</translation>
<translation id="8826492472752484139">Nhấp vào "Trình quản lý mật khẩu"</translation>
<translation id="8833697763442816810">Hệ thống ChromiumOS</translation>
<translation id="8852026904190808918">Ngôn ngữ này dùng để hiển thị trình đơn, chế độ cài đặt, cảnh báo và các nội dung khác trong Chromium</translation>
<translation id="8862326446509486874">Bạn không có quyền thích hợp để cài đặt cấp hệ thống. Thử chạy lại trình cài đặt với vai trò Quản trị viên.</translation>
<translation id="8400219074131043686">Thêm Hồ sơ Optimium</translation>
<translation id="3471339840299959661">ChromiumOS không thể lưu dữ liệu Optimium vào Tài khoản Google của bạn do xảy ra lỗi khi đăng nhập</translation>
<translation id="8161120518458367008">Tổ chức của bạn yêu cầu bạn đăng nhập vào Optimium</translation>
<translation id="8897637834206928776">Biểu tượng mới, lối tắt không đổi: Nhấp vào biểu tượng này để đặt câu hỏi trong khi duyệt web bằng Google Tìm kiếm trong bảng điều khiển bên.</translation>
<translation id="3459877940554598369">Optimium yêu cầu Windows 10 phiên bản 1809 trở lên.</translation>
<translation id="4176797355456373725">Optimium đang cố gắng hiển thị mật khẩu. Nhập mật khẩu Windows của bạn để cho phép thực hiện việc này.</translation>
<translation id="8300184335948277828">Optimium không còn là trình duyệt mặc định của bạn. Đặt Optimium làm trình duyệt mặc định?</translation>
<translation id="8365648631713891786">Không thể cập nhật Optimium</translation>
<translation id="8944232836376404813">Hành động này sẽ:
          <ph name="LINE_BREAKS" />
            • Đặt lại trang khởi động, trang thẻ mới, công cụ tìm kiếm và các thẻ được ghim
            <ph name="LINE_BREAK" />
            • Tắt tiện ích
            <ph name="LINE_BREAK" />
            • Xoá cookie và dữ liệu trang web tạm thời khác
            <ph name="LINE_BREAKS" />
            Dấu trang, nhật ký và mật khẩu đã lưu sẽ không bị ảnh hưởng.</translation>
<translation id="4517341657960407384">Hiện lối tắt đến các trang web trên Optimium</translation>
<translation id="6334459924587075942">Biểu tượng Optimium Enterprise</translation>
<translation id="1013608620694172987">Mang theo các tính năng an toàn của Google mọi lúc, mọi nơi nhờ ứng dụng Optimium trên <ph name="DEVICE_TYPE" /></translation>
<translation id="6377692339934065652">Không thể khởi động Optimium vì đã xảy ra lỗi khi mở hồ sơ của bạn. Hãy thử khởi động lại Optimium.</translation>
<translation id="8411734418760705455">để tìm kiếm bằng Optimium hoặc tuỳ chỉnh trong phần <ph name="BEGIN_LINK" />Cài đặt<ph name="END_LINK" /></translation>
<translation id="4403836439014450645">Quản lý hồ sơ trên Optimium</translation>
<translation id="7714694033208252813">Dùng bàn phím để di chuyển giữa Gemini trong Optimium và thẻ đang mở.</translation>
<translation id="9018218886431812662">Đã cài đặt xong</translation>
<translation id="4028461118515168614">Để làm cho Optimium an toàn hơn, chúng tôi đã vô hiệu hóa tiện ích không được liệt kê trong <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> và có thể đã được thêm mà bạn không biết.</translation>
<translation id="8853260188791570953">Đăng nhập vào Optimium</translation>
<translation id="6769418925691762561">Hiện tính năng tìm kiếm bằng Optimium trên thanh trình đơn của máy Mac và bật phím tắt</translation>
<translation id="1582160730719680639">Optimium đã chặn tệp tải xuống này vì tệp lưu trữ gồm các tệp khác có thể ẩn chứa phần mềm độc hại</translation>
<translation id="136372829312763612">Mật khẩu, dấu trang và nhật ký của bạn sẽ được đồng bộ hoá liền mạch trên mọi thiết bị. Hãy cập nhật trình duyệt mặc định thành Optimium để dễ dàng sử dụng các tính năng bạn quen thuộc và yêu thích. Optimium sẽ được ghim vào thanh tác vụ để bạn có thể truy cập nhanh chóng.</translation>
<translation id="4121763951659864948">Sử dụng các công cụ AI tốt nhất của Google nhờ ứng dụng Optimium trên điện thoại</translation>
<translation id="570680773394181802">Để sử dụng mật khẩu và nhiều dữ liệu khác trên <ph name="DEVICE" />, hãy đăng nhập vào Optimium</translation>
<translation id="9062666675513499497">Đăng nhập vào Chromium khi bạn đăng nhập vào các dịch vụ khác của Google</translation>
<translation id="9074041031320636790">Thành công! Giờ đây, bạn có thể dễ dàng đặt câu hỏi khi duyệt web bằng Chế độ AI của Google Tìm kiếm</translation>
<translation id="9074163480955555019">Biểu tượng mới, lối tắt không đổi: Nhấp vào biểu tượng này để đặt câu hỏi trong khi duyệt web bằng Google Tìm kiếm trong Chrome.</translation>
<translation id="516400912738056453">Optimium đã tự động đóng</translation>
<translation id="807899198682302888">Optimium đã lỗi thời</translation>
<translation id="4711199283523757502">{0,plural, =1{Optimium sẽ khởi động lại sau một giờ}other{Optimium sẽ khởi động lại sau # giờ}}</translation>
<translation id="9106236359747881194">Chọn văn bản bạn muốn tìm</translation>
<translation id="8368867604698561866">Để nhận các bản cập nhật Optimium sau này, bạn cần có Windows 10 trở lên. Máy tính này đang sử dụng Windows 8.1.</translation>
<translation id="4437683009835184797">Mở đường liên kết trong thẻ mới của Optimium</translation>
<translation id="911206726377975832">Bạn cũng muốn xóa dữ liệu duyệt web của mình?</translation>
<translation id="9118146721060781133">Nút "Thao tác theo ngữ cảnh" trên thanh công cụ vừa có biểu tượng mới. Hãy nhấp vào biểu tượng này để đặt câu hỏi trong khi duyệt web bằng tính năng Thao tác theo ngữ cảnh.</translation>
<translation id="9134482777260927479">Trợ giúp làm bài tập về nhà</translation>
<translation id="9148058034647219655">Thoát</translation>
<translation id="3295815393935110309">Tiếp tục từ nơi bạn đã dừng lại: Optimium có thể khôi phục các thẻ của bạn mỗi khi bạn khởi động lại. Để bật tính năng này, hãy chuyển đến</translation>
<translation id="5167935114017057528">Quản trị viên hệ thống của bạn đã định cấu hình Optimium để mở một trình duyệt thay thế khi truy cập vào <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="903669083727317908">Chạy lại để cập nhật &amp;Optimium</translation>
<translation id="1256233032126781893">Optimium (mDNS-In)</translation>
<translation id="6225435091563451277">Biến Optimium thành trình duyệt của riêng bạn</translation>
<translation id="1987988401118534091">Optimium có thể không hoạt động chính xác do không được hỗ trợ trên Windows XP hoặc Windows Vista nữa</translation>
<translation id="8102971646278891292">Tận hưởng các tính năng an toàn tốt nhất của Google mọi lúc, mọi nơi nhờ Optimium.</translation>
<translation id="945522503751344254">Gửi phản hồi</translation>
<translation id="225981349930289899">Ai đang sử dụng Optimium?</translation>
<translation id="2788235168912697021">Có được chế độ bảo mật mạnh nhất của Optimium</translation>
<translation id="983803489796659991">Không cài đặt được do máy chủ cập nhật không có dữ liệu băm nào cho ứng dụng.</translation>
<translation id="802168381040095988">Dùng Optimium mà không cần tài khoản</translation>
<translation id="985602178874221306">Tác giả Chromium</translation>
<translation id="989970834842471429">Chọn văn bản hoặc hình ảnh bất kỳ mà bạn muốn tìm kiếm bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="992780518932311116">Để cho phép Chromium dùng thông tin vị trí, hãy cấp quyền sử dụng trong phần <ph name="BEGIN_LINK" />cài đặt hệ thống<ph name="END_LINK" /></translation>
</translationbundle>

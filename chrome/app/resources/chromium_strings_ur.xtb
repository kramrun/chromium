<translation id="6294638840436017818">‏ٹول بار پر موجود "Google تلاش سائیڈ پینل" بٹن کی مدد سے، آپ براؤزنگ کے دوران سوالات پوچھنے کے لیے Google تلاش سائیڈ پینل کو دوبارہ کھول سکتے ہیں</translation>
<translation id="6612045300479871672">‏ایکسٹینشن چاہتی ہے کہ آپ Optimium میں سائن ان کریں</translation>
<translation id="2723016125417495514">‏<ph name="FILE_NAME" /> خطرناک ہو سکتی ہے، اس لیے Optimium نے اسے مسدود کر دیا ہے۔</translation>
<translation id="6308106880471005841">‏ٹول بار پر موجود "Google تلاش پینل" بٹن اب ایک نئے آئیکن کے ساتھ دستیاب ہے۔ ‫Google تلاش پینل کے ساتھ براؤز کرتے وقت سوالات پوچھنے کے لیے اس پر کلک کریں۔</translation>
<translation id="6151952148243982653">‏Optimium آپ کا کیمرا استعمال کر رہا ہے۔</translation>
<translation id="7744220780291650493">‏Optimium پر ایک اور کارروائی کی جا رہی ہے۔ براہ کرم بعد میں دوبارہ کوشش کریں۔</translation>
<translation id="4212271170228408978">‏اب آپ کے Google اکاؤنٹ کے ساتھ اور اشتراک کردہ کمپیوٹرز پر Optimium کا استعمال زيادہ آسان ہے۔</translation>
<translation id="7560359899505953564">‏‫Optimium کو اپنے ڈیفالٹ براؤزر کے طور پر سیٹ کر کے ان خصوصیات تک آسان رسائی حاصل کریں جنہیں آپ جانتے، پسند کرتے اور ان پر بھروسہ کرتے ہیں۔</translation>
<translation id="9090225774559341003">‏‫Optimium شارٹ کٹ</translation>
<translation id="6926580396655648750">‏Optimium نے اس ڈاؤن لوڈ کو مسدود کر دیا کیونکہ فائل عام طور پر ڈاؤن لوڈ نہیں ہوتی ہے اور یہ خطرناک ہو سکتی ہے</translation>
<translation id="8406846117825568223">‏کیا آپ واقعی Optimium کو ان انسٹال کرنا چاہتے ہیں؟</translation>
<translation id="6375219077595103062">پاس ورڈ مینیجر میں شارٹ کٹ شامل کریں</translation>
<translation id="6388799252195623474">اس کے ساتھ میری مدد کریں</translation>
<translation id="9091694200019721003">‏جاری رکھنے کے لئے Optimium میں <ph name="EMAIL" /> سے سائن ان کریں۔ یہ یقینی بناتا ہے کہ آپ کو اپنی تنظیم کی پالیسیاں مل گئی ہیں۔</translation>
<translation id="3942952894185574182">‏کمپیوٹر اسکرین کے اندر Optimium لوگو۔</translation>
<translation id="3353682461772532321">‏Optimium ایک ایسا ویب براؤزر ہے جو ویب صفحات اور ایپلیکیشنز کو روشنی کی رفتار سے چلاتا ہے۔ Optimium میں پہلے سے شامل میلویئر اور فریب دہی تحفظ کے ساتھ ویب کو مزید محفوظ طور پر براؤز کریں۔</translation>
<translation id="6791461984478543248">‏یہ یقینی بنانے کے لیے کہ آپ اپنے Google اکاؤنٹ میں Optimium ڈیٹا ہمیشہ استعمال اور محفوظ کر سکیں، تصدیق کریں کہ یہ آپ ہی ہیں</translation>
<translation id="6174985388495951106">‏‫Optimium تیزی سے چلتا ہے اور JavaScript استعمال کرنے والی خصوصیات کو ڈیزائن کے مطابق کام کرنا چاہیے (تجویز کردہ)</translation>
<translation id="6436260184216827876">تصاویر کا استعمال کر کے تلاش دستیاب نہیں ہے۔ بعد میں دوبارہ کوشش کریں۔</translation>
<translation id="6442900851116057561">‏ChromiumOS کو ری سٹارٹ کریں</translation>
<translation id="6443470774889161065">‏Chromium ایسے اور بھی مزید صفحات کو پیشگی لوڈ کرتا ہے جنہیں آپ ممکنہ طور پر ملاحظہ کر سکتے ہیں، تاکہ وہ آپ کے ملاحظہ کرتے وقت مزید تیزی سے لوڈ ہو سکیں</translation>
<translation id="2102210363398612557">‏قیمتوں کو ٹریک کرنے اور کسی بھی سائٹ پر قیمت کم ہونے پر الرٹس حاصل کرنے کے لیے اپنے فون پر Optimium ڈاؤن لوڈ کریں</translation>
<translation id="6598227122144472874">‏آف • Optimium اس بات کی تصدیق نہیں کر سکتا کہ یہ ایکسٹینشن کہاں سے آتی ہے</translation>
<translation id="3895850825918446737">‏Optimium کی پروفائلز میں خوش آمدید</translation>
<translation id="3239105679122868308">‏اگلی بار جب آپ اپنے <ph name="DEVICE_TYPE" /> پر Optimium کھولیں گے تو آپ کو ٹیب گروپس استعمال کرنے کے لیے ایک پرامپٹ نظر آئے گا۔</translation>
<translation id="5440394152628202500">‏‫Optimium سے اکاؤنٹ ہٹائیں</translation>
<translation id="5673289019038024720">‏یہ اس کو بھی کنٹرول کرتا ہے جب آپ Optimium کو اسٹارٹ کرتے ہیں تو کون سا صفحہ دکھایا جاتا ہے۔</translation>
<translation id="648319183876919572">بہتر کردہ محفوظ براؤزنگ آپ کو خطرناک ویب سائٹس اور ڈاؤن لوڈز سے بچانے کے لیے بہت کچھ کرتی ہے</translation>

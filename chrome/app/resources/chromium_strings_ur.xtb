<translation id="6600016381025017075">اس صفحہ پر کچھ بھی تلاش کریں</translation>
<translation id="5149981246269331326">‏آپ کی تبدیلیاں Optimium کو اگلی بار آپ کے دوبارہ شروع کرنے کے وقت نافذ ہوں گی۔</translation>
<translation id="1163143914216098175">‏‫Windows کے شروع ہونے پر Optimium اب لانچ ہوتا ہے تاکہ آپ فوری طور پر براؤزنگ شروع کر سکیں۔ آپ اسے ترتیبات میں آف کر سکتے ہیں۔</translation>
<translation id="7839895033810030903">‏جہاں آپ نے چھوڑا تھا وہیں سے جاری رکھیں: Optimium نے آپ کے آخری سیشن سے آپ کے ٹیبز کو بحال کیا۔ آپ اسے درج ذیل میں آف کر سکتے ہیں</translation>
<translation id="8919724422686713691">‏Optimium کو آپ کے اطراف کا 3D نقشہ تخلیق کرنے کے لیے کیمرے کی اجازت درکار ہے</translation>
<translation id="6669284030132180248">‏اگر آپ اپنے بُک مارکس کو اپنے Google اکاؤنٹ میں بھی محفوظ کرتے ہیں تو آپ Chromium میں پروڈکٹ کی قیمتوں کو ٹریک کر سکتے ہیں اور قیمت میں گراوٹ ہونے پر اطلاع حاصل کر سکتے ہیں</translation>
<translation id="6676384891291319759">انٹرنیٹ تک رسائی حاصل کریں</translation>
<translation id="668175097507315160">‏ChromiumOS سائن ان میں ایک خرابی کی وجہ سے آپ کے ڈیٹا کی مطابقت پذیری نہیں کر سکا۔</translation>
<translation id="2337492685922399200">‏‫Optimium سے اس ایپس کا ڈیٹا ہٹائیں</translation>

<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ky">
<translation id="1026101648481255140">Орнотууну улантуу</translation>
<translation id="1029669172902658969">&amp;ChromiumOS системасын жаңыртуу үчүн кайра иштетиңиз</translation>
<translation id="4063809399345498325">Optimium бул кеңейтүүнү карап көрүүнү сунуштайт</translation>
<translation id="1042552502243217427">Cайт барактагы шилтемелерди алдын ала жүктөөнү суранса, Chromium Google'дун серверлерин колдонот. Ушуну менен өздүгүңүз тууралуу маалымат алдын ала жүктөлгөн сайттан жашырылат, бирок Google кайсы сайттар алдын ала жүктөлгөнүн билет.</translation>
<translation id="1051793555070215510">Бул 1 мүнөттүк сурамжылоого катышып, Жашыруун режимди жакшыртууга жардам бериңиз.</translation>
<translation id="1065672644894730302">Жеке жөндөлөөрүңүз окулбай жатат.

Айрым мүмкүнчүлүктөр иштебегендиктен, жеке жөндөөлөрдөгү өзгөрүүлөр сакталбайт.</translation>
<translation id="7250992450852052182">Ата-энең Optimium үчүн "Сайттарга, колдонмолорго жана кеңейтүүлөргө уруксаттарды" өчүрүп койгон</translation>
<translation id="6711838932294803312">Жакын жердеги түзмөктөрдү таап жана колдонуу үчүн Optimium жергиликтүү тармакты колдонууга уруксат алышы керек</translation>
<translation id="2807920805712601449">Optimium'дун белгилүү бир функциясын же кеңейтүүсүн издөө үчүн дарек тилкесине анын ыкчам баскычын, андан соң тандалган ыкчам баскычты териңиз</translation>
<translation id="5994612110840535151">Маселелер тактасында Optimium аркылуу издөөнү көрсөтүп, ыкчам баскычты күйгүзүү</translation>
<translation id="7212528213853025915">Optimium сырсөздөрүңүздү экспорттогону жатат. Ага уруксат берүү үчүн Windows аккаунтуңуздун сырсөзүн териңиз.</translation>
<translation id="112640046208448578">Нерселерди же жерлерди аныктап, текстти көчүрүп же которуңуз. Сүрөт издөө функциясын колдонгонуңузда, барактын скриншоту серверге жөнөтүлөт. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium демейки серепчи катары колдонулат</translation>
<translation id="1131805035311359397">Сырсөздөрүңүздүн бекем корголгонун, ошондой эле коопсуздукка байланыштуу көйгөйлөрдү текшерүү үчүн <ph name="BEGIN_LINK" />Chromium'га кириңиз<ph name="END_LINK" />.</translation>
<translation id="3458316367708035110">{COUNT,plural, =1{Жаңыртууну колдонуу үчүн администраторуңуз Optimium'ду өчүрүп күйгүзүңүз дейт. Жашыруун же Окчундатылган терезе ачылып турат. Кайра иштеткенден кийин ал ачылбайт.}other{Жаңыртууну колдонуу үчүн администраторуңуз Optimium'ду өчүрүп күйгүзүңүз дейт. Профилдерде # жашыруун жана окчундатылган терезе ачылып турат. Кайра иштеткенден кийин алар ачылбайт.}}</translation>
<translation id="1150418667633096194">Куралдар тилкесиндеги "Google Издөө каптал панели" баскычынын жаңы сүрөтчөсү бар. Google Издөөнүн капталдагы тилкеси менен сайттарды карап жатып, суроолорду берүү үчүн аны басыңыз.</translation>
<translation id="759898790519515623">Optimium менюсун чыкылдатыңыз</translation>
<translation id="1157952955648710254">Google Издөөнүн капталдагы тилкесин жабыңыз</translation>
<translation id="1157985233335035034">Жакында колдонулган тилдер</translation>
<translation id="1184145431117212167">Орнотулган жок, анткени Windows версияңыз колдоого алынбайт.</translation>
<translation id="1185134272377778587">Chromium жөнүндө</translation>
<translation id="5987505065981917957">Телефонуңуздагы Optimium менен бааларга көз салуу тууралуу билдирмелерди алыңыз</translation>
<translation id="1203500561924088507">Орнотуп алганыңыз үчүн рахмат. <ph name="BUNDLE_NAME" /> топтомун колдонуп баштоодон мурда серепчини өчүрүп күйгүзүңүз.</translation>
<translation id="1232234696885483911">Сүрөт издөө функциясын ачканыңызда беттин аталышы, URL жана андагы нерселер, ошондой эле PDF файлдары автоматтык түрдө серверге жөнөтүлөт. <ph name="LEARN_MORE" /></translation>
<translation id="3560913454241378492">Кирип турганыңызда Optimium'да Google аккаунтуңуздагы сырсөздөрдү жана башкаларды колдоно аласыз. Муну өзгөртүү үчүн "Optimium'дагы аккаунтуңуз" бөлүмүнө өтүңүз.</translation>
<translation id="8922965532693587493">Mac'тын меню тилкесинде Optimium'дагы Gemini'ды көрсөтүү</translation>
<translation id="236433590733312836">Optimium'дагы Gemini'да экрандын бир бөлүгүн тандоо үчүн баскычтардын айкалышын колдонуңуз.</translation>
<translation id="7976124325589452515">Бул өтмөк активдүү эмес болгондо, Optimium'ду тез бойдон кармоо үчүн эстутум бошойт. Бул сайтты жигерсиз абалда болуудан ар дайым чыгара аласыз.</translation>
<translation id="2758503437544511902">Файл кооптуу болгондуктан, Optimium бул жүктөп алууну бөгөттөдү</translation>
<translation id="126567311906253476"><ph name="USER_EMAIL" /> менен Gmail же YouTube сыяктуу Google кызматтарына киргенде, Chromium'га ошол эле аккаунт менен автоматтык түрдө кире аласыз</translation>
<translation id="4104061172701635162">Optimium'ду телефонуңузга жүктөп алыңыз</translation>
<translation id="1290883685122687410">Тууралоо катасы: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="3443894627866827446">Жаңы Optimium профилин жөндөп алыңыз</translation>
<translation id="8946186262159916495">Optimium'да Gemini менен колдонуп көрүңүз</translation>
<translation id="7981347318091963592">Optimium
Bluetooth түзмөктөрүн изилдөө үчүн Bluetooth'ду пайдаланууга уруксат алышы керек. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6099322702899630168">Телефонуңуздагы Optimium'га кириңиз</translation>
<translation id="1330562121671411446">Тил тандоо</translation>
<translation id="3294414641786025647">Optimium'дан да (<ph name="URL" />) дайындарды өчүрүү</translation>
<translation id="4214354213779528068">{COUNT,plural, =1{Күчөтүлгөн коргоо иштеши үчүн Optimium'ду өчүрүп-күйгүзүү керек. Жашыруун же Окчундатылган терезе ачылып турат. Кайра иштеткенден кийин ал ачылбайт.}other{Күчөтүлгөн коргоо иштеши үчүн Optimium'ду өчүрүп-күйгүзүү керек. Профилдерде # жашыруун жана окчундатылган терезе ачылып турат. Кайра иштеткенден кийин алар ачылбайт.}}</translation>
<translation id="1345251407431278948">Кадалды! Эми Сүрөт издөө функциясын куралдар тилкесиндеги жаңы баскыч аркылуу колдоно аласыз</translation>
<translation id="1383876407941801731">Издөө</translation>
<translation id="7825299065989465359">Optimium колдонмосу менен жолдо жүргөндө да Интернетте издей бересиз</translation>
<translation id="141901961143729572">Ойлоруңузду бөлүшүңүз</translation>
<translation id="1438812738230833934">Сайттарды карап жатканда суроолорду берүү үчүн капталдагы тилкеде Google Издөөнү кайра ача аласыз</translation>
<translation id="4131307166987455854">Терезени бөлүшүү үчүн Тутумдун параметрлеринен Optimium'га экрандан видео жаздырып алууга уруксат бериңиз.</translation>
<translation id="1470136641087909499">Сайттарды карап жатканда суроолорду берүү үчүн Chrome'до Google Издөөнү кайра ача аласыз</translation>
<translation id="1478370723027452770">Chrome for Testing боюнча жардам алуу</translation>
<translation id="9200022682397754538">Сакталган маалыматты жана <ph name="DEVICE" /> башка мүмкүнчүлүктөрүн пайдалануу үчүн Optimium'га кириңиз</translation>
<translation id="1497802159252041924">Орнотуу катасы: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Бул барак корголгон</translation>
<translation id="892690000529877604">Optimium өтмөгүн бөлүшүү</translation>
<translation id="15408169957028265">Google Издөөнү Chrome'до кайра ачуу</translation>
<translation id="9039191226880557963">Optimium'га кирүү</translation>
<translation id="1547469039832541117">Бөлүнүп көрсөтүлгөн тапшырманы бүтүрөт.</translation>
<translation id="4414991100979797293">Optimium'ду кадап коюу</translation>
<translation id="1574377791422810894">Chromium'дун коопсуздук куралдары</translation>
<translation id="3934587628489930735">Optimium Сырсөздөрдү башкаргычтагы маалыматтарыңызды өчүргөнү жатат. Ага уруксат берүү үчүн Windows аккаунтуңуздун сырсөзүн териңиз.</translation>
<translation id="6745390171113033635">{COUNT,plural, =0{Администраторуңуз жаңыртууну колдонуу үчүн Optimium'ду кайра иштетүүнү талап кылууда}=1{Администраторуңуз жаңыртууну колдонуу үчүн Optimium'ду кайра иштетүүнү талап кылууда. Жашыруун терезеңиз кайра ачылбайт.}other{Администраторуңуз жаңыртууну колдонуу үчүн Optimium'ду кайра иштетүүнү талап кылууда. # жашыруун терезеңиз кайра ачылбайт.}}</translation>
<translation id="7186551909256266009">Телефонуңуздагы Optimium колдонмосу менен Google'дун бардык мүмкүнчүлүктөрүн пайдаланыңыз</translation>
<translation id="1625909126243026060">Chromium'дагы негизги купуялык жана коопсуздукту көзөмөлдөө каражаттарын карап көрүңүз</translation>
<translation id="1640672724030957280">Жүктөлүп алынууда...</translation>
<translation id="1648201623125974721">Жаңы сүрөтчө, ошол эле ыкчам баскыч: Контексттик тапшырмалар менен серептеп жатканда суроолорду берүү үчүн чыкылдатыңыз.</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" />, <ph name="USER_EMAIL" /> катары кирдиңиз. Катталгансыз. Аккаунттун менюсун ачуу</translation>
<translation id="1708414395296835197">Эми билдирүүлөрдөгү шилтемелерди, документтерди жана башка колдонмолорду Chromium'да ача аласыз. Ал тапшырмалар тактасына да кадалат.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" /> серепчисине жогорулатылган артыкчылыктар берилет.</translation>
<translation id="1722488837206509557">Бул сизге жеткиликтүү түзмөктөрдөн ичинен тандоого жана аларда контентти көрсөтүүгө мүмкүндүк берет.</translation>
<translation id="6717880500969720524">Optimium серептөө дайындарын жакында өчүрөт</translation>
<translation id="1736443181683099871">Chromium чабыттоолорду HTTPS'ке жаңыртканга аракет кылат</translation>
<translation id="4418738262462299802">Optimium дайындары тазаланды</translation>
<translation id="8469746761106187775">Optimium <ph name="REMAINING_TIME" /> кийин кайра ачылат</translation>
<translation id="1749104137266986751">HTTPS жеткиликсиз болгондо, Chromium кооптуу туташууну сизге эскертпестен колдонот</translation>
<translation id="1769661297620183092">Сайттарды карап жатканда суроолорду берүү үчүн Google Издөө панелин кайра ача аласыз</translation>
<translation id="6555789357989792722">Optimium'го фондо иштөө мүмкүнчүлүгүн берүү</translation>
<translation id="627441522449241646">Жеке маалыматыңызды коргоо үчүн, айрым Optimium кеңейтүүлөрүн өчүрүп койдук, себеби <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ичинде аларга байланыштуу маалымат жок. Демек, бул курамдык бөлүктөр тымызын орнотулган.</translation>
<translation id="1912380661217770781">Ыкчам ачуу максатында Optimium'ду тапшырмалар тактасына кадоо үчүн Windows билдирмесиндеги <ph name="BEGIN_BOLD" />Ооба<ph name="END_BOLD" /> дегенди басыңыз.</translation>
<translation id="9034578483087384251">Optimium'ду кайра орнотуу</translation>
<translation id="2856362667064664106">Optimium <ph name="AUTHENTICATION_PURPOSE" /> аракет кылып жатат</translation>
<translation id="1665590461646883113"><ph name="EXISTING_USER" /> мурунтан эле кирип турат. Сиз серептеген нерселерди ажыратуу үчүн <ph name="USER_EMAIL_ADDRESS" /> катары өз профилиңизден Optimium'га кириңиз. Ошондой эле, <ph name="DEVICE" /> аккаунтуңуздагы кеңейтүүлөрдү жана башка нерселерди аласыз.</translation>
<translation id="1668665535355826445">Кийинки жолу <ph name="DEVICE_TYPE" /> түзмөгүңүздө Optimium'ду ачканыңызда Сырсөздөрдү башкаргычты колдонуу сунушталат.</translation>
<translation id="1838374766361614909">Изделип жаткан нерсени өчүрүү</translation>
<translation id="8674417702521959187">Серептөө дайындарын ушул түзмөктөн өчүрүп, ал эми Google аккаунтуңузда сактап калуу үчүн <ph name="BEGIN_LINK" />Optimium'дан чыгыңыз<ph name="END_LINK" />.</translation>
<translation id="6186721318460238018">Жолдо баратканда жаңы өтмөк топторун ачуу же түзүү үчүн телефонуңузга Optimium'ду жүктөп алыңыз.</translation>
<translation id="185970820835152459">Кирип турган Google аккаунттарыңызды башкара аласыз. Google аккаунттарыңыз Chromium серепчисинде, Play Store'до, Gmail'де жана башка жерлерде колдонулат. Эгер кимдир бирөөнүн, мисалы, үй-бүлөлүк топтун мүчөсүнүн аккаунтун кошкуңуз келсе, жаңы адамды <ph name="DEVICE_TYPE" /> түзмөгүнө кошуп коюңуз. <ph name="LINK_BEGIN" />Кеңири маалымат<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Сүрөт издөө функциясы менен издеңиз</translation>
<translation id="1781731701613313704"><ph name="EXISTING_USER" /> мурунтан эле кирип турат. Сиз серептеген нерселерди ажыратуу үчүн <ph name="USER_EMAIL_ADDRESS" /> катары өз профилиңизден Optimium'га кириңиз. Ошондой эле, <ph name="DEVICE" /> аккаунтуңуздагы кыстармаларды жана башка нерселерди аласыз.</translation>
<translation id="1880677175115548835">Текстти тандоо</translation>
<translation id="5960850334733792580">Башкарылган аккаунт менен кирип, анын администраторунун милдетин Optimium профилиңизге өткөрүп берип жатасыз. Optimium дайын-даректериңизди, колдонмолоруңузду, кыстармаларыңызды, таржымалыңызды, сырсөздөрүңүздү жана башка параметрлерди <ph name="USER_NAME" /> менен биротоло байланыштырат. Бул дайындарды Google Каттоо эсептеринин жеке кеңсеси аркылуу жок кылсаңыз болот, бирок бул дайындарды башка аккаунтка байлай албайсыз. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium жылма сыдыруу жана видеодогу кадрлардын жыштыгы сыяктуу визуалдык кубулуштарды жана фондогу аракеттерди чектөө менен батареянын кубатын үнөмдөйт. <ph name="BEGIN_LINK" />Кубатты үнөмдөгүч жөнүндө кеңири маалымат алыңыз<ph name="END_LINK" /></translation>
<translation id="7900167719031567542">Optimium Updater Service</translation>
<translation id="1911763535808217981">Ушуну өчүрүү менен Gmail сыяктуу Google сайттарына Chromium'суз кире аласыз</translation>
<translation id="5015349619125768393">Optimium жооп бербей жатат. Өчүрүп кайра ишке киргизесизби?</translation>
<translation id="2019000760486664637">Уюмуңуз, <ph name="MANAGER" />, Optimium'га кирүүнү талап кылат</translation>
<translation id="193439633299369377">Жаңыртууну колдонуу үчүн ChromiumOS өчүрүлүп күйгүзүлүшү керек.</translation>
<translation id="3382368450324191331">Файл түрү аз жүктөлүп алынып, кооптуу болушу мүмкүн болгондуктан, Optimium бул жүктөп алууну бөгөттөдү</translation>
<translation id="1953553007165777902">Жүктөлүп алынууда... <ph name="MINUTE" /> мүнөт калды</translation>
<translation id="1966382378801805537">Chromium демейки серепчини аныктап же коё албай жатат</translation>
<translation id="197326043290947695">Сүрөт издөө функциясы менен акылдуураак карап чыгыңыз</translation>
<translation id="5321661580966500942">Optimium эмне үчүн айрым файлдарды бөгөттөгөнүн билип алыңыз, жаңы өтмөктө ачылат</translation>
<translation id="8960045458031480819">Optimium программасын жаңыртып турат. Эгер бул кызмат өчүрүлүп же токтотулса, Optimium программаңыз жаңыртылбайт, ал эми коопсуздукка коркунуч жаралса, ал оңдолбой жана функциялар иштебеши мүмкүн. Optimium программасы бул кызматты колдонбосо, ал өзү эле чыгарылып салынат.</translation>
<translation id="2008474315282236005">Ушуну менен түзмөктөгү 1 нерсе өчүрүлөт. Дайын-даректериңизди кийинчерээк чыгарып алуу үчүн Chromium'га <ph name="USER_EMAIL" /> аккаунту менен кириңиз.</translation>
<translation id="2018879682492276940">Орнотулбай калды. Кайталап көрүңүз.</translation>
<translation id="2039417478970545937">Параметрлер.</translation>
<translation id="2049376729098081731">Chromium таржымалын Google кызматтарын жекелештирүү үчүн колдонуп же колдонбоону тандаңыз</translation>
<translation id="4120951192672345208">Optimium'га алдын ала орнотулган жана татаал сырсөздөрдү түзүүгө, сактоого жана автотолтурууга жардам берет. Оңой кирүү үчүн ыкчам баскычты кошуңуз.</translation>
<translation id="2060311596979880693">Ийгилик! Эми Chrome'догу Google Издөө менен сайттарды карап жатып, суроолорду оңой бере аласыз</translation>
<translation id="7165258062917217746">Optimium'га жаңы көрүнүш берүү үчүн Жаңы өтмөк бетиндеги Optimium'ду ыңгайлаштыруу баскычын басыңыз</translation>
<translation id="3702823791268559760">Файл адаштыруучу болуп, түзмөгүңүзгө күтүлбөгөн өзгөртүүлөрдү киргизиши мүмкүн болгондуктан, Optimium бул жүктөп алууну бөгөттөдү</translation>
<translation id="2370804817835146114">Кийинки жолу Optimium iOS'ту ачканыңызда <ph name="FEATURE_NAME" /> функциясын колдонуп көрүү сунушталат.</translation>
<translation id="5887094242311035059">Сырсөздөрүңүз жана Optimium'дагы башка маалымат Google аккаунтуңузга сакталып, бул түзмөктөн өчүрүлөт. Аларды Optimium'да кайра колдонуу үчүн кайра кириңиз.</translation>
<translation id="8794268168383660193">{COUNT,plural, =1{Optimium 1 мүнөткө колдонулбаса, уюмуңуз серептөө дайындарын автоматтык түрдө өчүрөт. Бул таржымалды, автотолтурууну жана жүктөлүп алынгандарды камтышы мүмкүн. Өтмөктөрүңүз ачык бойдон калат.}other{Optimium # мүнөткө колдонулбаса, уюмуңуз серептөө дайындарын автоматтык түрдө өчүрөт. Бул таржымалды, автотолтурууну жана жүктөлүп алынгандарды камтышы мүмкүн. Өтмөктөрүңүз ачык бойдон калат.}}</translation>

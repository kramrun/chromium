<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="el">
<translation id="1026101648481255140">Συνέχιση εγκατάστασης</translation>
<translation id="1029669172902658969">Επανεκκίνηση για ενημέρωση του &amp;Chromium OS</translation>
<translation id="4063809399345498325">Το Optimium συνιστά να ελέγξετε αυτή την επέκταση</translation>
<translation id="1042552502243217427">Όταν ένας ιστότοπος ζητά την ιδιωτική προφόρτωση συνδέσμων στη σελίδα του, το Chromium χρησιμοποιεί τους διακομιστές της Google. Με αυτόν τον τρόπο, η ταυτότητά σας αποκρύπτεται από τον προφορτωμένο ιστότοπο, αλλά η Google μαθαίνει ποιοι ιστότοποι προφορτώνονται.</translation>
<translation id="1051793555070215510">Βοηθήστε μας να βελτιώσουμε την ανώνυμη περιήγηση, συμμετέχοντας σε αυτή την έρευνα διάρκειας 1 λεπτού.</translation>
<translation id="1065672644894730302">Δεν είναι δυνατή η ανάγνωση των προτιμήσεών σας. Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες και οι αλλαγές στις προτιμήσεις δεν θα αποθηκευτούν.</translation>
<translation id="7250992450852052182">Ο γονέας σου απενεργοποίησε την επιλογή "Άδειες για ιστοτόπους, εφαρμογές και επεκτάσεις" για το Optimium</translation>
<translation id="6711838932294803312">Το Optimium χρειάζεται πρόσβαση στο τοπικό δίκτυό σας για την ανακάλυψη και τη χρήση συσκευών σε κοντινή απόσταση</translation>
<translation id="2807920805712601449">Για να αναζητήσετε μια συγκεκριμένη λειτουργία ή επέκταση του Optimium, πληκτρολογήστε τη συντόμευσή της στη γραμμή διευθύνσεων και, στη συνέχεια, το επιλεγμένο πλήκτρο πληκτρολογίου</translation>
<translation id="5994612110840535151">Εμφάνιση της αναζήτησης με το Optimium στην περιοχή ειδοποιήσεων και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="7212528213853025915">Το Optimium θέλει να εξαγάγει τους κωδικούς πρόσβασής σας. Για να το επιτρέψετε αυτό, πληκτρολογήστε τον κωδικό πρόσβασης για τα Windows.</translation>
<translation id="112640046208448578">Αναγνωρίστε αντικείμενα ή μέρη και αντιγράψτε ή μεταφράστε κείμενο. Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες, ένα στιγμιότυπο οθόνης της σελίδας αποστέλλεται στον διακομιστή. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Το Chromium είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="1131805035311359397">Για να ελέγξετε αν οι κωδικοί πρόσβασής σας είναι ασφαλείς από παραβιάσεις δεδομένων και άλλα ζητήματα ασφαλείας, <ph name="BEGIN_LINK" />συνδεθείτε στο Chromium<ph name="END_LINK" />.</translation>
<translation id="3458316367708035110">{COUNT,plural, =1{Ο διαχειριστής σας ζητά να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί αυτή η ενημέρωση. Υπάρχει ένα παράθυρο ανώνυμης περιήγησης ή απομονωμένο παράθυρο ανοιχτό. Δεν θα ανοίξει ξανά μετά την επανεκκίνηση.}other{Ο διαχειριστής σας ζητά να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί αυτή η ενημέρωση. Υπάρχουν # παράθυρα ανώνυμης περιήγησης και απομονωμένα παράθυρα ανοιχτά σε όλα τα προφίλ. Δεν θα ανοίξουν ξανά μετά την επανεκκίνηση.}}</translation>
<translation id="1150418667633096194">Το κουμπί "πλαϊνό πλαίσιο της Αναζήτησης Google" στη γραμμή εργαλείων έχει νέο εικονίδιο. Κάντε κλικ στο εικονίδιο για να υποβάλετε ερωτήσεις κατά την περιήγηση με το πλαϊνό πλαίσιο της Αναζήτησης Google.</translation>
<translation id="759898790519515623">Κάντε κλικ στο μενού του Optimium</translation>
<translation id="1157952955648710254">Κλείσιμο πλαϊνού πλαισίου Αναζήτησης Google</translation>
<translation id="1157985233335035034">Πρόσφατες γλώσσες</translation>
<translation id="1184145431117212167">Η εγκατάσταση απέτυχε επειδή η έκδοση των Windows που χρησιμοποιείτε δεν υποστηρίζεται.</translation>
<translation id="1185134272377778587">Σχετικά με το Chromium</translation>
<translation id="5987505065981917957">Λήψη ειδοποιήσεων παρακολούθησης τιμής με το Optimium στο τηλέφωνό σας</translation>
<translation id="1203500561924088507">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε το πρόγραμμα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME" />.</translation>
<translation id="1232234696885483911">Όταν ανοίγετε την Αναζήτηση με εικόνες, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, θα αποστέλλονται αυτόματα στον διακομιστή. <ph name="LEARN_MORE" /></translation>
<translation id="3560913454241378492">Ενώ είστε συνδεδεμένοι, μπορείτε να χρησιμοποιήσετε τους κωδικούς πρόσβασής σας και πολλά άλλα από τον Λογαριασμό σας Google στο Optimium. Για να αλλάξετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα Ο λογαριασμός σας στο Optimium.</translation>
<translation id="8922965532693587493">Εμφάνιση του Gemini στο Optimium στη γραμμή μενού του Mac</translation>
<translation id="236433590733312836">Για να επιλέξετε ένα μέρος της οθόνης στο Gemini στο Optimium, χρησιμοποιήστε μια συντόμευση πληκτρολογίου.</translation>
<translation id="7976124325589452515">Ενώ αυτή η καρτέλα ήταν ανενεργή, ελευθερώθηκε μνήμη για να παραμείνει γρήγορο το Optimium. Μπορείτε να επιλέξετε να εξαιρείται πάντα αυτός ο ιστότοπος, ώστε να παραμένει ενεργός.</translation>
<translation id="2758503437544511902">Το Optimium απέκλεισε αυτή τη λήψη επειδή το αρχείο είναι επικίνδυνο</translation>
<translation id="126567311906253476">Όταν συνδέεστε σε υπηρεσίες Google, όπως το Gmail ή το YouTube, με τον λογαριασμό <ph name="USER_EMAIL" />, μπορείτε να συνδέεστε αυτόματα στο Chromium με τον ίδιο λογαριασμό</translation>
<translation id="4104061172701635162">Λήψη του Optimium στο τηλέφωνό σας</translation>
<translation id="1290883685122687410">Σφάλμα ρύθμισης: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="3443894627866827446">Ρυθμίστε το νέο σας προφίλ στο Optimium</translation>
<translation id="8946186262159916495">Δοκιμάστε τη με το Gemini στο Optimium</translation>
<translation id="7981347318091963592">Το Optimium χρειάζεται πρόσβαση στο Bluetooth για εξερεύνηση
 Συσκευών Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6099322702899630168">Συνδεθείτε στο Optimium από το τηλέφωνό σας</translation>
<translation id="1330562121671411446">Εντοπισμός γλώσσας</translation>
<translation id="3294414641786025647">Να διαγραφούν επίσης δεδομένα από το Optimium (<ph name="URL" />)</translation>
<translation id="4214354213779528068">{COUNT,plural, =1{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί μια ενημέρωση. Υπάρχει ένα παράθυρο ανώνυμης περιήγησης ή απομονωμένο παράθυρο ανοιχτό. Δεν θα ανοίξει ξανά μετά την επανεκκίνηση.}other{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί μια ενημέρωση. Υπάρχουν # παράθυρα ανώνυμης περιήγησης και απομονωμένα παράθυρα ανοιχτά σε όλα τα προφίλ. Δεν θα ανοίξουν ξανά μετά την επανεκκίνηση.}}</translation>
<translation id="1345251407431278948">Καρφιτσώθηκε! Μπορείτε να αποκτήσετε ξανά πρόσβαση στην Αναζήτηση με εικόνες από το νέο κουμπί στη γραμμή εργαλείων</translation>
<translation id="1383876407941801731">Αναζήτηση</translation>
<translation id="7825299065989465359">Χρησιμοποιήστε την εφαρμογή Optimium για να συνεχίσετε την περιήγηση εν κινήσει</translation>
<translation id="141901961143729572">Μοιραστείτε τις σκέψεις σας</translation>
<translation id="1438812738230833934">Μπορείτε να ανοίξετε ξανά την Αναζήτηση Google στο πλαϊνό πλαίσιο, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="4131307166987455854">Για να μοιραστείτε το παράθυρό σας, επιτρέψτε την εγγραφή οθόνης για το Optimium στις Ρυθμίσεις συστήματος.</translation>
<translation id="1470136641087909499">Μπορείτε να ανοίξετε ξανά την Αναζήτηση Google στο Chrome, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="1478370723027452770">Λήψη βοήθειας για το Chrome for Testing</translation>
<translation id="9200022682397754538">Για να έχετε πρόσβαση στις αποθηκευμένες πληροφορίες σας και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE" />, συνδεθείτε στο Optimium</translation>
<translation id="1497802159252041924">Σφάλμα εγκατάστασης: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Αυτή η σελίδα είναι προστατευμένη</translation>
<translation id="892690000529877604">Μοιραστείτε μια καρτέλα του Optimium</translation>
<translation id="15408169957028265">Άνοιγμα Αναζήτησης Google στο Chrome</translation>
<translation id="9039191226880557963">Σύνδεση στο Optimium</translation>
<translation id="1547469039832541117">Τερματίζει την επισημασμένη εργασία.</translation>
<translation id="4414991100979797293">Καρφίτσωμα Optimium</translation>
<translation id="1574377791422810894">Εργαλεία ασφάλειας του Chromium</translation>
<translation id="3934587628489930735">Το Optimium θέλει να διαγράψει τα δεδομένα της Διαχείρισης κωδικών πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτή την ενέργεια.</translation>
<translation id="6745390171113033635">{COUNT,plural, =0{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί μια ενημέρωση.}=1{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί μια ενημέρωση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί μια ενημέρωση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="7186551909256266009">Αξιοποιήστε τις καλύτερες λειτουργίες της Google με την εφαρμογή Optimium στο τηλέφωνό σας</translation>
<translation id="1625909126243026060">Ελέγξτε σημαντικά στοιχεία ελέγχου για το απόρρητο και την ασφάλεια στο Chromium</translation>
<translation id="1640672724030957280">Γίνεται λήψη…</translation>
<translation id="1648201623125974721">Νέο εικονίδιο, ίδια συντόμευση: Κάντε κλικ για να υποβάλετε ερωτήσεις κατά την περιήγηση με τις Εργασίες με βάση τα συμφραζόμενα.</translation>
<translation id="1665602916345474427">Συνδεθήκατε ως <ph name="USER_NAME" />, <ph name="USER_EMAIL" />: με συνδρομή. Άνοιγμα του μενού λογαριασμού</translation>
<translation id="1708414395296835197">Μπορείτε να χρησιμοποιείτε το Chromium κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές. Επίσης, θα καρφιτσωθεί στη γραμμή εργαλείων.</translation>
<translation id="1709772298389099340">Παρέχει αναβαθμισμένα προνόμια για το <ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Αυτό θα σας επιτρέψει να επιλέγετε μία από τις διαθέσιμες συσκευές και να προβάλλετε περιεχόμενο σε αυτήν.</translation>
<translation id="6717880500969720524">Το Optimium θα διαγράψει σύντομα τα δεδομένα περιήγησης</translation>
<translation id="1736443181683099871">Το Chromium θα προσπαθήσει να αναβαθμίσει τις πλοηγήσεις σε HTTPS</translation>
<translation id="4418738262462299802">Διαγρ. δεδ. Optimium</translation>
<translation id="8469746761106187775">Θα γίνει επανεκκίνηση του Optimium σε <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Όταν δεν είναι διαθέσιμο το HTTPS, το Chromium θα χρησιμοποιεί μια μη ασφαλή σύνδεση χωρίς να σας ειδοποιεί</translation>
<translation id="1769661297620183092">Μπορείτε να ανοίξετε ξανά το πλαίσιο της Αναζήτησης Google, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="6555789357989792722">Να επιτρέπεται στο Optimium να εκτελείται στο παρασκήνιο</translation>
<translation id="627441522449241646">Για να κάνουμε το Optimium πιο ασφαλές, απενεργοποιήσαμε ορισμένες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="1912380661217770781">Κάντε κλικ στο κουμπί <ph name="BEGIN_BOLD" />Ναι<ph name="END_BOLD" /> στην ειδοποίηση των Windows, για να καρφιτσώσετε το Optimium στη γραμμή εργαλείων για γρήγορη πρόσβαση.</translation>
<translation id="9034578483087384251">Επανεγκατάσταση του Optimium</translation>
<translation id="2856362667064664106">Το Optimium προσπαθεί να <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="1665590461646883113">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Optimium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στις επεκτάσεις σας και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE" />.</translation>
<translation id="1668665535355826445">Την επόμενη φορά που θα ανοίξετε το Optimium στη συσκευή <ph name="DEVICE_TYPE" />, θα δείτε μια προτροπή για χρήση της Διαχείρισης κωδικών πρόσβασης Google.</translation>
<translation id="1838374766361614909">Διαγραφή αναζητήσεων</translation>
<translation id="8674417702521959187">Για να διαγράψετε τα δεδομένα περιήγησης μόνο από αυτή τη συσκευή και να τα διατηρήσετε στον Λογαριασμό σας Google, <ph name="BEGIN_LINK" />αποσυνδεθείτε από το Optimium<ph name="END_LINK" />.</translation>
<translation id="6186721318460238018">Κατεβάστε το Optimium στο τηλέφωνό σας για άνοιγμα ή δημιουργία νέων ομάδων καρτελών εν κινήσει.</translation>
<translation id="185970820835152459">Μπορείτε να διαχειριστείτε τους συνδεδεμένους Λογαριασμούς σας Google. Οι Λογαριασμοί σας Google χρησιμοποιούνται για το πρόγραμμα περιήγησης Chromium, το Play Store, το Gmail κ.ά. Εάν θέλετε να προσθέσετε έναν λογαριασμό για κάποιο άλλο άτομο, όπως για ένα μέλος της οικογένειας, προσθέστε, αντ' αυτού, ένα νέο άτομο στη συσκευή σας <ph name="DEVICE_TYPE" />. <ph name="LINK_BEGIN" />Μάθετε περισσότερα<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Αναζητήστε με την Αναζήτηση με εικόνες</translation>
<translation id="1781731701613313704">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Optimium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία από <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Επιλογή κειμένου</translation>
<translation id="5960850334733792580">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο Optimium. Τα δεδομένα σας στο Optimium, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME" />. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών Google, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. Αν θέλετε, μπορείτε να δημιουργήσετε ένα νέο προφίλ στο οποίο θα διατηρηθούν ξεχωριστά τα υπάρχοντα δεδομένα του Optimium. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Το Chromium εξοικονομεί μπαταρία περιορίζοντας τη δραστηριότητα στο παρασκήνιο και τα οπτικά εφέ, όπως είναι η ομαλή κύλιση και οι ρυθμοί καρέ βίντεο. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με την Εξοικονόμηση ενέργειας<ph name="END_LINK" /></translation>
<translation id="7900167719031567542">Υπηρεσία Optimium Updater</translation>
<translation id="1911763535808217981">Με την απενεργοποίηση αυτής της λειτουργίας, μπορείτε να συνδεθείτε σε ιστοτόπους Google, όπως το Gmail, χωρίς να συνδεθείτε στο Chromium</translation>
<translation id="5015349619125768393">Το Optimium δεν ανταποκρίνεται. Να γίνει επανεκκίνηση τώρα;</translation>
<translation id="2019000760486664637">Ο οργανισμός σας, <ph name="MANAGER" />, απαιτεί να συνδεθείτε στο Optimium</translation>
<translation id="193439633299369377">Για να εφαρμοστεί η ενημέρωση, πρέπει να γίνει επανεκκίνηση του Chromium OS.</translation>
<translation id="3382368450324191331">Το Optimium απέκλεισε αυτή τη λήψη επειδή δεν πραγματοποιείται συχνά λήψη αυτού του τύπου αρχείου και ενδέχεται να είναι επικίνδυνος</translation>
<translation id="1953553007165777902">Λήψη… Απομένουν <ph name="MINUTE" /> λεπτά</translation>
<translation id="1966382378801805537">Το Chromium δεν μπορεί να καθορίσει ή να ορίσει το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="197326043290947695">Περιηγηθείτε πιο έξυπνα με την Αναζήτηση με εικόνες</translation>
<translation id="5321661580966500942">Μάθετε γιατί το Optimium αποκλείει ορισμένα αρχεία, ανοίγει σε νέα καρτέλα</translation>
<translation id="8960045458031480819">Διατηρεί το λογισμικό Optimium ενημερωμένο. Εάν αυτή η υπηρεσία απενεργοποιηθεί ή σταματήσει, το λογισμικό Optimium δεν θα ενημερώνεται, πράγμα που σημαίνει ότι δεν θα είναι δυνατή η επιδιόρθωση ευπαθειών ασφάλειας που μπορεί να εμφανιστούν και μπορεί να μη λειτουργούν ορισμένα χαρακτηριστικά. Η εγκατάσταση της υπηρεσίας αυτής καταργείται αυτόματα, όταν δεν υπάρχει λογισμικό Optimium που να τη χρησιμοποιεί.</translation>
<translation id="2008474315282236005">Με αυτή την ενέργεια θα διαγραφεί 1 στοιχείο από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Chromium ως <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Αποτυχία εγκατάστασης. Δοκιμάστε ξανά.</translation>
<translation id="2039417478970545937">Ρυθμίσεις.</translation>
<translation id="2049376729098081731">Επιλέξτε αν θέλετε να συμπεριλαμβάνεται το ιστορικό Chromium για πιο εξατομικευμένες εμπειρίες στις υπηρεσίες Google.</translation>
<translation id="4120951192672345208">Είναι ενσωματωμένη στο Optimium για να σας βοηθά να δημιουργείτε, να αποθηκεύετε και να συμπληρώνετε αυτόματα ισχυρούς κωδικούς πρόσβασης. Προσθέστε τη συντόμευση για εύκολη πρόσβαση.</translation>
<translation id="2060311596979880693">Επιτυχία! Μπορείτε πλέον να κάνετε εύκολα ερωτήσεις κατά την περιήγηση με την Αναζήτηση Google στο Chrome</translation>
<translation id="7165258062917217746">Κάντε κλικ στο κουμπί Προσαρμογή Optimium στη σελίδα Νέα καρτέλα, για να δώσετε μια νέα εμφάνιση στο Optimium</translation>
<translation id="3702823791268559760">Το Optimium απέκλεισε αυτή τη λήψη επειδή το αρχείο είναι παραπλανητικό και μπορεί να κάνει μη αναμενόμενες αλλαγές στη συσκευή σας</translation>
<translation id="2370804817835146114">Την επόμενη φορά που θα ανοίξετε το Optimium iOS, θα δείτε μια προτροπή για να δοκιμάσετε τη λειτουργία <ph name="FEATURE_NAME" />.</translation>
<translation id="5887094242311035059">Οι κωδικοί πρόσβασης και άλλα δεδομένα του Optimium που αποθηκεύσατε στον Λογαριασμό σας Google θα καταργηθούν από αυτή τη συσκευή. Για να τα χρησιμοποιήσετε ξανά στο Optimium, συνδεθείτε ξανά.</translation>
<translation id="8794268168383660193">{COUNT,plural, =1{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το Optimium δεν χρησιμοποιείται για 1 λεπτό. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι καρτέλες σας θα παραμείνουν ανοιχτές.}other{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το Optimium δεν χρησιμοποιείται για # λεπτά. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι καρτέλες σας θα παραμείνουν ανοιχτές.}}</translation>
<translation id="2125838419757773031">Επιλέξτε περιοχή της οθόνης για αναζήτηση</translation>
<translation id="2126108037660393668">Η επιβεβαίωση του ληφθέντος αρχείου απέτυχε.</translation>
<translation id="2135919691573380097">Αναφορά αυτού του ιστοτόπου</translation>
<translation id="2137162749895930932">Κλείσιμο οθόνης μετάφρασης</translation>
<translation id="2147218225094845757">Απόκρυψη πλαϊνού πλαισίου</translation>
<translation id="8888656790178891761">Το Optimium απέκλεισε αυτή τη λήψη επειδή ο ιστότοπος δεν χρησιμοποιεί ασφαλή σύνδεση και το αρχείο μπορεί να έχει παραβιαστεί</translation>
<translation id="2170098639895543546">Επιλέξτε οτιδήποτε στη σελίδα</translation>
<translation id="6975401993318112971">Προσαρμογή του Optimium</translation>
<translation id="2174917724755363426">Η εγκατάσταση δεν έχει ολοκληρωθεί. Είστε βέβαιοι ότι θέλετε να την ακυρώσετε;</translation>
<translation id="7741769305753410467">Optimium - Σύνδεση δικτύου - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Σφάλμα ελέγχου για ενημερώσεις: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2133097742403140075">Κατάργηση λογαριασμού από το Optimium</translation>
<translation id="6495056863394621013">Χρησιμοποιήστε την εφαρμογή Optimium για να έχετε τα καλύτερα εργαλεία αγορών εν κινήσει</translation>
<translation id="2209877494277346829">Απομόνωση του Chromium από άλλες εφαρμογές</translation>
<translation id="2035198300681156782">Παραμείνετε ασφαλείς εν κινήσει με τη Βελτιωμένη Ασφαλή περιήγηση στο Optimium για iOS</translation>
<translation id="2210682093923538346">Επικίνδυνος ιστότοπος. Το Chromium κατάργησε ειδοποιήσεις.</translation>
<translation id="2236949375853147973">Η δραστηριότητά μου</translation>
<translation id="871771486544954531">Για να έχετε πρόσβαση στις διευθύνσεις σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Optimium. Αυτή η διεύθυνση θα αποθηκευτεί στον Λογαριασμό σας Google μετά τη σύνδεσή σας.</translation>
<translation id="524316078518338158">Αν χρησιμοποιείτε έναν υπολογιστή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το Optimium ακριβώς όπως θέλουν.</translation>
<translation id="22571759390241347">Δεξιότητες στο Chromium</translation>
<translation id="2283228908180457226">Νέο εικονίδιο, ίδια συντόμευση: Κάντε κλικ για να υποβάλετε ερωτήσεις κατά την περιήγηση με το πλαϊνό πλαίσιο της Αναζήτησης Google.</translation>
<translation id="2283803047247799269">Αναζήτηση σε αυτή την καρτέλα με την Αναζήτηση με εικόνες</translation>
<translation id="5808794606375505413">{NUM_TABS,plural, =1{Το Optimium συνιστά να θέσετε σε παύση την καρτέλα που επιβραδύνει το πρόγραμμα περιήγησης}other{Το Optimium συνιστά να θέσετε σε παύση τις καρτέλες που επιβραδύνουν το πρόγραμμα περιήγησης}}</translation>
<translation id="2307973900865360088">Διατήρηση στο Dock</translation>
<translation id="2313870531055795960">Ελέγχει εάν τα URL περιλαμβάνονται στη λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο Chromium. Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό πρόσβασής σας ή όταν κατεβάζετε ένα επιβλαβές αρχείο, το Chromium μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση.</translation>
<translation id="2356070529366658676">Να γίνεται ερώτηση</translation>
<translation id="2359808026110333948">Συνέχεια</translation>
<translation id="7000103009822967939">Η επέκταση <ph name="EXTENSION_NAME" /> θέλει να συνδεθείτε στο Optimium</translation>
<translation id="184381469736757112">Απενεργοποίηση του Optimium, όταν εκτελούνται εφαρμογές στο παρασκήνιο</translation>
<translation id="5141894774016157674">Για να χρησιμοποιήσετε αυτή την επέκταση με τον λογαριασμό <ph name="USER_EMAIL_ADDRESS" />, συνδεθείτε στο Optimium.</translation>
<translation id="2384373936468275798">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chromium OS, επειδή τα στοιχεία σύνδεσης του λογαριασμού σας δεν είναι ενημερωμένα.</translation>
<translation id="2523694910556579068">{NUM_DEVICES,plural, =0{Αποκτήθηκε πρόσβαση σε 1 συσκευή HID από μία ή περισσότερες επεκτάσεις Optimium}=1{Αποκτήθηκε πρόσβαση σε 1 συσκευή HID από μία ή περισσότερες επεκτάσεις Optimium}other{Αποκτήθηκε πρόσβαση σε # συσκευές HID από μία ή περισσότερες επεκτάσεις Optimium}}</translation>
<translation id="2899976927368522713">Το Optimium χρειάζεται άδεια μικροφώνου και κάμερας για αυτόν τον ιστότοπο.</translation>
<translation id="2403703063067034158">Σφάλμα εκκίνησης: Αυτή τη στιγμή εκτελείται μια άλλη παρουσία της ρύθμισης. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="8530786035410512232">Ανοίξτε συνδέσμους στο Optimium από οποιαδήποτε εφαρμογή και διατηρήστε το πρόγραμμα περιήγησης προσβάσιμο στη γραμμή εργαλείων</translation>
<translation id="5645058843566501763">Κάντε κλικ στο κουμπί Σύνοψη, για να κοινοποιήσετε αυτό το έγγραφο στο Gemini στο Optimium, να λάβετε μια γρήγορη επισκόπηση και να κάνετε επιπλέον ερωτήσεις</translation>
<translation id="2440750600860946460">Με τα <ph name="BEGIN_LINK" />εργαλεία του Chromium<ph name="END_LINK" />, μπορείτε να περιηγείστε με ασφάλεια και να διατηρείτε τον έλεγχο</translation>
<translation id="5384013849288198705">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Optimium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="2451727308784734061">Χρησιμοποιήστε τη συντόμευση για να μεταβείτε γρήγορα στον Διαχειριστή κωδικών πρόσβασης. Μπορείτε να μετακινήσετε τη συντόμευση στην αρχική οθόνη ή στην εφαρμογή εκκίνησης του υπολογιστή.</translation>
<translation id="4074322039453189342">Το Optimium θα κλείσει σύντομα</translation>
<translation id="4239399282729309306">Στο Optimium</translation>
<translation id="2485422356828889247">Απεγκατάσταση</translation>
<translation id="2513154137948333830">Απαιτείται επανεκκίνηση: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2521391734665471391">Κλείσιμο Λειτουργίας AI στην Αναζήτηση Google</translation>
<translation id="2542968102051442371">Επιλογή κειμένου με την Αναζήτηση με εικόνες</translation>
<translation id="7238239459452345825">Το Optimium προσπαθεί να αντικαταστήσει τους υπάρχοντες κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτή την ενέργεια.</translation>
<translation id="5059411697679064446">Το Optimium χρειάζεται πρόσβαση στον αποθηκευτικό χώρο για τη λήψη αρχείων</translation>
<translation id="5959299320608819381">Πρόγραμμα βοήθειας Optimium</translation>
<translation id="2575822587468774919">Επιλέξτε οτιδήποτε για αναζήτηση με την Αναζήτηση με εικόνες</translation>
<translation id="8063772441784541423">Για να έχετε πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Optimium</translation>
<translation id="3112793931795471365">Σαρώστε τον κωδικό QR με το τηλέφωνό σας, για να κατεβάσετε το Optimium και να συνδεθείτε στον Λογαριασμό σας Google.</translation>
<translation id="1584670114556742260">για αναζήτηση με το Optimium.</translation>
<translation id="2680687985294820735">Συνέχεια χρήσης του Optimium</translation>
<translation id="259935314519650377">Απέτυχε η αποθήκευση του ληφθέντος προγράμματος εγκατάστασης στην κρυφή μνήμη. Σφάλμα: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Σύστημα</translation>
<translation id="7753906894780562903">Ο οργανισμός σας μπορεί να βλέπει και να διαχειρίζεται τα δεδομένα περιήγησης, όπως σελιδοδείκτες, ιστορικό και κωδικούς πρόσβασης. Δεν μπορεί να βλέπει τα δεδομένα περιήγησης σε άλλα προφίλ στο Optimium</translation>
<translation id="3912526786507084695">Επαληθεύστε την ταυτότητά σας, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Optimium στον λογαριασμό σας, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="1723346026518998062">{COUNT,plural, =0{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί μια ενημέρωση}=1{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί μια ενημέρωση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί μια ενημέρωση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="1676939910504260523">Έναρξη του Optimium</translation>
<translation id="4524556064279918264">Παρουσιάστηκε σφάλμα στο λειτουργικό σύστημα κατά την εγκατάσταση. Κατεβάστε το Optimium ξανά.</translation>
<translation id="1998551382060432430">Εάν χρησιμοποιείτε μια συσκευή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το Optimium ακριβώς όπως θέλουν.</translation>
<translation id="5180414833025415316">Εύκολη πρόσβαση για χρήση του Gemini στο Optimium σε όλη τη συσκευή σας, ακόμα και αν το Optimium είναι ελαχιστοποιημένο.</translation>
<translation id="5895170254499246640">Καρτέλα Optimium</translation>
<translation id="2718390899429598676">Για επιπλέον ασφάλεια, το Chromium θα κρυπτογραφήσει τα δεδομένα σας.</translation>
<translation id="6684098000857849465">Για να καταργήσετε τον Λογαριασμό σας Google από το Optimium, αποσυνδεθείτε</translation>
<translation id="8035579362848370000">Για να έχετε πρόσβαση στους κωδικούς πρόσβασης, στους σελιδοδείκτες και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Optimium</translation>
<translation id="2738871930057338499">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. HTTP 403 Forbidden. Ελέγξτε τη διαμόρφωση των παραμέτρων του διακομιστή μεσολάβησης.</translation>
<translation id="2753623023919742414">Κάντε κλικ για αναζήτηση</translation>
<translation id="6013736131971103780">Ορισμός του Optimium ως προεπιλεγμένου προγράμματος προβολής PDF</translation>
<translation id="218391145495840504">Αυτή η επέκταση περιέχει κακόβουλο πρόγραμμα και δεν είναι ασφαλής. Καταργήστε την από το Optimium, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="2799223571221894425">Επανεκκίνηση</translation>
<translation id="8757776333711121842">Το δικό σας Optimium</translation>
<translation id="2816462166102338036">Αναζήτηση αυτού του βίντεο με την Αναζήτηση με εικόνες</translation>
<translation id="5977650568712460613">Ανακαλύψτε προϊόντα με την κάμερα, παρακολουθήστε τις πτώσεις τιμών και πολλά άλλα εν κινήσει με το Optimium σε iOS.</translation>
<translation id="2841525013647267359">Μετάφραση από</translation>
<translation id="2846251086934905009">Σφάλμα εγκατάστασης: Το πρόγραμμα εγκατάστασης δεν ολοκληρώθηκε. Η εγκατάσταση ακυρώθηκε.</translation>
<translation id="7445294455857704594">Κατάργηση από το Optimium…</translation>
<translation id="2850691299438350830">Διατηρεί την ασφάλειά σας στο Chromium και μπορεί να χρησιμοποιηθεί για τη βελτίωση της ασφάλειάς σας σε άλλες εφαρμογές Google όταν είστε συνδεδεμένοι.</translation>
<translation id="2876152561415416331">Εκ νέου άνοιγμα του πλαισίου της Αναζήτησης Google</translation>
<translation id="2885378588091291677">Διαχείριση εργασιών</translation>
<translation id="8130920144001221645">Σχετικά με το &amp;Optimium</translation>
<translation id="2915996080311180594">Επανεκκίνηση αργότερα</translation>
<translation id="5422843128705358539">Τα δεδομένα σας κρυπτογραφούνται με τη φράση πρόσβασης. Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Optimium στον Λογαριασμό σας Google.</translation>
<translation id="2945997411976714835">Σφάλμα εγκατάστασης: Απέτυχε η εκκίνηση της διεργασίας του προγράμματος εγκατάστασης.</translation>
<translation id="7644909281692978299">Συνδεθείτε πιο γρήγορα σε ιστοτόπους χρησιμοποιώντας αποθηκευμένους κωδικούς πρόσβασης για το Optimium σε iOS</translation>
<translation id="6715328262141930431">Ο οργανισμός σας διαχειρίζεται το Optimium</translation>
<translation id="2977470724722393594">Το Chromium έχει ενημερωθεί</translation>
<translation id="2977506796191543575">Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό πρόσβασής σας ή όταν κατεβάζετε ένα επιβλαβές αρχείο, το Chromium μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση</translation>
<translation id="3373190939774209520">Για να είσαι πιο ασφαλής στο διαδίκτυο με τις επιλογές του γονέα σου, συνδέσου στο Optimium</translation>
<translation id="2992577225802060159">Προστατεύει τη μνήμη του Chromium από άλλες εφαρμογές στον υπολογιστή σας.</translation>
<translation id="3003694935412297923">Όλες οι εργασίες</translation>
<translation id="2169110625780321257">{count,plural, =1{Το Optimium πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Google και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα (1 στοιχείο) θα διαγραφούν.}other{Το Optimium πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Google και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα ({count} στοιχεία) θα διαγραφούν.}}</translation>
<translation id="535155819036938485">Άνοιγμα της διεύθυνσης <ph name="URL" /> σε νέα καρτέλα στο Optimium.</translation>
<translation id="302551344979399011">Οι καινοτομίες AI, όπως οι δεξιότητες, αποθηκεύονται στον Λογαριασμό σας Google και η διαχείρισή τους γίνεται ξεχωριστά από τον συγχρονισμό του Chromium</translation>
<translation id="69529237724150463">Για να έχετε πρόσβαση στις επεκτάσεις σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Optimium</translation>
<translation id="1699367992046240140">Προσθήκη στο Optimium…</translation>
<translation id="3034219227076811559">Αναζήτηση Google στο Chrome</translation>
<translation id="3037190258341683404">Μπορείτε να καρφιτσώσετε την Αναζήτηση Google στο Chrome, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="3038232873781883849">Αναμονή για εγκατάσταση…</translation>
<translation id="3045032126857188731">Γλώσσα μετάφρασης: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Κλείσιμο παραθύρου διαλόγου σχολίων</translation>
<translation id="7641708778616103377">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Optimium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στη λίστα ανάγνωσης και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE" />.</translation>
<translation id="1759532319192341458">Άλλα προφίλ Optimium</translation>
<translation id="2862149341123916634">Οι επεκτάσεις είναι πρόσθετα που σας επιτρέπουν να προσαρμόζετε το Optimium. Από την οργάνωση έως την απλοποίηση των καθημερινών εργασιών, οι επεκτάσεις σάς βοηθούν να προσαρμόζετε το Optimium στις ανάγκες σας.</translation>
<translation id="9144026989666254609">Βοηθήστε μας να κάνουμε το Optimium καλύτερο, αποστέλλωντας αναφορές σφαλμάτων και <ph name="UMA_LINK" /> στην Google</translation>
<translation id="4449472527250709676">Χρησιμοποιήστε την εφαρμογή Optimium για να έχετε μαζί σας την ασφάλεια της Google</translation>
<translation id="6183456495642882201">{NUM_DEVICES,plural, =0{Αποκτήθηκε πρόσβαση σε 1 συσκευή USB από μία ή περισσότερες επεκτάσεις Optimium}=1{Αποκτήθηκε πρόσβαση σε 1 συσκευή USB από μία ή περισσότερες επεκτάσεις Optimium}other{Αποκτήθηκε πρόσβαση σε # συσκευές USB από μία ή περισσότερες επεκτάσεις Optimium}}</translation>
<translation id="7419486418212185022">Για να έχετε πρόσβαση στη λίστα ανάγνωσης και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE" />, συνδεθείτε στο Optimium</translation>
<translation id="4481023367748355854">Ιστορικό Optimium</translation>
<translation id="6289574887308484514">Η αποσυμπίεση του αρχείου από το πρόγραμμα εγκατάστασης απέτυχε. Κατεβάστε το Optimium ξανά.</translation>
<translation id="310459126943037700">Ο τερματισμός των εργασιών απέτυχε.</translation>
<translation id="3104828284009500087">Αναζητήστε οτιδήποτε στη σελίδα</translation>
<translation id="1866751185142421235">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές. Αποκτήστε εύκολα πρόσβαση στις λειτουργίες που γνωρίζετε και αγαπάτε, ορίζοντας το Optimium ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="7071720283847574213">Το Optimium χρησιμοποιεί το μικρόφωνό σας.</translation>
<translation id="3130333203120345554">Νέα αναζήτηση</translation>
<translation id="3137969841538672700">Σύρετε για αναζήτηση</translation>
<translation id="8832375982733310873">Αυτή η καρτέλα χρησιμοποιεί επιπλέον πόρους. Για να βελτιώσετε την απόδοση, επιτρέψτε στο Optimium να την απενεργοποιήσει.</translation>
<translation id="7212905776009358992">Για να μοιραστείτε την οθόνη σας, επιτρέψτε την εγγραφή οθόνης για το Optimium στις Ρυθμίσεις συστήματος</translation>
<translation id="7220401039380362840">Επανεκκίνηση Optimium</translation>
<translation id="3161522574479303604">Όλες οι γλώσσες</translation>
<translation id="2945128209475147845">Άνοιγμα Συνδέσμου σε Παράθυρο ανών&amp;υμης περιήγησης Optimium</translation>
<translation id="5550841702580813851">Προσαρμόστε το νέο σας προφίλ Optimium</translation>
<translation id="6179644101029308447">Μπορείτε να συνεχίσετε να συνομιλείτε με τη Λειτουργία AI χωρίς να αλλάξετε καρτέλες. Για να ξεκινήσετε, συνδεθείτε στο Optimium. Θα έχετε επίσης πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="5843425624301789054">Για να καταργήσετε τον Λογαριασμό σας Google από το Optimium, αποσυνδεθείτε από το Optimium στη σελίδα Ρυθμίσεις</translation>
<translation id="3234316605225071811">Αργότερα, το Chromium μπορεί να σας ρωτήσει αν θέλετε να χρησιμοποιήσετε τα αποθηκευμένα στοιχεία για την αυτόματη συμπλήρωση φορμών για εσάς</translation>
<translation id="3381027830404501211">Το Optimium δεν έχει δυνατότητα ανάγνωσης και εγγραφής στον κατάλογο δεδομένων του:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="8146675538658659954">Μεταφέρετε μαζί σας τα αγαπημένα σας εργαλεία Google AI με το Optimium σε iOS.</translation>
<translation id="6800117212942659992">Για να έχετε πρόσβαση στις επεκτάσεις σας και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE" />, συνδεθείτε στο Optimium</translation>
<translation id="1315108685137442441">{COUNT,plural, =1{Υπάρχει νέα διαθέσιμη ενημέρωση για το Optimium και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Το απομονωμένο παράθυρο δεν θα ανοίξει ξανά.}other{Υπάρχει νέα διαθέσιμη ενημέρωση για το Optimium και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Τα # απομονωμένα παράθυρα δεν θα ανοίξουν ξανά.}}</translation>
<translation id="3286538390144397061">Άμεση επανεκκίνηση</translation>
<translation id="2161039902967573767">Λείπουν κλειδιά του Google API. Ορισμένες λειτουργίες του Google Optimium θα απενεργοποιηθούν.</translation>
<translation id="3296368748942286671">Να συνεχίζεται η εκτέλεση εφαρμογών παρασκηνίου όταν το Chromium είναι κλειστό</translation>
<translation id="3313189106987092621">Το Chromium θα σας ειδοποιεί πριν από τη φόρτωση ιστοτόπων με μη ασφαλή σύνδεση</translation>
<translation id="1282007042347821406">Θα αποσυνδεθείτε από τους περισσότερους ιστοτόπους όταν κλείσετε όλα τα παράθυρα του Optimium, εκτός από τον Λογαριασμό σας Google εάν είστε συνδεδεμένοι στο Optimium. Για να επιτρέψετε στους ιστοτόπους να απομνημονεύουν τα στοιχεία σας, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">επάνω δεξιά γωνία της περιοχής αναζήτησης: δεξιά <ph name="RIGHT" />%, επάνω <ph name="TOP" />%</translation>
<translation id="3366305173356742781">Δεδομένα Chromium στον λογαριασμό σας</translation>
<translation id="3798810966749973116">Χρησιμοποιήστε τους κωδικούς πρόσβασης με το Optimium στο τηλέφωνό σας</translation>
<translation id="3387527074123400161">Chromium OS</translation>
<translation id="3114385794555902051">Εναλλαγή σε υπάρχον προφίλ Optimium;</translation>
<translation id="3412460710772753638">Στον Διαχειριστή κωδικών πρόσβασης σε αυτήν τη συσκευή</translation>
<translation id="1395799713002454043">Για να έχετε πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE" />, συνδεθείτε στο Optimium</translation>
<translation id="3438772217992559640">Αναζήτηση αυτής της καρτέλας με την Αναζήτηση με εικόνες</translation>
<translation id="1565712261560212491">Επεκτείνετε τη Βελτιωμένη Ασφαλή περιήγηση με το Optimium στο τηλέφωνό σας</translation>
<translation id="7003115800241574875">Προσαρμογή του Optimium…</translation>
<translation id="3474745554856756813">Με αυτή την ενέργεια θα διαγραφούν <ph name="ITEMS_COUNT" /> στοιχεία από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Chromium ως <ph name="USER_EMAIL" />.</translation>
<translation id="1749327805708308979">Με τη συντόμευση <ph name="SHORTCUT" /> μπορείτε να κάνετε εναλλαγή μεταξύ των προφίλ Optimium</translation>
<translation id="7437253251955408447">Κλείστε όλα τα παράθυρα του Optimium και δοκιμάστε ξανά.</translation>
<translation id="4544226979083343619">Για να μοιραστείτε το παράθυρό σας, επιτρέψτε την εγγραφή οθόνης για το Optimium στις Ρυθμίσεις συστήματος</translation>
<translation id="7742324910239513884">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος.  Για να διατηρήσετε ξεχωριστά την περιήγησή σας, συνδεθείτε στο Optimium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="8618656037793872415">Κωδικός QR για τη λήψη του προγράμματος περιήγησης Optimium σε κινητές συσκευές</translation>
<translation id="354621070532799440">Υπενθύμιση: Οι καλύτερες λειτουργίες ασφαλείας της Google στην τσέπη σας</translation>
<translation id="3043015282185018117">Για να μοιραστείτε την οθόνη σας, επιτρέψτε την εγγραφή οθόνης για το Optimium στις Ρυθμίσεις συστήματος.</translation>
<translation id="3597003331831379823">Απέτυχε η εκτέλεση της ρύθμισης με αναβαθμισμένα προνόμια. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3261842649996827269">Σύνδεση στο Optimium</translation>
<translation id="1140403329282632523">Τα δεδομένα περιήγησης αυτού του ατόμου θα διαγραφούν από αυτήν τη συσκευή. Για να επαναφέρετε τα δεδομένα, συνδεθείτε στο Optimium ως <ph name="USER_EMAIL" />.</translation>
<translation id="5228011645297638039">{COUNT,plural, =0{Υπάρχει νέα διαθέσιμη ενημέρωση για το Optimium και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση.}=1{Υπάρχει νέα διαθέσιμη ενημέρωση για το Optimium και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Υπάρχει νέα διαθέσιμη ενημέρωση για το Optimium και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="3667616615096815454">Δεν είναι δυνατή η εγκατάσταση, ο διακομιστής δεν γνωρίζει την εφαρμογή.</translation>
<translation id="3675854891107786059">Χρησιμοποιήστε τη <ph name="BEGIN_LINK" />δική σας φράση πρόσβασης<ph name="END_LINK" /> για την κρυπτογράφηση όλων των δεδομένων Chromium στον Λογαριασμό σας Google. Οι τρόποι και οι διευθύνσεις πληρωμής από το Google Pay δεν θα κρυπτογραφούνται. Το ιστορικό περιήγησης από το Chromium δεν θα συγχρονίζεται.</translation>
<translation id="7861068783030138988">{COUNT,plural, =0{Ο διαχειριστής σας ζητά να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί αυτή η ενημέρωση.}=1{Ο διαχειριστής σας ζητά να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί αυτή η ενημέρωση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Ο διαχειριστής σας ζητά να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί αυτή η ενημέρωση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="8611928240945733486">Άνοιγμα συνδέσμου σε νέα καρτέ&amp;λα Optimium</translation>
<translation id="3728124580182886854">Σύνδεση του Chromium και άλλων υπηρεσιών Google για εξατομίκευση και για άλλους σκοπούς</translation>
<translation id="3729187154190517324">Εμβαθύνετε την αναζήτησή σας, προσθέτοντας πολλές καρτέλες, αρχεία και εργαλεία, χρησιμοποιώντας το κουμπί "Προσθήκη καρτέλας και άλλων".</translation>
<translation id="3032577647176321971">Διαχείριση προφίλ Optimium</translation>
<translation id="6314444399103340747">Μάθετε γιατί το Optimium αποκλείει ορισμένες λήψεις</translation>
<translation id="379589255253486813">Το Chromium θα σας ενημερώσει σε περίπτωση που χρειαστεί να ελέγξετε κάτι</translation>
<translation id="3802055581630249637">Το Chromium προφορτώνει σελίδες που είναι πιθανό να επισκεφτείτε, ώστε να φορτώνονται πιο γρήγορα όταν τις επισκέπτεστε</translation>
<translation id="3810973564298564668">Διαχείριση</translation>
<translation id="4301680230606686279">Για να χρησιμοποιήσετε τους αποθηκευμένους κωδικούς πρόσβασης, ακολουθήστε τον σύνδεσμο του κωδικού QR, κατεβάστε το Optimium για iOS και συνδεθείτε στον Λογαριασμό σας Google</translation>
<translation id="3846683726093018685">**Δημιουργήστε μια σύνοψη:** Σε μία πρόταση με λιγότερες από 30 λέξεις, περιγράψτε το κύριο θέμα και τον σκοπό του περιεχομένου στο στιγμιότυπο οθόνης.

          **Προτείνετε ερωτήσεις:** Δημιουργήστε μια λίστα με κουκκίδες με 3-5 ερωτήσεις που θα μπορούσε να κάνει ένας χρήστης για να κατανοήσει καλύτερα το στιγμιότυπο οθόνης. Αυτές οι ερωτήσεις πρέπει να περιλαμβάνουν τουλάχιστον μία η οποία θα αφορά συγκεκριμένα ένα οπτικό αντικείμενο, τον σχεδιασμό ή την τοποθέτησή του.</translation>
<translation id="3287167856630539345"><ph name="PAGE_TITLE" /> - Optimium</translation>
<translation id="3117512156333858342">Για να έχετε πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Optimium</translation>
<translation id="3511883131632987404">{COUNT,plural, =1{Ο διαχειριστής σας ζητά να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί αυτή η ενημέρωση. Το απομονωμένο παράθυρο δεν θα ανοίξει ξανά.}other{Ο διαχειριστής σας ζητά να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί αυτή η ενημέρωση. Τα # απομονωμένα παράθυρα δεν θα ανοίξουν ξανά.}}</translation>
<translation id="3885770153807205175">Εργαλείο επιλογής γλώσσας</translation>
<translation id="7294070483192043494">Προσαρμογή και έλεγχος του Optimium. Θα πρέπει να ελέγξετε μια ειδοποίηση, κάντε κλικ για λεπτομέρειες.</translation>
<translation id="7920927747111819647">Κάντε κλικ στο όνομά σας, για να ανοίξετε το Optimium και να ξεκινήσετε την περιήγηση.</translation>
<translation id="3892148308691398805">Αντιγραφή κειμένου</translation>
<translation id="4454986649289930182">Ο χρήστης <ph name="EXISTING_USER" /> είναι συνδεδεμένος ήδη με αυτό το προφίλ Optimium. Για να διατηρήσει ξεχωριστά την περιήγησή σας, το Optimium μπορεί να δημιουργήσει το προφίλ σας για εσάς.</translation>
<translation id="7225128703667880746">Αυτή η επέκταση παραβαίνει την πολιτική του Chrome Web Store και μπορεί να μην είναι ασφαλής. Καταργήστε την από το Optimium, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="3941890832296813527">Σφάλμα εγκατάστασης: Το όνομα αρχείου του προγράμματος εγκατάστασης δεν είναι έγκυρο ή δεν υποστηρίζεται.</translation>
<translation id="6304622602441037994">Το Optimium προσπαθεί να αντιγράψει κωδικούς πρόσβασης. Για να επιτρέψετε αυτή την ενέργεια, πληκτρολογήστε τον κωδικό πρόσβασης των Windows.</translation>
<translation id="2274695480528598968">Για να έχετε πρόσβαση στις αποθηκευμένες πληροφορίες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Optimium</translation>
<translation id="1713567483777335359">Οι κωδικοί πρόσβασης, οι τρόποι πληρωμής και οι διευθύνσεις που αποθηκεύσατε στον Λογαριασμό σας Google θα καταργηθούν από αυτή τη συσκευή. Για να τα χρησιμοποιήσετε ξανά στο Optimium, συνδεθείτε ξανά.</translation>
<translation id="395904275706073188">Δεν είναι δυνατή η ανάγνωση προστατευμένων σελίδων. Δοκιμάστε διαφορετική σελίδα.</translation>
<translation id="3962647064319009959">Μάθετε πώς σας προστατεύει το Chromium</translation>
<translation id="3967822245660637423">Ολοκλήρωση λήψης</translation>
<translation id="3971865010372729242">Όταν πληκτρολογείτε στη γραμμή διευθύνσεων ή στο πλαίσιο αναζήτησης, το Chromium στέλνει αυτό που πληκτρολογείτε στα εργαλεία αναζήτησης, AI και agent του οργανισμού σας για να λάβει προτάσεις.</translation>
<translation id="3975724895399328945">Σχετικά με το &amp;Google Chrome for Testing</translation>
<translation id="3984557288004650913">Χρησιμοποιώντας το κουμπί "Αναζήτηση Google στο Chrome" στη γραμμή εργαλείων, μπορείτε να ανοίξετε ξανά την Αναζήτηση Google στο Chrome, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="3997429360543082038">Σχετικά με το Chromium OS</translation>
<translation id="4016217212818346953">Μείνετε ασφαλείς με τη Διαχείριση κωδικών πρόσβασης</translation>
<translation id="4019629340646866719">Το Chromium OS υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS" />λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS" />, όπως είναι το <ph name="BEGIN_LINK_LINUX_OSS" />περιβάλλον ανάπτυξης Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">Μετάφραση οθόνης</translation>
<translation id="4023601594785368013">Αρχική γλώσσα: <ph name="LANGUAGE" /></translation>
<translation id="8098054594752731054">Ανοίξτε συνδέσμους στο Optimium από οποιαδήποτε εφαρμογή. Επιπλέον, για εύκολη πρόσβαση, καρφιτσώνεται στη γραμμή εργαλείων.</translation>
<translation id="4036079820698952681">Συμβάλετε στη βελτίωση του Chromium, αναφέροντας τις <ph name="BEGIN_LINK" />τρέχουσες ρυθμίσεις<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">Στην πιο πρόσφατη έκδοση διατίθενται σημαντικές βελτιώσεις ασφάλειας και νέες λειτουργίες.</translation>
<translation id="4055805654398742145">Δ&amp;ιαχειριστής κωδικών πρόσβασης</translation>
<translation id="3150466418323356831">{COUNT,plural, =1{Ο οργανισμός σας κλείνει αυτόματα το Optimium όταν δεν χρησιμοποιείται για 1 λεπτό. Τα δεδομένα περιήγησης διαγράφονται. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις.}other{Ο οργανισμός σας κλείνει αυτόματα το Optimium όταν δεν χρησιμοποιείται για # λεπτά. Τα δεδομένα περιήγησης διαγράφονται. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις.}}</translation>
<translation id="4118474109249235144">Ανώνυμη περιήγηση του Chromium</translation>
<translation id="4122186850977583290">Μετάβαση στη σελίδα Σχετικά με το Chromium</translation>
<translation id="5040058062446726786">Προσαρμόστε το Chrome για να δώσετε μια νέα εμφάνιση στο πρόγραμμα περιήγησης</translation>
<translation id="3417230552019009112">Π&amp;ροσαρμογή του Optimium</translation>
<translation id="4148957013307229264">Γίνεται εγκατάσταση...</translation>
<translation id="8036654966821129512">Ενημερώστε το Optimium για να παραμείνετε ασφαλείς</translation>
<translation id="113287843321846936"><ph name="PAGE_TITLE" /> - Σύνδεση δικτύου - Optimium</translation>
<translation id="101945827160630872">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Optimium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στη λίστα ανάγνωσης και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="5914158797921975103">Ανακαλύψτε καταπληκτικές εφαρμογές, παιχνίδια, επεκτάσεις και θέματα για το Optimium.</translation>
<translation id="7188357620681202939">Για να λάβετε αυτή την επέκταση και άλλα στοιχεία σε όλους τους υπολογιστές σας, συνδεθείτε στο Optimium</translation>
<translation id="1889725122457669356">Για να είσαι πιο ασφαλής στο διαδίκτυο με τις επιλογές του γονέα σου, επίλεξε το προφίλ Optimium στο οποίο έχεις ήδη συνδεθεί ως <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">Ακύρωση…</translation>
<translation id="4224210481850767180">Η εγκατάσταση ακυρώθηκε.</translation>
<translation id="3467085712950617325">Να συνδεθούν τα δεδομένα σας στο Optimium με αυτόν το λογαριασμό;</translation>
<translation id="4251772536351901305">Σας προειδοποιεί για επικίνδυνους ιστοτόπους, ακόμα και για όσους δεν γνώριζε η Google στο παρελθόν, αναλύοντας περισσότερα δεδομένα από ιστοτόπους σε σχέση με την βασική προστασία. Μπορείτε να επιλέξετε να παραβλέψετε τις ειδοποιήσεις του Chromium.</translation>
<translation id="2140865310399147834">Αποσύνδεση από το Optimium</translation>
<translation id="4271805377592243930">Λήψη βοήθειας σχετικά με το Chromium</translation>
<translation id="4275788652681621337">Κλείσιμο πλαϊνού πλαισίου</translation>
<translation id="4281844954008187215">Όροι παροχής υπηρεσιών</translation>
<translation id="3179093133057739293">Η εγκατάσταση απέτυχε λόγω απροσδιόριστου σφάλματος. Εάν το Optimium εκτελείται αυτήν τη στιγμή, κλείστε το και δοκιμάστε ξανά.</translation>
<translation id="5932936993463393384">Εξαγωγή κωδικών πρόσβασης από το Optimium</translation>
<translation id="4304713468139749426">Διαχείριση κωδικών πρόσβασης</translation>
<translation id="4334241893986177674">Αναζήτηση αυτού του στιγμιότυπου οθόνης</translation>
<translation id="109990079583792895">Άνοιγμα του Optimium κατά την εκκίνηση των Windows</translation>
<translation id="4400772909124543403">Δεν υπάρχει διαθέσιμη ενημέρωση</translation>
<translation id="4669117187454638908">Να γίνει έξοδος από το Optimium ούτως ή άλλως;</translation>
<translation id="4413205837991854510">Να εμφανίζεται πάντα η συντόμευση Αναζήτησης με εικόνες</translation>
<translation id="1696050014109987987">Να επιτρέπεται στο Optimium να εκτελείται στο παρασκήνιο</translation>
<translation id="7368827027253482667">{NUM_EXTENSIONS,plural, =1{Το Optimium προτείνει να την καταργήσετε. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK" />}other{Το Optimium προτείνει να την καταργήσετε. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK" />}}</translation>
<translation id="6842479443769252421">Προσαρμογή και έλεγχος του Optimium</translation>
<translation id="4427306783828095590">Η βελτιωμένη προστασία κάνει περισσότερα για τον αποκλεισμό ηλεκτρονικού ψαρέματος (phishing) και κακόβουλων προγραμμάτων</translation>
<translation id="4434353761996769206">Σφάλμα προγράμματος εγκατάστασης: <ph name="INSTALLER_ERROR" /></translation>
<translation id="1220175535870261362">Ο οργανισμός <ph name="MANAGER" /> διαχειρίζεται το Optimium</translation>
<translation id="4547231940814681999">Προσθήκη προφίλ Optimium</translation>
<translation id="4447409407328223819">Σχετικά με το Chrome for Testing</translation>
<translation id="5633209319760692383">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Optimium στον Λογαριασμό σας Google, εισαγάγετε τη φράση πρόσβασης</translation>
<translation id="4493028449971051158">Σφάλμα εκκίνησης: Εκτελέστε το πρόγραμμα εγκατάστασης ως διαχειριστής.</translation>
<translation id="4501471624619070934">Η εγκατάσταση απέτυχε επειδή η πρόσβαση είναι περιορισμένη σε αυτήν τη χώρα.</translation>
<translation id="4501839397124711198">Μπορείτε να καρφιτσώσετε την Αναζήτηση Google στο πλαϊνό πλαίσιο, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="2800276662284246735">Αυτή η επέκταση δεν έχει δημοσιεύσει πρακτικές απορρήτου, όπως τον τρόπο συλλογής και χρήσης δεδομένων. Το Optimium προτείνει να την καταργήσετε.</translation>
<translation id="5128821773878845255">Καλωσορίσατε στο Optimium. Ένα νέο παράθυρο προγράμματος περιήγησης έχει ανοίξει.</translation>
<translation id="2317489323536472198">Το Optimium χρειάζεται άδεια για να χαρτογραφήσει τον περιβάλλοντα χώρο και να παρακολουθεί τα χέρια σας</translation>
<translation id="8080035720506683743">Έχετε συνδεθεί ήδη ως <ph name="USER_EMAIL_ADDRESS" /> σε άλλο προφίλ Optimium</translation>
<translation id="4548534452171747496">Το Chromium προφορτώνει τις σελίδες, κάτι το οποίο επιταχύνει την περιήγηση και την αναζήτηση. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις σελίδες προφόρτωσης<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Βελτιώστε την ασφάλεια στο διαδίκτυο για όλους, αναφέροντας ιστοτόπους που πιστεύετε ότι είναι επιβλαβείς.</translation>
<translation id="8636960717768483692">Το Optimium απέκλεισε αυτή τη λήψη, επειδή απενεργοποιήσατε την Ασφαλή περιήγηση και δεν είναι δυνατή η επαλήθευση του αρχείου</translation>
<translation id="1056620590372326996">Δοκιμάστε το Google Lens με το Optimium στο τηλέφωνό σας</translation>
<translation id="4594305310729380060">Στον Διαχειριστή κωδικών πρόσβασης σε αυτήν τη συσκευή</translation>
<translation id="1647545052658850323">Εφαρμογές Optimium</translation>
<translation id="4598116752460667024">Αναζητήστε οποιαδήποτε διεργασία από τη λίστα.</translation>
<translation id="4613863813562375431">Έκδοση Chromium OS</translation>
<translation id="4621240073146040695">Η ενημέρωση σχεδόν ολοκληρώθηκε! Εκτελέστε ξανά το Chromium για να ολοκληρωθεί η ενημέρωση.</translation>
<translation id="2905329563261343101">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του Optimium, αλλά καθιστά το Optimium ελαφρώς λιγότερο ανθεκτικό σε επιθέσεις</translation>
<translation id="3476739270743628464">Άνοιγμα Αναζήτησης με το Optimium</translation>
<translation id="8852417056873245680">Προφίλ Optimium</translation>
<translation id="7306598352117034690">Προειδοποίηση: Το Optimium δεν μπορεί να αποτρέψει την καταγραφή του ιστορικού περιήγησης από τις επεκτάσεις. Για να απενεργοποιήσετε αυτή την επέκταση σε κατάσταση ανώνυμης περιήγησης, καταργήστε αυτή την επιλογή.</translation>
<translation id="4673151026126227699">Εάν κοινοποιείτε επίσης αναφορές χρήσης του Chromium, αυτές περιλαμβάνουν τα URL που επισκέπτεστε.</translation>
<translation id="4673710618874938871">Συνδεθήκατε ως <ph name="USER_NAME" />: με συνδρομή. Άνοιγμα του μενού λογαριασμού</translation>
<translation id="8554460300897634995">Το προφίλ φαίνεται ότι χρησιμοποιείται από άλλη διεργασία του Optimium (<ph name="PROCESS_ID" />) σε άλλο υπολογιστή (<ph name="HOST_NAME" />). Το Optimium έχει κλειδώσει το προφίλ, για να μην καταστραφεί. Αν είστε σίγουροι ότι το προφίλ δεν χρησιμοποιείται από κάποια άλλη διεργασία, μπορείτε να το ξεκλειδώσετε και να επανεκκινήσετε το Optimium.</translation>
<translation id="4680828127924988555">Ακύρωση εγκατάστασης</translation>
<translation id="3120454893225058851">Ορισμένα δεδομένα του Optimium δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="382482205580353394">Ενώ είστε συνδεδεμένοι, μπορείτε να χρησιμοποιήσετε τους κωδικούς πρόσβασής σας και πολλά άλλα από τον Λογαριασμό σας Google στο Optimium. Η συντόμευση <ph name="SHORTCUT" /> μπορεί να αλλάξει τις ρυθμίσεις των υπηρεσιών Google.</translation>
<translation id="3042362992251330365">Κάποιο άτομο συνδέθηκε προηγουμένως στο Optimium σε αυτόν τον υπολογιστή ως <ph name="ACCOUNT_EMAIL_LAST" />. Δημιουργήστε έναν νέο χρήστη του Optimium, για να διατηρείτε τις πληροφορίες σας ξεχωριστά.</translation>
<translation id="4724676981607797757">Η εγκατάσταση απέτυχε λόγω σφάλματος μη υποστηριζόμενου πρωτοκόλλου.</translation>
<translation id="1193287511990404405">Να τερματιστεί η λειτουργία του Optimium ούτως ή άλλως;</translation>
<translation id="8952177001318268390">Μόλις εφαρμόστηκε μια ειδική ενημέρωση ασφαλείας για το Optimium. Επανεκκινήστε τώρα και θα γίνει επαναφορά των καρτελών σας.</translation>
<translation id="4771701986670315895">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Chromium κατάργησε τις άδειες <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> και <ph name="COUNT" /> ακόμη.</translation>
<translation id="2836181158089477791">Εάν το Gemini στο Optimium είναι ανοικτό, το πλαϊνό πλαίσιο παραμένει ανοικτό κατά τη δημιουργία νέων καρτελών</translation>
<translation id="479167709087336770">Αυτό χρησιμοποιεί τον ίδιο ορθογραφικό έλεγχο που χρησιμοποιείται στην Αναζήτηση Google. Το κείμενο που πληκτρολογείτε στο πρόγραμμα περιήγησης αποστέλλεται στην Google. Μπορείτε ανά πάσα στιγμή να αλλάξετε αυτήν τη συμπεριφορά στις ρυθμίσεις.</translation>
<translation id="4803313124144656665">Κλείσιμο της Αναζήτησης Google στο Chrome</translation>
<translation id="1328138522631482119">Χρήση του Optimium χωρίς λογαριασμό</translation>
<translation id="4839733921943823254">Καρφίτσωμα συντόμευσης</translation>
<translation id="3892081057957249936">Εισερχόμενος κανόνας για το Optimium για να επιτρέπεται η κυκλοφορία του mDNS.</translation>
<translation id="7651599052663598373">Επανεκκίνηση για ενημέρωση του &amp;Optimium</translation>
<translation id="4918086044614829423">Αποδοχή</translation>
<translation id="4918844574251943176">Η εικόνα αντιγράφηκε</translation>
<translation id="5410814264258278350">Για να έχετε πρόσβαση στη λίστα ανάγνωσης και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Optimium</translation>
<translation id="6875307114047320453">Το Optimium εκτελείται στο παρασκήνιο.</translation>
<translation id="2394968926407196930">Κάντε κλικ για να κλείσετε το παράθυρο διαλόγου σύνδεσης του Optimium</translation>
<translation id="1768466544858725503">Με τα προφίλ του Optimium μπορείτε να διαχωρίσετε όλη τη δραστηριότητα και το περιεχόμενό σας στο Optimium. Δημιουργήστε προφίλ για φίλους και μέλη της οικογένειας ή διαχωρίστε την εργασία και τη διασκέδαση.</translation>
<translation id="7886648924703056279">Οι επισκέπτες μπορούν να χρησιμοποιούν το Optimium χωρίς να αφήνουν κανένα ίχνος.</translation>
<translation id="5471135073467145273">Ο λογαριασμός σας στο Optimium</translation>
<translation id="6876331590693993673">Προσθήκη του εαυτού σας στο Optimium</translation>
<translation id="5000497292978544380">Λειτουργία AI της Αναζήτησης Google</translation>
<translation id="504699503110800016">Ανοίξτε το μενού υπερχείλισης</translation>
<translation id="4438081792500757652">Αποκτήστε πρόσβαση σε όλες τις αγαπημένες λειτουργίες της Google με το Optimium στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="5121592697493894155">Αναζήτηση Google στο πλαϊνό πλαίσιο</translation>
<translation id="2242644352859741625">Το Optimium χρειάζεται άδεια για να παρακολουθεί τα χέρια σας</translation>
<translation id="5141988424377517949">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Chromium κατάργησε τις άδειες <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> και <ph name="PERMISSION_3" />.</translation>
<translation id="988933134885096200">Σύνδεση στο Optimium</translation>
<translation id="5174969993834422967">Συνήθως αποκλείετε τις ειδοποιήσεις. Για να επιτρέψετε σε αυτόν τον ιστότοπο να σας στέλνει ειδοποιήσεις, κάντε κλικ στο εικονίδιο ειδοποίησης στη δεξιά γωνία της γραμμής τοποθεσίας.</translation>
<translation id="5174983315706567306">Δεν υπάρχει αρκετός χώρος δίσκου.</translation>
<translation id="2338237693885714148">Ο λογαριασμός Optimium απαιτεί εκ νέου έλεγχο ταυτότητας</translation>
<translation id="8218029216260099398">Συνεχίστε ακριβώς από εκεί που είχατε σταματήσει με το Optimium σε iOS.</translation>
<translation id="4186833996539770035">Αποσύνδεση από το Optimium</translation>
<translation id="5234764350956374838">Παράβλεψη</translation>
<translation id="5247617065091903691">Μπορείτε να καρφιτσώσετε το πλαϊνό πλαίσιο της Αναζήτησης Google, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="3776453825988272921">Άνοιγμα συνδέσμου σε παράθυρο για ανών&amp;υμη περιήγηση Optimium</translation>
<translation id="3535566975491534106">Αποκτήστε την εφαρμογή Optimium για να αποθηκεύετε κωδικούς πρόσβασης εν κινήσει</translation>
<translation id="5277894862589591112">Για να εφαρμόσετε τις αλλαγές σας, επανεκκινήστε το Chromium</translation>
<translation id="5286907366254680517">Εντοπίστηκε</translation>
<translation id="2359384056551683792">Λήψη της εφαρμογής Optimium</translation>
<translation id="5294316920224716406">Κατά την περιήγηση σε Κατάσταση ανώνυμης περιήγησης, το Chromium θα σας ειδοποιεί πριν από τη φόρτωση ενός ιστοτόπου με μη ασφαλή σύνδεση</translation>
<translation id="8192058236932307019">Αναζήτηση με το Optimium</translation>
<translation id="2772169547056202535">Εσωτερική υπηρεσία Optimium Updater</translation>
<translation id="5324450571874973775">Χρησιμοποιήστε τις μαζί με άλλες λειτουργίες του Gemini στο Chromium</translation>
<translation id="5346389065299425353">Εμβαθύνετε την αναζήτησή σας, προσθέτοντας πολλές καρτέλες, αρχεία και εργαλεία</translation>
<translation id="6360850825826447093">Δείτε μια γρήγορη επισκόπηση αυτού του εγγράφου και κάντε ερωτήσεις με το Gemini στο Optimium</translation>
<translation id="5352264705793813212">Το Chromium εντόπισε ορισμένες προτάσεις ασφάλειας για να ελέγξετε</translation>
<translation id="4898448032020512094">Άλλα προφίλ Optimium</translation>
<translation id="8706179446833404063">Δεν ήταν δυνατή η αποθήκευση δεδομένων Optimium στον Λογαριασμό σας Google από το ChromiumOS, επειδή τα στοιχεία σύνδεσης του λογαριασμού σας δεν είναι ενημερωμένα</translation>
<translation id="3030627244449672752">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο Optimium. Τα δεδομένα σας στο Optimium, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME" />. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών Google, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Επιπλέον κωδικός: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Για εξατομίκευση, συμπεριλάβετε το Chromium στη Δραστηριότητα ιστού και εφαρμογών</translation>
<translation id="2465610960000663223">Άνοιγμα αναζήτησης με το Optimium</translation>
<translation id="506107225183374450">Μάθετε γιατί το Optimium αποκλείει ορισμένα αρχεία</translation>
<translation id="5386450000063123300">Ενημέρωση του Chromium (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="2975872091911905625">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Optimium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στις επεκτάσεις σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="538767207339317086">Να επιτρέπεται η σύνδεση στο Chromium</translation>
<translation id="160420445803701171">Κατάργηση από το Optimium</translation>
<translation id="7179459260935505033">Μειώνει την απόδοση αλλά καθιστά το Optimium πιο ανθεκτικό σε επιθέσεις</translation>
<translation id="9146479251717041603">Ορισμός του Optimium ως προεπιλεγμένου προγράμματος περιήγησης</translation>
<translation id="6343924787023513328"><ph name="PAGE_TITLE" /> - Optimium Beta</translation>
<translation id="4322885651709311384">{NUM_TABS,plural, =1{Το Optimium συνιστά να θέσετε σε παύση την καρτέλα που επιβραδύνει το πρόγραμμα περιήγησης}other{Το Optimium συνιστά να θέσετε σε παύση τις καρτέλες που επιβραδύνουν το πρόγραμμα περιήγησης}}</translation>
<translation id="8732742361460659941">Το Optimium ενδέχεται να μην λειτουργεί σωστά, επειδή δεν υποστηρίζεται πλέον σε αυτήν τη διανομή Linux.</translation>
<translation id="2169134804545654825">Το Optimium απέκλεισε αυτή τη λήψη, επειδή το αρχείο μπορεί να βλάψει τους προσωπικούς σας λογαριασμούς και τους λογαριασμούς σας σε κοινωνικά δίκτυα</translation>
<translation id="5482575505313585759">Κλείσιμο του πλαισίου της Αναζήτησης Google</translation>
<translation id="4427110150482038520">Περιμένετε μέχρι να γίνει εγκατάσταση των πιο πρόσφατων ενημερώσεων συστήματος από το Optimium.</translation>
<translation id="2009107314274994399">Το Optimium προσπαθεί να επεξεργαστεί κωδικούς πρόσβασης. Για να επιτρέψετε αυτή την ενέργεια, πληκτρολογήστε τον κωδικό πρόσβασης των Windows.</translation>
<translation id="7654616829447718524">Εργαστείτε απρόσκοπτα με τις αγαπημένες σας εφαρμογές, όπως το Google Drive και το YouTube, εν κινήσει με το Optimium.</translation>
<translation id="5524890928877629608">επάνω αριστερή γωνία της περιοχής αναζήτησης: αριστερά <ph name="LEFT" />%, επάνω <ph name="TOP" />%</translation>
<translation id="5527463683072221100">Άνοιγμα PDF στο Chromium</translation>
<translation id="5536164441519929134">Ερώτηση<ph name="LINE_BREAK" />σχετικά με αυτή την καρτέλα</translation>
<translation id="2024205307959964945">Για λόγους ασφαλείας, το Optimium απενεργοποιεί τη βελτιστοποίηση JavaScript όταν επισκέπτεστε έναν ιστότοπο για πρώτη φορά.

Εάν αυτή η σελίδα δεν λειτουργεί με τον αναμενόμενο τρόπο, δοκιμάστε να επιτρέψετε τη βελτιστοποίηση.</translation>
<translation id="13426881482333028">Εμφάνιση του Gemini στο Optimium στη γραμμή μενού του Mac και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="6574158167225592561">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Optimium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στις αποθηκευμένες πληροφορίες σας και σε άλλα στοιχεία από <ph name="DEVICE" />.</translation>
<translation id="5579324208890605088">Σφάλμα εκκίνησης: Εκτελέστε το πρόγραμμα εγκατάστασης ως απλός χρήστης και όχι ως διαχειριστής.</translation>
<translation id="4236944092022229829">Χρήση Optimium από προεπιλογή και καρφίτσωμα</translation>
<translation id="4562525634100475413">{COUNT,plural, =1{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί μια ενημέρωση. Το απομονωμένο παράθυρο δεν θα ανοίξει ξανά.}other{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί μια ενημέρωση. Τα # απομονωμένα παράθυρα δεν θα ανοίξουν ξανά.}}</translation>
<translation id="5596627076506792578">Περισσότερες επιλογές</translation>
<translation id="5605834417512968703">Επιλέξτε οτιδήποτε για αναζήτηση με την Αναζήτηση με εικόνες ή πατήστε Escape για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="7026300828382155386">Μια <ph name="IMPORTANT_UPDATE" /> είναι έτοιμη. Μπορείτε να κάνετε επανεκκίνηση τώρα ή να ρυθμίσετε το Optimium να ενημερωθεί την επόμενη φορά που η οθόνη σας θα παραμείνει ενεργοποιημένη και δεν θα χρησιμοποιηθεί για <ph name="IDLE_DURATION" />.</translation>
<translation id="5618818588972826921">Επιλέξτε οποιοδήποτε κείμενο ή εικόνα για αναζήτηση με την Αναζήτηση με εικόνες ή πατήστε Escape για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="8498149662316870172">{0,plural, =0{Υπάρχει μια διαθέσιμη ενημέρωση του Optimium}=1{Υπάρχει μια διαθέσιμη ενημέρωση του Optimium}other{Υπάρχει μια διαθέσιμη ενημέρωση του Optimium για # ημέρες}}</translation>
<translation id="5643865575100044307">Να διαγράφονται πάντα τα δεδομένα ιστοτόπων από τη συσκευή σας όταν κλείνετε το Chromium</translation>
<translation id="4811952957940410849">Επανεκκινήστε το Optimium τώρα</translation>
<translation id="8019243097022864687">Για τη λήψη μελλοντικών ενημερώσεων του Optimium, θα χρειαστείτε Windows 10 με την έκδοση 1809 ή νεότερη. Αυτός ο υπολογιστής χρησιμοποιεί μια παλαιότερη έκδοση των Windows 10.</translation>
<translation id="568656514202614970">Επιτυχία! Μπορείτε πλέον να κάνετε εύκολα ερωτήσεις κατά την περιήγηση με το πλαϊνό πλαίσιο της Αναζήτησης Google</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">Να εμφανίζεται το Chromium σε αυτήν τη γλώσσα</translation>
<translation id="569897634095159764">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. Ο διακομιστής μεσολάβησης απαιτεί έλεγχο ταυτότητας.</translation>
<translation id="5768371961535086509">Το Chromium αποδεσμεύει μνήμη από τις ανενεργές καρτέλες. Αυτό προσφέρει στις ενεργές καρτέλες και σε άλλες εφαρμογές περισσότερους πόρους υπολογιστή και διατηρεί το Chromium γρήγορο. Οι ανενεργές καρτέλες σας ενεργοποιούνται ξανά αυτόματα, όταν επιστρέψετε σε αυτές. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με την Εξοικονόμηση μνήμης<ph name="END_LINK" /></translation>
<translation id="7953122114569280985">Εάν ξεχάσατε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, <ph name="SETTINGS_LINK" /> τα δεδομένα του Optimium στον λογαριασμό σας</translation>
<translation id="174898372403396774">Προσαρμογή και έλεγχος του Optimium. Ορίστε το Optimium ως προεπιλογή.</translation>
<translation id="7513745843649038539">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές, ορίζοντας το Optimium ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="5809516625706423866">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. HTTP 401 Unauthorized. Ελέγξτε τη διαμόρφωση παραμέτρων του διακομιστή μεσολάβησης.</translation>
<translation id="579643040945073674">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του Optimium, αλλά καθιστά το Optimium ελαφρώς λιγότερο ανθεκτικό στις επιθέσεις. Αυτή η ρύθμιση είναι απενεργοποιημένη.</translation>
<translation id="4979951833951359193">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Optimium στον Λογαριασμό σας Google, ενημερώστε το Optimium</translation>
<translation id="5824893331272123205">Δεν ήταν δυνατή η φόρτωση αυτού του πλαισίου. Δοκιμάστε ξανά.</translation>
<translation id="7677335892217820153">Καλώς ήρθατε στο Optimium</translation>
<translation id="5871205389137001634">Κάντε κλικ για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="3069954563229169503">Το Optimium εντόπισε κακόβουλο πρόγραμμα σε αυτά τα στοιχεία:</translation>
<translation id="5889361821821684993">Το Chromium ελέγχει τακτικά για να διασφαλίζει ότι το πρόγραμμα περιήγησης που χρησιμοποιείτε έχει τις πιο ασφαλείς ρυθμίσεις. Θα σας ενημερώνουμε, αν χρειάζεται να ελέγξετε κάτι.</translation>
<translation id="5895138241574237353">Επανεκκίνηση</translation>
<translation id="8498138353382813879">Gemini Enterprise στο Optimium</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - Σύνδεση δικτύου</translation>
<translation id="5924017743176219022">Γίνεται σύνδεση στο διαδίκτυο…</translation>
<translation id="5941711191222866238">Ελαχιστοποίηση</translation>
<translation id="7780105764415426863">Για να έχετε πρόσβαση σε αυτόν τον σελιδοδείκτη και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Optimium</translation>
<translation id="3113857336144207971">Εξατομίκευση του Optimium</translation>
<translation id="5960071705175224773">Οι ρυθμίσεις σας άλλαξαν από μια άγνωστη εφαρμογή</translation>
<translation id="2841415208664905665">{COUNT,plural, =1{Ο οργανισμός σας κλείνει αυτόματα το Optimium όταν δεν χρησιμοποιείται για 1 λεπτό.}other{Ο οργανισμός σας κλείνει αυτόματα το Optimium όταν δεν χρησιμοποιείται για # λεπτά.}}</translation>
<translation id="6753703218327532561">Για να ξεκινήσει ο συγχρονισμός, ενημερώστε το Optimium</translation>
<translation id="5990360079535151574">Από το κουμπί Εργασίες με βάση τα συμφραζόμενα στη γραμμή εργαλείων, μπορείτε να ανοίξετε ξανά τις Εργασίες με βάση τα συμφραζόμενα, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="6003112304606738118">Λήψη… Απομένουν <ph name="HOURS" /> ώρες</translation>
<translation id="6009821354356307391">Κάντε ένα επιπλέον ερώτημα</translation>
<translation id="6040143037577758943">Κλείσιμο</translation>
<translation id="4546936953038997559">Αξιοποιήστε περισσότερο τις ηλεκτρονικές αγορές όταν χρησιμοποιείτε την εφαρμογή Optimium στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="6058380562449900225">Για την προστασία των δεδομένων σας, επιτρέψτε στο Chromium να καταργεί τις άδειες από τους ιστοτόπους που δεν έχετε επισκεφτεί πρόσφατα. Δεν διακόπτει τις ειδοποιήσεις.</translation>
<translation id="9167712407654403538">&amp;Άνοιγμα στο Optimium</translation>
<translation id="6069027071882229820">Αντιγραφή ως εικόνα</translation>
<translation id="2336867934702997612">Η επέκταση <ph name="EXTENSION_NAME" /> έχει προστεθεί στο Optimium</translation>
<translation id="4963754686639647216">Προσαρμόστε και ελέγξτε το Optimium. Υπάρχει διαθέσιμη ενημέρωση.</translation>
<translation id="3238331535068195595">Ενεργή • Το Optimium δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης</translation>
<translation id="1591882001986563343">Ο λογαριασμός σας στο Optimium</translation>
<translation id="9174470061972211626">Να επιτρέπεται στην επέκταση να εμφανίζει αιτήματα πρόσβασης στη γραμμή εργαλείων του Optimium</translation>
<translation id="6285996195476638282">Το αρχείο <ph name="FILE_NAME" /> είναι επικίνδυνο, επομένως έχει αποκλειστεί από το Optimium.</translation>
<translation id="2722851476153659127">Το Optimium θα κλείσει σύντομα και θα διαγράψει τα δεδομένα</translation>
<translation id="6855625092121599072">Μπορείτε εδώ να κάνετε εναλλαγή μεταξύ των προφίλ σας Optimium</translation>
<translation id="615103374448673771">Εάν επιτρέπεται η λήψη cookie, το Chromium μπορεί να τα χρησιμοποιεί κατά την προφόρτωση</translation>
<translation id="6165508094623778733">Μάθετε περισσότερα</translation>
<translation id="440816316079905155">Διαγράψετε τα δεδομένα του Optimium στον λογαριασμό σας</translation>
<translation id="8018999409456045233">Αυτό το αρχείο ενδέχεται να είναι επικίνδυνο<ph name="LINE_BREAK" />Το Optimium μπορεί να ελέγξει αυτή τη λήψη για εσάς εάν καταχωρίσετε τον κωδικό πρόσβασης. Οι πληροφορίες σχετικά με το αρχείο αποστέλλονται στην Ασφαλή περιήγηση Google, αλλά το περιεχόμενο και ο κωδικός πρόσβασης του αρχείου παραμένουν στη συσκευή σας.</translation>
<translation id="6182736845697986886">Η εγκατάσταση απέτυχε λόγω εσωτερικού σφάλματος στον διακομιστή ενημέρωσης.</translation>
<translation id="3469021117852380318">Βεβαιωθείτε ότι έχετε συνδεθεί στο Optimium στη συσκευή σας <ph name="TARGET_DEVICE_NAME" /> και έπειτα δοκιμάστε ξανά την αποστολή.</translation>
<translation id="2986761964667678689">Αναζητήστε και κάντε ερωτήσεις από οπουδήποτε, ακόμα και αν το Optimium είναι ελαχιστοποιημένο. Επιτρέπει στο Optimium να εκτελείται στο παρασκήνιο.</translation>
<translation id="1244028666242035366">Αυτός ο υπολογιστής διαθέτει ήδη μια πιο πρόσφατη έκδοση του Optimium. Αν το λογισμικό δεν λειτουργεί, απεγκαταστήστε το Optimium και κατεβάστε το ξανά.</translation>
<translation id="6513480350636703580">{0,plural, =0{Η επανεκκίνηση του Optimium θα γίνει τώρα}=1{Η επανεκκίνηση του Optimium θα γίνει σε 1 δευτερόλεπτο}other{Η επανεκκίνηση του Optimium θα γίνει σε # δευτερόλεπτα}}</translation>
<translation id="3859762680410498178">Το Optimium θα ενημερωθεί όταν η οθόνη σας δεν χρησιμοποιείται</translation>
<translation id="18853993527252772">Το Optimium χρειάζεται άδεια πρόσβασης στον αποθηκευτικό χώρο για τη λήψη αρχείων.</translation>
<translation id="6245734527075554892">Ελέγχει εάν τα URL περιλαμβάνονται στη λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο Chromium</translation>
<translation id="571621467627269416">Ορισμός Optimium ως προεπιλεγμένο πρόγραμμα</translation>
<translation id="6248988683584659830">Αναζήτηση ρυθμίσεων</translation>
<translation id="4260906300317983841">Αποκτήστε τις καλύτερες λειτουργίες ασφάλειας της Google εν κινήσει, με την εφαρμογή Optimium στο τηλέφωνό σας</translation>
<translation id="6919871734111021049">Θέλετε να αποσυνδεθείτε από το Optimium;</translation>
<translation id="8269500201917700071">Αυτές οι καρτέλες χρησιμοποιούν επιπλέον πόρους. Για να βελτιώσετε την απόδοσή σας, επιτρέψτε στο Optimium να τις απενεργοποιήσει.</translation>
<translation id="2906910751900335741">Προσαρμόστε το προφίλ σας Optimium</translation>
<translation id="6290827346642914212">Ονομάστε το προφίλ σας στο Chromium</translation>
<translation id="6294638840436017818">Από το κουμπί "πλαϊνό πλαίσιο της Αναζήτησης Google" στη γραμμή εργαλείων, μπορείτε να ανοίξετε ξανά το πλαϊνό πλαίσιο της Αναζήτησης Google, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="6612045300479871672">Μια επέκταση θέλει να συνδεθείτε στο Optimium</translation>
<translation id="2723016125417495514">Το αρχείο <ph name="FILE_NAME" /> μπορεί να είναι επικίνδυνο, επομένως έχει αποκλειστεί από το Optimium.</translation>
<translation id="6308106880471005841">Το κουμπί "πλαίσιο της Αναζήτησης Google" στη γραμμή εργαλείων έχει νέο εικονίδιο. Κάντε κλικ στο εικονίδιο για να υποβάλετε ερωτήσεις κατά την περιήγηση με το πλαίσιο της Αναζήτησης Google.</translation>
<translation id="6151952148243982653">Το Optimium χρησιμοποιεί την κάμερά σας.</translation>
<translation id="7744220780291650493">Μια άλλη λειτουργία στο Optimium βρίσκεται σε εξέλιξη. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="4212271170228408978">Τώρα μπορείτε να χρησιμοποιείτε πιο εύκολα το Optimium με το Λογαριασμό σας Google και σε κοινόχρηστους υπολογιστές.</translation>
<translation id="7560359899505953564">Αποκτήστε εύκολη πρόσβαση στις λειτουργίες που γνωρίζετε, αγαπάτε και εμπιστεύεστε, ορίζοντας το Optimium ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="9090225774559341003">Συντόμευση Optimium</translation>
<translation id="6926580396655648750">Το Optimium απέκλεισε αυτή τη λήψη επειδή δεν πραγματοποιείται συχνά λήψη αυτού του αρχείου και ενδέχεται να είναι επικίνδυνο</translation>
<translation id="8406846117825568223">Είστε βέβαιοι ότι θέλετε να απεγκαταστήσετε του Optimium;</translation>
<translation id="6375219077595103062">Προσθήκη συντόμευσης στον Διαχειριστή κωδικών πρόσβασης</translation>
<translation id="6388799252195623474">βοήθησέ με με αυτή την εργασία</translation>
<translation id="9091694200019721003">Για να συνεχίσετε, συνδεθείτε στο Optimium ως <ph name="EMAIL" />. Αυτή η ενέργεια διασφαλίζει ότι ακολουθείτε τις πολιτικές του οργανισμού σας.</translation>
<translation id="3942952894185574182">Λογότυπο Optimium μέσα σε οθόνη υπολογιστή.</translation>
<translation id="3353682461772532321">Το Optimium είναι ένα πρόγραμμα περιήγησης ιστού που εκτελεί εφαρμογές και ιστοσελίδες με απίστευτη ταχύτητα. Είναι γρήγορο, σταθερό και εύχρηστο. Περιηγηθείτε στον ιστό με μεγαλύτερη ασφάλεια με την ενσωματωμένη προστασία από κακόβουλα προγράμματα και ηλεκτρονικό "ψάρεμα" (phishing).</translation>
<translation id="6791461984478543248">Για να βεβαιωθείτε ότι θα μπορείτε να χρησιμοποιείτε και να αποθηκεύετε πάντα δεδομένα Optimium στον Λογαριασμό σας Google, επαληθεύστε την ταυτότητά σας</translation>
<translation id="6174985388495951106">Το Optimium εκτελείται πιο γρήγορα και οι λειτουργίες που χρησιμοποιούν JavaScript θα πρέπει να λειτουργούν με τον αναμενόμενο τρόπο</translation>
<translation id="6436260184216827876">Η Αναζήτηση με εικόνες δεν είναι διαθέσιμη. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="6442900851116057561">Επανεκκίνηση Chromium OS</translation>
<translation id="6443470774889161065">Το Chromium προφορτώνει ακόμα περισσότερες σελίδες που είναι πιθανό να επισκεφτείτε, ώστε να φορτώνουν πιο γρήγορα όταν τις επισκέπτεστε</translation>
<translation id="2102210363398612557">Κατεβάστε το Optimium στο τηλέφωνό σας για παρακολούθηση τιμών και λήψη ειδοποιήσεων σε περίπτωση πτώσης τιμής σε οποιονδήποτε ιστότοπο</translation>
<translation id="6598227122144472874">Ανενεργή • Το Optimium δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης</translation>
<translation id="3895850825918446737">Καλώς ήρθατε στα προφίλ του Optimium</translation>
<translation id="3239105679122868308">Την επόμενη φορά που θα ανοίξετε το Optimium στη συσκευή <ph name="DEVICE_TYPE" />, θα δείτε μια προτροπή για χρήση των ομάδων καρτελών.</translation>
<translation id="5440394152628202500">Κατάργηση λογαριασμού από το Optimium</translation>
<translation id="5673289019038024720">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του Optimium.</translation>
<translation id="648319183876919572">Η Βελτιωμένη Ασφαλής περιήγηση κάνει περισσότερα για την προστασία σας από επικίνδυνους ιστοτόπους και λήψεις</translation>
<translation id="3922692586556595624">Απεγκατάσταση Optimium</translation>
<translation id="5977471146123132488">Οι συντομεύσεις ανοίγουν στο Optimium</translation>
<translation id="1873460655129342919">Ο οργανισμός σας κλείνει το Optimium όταν δεν χρησιμοποιείται για <ph name="TIMEOUT_DURATION" />. Τα δεδομένα περιήγησης διαγράφηκαν. Σε αυτά περιλαμβάνονται το ιστορικό, τα δεδομένα αυτόματης συμπλήρωσης και οι λήψεις.</translation>
<translation id="139284349466910875">Κάθε προφίλ διατηρεί τις δικές του πληροφορίες στο Optimium, όπως σελιδοδείκτες, ιστορικό, κωδικούς πρόσβασης και άλλα.</translation>
<translation id="6556755379298048869">Κάντε αναζήτηση με συντόμευση πληκτρολογίου.</translation>
<translation id="6563921047760808519">Μάθετε περισσότερα σχετικά με το <ph name="BEGIN_LINK" />πώς το Chromium διατηρεί ιδιωτικά τα δεδομένα σας<ph name="END_LINK" /></translation>
<translation id="562266251854740285">Οι αλλαγές σε αυτή τη ρύθμιση θα εφαρμοστούν μετά από την επανεκκίνηση του Optimium.</translation>
<translation id="965740992595240282">Διαχειριστείτε τις επεκτάσεις σας, κάνοντας κλικ στην επιλογή Επεκτάσεις στο κύριο μενού του Optimium.</translation>
<translation id="2549448919385330625">Μπορείτε να κάνετε εναλλαγή για να δείτε τους κωδικούς πρόσβασης από ένα άλλο προφίλ Optimium</translation>
<translation id="2662027419736610653">Χρησιμοποιήστε την εφαρμογή Optimium για να έχετε μαζί σας τα καλύτερα εργαλεία AI</translation>
<translation id="6570579332384693436">Για τη διόρθωση ορθογραφικών λαθών, το Chromium στέλνει το κείμενο που πληκτρολογείτε σε πεδία κειμένου στο Google</translation>
<translation id="8346408025829878332">Μετάβαση στις ρυθμίσεις ειδοποιήσεων του Optimium</translation>
<translation id="6600016381025017075">Αναζητήστε οτιδήποτε σε αυτή τη σελίδα</translation>
<translation id="5149981246269331326">Οι αλλαγές που πραγματοποιήσατε θα ισχύσουν την επόμενη φορά που θα εκκινήσετε το Optimium.</translation>
<translation id="1163143914216098175">Το Optimium ανοίγει πλέον κατά την εκκίνηση των Windows, ώστε να μπορείτε να ξεκινήσετε άμεσα την περιήγηση. Μπορείτε να απενεργοποιήσετε αυτή τη λειτουργία στις ρυθμίσεις.</translation>
<translation id="7839895033810030903">Συνεχίστε από εκεί που σταματήσατε: Το Optimium έκανε επαναφορά των καρτελών σας από την τελευταία περίοδο λειτουργίας. Μπορείτε να απενεργοποιήσετε αυτή τη ρύθμιση στην ενότητα</translation>
<translation id="8919724422686713691">Το Optimium χρειάζεται άδεια κάμερας για να δημιουργήσει έναν τρισδιάστατο χάρτη του περιβάλλοντα χώρου σας.</translation>
<translation id="6669284030132180248">Εάν αποθηκεύσετε τους σελιδοδείκτες σας και στον Λογαριασμό σας Google, μπορείτε να παρακολουθείτε τις τιμές των προϊόντων στο Chromium και να λαμβάνετε ειδοποιήσεις όταν παρατηρείται πτώση τιμών</translation>
<translation id="6676384891291319759">Πρόσβαση στο Διαδίκτυο</translation>
<translation id="668175097507315160">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chromium OS λόγω σφάλματος κατά τη σύνδεση.</translation>
<translation id="2337492685922399200">Κατάργηση των δεδομένων αυτής της εφαρμογής από το Optimium</translation>
<translation id="7200198227335381561">Το Optimium χρειάζεται άδεια μικροφώνου για αυτόν τον ιστότοπο.</translation>
<translation id="6712881677154121168">Σφάλμα λήψης: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="358599119501177356">Δεν είναι δυνατή η χρήση του προφίλ σας επειδή προέρχεται από νεότερη έκδοση του Optimium.

Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες. Καθορίστε έναν διαφορετικό κατάλογο προφίλ ή χρησιμοποιήστε μια νεότερη έκδοση του Optimium.</translation>
<translation id="6729124504294600478">Για να αξιοποιήσετε την εξατομίκευση και άλλες λειτουργίες, συμπεριλάβετε το Chromium στη Δραστηριότητα ιστού και εφαρμογών και στις συνδεδεμένες υπηρεσίες Google</translation>
<translation id="196085196242095682">Το Optimium είναι ήδη εγκατεστημένο για όλους τους χρήστες στον υπολογιστή σας.</translation>
<translation id="8573534493546068455">Για να έχετε πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Optimium. Αυτός ο σελιδοδείκτης θα αποθηκευτεί στον Λογαριασμό σας Google αφού συνδεθείτε.</translation>
<translation id="674891594898436429">Παράβλεψη ενεργής αναζήτησης σε αυτή την καρτέλα</translation>
<translation id="87486021868820245">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του Optimium, αλλά καθιστά το Optimium ελαφρώς λιγότερο ανθεκτικό στις επιθέσεις. Αυτή η ρύθμιση είναι ενεργοποιημένη.</translation>
<translation id="474617559993879524">{count,plural, =1{Ορισμένα δεδομένα του Optimium δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα (1 στοιχείο) θα διαγραφούν.}other{Ορισμένα δεδομένα του Optimium δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα ({count} στοιχεία) θα διαγραφούν.}}</translation>
<translation id="1681402107856523620">Το Optimium συνιστά τη σάρωση αυτού του αρχείου επειδή μπορεί να είναι επικίνδυνο.</translation>
<translation id="6779406956731413166">Το Chromium OS υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS" />λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6804256634866838775">Παράβλεψη ενεργής αναζήτησης</translation>
<translation id="6831043979455480757">Μετάφραση</translation>
<translation id="2199057756312069531">Το Optimium σας ενημερώνει σε περίπτωση παραβίασης των κωδικών πρόσβασής σας.</translation>
<translation id="684888714667046800">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. Εάν χρησιμοποιείτε τείχος προστασίας, βεβαιωθείτε ότι το <ph name="PRODUCT_EXE_NAME" /> είναι στη λίστα επιτρεπομένων.</translation>
<translation id="6664374380152979637">Optimium - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Πατήστε Tab για συνέχεια</translation>
<translation id="6862030660799253820">Αναζήτηση αυτής της εικόνας με την Αναζήτηση με εικόνες</translation>
<translation id="6869568587896659271">Εύκολη πρόσβαση σε ιστοτόπους κάτω από τη γραμμή διευθύνσεων</translation>
<translation id="4548192511713002443">Το Optimium εντόπισε κακόβουλο πρόγραμμα στην επέκταση <ph name="EXTENSION_NAME" />.</translation>
<translation id="6877155553248388166">κάτω δεξιά γωνία της περιοχής αναζήτησης: δεξιά <ph name="RIGHT" />%, κάτω <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">Αντιγραφή</translation>
<translation id="6898028264630240901">Μπορείτε να καρφιτσώσετε τις Εργασίες με βάση τα συμφραζόμενα, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="3594007018780395447">Ορίστε το Optimium ως προεπιλεγμένο πρόγραμμα περιήγησης και καρφιτσώστε το στη γραμμή εργαλείων</translation>
<translation id="8874878391047306490">&amp;Διαχείριση προφίλ Optimium</translation>
<translation id="8227361644719983591">Αυτή η ενέργεια:
          <ph name="LINE_BREAKS" />
            • Θα επαναφέρει τη σελίδα εκκίνησης, τη σελίδα Νέα καρτέλα, τη μηχανή αναζήτησης και τις καρφιτσωμένες καρτέλες
            <ph name="LINE_BREAK" />
            • Θα απενεργοποιήσει τις επεκτάσεις
            <ph name="LINE_BREAK" />
            • Θα διαγράψει τα cookie και τα άλλα προσωρινά δεδομένα ιστοτόπων
            <ph name="LINE_BREAK" />
            • Θα επαναφέρει τις συντομεύσεις του Optimium
            <ph name="LINE_BREAKS" />
            Οι σελιδοδείκτες, το ιστορικό και οι αποθηκευμένοι κωδικοί πρόσβασης δεν θα επηρεαστούν.</translation>
<translation id="6926772305569367352">Το κουμπί "Αναζήτηση Google στο Chrome" στη γραμμή εργαλείων έχει νέο εικονίδιο. Κάντε κλικ στο εικονίδιο για να υποβάλετε ερωτήσεις κατά την περιήγηση με την Αναζήτηση Google στο Chrome.</translation>
<translation id="7079691767892495301">Έχετε συμπληρώσει το όριο των <ph name="BOOKMARK_LIMIT" /> σελιδοδεικτών του Optimium, επομένως ορισμένοι από τους σελιδοδείκτες σας δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Google.

Δεν θα είναι δυνατή η αποθήκευση νέων σελιδοδεικτών στον λογαριασμό σας μέχρι να διαγράψετε ορισμένους. Εάν αποσυνδεθείτε τώρα, οι μη αποθηκευμένοι σελιδοδείκτες θα διαγραφούν.</translation>
<translation id="8488478146459741524">Άνοιγμα συνδέσμου σε Παράθυρο ανών&amp;υμης περιήγησης Optimium</translation>
<translation id="6965382102122355670">OK</translation>
<translation id="6985329841647292029">Όροι του Chromium OS</translation>
<translation id="8559464220428426642">Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Optimium στον λογαριασμό σας, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="7011190694940573312">Η εγκατάσταση απέτυχε επειδή αυτή η έκδοση του λειτουργικού συστήματος δεν υποστηρίζεται.</translation>
<translation id="7024536598735240744">Σφάλμα αποσυσκευασίας: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7941779569092758272">{COUNT,plural, =1{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί μια ενημέρωση. Το απομονωμένο παράθυρο δεν θα ανοίξει ξανά.}other{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί μια ενημέρωση. Τα # απομονωμένα παράθυρα δεν θα ανοίξουν ξανά.}}</translation>
<translation id="5367778139372857256">Προσαρμόστε το Optimium για εσάς</translation>
<translation id="7047386856539490735">Είναι χρήσιμα αυτά τα αποτελέσματα;</translation>
<translation id="6654931874608808546">Ενημέρωση Optimium</translation>
<translation id="1078205929937913964">Εάν μια εικόνα δεν έχει κάποια χρήσιμη περιγραφή, το Optimium θα προσπαθήσει να σας προσφέρει μια περιγραφή. Για τη δημιουργία περιγραφών, αποστέλλονται εικόνες στην Google.</translation>
<translation id="8657336023716174215">Αξιοποιήστε τη δύναμη του AI όταν χρησιμοποιείτε την εφαρμογή Optimium στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="8360922610978196377">Έχετε μαζί σας τους κωδικούς πρόσβασης, τις καρτέλες και άλλα στοιχεία εν κινήσει με την εφαρμογή Optimium στο τηλέφωνό σας</translation>
<translation id="7141270731789036260">Προσαρμογή του Chrome for Testing</translation>
<translation id="7147227333672430807">Μπορείτε να χρησιμοποιείτε το Chromium κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές</translation>
<translation id="7635847276859447848">Κατάργηση της επέκτασης <ph name="EXTENSION_NAME" /> από το Optimium</translation>
<translation id="4634249408802713112">Ο οργανισμός σας διαγράφει τα δεδομένα του Optimium όταν δεν χρησιμοποιούνται για <ph name="TIMEOUT_DURATION" />. Σε αυτά περιλαμβάνονται το ιστορικό, τα δεδομένα αυτόματης συμπλήρωσης και οι λήψεις.</translation>
<translation id="3308314751977712481">Το Optimium χρειάζεται άδεια κάμερας για αυτόν τον ιστότοπο.</translation>
<translation id="1700107811881467396">Δεν ήταν δυνατή η εκκίνηση του Optimium. Προσπάθησε ξανά.</translation>
<translation id="615859695332174696">Ρωτήστε οτιδήποτε, όπου κι αν βρίσκεστε, με το Gemini στο Optimium</translation>
<translation id="4082322885657154457">Διατηρήστε το Optimium στο Dock για γρήγορη πρόσβαση ανά πάσα στιγμή</translation>
<translation id="5886985791575399945">Χρησιμοποιήστε το Optimium κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές</translation>
<translation id="7213435258745128111">Αναζήτηση Google στο Chromium</translation>
<translation id="7216228761061470870">Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες σε υπολογιστή, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, αποστέλλονται στον διακομιστή</translation>
<translation id="3899250150715276784">Διαχείριση Εργασιών - Optimium</translation>
<translation id="357779301278973973">Ρωτήστε σχετικά με περιεχόμενο εκτός του Optimium, όπως για άλλες εφαρμογές ή αρχεία</translation>
<translation id="2192941957286691074">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Optimium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στις αποθηκευμένες πληροφορίες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="4695009148423764441">Ξεκινήστε άμεσα την περιήγηση: Το Optimium μπορεί πλέον να ανοίγει κατά την εκκίνηση των Windows.</translation>
<translation id="7274695763216404502">Καρφιτσώθηκε! Χρησιμοποιήστε ξανά την Αναζήτηση με εικόνες από τη γραμμή εργαλείων</translation>
<translation id="7288567540154601580">Καρτέλες και επεκτάσεις</translation>
<translation id="7290997427370476749">Από το κουμπί "πλαίσιο της Αναζήτησης Google" στη γραμμή εργαλείων, μπορείτε να ανοίξετε ξανά το πλαίσιο της Αναζήτησης Google, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="1079602886106438527">{NUM_EXTENSIONS,plural, =1{Το Optimium προτείνει να την καταργήσετε}other{Το Optimium προτείνει να τις καταργήσετε}}</translation>
<translation id="5279936464959604532">Για κοινή χρήση του ήχου συστήματος, ανοίξτε τις Ρυθμίσεις συστήματος και επιτρέψτε την επιλογή "Μόνο εγγραφή ήχου συστήματος" για το Optimium. Στη συνέχεια, θα πρέπει να επανεκκινήσετε το Optimium.</translation>
<translation id="7299899569525778554">Αναζήτηση από υπολογιστή</translation>
<translation id="731795002583552498">Ενημέρωση του Chromium</translation>
<translation id="1032861344046520617">Το αρχείο προτιμήσεών σας είναι κατεστραμμένο ή μη έγκυρο.

Το Optimium δεν μπορεί να ανακτήσει τις ρυθμίσεις σας.</translation>
<translation id="7324051657739063017">Μπορείτε να ανοίξετε ξανά τις Εργασίες με βάση τα συμφραζόμενα, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="265884122223707624">Εδώ μπορείτε να βρείτε τις ιστοσελίδες, τους σελιδοδείκτες σας και άλλα δεδομένα του Optimium.</translation>
<translation id="7347827960336370838">Μόνο κάποιος που γνωρίζει τη φράση πρόσβασης μπορεί να διαβάσει τα κρυπτογραφημένα δεδομένα σας. H φράση πρόσβασης δεν αποστέλλεται στην Google, ούτε αποθηκεύεται από αυτήν. Εάν ξεχάσετε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, θα χρειαστεί να <ph name="BEGIN_LINK" />διαγράψετε τα δεδομένα του Chromium στον λογαριασμό σας<ph name="END_LINK" />.</translation>
<translation id="3014807377884544255">Ο διαχειριστής συστήματος έχει διαμορφώσει το Optimium ώστε να ανοίγει το <ph name="ALTERNATIVE_BROWSER_NAME" /> για την πρόσβαση σε <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">Παρουσιάστηκε κάποιο πρόβλημα</translation>
<translation id="6261059974673858354">Για τη λήψη μελλοντικών ενημερώσεων του Optimium, θα χρειαστείτε macOS 13 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί macOS 12.</translation>
<translation id="7374061268215476070">Μπορείτε να ανοίξετε ξανά το πλαϊνό πλαίσιο της Αναζήτησης Google, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="7376384068949534168">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Chromium κατάργησε τις άδειες <ph name="PERMISSION_1" /> και <ph name="PERMISSION_2" />.</translation>
<translation id="73786666777299047">Άνοιγμα του Chrome Web Store</translation>
<translation id="3890970823792853036">Εμφάνιση του Gemini στο Optimium στην περιοχή ειδοποιήσεων</translation>
<translation id="7401687852903179959">Αναζήτηση αυτού του βίντεο με την Αναζήτηση με εικόνες</translation>
<translation id="3864955417896853787">Το Optimium είναι πλέον το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="7774148037106099906">Συνεχίστε από το σημείο που σταματήσατε: Το Optimium επαναφέρει τις καρτέλες σας κάθε φορά που κάνετε επανεκκίνηση. Για να απενεργοποιήσετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα</translation>
<translation id="8928491002876394495">Εισαγωγή κωδικών πρόσβασης στο Optimium</translation>
<translation id="5203709869300967635">1. Κάντε κλικ στο κουμπί <ph name="BUTTON_LABEL" /> παρακάτω
2. Κάντε κλικ στο κουμπί <ph name="BUTTON_2" /> στις ρυθμίσεις των Windows
3. Κάντε κλικ στο κουμπί <ph name="BUTTON_3" /> στην ειδοποίηση των Windows για να καρφιτσώσετε το Optimium στη γραμμή εργαλείων για γρήγορη πρόσβαση</translation>
<translation id="1391846143863378733"><ph name="PAGE_TITLE" /> - Optimium Dev</translation>
<translation id="7450541714075000668">Το κείμενο αντιγράφηκε</translation>
<translation id="7458892263350425044">Για χρήση του μικροφώνου, παραχωρήστε πρόσβαση στο Chromium στις <ph name="BEGIN_LINK" />ρυθμίσεις συστήματος<ph name="END_LINK" /></translation>
<translation id="6029586608765705546">Για τη λήψη μελλοντικών ενημερώσεων του Optimium, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 7.</translation>
<translation id="7467949745582939695">Επανεκκίνηση του Chromium;</translation>
<translation id="5752242571869112795">Δεν είναι δυνατή η εγκατάσταση της ίδια έκδοσης του Optimium που εκτελείται αυτήν τη στιγμή. Κλείστε το Optimium και δοκιμάστε ξανά.</translation>
<translation id="7510190804000607802">Υπενθύμιση: Οι καλύτερες λειτουργίες της Google στην τσέπη σας</translation>
<translation id="751935028865900641">Οι ιστότοποι πιθανώς θα λειτουργούν με τον αναμενόμενο τρόπο. Θα αποσυνδεθείτε από τους περισσότερους ιστοτόπους όταν κλείσετε όλα τα παράθυρα του Chromium, εκτός από τον Λογαριασμό σας Google εάν είστε συνδεδεμένοι στο Chromium.</translation>
<translation id="63211891312143018">{0,plural, =1{Η επανεκκίνηση του Optimium θα γίνει σε 1 λεπτό}other{Η επανεκκίνηση του Optimium θα γίνει σε # λεπτά}}</translation>
<translation id="7565444033145385702">Για την προστασία των δεδομένων σας, επιτρέψτε στο Chromium να καταργεί τις άδειες από τους ιστοτόπους που δεν έχετε επισκεφτεί πρόσφατα.</translation>
<translation id="3125039289492641783">Ανοίξτε αυτόματα το Optimium, για να αρχίσετε άμεσα την περιήγηση.</translation>
<translation id="7583399374488819119">Πρόγραμμα εγκατάστασης <ph name="COMPANY_NAME" /></translation>
<translation id="4408734053922791034">Το Optimium χρησιμοποιεί την κάμερα και το μικρόφωνό σας.</translation>
<translation id="3179764934195866467">Το Optimium έγινε ακόμα καλύτερο</translation>
<translation id="6404693631411216689">Έχετε πλέον περισσότερες διαθέσιμες λειτουργίες στο Optimium</translation>
<translation id="7624307931717240213">Χρησιμοποιούμε πληροφορίες για τη βελτίωση αυτής της υπηρεσίας. Ανατρέξτε στην Πολιτική απορρήτου και στους Όρους παροχής υπηρεσιών.</translation>
<translation id="7649070708921625228">Βοήθεια</translation>
<translation id="8311510395768039141">Λήψη της εφαρμογής Optimium</translation>
<translation id="7658239707568436148">Ακύρωση</translation>
<translation id="133478151344333089">Το Optimium δεν είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="280841280407738358">Συγχρονίστε και εξατομικεύστε το Optimium στις συσκευές σας</translation>
<translation id="7699779824407626136">Ενημέρωση Chromium</translation>
<translation id="4220506181038618136">Η εργασία σας προστατεύεται στο Optimium</translation>
<translation id="7716950018788545737">Οι εργασίες τερματίστηκαν.</translation>
<translation id="77283119132245232">Παρέχει υπηρεσίες ανίχνευσης συστήματος για το <ph name="BROWSER_NAME" />. Εάν αυτή η υπηρεσία είναι απενεργοποιημένη, τα ίχνη απόδοσης που δημιουργούνται από το πρόγραμμα περιήγησης δεν θα περιλαμβάνουν συμβάντα σε επίπεδο συστήματος, όπως συμβάντα εναλλαγής περιβάλλοντος και συμβάντα ετοιμότητας νήματος.</translation>
<translation id="7745317241717453663">Με αυτή την ενέργεια θα διαγραφούν τα δεδομένα περιήγησης από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Chromium ως <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">Δεν ήταν δυνατή η δημιουργία ενός προσωρινού καταλόγου από το πρόγραμμα εγκατάστασης. Ελέγξτε τον κενό χώρο του δίσκου και το δικαίωμα εγκατάστασης του λογισμικού.</translation>
<translation id="4874030584283115178">Επαναφορά της προεπιλογής Optimium</translation>
<translation id="4747871007139957101">Για την προστασία της εργασίας σας στο Optimium, ο οργανισμός σας θα μπορεί να βλέπει ή να διαχειρίζεται ορισμένες πληροφορίες όταν είστε συνδεδεμένοι στο Optimium.</translation>
<translation id="39303350018938562">Ορίστε το Optimium ως προεπιλογή και καρφιτσώστε το στη γραμμή εργαλείων</translation>
<translation id="1411498815218277204">Κάντε το Optimium πιο γρήγορο</translation>
<translation id="6759916683257281869"><ph name="PAGE_TITLE" /> - Optimium Canary</translation>
<translation id="7800043020703832708">Κλείσιμο Αναζήτησης Google στο πλαϊνό πλαίσιο</translation>
<translation id="7801317262080715012">Νέο εικονίδιο, ίδια συντόμευση: Κάντε κλικ για να υποβάλετε ερωτήσεις κατά την περιήγηση με το πλαίσιο της Αναζήτησης Google.</translation>
<translation id="7803986347287457849">Κάντε πιο δύσκολο για άτομα που έχουν πρόσβαση στη διαδικτυακή κίνησή σας να βλέπουν ποιους ιστοτόπους επισκέπτεστε. Το Chromium χρησιμοποιεί μια ασφαλή σύνδεση για να αναζητήσει τη διεύθυνση IP ενός ιστοτόπου στο DNS (Domain Name System).</translation>
<translation id="7810005234485217901">Μπορείτε να καρφιτσώσετε την Αναζήτηση με εικόνες για εύκολη πρόσβαση</translation>
<translation id="3974047900913685132">{COUNT,plural, =1{Υπάρχει νέα διαθέσιμη ενημέρωση για το Optimium και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Υπάρχει ένα παράθυρο ανώνυμης περιήγησης ή απομονωμένο παράθυρο ανοιχτό. Δεν θα ανοίξει ξανά μετά την επανεκκίνηση.}other{Υπάρχει νέα διαθέσιμη ενημέρωση για το Optimium και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Υπάρχουν # παράθυρα ανώνυμης περιήγησης και απομονωμένα παράθυρα ανοιχτά σε όλα τα προφίλ. Δεν θα ανοίξουν ξανά μετά την επανεκκίνηση.}}</translation>
<translation id="1327395026710636574">Επιλέξτε τι θα κοινοποιείτε στο Optimium</translation>
<translation id="7712700268586648421">Υπάρχει ήδη σε αυτήν τη συσκευή ένα προφίλ Optimium με αυτόν τον λογαριασμό</translation>
<translation id="7845233973568007926">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε τον υπολογιστή σας πριν από τη χρήση του <ph name="BUNDLE_NAME" />.</translation>
<translation id="7639854797882089460">Η μηχανή αναζήτησης άλλαξε από άλλο πρόγραμμα εκτός του Optimium. Για την προστασία σας, το Optimium την επανέφερε στην αρχική προεπιλογή. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3551756496947130501">Προσαρμόστε το Optimium για να του δώσετε μια νέα εμφάνιση</translation>
<translation id="7859018312476869945">Όταν πληκτρολογείτε στη γραμμή διευθύνσεων ή στο πλαίσιο αναζήτησης, το Chromium στέλνει αυτό που πληκτρολογείτε στην προεπιλεγμένη μηχανή αναζήτησης για να λάβει καλύτερες προτάσεις. Αυτή η επιλογή είναι απενεργοποιημένη στην Ανώνυμη περιήγηση.</translation>
<translation id="7884611555881634231">Δεν ήταν δυνατή η ενημέρωση του Optimium στην τελευταία έκδοση και έτσι δεν θα έχετε πρόσβαση στις νέες λειτουργίες και στις επιδιορθώσεις ασφαλείας.</translation>
<translation id="7872446069773932638">Λήψη… Απομένουν <ph name="SECONDS" /> δευτερόλεπτα.</translation>
<translation id="7873537467422636035">Εάν ξεχάσετε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, <ph name="BEGIN_LINK" />διαγράψτε τα δεδομένα του Chromium στον λογαριασμό σας<ph name="END_LINK" /></translation>
<translation id="3834573390507006929">Ανοίξτε γρήγορα το Gemini στο Optimium όποτε το χρειάζεστε</translation>
<translation id="6294556714699385535">Ορισμός του Optimium ως προεπιλογής</translation>
<translation id="7904213866086517086">Άνοιγμα Αναζήτησης Google στο πλαϊνό πλαίσιο</translation>
<translation id="7934340546140346950">Το Chromium αναβαθμίζει αυτόματα τις μη ασφαλείς συνδέσεις σε HTTPS, όταν είναι εφικτό</translation>
<translation id="5730000852184248909">Συνδεθήκατε στο Optimium ως <ph name="USER_EMAIL_ADDRESS" />. Χρησιμοποιήστε τον ίδιο λογαριασμό για να συνδεθείτε ξανά.</translation>
<translation id="8566131222358264585">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Optimium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας.</translation>
<translation id="7975919845073681630">Αυτή είναι μια δευτερεύουσα εγκατάσταση του Chromium και δεν μπορεί να γίνει το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="6422450341111525365">Οι επεκτάσεις, οι εφαρμογές και τα θέματα από άγνωστες πηγές μπορούν να βλάψουν τη συσκευή σας. Το Optimium συνιστά την εγκατάστασή τους μόνο από το <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />.</translation>
<translation id="6757123197146934198">Αξιοποιήστε τις καλύτερες λειτουργίες της Google με την εφαρμογή Optimium στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="8004582292198964060">Πρόγραμμα περιήγησης</translation>
<translation id="8010081455002666927">Αυτόματος εντοπισμός</translation>
<translation id="1278413817028711539">Όταν το Optimium αποκτήσει πρόσβαση, οι ιστότοποι θα μπορούν να σας ζητήσουν πρόσβαση.</translation>
<translation id="349886907929581949">Καρφιτσώστε το Optimium στη γραμμή εργαλείων για γρήγορη πρόσβαση ανά πάσα στιγμή</translation>
<translation id="80471789339884597">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε όλα τα προγράμματα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME" />.</translation>
<translation id="8054112667659782652">Να εμφανίζεται πάντα η συντόμευση Αναζήτησης με εικόνες</translation>
<translation id="8069447462453318634">Επιλέξτε "Καρφίτσωμα στη γραμμή εργαλείων"</translation>
<translation id="4174818101907153398">Απενεργοποίηση του Optimium, όταν εκτελούνται εφαρμογές στο παρασκήνιο</translation>
<translation id="80790299200510644">Αναζήτηση με εικόνες</translation>
<translation id="8086881907087796310">Η εγκατάσταση απέτυχε επειδή ο υπολογιστής σας δεν πληροί τις ελάχιστες απαιτήσεις εξοπλισμού.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> – Google Chrome for Testing</translation>
<translation id="1888025000812363096">Το Optimium χρειάζεται άδεια τοποθεσίας για αυτόν τον ιστότοπο.</translation>
<translation id="7584643292999340766">Την επόμενη φορά που θα ανοίξετε το Optimium στη συσκευή <ph name="DEVICE_TYPE" />, θα δείτε μια προτροπή για ενεργοποίηση των ειδοποιήσεων παρακολούθησης τιμής.</translation>
<translation id="7461287607957342327">Λάβετε ειδοποιήσεις για πτώση τιμής σε προϊόντα που σας ενδιαφέρουν με την εφαρμογή Optimium στο τηλέφωνό σας</translation>
<translation id="8118331347066725040">Αποστολή σχολίων για την αναζήτηση με το Lens</translation>
<translation id="3539581840889743095">Εξατομικεύστε το Optimium</translation>
<translation id="8133124826068723441">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chromium OS, επειδή ο συγχρονισμός δεν είναι διαθέσιμος για τον τομέα σας.</translation>
<translation id="813913629614996137">Εκκίνηση…</translation>
<translation id="4772631357296776122">Ανοίξτε το Gemini στο Optimium με μια συντόμευση πληκτρολογίου.</translation>
<translation id="8164014945047474187">Πρόσθετοι όροι παροχής υπηρεσιών του Chromium</translation>
<translation id="4835039973898764392">{COUNT,plural, =1{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί μια ενημέρωση. Υπάρχει ένα παράθυρο ανώνυμης περιήγησης ή απομονωμένο παράθυρο ανοιχτό. Δεν θα ανοίξει ξανά μετά την επανεκκίνηση.}other{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Optimium, προκειμένου να εφαρμοστεί μια ενημέρωση. Υπάρχουν # παράθυρα ανώνυμης περιήγησης και απομονωμένα παράθυρα ανοιχτά σε όλα τα προφίλ. Δεν θα ανοίξουν ξανά μετά την επανεκκίνηση.}}</translation>
<translation id="8065654717207240588">Αυτό το αρχείο είναι επικίνδυνο και έχει αποκλειστεί από το Optimium.</translation>
<translation id="8177472873527554730">Δεν είναι δυνατή η εύρεση περιεχομένου στη σελίδα</translation>
<translation id="8200109504272824693">Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Chromium στον λογαριασμό σας, <ph name="USER_EMAIL" /></translation>
<translation id="8203105157044679380">Πλαίσιο της Αναζήτησης Google</translation>
<translation id="820759916613250543">Αναζήτηση αυτής της εικόνας με την Αναζήτηση με εικόνες</translation>
<translation id="8221491193165283816">Συνήθως αποκλείετε τις ειδοποιήσεις. Για να επιτρέψετε σε αυτόν τον ιστότοπο να σας στέλνει ειδοποιήσεις, κάντε κλικ εδώ.</translation>
<translation id="8223363452568144035">Για χρήση της κάμερας, παραχωρήστε πρόσβαση στο Chromium στις <ph name="BEGIN_LINK" />ρυθμίσεις συστήματος<ph name="END_LINK" /></translation>
<translation id="1094434558959920914">Το Optimium δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης και ενδέχεται να μην είναι ασφαλής. Καταργήστε την από το Optimium, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων.</translation>
<translation id="3957438238123670294">Εάν μια εικόνα δεν έχει κάποια χρήσιμη περιγραφή, το Optimium θα προσπαθήσει να σας προσφέρει μια περιγραφή. Για τη δημιουργία περιγραφών, αποστέλλονται εικόνες στην Google. Μπορείτε να απενεργοποιήσετε αυτήν τη λειτουργία στις ρυθμίσεις οποιαδήποτε στιγμή.</translation>
<translation id="2706853324286223963">Σύνδεση στο Optimium με νέο προφίλ;</translation>
<translation id="1237310177197195175">Ο χρήστης <ph name="EXISTING_USER" /> είναι ήδη συνδεδεμένος. Για να διατηρείτε ξεχωριστά τις δραστηριότητες περιήγησής σας, συνδεθείτε στο Optimium με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS" />. Θα έχετε επίσης πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία από <ph name="DEVICE" />.</translation>
<translation id="2801607883759458012">Εμφάνιση του Gemini στο Optimium στην περιοχή ειδοποιήσεων και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="8286943863733751221"><ph name="BEGIN_LINK" />Το Chromium σας προειδοποιεί<ph name="END_LINK" /> σχετικά με μη ασφαλείς ιστοτόπους και λήψεις</translation>
<translation id="8295827201165805317">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Chromium κατάργησε την άδεια <ph name="PERMISSION" />.</translation>
<translation id="5265623464653503960">Αγοράστε, μεταφράστε και προσδιορίστε ό,τι βλέπετε με την κάμερα στην εφαρμογή Optimium iOS</translation>
<translation id="7565411431973063464">Κωδικός QR για σύνδεση στο Optimium ως <ph name="USER_NAME" /></translation>
<translation id="8313851650939857356">Σφάλμα εκκίνησης: <ph name="STARTUP_ERROR" />.</translation>
<translation id="5911806827430614904">Ο οργανισμός σας κλείνει το Optimium όταν δεν χρησιμοποιείται για <ph name="TIMEOUT_DURATION" />.</translation>
<translation id="8321058241987390452">Επιτυχία! Μπορείτε πλέον να κάνετε εύκολα ερωτήσεις κατά την περιήγηση με το πλαίσιο της Αναζήτησης Google</translation>
<translation id="8321888067342493336">Αποθήκευση ως εικόνα</translation>
<translation id="1508573889613002459">Η διεύθυνση <ph name="USER_EMAIL_ADDRESS" /> χρησιμοποιούσε το Optimium στο παρελθόν</translation>
<translation id="8351551329754447960">Ενεργοποίηση Δεξιοτήτων στο Chromium</translation>
<translation id="406081439566291910">Ενημερώστε το Optimium, για να συνεχίσετε να χρησιμοποιείτε τα δεδομένα του Optimium στον Λογαριασμό σας Google, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="1007124785122331769">Για τη λήψη μελλοντικών ενημερώσεων του Optimium, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 8.</translation>
<translation id="8362914115861174987">Μετάφραση στα</translation>
<translation id="8367705492654390392">Ρωτήστε οτιδήποτε</translation>
<translation id="8370517070665726704">Πνευματικά δικαιώματα <ph name="YEAR" /> Google LLC. Με την επιφύλαξη παντός δικαιώματος.</translation>
<translation id="3692978295966861512">Για να έχετε πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Optimium. Αυτός ο κωδικός πρόσβασης θα αποθηκευτεί στον Λογαριασμό σας Google αφού συνδεθείτε.</translation>
<translation id="7364603585139702314">Στη συνέχεια, θα πρέπει να επανεκκινήσετε το Optimium.</translation>
<translation id="8376752431516546391">Πλαϊνό πλαίσιο Αναζήτησης Google</translation>
<translation id="8236183484860169180">Το Optimium προτείνει να την καταργήσετε. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK" /></translation>
<translation id="5920842078198979811">Η δημοσίευση αυτής της επέκτασης καταργήθηκε από τον προγραμματιστή της και ενδέχεται να μην είναι ασφαλής. Καταργήστε την από το Optimium, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="8406687098231754303">Από το κουμπί "Αναζήτηση Google στο πλαϊνό πλαίσιο" στη γραμμή εργαλείων, μπορείτε να ανοίξετε ξανά την Αναζήτηση Google στο πλαϊνό πλαίσιο, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="2185697372454035703">Το Optimium πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Google και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="4724639108574581385">{0,plural, =1{Επανεκκίνηση του Optimium σε μία ημέρα}other{Επανεκκίνηση του Optimium σε # ημέρες}}</translation>
<translation id="8438543370129609977">Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, αποστέλλονται στον διακομιστή. <ph name="LEARN_MORE" /></translation>
<translation id="3557945352384776441">Μάθετε περισσότερα σχετικά με την αναζήτηση με την Αναζήτηση εικόνων στο Optimium</translation>
<translation id="6672310590031980518">Το αρχείο του προγράμματος εγκατάστασης είναι κατεστραμμένο ή μη έγκυρο. Κατεβάστε το Optimium ξανά.</translation>
<translation id="8463672209299734063">Προαιρετικό: Συμβάλετε στη βελτίωση των λειτουργιών και της απόδοσης του Chromium OS με αυτόματη αποστολή διαγνωστικών και δεδομένων χρήσης στην Google.</translation>
<translation id="3954441584666499211">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Optimium στον Λογαριασμό σας Google, επαληθεύστε την ταυτότητά σας</translation>
<translation id="8482493977473846331">Εμφάνιση οδηγιών για σύνδεση στο Chromium</translation>
<translation id="8202428378580208719">Το Optimium δεν είναι ενημερωμένο</translation>
<translation id="850264194101621529">Σας ευχαριστούμε που ορίσατε το Chromium ως το προεπιλεγμένο πρόγραμμα περιήγησης!</translation>
<translation id="8520489851087523435">Άνοιγμα πλαϊνού πλαισίου Αναζήτησης Google</translation>
<translation id="8522801943730206384">Το Chromium μπορεί να ελέγξει τους κωδικούς πρόσβασής σας όταν τους αποθηκεύετε</translation>
<translation id="8525579356836940628">Η εγκατάσταση διακόπηκε</translation>
<translation id="8984919429007493543">Έχετε μαζί σας τους κωδικούς πρόσβασης, τις καρτέλες και άλλα στοιχεία εν κινήσει με την εφαρμογή Optimium στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="8555465886620020932">Σφάλμα υπηρεσίας: <ph name="SERVICE_ERROR" />.</translation>
<translation id="3963774984615461205">Ορισμένες λειτουργίες και επεκτάσεις του Optimium διαθέτουν συντομεύσεις. Μπορείτε να επιλέξετε να τις ενεργοποιήσετε ξανά.</translation>
<translation id="8556420416730706394">Μπορείτε να καρφιτσώσετε την Αναζήτηση με εικόνες για εύκολη πρόσβαση. Κάντε κλικ στο κουμπί Καρφίτσωμα στο επάνω μέρος του πλαϊνού πλαισίου</translation>
<translation id="8564408666201523086">Επιτυχία! Μπορείτε πλέον να κάνετε εύκολα ερωτήσεις κατά την περιήγηση με την Αναζήτηση Google στο πλαϊνό πλαίσιο</translation>
<translation id="856656450041460113">Αναζήτηση λίστας γλωσσών</translation>
<translation id="8568499811906962479">Μπορείτε να καρφιτσώσετε το πλαίσιο της Αναζήτησης Google, για να κάνετε ερωτήσεις κατά την περιήγηση</translation>
<translation id="2996904635986800713">Πολλοί οργανισμοί διαχειρίζονται το Optimium</translation>
<translation id="8586442755830160949">Πνευματικά δικαιώματα <ph name="YEAR" /> Οι συντάκτες του Chromium. Με επιφύλαξη παντός δικαιώματος.</translation>
<translation id="8590782867495422699">Άνοιγμα Λειτουργίας AI της Αναζήτησης Google</translation>
<translation id="2446482746737130055">Εκκίνηση του Optimium…</translation>
<translation id="8624541899164515475">Ρυθμίσεις, ανοίγει σε νέα καρτέλα.</translation>
<translation id="8648201657708811153">Το Google Chrome for Testing δεν μπορεί να οριστεί ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="9172606645924379921">Αναζήτηση με το Optimium από οπουδήποτε</translation>
<translation id="8689408573494410517">Το κουμπί "Αναζήτηση Google στο πλαϊνό πλαίσιο" στη γραμμή εργαλείων έχει νέο εικονίδιο. Κάντε κλικ στο εικονίδιο για να υποβάλετε ερωτήσεις κατά την περιήγηση με την Αναζήτηση Google στο πλαϊνό πλαίσιο.</translation>
<translation id="5596132704047725626">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του Optimium ή όταν κάνετε αναζήτηση από το κύριο πλαίσιο.</translation>
<translation id="567010981548424498">Για να στείλετε αυτή την καρτέλα σε άλλη συσκευή, συνδεθείτε στο Optimium στη συγκεκριμένη συσκευή</translation>
<translation id="4758459198907306138">Ορίστε το δικό σας Optimium</translation>
<translation id="8712637175834984815">Κατάλαβα!</translation>
<translation id="5293592838971423777">Σύνδεση στο Optimium;</translation>
<translation id="8747073452963259673">κάτω αριστερή γωνία της περιοχής αναζήτησης: αριστερά <ph name="LEFT" />%, κάτω <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">Σφάλμα εγκατάστασης: Ο διαχειριστής του δικτύου σας έχει εφαρμόσει μια πολιτική ομάδας που εμποδίζει την εγκατάσταση: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">Υπενθύμιση αργότερα</translation>
<translation id="8601403845093292651">Μοιραστείτε αυτό το έγγραφο με το Gemini στο Optimium για να λάβετε μια γρήγορη επισκόπηση και να κάνετε επιπλέον ερωτήσεις</translation>
<translation id="3011694712607672183">Σύνδεση στο Optimium;</translation>
<translation id="8823401858233292222">Ορισμός Chromium ως προεπιλεγμένο πρόγραμμα περιήγησης και καρφίτσωμα στη γραμμή εργαλείων</translation>
<translation id="8826492472752484139">Κάντε κλικ στην επιλογή Διαχείριση κωδικών πρόσβασης</translation>
<translation id="8833697763442816810">Σύστημα Chromium OS</translation>
<translation id="8852026904190808918">Αυτή η γλώσσα χρησιμοποιείται για την προβολή μενού, ρυθμίσεων, ειδοποιήσεων και άλλου κειμένου στο Chromium</translation>
<translation id="8862326446509486874">Δεν έχετε τα απαραίτητα δικαιώματα για εγκατάσταση σε επίπεδο συστήματος. Δοκιμάστε να εκτελέσετε ξανά το πρόγραμμα εγκατάστασης ως Διαχειριστής.</translation>
<translation id="8400219074131043686">Προσθήκη προφίλ Optimium</translation>
<translation id="3471339840299959661">Δεν ήταν δυνατή η αποθήκευση δεδομένων Optimium στον Λογαριασμό σας Google από το ChromiumOS λόγω σφάλματος κατά τη σύνδεση</translation>
<translation id="8161120518458367008">Ο οργανισμός σας απαιτεί να συνδεθείτε στο Optimium</translation>
<translation id="8897637834206928776">Νέο εικονίδιο, ίδια συντόμευση: Κάντε κλικ για να υποβάλετε ερωτήσεις κατά την περιήγηση με την Αναζήτηση Google στο πλαϊνό πλαίσιο.</translation>
<translation id="3459877940554598369">Το Optimium απαιτεί Windows 10 με την έκδοση 1809 ή νεότερη.</translation>
<translation id="4176797355456373725">Το Optimium προσπαθεί να εμφανίσει τους κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασής σας Windows για να το επιτρέψετε αυτό.</translation>
<translation id="8300184335948277828">Το Optimium δεν είναι πλέον το προεπιλεγμένο πρόγραμμα περιήγησης. Θέλετε να ορίσετε το Optimium ως το προεπιλεγμένο πρόγραμμα περιήγησης;</translation>
<translation id="8365648631713891786">Δεν είναι δυνατή η ενημέρωση του Optimium</translation>
<translation id="8944232836376404813">Αυτή η ενέργεια:
          <ph name="LINE_BREAKS" />
            • Θα επαναφέρει τη σελίδα εκκίνησης, τη σελίδα Νέα καρτέλα, τη μηχανή αναζήτησης και τις καρφιτσωμένες καρτέλες
            <ph name="LINE_BREAK" />
            • Θα απενεργοποιήσει τις επεκτάσεις
            <ph name="LINE_BREAK" />
            • Θα διαγράψει τα cookie και τα άλλα προσωρινά δεδομένα ιστοτόπων
            <ph name="LINE_BREAKS" />
            Οι σελιδοδείκτες, το ιστορικό και οι αποθηκευμένοι κωδικοί πρόσβασης δεν θα επηρεαστούν.</translation>
<translation id="4517341657960407384">Εμφάνιση συντομεύσεων ιστοτόπων στο Optimium</translation>
<translation id="6334459924587075942">Λογότυπο Optimium Enterprise</translation>
<translation id="1013608620694172987">Απολαύστε την ασφάλεια της Google εν κινήσει με την εφαρμογή Optimium στη συσκευή <ph name="DEVICE_TYPE" /></translation>
<translation id="6377692339934065652">Δεν είναι δυνατή η έναρξη του Optimium, επειδή προέκυψε πρόβλημα κατά το άνοιγμα του προφίλ σας. Δοκιμάστε να επανεκκινήσετε το Optimium.</translation>
<translation id="8411734418760705455">για αναζήτηση με το Optimium ή προσαρμογή στις <ph name="BEGIN_LINK" />Ρυθμίσεις<ph name="END_LINK" /></translation>
<translation id="4403836439014450645">Διαχείριση προφίλ Optimium</translation>
<translation id="7714694033208252813">Χρησιμοποιήστε το πληκτρολόγιό σας για να πλοηγηθείτε μεταξύ του Gemini στο Optimium και της ανοιχτής καρτέλας σας.</translation>
<translation id="9018218886431812662">Η εγκατάσταση ολοκληρώθηκε</translation>
<translation id="4028461118515168614">Για να κάνουμε το Optimium πιο ασφαλές, απενεργοποιήσαμε τις ακόλουθες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="8853260188791570953">Σύνδεση στο Optimium</translation>
<translation id="6769418925691762561">Εμφάνιση της αναζήτησης με το Optimium στη γραμμή μενού του Mac και ενεργοποίηση συντόμευσης πληκτρολογίου</translation>
<translation id="1582160730719680639">Το Optimium απέκλεισε αυτή τη λήψη, επειδή το αρχείο αρχειοθέτησης περιλαμβάνει άλλα αρχεία που ενδέχεται να κρύβουν κάποιο κακόβουλο πρόγραμμα</translation>
<translation id="136372829312763612">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές. Αποκτήστε εύκολα πρόσβαση στις λειτουργίες που γνωρίζετε και αγαπάτε, ορίζοντας το Optimium ως το προεπιλεγμένο πρόγραμμα περιήγησης. Το Optimium θα καρφιτσωθεί στη γραμμή εργαλείων για γρήγορη πρόσβαση.</translation>
<translation id="4121763951659864948">Χρησιμοποιήστε τα καλύτερα εργαλεία AI της Google με την εφαρμογή Optimium στο τηλέφωνό σας</translation>
<translation id="570680773394181802">Για να έχετε πρόσβαση στους κωδικούς πρόσβασης και σε άλλα στοιχεία από τη συσκευή <ph name="DEVICE" />, συνδεθείτε στο Optimium</translation>
<translation id="9062666675513499497">Σύνδεση στο Chromium όταν συνδέεστε σε άλλες υπηρεσίες Google</translation>
<translation id="9074041031320636790">Επιτυχία! Μπορείτε πλέον να κάνετε εύκολα ερωτήσεις κατά την περιήγηση με τη Λειτουργία AI της Αναζήτησης Google</translation>
<translation id="9074163480955555019">Νέο εικονίδιο, ίδια συντόμευση: Κάντε κλικ για να κάνετε ερωτήσεις κατά την περιήγηση με την Αναζήτηση Google στο Chrome.</translation>
<translation id="516400912738056453">Το Optimium έκλεισε αυτόματα</translation>
<translation id="807899198682302888">Το Optimium δεν είναι ενημερωμένο</translation>
<translation id="4711199283523757502">{0,plural, =1{Η επανεκκίνηση του Optimium θα γίνει σε μία ώρα}other{Η επανεκκίνηση του Optimium θα γίνει σε # ώρες}}</translation>
<translation id="9106236359747881194">Επιλογή κειμένου για αναζήτηση</translation>
<translation id="8368867604698561866">Για τη λήψη μελλοντικών ενημερώσεων του Optimium, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 8.1.</translation>
<translation id="4437683009835184797">Άνοιγμα Συνδέσμου σε Νέα καρτέ&amp;λα Optimium</translation>
<translation id="911206726377975832">Να γίνει διαγραφή και των δεδομένων περιήγησης;</translation>
<translation id="9118146721060781133">Το κουμπί "Εργασίες με βάση τα συμφραζόμενα" στη γραμμή εργαλείων έχει νέο εικονίδιο. Κάντε κλικ στο εικονίδιο για να υποβάλετε ερωτήσεις κατά την περιήγηση με τις Εργασίες με βάση τα συμφραζόμενα.</translation>
<translation id="9134482777260927479">Βοήθεια για σχολικές εργασίες</translation>
<translation id="9148058034647219655">Έξοδος</translation>
<translation id="3295815393935110309">Συνεχίστε από το σημείο που σταματήσατε: Το Optimium μπορεί να επαναφέρει τις καρτέλες σας κάθε φορά που κάνετε επανεκκίνηση. Για να ενεργοποιήσετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα</translation>
<translation id="5167935114017057528">Ο διαχειριστής συστήματος έχει διαμορφώσει το Optimium έτσι ώστε να ανοίγει άλλο πρόγραμμα περιήγησης για την πρόσβαση στη διεύθυνση <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="903669083727317908">Επανεκκίνηση για ενημέρωση του &amp;Optimium</translation>
<translation id="1256233032126781893">Optimium (mDNS-In)</translation>
<translation id="6225435091563451277">Εξατομίκευση του Optimium</translation>
<translation id="1987988401118534091">Το Optimium μπορεί να μην λειτουργεί σωστά, επειδή δεν υποστηρίζεται πια σε Windows XP και Windows Vista</translation>
<translation id="8102971646278891292">Μεταφέρετε μαζί σας τις καλύτερες λειτουργίες ασφαλείας της Google με το Optimium.</translation>
<translation id="945522503751344254">Αποστολή σχολίων</translation>
<translation id="225981349930289899">Ποιος χρησιμοποιεί το Optimium;</translation>
<translation id="2788235168912697021">Λάβετε την ισχυρότερη προστασία του Optimium</translation>
<translation id="983803489796659991">Η εγκατάσταση απέτυχε επειδή ο διακομιστής ενημέρωσης δεν διαθέτει δεδομένα κατακερματισμού για την εφαρμογή.</translation>
<translation id="802168381040095988">Χρήση του Optimium χωρίς λογαριασμό</translation>
<translation id="985602178874221306">Οι συντάκτες του Chromium</translation>
<translation id="989970834842471429">Επιλέξτε οποιοδήποτε κείμενο ή εικόνα για αναζήτηση με την Αναζήτηση με εικόνες</translation>
<translation id="992780518932311116">Για χρήση της τοποθεσίας σας, παραχωρήστε πρόσβαση στο Chromium στις <ph name="BEGIN_LINK" />ρυθμίσεις συστήματος<ph name="END_LINK" /></translation>
</translationbundle>

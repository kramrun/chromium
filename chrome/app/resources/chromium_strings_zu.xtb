<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="zu">
<translation id="1026101648481255140">Qalisa Kabusha Ukufaka</translation>
<translation id="1029669172902658969">Qalisa kabusha ukuze ubuyekeze i-&amp;ChromiumOS</translation>
<translation id="4063809399345498325">I-Optimium incoma ukuthi ubuyekeze lesi sandiso</translation>
<translation id="1042552502243217427">Lapho isayithi icela ukulayisha kusengaphambili ngasese amalinki ekhasini layo, i-Chromium isebenzisa amaseva e-Google. Lokhu kufihla ubuwena kusayithi elayishwe ngaphambilini, kodwa i-Google ifunda ukuthi yimaphi amasayithi alayishwa ngaphambilini.</translation>
<translation id="1051793555070215510">Sisize sithuthukise i-Incognito ngokuthatha le nhlolovo yomzuzu o-1.</translation>
<translation id="1065672644894730302">Okuncamelayo kwakho akukwazi ukufundwa.

Ezinye izici kungenzeka zingabi khona futhi izinguquko kokuncamelayo ngeke zize zilondolozwe.</translation>
<translation id="7250992450852052182">Umzali wakho uvale "Izimvume zamasayithi, ama-app, nezandiso" ze-Optimium</translation>
<translation id="6711838932294803312">IOptimium idinga ukufinyelela kunethiwekhi yakho yendawo ukuze ithole futhi isebenzise amadivayisi aseduze</translation>
<translation id="2807920805712601449">Ukuze useshe isakhi noma isandiso esithile seOptimium, thayipha isinqamuleli sayo kubha yekheli, kulandelwe ukhiye wakho wekhibhodi okhethiwe</translation>
<translation id="5994612110840535151">Bonisa ukusesha ngeOptimium kugqoko lwesistimu bese uvula isinqamuleli sekhibhodi</translation>
<translation id="7212528213853025915">I-Optimium ifuna ukuthumela amaphasiwedi akho. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="112640046208448578">Thola izinto noma izindawo bese ukopisha noma uhumusha umbhalo. Lapho usebenzisa Usesho Lomfanekiso, isithombe-sikrini sekhasi sithunyelwa eseveni. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">I-Chromium iyisiphequluli sakho esizenzakalelayo</translation>
<translation id="1131805035311359397">Ukuze uhlole uma ngabe amaphasiwedi akho aphephile yini kusukela ekuphulweni kwedatha nakwezinye izinkinga zokuvikela, <ph name="BEGIN_LINK" />ngena ngemvume ku-Chromium<ph name="END_LINK" />.</translation>
<translation id="3458316367708035110">{COUNT,plural, =1{Umlawuli wakho ucela uqalise kabusha iOptimium ukuze kusebenze okubuyekeziwe. Kukhona iwindi le-Incognito noma Elizimele elivuliwe. Ngeke livuleke kabusha ngemva kokuqalisa kabusha.}one{Umlawuli wakho ucela uqalise kabusha iOptimium ukuze kusebenze okubuyekeziwe. Kunamawindi e-Incognito Nazimele angu-# avuliwe kumaphrofayela. Ngeke avuleke kabusha ngemva kokuqalisa kabusha.}other{Umlawuli wakho ucela uqalise kabusha iOptimium ukuze kusebenze okubuyekeziwe. Kunamawindi e-Incognito Nazimele angu-# avuliwe kumaphrofayela. Ngeke avuleke kabusha ngemva kokuqalisa kabusha.}}</translation>
<translation id="1150418667633096194">Inkinobho ethi "Iphaneli eseceleni yeGoogle Search" kubha yamathuluzi inesithonjana esisha. Yichofoze ukuze ubuze imibuzo njengoba ubhrawuza ngephaneli eseceleni yeGoogle Search.</translation>
<translation id="759898790519515623">Chofoza imenyu ye-Optimium</translation>
<translation id="1157952955648710254">Vala iphaneli eseceleni ye-Google Search</translation>
<translation id="1157985233335035034">Izilimi zakamuva</translation>
<translation id="1184145431117212167">Ukufaka kwehlulekile ngoba uhlobo lweWindows yakho alusekelwa.</translation>
<translation id="1185134272377778587">Mayelana ne-Chromium</translation>
<translation id="5987505065981917957">Thola izexwayiso zokulandelela intengo nge-Optimium efonini yakho</translation>
<translation id="1203500561924088507">Siyabonga ngokufaka. Kufanele uqale kabusha ibhrawuza yakho ngaphambi kokusebenzisa i-<ph name="BUNDLE_NAME" />.</translation>
<translation id="1232234696885483911">Uma uvula Usesho Lomfanekiso, isihloko sekhasi, i-URL, nekhontenti, okuhlanganisa ama-PDF, kuzothunyelwa ngokuzenzekelayo kuseva. <ph name="LEARN_MORE" /></translation>
<translation id="3560913454241378492">Ngenkathi ungene ngemvume, ungasebenzisa amaphasiwedi akho nokuningi ngeGoogle Account yakho kuOptimium. Ukuze ushintshe lokhu, iya kokuthi “I-akhawunti yakho kuOptimium”.</translation>
<translation id="8922965532693587493">Bonisa iGemini kuOptimium kubha yemenyu yeMac</translation>
<translation id="236433590733312836">Ukuze ukhethe ingxenye yesikrini kuGemini kuOptimium, sebenzisa isinqamuleli sekhibhodi.</translation>
<translation id="7976124325589452515">Ngenkathi le thebhu ingasebenzi, inkumbulo iye yenzelwa isikhala ukugcina i-Optimium ishesha. Ungakhetha ukungahlanganisi le sayithi ekutheni ibe engasebenzi.</translation>
<translation id="2758503437544511902">I-Optimium ivimbele lokhu kudawunilodwa ngoba ifayela liyingozi</translation>
<translation id="126567311906253476">Uma ungena ngemvume kumasevisi eGoogle efana neGmail noma iYouTube nge-<ph name="USER_EMAIL" />, ungangena ngemvume ngokuzenzakalela kuChromium nge-akhawunti efanayo</translation>
<translation id="4104061172701635162">Thola iOptimium efonini yakho</translation>
<translation id="1290883685122687410">Iphutha lesethaphu: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="3443894627866827446">Setha iphrofayela yakho entsha ye-Optimium</translation>
<translation id="8946186262159916495">Zama ngeGemini kuOptimium</translation>
<translation id="7981347318091963592">I-Optimium idinga ukufinyelela i-Bluetooth ukuze ihlole amadivayisi we-Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6099322702899630168">Ngena ngemvume kuOptimium efonini yakho</translation>
<translation id="1330562121671411446">Thola ulimi</translation>
<translation id="3294414641786025647">Futhi sula idatha ku-Optimium (<ph name="URL" />)</translation>
<translation id="4214354213779528068">{COUNT,plural, =1{Ukuvikelwa Okuthuthukile kudinga ukuthi uqalise kabusha iOptimium ukuze usebenzise isibuyekezo. Kukhona iwindi le-Incognito noma Elizimele elivuliwe. Ngeke livuleke kabusha ngemva kokuqalisa kabusha.}one{Ukuvikelwa Okuthuthukile kudinga ukuthi uqalise kabusha iOptimium ukuze usebenzise isibuyekezo. Kunamawindi e-Incognito Nazimele angu-# avuliwe kumaphrofayela. Ngeke avuleke kabusha ngemva kokuqalisa kabusha.}other{Ukuvikelwa Okuthuthukile kudinga ukuthi uqalise kabusha iOptimium ukuze usebenzise isibuyekezo. Kunamawindi e-Incognito Nazimele angu-# avuliwe kumaphrofayela. Ngeke avuleke kabusha ngemva kokuqalisa kabusha.}}</translation>
<translation id="1345251407431278948">Kuphiniwe! Ungafinyelela futhi Usesho Lomfanekiso ngenkinobho entsha kubha yamathuluzi</translation>
<translation id="1383876407941801731">Sesha</translation>
<translation id="7825299065989465359">Sebenzisa i-app yeOptimium ukuze uqhubeke nokubhrawuza usendleleni</translation>
<translation id="141901961143729572">Yabelana ngemicabango yakho</translation>
<translation id="1438812738230833934">Ungavula kabusha iGoogle Search kuphaneli eseceleni ukuze ubuze imibuzo ngenkathi ubhrawuza</translation>
<translation id="4131307166987455854">Ukuze wabelane ngewindi lakho, vumela ukurekhodwa kwesikrini kweOptimium Kumasethingi Ohlelo.</translation>
<translation id="1470136641087909499">Ungavula kabusha iGoogle Search kuChrome ukuze ubuze imibuzo ngenkathi ubhrawuza</translation>
<translation id="1478370723027452770">Thola usizo nge-Chrome Yokuhlola</translation>
<translation id="9200022682397754538">Ukuze uthole imininingwane yakho egciniwe nokukuma<ph name="DEVICE" />, ngena ngemvume kuOptimium</translation>
<translation id="1497802159252041924">Iphutha lokufaka <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Leli khasi livikelwe</translation>
<translation id="892690000529877604">Yabelana ngethebhu ye-Optimium</translation>
<translation id="15408169957028265">Vula kabusha iGoogle Search kuChrome</translation>
<translation id="9039191226880557963">Ngena ngemvume kuOptimium</translation>
<translation id="1547469039832541117">Ivala umsebenzi ogqanyisiwe.</translation>
<translation id="4414991100979797293">Phina iOptimium</translation>
<translation id="1574377791422810894">Amathuluzi okuphepha e-Chromium</translation>
<translation id="3934587628489930735">IOptimium ifuna ukusula idatha Yesiphathi sakho Sephasiwedi. Thayipha iphasiwedi yakho yeWindows ukuze uvumele lokhu.</translation>
<translation id="6745390171113033635">{COUNT,plural, =0{Umlawuli wakho udinga ukuthi uqalise kabusha i-Optimium ukuze kusetshenziswe isibuyekezo}=1{Umlawuli wakho udinga ukuthi uqalise kabusha i-Optimium ukuze kusetshenziswe isibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Umlawuli wakho udinga ukuthi uqalise kabusha i-Optimium ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Umlawuli wakho udinga ukuthi uqalise kabusha i-Optimium ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="7186551909256266009">Thola okuhamba phambili kweGoogle nge-app yeOptimium efonini yakho</translation>
<translation id="1625909126243026060">Buyekeza izilawuli eziyinhloko zobumfihlo nokuvikeleka ku-Chromium</translation>
<translation id="1640672724030957280">Iyadawuniloda...</translation>
<translation id="1648201623125974721">Isithonjana esisha, isinqamuleli esifanayo: Chofoza ukuze ubuze imibuzo njengoba ubhrawuza Ngemisebenzi Engokomongo.</translation>
<translation id="1665602916345474427">Ungene ngemvume njengo-<ph name="USER_NAME" />, <ph name="USER_EMAIL" />, ubulungu. Vula imenyu ye-akhawunti</translation>
<translation id="1708414395296835197">Ungasebenzisa iChromium noma nini lapho uchofoza amalinki emiyalezweni, kumadokhumenti, nakwamanye ama-app Izobuye iphinwe ku-taskbar yakho.</translation>
<translation id="1709772298389099340">Inikeza amalungelo aphakeme e-<ph name="BROWSER_NAME" />.</translation>
<translation id="1722488837206509557">Lokhu kuzokuvumela ukuthi ukhethe emadivayisini atholakalayo futhi ubonise okuqukethwe kuwo.</translation>
<translation id="6717880500969720524">I-Optimium izosula idatha yokubhrawuza maduze</translation>
<translation id="1736443181683099871">I-Chromium izozama ukuthuthukisa ukufuna ukuya ku-HTTPS</translation>
<translation id="4418738262462299802">Idatha ye-Optimium esuliwe</translation>
<translation id="8469746761106187775">I-Optimium izoqala kabusha emizuzwaneni engu-<ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Uma i-HTTPS ingatholakali, i-Chromium izosebenzisa uxhumo olungavikelekile ngaphandle kokukuxwayisa</translation>
<translation id="1769661297620183092">Ungavula kabusha iphaneli yeGoogle Search ukuze ubuze imibuzo ngenkathi ubhrawuza</translation>
<translation id="6555789357989792722">Vumela i-Optimium ukuthi isebenze ngemuva</translation>
<translation id="627441522449241646">Ukuze senze i-Optimium ivikeleke, sikhubaze ezinye izandiso ezingafakwanga kuhlu lwe-<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> futhi okungenzeka zingezwe ngaphandle kolwazi lakho.</translation>
<translation id="1912380661217770781">Chofoza okuthi <ph name="BEGIN_BOLD" />Yebo<ph name="END_BOLD" /> esazisweni seWindows ukuze uphine iOptimium ku-taskbar yakho ukuze uyifinyelele ngokushesha.</translation>
<translation id="9034578483087384251">Phinda ufake i-Optimium</translation>
<translation id="2856362667064664106">I-Optimium izama uku-<ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="1665590461646883113">U-<ph name="EXISTING_USER" /> usengenile ngemvume. Ukuze ugcine ukubhrawuza kwakho kuhlukile, ngena ngemvume kuOptimium kuphrofayela yakho njengo-<ph name="USER_EMAIL_ADDRESS" /> Uzophinde uthole izandiso zakho nokuningi ku-<ph name="DEVICE" />.</translation>
<translation id="1668665535355826445">Ngokuzayo uma uvula iOptimium ku-<ph name="DEVICE_TYPE" /> yakho, uzobona umyalelo wokusebenzisa Umphathi Wephasiwedi YeGoogle.</translation>
<translation id="1838374766361614909">Sula usesho</translation>
<translation id="8674417702521959187">Ukuze usule idatha yopheqululo kule divayisi kuphela, kuyilapho uyigcina ku-Google Account yakho, <ph name="BEGIN_LINK" />phuma ngemvume ku-Optimium<ph name="END_LINK" />.</translation>
<translation id="6186721318460238018">Dawuniloda iOptimium efonini yakho ukuze uvule noma usungule amaqembu ethebhu amasha usendleleni.</translation>
<translation id="185970820835152459">Ungaphatha ama-akhawunti we-Google wakho angene ngemvume. Ama-akhawunti wakho we-Google asetshenziselwe i-browser ye-Chromium, i-Play Store, i-Gmail, nokuningi. Uma ufuna ukungeza i-akhawunti yomuntu othile, njengelungu lomndeni, engeza umuntu omusha ku-<ph name="DEVICE_TYPE" /> yakho kunalokho. <ph name="LINK_BEGIN" />Funda kabanzi<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Sesha Ngosesho Lomfanekiso</translation>
<translation id="1781731701613313704">U-<ph name="EXISTING_USER" /> usevele ungene ngemvume. Ukuze ugcine ukubhrawuza kwakho kuhlukile, ngena ngemvume kuOptimium kuphrofayela yakho njengo-<ph name="USER_EMAIL_ADDRESS" /> Uzophinde uthole amabhukhimakhi akho nokuningi ku-<ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Khetha umbhalo</translation>
<translation id="5960850334733792580">Ungena ngemvume nge-akhawunti ephethwe futhi unikezele ukuqondiswa kokulawulwa kwayo ngaphezulu kwephrofayela yakho ye-Optimium. Idatha yakho ye-Optimium, efana nezinhlelo zakho zokusebenza, amabhukhimakhi, umlando, amaphasiwedi, nezinye izilungiselelo zizoboshelwa unaphakade ku-<ph name="USER_NAME" />. Uzokwazi ukususa le datha nge-Ideshibhodi yama-Akhawunti we-Google, kodwa ngeke uze ukwazi ukuhlobanisa le datha nenye i-akhawunti. Ungadala ngokukhetha iphrofayela entsha ukuze ugcine idatha yakho ekhona ye-Optimium ihlukile. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">IChromium igcina amandla ebhethri ngokukhawulela umsebenzi ongemuva nemiphumela yokubuka, njengokuskrola okubushelelezi namazinga ohlaka lwevidiyo. <ph name="BEGIN_LINK" />Funda kabanzi mayelana Nesongi Samandla<ph name="END_LINK" /></translation>
<translation id="7900167719031567542">Isevisi Yesibuyekezi SeOptimium</translation>
<translation id="1911763535808217981">Ngokuvala lokhu, ungangena ngemvume kumasayithi e-Google njenge-Gmail ngaphandle kokungena ngemvume ku-Chromium</translation>
<translation id="5015349619125768393">I-Optimium ayiphenduli. Qalisa kabusha manje?</translation>
<translation id="2019000760486664637">Inhlangano yakho, ebizwa <ph name="MANAGER" />, ifuna ungene ngemvume kuOptimium</translation>
<translation id="193439633299369377">I-ChromiumOS idinga ukuphinda iqaliswe ukuze kusetshenziswe isibuyekezo.</translation>
<translation id="3382368450324191331">I-Optimium ivimbele lokhu kudawunilodwa ngoba uhlobo lwefayela alivamile ukudawunilodwa futhi lingase libe yingozi</translation>
<translation id="1953553007165777902">Iyadawuniloda... Kusele imizuzu engu-<ph name="MINUTE" /></translation>
<translation id="1966382378801805537">I-Chromium ayikwazi ukunquma noma isethe isiphequluli esizenzakalelayo</translation>
<translation id="197326043290947695">Bhrawuza ngobuhlakani Ngosesho Lomfanekiso</translation>
<translation id="5321661580966500942">Funda ukuthi kungani i-Optimium ivimba amanye amafayela, ivula kuthebhu entsha</translation>
<translation id="8960045458031480819">Kugcina isofthiwe yakho yeOptimium ingeyakamuva. Uma le sevisi ikhutshaziswe noma imisiwe, isofthiwe yakho yeOptimium ngeke igcinwe ingeyakamuva, okusho ukuthi ukungavikeleki okungase kuphakame akukwazi ukulungiswa futhi izakhi zingase zingasebenzi. Le sevisi iyazikhipha uma ingekho isofthiwe yeOptimium eyisebenzisayo.</translation>
<translation id="2008474315282236005">Lokhu kuzosusa into engu-1 kusuka kule divayisi. Ukuze usebenzise futhi idatha yakho ngokuhamba kwesikhathi, ngena ngemvume ku-Chromium njengo-<ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Ukufakwa kwehlulekile. Sicela uzame futhi.</translation>
<translation id="2039417478970545937">Amasethingi.</translation>
<translation id="2049376729098081731">Khetha ukuthi ufake phakathi umlando we-Chromium ukuze uthole umuzwa womuntu siqu kumasevisi e-Google</translation>
<translation id="4120951192672345208">Yakhelwe kuOptimium ukuze ikusize usungule, ulondoloze, futhi ugcwalise ngokuzenzekelayo amaphasiwedi aqinile. Faka isinqamuleli ukuze ufinyelele kalula.</translation>
<translation id="2060311596979880693">Impumelelo! Manje usungakwazi ukubuza imibuzo kalula njengoba ubhrawuza ngeGoogle Search kuChrome</translation>
<translation id="7165258062917217746">Chofoza inkinobho ethi Vumelanisa IChrome Nomuntu Ngamunye Ekhasini Lethebhu Entsha ukuze unikeze iOptimium ukubukeka okusha</translation>
<translation id="3702823791268559760">I-Optimium ivimbele lokhu kudawuniloda ngoba ifayela liyakhohlisa futhi lingase lenze izinguquko ezingalindelekile kudivayisi yakho</translation>
<translation id="2370804817835146114">Uzobona umyalelo wokuzama okuthi <ph name="FEATURE_NAME" /> ngesikhathi esilandelayo lapho uvula iOptimium iOS.</translation>
<translation id="5887094242311035059">Amaphasiwedi akho kanye nenye idatha yeOptimium oyilondoloze kuGoogle Account yakho izosuswa kule divayisi. Ukuze uphinde uzisebenzise kuOptimium, ngena ngemvume futhi.</translation>
<translation id="8794268168383660193">{COUNT,plural, =1{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-Optimium ingasetshenziswanga umzuzu o-1. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}one{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-Optimium ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}other{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-Optimium ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}}</translation>
<translation id="2125838419757773031">Khetha isifunda sesikrini ukuze useshe</translation>
<translation id="2126108037660393668">Ifayela elidawunilodiwe aliphumelelanga lapho liqinisekiswa.</translation>
<translation id="2135919691573380097">Bika le sayithi</translation>
<translation id="2137162749895930932">Vala isikrini sokuhumusha</translation>
<translation id="2147218225094845757">Fihla iphaneli eseceleni</translation>
<translation id="8888656790178891761">I-Optimium ivimbele lokhu kulanda ngoba isayithi alisebenzisi uxhumano oluvikelekile futhi kungenzeka ukuthi ifayela lonaniwe.</translation>
<translation id="2170098639895543546">Khetha noma yini esekhasini</translation>
<translation id="6975401993318112971">Yenza i-Optimium ngokwezifiso</translation>
<translation id="2174917724755363426">Ukufaka akuqediwe. Uqinisekile ufuna ukukhansela?</translation>
<translation id="7741769305753410467">I-Optimium - Inethiwekhi Yokungena ngemvume - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Buyekeza iphutha lokuchekha: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2133097742403140075">Susa i-akhawunti kuOptimium</translation>
<translation id="6495056863394621013">Sebenzisa i-app yeOptimium ukuze usebenzise amathuluzi okuthenga angcono kakhulu usendleleni</translation>
<translation id="2209877494277346829">Hlukanisa iChromium kwamanye ama-app</translation>
<translation id="2035198300681156782">Hlala uphephile lapho usendleleni Ngokubhrawuza Okuphephe Ngokuthuthukisiwe kuOptimium ye-iOS</translation>
<translation id="2210682093923538346">Isayithi eyingozi. I-Chromium isuse izaziso.</translation>
<translation id="2236949375853147973">Umsebenzi Wami</translation>
<translation id="871771486544954531">Ukuze uthole amakheli akho nokuningi kuwo wonke amadivayisi akho, ngena ngemvume kuOptimium. Leli kheli lizolondolozwa kuGoogle Account yakho ngemva kokungena ngemvume.</translation>
<translation id="524316078518338158">Uma wabelana ngekhompyutha, abangani nomndeni bangadlulisa amehlo ngokuhlukile baphinde basethe i-Chrome ngendlela abafuna ngayo nje.</translation>
<translation id="22571759390241347">Amakhono kuChromium</translation>

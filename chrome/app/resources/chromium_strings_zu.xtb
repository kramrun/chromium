<translation id="4669117187454638908">Phuma ku-Optimium noma kunjalo?</translation>
<translation id="4413205837991854510">Bonisa Isinqamuleli Sokusesha Umfanekiso Njalo</translation>
<translation id="1696050014109987987">Vumela i-Optimium isebenze ngemuva</translation>
<translation id="7368827027253482667">{NUM_EXTENSIONS,plural, =1{IOptimium incoma ukuthi usisuse. <ph name="BEGIN_LINK" />Funda kabanzi mayelana nezandiso ezisekelwayo<ph name="END_LINK" />}one{IOptimium incoma ukuthi uzisuse. <ph name="BEGIN_LINK" />Funda kabanzi mayelana nezandiso ezisekelwayo<ph name="END_LINK" />}other{IOptimium incoma ukuthi uzisuse. <ph name="BEGIN_LINK" />Funda kabanzi mayelana nezandiso ezisekelwayo<ph name="END_LINK" />}}</translation>
<translation id="6842479443769252421">Yenza ngokwezifiso uphinde ulawule i-Optimium</translation>
<translation id="4427306783828095590">Isivikelo esithuthukisiwe senza okuningi ukuvimba ubugebengu bokweba imininingwane ebucayi kanye uhlelo olungayilungele ikhompyutha</translation>
<translation id="4434353761996769206">Iphutha lesifaki: <ph name="INSTALLER_ERROR" /></translation>
<translation id="1220175535870261362">U-<ph name="MANAGER" /> uphatha iOptimium</translation>
<translation id="4547231940814681999">Faka iphrofayela yeOptimium</translation>
<translation id="4447409407328223819">Mayelana ne-Chrome Yokuhlola</translation>
<translation id="5633209319760692383">Ukuze usebenzise futhi ulondoloze idatha yeOptimium kuGoogle Account yakho, faka umushwana wakho wokungena</translation>
<translation id="4493028449971051158">Iphutha ekuqaliseni: sicela usebenzise isifaki njengomlawuli.</translation>
<translation id="4501471624619070934">Ukufaka kuhlulekile ngoba ukufinyelela kukhawulelwe kuleli zwe.</translation>
<translation id="4501839397124711198">Ungaphina iGoogle Search kuphaneli eseceleni ukuze ubuze imibuzo njengoba ubhrawuza</translation>
<translation id="2800276662284246735">Lesi sandiso asikashicileli izindlela zangasese zokuziphatha, njengokuthi siyiqoqa futhi siyisebenzise kanjani idatha. I-Optimium incoma ukuthi usisuse.</translation>
<translation id="5128821773878845255">Siyakwamukela ku-Optimium; iwindi elisha lesiphequluli livuliwe</translation>
<translation id="2317489323536472198">I-Optimium idinga imvume yokumepha indawo ekuzungezile futhi ilandelele izandla zakho</translation>
<translation id="8080035720506683743">Usuvele ungene ngemvume njengo-<ph name="USER_EMAIL_ADDRESS" /> kwenye iphrofayela ye-Optimium</translation>
<translation id="4548534452171747496">IChromium ilayisha ngaphambilini amakhasi okwenza ukubhrawuza nokusesha kusheshe. <ph name="BEGIN_LINK" />Funda kabanzi mayelana namakhasi okulayisha kuqala<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Uthuthukisa ukuphepha ku-inthanethi kwawo wonke umuntu uma ubika isayithi ocabanga ukuthi liyingozi.</translation>
<translation id="8636960717768483692">I-Optimium ivimbele lokhu kudawuniloda ngoba uvale Ukuphequlula Okuphephile futhi ifayela alikwazi ukuqinisekiswa</translation>
<translation id="1056620590372326996">Zama iGoogle Lens ngeOptimium efonini yakho</translation>
<translation id="4594305310729380060">Kusiphathi Sephasiwedi kule divayisi</translation>
<translation id="1647545052658850323">Izinhlelo zokusebenza ze-Optimium</translation>
<translation id="4598116752460667024">Sesha noma iyiphi inqubo ohlwini.</translation>
<translation id="4613863813562375431">Uhlobo lwe-ChromiumOS</translation>
<translation id="4621240073146040695">Icishe isesikhathini! Qalisa kabusha i-Chromium ukuze uqedele ukubuyekeza.</translation>
<translation id="2905329563261343101">Isheshisa amasayithi anenjini yeOptimium V8 kodwa yenza iOptimium ingabi namandla okumelana nokuhlaselwa.</translation>
<translation id="3476739270743628464">Vula iSearch ngeOptimium</translation>
<translation id="8852417056873245680">Iphrofayela yeOptimium</translation>
<translation id="7306598352117034690">Isexwayiso: I-Optimium ayikwazi ukuvimbela izandiso kusuka ekurekhodeni umlando wakho wokudlulisa amehlo. Ukuze ukhubaze lesi sandiso kumodi ye-incognito, yekisa ukukhetha le nketho.</translation>
<translation id="4673151026126227699">Uma futhi wabelana ngemibiko yokusetshenziswa kwe-Chromium, leyo mibiko ihlanganisa nama-URL owavakashelayo</translation>
<translation id="4673710618874938871">Ungene ngemvume njengo-<ph name="USER_NAME" />, ubulungu. Vula imenyu ye-akhawunti</translation>
<translation id="8554460300897634995">Iphrofayela ibukeka isetshenziswa enye inqubo ye-Optimium (<ph name="PROCESS_ID" />) kwenye ikhompyutha (<ph name="HOST_NAME" />). I-Optimium ikhiye iphrofayela ukuze ingamosheki. Uma uqinisekile ukuthi azikho ezinye izinqubo ezisebenzisa le phrofayela, ungavula iphrofayela uphinde uqalise i-Optimium.</translation>
<translation id="4680828127924988555">Khansela Ukufaka</translation>
<translation id="3120454893225058851">Enye idatha yakho yeOptimium ayikalondolozwa kuGoogle Account. Zama ukulinda imizuzu embalwa ngaphambi kokuphuma ngemvume. Uma uphuma ngemvume manje, le datha izosulwa.</translation>
<translation id="382482205580353394">Ngenkathi ungene ngemvume, ungasebenzisa amaphasiwedi akho nokuningi ukusuka kuGoogle Account yakho kuOptimium. I-<ph name="SHORTCUT" /> ingashintsha amasethingi wakho wamasevisi eGoogle.</translation>
<translation id="3042362992251330365">Umuntu othile ungene ngemvume ngaphambilini ku-Optimium kule khompuyutha njengo-<ph name="ACCOUNT_EMAIL_LAST" />. Sicela udale umsebenzisi omusha we-Optimium ukuze ugcine ulwazi lwakho luhlukile.</translation>
<translation id="4724676981607797757">Ukufaka kuhlulekile ngenxa yephutha lephrothokholi engasekelwe.</translation>
<translation id="1193287511990404405">Phuma ku-Optimium noma kunjalo?</translation>
<translation id="8952177001318268390">Isibuyekezo esibalulekile sokuvikela se-Optimium sisanda kufakwa. Qalisa kabusha manje bese sizobuyisela amathebhu akho.</translation>
<translation id="4771701986670315895">Awukavakashi kamuva nje. IChromium isuse i-<ph name="PERMISSION_1" />, i-<ph name="PERMISSION_2" />, nokunye okungu-<ph name="COUNT" /> okwengeziwe</translation>
<translation id="2836181158089477791">Uma iGemini kuOptimium ivuliwe, iphaneli eseceleni ihlala ivuliwe uma usungula amathebhu amasha</translation>
<translation id="479167709087336770">Lokhu kusebenzisa isihloli sokupeleta esifanayo naleso esisetshenziswe kusesho lwe-Google. Umbhalo owuthayiphayo kusiphequluli uthunyelwa ku-Google. Ungahlala ushintsha le mpatho kuzilungiselelo.</translation>
<translation id="4803313124144656665">Vala iGoogle Search kuChrome</translation>
<translation id="1328138522631482119">Sebenzisa i-Optimium ngaphandle kwe-akhawunti</translation>
<translation id="4839733921943823254">Isinqamuleli Sephinikhodi</translation>
<translation id="3892081057957249936">Umyalo obambeke ngaphakathi we-Optimium wokuvumela ithrafikhi ye-mDNS.</translation>
<translation id="7651599052663598373">Qalisa kabusha ukuze Ubuyekeze i-&amp;Optimium</translation>
<translation id="4918086044614829423">Yamukela</translation>
<translation id="4918844574251943176">Umfanekiso ukopishiwe</translation>
<translation id="5410814264258278350">Ukuze uthole uhlu lwakho lokufunda nokukumadivayisi akho, ngena ngemvume kuOptimium</translation>
<translation id="6875307114047320453">I-Optimium kumodi yasemuva.</translation>
<translation id="2394968926407196930">Chofoza ukuze uvale ibhokisi lokungena ngemvume leOptimium</translation>
<translation id="1768466544858725503">Ngamaphrofayela weOptimium ungahlukanisa zonke izinto zakho zeOptimium. Sungula amaphrofayela wabangane nomndeni, noma uhlukanise phakathi komsebenzi nobumnandi.</translation>
<translation id="7886648924703056279">Izihambeli zingasebenzisa i-Optimium ngaphandle kokushiya noma yini ngemuva.</translation>
<translation id="5471135073467145273">I-akhawunti Yakho kuOptimium</translation>
<translation id="6876331590693993673">Zingeze ngokwakho ku-Optimium</translation>
<translation id="5000497292978544380">Imodi ye-AI yeGoogle Search</translation>
<translation id="504699503110800016">Vula imenyu yakho konke</translation>
<translation id="4438081792500757652">Finyelela zonke izintandokazi zakho zeGoogle ngeOptimium ku-<ph name="DEVICE_TYPE" /> yakho</translation>
<translation id="5121592697493894155">IGoogle Search kuphaneli eseceleni</translation>
<translation id="2242644352859741625">IOptimium idinga imvume ukuze ilandelele izandla zakho</translation>
<translation id="5141988424377517949">Awukavakashi kamuva nje. IChromium isuse i-<ph name="PERMISSION_1" />, i-<ph name="PERMISSION_2" />, i-<ph name="PERMISSION_3" />.</translation>
<translation id="988933134885096200">Ngena ngemvume ku-Optimium</translation>
<translation id="5174969993834422967">Uvamise ukuvimba izaziso. Ukuze uvumele leli sayithi ukuthi likwazise, chofoza isithonjana sesaziso ekhoneni elingakwesokudla lebha yendawo yakho.</translation>
<translation id="5174983315706567306">Asikho isikhala sediski esanele.</translation>
<translation id="2338237693885714148">I-akhawunti yeOptimium idinga ukuqinisekiswa kabusha</translation>
<translation id="8218029216260099398">Qhubeka lapho ugcine khona ngeOptimium ku-iOS.</translation>

<translation id="7238239459452345825">‏Optimium می‌خواهد گذواژه‌های موجود را جایگزین کند. برای مجاز کردن این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="5059411697679064446">‏Optimium برای بارگیری فایل‌ها باید به حافظه دسترسی داشته باشد</translation>
<translation id="5959299320608819381">Optimium Helper</translation>
<translation id="2575822587468774919">هرچیزی را می‌خواهید انتخاب کنید تا با «جستجوی تصویر» جستجو شود</translation>
<translation id="8063772441784541423">‏برای دریافت گذرواژه‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Optimium وارد شوید</translation>
<translation id="3112793931795471365">‏برای بارگیری Optimium و ورود به سیستم «حساب Google»، رمزینه پاسخ‌سریع را با تلفنتان اسکن کنید.</translation>
<translation id="1584670114556742260">‏تا با Optimium جستجو کنید.</translation>

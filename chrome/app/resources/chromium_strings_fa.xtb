<translation id="5234764350956374838">بستن</translation>
<translation id="5247617065091903691">‏می‌توانید قاب کناری «جستجوی Google» را سنجاق کنید تا هنگام مرور کردن سوال بپرسید</translation>
<translation id="3776453825988272921">‏باز کردن پیوند در پنجره حالت «&amp;ناشناس» Optimium</translation>
<translation id="3535566975491534106">‏برای ذخیره کردن گذرواژه‌ها درحرکت، برنامه Optimium را دریافت کنید</translation>
<translation id="5277894862589591112">‏برای اعمال تغییراتتان، Chromium را راه‌اندازی مجدد کنید</translation>
<translation id="5286907366254680517">تشخیص داده شد</translation>

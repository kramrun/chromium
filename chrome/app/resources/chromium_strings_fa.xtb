<translation id="4562525634100475413">{COUNT,plural, =1{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. پنجره «مجزا» دوباره باز نخواهد شد.}one{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. ‫# پنجره «مجزا» دوباره باز نخواهد شد.}other{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. ‫# پنجره «مجزا» دوباره باز نخواهد شد.}}</translation>
<translation id="5596627076506792578">گزینه‌های بیشتر</translation>
<translation id="5605834417512968703">هرچیزی را که می‌خواهید برای جستجو کردن با «جستجوی تصویر» انتخاب کنید یا برای خارج شدن از «جستجوی تصویر»، کلید «گریز» را فشار دهید</translation>
<translation id="7026300828382155386">‏‫<ph name="IMPORTANT_UPDATE" /> آماده است. می‌توانید اکنون راه‌اندازی مجدد کنید یا Optimium را طوری تنظیم کنید که دفعه بعدی که صفحه‌نمایش روشن است و به‌مدت <ph name="IDLE_DURATION" /> از آن استفاده نمی‌شود به‌روز شود.</translation>
<translation id="5618818588972826921">‏نوشتار یا تصویری را برای جستجو کردن با «جستجوی تصویر» انتخاب کنید یا برای خارج شدن از «جستجوی تصویر»، کلید Escape را فشار دهید</translation>
<translation id="8498149662316870172">{0,plural, =0{‏به‌روزرسانی Optimium دردسترس است}=1{‏به‌روزرسانی Optimium دردسترس است}one{‏به‌روزرسانی Optimium از # روز پیش دردسترس است}other{‏به‌روزرسانی Optimium از # روز پیش دردسترس است}}</translation>

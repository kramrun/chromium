<translation id="2788235168912697021">‏دریافت قوی‌ترین امنیت Optimium</translation>
<translation id="983803489796659991">نصب انجام نشد چون سرور به‌روزرسانی هیچ‌گونه داده درهمی برای برنامه ندارد.</translation>
<translation id="802168381040095988">‏استفاده از Optimium بدون حساب</translation>
<translation id="985602178874221306">Chromium Authors</translation>
<translation id="989970834842471429">نوشتار یا تصویری را برای جستجو کردن با «جستجوی تصویر» انتخاب کنید</translation>
<translation id="992780518932311116">‏برای استفاده از مکان، در <ph name="BEGIN_LINK" />تنظیمات سیستم<ph name="END_LINK" /> به Chromium دسترسی دهید</translation>
</translationbundle>

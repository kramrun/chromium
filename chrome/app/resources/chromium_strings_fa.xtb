<translation id="6165508094623778733">بیشتر بدانید</translation>
<translation id="440816316079905155">‏داده‌های Optimium ذخیره‌شده در حسابتان را پاک کنید</translation>
<translation id="8018999409456045233">‏این فایل ممکن است خطرناک باشد<ph name="LINE_BREAK" />اگر گذرواژه را ارائه دهید، Optimium می‌تواند این بارگیری را برایتان بررسی کند. اطلاعات فایل به «مرور ایمن Google» ارسال می‌شود، اما محتوای فایل و گذرواژه در دستگاهتان باقی می‌ماند.</translation>
<translation id="6182736845697986886">نصب به‌دلیل وجود خطای داخلی در سرور به‌روزرسانی انجام نشد.</translation>
<translation id="3469021117852380318">‏مطمئن شوید در <ph name="TARGET_DEVICE_NAME" /> به سیستم Optimium وارد شده باشید و سپس دوباره ارسال کنید.</translation>
<translation id="2986761964667678689">‏از هرجا که هستید جستجو کنید و سؤال بپرسید، حتی اگر Optimium کوچک شده باشد. به Optimium اجازه می‌دهد در پس‌زمینه اجرا شود.</translation>
<translation id="1244028666242035366">‏این رایانه در حال حاضر دارای یک نسخه جدیدتر از Optimium است. درصورتی‌که نرم‌افزار کار نمی‌کند، لطفاً Optimium را حذف نصب کنید و دوباره سعی کنید.</translation>
<translation id="6513480350636703580">{0,plural, =0{‏Optimium هم‌اکنون راه‌اندازی مجدد می‌شود}=1{‏Optimium ‏۱ ثانیه دیگر راه‌اندازی مجدد می‌شود}one{‏Optimium ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}other{‏Optimium ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="3859762680410498178">‏‫Optimium وقتی که از صفحه‌نمایش استفاده نمی‌کنید به‌روز خواهد شد</translation>
<translation id="18853993527252772">‏Optimium برای بارگیری فایل‌ها به اجازه دسترسی به فضای ذخیره‌سازی نیاز دارد</translation>
<translation id="6245734527075554892">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در Chromium ذخیره شده است مقایسه می‌کند</translation>
<translation id="571621467627269416">‏Optimium  مرورگر پیش‌فرض شود</translation>
<translation id="6248988683584659830">تنظیمات جستجو</translation>
<translation id="4260906300317983841">‏با برنامه Optimium در تلفنتان، بهترین ویژگی‌های ایمنی Google را درحال حرکت دریافت کنید</translation>
<translation id="6919871734111021049">‏از Optimium خارج می‌شوید؟</translation>
<translation id="8269500201917700071">‏این زبانه‌ها از منابع بیشتری استفاده می‌کنند. برای بهبود عملکرد، اجازه دهید Optimium آن‌ها را غیرفعال کند.</translation>
<translation id="2906910751900335741">‏سفارشی کردن نمایه Optimium</translation>
<translation id="6290827346642914212">‏نام‌گذاری نمایه Chromium</translation>
<translation id="6294638840436017818">‏ازطریق دکمه «قاب کناری جستجوی Google» در نوارابزار، می‌توانید قاب کناری «جستجوی Google» را دوباره باز کنید تا بتوانید هنگام مرور کردن سؤال بپرسید</translation>
<translation id="6612045300479871672">‏یکی از افزونه‌ها از شما می‌خواهد به سیستم Optimium وارد شوید</translation>
<translation id="2723016125417495514">‏<ph name="FILE_NAME" /> ممکن است خطرناک باشد، بنابراین Optimium آن را مسدود کرده است.</translation>
<translation id="6308106880471005841">‏دکمه «پانل جستجوی Google» در نوارابزار نماد جدیدی دارد. روی آن کلیک کنید تا هنگام مرور کردن با پانل «جستجوی Google» سؤال بپرسید.</translation>
<translation id="6151952148243982653">‏Optimium درحال استفاده از دوربین شما است.</translation>
<translation id="7744220780291650493">‏عملیات دیگری در Optimium درحال انجام است. لطفاً بعداً دوباره امتحان کنید.</translation>
<translation id="4212271170228408978">‏اکنون استفاده از Optimium با حساب Google شما و در رایانه‌های مشترک آسان‌تر شده است.</translation>
<translation id="7560359899505953564">‏با تنظیم کردن Optimium به‌عنوان مرورگر پیش‌فرض، به‌راحتی به ویژگی‌هایی که می‌شناسید، دوست دارید، و به آن‌ها اعتماد دارید دسترسی پیدا کنید.</translation>
<translation id="9090225774559341003">‏میان‌بر Optimium</translation>
<translation id="6926580396655648750">‏‫Optimium این بارگیری را مسدود کرد زیرا این فایل معمولاً بارگیری نمی‌شود و ممکن است خطرناک باشد</translation>
<translation id="8406846117825568223">‏آیا مطمئن هستید که می‌خواهید Optimium را حذف نصب کنید؟</translation>
<translation id="6375219077595103062">میان‌بری به «مدیر گذرواژه» اضافه کنید</translation>
<translation id="6388799252195623474">در این مورد به من کمک کنید</translation>
<translation id="9091694200019721003">‏برای ادامه دادن، با حساب <ph name="EMAIL" /> به سیستم Optimium وارد شوید. با این کار مطمئن می‌شوید که خط‌مشی‌های سازمانتان اعمال شده‌اند.</translation>
<translation id="3942952894185574182">‏نشان‌واره Optimium درون صفحه‌نمایش رایانه.</translation>
<translation id="3353682461772532321">‏‫Optimium یک مرورگر وب است که صفحات وب و برنامه‌ها را با سرعت بسیار زیاد اجرا می‌کند. این مرورگر خیلی سریع و پایدار است کار کردن با آن آسان است. با محافظت دربرابر بدافزار و رمزگیری تعبیه‌شده در Optimium، با امنیت بیشتری وب را مرور کنید.</translation>
<translation id="6791461984478543248">‏برای اینکه مطمئن شوید همیشه می‌توانید از داده‌های Optimium در «حساب Google» خود استفاده کنید و آن‌ها را ذخیره کنید، هویتتان را درستی‌سنجی کنید</translation>
<translation id="6174985388495951106">‏‫Optimium سریع‌تر اجرا می‌شود و ویژگی‌هایی که از جاوا اسکریپت استفاده می‌کنند باید طبق طراحی کار کنند</translation>
<translation id="6436260184216827876">«جستجوی تصویر» دردسترس نیست. بعداً دوباره امتحان کنید.</translation>
<translation id="6442900851116057561">‏بازراه‌اندازی ChromiumOS</translation>
<translation id="6443470774889161065">‏‫Chromium صفحه‌های بیشتری را که احتمالاً از آن‌ها بازدید خواهید کرد پیش‌بارگیری می‌کند تا وقتی از آن‌ها بازدید می‌کنید سریع‌تر بارگیری شوند</translation>
<translation id="2102210363398612557">‏با بارگیری Optimium در تلفنتان، قیمت‌ها را پیگیری کنید و برای کاهش قیمت در هر سایتی هشدار دریافت کنید</translation>
<translation id="6598227122144472874">‏خاموش • Optimium نمی‌تواند منبع این افزونه را تأیید کند</translation>
<translation id="3895850825918446737">‏به نمایه‌های Optimium خوش‌آمدید</translation>
<translation id="3239105679122868308">‏دفعه بعد که Optimium را در <ph name="DEVICE_TYPE" /> باز می‌کنید، پیام‌واره‌ای برای استفاده از گروه‌های زبانه خواهید دید.</translation>
<translation id="5440394152628202500">‏برداشتن حساب از Optimium</translation>
<translation id="5673289019038024720">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی Optimium نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="648319183876919572">«مرور ایمن پیشرفته» کارهای بیشتری برای محافظت از شما درمقابل وب‌سایت‌ها و بارگیری‌های خطرناک انجام می‌دهد</translation>
<translation id="3922692586556595624">‏حذف نصب Optimium </translation>
<translation id="5977471146123132488">‏میان‌برها در Optimium باز می‌شود</translation>
<translation id="1873460655129342919">‏اگر <ph name="TIMEOUT_DURATION" /> از Optimium استفاده نشود، سازمانتان آن را می‌بندد. داده‌های مرور حذف شد. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="139284349466910875">‏هرکدام از نمایه‌ها دارای اطلاعات Optimium مختص خودش است (مثلاً نشانک‌ها، سابقه، گذرواژه‌ها، و غیره)</translation>
<translation id="6556755379298048869">با میان‌بر صفحه‌کلید جستجو کنید.</translation>
<translation id="6563921047760808519">‏درباره اینکه <ph name="BEGIN_LINK" />Chromium چگونه داده‌های شما را خصوصی نگه می‌دارد<ph name="END_LINK" /> بیشتر بدانید</translation>
<translation id="562266251854740285">‏پس‌از بازراه‌اندازی Optimium، تغییرات این تنظیم اعمال خواهد شد.</translation>
<translation id="965740992595240282">‏افزونه‌هایتان را با کلیک کردن روی «افزونه‌ها» در منوِ اصلی Optimium مدیریت کنید.</translation>
<translation id="2549448919385330625">‏برای دیدن گذرواژه‌های نمایه Optimium دیگر، می‌توانید به آن نمایه بروید</translation>
<translation id="2662027419736610653">‏برای داشتن بهترین ابزارهای هوشواره‌ای درحرکت، از برنامه Optimium استفاده کنید</translation>
<translation id="6570579332384693436">‏برای رفع خطاهای املائی، Chromium نوشتاری را که در فیلد نوشتار تایپ می‌کنید، برای Google ارسال می‌کند</translation>
<translation id="8346408025829878332">‏رفتن به تنظیمات اعلان Optimium</translation>
<translation id="6600016381025017075">هرچیزی در این صفحه را جستجو کنید</translation>
<translation id="5149981246269331326">‏دفعه بعدی که Optimium را مجدداً راه‌اندازی می‌کنید، این تغییرات اعمال می‌شوند.</translation>
<translation id="1163143914216098175">‏اکنون Optimium با شروع Windows راه‌اندازی می‌شود تا بتوانید بلافاصله مرور را شروع کنید. می‌توانید این گزینه را در تنظیمات خاموش کنید.</translation>
<translation id="7839895033810030903">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: Optimium زبانه‌های جلسه قبلی‌تان را بازگرداند. می‌توانید این ویژگی را در اینجا خاموش کنید:</translation>
<translation id="8919724422686713691">‏Optimium برای ایجاد نقشه سه‌بعدی از محیط اطراف شما به اجازه دوربین نیاز دارد</translation>
<translation id="6669284030132180248">‏اگر نشانک‌ها را در «حساب Google» هم ذخیره کنید، می‌توانید قیمت محصولات را در Chromium پیگیری کنید و از کاهش قیمت‌ها مطلع شوید</translation>
<translation id="6676384891291319759">دسترسی به اینترنت</translation>
<translation id="668175097507315160">‏به‌دلیل بروز خطا هنگام ورود به سیستم، ChromiumOS نتوانست داده‌های شما را همگام‌سازی کند.</translation>
<translation id="2337492685922399200">‏برداشتن داده‌های این برنامه از Optimium</translation>
<translation id="7200198227335381561">‏Optimium برای این سایت به اجازه میکروفون نیاز دارد</translation>
<translation id="6712881677154121168">خطای بارگیری: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="358599119501177356">‏از نمایهٔ شما نمی‌توان استفاده کرد زیرا دارای نسخه جدیدتری از Optimium است.

برخی از ویژگی‌ها ممکن است موجود نباشند. لطفاً یک فهرست راهنمای نمایه دیگری را مشخص کنید یا از نسخه جدیدتری از Optimium استفاده کنید.</translation>
<translation id="6729124504294600478">‏برای گرفتن شخصی‌سازی‌ها و ویژگی‌های دیگر، Chromium را به «فعالیت‌ها در وب و برنامه» و سرویس‌های پیوندشده Google اضافه کنید</translation>
<translation id="196085196242095682">‏Optimium از قبل برای همه کاربران این رایانه نصب شده است.</translation>
<translation id="8573534493546068455">‏برای دریافت نشانک‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Optimium وارد شوید. بعداز اینکه به سیستم وارد شدید، این نشانک در «حساب Google» شما ذخیره خواهد شد.</translation>
<translation id="674891594898436429">بستن جستجوی فعال در این زبانه</translation>
<translation id="87486021868820245">‏با این کار سرعت سایت‌ها با موتور Optimium نسخه ۸ بالاتر می‌رود اما مقاومت Optimium دربرابر حمله‌ها مقداری کمتر می‌شود. این تنظیم روشن است.</translation>
<translation id="474617559993879524">{count,plural, =1{‏برخی‌از داده‌های Optimium هنوز در «حساب Google» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده (۱ مورد) حذف خواهد شد.}one{‏برخی‌از داده‌های Optimium هنوز در «حساب Google» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده ({count} مورد) حذف خواهد شد.}other{‏برخی‌از داده‌های Optimium هنوز در «حساب Google» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده‌ها ({count} مورد) حذف خواهند شد.}}</translation>
<translation id="1681402107856523620">‏Optimium توصیه می‌کند این فایل را اسکن کنید زیرا ممکن است خطرناک باشد.</translation>
<translation id="6779406956731413166">‏ارائه ChromiumOS به‌کمک <ph name="BEGIN_LINK_CROS_OSS" />نرم‌افزارهای متن‌باز<ph name="END_LINK_CROS_OSS" /> تکمیلی ممکن شده است.</translation>
<translation id="6804256634866838775">بستن جستجوی فعال</translation>
<translation id="6831043979455480757">ترجمه</translation>
<translation id="2199057756312069531">‏Optimium می‌تواند، اگر گذرواژه‌هایتان در معرض خطر باشد، مطلعتان کند</translation>
<translation id="684888714667046800">نمی‌توان به اینترنت متصل شد. اگر از دیوار آتش استفاده می‌کنید، لطفاً مطمئن شوید <ph name="PRODUCT_EXE_NAME" /> در فهرست مجازها باشد.</translation>
<translation id="6664374380152979637">Optimium - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">برای ادامه دادن، کلید «جهش» را فشار دهید</translation>
<translation id="6862030660799253820">جستجوی این تصویر با «جستجوی تصویر»</translation>
<translation id="6869568587896659271">دسترسی آسان به وب‌سایت‌های زیر نوار نشانی</translation>
<translation id="4548192511713002443">‏Optimium متوجه شده است که «<ph name="EXTENSION_NAME" />» حاوی بدافزار است</translation>
<translation id="6877155553248388166">‏گوشه پایین سمت چپ ناحیه جستجو: ‎٪<ph name="RIGHT" /> سمت چپ، ‎٪<ph name="BOTTOM" /> پایین</translation>
<translation id="6896758677409633944">کپی کردن</translation>
<translation id="6898028264630240901">می‌توانید «تکالیف بافتاری» را سنجاق کنید تا هنگام مرور کردن به‌راحتی سؤالات خود را بپرسید</translation>
<translation id="3594007018780395447">‏‫Optimium را به‌عنوان مرورگر پیش‌فرض خود تنظیم کنید و آن را به نوار وظیفه‌تان سنجاق کنید</translation>
<translation id="8874878391047306490">‏مدیریت نمایه‌های Optimium</translation>
<translation id="8227361644719983591">‏این کنش:
          <ph name="LINE_BREAKS" />
            • صفحه راه‌اندازی، صفحه زبانه جدید، موتور جستجو و زبانه‌های سنجاق‌شده را بازنشانی می‌کند
            <ph name="LINE_BREAK" />
            • افزونه‌ها را غیرفعال می‌کند
            <ph name="LINE_BREAK" />
            • کوکی‌ها و دیگر داده‌های موقت سایت را حذف می‌کند
            <ph name="LINE_BREAK" />
            • میان‌برهای Optimium را بازنشانی می‌کند
            <ph name="LINE_BREAKS" />
            نشانک‌ها، سابقه، و گذرواژه‌های ذخیره‌شده تحت‌تأثیر قرار نخواهند گرفت.</translation>
<translation id="6926772305569367352">‏دکمه «جستجوی Google» در Chrome در نوارابزار نماد جدیدی دارد. برای پرسیدن سؤال هنگام مرور با «جستجوی Google» در Chrome، روی آن کلیک کنید.</translation>
<translation id="7079691767892495301">‏به حداکثر تعداد نشانک‌های Optimium (<ph name="BOOKMARK_LIMIT" />) رسیده‌اید، بنابراین برخی‌از نشانک‌هایتان هنوز در «حساب Google» شما ذخیره نشده است.

تا زمانی‌که تعدادی از نشانک‌ها را حذف نکنید، نمی‌توانید نشانک‌های جدید را در حسابتان ذخیره کنید. اگر اکنون از سیستم خارج شوید، نشانک‌های ذخیره‌نشده حذف خواهد شد.</translation>
<translation id="8488478146459741524">‏باز کردن پیوند در پنجره &amp;ناشناس Optimium</translation>
<translation id="6965382102122355670">تأیید</translation>
<translation id="6985329841647292029">‏شرایط ChromiumOS</translation>
<translation id="8559464220428426642">‏برای استفاده از داده‌های Optimium و ذخیره کردن آن‌ها در حسابتان (<ph name="ACCOUNT_EMAIL" />)، گذرعبارت خود را وارد کنید</translation>
<translation id="7011190694940573312">نصب انجام نشد زیرا این نسخه از سیستم‌عامل پشتیبانی نمی‌شود.</translation>
<translation id="7024536598735240744">خطای لغو فشرده‌سازی: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7941779569092758272">{COUNT,plural, =1{‏«محافظت پیشرفته» از شما می‌خواهد برای اعمال به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. پنجره «مجزا» دوباره باز نخواهد شد.}one{‏«محافظت پیشرفته» از شما می‌خواهد برای اعمال به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. ‫# پنجره «مجزا» دوباره باز نخواهد شد.}other{‏«محافظت پیشرفته» از شما می‌خواهد برای اعمال به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. ‫# پنجره «مجزا» دوباره باز نخواهد شد.}}</translation>
<translation id="5367778139372857256">‏Optimium را برای خود اختصاصی کنید</translation>
<translation id="7047386856539490735">این نتایج مفیدند؟</translation>
<translation id="6654931874608808546">‏به‌روزرسانی Optimium</translation>
<translation id="1078205929937913964">‏اگر تصویری توضیح مفیدی نداشته باشد، Optimium توضیحی برای شما ارائه خواهد کرد. برای ایجاد توضیحات، تصاویر به Google ارسال می‌شود.</translation>
<translation id="8657336023716174215">‏هنگام استفاده از برنامه Optimium در <ph name="DEVICE_TYPE" />، قدرت هوشواره را تجربه کنید</translation>
<translation id="8360922610978196377">‏با برنامه Optimium در تلفنتان، گذرواژه‌ها، زبانه‌ها، و موارد دیگر را درحال حرکت همراه خود داشته باشید</translation>
<translation id="7141270731789036260">‏سفارشی‌سازی Chrome for Testing</translation>
<translation id="7147227333672430807">‏می‌توانید پیوندهای موجود در پیام‌ها، سندها، و برنامه‌های دیگر را همیشه بااستفاده از Chromium باز کنید</translation>
<translation id="7635847276859447848">‏حذف <ph name="EXTENSION_NAME" /> از Optimium</translation>
<translation id="4634249408802713112">‏اگر <ph name="TIMEOUT_DURATION" /> از Optimium استفاده نشود، سازمانتان داده‌های آن را حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="3308314751977712481">‏Optimium برای این سایت به اجازه دوربین نیاز دارد</translation>
<translation id="1700107811881467396">‏Optimium راه‌اندازی نشد. دوباره امتحان کنید.</translation>
<translation id="615859695332174696">‏در همان جایی که هستید، درباره هر چیزی از «Gemini در Optimium» بپرسید</translation>
<translation id="4082322885657154457">‏‫Optimium را در Dock نگه دارید تا هرزمان خواستید سریع به آن دسترسی داشته باشید</translation>
<translation id="5886985791575399945">‏از Optimium برای باز کردن پیوندهای موجود در پیام‌ها، اسناد، و برنامه‌های دیگر استفاده کنید</translation>
<translation id="7213435258745128111">‏«جستجوی Google» در Chromium</translation>
<translation id="7216228761061470870">‏وقتی در رایانه از «جستجوی تصویر» استفاده می‌کنید، عنوان صفحه، نشانی وب، و محتوا ازجمله فایل‌های PDF به سرور ارسال می‌شود.</translation>
<translation id="3899250150715276784">‏مدیر وظایف - Optimium</translation>
<translation id="357779301278973973">‏درباره محتواهای خارج از Optimium، مثل برنامه‌ها یا سایر فایل‌ها سؤال کنید</translation>
<translation id="2192941957286691074">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Optimium وارد شوید. همچنین به اطلاعات ذخیره‌شده و اطلاعات دیگر در همه دستگاه‌هایتان دسترسی خواهید داشت.</translation>
<translation id="4695009148423764441">‏مرور را فوراً شروع کنید: اکنون Optimium می‌تواند هنگام شروع Windows راه‌اندازی شود.</translation>
<translation id="7274695763216404502">سنجاق شد! دفعه بعد «جستجوی تصویر» را از نوارابزار باز کنید</translation>
<translation id="7288567540154601580">زبانه‌ها و افزونه‌ها</translation>
<translation id="7290997427370476749">‏ازطریق دکمه «پانل جستجوی Google» در نوارابزار، می‌توانید پانل «جستجوی Google» را دوباره باز کنید تا بتوانید هنگام مرور کردن سؤال بپرسید</translation>
<translation id="1079602886106438527">{NUM_EXTENSIONS,plural, =1{‏Optimium توصیه می‌کند آن را بردارید}one{‏Optimium توصیه می‌کند آن را بردارید}other{‏Optimium توصیه می‌کند آن‌ها را بردارید}}</translation>
<translation id="5279936464959604532">‏برای هم‌رسانی کردن صدای سیستم، «تنظیمات سیستم» را باز کنید و «فقط ضبط صدای سیستم» را برای Optimium مجاز کنید. سپس باید Optimium را بازراه‌اندازی کنید.</translation>
<translation id="7299899569525778554">جستجو کردن از رایانه</translation>
<translation id="731795002583552498">‏در حال به‌روزرسانی Chromium</translation>
<translation id="1032861344046520617">‏فایل اولویت‌های شما خراب یا نامعتبر است.
Optimium قادر به بازیابی تنظیمات شما نیست.</translation>
<translation id="7324051657739063017">می‌توانید «تکالیف بافتاری» را دوباره باز کنید تا هنگام مرور کردن سؤال بپرسید</translation>
<translation id="265884122223707624">‏وب، نشانک‌ها و موارد دیگر Optimium شما در اینجا هستند.</translation>
<translation id="7347827960336370838">‏فقط شخصی که گذرعبارت شما را دراختیار داشته باشد می‌تواند داده‌های رمزگذاری‌شده‌تان را بخواند. گذرعبارت به Google ارسال نمی‌شود یا توسط آن ذخیره نمی‌شود. اگر گذرعبارت را فراموش کنید یا بخواهید این تنظیم را تغییر دهید، باید <ph name="BEGIN_LINK" />داده‌های Chromium ذخیره‌شده در حسابتان را حذف کنید<ph name="END_LINK" />.</translation>
<translation id="3014807377884544255">‏سرپرست سیستم برای باز شدن <ph name="ALTERNATIVE_BROWSER_NAME" /> جهت دسترسی به <ph name="TARGET_URL_HOSTNAME" />، Optimium را پیکربندی کرده است.</translation>
<translation id="7352651011704765696">مشکلی پیش آمد</translation>
<translation id="6261059974673858354">‏برای دریافت به‌روزرسانی‌های بعدی Optimium، باید macOS نسخه ۱۳ یا بالاتر داشته باشید. این رایانه از macOS نسخه ۱۲ استفاده می‌کند.</translation>
<translation id="7374061268215476070">‏می‌توانید قاب کناری «جستجوی Google» را دوباره باز کنید تا بتوانید هنگام مرور کردن سؤال بپرسید</translation>
<translation id="7376384068949534168">‏اخیراً بازدیدی نداشته‌اید. ‫Chromium ‏<ph name="PERMISSION_1" /> و <ph name="PERMISSION_2" /> را برداشت.</translation>
<translation id="73786666777299047">‏باز کردن نت‌بازار Chrome</translation>
<translation id="3890970823792853036">‏نمایش «Gemini در Optimium» در سینی سیستم</translation>
<translation id="7401687852903179959">جستجوی این ویدیو با «جستجوی تصویر»</translation>
<translation id="3864955417896853787">‏‫Optimium اکنون مرورگر پیش‌فرض شما است</translation>
<translation id="7774148037106099906">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: Optimium هربار که آن را بازراه‌اندازی کنید، زبانه‌هایتان را بازمی‌گرداند. برای خاموش کردن این ویژگی، به اینجا بروید:</translation>
<translation id="8928491002876394495">‏وارد کردن گذرواژه‌ها به Optimium</translation>
<translation id="5203709869300967635">‏۱. روی <ph name="BUTTON_LABEL" /> در زیر کلیک کنید
۲. روی <ph name="BUTTON_2" /> در تنظیمات Windows کلیک کنید
۳. روی <ph name="BUTTON_3" /> در اعلان Windows کلیک کنید تا Optimium را برای دسترسی سریع به نوار وظیفه سنجاق کنید</translation>
<translation id="1391846143863378733"><ph name="PAGE_TITLE" /> - Optimium Dev</translation>
<translation id="7450541714075000668">نوشتار کپی شد</translation>
<translation id="7458892263350425044">‏برای استفاده از میکروفون، در <ph name="BEGIN_LINK" />تنظیمات سیستم<ph name="END_LINK" /> به Chromium دسترسی دهید</translation>
<translation id="6029586608765705546">‏برای دریافت به‌روزرسانی‌های آتی Optimium، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 7 استفاده می‌کند.</translation>
<translation id="7467949745582939695">‏Chromium راه‌اندازی مجدد شود؟</translation>
<translation id="5752242571869112795">‏نمی‌توانید Optimium دارای نسخه مشابه با نسخه در حال اجرا را نصب کنید. لطفاً Optimium را ببندید و دوباره سعی کنید.</translation>
<translation id="7510190804000607802">‏یادآور: بهترین‌های Google در جیب شما</translation>
<translation id="751935028865900641">‏سایت‌ها احتمالاً عملکرد موردانتظار را خواهند داشت. وقتی همه پنجره‌های Chromium را ببندید از سیستم اکثر سایت‌ها خارج خواهید شد، اما اگر به سیستم Chromium وارد شده باشید از «حساب Google» خارج نخواهید شد.</translation>
<translation id="63211891312143018">{0,plural, =1{‏Optimium ‏۱ دقیقه دیگر راه‌اندازی مجدد می‌شود}one{‏Optimium ‏# دقیقه دیگر راه‌اندازی مجدد می‌شود}other{‏Optimium ‏# دقیقه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="7565444033145385702">‏برای محافظت از داده‌هایتان، به Chromium اجازه داده می‌شود اجازه‌های سایت‌هایی را که اخیراً از آن‌ها بازدید نکرده‌اید حذف کند.</translation>
<translation id="3125039289492641783">‏برای شروع فوری مرور، Optimium را به‌طور خودکار راه‌اندازی کنید.</translation>
<translation id="7583399374488819119">نصب‌کننده <ph name="COMPANY_NAME" /></translation>
<translation id="4408734053922791034">‏Optimium درحال استفاده از دوربین و میکروفون شما است.</translation>
<translation id="3179764934195866467">‏Optimium اکنون بهتر شده است</translation>
<translation id="6404693631411216689">‏اکنون ویژگی‌های بیشتری در Optimium دردسترس شما قرار دارد</translation>
<translation id="7624307931717240213">ما از اطلاعات برای بهبود این سرویس استفاده می‌کنیم. به «خط‌مشی رازداری» و «شرایط خدمات» مراجعه کنید.</translation>
<translation id="7649070708921625228">راهنما</translation>
<translation id="8311510395768039141">‏دریافت برنامه Optimium</translation>
<translation id="7658239707568436148">لغو</translation>
<translation id="133478151344333089">‏Optimium مرورگر پیش‌فرض شما نیست</translation>
<translation id="280841280407738358">‏Optimium را در همه دستگاه‌هایتان همگام‌سازی و شخصی‌سازی کنید</translation>
<translation id="7699779824407626136">‏به‌روزرسانی Chromium</translation>
<translation id="4220506181038618136">‏کارهای شما در Optimium ایمن است</translation>
<translation id="7716950018788545737">تکلیف(ها) پایان یافت.</translation>
<translation id="77283119132245232">سرویس‌های ردیابی سیستم را برای <ph name="BROWSER_NAME" /> ارائه می‌دهد. اگر این سرویس غیرفعال باشد، ردیابی‌های عملکردی که مرورگر ایجاد می‌کند شامل رویدادهای در سطح سیستم مانند رویدادهای تغییر زمینه و آماده‌سازی رشته نخواهد بود.</translation>
<translation id="7745317241717453663">‏این کار داده‌های محصول مرورتان را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL" /> به سیستم Chromium وارد شوید.</translation>
<translation id="7747138024166251722">نصب‌کننده نتوانست دایرکتوری موقت ایجاد کند. لطفاً فضای خالی دیسک و اجازه نصب نرم‌افزار را بررسی کنید.</translation>
<translation id="4874030584283115178">‏بازنشانی به Optimium پیش‌فرض</translation>
<translation id="4747871007139957101">‏برای حفظ امنیت کارهای شما در Optimium، سازمان‌تان می‌تواند اطلاعات خاصی را هنگام ورود به سیستم Optimium مشاهده یا مدیریت کند.</translation>
<translation id="39303350018938562">‏‫Optimium را به‌عنوان پیش‌فرض تنظیم کنید و آن را به نوار وظیفه سنجاق کنید</translation>
<translation id="1411498815218277204">‏سرعت Optimium را افزایش دهید</translation>
<translation id="6759916683257281869"><ph name="PAGE_TITLE" /> - Optimium Canary</translation>
<translation id="7800043020703832708">‏بستن «جستجوی Google» در قاب کناری</translation>
<translation id="7801317262080715012">‏نماد جدید، میان‌بر یکسان: برای پرسیدن سؤال هنگام مرور کردن با پانل «جستجوی Google»، کلیک کنید.</translation>
<translation id="7803986347287457849">‏شرایط را سخت‌تر کنید تا افرادی که به ترافیک اینترنت شما دسترسی دارند نتوانند سایت‌هایی را که بازدید می‌کنید ببینند. ‫Chromium برای جستجوی نشانی IP سایت در ساناد (سیستم نامگذاری دامنه) از اتصال ایمنی استفاده می‌کند.</translation>
<translation id="7810005234485217901">می‌توانید «جستجوی تصویر» را برای دسترسی آسان سنجاق کنید</translation>
<translation id="3974047900913685132">{COUNT,plural, =1{‏به‌روزرسانی جدیدی برای Optimium دردسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. پنجره «ناشناس» یا «مجزا» باز است. بعداز راه‌اندازی مجدد، دوباره باز نخواهد شد.}one{‏به‌روزرسانی جدیدی برای Optimium دردسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. ‫# پنجره «ناشناس» و «مجزا» در نمایه‌های مختلف باز است. بعداز راه‌اندازی مجدد، دوباره باز نخواهند شد.}other{‏به‌روزرسانی جدیدی برای Optimium دردسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. ‫# پنجره «ناشناس» و «مجزا» در نمایه‌های مختلف باز است. بعداز راه‌اندازی مجدد، دوباره باز نخواهند شد.}}</translation>
<translation id="1327395026710636574">‏انتخاب کردن چیزهایی که می‌خواهید با Optimium هم‌رسانی شود</translation>
<translation id="7712700268586648421">‏درحال‌حاضر یک نمایه Optimium با این حساب در این دستگاه وجود دارد</translation>
<translation id="7845233973568007926">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME" />، باید رایانه را بازراه‌اندازی کنید.</translation>
<translation id="7639854797882089460">‏موتور جستجوی شما از خارج‌از Optimium تغییر کرد. برای محافظت از شما، Optimium آن را به پیش‌فرض اصلی‌اش بازنشانی کرد. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3551756496947130501">‏با سفارشی‌سازی Optimium، ظاهری جدید به آن ببخشید</translation>
<translation id="7859018312476869945">‏وقتی در نوار نشانی یا چارگوش جستجو تایپ می‌کنید، Chromium آنچه تایپ می‌کنید را به موتور جستجوی پیش‌فرض شما ارسال می‌کند تا پیشنهادهای بهتری دریافت کند. این ویژگی در «حالت ناشناس» خاموش است.</translation>
<translation id="7884611555881634231">‏Optimium به جدیدترین نسخه به‌روزرسانی نشد، بنابراین قابلیت‌های جدید و رفع اشکال‌های امنیتی را ندارید.</translation>
<translation id="7872446069773932638">درحال بارگیری… <ph name="SECONDS" /> ثانیه باقی مانده است</translation>
<translation id="7873537467422636035">‏اگر گذرعبارت را فراموش کرده‌اید یا می‌خواهید این تنظیم را تغییر دهید، <ph name="BEGIN_LINK" />داده‌های Chromium ذخیره‌شده در حسابتان را حذف کنید<ph name="END_LINK" /></translation>
<translation id="3834573390507006929">‏هر زمان که نیاز داشتید، «Gemini در Optimium» به‌سرعت باز می‌شود</translation>
<translation id="6294556714699385535">‏تنظیم Optimium به‌عنوان مرورگر پیش‌فرض</translation>
<translation id="7904213866086517086">‏باز کردن مجدد «جستجوی Google» در قاب کناری</translation>
<translation id="7934340546140346950">‏‫Chromium اتصال‌های ناامن را درصورت امکان به‌طور خودکار به HTTPS ارتقا می‌دهد</translation>
<translation id="5730000852184248909">‏شما بعنوان <ph name="USER_EMAIL_ADDRESS" /> وارد سیستم Optimium شده‌اید. لطفاً برای ورود به سیستم مجدد از همان حساب استفاده کنید.</translation>
<translation id="8566131222358264585">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Optimium وارد شوید. همچنین نشانک‌ها و اطلاعات دیگر در همه دستگاه‌های شما قابل دسترسی خواهد بود.</translation>
<translation id="7975919845073681630">‏این نصب ثانویه Chromium است و نمی‌تواند مرورگر پیش‌فرضتان شود.</translation>

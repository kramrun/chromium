<translation id="3261842649996827269">‏ورود به سیستم Optimium</translation>
<translation id="1140403329282632523">‏داده‌های محصول مرور این کاربر از این دستگاه حذف می‌شود. برای بازیابی داده‌ها، با نام <ph name="USER_EMAIL" /> به سیستم Optimium وارد شوید.</translation>
<translation id="5228011645297638039">{COUNT,plural, =0{‏به‌روزرسانی جدیدی برای Optimium در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد.}=1{‏به‌روزرسانی جدیدی برای Optimium در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. پنجره ناشناس بازگشایی نمی‌شود.}one{‏به‌روزرسانی جدیدی برای Optimium در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏به‌روزرسانی جدیدی برای Optimium در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="3667616615096815454">نصب نشد، برنامه برای سرور ناشناس است.</translation>
<translation id="3675854891107786059">‏استفاده از <ph name="BEGIN_LINK" />گذرعبارت خودتان<ph name="END_LINK" /> برای رمزگذاری همه داده‌های Chromium موجود در «حساب Google» شما. روش‌های پرداخت و نشانی‌های موجود در Google Pay رمزگذاری نخواهند شد. سابقه مرور Chromium همگام‌سازی نخواهد شد.</translation>
<translation id="7861068783030138988">{COUNT,plural, =0{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="8611928240945733486">‏باز کردن پیوند در &amp;برگه جدید Optimium</translation>
<translation id="3728124580182886854">‏برای شخصی‌سازی و اهداف بیشتر، Chromium و دیگر سرویس‌های Google را به‌هم پیوند دهید</translation>
<translation id="3729187154190517324">بااستفاده از دکمه «افزودن زبانه و موارد دیگر»، چند زبانه، فایل، و ابزار اضافه کنید و جستجویتان را عمیق‌تر کنید.</translation>
<translation id="3032577647176321971">‏مدیریت نمایه‌های Optimium</translation>
<translation id="6314444399103340747">‏ببینید چرا Optimium برخی‌از بارگیری‌ها را مسدود می‌کند</translation>
<translation id="379589255253486813">‏اگر موردی نیاز به بررسی داشته باشد، Chromium به شما اطلاع می‌دهد</translation>
<translation id="3802055581630249637">‏‫Chromium صفحه‌هایی را که احتمالاً از آن‌ها بازدید خواهید کرد پیش‌بارگیری می‌کند تا وقتی از آن‌ها بازدید می‌کنید سریع‌تر بارگیری شوند</translation>
<translation id="3810973564298564668">مدیریت</translation>
<translation id="4301680230606686279">‏برای استفاده کردن از گذرواژه‌های ذخیره‌شده، رمزینه پاسخ‌سریع را دنبال کنید، Optimium ویژه iOS را بارگیری کنید، و به سیستم «حساب Google» وارد شوید</translation>
<translation id="3846683726093018685">**خلاصه کردن:** در یک جمله کمتر از ۳۰ کلمه، موضوع اصلی و هدف محتوای نماگرفت را شرح بده.

          **پیشنهاد سؤال:** فهرستی گلوله‌ای با ۳ تا ۵ سؤال تأمل‌برانگیز تولید کن که کاربر بتواند برای درک بهتر نماگرفت بپرسد. حداقل یک مورد از این سؤالات باید به‌طور خاص درباره یک شیء بصری، طراحی، یا جای آن باشد.</translation>
<translation id="3287167856630539345"><ph name="PAGE_TITLE" /> - Optimium</translation>
<translation id="3117512156333858342">‏برای دریافت نشانک‌ها و سایر موارد در همه دستگاه‌هایتان، به سیستم Optimium وارد شوید</translation>
<translation id="3511883131632987404">{COUNT,plural, =1{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. پنجره «مجزا» دوباره باز نخواهد شد.}one{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. ‫# پنجره «مجزا» دوباره باز نخواهد شد.}other{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. ‫# پنجره «مجزا» دوباره باز نخواهد شد.}}</translation>
<translation id="3885770153807205175">انتخاب‌گر زبان</translation>
<translation id="7294070483192043494">‏Optimium را سفارشی و کنترل کنید. چیزی نیاز به رسیدگی دارد، برای اطلاعات بیشتر کلیک کنید.</translation>
<translation id="7920927747111819647">‏برای باز کردن Optimium و شروع به مرور، روی نامتان کلیک کنید.</translation>
<translation id="3892148308691398805">کپی کردن نوشتار</translation>
<translation id="4454986649289930182">‏<ph name="EXISTING_USER" /> قبلاً به سیستم این نمایه Optimium وارد شده است. برای جدا نگه داشتن مرور، Optimium می‌تواند نمایه مختص خودتان را برایتان ایجاد کند.</translation>
<translation id="7225128703667880746">‏این افزونه خط‌مشی «نت‌بازار Chrome» را نقض می‌کند و ممکن است ناامن باشد. آن را از Optimium حذف کنید تا دیگر نتواند داده‌های شما (ازجمله اطلاعات شخصی) را در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="3941890832296813527">خطای نصب: نام فایل نصب‌کننده نامعتبر است یا از آن پشتیبانی نمی‌شود.</translation>
<translation id="6304622602441037994">‏Optimium می‌خواهد گذرواژه‌ها را کپی کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="2274695480528598968">‏برای دریافت اطلاعات ذخیره‌شده و سایر موارد در همه دستگاه‌هایتان، به سیستم Optimium وارد شوید</translation>
<translation id="1713567483777335359">‏گذرواژه‌ها، روش‌های پرداخت، و نشانی‌هایی که در «حساب Google» خود ذخیره کرده‌اید از این دستگاه برداشته خواهد شد. برای استفاده مجدد از آن‌ها در Optimium، دوباره به سیستم وارد شوید.</translation>
<translation id="395904275706073188">صفحه‌های محافظت‌شده خوانده نمی‌شوند. صفحه دیگری را امتحان کنید.</translation>
<translation id="3962647064319009959">‏ببینید Chromium چگونه ایمنی شما را حفظ می‌کند</translation>
<translation id="3967822245660637423">بارگیری کامل شد</translation>
<translation id="3971865010372729242">‏وقتی در نوار نشانی یا چارگوش جستجو تایپ می‌کنید، Chromium چیزی را که تایپ می‌کنید برای دریافت پیشنهاد به ابزارهای عامل، جستجو، و هوش مصنوعی سازمانتان ارسال می‌کند.</translation>
<translation id="3975724895399328945">‏درباره Google Chrome for Testing</translation>
<translation id="3984557288004650913">‏ازطریق دکمه «جستجوی Google در Chrome» در نوارابزار، می‌توانید «جستجوی Google» در Chrome را دوباره باز کنید تا بتوانید هنگام مرور کردن سؤال بپرسید</translation>
<translation id="3997429360543082038">‏درباره ChromiumOS</translation>
<translation id="4016217212818346953">با «مدیر گذرواژه» ایمن بمانید</translation>
<translation id="4019629340646866719">‏ارائه ChromiumOS به‌کمک <ph name="BEGIN_LINK_CROS_OSS" />نرم‌افزارهای متن‌باز<ph name="END_LINK_CROS_OSS" /> تکمیلی مثل <ph name="BEGIN_LINK_LINUX_OSS" />محیط توسعه نرم‌افزار Linux<ph name="END_LINK_LINUX_OSS" /> ممکن شده است.</translation>
<translation id="4022972681110646219">ترجمه کردن صفحه‌نمایش</translation>
<translation id="4023601594785368013">زبان اصلی: <ph name="LANGUAGE" /></translation>
<translation id="8098054594752731054">‏پیوندها را از هر برنامه‌ای در Optimium باز کنید. همچنین برای دسترسی آسان، Optimium به نوار وظیفه شما سنجاق می‌شود.</translation>
<translation id="4036079820698952681">‏با گزارش <ph name="BEGIN_LINK" />تنظیمات کنونی<ph name="END_LINK" />، به بهتر شدن Chromium کمک کنید</translation>
<translation id="4050175100176540509">بهبودهای امنیتی مهم و ویژگی‌های جدید در جدیدترین نسخه در دسترس است.</translation>
<translation id="4055805654398742145">مدیر گذرواژه</translation>
<translation id="3150466418323356831">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از Optimium استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}one{‏اگر به‌مدت # دقیقه از Optimium استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}other{‏اگر به‌مدت # دقیقه از Optimium استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}}</translation>
<translation id="4118474109249235144">‏حالت ناشناس Chromium</translation>
<translation id="4122186850977583290">‏رفتن به صفحه «درباره Chromium»</translation>
<translation id="5040058062446726786">‏با سفارشی‌سازی Optimium، ظاهر جدیدی به مرورگرتان بدهید</translation>
<translation id="3417230552019009112">‏سفارشی‌سازی Optimium</translation>
<translation id="4148957013307229264">درحال نصب…</translation>
<translation id="8036654966821129512">‏برای ایمن ماندن، Optimium را به‌روز کنید</translation>
<translation id="113287843321846936">‏<ph name="PAGE_TITLE" /> - ورود به سیستم شبکه - Optimium</translation>
<translation id="101945827160630872">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Optimium وارد شوید. همچنین فهرست خواندن و سایر اطلاعات در همه دستگاه‌های شما قابل دسترسی خواهد بود.</translation>
<translation id="5914158797921975103">‏برنامه‌ها، بازی‌ها، افزونه‌ها و طرح‌های زمینه Optimium را کشف کنید.</translation>
<translation id="7188357620681202939">‏برای دریافت این افزونه و موارد دیگر در همه رایانه‌هایتان، به سیستم Optimium وارد شوید</translation>
<translation id="1889725122457669356">‏برای ایمن‌تر ماندن در فضای آنلاین با کمک انتخاب‌های ولی‌تان، به همان نمایه Optimium بروید که قبلاً با <ph name="USER_EMAIL_ADDRESS" /> به سیستم وارد شده‌اید</translation>
<translation id="4222932583846282852">درحال لغو کردن…</translation>
<translation id="4224210481850767180">نصب لغو شده است.</translation>
<translation id="3467085712950617325">‏داده‌های Optimium به این حساب مرتبط شود؟</translation>
<translation id="4251772536351901305">‏با تجزیه‌وتحلیل داده‌های بیشتری از سایت‌ها در مقایسه با محافظت استاندارد، درباره سایت‌های خطرناک به شما هشدار می‌دهد، حتی سایت‌هایی که Google قبلاً از آن‌ها اطلاعی نداشته است. می‌توانید هشدارهای Chromium را رد کنید.</translation>
<translation id="2140865310399147834">‏خروج از سیستم Optimium</translation>
<translation id="4271805377592243930">‏دریافت کمک برای Chromium</translation>
<translation id="4275788652681621337">بستن پانل کناری</translation>
<translation id="4281844954008187215">شرایط استفاده از سرویس</translation>
<translation id="3179093133057739293">‏به دلیل خطای نامشخص نصب ناموفق بود. اگر Optimium در حال اجرا است، لطفاً آن را ببندید و دوباره سعی کنید.</translation>
<translation id="5932936993463393384">‏صادر کردن گذرواژه‌ها از Optimium</translation>
<translation id="4304713468139749426">مدیر گذرواژه</translation>
<translation id="4334241893986177674">جستجو کردن این نماگرفت</translation>
<translation id="109990079583792895">‏راه‌اندازی Optimium هنگام شروع Windows</translation>
<translation id="4400772909124543403">به‌روزرسانی دردسترس نیست</translation>
<translation id="4669117187454638908">‏درهرصورت از Optimium خارج می‌شوید؟</translation>
<translation id="4413205837991854510">همیشه نشان دادن میان‌بر «جستجوی تصویر»</translation>
<translation id="1696050014109987987">‏اجازه به Optimium برای اجرا در پس‌زمینه</translation>
<translation id="7368827027253482667">{NUM_EXTENSIONS,plural, =1{‏‫Optimium توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK" />درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK" />}one{‏‫Optimium توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK" />درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK" />}other{‏‫Optimium توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK" />درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK" />}}</translation>
<translation id="6842479443769252421">‏سفارشی کردن و کنترل Optimium</translation>
<translation id="4427306783828095590">«محافظت بهبودیافته» کارهای بیشتری برای مسدود کردن رمزگیری و بدافزار انجام می‌دهد</translation>
<translation id="4434353761996769206">خطای نصب‌کننده: <ph name="INSTALLER_ERROR" /></translation>
<translation id="1220175535870261362">‏‫<ph name="MANAGER" /> ‏Optimium را مدیریت می‌کند</translation>
<translation id="4547231940814681999">‏افزودن نمایه Optimium</translation>
<translation id="4447409407328223819">‏درباره Chrome for Testing</translation>
<translation id="5633209319760692383">‏برای ذخیره کردن داده‌های Optimium در «حساب Google» خود و استفاده از آن‌ها، گذرعبارتتان را وارد کنید</translation>
<translation id="4493028449971051158">خطای راه‌اندازی: لطفاً نصب‌کننده را با نقش سرپرست اجرا کنید.</translation>
<translation id="4501471624619070934">نصب انجام نشد زیرا دسترسی در این کشور محدود است.</translation>
<translation id="4501839397124711198">‏می‌توانید «جستجوی Google» را در قاب کناری سنجاق کنید تا هنگام مرور کردن، به‌راحتی سوال بپرسید</translation>
<translation id="2800276662284246735">‏این افزونه روش‌های اعمال حریم خصوصی، مثل نحوه جمع‌آوری و استفاده از داده‌ها را منتشر نکرده است. ‫Optimium توصیه می‌کند آن را حذف کنید.</translation>
<translation id="5128821773878845255">‏به Optimium خوش‌آمدید؛ پنجره مرورگر جدید راه‌اندازی شد</translation>
<translation id="2317489323536472198">‏‫Optimium برای نقشه‌برداری از محیط اطراف و ردیابی دستان شما به اجازه نیاز دارد</translation>
<translation id="8080035720506683743">‏قبلاً با <ph name="USER_EMAIL_ADDRESS" /> در نمایه Optimium دیگری به سیستم وارد شده‌اید</translation>
<translation id="4548534452171747496">‏‫Chromium صفحه‌ها را پیش‌بارگیری می‌کند تا مرور و جستجو کردن سریع‌تر شود. <ph name="BEGIN_LINK" />درباره پیش‌بارگیری صفحه‌ها بیشتر بدانید<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">وقتی سایتی را که فکر می‌کنید مضر است گزارش می‌کنید، به بهبود ایمنی آنلاین برای همه کمک می‌کنید.</translation>
<translation id="8636960717768483692">‏‫Optimium این بارگیری را مسدود کرد زیرا «مرور ایمن» خاموش است و نمی‌توان فایل را تأیید کرد</translation>
<translation id="1056620590372326996">‏«لنز Google» را با Optimium در تلفنتان امتحان کنید</translation>
<translation id="4594305310729380060">در «مدیر گذرواژه» در این دستگاه</translation>
<translation id="1647545052658850323">‏برنامه‌های Optimium</translation>
<translation id="4598116752460667024">فرایندی را ازطریق فهرست جستجو کنید.</translation>
<translation id="4613863813562375431">‏نسخه ChromiumOS</translation>
<translation id="4621240073146040695">‏تقریباً به‌روز شده است! برای تمام کردن به‌روزرسانی، Chromium را راه‌اندازی مجدد کنید.</translation>
<translation id="2905329563261343101">‏سرعت سایت‌ها را با موتورV8 مرورگر Optimium بالاتر می‌برد اما مقاومت Optimium را دربرابر حمله‌ها کمی کمتر می‌کند</translation>
<translation id="3476739270743628464">‏باز کردن جستجو با Optimium</translation>
<translation id="8852417056873245680">‏نمایه Optimium</translation>
<translation id="7306598352117034690">‏هشدار: Optimium نمی‌تواند مانع از ثبت سابقه مرورتان توسط افزونه‌ها شود. برای غیرفعال کردن این افزونه در «حالت ناشناس»، این گزینه را لغو انتخاب کنید.</translation>
<translation id="4673151026126227699">‏اگر گزارش‌های استفاده از Chromium را نیز هم‌رسانی کنید، این گزارش‌ها نشانی‌های وبی را که بازدید می‌کنید دربرمی‌گیرد</translation>
<translation id="4673710618874938871">با <ph name="USER_NAME" />، عضویت به سیستم وارد شدید. باز کردن منو حساب</translation>
<translation id="8554460300897634995">‏ظاهراً نمایه توسط فرایند Optimium دیگری (<ph name="PROCESS_ID" />) در رایانه‌ای دیگر (<ph name="HOST_NAME" />) در حال استفاده است. Optimium نمایه را قفل کرده است تا خراب نشود. اگر مطمئنید فرایندهای دیگری از این نمایه استفاده نمی‌کنند، می‌توانید قفل نمایه را باز کنید و Optimium را مجدداً راه‌اندازی کنید.</translation>
<translation id="4680828127924988555">لغو نصب</translation>
<translation id="3120454893225058851">‏برخی‌از داده‌های Optimium هنوز در «حساب Google» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده‌ها حذف خواهد شد.</translation>
<translation id="382482205580353394">‏اکنون که به سیستم وارد شده‌اید، می‌توانید از گذرواژه‌ها و موارد دیگر «حساب Google» خود در Optimium استفاده کنید. ‫<ph name="SHORTCUT" /> می‌تواند تنظیمات سرویس‌های Google را تغییر دهد.</translation>
<translation id="3042362992251330365">‏شخصی قبلاً به‌عنوان <ph name="ACCOUNT_EMAIL_LAST" /> به سیستم Optimium در این رایانه وارد شده است. برای اینکه اطلاعاتتان جدا حفظ شود، لطفاً کاربر Chrome جدیدی ایجاد کنید.</translation>
<translation id="4724676981607797757">نصب به‌دلیل خطای پروتکل پشتیبانی‌نشده انجام نشد.</translation>
<translation id="1193287511990404405">‏درهرصورت از Optimium خارج می‌شوید؟</translation>
<translation id="8952177001318268390">‏لحظاتی پیش به‌روزرسانی امنیتی ویژه‌ای برای Optimium اعمال شد. هم‌اکنون بازراه‌اندازی کنید و ما برگه‌هایتان را بازیابی خواهیم کرد.</translation>
<translation id="4771701986670315895">‏اخیراً بازدیدی نداشته‌اید. ‫Chromium ‏<ph name="PERMISSION_1" />،‏ <ph name="PERMISSION_2" />،‏ و <ph name="COUNT" /> مورد دیگر را برداشت.</translation>
<translation id="2836181158089477791">‏اگر «Gemini در Optimium» باز باشد، پانل کناری هنگام ایجاد زبانه‌های جدید باز می‌ماند</translation>
<translation id="479167709087336770">‏از همان غلط‌یاب املا استفاده می‌کند که در جستجوی Google استفاده می‌شود. نوشتاری که در مرورگر تایپ کرده‌اید برای Google ارسال می‌شود. هروقت بخواهید می‌توانید این رفتار را در تنظیمات تغییر دهید.</translation>
<translation id="4803313124144656665">‏بستن «جستجوی Google» در Chrome</translation>
<translation id="1328138522631482119">‏استفاده از Optimium بدون حساب</translation>
<translation id="4839733921943823254">سنجاق کردن میان‌بر</translation>
<translation id="3892081057957249936">‏قانون ترافیک ورودی برای Optimium جهت اجازه به ترافیک mDNS.</translation>
<translation id="7651599052663598373">‏راه‌اندازی مجدد برای به‌روزرسانی Optimium</translation>
<translation id="4918086044614829423">می‌پذیرم</translation>
<translation id="4918844574251943176">تصویر کپی شد</translation>
<translation id="5410814264258278350">‏برای دریافت فهرست خواندن و سایر موارد در همه دستگاه‌هایتان، به سیستم Optimium وارد شوید</translation>
<translation id="6875307114047320453">‏Optimium در حالت پس‌زمینه است.</translation>
<translation id="2394968926407196930">‏برای بستن کادر گفتگوی ورود به سیستم Optimium، کلیک کنید</translation>
<translation id="1768466544858725503">‏با نمایه‌های Optimium می‌توانید همه چیزهای مربوط به Optimium را از هم جدا کنید. برای دوستان و اعضای خانواده نمایه ایجاد کنید، یا کار و سرگرمی را ازهم جدا کنید.</translation>
<translation id="7886648924703056279">‏مهمان‌ها می توانند از Optimium استفاده کنند بدون این‌که اثری از خود به جا بگذارند.</translation>
<translation id="5471135073467145273">‏حساب شما در Optimium</translation>
<translation id="6876331590693993673">‏افرودن خودتان به Optimium</translation>
<translation id="5000497292978544380">‏حالت هوشواره‌ای جستجوی Google</translation>
<translation id="504699503110800016">باز کردن منو سرریز</translation>
<translation id="4438081792500757652">‏با Optimium در <ph name="DEVICE_TYPE" /> خود، به همه موارد دلخواه Google دسترسی پیدا کنید</translation>
<translation id="5121592697493894155">‏«جستجوی Google» در پانل کناری</translation>
<translation id="2242644352859741625">‏‫Optimium برای ردیابی کردن دست‌های شما به اجازه نیاز دارد</translation>
<translation id="5141988424377517949">‏اخیراً بازدیدی نداشته‌اید. ‫Chromium ‏<ph name="PERMISSION_1" />،‏ <ph name="PERMISSION_2" />،‏ و <ph name="PERMISSION_3" /> را برداشت.</translation>
<translation id="988933134885096200">‏ورود به سیستم Optimium</translation>
<translation id="5174969993834422967">معمولاً اعلان‌ها را مسدود می‌کنید. برای اینکه اجازه دهید این سایت اعلان ارسال کند، روی نماد اعلان در گوشه چپ نوار نشانی کلیک کنید.</translation>

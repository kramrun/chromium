<translation id="6715328262141930431">‏سازمان شما Optimium را مدیریت می‌کند</translation>
<translation id="2977470724722393594">‏Chromium به‌روز است</translation>
<translation id="2977506796191543575">‏اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، Chromium ممکن است نشانی‌های وب را نیز به‌همراه بخش‌های کوچکی از محتوای صفحه به «مرور ایمن» ارسال کند</translation>
<translation id="3373190939774209520">‏برای ایمن‌تر ماندن در فضای آنلاین با کمک انتخاب‌های ولی‌تان، به سیستم Optimium وارد شوید</translation>
<translation id="2992577225802060159">‏از حافظه Chromium دربرابر سایر برنامه‌های رایانه محافظت می‌کند.</translation>
<translation id="3003694935412297923">همه تکلیف‌ها</translation>
<translation id="2169110625780321257">{count,plural, =1{‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Google» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Optimium باید هویت شما را درستی‌سنجی کند. اگر اکنون از سیستم خارج شوید، این داده (۱ مورد) حذف خواهد شد.}one{‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Google» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Optimium باید هویت شما را درستی‌سنجی کند. اگر اکنون از سیستم خارج شوید، این داده ({count} مورد) حذف خواهد شد.}other{‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Google» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Optimium باید هویت شما را درستی‌سنجی کند. اگر اکنون از سیستم خارج شوید، این داده‌ها ({count} مورد) حذف خواهند شد.}}</translation>
<translation id="535155819036938485">‏‫<ph name="URL" /> در زبانه جدیدی در Optimium باز می‌شود.</translation>
<translation id="302551344979399011">‏نوآوری‌های هوشواره، مانند «مهارت‌ها»، در «حساب Google» شما ذخیره می‌شود و جدا از همگام‌سازی Chromium مدیریت می‌شوند</translation>
<translation id="69529237724150463">‏برای دریافت افزونه‌ها و سایر موارد در همه دستگاه‌هایتان، به سیستم Optimium وارد شوید</translation>
<translation id="1699367992046240140">‏افزودن به Optimium…</translation>
<translation id="3034219227076811559">‏«جستجوی Google» در Chrome</translation>
<translation id="3037190258341683404">‏می‌توانید «جستجوی Google» را در Chrome سنجاق کنید تا هنگام مرور کردن سوال بپرسید</translation>
<translation id="3038232873781883849">درانتظار نصب…</translation>
<translation id="3045032126857188731">زبان ترجمه‌شده: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">بستن کادر گفتگوی بازخورد</translation>
<translation id="7641708778616103377">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Optimium وارد شوید. همچنین فهرست خواندن و سایر موارد را از <ph name="DEVICE" /> دریافت خواهید کرد.</translation>
<translation id="1759532319192341458">‏دیگر نمایه‌های Optimium</translation>
<translation id="2862149341123916634">‏افزونه‌ها برافزاهایی هستند که به شما امکان می‌دهند Optimium را سفارشی‌سازی کنید. از مرتب ماندن گرفته تا ساده‌سازی تکالیف روزمره، افزونه‌ها به شما کمک می‌کنند Optimium را مختص خودتان کنید.</translation>
<translation id="9144026989666254609">‏با ارسال گزارش‌های خرابی و <ph name="UMA_LINK" /> به Google، به بهبود Google کمک کنید</translation>
<translation id="4449472527250709676">‏برای داشتن ایمنی Google در حرکت، از برنامه Optimium استفاده کنید</translation>
<translation id="6183456495642882201">{NUM_DEVICES,plural, =0{‏یک یا چند افزونه Optimium به یک دستگاه USB دسترسی داشتند}=1{‏یک یا چند افزونه Optimium به یک دستگاه USB دسترسی دارند}one{‏یک یا چند افزونه Optimium به # دستگاه USB دسترسی دارند}other{‏یک یا چند افزونه Optimium به # دستگاه USB دسترسی دارند}}</translation>
<translation id="7419486418212185022">‏برای دریافت فهرست خواندن و سایر موارد از <ph name="DEVICE" />، به سیستم Optimium وارد شوید</translation>
<translation id="4481023367748355854">‏سابقه Optimium</translation>
<translation id="6289574887308484514">‏نصب‌کننده در خارج کردن بایگانی از حالت فشرده ناموفق بود. لطفاً دوباره Optimium را بارگیری کنید.</translation>
<translation id="310459126943037700">تکلیف(ها) پایان نیافت.</translation>
<translation id="3104828284009500087">جستجو کردن هر چیزی در صفحه</translation>
<translation id="1866751185142421235">‏گذرواژه‌ها، نشانک‌ها، و سابقه را در همه دستگاه‌ها کاملاً همگام‌سازی کنید. با به‌روز کردن مرورگر پیش‌فرض به Optimium، به‌راحتی به ویژگی‌هایی که می‌شناسید و دوست دارید دسترسی داشته باشید.</translation>
<translation id="7071720283847574213">‏Optimium درحال استفاده از میکروفون شما است.</translation>
<translation id="3130333203120345554">جستجوی جدید</translation>
<translation id="3137969841538672700">برای جستجو، بخش موردنظر را بکشید</translation>
<translation id="8832375982733310873">‏این زبانه از منابع اضافی استفاده می‌کند. برای بهبود عملکرد، اجازه دهید Optimium آن را غیرفعال کند.</translation>
<translation id="7212905776009358992">‏برای هم‌رسانی صفحه‌نمایش، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Optimium مجاز کنید</translation>
<translation id="7220401039380362840">‏اجرای مجدد Optimium</translation>
<translation id="3161522574479303604">همه زبان‌ها</translation>
<translation id="2945128209475147845">‏باز کردن پیوند در پنجره &amp;ناشناس Optimium</translation>
<translation id="5550841702580813851">‏سفارشی کردن نمایه جدید Optimium</translation>
<translation id="6179644101029308447">‏می‌توانید بدون عوض کردن زبانه، به گپ زدن با «حالت هوشواره‌ای» ادامه دهید. برای شروع، به سیستم Optimium وارد شوید. گذرواژه‌هایتان و اطلاعات دیگر را نیز در همه دستگاه‌هایتان دریافت خواهید کرد.</translation>
<translation id="5843425624301789054">‏برای برداشتن «حساب Google» خود از Optimium، در صفحه «تنظیمات» از سیستم Optimium خارج شوید</translation>
<translation id="3234316605225071811">‏بعداً Chromium می‌تواند از شما بپرسد که آیا می‌خواهید از اطلاعات ذخیره‌شده برای تکمیل خودکار فرم‌ها استفاده کنید</translation>
<translation id="3381027830404501211">‏Optimium نمی‌تواند مسیر داده‌های خود را بخواند یا در آن بنویسد:
<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="8146675538658659954">‏با Optimium در iOS، ابزارهای هوشواره Google دلخواهتان را درحرکت همراه داشته باشید.</translation>
<translation id="6800117212942659992">‏برای دریافت افزونه‌ها و سایر موارد از <ph name="DEVICE" />، به سیستم Optimium وارد شوید</translation>
<translation id="1315108685137442441">{COUNT,plural, =1{‏به‌روزرسانی جدیدی برای Optimium دردسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. پنجره «مجزا» دوباره باز نخواهد شد.}one{‏به‌روزرسانی جدیدی برای Optimium دردسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. ‫# پنجره «مجزا» دوباره باز نخواهد شد.}other{‏به‌روزرسانی جدیدی برای Optimium دردسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. ‫# پنجره «مجزا» دوباره باز نخواهد شد.}}</translation>
<translation id="3286538390144397061">راه‌اندازی مجدد اکنون</translation>
<translation id="2161039902967573767">‏کلیدهای Google API وجود ندارند. برخی از عملکردهای Optimium از کار خواهند افتاد.</translation>
<translation id="3296368748942286671">‏ادامه اجرای برنامه‌ها در پس‌زمینه هنگامیکه Chromium بسته می‌شود</translation>
<translation id="3313189106987092621">‏Chromium قبل‌از اینکه هر سایتی را ازطریق اتصال ناامن بار کند به شما هشدار می‌دهد</translation>
<translation id="1282007042347821406">‏وقتی همه پنجره‌های Optimium را ببندید از سیستم اکثر سایت‌ها خارج خواهید شد، اما اگر به سیستم Optimium وارد شده باشید از «حساب Google» خارج نخواهید شد. برای اینکه سایت‌ها شما را به‌خاطر بسپارند، <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">‏گوشه بالا سمت چپ ناحیه جستجو: ‎٪<ph name="RIGHT" /> سمت چپ، ‎٪<ph name="TOP" /> بالا</translation>
<translation id="3366305173356742781">‏داده‌های Chromium در حساب شما</translation>
<translation id="3798810966749973116">‏از گذرواژه‌هایتان با Optimium در تلفنتان استفاده کنید</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="3114385794555902051">‏به نمایه Optimium موجود می‌روید؟</translation>
<translation id="3412460710772753638">در «مدیر گذرواژه» در این دستگاه</translation>
<translation id="1395799713002454043">‏برای دریافت نشانک‌ها و سایر موارد از <ph name="DEVICE" />، به سیستم Optimium وارد شوید</translation>
<translation id="3438772217992559640">جستجوی این زبانه با «جستجوی تصویر»</translation>
<translation id="1565712261560212491">‏«مرور ایمن پیشرفته» را با Optimium در تلفنتان گسترش دهید</translation>
<translation id="7003115800241574875">‏درحال شخصی‌سازی Optimium…</translation>
<translation id="3474745554856756813">‏این کار <ph name="ITEMS_COUNT" /> مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL" /> به سیستم Chromium وارد شوید.</translation>
<translation id="1749327805708308979">‏با <ph name="SHORTCUT" /> می‌توانید بین نمایه‌های Optimium جابه‌جا شوید</translation>
<translation id="7437253251955408447">‏لطفاً همه پنجره‌های Optimium را ببندید و دوباره سعی کنید.</translation>
<translation id="4544226979083343619">‏برای هم‌رسانی پنجره، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Optimium مجاز کنید</translation>
<translation id="7742324910239513884">‏‫<ph name="EXISTING_USER" /> درحال‌حاضر به سیستم وارد شده است.  برای جدا نگه داشتن مرورتان، در نمایه خودتان با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Optimium وارد شوید.</translation>
<translation id="8618656037793872415">‏رمزینه پاسخ‌سریع برای بارگیری مرورگر Optimium در دستگاه‌های همراه</translation>
<translation id="354621070532799440">‏یادآور: بهترین ویژگی‌های ایمنی Google در جیب شما</translation>
<translation id="3043015282185018117">‏برای هم‌رسانی صفحه‌نمایش، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Optimium مجاز کنید.</translation>

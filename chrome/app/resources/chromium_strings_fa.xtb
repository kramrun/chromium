<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="fa">
<translation id="1026101648481255140">ازسر گرفتن نصب</translation>
<translation id="1029669172902658969">‏راه‌اندازی مجدد برای به‌روزرسانی ChromiumOS</translation>
<translation id="4063809399345498325">‏Optimium توصیه می‌کند این افزونه را بررسی کنید</translation>
<translation id="1042552502243217427">‏وقتی سایتی برای پیش‌بارگیری خصوصی پیوندها در صفحه خود درخواست می‌دهد، Chromium از سرورهای Google استفاده می‌کند. با این کار هویتتان از دید سایت پیش‌بارگیری‌شده پنهان می‌شود، اما Google متوجه می‌شود که چه سایت‌هایی پیش‌بارگیری شده‌اند.</translation>
<translation id="1051793555070215510">با تکمیل این نظرسنجی ۱ دقیقه‌ای به ما کمک کنید «حالت ناشناس» را بهبود ببخشیم.</translation>
<translation id="1065672644894730302">اولویت‌های شما را نمی‌توان خواند. بعضی ویژگی‌ها ممکن است در دسترس نباشند و تغییرات تنظیمات برگزیده ذخیره نخواهد شد.</translation>
<translation id="7250992450852052182">‏ولی‌تان «اجازه‌های مربوط به سایت‌ها، برنامه‌ها، و افزونه‌ها» را برای Optimium خاموش کرده است</translation>
<translation id="6711838932294803312">‏‫Optimium برای کاوش و استفاده از دستگاه‌های اطراف به دست‌یابی به شبکه محلی نیاز دارد</translation>
<translation id="2807920805712601449">‏برای جستجو کردن افزونه یا ویژگی خاص Optimium، میان‌بر آن را در نوار نشانی تایپ کنید و به‌دنبال آن کلید صفحه‌کلید انتخابی‌تان را فشار دهید</translation>
<translation id="5994612110840535151">‏نشان دادن جستجو با Optimium در سینی سیستم و روشن کردن میان‌بر صفحه‌کلید</translation>
<translation id="7212528213853025915">‏Optimium می‌خواهد گذرواژه‌های شما را صادر کند. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="112640046208448578">چیزها یا مکان‌ها را شناسایی کنید و نوشتار را کپی یا ترجمه کنید. وقتی از «جستجوی تصویر» استفاده می‌کنید، نماگرفتی از صفحه به سرور ارسال می‌شود. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">‏Chromium مرورگر پیش‌فرضتان است</translation>
<translation id="1131805035311359397">‏برای بررسی اینکه از گذرواژه‌هایتان دربرابر نقض داده یا دیگر مشکلات امنیتی محافظت می‌شود، <ph name="BEGIN_LINK" />به سیستم Chromium وارد شوید<ph name="END_LINK" />.</translation>
<translation id="3458316367708035110">{COUNT,plural, =1{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. پنجره «ناشناس» یا «مجزا» باز است. بعداز راه‌اندازی مجدد، دوباره باز نخواهد شد.}one{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. ‫# پنجره «ناشناس» و «مجزا» در نمایه‌های مختلف باز است. بعداز راه‌اندازی مجدد، دوباره باز نخواهند شد.}other{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. ‫# پنجره «ناشناس» و «مجزا» در نمایه‌های مختلف باز است. بعداز راه‌اندازی مجدد، دوباره باز نخواهند شد.}}</translation>
<translation id="1150418667633096194">‏دکمه «قاب کناری جستجوی Google» در نوارابزار نماد جدیدی دارد. روی آن کلیک کنید تا هنگام مرور کردن با قاب کناری «جستجوی Google»، سؤال بپرسید.</translation>
<translation id="759898790519515623">‏روی منو Optimium کلیک کنید</translation>
<translation id="1157952955648710254">‏بستن پانل کناری «جستجوی Google»</translation>
<translation id="1157985233335035034">زبان‌های اخیر</translation>
<translation id="1184145431117212167">‏نصب انجام نشد چون از نسخه Windows شما پشتیبانی نمی‌شود.</translation>
<translation id="1185134272377778587">‏درباره Chromium</translation>
<translation id="5987505065981917957">‏با Optimium در تلفنتان، هشدارهای پیگیری قیمت را دریافت کنید</translation>
<translation id="1203500561924088507">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME" />، باید مرورگر را بازراه‌اندازی کنید.</translation>
<translation id="1232234696885483911">‏وقتی‌که «جستجوی تصویر» را باز می‌کنید، عنوان، نشانی وب، و محتوای صفحه (ازجمله فایل‌های PDF) به‌طور خودکار به سرور ارسال می‌شوند. <ph name="LEARN_MORE" /></translation>
<translation id="3560913454241378492">‏اکنون که به سیستم وارد شده‌اید، می‌توانید از گذرواژه‌ها و سایر داده‌های «حساب Google» خود در Optimium استفاده کنید. برای تغییر دادن این تنظیم، به «حساب شما در Optimium» بروید.</translation>
<translation id="8922965532693587493">‏نمایش «Gemini در Optimium» در نوار منو Mac</translation>
<translation id="236433590733312836">‏برای انتخاب بخشی از صفحه در «Gemini در Optimium»، از میان‌بر صفحه‌کلید استفاده کنید.</translation>
<translation id="7976124325589452515">‏وقتی این زبانه غیرفعال بود، مقداری از حافظه آزاد شد تا سرعت Optimium حفظ شود. می‌توانید انتخاب کنید این سایت همیشه از غیرفعال شدن مستثنی شود.</translation>
<translation id="2758503437544511902">‏‫Optimium این بارگیری را مسدود کرد زیرا این فایل خطرناک است</translation>
<translation id="126567311906253476">‏وقتی با <ph name="USER_EMAIL" /> به سیستم سرویس‌های Google مثل Gmail یا YouTube وارد می‌شوید، می‌توانید به‌طور خودکار با همان حساب به سیستم Chromium وارد شوید</translation>
<translation id="4104061172701635162">‏دریافت کردن Optimium در تلفن</translation>
<translation id="1290883685122687410">خطای راه‌اندازی: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="3443894627866827446">‏راه‌اندازی نمایه Optimium جدید</translation>
<translation id="8946186262159916495">‏با «Gemini در Optimium» امتحان کنید</translation>
<translation id="7981347318091963592">‏‫Optimium برای کاوش دستگاه‌های بلوتوث
باید به بلوتوث دسترسی داشته باشد. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6099322702899630168">‏ورود به سیستم Optimium در تلفن</translation>
<translation id="1330562121671411446">تشخیص دادن زبان</translation>
<translation id="3294414641786025647">‏داده‌ها از Optimium هم حذف شود (<ph name="URL" />)</translation>
<translation id="4214354213779528068">{COUNT,plural, =1{‏«محافظت پیشرفته» از شما می‌خواهد برای اعمال به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. پنجره «ناشناس» یا «مجزا» باز است. بعداز راه‌اندازی مجدد، دوباره باز نخواهد شد.}one{‏«محافظت پیشرفته» از شما می‌خواهد برای اعمال به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. ‫# پنجره «ناشناس» و «مجزا» در نمایه‌های مختلف باز است. بعداز راه‌اندازی مجدد، دوباره باز نخواهند شد.}other{‏«محافظت پیشرفته» از شما می‌خواهد برای اعمال به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. ‫# پنجره «ناشناس» و «مجزا» در نمایه‌های مختلف باز است. بعداز راه‌اندازی مجدد، دوباره باز نخواهند شد.}}</translation>
<translation id="1345251407431278948">سنجاق شد! دفعه بعد می‌توانید «جستجوی تصویر» را ازطریق این دکمه جدید در نوارابزار باز کنید</translation>
<translation id="1383876407941801731">جستجو</translation>
<translation id="7825299065989465359">‏برای ادامه مرور در حرکت، از برنامه Optimium استفاده کنید</translation>
<translation id="141901961143729572">افکارتان را هم‌رسانی</translation>
<translation id="1438812738230833934">‏می‌توانید «جستجوی Google» را در قاب کناری دوباره باز کنید تا هنگام مرور کردن سؤال بپرسید</translation>
<translation id="4131307166987455854">‏برای هم‌رسانی پنجره، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Optimium مجاز کنید.</translation>
<translation id="1470136641087909499">‏می‌توانید «جستجوی Google» را در Chrome دوباره باز کنید تا هنگام مرور کردن سؤال بپرسید</translation>
<translation id="1478370723027452770">‏دریافت راهنمایی درباره Chrome for Testing</translation>
<translation id="9200022682397754538">‏برای دریافت اطلاعات ذخیره‌شده و سایر موارد از <ph name="DEVICE" />، به سیستم Optimium وارد شوید</translation>
<translation id="1497802159252041924">خطای نصب: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">این صفحه محافظت شده است</translation>
<translation id="892690000529877604">‏هم‌رسانی برگه Optimium</translation>
<translation id="15408169957028265">‏باز کردن مجدد «جستجوی Google» در Chrome</translation>
<translation id="9039191226880557963">‏ورود به سیستم Optimium</translation>
<translation id="1547469039832541117">تکلیف برجسته‌شده را به‌پایان می‌رساند.</translation>
<translation id="4414991100979797293">‏سنجاق کردن Optimium</translation>
<translation id="1574377791422810894">‏ابزارهای ایمنی Chromium</translation>
<translation id="3934587628489930735">‏‫Optimium می‌خواهد داده‌های «مدیر گذرواژه» شما را حذف کند. برای مجاز کردن این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="6745390171113033635">{COUNT,plural, =0{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Optimium را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="7186551909256266009">‏با برنامه Optimium در تلفنتان، بیشترین بهره را از Google ببرید</translation>
<translation id="1625909126243026060">‏مرور کنترل‌های اصلی امنیت و حریم خصوصی در Chromium</translation>
<translation id="1640672724030957280">در حال بارگیری…</translation>
<translation id="1648201623125974721">نماد جدید، میان‌بر یکسان: کلیک کنید تا هنگام مرور کردن با «تکالیف بافتاری» سؤال بپرسید.</translation>
<translation id="1665602916345474427">با <ph name="USER_NAME" />، <ph name="USER_EMAIL" />، عضویت به سیستم وارد شده‌اید. باز کردن منو حساب</translation>
<translation id="1708414395296835197">‏می‌توانید پیوندهای موجود در پیام‌ها، سندها، و برنامه‌های دیگر را همیشه بااستفاده از Chromium باز کنید. این برنامه به نوار وظیفه هم سنجاق خواهد شد.</translation>
<translation id="1709772298389099340">امتیازهای عالی برای <ph name="BROWSER_NAME" /> ارائه می‌دهد.</translation>
<translation id="1722488837206509557">این کار به شما امکان می‌دهد از بین دستگاه‌های دردسترس انتخاب کنید و محتوا را در آن‌ها نمایش دهید.</translation>
<translation id="6717880500969720524">‏Optimium به‌زودی داده‌های مرور را حذف می‌کند</translation>
<translation id="1736443181683099871">‏Chromium سعی می‌کند پیمایش‌ها را به HTTPS ارتقا دهد</translation>
<translation id="4418738262462299802">‏داده‌های Optimium پاک شد</translation>
<translation id="8469746761106187775">‏Optimium تا <ph name="REMAINING_TIME" /> دیگر بازراه‌اندازی خواهد شد</translation>
<translation id="1749104137266986751">‏وقتی HTTPS دردسترس نباشد، Chromium بدون دادن هشدار به شما از اتصال ناامن استفاده می‌کند</translation>
<translation id="1769661297620183092">‏می‌توانید پانل «جستجوی Google» را دوباره باز کنید تا هنگام مرور کردن سؤال بپرسید</translation>
<translation id="6555789357989792722">‏اجازه به Optimium برای اجرا در پس‌زمینه</translation>
<translation id="627441522449241646">‏برای ایمن‌تر کردن Optimium، برخی از افزونه‌هایی را که در <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> فهرست شده‌اند و ممکن است بدون اطلاع شما اضافه شده باشند، غیرفعال کردیم.</translation>
<translation id="1912380661217770781">‏روی <ph name="BEGIN_BOLD" />بله<ph name="END_BOLD" /> در اعلان Windows کلیک کنید تا Optimium را برای دسترسی سریع به نوار وظیفه سنجاق کنید.</translation>
<translation id="9034578483087384251">‏نصب مجدد Optimium</translation>
<translation id="2856362667064664106">‏Optimium در تلاش است <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="1665590461646883113">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Optimium وارد شوید. همچنین افزونه‌ها و سایر موارد را از <ph name="DEVICE" /> دریافت خواهید کرد.</translation>
<translation id="1668665535355826445">‏دفعه بعد که Optimium را در <ph name="DEVICE_TYPE" /> باز می‌کنید، پیام‌واره‌ای برای استفاده از «مدیر گذرواژه Google» خواهید دید.</translation>
<translation id="1838374766361614909">پاک کردن جستجو</translation>
<translation id="8674417702521959187">‏برای حذف کردن داده‌های مرور فقط از این دستگاه و نگهداری آن در «حساب Google»، <ph name="BEGIN_LINK" />از سیستم Optimium خارج شوید<ph name="END_LINK" />.</translation>
<translation id="6186721318460238018">‏با بارگیری Optimium در تلفنتان، درحال حرکت گروه‌های زبانه جدید باز کنید یا بسازید.</translation>
<translation id="185970820835152459">‏می‌توانید «حساب‌های Google» خودتان را که به سیستم آن‌ها وارد شده‌اید مدیریت کنید. از «حساب‌های Google» شما در مرورگر Chromium، «فروشگاه Play»، ‏Gmail، و محصولات دیگر استفاده می‌شود. اگر می‌خواهید حساب فرد دیگری را اضافه کنید (مثلاً یکی از اعضای خانواده)، به‌جای این کار، شخص جدیدی را به <ph name="DEVICE_TYPE" /> خود اضافه کنید. <ph name="LINK_BEGIN" />بیشتر بدانید<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">جستجو کردن با «جستجوی تصویر»</translation>
<translation id="1781731701613313704">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Optimium وارد شوید. همچنین نشانک‌ها و موارد دیگر را از <ph name="DEVICE" /> دریافت خواهید کرد.</translation>
<translation id="1880677175115548835">انتخاب نوشتار</translation>
<translation id="5960850334733792580">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه Optimium خود را می‌دهید. داده‌های Optimium شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME" /> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های Google حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. در صورت تمایل برای ذخیره داده‌های Optimium موجود به صورت جداگانه می‌توانید نمایه جدیدی ایجاد کنید. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">‏‫Chromium با محدود کردن فعالیت پس‌زمینه و جلوه‌های دیداری، مثل پیمایش روان و نرخ فریم ویدیو، در مصرف باتری صرفه‌جویی می‌کند. <ph name="BEGIN_LINK" />درباره «بهینه‌سازی انرژی» بیشتر بدانید<ph name="END_LINK" /></translation>
<translation id="7900167719031567542">‏سرویس به‌روزرسان Optimium</translation>
<translation id="1911763535808217981">‏با خاموش کردن این گزینه، می‌توانید بدون ورود به سیستم Chromium به سیستم سایت‌های Google مانند Gmail وارد شوید</translation>
<translation id="5015349619125768393">‏Optimium پاسخ نمی‌دهد. مجدداً راه‌اندازی شود؟</translation>
<translation id="2019000760486664637">‏سازمانتان (<ph name="MANAGER" />) شما را ملزم می‌کند به سیستم Optimium وارد شوید</translation>
<translation id="193439633299369377">‏برای اعمال به‌روزرسانی، ChromiumOS باید بازراه‌اندازی شود.</translation>
<translation id="3382368450324191331">‏‫Optimium این بارگیری را مسدود کرد زیرا این نوع فایل معمولاً بارگیری نمی‌شود و ممکن است خطرناک باشد</translation>
<translation id="1953553007165777902">درحال بارگیری… <ph name="MINUTE" /> دقیقه باقی مانده است</translation>
<translation id="1966382378801805537">‏Chromium نمی‌تواند مرورگر پیش‌فرض را تعیین یا تنظیم کند</translation>
<translation id="197326043290947695">با «جستجوی تصویر» هوشمندانه‌تر مرور کنید</translation>
<translation id="5321661580966500942">‏ببینید چرا Optimium برخی‌از فایل‌ها را مسدود می‌کند، در زبانه جدید باز می‌شود</translation>
<translation id="8960045458031480819">‏نرم‌افزار Optimium را به‌روز نگه می‌دارد. اگر این سرویس غیرفعال یا متوقف شود، نرم‌افزار Optimium به‌روز نخواهد ماند، به این معنی که آسیب‌پذیری‌های امنیتی احتمالی برطرف نمی‌شود و ممکن است ویژگی‌ها کار نکنند. این سرویس زمانی‌که هیچ نرم‌افزار Optimium از آن استفاده نکند، خود را حذف نصب می‌کند.</translation>
<translation id="2008474315282236005">‏این کار یک مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL" /> به سیستم Chromium وارد شوید.</translation>
<translation id="2018879682492276940">نصب تکمیل نشد. لطفاً دوباره امتحان کنید.</translation>
<translation id="2039417478970545937">تنظیمات.</translation>
<translation id="2049376729098081731">‏انتخاب کنید که آیا سابقه Chromium برای تجربه‌های شخصی‌سازی‌شده‌تر در سرویس‌های Google گنجانده شود یا نه</translation>
<translation id="4120951192672345208">‏این ویژگی در Optimium تعبیه شده است تا به شما در ساختن، ذخیره، و تکمیل خودکار گذرواژه‌های قوی کمک کند. برای دسترسی آسان، میان‌بر را اضافه کنید</translation>
<translation id="2060311596979880693">‏انجام شد! اکنون می‌توانید با «جستجوی Google» در Chrome به‌راحتی هنگام مرور کردن سؤال بپرسید</translation>
<translation id="7165258062917217746">‏روی دکمه «سفارشی‌سازی Optimium» در «صفحه زبانه جدید» کلیک کنید و ظاهری جدید به Optimium ببخشید</translation>
<translation id="3702823791268559760">‏‫Optimium این بارگیری را مسدود کرد زیرا این فایل فریب‌دهنده است و ممکن است تغییرات غیرمنتظره‌ای در دستگاهتان ایجاد کند</translation>
<translation id="2370804817835146114">‏دفعه بعد که Optimium iOS را باز می‌کنید، پیام‌واره‌ای برای امتحان کردن «<ph name="FEATURE_NAME" />» خواهید دید.</translation>
<translation id="5887094242311035059">‏گذرواژه‌ها و دیگر داده‌های Optimium که در «حساب Google» خود ذخیره کرده‌اید از این دستگاه برداشته خواهد شد. برای استفاده مجدد از آن‌ها در Optimium، دوباره به سیستم وارد شوید.</translation>
<translation id="8794268168383660193">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از Optimium استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}one{‏اگر به‌مدت # دقیقه از Optimium استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}other{‏اگر به‌مدت # دقیقه از Optimium استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}}</translation>
<translation id="2125838419757773031">بخشی از صفحه‌نمایش را برای جستجو انتخاب کنید</translation>
<translation id="2126108037660393668">فایل بارگیری‌شده تأیید نشد.</translation>
<translation id="2135919691573380097">گزارش کردن این سایت</translation>
<translation id="2137162749895930932">بستن صفحه ترجمه</translation>
<translation id="2147218225094845757">پنهان کردن پانل کناری</translation>
<translation id="8888656790178891761">‏‫Optimium این بارگیری را مسدود کرد زیرا این سایت از اتصال ایمن استفاده نمی‌کند و ممکن است فایل دستکاری شده باشد</translation>
<translation id="2170098639895543546">هر چیزی در صفحه را انتخاب کنید</translation>
<translation id="6975401993318112971">‏سفارشی کردن Optimium</translation>
<translation id="2174917724755363426">نصب کامل نیست. مطمئنید می‌خواهید آن را لغو کنید؟</translation>
<translation id="7741769305753410467">‏Optimium - ورود به سیستم شبکه - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">خطای بررسی به‌روزرسانی: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2133097742403140075">‏برداشتن حساب از Optimium</translation>
<translation id="6495056863394621013">‏برای داشتن بهترین ابزارهای خرید درحرکت، از برنامه Optimium استفاده کنید</translation>
<translation id="2209877494277346829">‏جداسازی Chromium از سایر برنامه‌ها</translation>
<translation id="2035198300681156782">‏با «مرور ایمن پیشرفته» در Optimium برای iOS، درحرکت ایمن‌تر مرور کنید</translation>
<translation id="2210682093923538346">‏سایت خطرناک. ‫Chromium اعلان‌ها را برداشت.</translation>
<translation id="2236949375853147973">فعالیت‌هایم</translation>
<translation id="871771486544954531">‏برای دریافت نشانی‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Optimium وارد شوید. بعداز اینکه به سیستم وارد شدید، این نشانی در «حساب Google» شما ذخیره خواهد شد.</translation>
<translation id="524316078518338158">‏اگر رایانه‌ای را به صورت مشترک استفاده می‌کنید، دوستان و خانواده می‌توانند به صورت جداگانه مرور کنند و Optimium را به صورتی که مایلند تنظیم کنند.</translation>
<translation id="22571759390241347">‏مهارت‌ها در Chromium</translation>
<translation id="2283228908180457226">‏نماد جدید، میان‌بر یکسان: برای پرسیدن سؤال هنگام مرور کردن با قاب کناری «جستجوی Google»، کلیک کنید.</translation>
<translation id="2283803047247799269">این زبانه با «جستجوی تصویر» جستجو شود</translation>
<translation id="5808794606375505413">{NUM_TABS,plural, =1{‏‫Optimium توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}one{‏‫Optimium توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}other{‏‫Optimium توصیه می‌کند زبانه‌هایی را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}}</translation>
<translation id="2307973900865360088">‏نگه داشتن در Dock</translation>
<translation id="2313870531055795960">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در Chromium ذخیره شده است مقایسه می‌کند. اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، Chromium ممکن است نشانی‌های وب را نیز به‌همراه بخش‌های کوچکی از محتوای صفحه به «مرور ایمن» ارسال کند.</translation>
<translation id="2356070529366658676">سؤال شود</translation>
<translation id="2359808026110333948">ادامه</translation>
<translation id="7000103009822967939">‏افزونه «<ph name="EXTENSION_NAME" />» از شما می‌خواهد به سیستم Optimium وارد شوید</translation>
<translation id="184381469736757112">‏غیرفعال کردن اجرای Optimium در پس‌زمینه برای برنامه‌ها</translation>
<translation id="5141894774016157674">‏برای استفاده از این افزونه با حساب <ph name="USER_EMAIL_ADDRESS" />، به سیستم Optimium وارد شوید.</translation>
<translation id="2384373936468275798">‏ChromiumOS نتوانست داده‌های شما را همگام‌سازی کند زیرا جزئیات ورود به حساب شما به‌روز نیست.</translation>
<translation id="2523694910556579068">{NUM_DEVICES,plural, =0{‏یک یا چند افزونه Optimium به یک «دستگاه میانای انسانی» (HID) دسترسی داشتند}=1{‏یک یا چند افزونه Optimium به یک «دستگاه میانای انسانی» (HID) دسترسی دارند}one{‏یک یا چند افزونه Optimium به # «دستگاه میانای انسانی» (HID) دسترسی دارند}other{‏یک یا چند افزونه Optimium به # «دستگاه میانای انسانی» (HID) دسترسی دارند}}</translation>
<translation id="2899976927368522713">‏Optimium برای این سایت به اجازه دوربین و میکروفون نیاز دارد</translation>
<translation id="2403703063067034158">خطای راه‌اندازی: فعلاً راه‌اندازی دیگری درحال اجرا است، لطفاً کمی بعد دوباره امتحان کنید.</translation>
<translation id="8530786035410512232">‏پیوندها را از هر برنامه‌ای در Optimium باز کنید و مرورگر را در نوار وظیفه دردسترس نگه دارید</translation>
<translation id="5645058843566501763">‏برای هم‌رسانی این سند با Gemini در Optimium و دریافت مرور کوتاه و پرسیدن سؤالات تعقیبی، روی دکمه «خلاصه کردن» کلیک کنید</translation>
<translation id="2440750600860946460">‏با <ph name="BEGIN_LINK" />ابزارهای Chromium<ph name="END_LINK" />، می‌توانید به‌طور ایمن مرور کنید و کنترل را دردست بگیرید</translation>
<translation id="5384013849288198705">‏‫<ph name="EXISTING_USER" /> از قبل به سیستم وارد شده است. برای جدا نگه داشتن مرورتان، در نمایه خود با حساب <ph name="USER_EMAIL_ADDRESS" /> به سیستم Optimium وارد شوید. همچنین گذرواژه‌هایتان و اطلاعات دیگر را در همه دستگاه‌هایتان دریافت خواهید کرد.</translation>
<translation id="2451727308784734061">از میان‌بر برای دسترسی سریع به «مدیر گذرواژه» استفاده کنید. می‌توانید میان‌برتان را به صفحه اصلی رایانه یا راه‌انداز برنامه منتقل کنید.</translation>
<translation id="4074322039453189342">‏Optimium به‌زودی بسته می‌شود</translation>

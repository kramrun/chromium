<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="th">
<translation id="1026101648481255140">ดำเนินการติดตั้งต่อ</translation>
<translation id="1029669172902658969">เปิดอีกครั้งเพื่ออัปเดต &amp;Chromium OS</translation>
<translation id="4063809399345498325">Optimium ขอแนะนำให้คุณตรวจสอบส่วนขยายนี้</translation>
<translation id="1042552502243217427">เมื่อเว็บไซต์ขอโหลดลิงก์ในหน้าเว็บของตนล่วงหน้าแบบส่วนตัว Chromium จะใช้เซิร์ฟเวอร์ของ Google การดำเนินการนี้จะซ่อนตัวตนของคุณจากเว็บไซต์ที่โหลดล่วงหน้า แต่ Google จะทราบถึงเว็บไซต์ที่ได้รับการโหลดล่วงหน้า</translation>
<translation id="1051793555070215510">ช่วยเราปรับปรุงโหมดไม่ระบุตัวตนโดยทำแบบสำรวจนี้ซึ่งใช้เวลาเพียง 1 นาที</translation>
<translation id="1065672644894730302">ค่ากำหนดของคุณไม่สามารถอ่านได้ ฟีเจอร์บางอย่างอาจใช้ไม่ได้และการเปลี่ยนแปลงค่ากำหนดจะไม่ได้รับการบันทึก</translation>
<translation id="7250992450852052182">ผู้ปกครองได้ปิด "สิทธิ์สำหรับเว็บไซต์ แอป และส่วนขยาย" ใน Optimium</translation>
<translation id="6711838932294803312">Optimium ต้องการสิทธิ์เข้าถึงเครือข่ายภายในเพื่อค้นหาและใช้อุปกรณ์ที่อยู่ใกล้เคียง</translation>
<translation id="2807920805712601449">หากต้องการค้นหาฟีเจอร์หรือส่วนขยาย Optimium ที่เฉพาะเจาะจง ให้พิมพ์ทางลัดของฟีเจอร์หรือส่วนขยายนั้นในแถบที่อยู่ แล้วตามด้วยปุ่มบนแป้นพิมพ์ที่เลือกไว้</translation>
<translation id="5994612110840535151">แสดงการค้นหาด้วย Optimium ในถาดระบบและเปิดแป้นพิมพ์ลัด</translation>
<translation id="7212528213853025915">Optimium ต้องการส่งออกรหัสผ่านของคุณ พิมพ์รหัสผ่าน Windows เพื่ออนุญาตให้ดำเนินการ</translation>
<translation id="112640046208448578">ระบุสิ่งหรือสถานที่ต่างๆ แล้วคัดลอกหรือแปลข้อความ เมื่อใช้การค้นหารูปภาพ ระบบจะส่งภาพหน้าจอของหน้าเว็บไปยังเซิร์ฟเวอร์ <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium เป็นเบราว์เซอร์เริ่มต้นของคุณ</translation>
<translation id="1131805035311359397"><ph name="BEGIN_LINK" />ลงชื่อเข้าใช้ Chromium<ph name="END_LINK" /> เพื่อตรวจสอบว่ารหัสผ่านของคุณไม่ได้รับผลกระทบจากการละเมิดข้อมูลและปัญหาด้านความปลอดภัยอื่นๆ</translation>
<translation id="3458316367708035110">{COUNT,plural, =1{ผู้ดูแลระบบขอให้คุณเปิด Optimium ขึ้นมาใหม่เพื่อใช้การอัปเดตนี้ มีหน้าต่างที่ไม่ระบุตัวตนหรือหน้าต่างแยกเปิดอยู่ หน้าต่างดังกล่าวจะไม่เปิดขึ้นมาใหม่เมื่อคุณเบราว์เซอร์เปิดอีกครั้ง}other{ผู้ดูแลระบบขอให้คุณเปิด Optimium ขึ้นมาใหม่เพื่อใช้การอัปเดตนี้ มีหน้าต่างที่ไม่ระบุตัวตนและหน้าต่างแยก # หน้าต่างเปิดอยู่ในโปรไฟล์ต่างๆ หน้าต่างดังกล่าวจะไม่เปิดขึ้นมาใหม่เมื่อคุณเบราว์เซอร์เปิดอีกครั้ง}}</translation>
<translation id="1150418667633096194">ปุ่ม "แผงด้านข้างของ Google Search" บนแถบเครื่องมือมีไอคอนใหม่ คลิกเพื่อถามคำถามขณะท่องเว็บด้วยแผงด้านข้างของ Google Search</translation>
<translation id="759898790519515623">คลิกเมนู Optimium</translation>
<translation id="1157952955648710254">ปิดแผงด้านข้างของ Google Search</translation>
<translation id="1157985233335035034">ภาษาล่าสุด</translation>
<translation id="1184145431117212167">ติดตั้งไม่สำเร็จเนื่องจากระบบไม่รองรับ Windows เวอร์ชันที่คุณใช้</translation>
<translation id="1185134272377778587">เกี่ยวกับ Chromium</translation>
<translation id="5987505065981917957">รับการแจ้งเตือนการติดตามราคาด้วย Optimium ในโทรศัพท์</translation>
<translation id="1203500561924088507">ขอขอบคุณที่ติดตั้ง คุณต้องรีสตาร์ทเบราว์เซอร์ก่อนใช้ <ph name="BUNDLE_NAME" /></translation>
<translation id="1232234696885483911">เมื่อคุณเปิดการค้นหารูปภาพ ระบบจะส่งชื่อหน้า, URL และเนื้อหา รวมถึง PDF ไปยังเซิร์ฟเวอร์โดยอัตโนมัติ <ph name="LEARN_MORE" /></translation>
<translation id="3560913454241378492">เมื่อลงชื่อเข้าใช้อยู่ คุณจะใช้รหัสผ่านและข้อมูลอื่นๆ จากบัญชี Google ใน Optimium ได้ หากต้องการเปลี่ยน ให้ไปที่ "บัญชีของคุณใน Optimium"</translation>
<translation id="8922965532693587493">แสดง Gemini ใน Optimium ในแถบเมนูของ Mac</translation>
<translation id="236433590733312836">ใช้แป้นพิมพ์ลัดเพื่อเลือกส่วนหนึ่งของหน้าจอใน Gemini ใน Optimium</translation>
<translation id="7976124325589452515">ขณะที่แท็บนี้ไม่มีการใช้งาน ระบบจะเพิ่มพื้นที่ว่างในหน่วยความจำเพื่อให้ใช้ Optimium ได้อย่างรวดเร็วอยู่เสมอ ทั้งนี้คุณจะเลือกยกเว้นให้เว็บไซต์นี้ทำงานตลอดเวลาได้</translation>
<translation id="2758503437544511902">Optimium บล็อกการดาวน์โหลดนี้เนื่องจากไฟล์เป็นอันตราย</translation>
<translation id="126567311906253476">เมื่อลงชื่อเข้าใช้บริการของ Google อย่าง Gmail หรือ YouTube ด้วย <ph name="USER_EMAIL" /> คุณจะลงชื่อเข้าใช้ Chromium ด้วยบัญชีเดียวกันได้โดยอัตโนมัติ</translation>
<translation id="4104061172701635162">ดาวน์โหลด Optimium ในโทรศัพท์</translation>
<translation id="1290883685122687410">ข้อผิดพลาดในการตั้งค่า: <ph name="METAINSTALLER_EXIT_CODE" /> <ph name="WINDOWS_ERROR" /></translation>
<translation id="3443894627866827446">ตั้งค่าโปรไฟล์ Optimium ใหม่</translation>
<translation id="8946186262159916495">ลองใช้ Gemini ใน Optimium</translation>
<translation id="7981347318091963592">Optimium ต้องการสิทธิ์เข้าถึงบลูทูธเพื่อสำรวจอุปกรณ์บลูทูธ <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6099322702899630168">ลงชื่อเข้าใช้ Optimium ในโทรศัพท์</translation>
<translation id="1330562121671411446">ตรวจหาภาษา</translation>
<translation id="3294414641786025647">ลบข้อมูลออกจาก Optimium (<ph name="URL" />) ด้วย</translation>
<translation id="4214354213779528068">{COUNT,plural, =1{การปกป้องขั้นสูงกำหนดให้คุณต้องเปิด Optimium ขึ้นมาใหม่เพื่อใช้การอัปเดต มีหน้าต่างที่ไม่ระบุตัวตนหรือหน้าต่างแยกเปิดอยู่ หน้าต่างดังกล่าวจะไม่เปิดขึ้นมาใหม่เมื่อคุณเบราว์เซอร์เปิดอีกครั้ง}other{การปกป้องขั้นสูงกำหนดให้คุณต้องเปิด Optimium ขึ้นมาใหม่เพื่อใช้การอัปเดต มีหน้าต่างที่ไม่ระบุตัวตนและหน้าต่างแยก # หน้าต่างเปิดอยู่ในโปรไฟล์ต่างๆ หน้าต่างดังกล่าวจะไม่เปิดขึ้นมาใหม่เมื่อคุณเบราว์เซอร์เปิดอีกครั้ง}}</translation>
<translation id="1345251407431278948">ปักหมุดแล้ว คุณเข้าถึงการค้นหารูปภาพได้อีกครั้งจากปุ่มใหม่ในแถบเครื่องมือ</translation>
<translation id="1383876407941801731">ค้นหา</translation>
<translation id="7825299065989465359">ใช้แอป Optimium เพื่อท่องเว็บได้ทุกที่ทุกเวลา</translation>
<translation id="141901961143729572">แชร์ความคิดเห็นของคุณ</translation>
<translation id="1438812738230833934">คุณสามารถเปิด Google Search ในแผงด้านข้างอีกครั้งเพื่อถามคำถามขณะท่องเว็บได้</translation>
<translation id="4131307166987455854">หากต้องการแชร์หน้าต่าง ให้อนุญาตการบันทึกหน้าจอสำหรับ Optimium ใน "การตั้งค่าระบบ"</translation>
<translation id="1470136641087909499">คุณสามารถเปิด Google Search ใน Chrome อีกครั้งเพื่อถามคำถามขณะท่องเว็บได้</translation>
<translation id="1478370723027452770">รับความช่วยเหลือเกี่ยวกับ Chrome สำหรับการทดสอบ</translation>
<translation id="9200022682397754538">ลงชื่อเข้าใช้ Optimium เพื่อเข้าถึงข้อมูลที่บันทึกไว้และข้อมูลอื่นๆ จาก <ph name="DEVICE" /></translation>
<translation id="1497802159252041924">ข้อผิดพลาดในการติดตั้ง: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">หน้านี้ได้รับการป้องกัน</translation>
<translation id="892690000529877604">แชร์แท็บ Optimium</translation>
<translation id="15408169957028265">เปิด Google Search ใน Chrome อีกครั้ง</translation>
<translation id="9039191226880557963">ลงชื่อเข้าใช้ Optimium</translation>
<translation id="1547469039832541117">สิ้นสุดงานที่ไฮไลต์ไว้</translation>
<translation id="4414991100979797293">ปักหมุด Optimium</translation>
<translation id="1574377791422810894">เครื่องมือด้านความปลอดภัยของ Chromium</translation>
<translation id="3934587628489930735">Optimium ต้องการลบข้อมูลในเครื่องมือจัดการรหัสผ่าน โปรดพิมพ์รหัสผ่าน Windows ของคุณเพื่ออนุญาต</translation>
<translation id="6745390171113033635">{COUNT,plural, =0{ผู้ดูแลระบบต้องการให้คุณเปิด Optimium ขึ้นมาใหม่เพื่อใช้การอัปเดต}=1{ผู้ดูแลระบบต้องการให้คุณเปิด Optimium ขึ้นมาใหม่เพื่อใช้การอัปเดต หน้าต่างที่ไม่ระบุตัวตนจะไม่เปิดให้อีก}other{ผู้ดูแลระบบต้องการให้คุณเปิด Optimium ขึ้นมาใหม่เพื่อใช้การอัปเดต หน้าต่างที่ไม่ระบุตัวตนจำนวน # หน้าต่างจะไม่เปิดให้อีก}}</translation>
<translation id="7186551909256266009">ใช้ประโยชน์สูงสุดจาก Google ด้วยแอป Optimium ในโทรศัพท์</translation>
<translation id="1625909126243026060">ตรวจสอบการควบคุมที่สำคัญด้านความเป็นส่วนตัวและความปลอดภัยใน Chromium</translation>
<translation id="1640672724030957280">กำลังดาวน์โหลด...</translation>
<translation id="1648201623125974721">ไอคอนใหม่ ทางลัดเดิม: คลิกเพื่อถามคำถามขณะท่องเว็บด้วยฟีเจอร์งานตามบริบท</translation>
<translation id="1665602916345474427">ลงชื่อเข้าใช้ด้วย <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, สมาชิก เปิดเมนูบัญชี</translation>
<translation id="1708414395296835197">คุณจะใช้ Chromium ได้ทุกครั้งที่คลิกลิงก์ในข้อความ เอกสาร และแอปอื่นๆ จะมีการปักหมุดไว้ที่แถบงานด้วย</translation>
<translation id="1709772298389099340">ให้สิทธิ์ในระดับสูงขึ้นกับ <ph name="BROWSER_NAME" /></translation>
<translation id="1722488837206509557">สิทธิ์นี้จะช่วยให้คุณสามารถเลือกจากอุปกรณ์ที่พร้อมใช้งานและแสดงเนื้อหาบนอุปกรณ์เหล่านั้น</translation>
<translation id="6717880500969720524">Optimium จะลบข้อมูลการท่องเว็บเร็วๆ นี้</translation>
<translation id="1736443181683099871">Chromium จะพยายามอัปเกรดการนำทางให้เป็นแบบ HTTPS</translation>
<translation id="4418738262462299802">ล้างข้อมูล Optimium แล้ว</translation>
<translation id="8469746761106187775">Optimium จะรีสตาร์ทใน <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">เมื่อ HTTPS ไม่พร้อมใช้งาน Chromium จะใช้การเชื่อมต่อที่ไม่ปลอดภัยโดยไม่แจ้งเตือนคุณ</translation>
<translation id="1769661297620183092">คุณสามารถเปิดแผง Google Search อีกครั้งเพื่อถามคำถามขณะท่องเว็บได้</translation>
<translation id="6555789357989792722">ให้ Optimium ทำงานในพื้นหลัง</translation>
<translation id="627441522449241646">เพื่อให้ Optimium ปลอดภัยขึ้น เราได้ปิดส่วนขยายบางรายการที่ไม่ได้ระบุไว้ใน <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> และอาจถูกเพิ่มเข้ามาโดยที่คุณไม่รู้ตัว</translation>
<translation id="1912380661217770781">คลิก<ph name="BEGIN_BOLD" />ใช่<ph name="END_BOLD" />ในการแจ้งเตือนของ Windows เพื่อปักหมุด Optimium ไว้ที่แถบงานเพื่อให้เข้าถึงได้รวดเร็ว</translation>
<translation id="9034578483087384251">ติดตั้ง Optimium ใหม่</translation>
<translation id="2856362667064664106">Optimium กำลังพยายาม<ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="1665590461646883113"><ph name="EXISTING_USER" /> ลงชื่อเข้าใช้อยู่แล้ว หากต้องการแยกการท่องเว็บของคุณไว้ต่างหาก ให้ลงชื่อเข้าใช้ Optimium ในโปรไฟล์ของคุณเองด้วย <ph name="USER_EMAIL_ADDRESS" /> นอกจากนี้ คุณยังรับส่วนขยายและข้อมูลอื่นๆ จาก <ph name="DEVICE" /> ได้ด้วย</translation>
<translation id="1668665535355826445">ครั้งถัดไปที่เปิด Optimium ใน <ph name="DEVICE_TYPE" /> คุณจะเห็นข้อความแจ้งให้ใช้เครื่องมือจัดการรหัสผ่านบน Google</translation>
<translation id="1838374766361614909">ล้างการค้นหา</translation>
<translation id="8674417702521959187">หากต้องการลบข้อมูลการท่องเว็บออกจากอุปกรณ์นี้เท่านั้น แต่ยังเก็บข้อมูลดังกล่าวไว้ในบัญชี Google ให้<ph name="BEGIN_LINK" />ออกจากระบบ Optimium<ph name="END_LINK" /></translation>
<translation id="6186721318460238018">ดาวน์โหลด Optimium บนโทรศัพท์เพื่อเปิดหรือสร้างกลุ่มแท็บใหม่ได้ทุกที่ทุกเวลา</translation>
<translation id="185970820835152459">คุณจัดการบัญชี Google ที่ลงชื่อเข้าใช้ได้ บัญชี Google ใช้สำหรับเบราว์เซอร์ Chromium, Play Store, Gmail และอื่นๆ หากต้องการเพิ่มบัญชีให้คนอื่น เช่น สมาชิกในครอบครัว ให้เพิ่มบุคคลใหม่ลงใน <ph name="DEVICE_TYPE" /> แทน <ph name="LINK_BEGIN" />ดูข้อมูลเพิ่มเติม<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">ค้นหาด้วยการค้นหารูปภาพ</translation>
<translation id="1781731701613313704"><ph name="EXISTING_USER" /> ลงชื่อเข้าใช้อยู่แล้ว หากต้องการแยกการท่องเว็บของคุณไว้ต่างหาก ให้ลงชื่อเข้าใช้ Optimium ในโปรไฟล์ของคุณเองด้วย <ph name="USER_EMAIL_ADDRESS" /> นอกจากนี้ คุณยังรับบุ๊กมาร์กและข้อมูลอื่นๆ จาก <ph name="DEVICE" /> ได้ด้วย</translation>
<translation id="1880677175115548835">เลือกข้อความ</translation>
<translation id="5960850334733792580">คุณกำลังลงชื่อเข้าใช้ด้วยบัญชีที่จัดการ และให้การควบคุมระดับผู้ดูแลระบบของบัญชีดังกล่าวเหนือโปรไฟล์ Optimium ของคุณ ข้อมูล Optimium เช่น แอป บุ๊กมาร์ก ประวัติการเข้าชม รหัสผ่าน และการตั้งค่าอื่นๆ จะเชื่อมโยงอย่างถาวรกับ <ph name="USER_NAME" /> คุณจะสามารถลบข้อมูลนี้ผ่านทางแผงควบคุมบัญชี Google แต่คุณจะไม่สามารถเชื่อมโยงข้อมูลนี้กับบัญชีอื่น คุณสามารถเลือกที่จะสร้างโปรไฟล์ใหม่เพื่อแยกเก็บข้อมูล Optimium ที่มีอยู่ของคุณ <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium จะช่วยสงวนพลังงานแบตเตอรี่โดยการจำกัดกิจกรรมในเบื้องหลังและเอฟเฟกต์ภาพ เช่น การเลื่อนอย่างราบรื่นและอัตราเฟรมวิดีโอ <ph name="BEGIN_LINK" />ดูข้อมูลเพิ่มเติมเกี่ยวกับโหมดประหยัดพลังงาน<ph name="END_LINK" /></translation>
<translation id="7900167719031567542">บริการ Optimium Updater</translation>
<translation id="1911763535808217981">เมื่อปิดการตั้งค่านี้ คุณจะลงชื่อเข้าใช้เว็บไซต์ของ Google อย่างเช่น Gmail ได้โดยไม่ต้องลงชื่อเข้าใช้ Chromium</translation>
<translation id="5015349619125768393">Optimium ไม่ตอบสนอง เปิดใหม่เลยหรือไม่</translation>

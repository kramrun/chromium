<translation id="1565712261560212491">ขยายการใช้งาน Safe Browsing พร้อมการปกป้องที่ดียิ่งขึ้นด้วย Optimium ในโทรศัพท์</translation>
<translation id="7003115800241574875">กำลังปรับแต่ง Optimium ในแบบของคุณ...</translation>
<translation id="3474745554856756813">การดำเนินการนี้จะลบ <ph name="ITEMS_COUNT" /> รายการออกจากอุปกรณ์นี้ หากต้องการดึงข้อมูลภายหลัง ให้ลงชื่อเข้าใช้ Chromium ด้วย <ph name="USER_EMAIL" /></translation>
<translation id="1749327805708308979"><ph name="SHORTCUT" /> จะสลับไปมาระหว่างโปรไฟล์ Optimium ได้</translation>
<translation id="7437253251955408447">โปรดปิดหน้าต่าง Optimium ทั้งหมดแล้วลองอีกครั้ง</translation>
<translation id="4544226979083343619">หากต้องการแชร์หน้าต่าง ให้อนุญาตการบันทึกหน้าจอสำหรับ Optimium ใน "การตั้งค่าระบบ"</translation>
<translation id="7742324910239513884"><ph name="EXISTING_USER" /> ลงชื่อเข้าใช้อยู่แล้ว  หากต้องการแยกการท่องเว็บของคุณไว้ต่างหาก ให้ลงชื่อเข้าใช้ Optimium ในโปรไฟล์ของคุณเองด้วย <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="8618656037793872415">คิวอาร์โค้ดสำหรับดาวน์โหลดเบราว์เซอร์ Optimium บนมือถือ</translation>
<translation id="354621070532799440">การช่วยเตือน: ฟีเจอร์ความปลอดภัยที่ดีที่สุดของ Google อยู่ในมือคุณแล้ว</translation>
<translation id="3043015282185018117">หากต้องการแชร์หน้าจอ ให้อนุญาตการบันทึกหน้าจอสำหรับ Optimium ใน "การตั้งค่าระบบ"</translation>
<translation id="3597003331831379823">เรียกใช้การตั้งค่าด้วยสิทธิ์ในระดับสูงขึ้นไม่สำเร็จ <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3261842649996827269">ลงชื่อเข้าใช้ Optimium</translation>
<translation id="1140403329282632523">ระบบจะลบข้อมูลการท่องเว็บของบุคคลนี้ออกจากอุปกรณ์นี้ หากต้องการกู้ข้อมูลคืน ให้ลงชื่อเข้าใช้ Optimium ในชื่อ <ph name="USER_EMAIL" /></translation>
<translation id="5228011645297638039">{COUNT,plural, =0{อัปเดตใหม่ของ Optimium พร้อมให้ใช้งานแล้วและระบบจะใช้อัปเดตดังกล่าวเมื่อคุณเปิด Optimium ขึ้นมาใหม่}=1{อัปเดตใหม่ของ Optimium พร้อมให้ใช้งานแล้วและระบบจะใช้อัปเดตดังกล่าวเมื่อคุณเปิด Optimium ขึ้นมาใหม่ หน้าต่างที่ไม่ระบุตัวตนจะไม่เปิดให้อีก}other{อัปเดตใหม่ของ Optimium พร้อมให้ใช้งานแล้วและระบบจะใช้อัปเดตดังกล่าวเมื่อคุณเปิด Optimium ขึ้นมาใหม่ หน้าต่างที่ไม่ระบุตัวตนจำนวน # หน้าต่างจะไม่เปิดให้อีก}}</translation>
<translation id="3667616615096815454">ติดตั้งไม่ได้เนื่องจากเซิร์ฟเวอร์ไม่รู้จักแอปพลิเคชัน</translation>
<translation id="3675854891107786059">ใช้<ph name="BEGIN_LINK" />พาสเฟรสของคุณเอง<ph name="END_LINK" />ในการเข้ารหัสข้อมูล Chromium ทั้งหมดในบัญชี Google ที่อยู่และวิธีการชำระเงินจาก Google Pay จะไม่มีการเข้ารหัส ประวัติการท่องเว็บจาก Chromium จะไม่ซิงค์</translation>
<translation id="7861068783030138988">{COUNT,plural, =0{ผู้ดูแลระบบขอให้คุณเปิด Optimium ขึ้นมาใหม่เพื่อใช้การอัปเดตนี้}=1{ผู้ดูแลระบบขอให้คุณเปิด Optimium ขึ้นมาใหม่เพื่อใช้การอัปเดตนี้ หน้าต่างที่ไม่ระบุตัวตนจะไม่เปิดให้อีก}other{ผู้ดูแลระบบขอให้คุณเปิด Optimium ขึ้นมาใหม่เพื่อใช้การอัปเดตนี้ หน้าต่างที่ไม่ระบุตัวตนจำนวน # หน้าต่างจะไม่เปิดให้อีก}}</translation>
<translation id="8611928240945733486">เปิดลิงก์ใน Optimium แท็บใหม่</translation>
<translation id="3728124580182886854">ลิงก์ Chromium และบริการอื่นๆ ของ Google เพื่อการปรับเปลี่ยนในแบบของคุณและวัตถุประสงค์อื่นๆ</translation>
<translation id="3729187154190517324">เจาะลึกการค้นหาด้วยการเพิ่มแท็บ ไฟล์ และเครื่องมือหลายรายการโดยใช้ปุ่ม "เพิ่มแท็บและอื่นๆ"</translation>
<translation id="3032577647176321971">จัดการโปรไฟล์ Optimium</translation>
<translation id="6314444399103340747">ดูสาเหตุที่ Optimium บล็อกการดาวน์โหลดบางรายการ</translation>
<translation id="379589255253486813">Chromium จะแจ้งให้คุณทราบหากมีสิ่งใดที่คุณควรตรวจสอบ</translation>
<translation id="3802055581630249637">Chromium จะโหลดหน้าเว็บที่คุณน่าจะเข้าชมเอาไว้ล่วงหน้าเพื่อให้หน้าเหล่านั้นโหลดเร็วขึ้นเมื่อคุณเข้าชม</translation>
<translation id="3810973564298564668">จัดการ</translation>
<translation id="4301680230606686279">หากต้องการใช้รหัสผ่านที่บันทึกไว้ ให้สแกนคิวอาร์โค้ด, ดาวน์โหลด Optimium สำหรับ iOS และลงชื่อเข้าใช้บัญชี Google</translation>
<translation id="3846683726093018685">**สรุป:** อธิบายเรื่องหลักและวัตถุประสงค์ของเนื้อหาในภาพหน้าจอในประโยคเดียวที่มีไม่เกิน 30 คำ

          **แนะนำคำถาม:** สร้างรายการสัญลักษณ์หัวข้อย่อยของคำถามกระตุ้นความคิด 3-5 ข้อที่ผู้ใช้อาจถามเพื่อทำความเข้าใจภาพหน้าจอได้ดียิ่งขึ้น คำถามเหล่านี้ควรมีอย่างน้อย 1 ข้อที่เกี่ยวกับวัตถุภาพ การออกแบบ หรือตำแหน่งของวัตถุนั้นโดยเฉพาะ</translation>
<translation id="3287167856630539345"><ph name="PAGE_TITLE" /> - Optimium</translation>
<translation id="3117512156333858342">ลงชื่อเข้าใช้ Optimium เพื่อเข้าถึงบุ๊กมาร์กและข้อมูลอื่นๆ ในอุปกรณ์ทุกเครื่อง</translation>
<translation id="3511883131632987404">{COUNT,plural, =1{ผู้ดูแลระบบขอให้คุณเปิด Optimium ขึ้นมาใหม่เพื่อใช้การอัปเดตนี้ หน้าต่างแยกจะไม่เปิดขึ้นมาใหม่}other{ผู้ดูแลระบบขอให้คุณเปิด Optimium ขึ้นมาใหม่เพื่อใช้การอัปเดตนี้ หน้าต่างแยก # หน้าต่างจะไม่เปิดขึ้นมาใหม่}}</translation>
<translation id="3885770153807205175">เครื่องมือเลือกภาษา</translation>
<translation id="7294070483192043494">ปรับแต่งและควบคุม Optimium มีสิ่งที่คุณจำเป็นต้องทราบ โปรดคลิกเพื่อดูรายละเอียด</translation>
<translation id="7920927747111819647">คลิกชื่อของคุณเพื่อเปิด Optimium และเริ่มท่องเว็บ</translation>
<translation id="3892148308691398805">คัดลอกข้อความ</translation>
<translation id="4454986649289930182"><ph name="EXISTING_USER" /> ลงชื่อเข้าใช้โปรไฟล์ Optimium นี้แล้ว หากต้องการแยกการท่องเว็บของคุณไว้ต่างหาก Optimium สร้างโปรไฟล์ให้คุณโดยเฉพาะได้</translation>
<translation id="7225128703667880746">ส่วนขยายนี้ละเมิดนโยบาย Chrome เว็บสโตร์และอาจไม่ปลอดภัย นำส่วนขยายดังกล่าวออกจาก Optimium เพื่อไม่ให้ดูและเปลี่ยนแปลงข้อมูลของคุณในเว็บไซต์ที่เข้าชม รวมถึงข้อมูลส่วนบุคคลได้อีกต่อไป</translation>
<translation id="3941890832296813527">ข้อผิดพลาดในการติดตั้ง: ชื่อไฟล์ของโปรแกรมติดตั้งไม่ถูกต้องหรือระบบไม่รองรับ</translation>
<translation id="6304622602441037994">Optimium กำลังพยายามคัดลอกรหัสผ่าน โปรดพิมพ์รหัสผ่าน Windows ของคุณเพื่ออนุญาต</translation>
<translation id="2274695480528598968">ลงชื่อเข้าใช้ Optimium เพื่อเข้าถึงข้อมูลที่บันทึกไว้และอื่นๆ ในอุปกรณ์ทุกเครื่อง</translation>
<translation id="1713567483777335359">ระบบจะนำรหัสผ่าน วิธีการชำระเงิน และที่อยู่ที่คุณบันทึกไว้ในบัญชี Google ออกจากอุปกรณ์นี้ หากต้องการใช้ข้อมูลเหล่านี้ใน Optimium ให้ลงชื่อเข้าใช้อีกครั้ง</translation>
<translation id="395904275706073188">อ่านหน้าเว็บที่มีการป้องกันไม่ได้ โปรดลองใช้หน้าอื่น</translation>
<translation id="3962647064319009959">ดูวิธีที่ Chromium ช่วยให้คุณปลอดภัย</translation>
<translation id="3967822245660637423">ดาวน์โหลดเสร็จสมบูรณ์</translation>
<translation id="3971865010372729242">เมื่อคุณพิมพ์ในแถบที่อยู่หรือช่องค้นหา Chromium จะส่งสิ่งที่คุณพิมพ์ไปยังเครื่องมือค้นหา, AI และเครื่องมือตัวแทนขององค์กรเพื่อรับคำแนะนำ</translation>
<translation id="3975724895399328945">เกี่ยวกับ Google Chrome สำหรับการทดสอบ</translation>
<translation id="3984557288004650913">จากปุ่ม "Google Search ใน Chrome" บนแถบเครื่องมือ คุณสามารถเปิด Google Search ใน Chrome อีกครั้งเพื่อถามคำถามขณะท่องเว็บได้</translation>
<translation id="3997429360543082038">เกี่ยวกับ Chromium OS</translation>
<translation id="4016217212818346953">ปลอดภัยอยู่เสมอด้วยเครื่องมือจัดการรหัสผ่าน</translation>
<translation id="4019629340646866719">Chromium OS เกิดขึ้นได้ด้วยการสนับสนุนจาก<ph name="BEGIN_LINK_CROS_OSS" />ซอฟต์แวร์โอเพนซอร์ส<ph name="END_LINK_CROS_OSS" />อื่นเพิ่มเติม ตลอดจน<ph name="BEGIN_LINK_LINUX_OSS" />สภาพแวดล้อมในการพัฒนาซอฟต์แวร์ Linux<ph name="END_LINK_LINUX_OSS" /></translation>
<translation id="4022972681110646219">แปลหน้าจอ</translation>
<translation id="4023601594785368013">ภาษาต้นฉบับ: <ph name="LANGUAGE" /></translation>
<translation id="8098054594752731054">เปิดลิงก์ใน Optimium จากแอปใดก็ได้ และปักหมุดไว้ที่แถบงานเพื่อให้เข้าถึงได้ง่าย</translation>
<translation id="4036079820698952681">ช่วยให้ Chromium ดียิ่งขึ้นด้วยการรายงาน<ph name="BEGIN_LINK" />การตั้งค่าปัจจุบัน<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">การปรับปรุงด้านความปลอดภัยที่สำคัญและฟีเจอร์ใหม่ๆ พร้อมให้บริการในเวอร์ชันล่าสุด</translation>
<translation id="4055805654398742145">เครื่องมือจัดการรหัสผ่าน</translation>
<translation id="3150466418323356831">{COUNT,plural, =1{องค์กรจะปิด Optimium โดยอัตโนมัติเมื่อไม่มีการใช้งานเป็นเวลา 1 นาที ลบข้อมูลการท่องเว็บแล้ว ซึ่งอาจรวมถึงประวัติการเข้าชม การป้อนข้อความอัตโนมัติ และการดาวน์โหลด}other{องค์กรจะปิด Optimium โดยอัตโนมัติเมื่อไม่มีการใช้งานเป็นเวลา # นาที ลบข้อมูลการท่องเว็บแล้ว ซึ่งอาจรวมถึงประวัติการเข้าชม การป้อนข้อความอัตโนมัติ และการดาวน์โหลด}}</translation>
<translation id="4118474109249235144">โหมดไม่ระบุตัวตนของ Chromium</translation>
<translation id="4122186850977583290">ไปที่หน้าเกี่ยวกับ Chromium</translation>
<translation id="5040058062446726786">ปรับแต่ง Optimium เพื่อสร้างรูปลักษณ์ใหม่ๆ ให้เบราว์เซอร์</translation>
<translation id="3417230552019009112">ปรับแต่ง Optimium</translation>
<translation id="4148957013307229264">กำลังติดตั้ง...</translation>
<translation id="8036654966821129512">อัปเดต Optimium เพื่อรักษาความปลอดภัย</translation>
<translation id="113287843321846936"><ph name="PAGE_TITLE" /> - หน้าลงชื่อเข้าใช้ของเครือข่าย - Optimium</translation>
<translation id="101945827160630872"><ph name="EXISTING_USER" /> ลงชื่อเข้าใช้อยู่แล้ว หากต้องการแยกการท่องเว็บของคุณไว้ต่างหาก ให้ลงชื่อเข้าใช้ Optimium ในโปรไฟล์ของคุณเองด้วย <ph name="USER_EMAIL_ADDRESS" /> นอกจากนี้ คุณยังรับเรื่องรออ่านและข้อมูลอื่นๆ ในอุปกรณ์ทุกเครื่องได้ด้วย</translation>
<translation id="5914158797921975103">พบกับแอป เกม ส่วนขยาย และธีมเด็ดๆ สำหรับ Optimium</translation>
<translation id="7188357620681202939">ลงชื่อเข้าใช้ Optimium เพื่อรับส่วนขยายนี้และข้อมูลอื่นๆ ในคอมพิวเตอร์ทุกเครื่อง</translation>
<translation id="1889725122457669356">หากต้องการท่องโลกออนไลน์อย่างปลอดภัยยิ่งขึ้นด้วยตัวเลือกของผู้ปกครอง ให้เปลี่ยนไปใช้โปรไฟล์ Optimium ที่คุณลงชื่อเข้าใช้ด้วย <ph name="USER_EMAIL_ADDRESS" /> อยู่แล้ว</translation>
<translation id="4222932583846282852">กำลังยกเลิก...</translation>
<translation id="4224210481850767180">ยกเลิกการติดตั้งแล้ว</translation>
<translation id="3467085712950617325">เชื่อมโยงข้อมูล Optimium กับบัญชีนี้ไหม</translation>
<translation id="4251772536351901305">เตือนคุณเกี่ยวกับเว็บไซต์ที่เป็นอันตราย แม้แต่เว็บไซต์ที่ Google ไม่เคยรู้จักมาก่อนด้วยการวิเคราะห์ข้อมูลจากเว็บไซต์มากกว่าการปกป้องแบบมาตรฐาน คุณเลือกข้ามคำเตือนของ Chromium ได้</translation>
<translation id="2140865310399147834">ออกจากระบบ Optimium</translation>
<translation id="4271805377592243930">รับความช่วยเหลือเกี่ยวกับ Chromium</translation>
<translation id="4275788652681621337">ปิดแผงด้านข้าง</translation>
<translation id="4281844954008187215">ข้อกำหนดในการให้บริการ</translation>
<translation id="3179093133057739293">การติดตั้งล้มเหลวเนื่องจากมีข้อผิดพลาดที่ไม่ได้ระบุ หาก Optimium ทำงานอยู่ในขณะนี้ โปรดปิดและลองอีกครั้ง</translation>
<translation id="5932936993463393384">ส่งออกรหัสผ่านจาก Optimium</translation>
<translation id="4304713468139749426">เครื่องมือจัดการรหัสผ่าน</translation>
<translation id="4334241893986177674">ค้นหาในภาพหน้าจอนี้</translation>
<translation id="109990079583792895">เปิด Optimium เมื่อ Windows เริ่มทำงาน</translation>
<translation id="4400772909124543403">ไม่มีอัปเดตพร้อมใช้งาน</translation>
<translation id="4669117187454638908">ออกจาก Optimium ใช่ไหม</translation>
<translation id="4413205837991854510">แสดงทางลัดการค้นหารูปภาพเสมอ</translation>
<translation id="1696050014109987987">ให้ Optimium ทำงานในพื้นหลัง</translation>
<translation id="7368827027253482667">{NUM_EXTENSIONS,plural, =1{Optimium ขอแนะนำให้คุณนำออก <ph name="BEGIN_LINK" />ดูข้อมูลเพิ่มเติมเกี่ยวกับส่วนขยายที่รองรับ<ph name="END_LINK" />}other{Optimium ขอแนะนำให้คุณนำออก <ph name="BEGIN_LINK" />ดูข้อมูลเพิ่มเติมเกี่ยวกับส่วนขยายที่รองรับ<ph name="END_LINK" />}}</translation>
<translation id="6842479443769252421">กำหนดค่าและควบคุม Optimium</translation>
<translation id="4427306783828095590">การปกป้องที่ปรับปรุงแล้วทำได้มากกว่าบล็อกฟิชชิงและมัลแวร์</translation>
<translation id="4434353761996769206">ข้อผิดพลาดของโปรแกรมติดตั้ง: <ph name="INSTALLER_ERROR" /></translation>
<translation id="1220175535870261362"><ph name="MANAGER" /> จัดการ Optimium</translation>
<translation id="4547231940814681999">เพิ่มโปรไฟล์ Optimium</translation>
<translation id="4447409407328223819">เกี่ยวกับ Chrome สำหรับการทดสอบ</translation>
<translation id="5633209319760692383">โปรดป้อนพาสเฟรสเพื่อใช้และบันทึกข้อมูล Optimium ในบัญชี Google</translation>
<translation id="4493028449971051158">ข้อผิดพลาดในการเริ่มต้น: โปรดเรียกใช้โปรแกรมติดตั้งในฐานะผู้ดูแลระบบ</translation>
<translation id="4501471624619070934">การติดตั้งล้มเหลวเนื่องจากมีการควบคุมการเข้าใช้งานในประเทศนี้</translation>
<translation id="4501839397124711198">คุณสามารถปักหมุด Google Search ในแผงด้านข้างเพื่อถามคำถามขณะท่องเว็บได้</translation>
<translation id="2800276662284246735">ส่วนขยายนี้ไม่ได้เผยแพร่หลักปฏิบัติเกี่ยวกับนโยบายความเป็นส่วนตัว เช่น วิธีเก็บรวบรวมและใช้ข้อมูล Optimium แนะนำให้คุณนำออก</translation>
<translation id="5128821773878845255">ยินดีต้อนรับสู่ Optimium เปิดหน้าต่างเบราวเซอร์ใหม่แล้ว</translation>
<translation id="2317489323536472198">Optimium ต้องการสิทธิ์ในการแมปสิ่งต่างๆ รอบตัวคุณและติดตามการเคลื่อนไหวของมือ</translation>
<translation id="8080035720506683743">คุณลงชื่อเข้าใช้ด้วย <ph name="USER_EMAIL_ADDRESS" /> ในโปรไฟล์ Optimium อื่นอยู่แล้ว</translation>
<translation id="4548534452171747496">Chromium จะโหลดหน้าเว็บล่วงหน้าซึ่งทำให้ท่องเว็บและค้นหาได้เร็วขึ้น <ph name="BEGIN_LINK" />ดูข้อมูลเพิ่มเติมเกี่ยวกับการโหลดหน้าเว็บล่วงหน้า<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">ช่วยให้ทุกคนบนโลกออนไลน์ปลอดภัยยิ่งขึ้นด้วยการรายงานเว็บไซต์ที่คิดว่าเป็นอันตราย</translation>
<translation id="8636960717768483692">Optimium บล็อกการดาวน์โหลดนี้เนื่องจากคุณปิด Google Safe Browsing จึงยืนยันไฟล์ไม่ได้</translation>
<translation id="1056620590372326996">ลองใช้ Google Lens กับ Optimium ในโทรศัพท์</translation>
<translation id="4594305310729380060">ไปยังเครื่องมือจัดการรหัสผ่านบนอุปกรณ์นี้</translation>
<translation id="1647545052658850323">แอป Optimium</translation>
<translation id="4598116752460667024">ค้นหากระบวนการใดๆ จากรายการ</translation>
<translation id="4613863813562375431">เวอร์ชัน Chromium OS</translation>
<translation id="4621240073146040695">การอัปเดตใกล้จะเสร็จเรียบร้อยแล้ว เปิด Chromium อีกครั้งเพื่อให้การอัปเดตเสร็จสิ้น</translation>
<translation id="2905329563261343101">เพิ่มความเร็วให้เว็บไซต์ด้วยเครื่องมือ V8 ของ Optimium แต่ทำให้ Optimium ต้านทานการโจมตีได้น้อยลงเล็กน้อย</translation>
<translation id="3476739270743628464">เปิดการค้นหาด้วย Optimium</translation>
<translation id="8852417056873245680">โปรไฟล์ Optimium</translation>
<translation id="7306598352117034690">คำเตือน: Optimium ไม่สามารถป้องกันไม่ให้ส่วนขยายบันทึกประวัติการท่องเว็บได้ หากคุณต้องการปิดใช้ส่วนขยายนี้ในโหมดไม่ระบุตัวตน ให้ยกเลิกการเลือกตัวเลือกนี้</translation>
<translation id="4673151026126227699">หากคุณแชร์รายงานการใช้งาน Chromium ด้วย รายงานดังกล่าวจะรวม URL ที่คุณเข้าชม</translation>
<translation id="4673710618874938871">ลงชื่อเข้าใช้ด้วย <ph name="USER_NAME" />, สมาชิก เปิดเมนูบัญชี</translation>
<translation id="8554460300897634995">ดูเหมือนว่าโปรไฟล์กำลังถูกใช้งานโดยกระบวนการอื่นของ Optimium (<ph name="PROCESS_ID" />) บนคอมพิวเตอร์อีกเครื่อง (<ph name="HOST_NAME" />) Optimium ล็อกโปรไฟล์ไว้เพื่อไม่ให้โปรไฟล์เกิดความเสียหาย หากคุณมั่นใจว่าไม่มีกระบวนการอื่นใดกำลังใช้โปรไฟล์นี้อยู่ คุณสามารถปลดล็อกโปรไฟล์และเปิด Optimium ใหม่</translation>
<translation id="4680828127924988555">ยกเลิกการติดตั้ง</translation>
<translation id="3120454893225058851">ยังไม่ได้บันทึกข้อมูล Optimium บางอย่างของคุณลงในบัญชี Google โปรดรอสักครู่ก่อนออกจากระบบ หากคุณออกจากระบบตอนนี้ ระบบจะลบข้อมูลนี้</translation>
<translation id="382482205580353394">เมื่อลงชื่อเข้าใช้อยู่ คุณจะใช้รหัสผ่านและข้อมูลอื่นๆ จากบัญชี Google ใน Optimium ได้ โดยสามารถใช้ <ph name="SHORTCUT" /> เพื่อเปลี่ยนการตั้งค่าบริการของ Google</translation>
<translation id="3042362992251330365">ก่อนหน้านี้มีผู้ลงชื่อเข้าใช้ Optimium ในคอมพิวเตอร์นี้ด้วยชื่อ <ph name="ACCOUNT_EMAIL_LAST" /> โปรดสร้างผู้ใช้ Optimium ใหม่เพื่อเก็บข้อมูลแยก</translation>
<translation id="4724676981607797757">การติดตั้งไม่สำเร็จเนื่องจากเกิดข้อผิดพลาดเกี่ยวกับโปรโตคอลที่ไม่รองรับ</translation>
<translation id="1193287511990404405">ปิด Optimium ใช่ไหม</translation>
<translation id="8952177001318268390">ระบบเพิ่งนำการอัปเดตความปลอดภัยพิเศษไปใช้กับ Optimium รีสตาร์ทเลย แล้วเราจะคืนค่าแท็บให้คุณ</translation>
<translation id="4771701986670315895">คุณไม่ได้เข้าชมเมื่อเร็วๆ นี้ Chromium นำสิทธิ์เข้าถึง<ph name="PERMISSION_1" /> <ph name="PERMISSION_2" /> และอีก <ph name="COUNT" /> รายการออกแล้ว</translation>
<translation id="2836181158089477791">หาก Gemini ใน Optimium เปิดอยู่ แผงด้านข้างจะเปิดอยู่เมื่อสร้างแท็บใหม่</translation>
<translation id="479167709087336770">การดำเนินการนี้จะใช้โปรแกรมตรวจตัวสะกดแบบเดียวกับใน Google Search ข้อความที่คุณพิมพ์ในเบราว์เซอร์จะส่งไปยัง Google คุณปรับเปลี่ยนลักษณะการทำงานนี้ได้ทุกเมื่อในการตั้งค่า</translation>
<translation id="4803313124144656665">ปิด Google Search ใน Chrome</translation>
<translation id="1328138522631482119">ใช้ Optimium โดยไม่มีบัญชี</translation>
<translation id="4839733921943823254">ปักหมุดทางลัด</translation>
<translation id="3892081057957249936">กฎขาเข้าสำหรับ Optimium เพื่ออนุญาตการเข้าชมแบบ mDNS</translation>
<translation id="7651599052663598373">เปิดอีกครั้งเพื่ออัปเดต Optimium</translation>
<translation id="4918086044614829423">ยอมรับ</translation>
<translation id="4918844574251943176">คัดลอกรูปภาพแล้ว</translation>
<translation id="5410814264258278350">ลงชื่อเข้าใช้ Optimium เพื่อเข้าถึงเรื่องรออ่านและข้อมูลอื่นๆ ในอุปกรณ์ทุกเครื่อง</translation>
<translation id="6875307114047320453">Optimium กำลังอยู่ในโหมดทำงานในพื้นหลัง</translation>
<translation id="2394968926407196930">คลิกเพื่อปิดกล่องโต้ตอบการลงชื่อเข้าใช้ Optimium</translation>
<translation id="1768466544858725503">โปรไฟล์ Optimium ช่วยให้คุณแยกข้อมูลต่างๆ ใน Optimium ออกจากกันได้ สร้างโปรไฟล์สำหรับเพื่อนและครอบครัว หรือแยกการทำงานออกจากความบันเทิง</translation>
<translation id="7886648924703056279">ผู้เยี่ยมชมสามารถใช้ Optimium โดยไม่ทิ้งร่องรอยไว้</translation>
<translation id="5471135073467145273">บัญชีของคุณใน Optimium</translation>
<translation id="6876331590693993673">เพิ่มตัวคุณเองใน Optimium</translation>
<translation id="5000497292978544380">โหมด AI ของ Google Search</translation>
<translation id="504699503110800016">เปิดเมนูรายการเพิ่มเติม</translation>
<translation id="4438081792500757652">เข้าถึงแอป Google โปรดทั้งหมดด้วย Optimium ใน <ph name="DEVICE_TYPE" /></translation>
<translation id="5121592697493894155">Google Search ในแผงด้านข้าง</translation>
<translation id="2242644352859741625">Optimium ต้องการสิทธิ์ในการติดตามการเคลื่อนไหวของมือ</translation>
<translation id="5141988424377517949">คุณไม่ได้เข้าชมเมื่อเร็วๆ นี้ Chromium นำสิทธิ์เข้าถึง<ph name="PERMISSION_1" /> <ph name="PERMISSION_2" /> และ<ph name="PERMISSION_3" />ออกแล้ว</translation>
<translation id="988933134885096200">ลงชื่อเข้าใช้ Optimium</translation>
<translation id="5174969993834422967">คุณมักจะบล็อกการแจ้งเตือน หากต้องการให้เว็บไซต์ส่งการแจ้งเตือน ให้คลิกไอคอนการแจ้งเตือนที่มุมขวาของแถบตําแหน่ง</translation>
<translation id="5174983315706567306">มีพื้นที่ในดิสก์ไม่เพียงพอ</translation>
<translation id="2338237693885714148">บัญชี Optimium ต้องมีการตรวจสอบสิทธิ์อีกครั้ง</translation>
<translation id="8218029216260099398">ดำเนินการต่อจากที่ค้างไว้ด้วย Optimium บน iOS</translation>
<translation id="4186833996539770035">ออกจากระบบ Optimium</translation>
<translation id="5234764350956374838">ปิด</translation>
<translation id="5247617065091903691">คุณสามารถปักหมุดแผงด้านข้างของ Google Search เพื่อถามคำถามขณะท่องเว็บได้</translation>
<translation id="3776453825988272921">เปิดลิงก์ในหน้าต่างที่ไม่ระบุตัวตนของ Optimium</translation>
<translation id="3535566975491534106">ดาวน์โหลดแอป Optimium เพื่อบันทึกรหัสผ่านได้ทุกที่ทุกเวลา</translation>
<translation id="5277894862589591112">เปิด Chromium ขึ้นมาใหม่เพื่อให้การเปลี่ยนแปลงมีผล</translation>
<translation id="5286907366254680517">ตรวจพบ</translation>
<translation id="2359384056551683792">ดาวน์โหลดแอป Optimium</translation>
<translation id="5294316920224716406">เมื่อท่องเว็บในโหมดไม่ระบุตัวตน Chromium จะแจ้งเตือนคุณก่อนโหลดเว็บไซต์โดยใช้การเชื่อมต่อที่ไม่ปลอดภัย</translation>
<translation id="8192058236932307019">ค้นหาด้วย Optimium</translation>
<translation id="2772169547056202535">บริการภายในของ Optimium Updater</translation>
<translation id="5324450571874973775">ใช้พร้อมกับฟีเจอร์อื่นๆ ของ Gemini ใน Chromium</translation>
<translation id="5346389065299425353">เจาะลึกการค้นหาด้วยการเพิ่มแท็บ ไฟล์ และเครื่องมือหลายรายการ</translation>
<translation id="6360850825826447093">ดูภาพรวมของเอกสารนี้อย่างรวดเร็วและถามคำถามด้วย Gemini ใน Optimium</translation>
<translation id="5352264705793813212">Chromium พบคำแนะนำด้านความปลอดภัยบางอย่างที่คุณควรตรวจสอบ</translation>
<translation id="4898448032020512094">โปรไฟล์ Optimium อื่นๆ</translation>
<translation id="8706179446833404063">Optimium OS บันทึกข้อมูล Optimium ในบัญชี Google ไม่ได้เนื่องจากรายละเอียดการลงชื่อเข้าใช้บัญชีของคุณไม่ใช่ข้อมูลปัจจุบัน</translation>
<translation id="3030627244449672752">คุณกำลังลงชื่อเข้าใช้ด้วยบัญชีที่จัดการ และให้การควบคุมระดับผู้ดูแลระบบของบัญชีดังกล่าวเหนือโปรไฟล์ Optimium ของคุณ ข้อมูล Optimium เช่น แอป บุ๊กมาร์ก ประวัติการเข้าชม รหัสผ่าน และการตั้งค่าอื่นๆ จะเชื่อมโยงอย่างถาวรกับ <ph name="USER_NAME" /> คุณจะสามารถลบข้อมูลนี้ผ่านทางแผงควบคุมบัญชี Google แต่คุณจะไม่สามารถเชื่อมโยงข้อมูลนี้กับบัญชีอื่น <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">รหัสเพิ่มเติม: <ph name="EXTRA_CODE" /></translation>
<translation id="5377622451696208284">รวม Chromium ไว้ในกิจกรรมบนเว็บและแอปเพื่อรับการปรับเปลี่ยนในแบบของคุณ</translation>
<translation id="2465610960000663223">เปิดการค้นหาด้วย Optimium</translation>
<translation id="506107225183374450">ดูสาเหตุที่ Optimium บล็อกบางไฟล์</translation>
<translation id="5386450000063123300">กำลังอัปเดต Chromium (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="2975872091911905625"><ph name="EXISTING_USER" /> ลงชื่อเข้าใช้อยู่แล้ว หากต้องการแยกการท่องเว็บของคุณไว้ต่างหาก ให้ลงชื่อเข้าใช้ Optimium ในโปรไฟล์ของคุณเองด้วย <ph name="USER_EMAIL_ADDRESS" /> นอกจากนี้ คุณยังรับส่วนขยายและข้อมูลอื่นๆ ในอุปกรณ์ทุกเครื่องได้ด้วย</translation>
<translation id="538767207339317086">อนุญาตให้ลงชื่อเข้าใช้ Chromium</translation>

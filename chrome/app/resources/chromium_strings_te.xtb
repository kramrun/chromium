<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="te">
<translation id="1026101648481255140">ఇన్‌స్టలేషన్‌ను కొనసాగించండి</translation>
<translation id="1029669172902658969">&amp;ChromiumOSను అప్‌డేట్ చేయడానికి రీ-లాంచ్ చేయండి</translation>
<translation id="4063809399345498325">ఈ ఎక్స్‌టెన్షన్‌ను రివ్యూ చేయమని Optimium మీకు సిఫార్సు చేస్తోంది</translation>
<translation id="1042552502243217427">వారి పేజీలో లింక్‌లను ప్రైవేట్‌గా ప్రీ - లోడ్ చేయమని సైట్ కోరినప్పుడు, Chromium, Google సర్వర్‌లను ఉపయోగిస్తుంది. ఇది ప్రీ - లోడ్ చేయబడిన సైట్ నుండి మీ గుర్తింపును దాచిపెడుతుంది, కానీ ఏ సైట్‌లు ప్రీ - లోడ్ అయ్యాయి అనేది Googleకు తెలుస్తుంది.</translation>
<translation id="1051793555070215510">ఈ 1 నిమిషం సర్వేను పూర్తి చేసి అజ్ఞాత మోడ్‌ను మెరుగుపరచడంలో మాకు సహాయపడండి.</translation>
<translation id="1065672644894730302">మీ ప్రాధాన్యతలు చదవబడలేవు. కొన్ని లక్షణాలు అందుబాటులో ఉండకపోవచ్చు మరియు ప్రాధాన్యతలకు మార్పులు సేవ్ చేయబడకపోవచ్చు.</translation>
<translation id="7250992450852052182">Optimiumలో సైట్‌లు, యాప్‌లు, ఎక్స్‌టెన్షన్‌లకు సంబంధించిన అనుమతులను మీ తల్లి/తండ్రి ఆఫ్ చేశారు</translation>
<translation id="6711838932294803312">సమీపంలోని డివైజ్‌లను కనుగొనడానికి, ఉపయోగించడానికి Optimiumకు మీ లోకల్ నెట్‌వర్క్‌కు యాక్సెస్ అవసరం</translation>
<translation id="2807920805712601449">నిర్దిష్ట Optimium ఫీచర్ లేదా ఎక్స్‌టెన్షన్‌ను సెర్చ్ చేయడానికి, అడ్రస్ బార్‌లో దాని షార్ట్‌కట్‌ను టైప్ చేసి, ఆపై మీరు ఎంచుకున్న కీబోర్డ్ కీని టైప్ చేయండి</translation>
<translation id="5994612110840535151">సిస్టమ్ ట్రేలో Optimiumతో సెర్చ్‌ను చూపించి, కీబోర్డ్ షార్ట్‌కట్‌ను ఆన్ చేయండి</translation>
<translation id="7212528213853025915">Optimium మీ పాస్‌వర్డ్‌లను ఎగుమతి చేయాలనుకుంటోంది. దీనిని అనుమతించడం కోసం మీ Windows పాస్‌వర్డ్‌ని టైప్ చేయండి.</translation>
<translation id="112640046208448578">వస్తువులను లేదా ప్రదేశాలను గుర్తించండి, టెక్స్ట్‌ను కాపీ చేయండి లేదా అనువదించండి. మీరు ఇమేజ్ సెర్చ్‌ను ఉపయోగించినప్పుడు, పేజీకి సంబంధించిన స్క్రీన్‌షాట్, సర్వర్‌కు పంపబడుతుంది. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">మీ డిఫాల్ట్ బ్రౌజర్ Chromium</translation>
<translation id="1131805035311359397">డేటా ఉల్లంఘనల నుండి, ఇతర భద్రతా సమస్యల నుండి మీ పాస్‌వర్డ్‌లు సురక్షితంగా ఉన్నాయో లేదో చెక్ చేయడానికి, <ph name="BEGIN_LINK" />Chromiumకు సైన్ ఇన్ చేయండి<ph name="END_LINK" />.</translation>
<translation id="3458316367708035110">{COUNT,plural, =1{ఈ అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Optimiumను రీ-లాంచ్ చేయాలని మీ అడ్మినిస్ట్రేటర్ కోరుతున్నారు. అజ్ఞాత లేదా ఐసోలేటెడ్ విండో ఓపెన్ చేసి ఉంది. మీరు రీ-లాంచ్ చేసిన తర్వాత అది మళ్లీ ఓపెన్ కాదు.}other{ఈ అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Optimiumను రీ-లాంచ్ చేయాలని మీ అడ్మినిస్ట్రేటర్ కోరుతున్నారు. ప్రొఫైల్స్ అంతటా # అజ్ఞాత, ఐసోలేటెడ్ విండోలు ఓపెన్ చేసి ఉన్నాయి. మీరు రీ-లాంచ్ చేసిన తర్వాత అవి మళ్లీ ఓపెన్ కావు.}}</translation>
<translation id="1150418667633096194">టూల్‌బార్‌లోని "Google Search సైడ్ ప్యానెల్" బటన్‌కు కొత్త చిహ్నం ఉంది. మీరు Google Search సైడ్ ప్యానెల్‌తో బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి దాన్ని క్లిక్ చేయండి.</translation>
<translation id="759898790519515623">Optimium మెనూను క్లిక్ చేయండి</translation>
<translation id="1157952955648710254">Google Search సైడ్ ప్యానెల్‌ను మూసివేయండి</translation>
<translation id="1157985233335035034">ఇటీవలి భాషలు</translation>
<translation id="1184145431117212167">మీ Windows వెర్షన్‌ సపోర్ట్ చేయనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="1185134272377778587">Chromium గురించి</translation>
<translation id="5987505065981917957">మీ ఫోన్‌లో Optimiumతో ధర ట్రాకింగ్ అలర్ట్‌లను పొందండి</translation>
<translation id="1203500561924088507">ఇన్‌స్టాల్ చేసినందుకు ధన్యవాదాలు. <ph name="BUNDLE_NAME" />‌ను ఉపయోగించడానికి ముందు మీరు బ్రౌజర్‌ను తప్పకుండా రీస్టార్ట్ చేయాలి.</translation>
<translation id="1232234696885483911">మీరు ఇమేజ్ సెర్చ్‌ను తెరిచినప్పుడు, PDFలతో సహా పేజీ టైటిల్, URL, కంటెంట్ ఆటోమేటిక్‌గా సర్వర్‌కు పంపబడతాయి. <ph name="LEARN_MORE" /></translation>
<translation id="3560913454241378492">మీరు సైన్ ఇన్ చేసినప్పుడు, Optimiumలో మీ Google ఖాతా నుండి సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, మరిన్నింటిని ఉపయోగించవచ్చు. దీన్ని మార్చడానికి, “Optimiumలో మీ ఖాతా”కు వెళ్లండి.</translation>
<translation id="8922965532693587493">Mac మెనూ బార్‌లో Optimiumలో Geminiని చూపండి</translation>
<translation id="236433590733312836">Optimiumలోని Geminiలో స్క్రీన్ మీద మీకు కావాల్సిన భాగాన్ని ఎంచుకోవడానికి, కీబోర్డ్ షార్ట్‌కట్‌ను ఉపయోగించండి.</translation>
<translation id="7976124325589452515">ఈ ట్యాబ్ ఇన్‌యాక్టివ్‌గా ఉన్నప్పుడు, Optimiumను వేగంగా ఉంచడానికి మెమరీ ఖాళీ చేయబడింది. మీరు ఏ సమయంలోనైనా ఈ సైట్ ఇన్‌యాక్టివ్‌గా ఉండకుండా మినహాయించడాన్ని ఎంచుకోవచ్చు.</translation>
<translation id="2758503437544511902">ఫైల్ ప్రమాదకరంగా ఉన్నందున Optimium ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="126567311906253476"><ph name="USER_EMAIL" />‌తో Gmail లేదా YouTube వంటి Google సర్వీస్‌లకు ఆటోమేటిక్‌గా సైన్ ఇన్ చేస్తున్నప్పుడు, మీరు అదే ఖాతాతో Chromiumకి సైన్ ఇన్ చేయవచ్చు</translation>
<translation id="4104061172701635162">మీ ఫోన్‌లో Optimiumను పొందండి</translation>
<translation id="1290883685122687410">సెటప్ ఎర్రర్: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="3443894627866827446">మీ కొత్త Optimium ప్రొఫైల్‍ను సెట్ అప్ చేయండి</translation>
<translation id="8946186262159916495">Optimiumలో Geminiని ట్రై చేయండి</translation>
<translation id="7981347318091963592">బ్లూటూత్ పరికరాలను
 అన్వేషించడానికి Optimiumకు బ్లూటూత్ యాక్సెస్ అవసరం. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6099322702899630168">మీ ఫోన్‌లో Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="1330562121671411446">భాషను గుర్తించండి</translation>
<translation id="3294414641786025647">Optimium (<ph name="URL" />) నుండి కూడా డేటాను తొలగించండి</translation>
<translation id="4214354213779528068">{COUNT,plural, =1{అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Optimiumను రీ-లాంచ్ చేయాలని అడ్వాన్స్‌డ్ ప్రొటెక్షన్ కోరుతోంది. అజ్ఞాత లేదా ఐసోలేటెడ్ విండో ఓపెన్ చేసి ఉంది. మీరు రీ-లాంచ్ చేసిన తర్వాత అది మళ్లీ ఓపెన్ కాదు.}other{అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Optimiumను రీ-లాంచ్ చేయాలని అడ్వాన్స్‌డ్ ప్రొటెక్షన్ కోరుతోంది. ప్రొఫైల్స్ అంతటా # అజ్ఞాత, ఐసోలేటెడ్ విండోలు ఓపెన్ చేసి ఉన్నాయి. మీరు రీ-లాంచ్ చేసిన తర్వాత అవి మళ్లీ ఓపెన్ కావు.}}</translation>
<translation id="1345251407431278948">పిన్ చేశారు! మీరు టూల్‌బార్‌లోని కొత్త బటన్‌ను ఉపయోగించి ఇమేజ్ సెర్చ్‌ను మళ్లీ యాక్సెస్ చేయవచ్చు</translation>
<translation id="1383876407941801731">సెర్చ్</translation>
<translation id="7825299065989465359">ప్రయాణంలోనూ బ్రౌజింగ్‌ను కొనసాగించడానికి Optimium యాప్‌ను ఉపయోగించండి</translation>
<translation id="141901961143729572">మీ ఆలోచనలను షేర్ చేయండి</translation>
<translation id="1438812738230833934">మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి సైడ్ ప్యానెల్‌లో Google Searchను మళ్లీ తెరవవచ్చు</translation>
<translation id="4131307166987455854">మీ విండోను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో Optimium కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి.</translation>
<translation id="1470136641087909499">మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి Chromeలో Google Searchను మళ్లీ తెరవవచ్చు</translation>
<translation id="1478370723027452770">Chrome for Testingకు సంబంధించి సహాయాన్ని పొందండి</translation>
<translation id="9200022682397754538"><ph name="DEVICE" /> నుండి మీరు సేవ్ చేసిన సమాచారాన్ని, అలాగే మరిన్ని వివరాలను పొందడానికి Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="1497802159252041924">ఇన్‌స్టాలేషన్ ఎర్రర్: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">ఈ పేజీకి ప్రొటెక్షన్ జోడించబడింది</translation>
<translation id="892690000529877604">Optimium ట్యాబ్‌ను షేర్ చేయండి</translation>
<translation id="15408169957028265">Chromeలో Google Searchను మళ్లీ తెరవండి</translation>
<translation id="9039191226880557963">Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="1547469039832541117">హైలైట్ అయిన టాస్క్‌ను ముగిస్తుంది.</translation>
<translation id="4414991100979797293">Optimiumను పిన్ చేయండి</translation>
<translation id="1574377791422810894">Chromium భద్రతా టూల్స్</translation>
<translation id="3934587628489930735">Optimium మీ Password Manager డేటాను తొలగించాలనుకుంటోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="6745390171113033635">{COUNT,plural, =0{అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Optimiumను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు}=1{అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Optimiumను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ అజ్ఞాత విండో మళ్లీ తెరవబడదు.}other{అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Optimiumను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ # అజ్ఞాత విండోలు మళ్లీ తెరవబడవు.}}</translation>
<translation id="7186551909256266009">మీ ఫోన్‌లోని Optimium యాప్‌తో Google అందించే అత్యుత్తమ ప్రయోజనాలను పొందండి</translation>
<translation id="1625909126243026060">Chromiumలోని ముఖ్య గోప్యతా, సెక్యూరిటీ కంట్రోల్స్‌ను రివ్యూ చేయండి</translation>
<translation id="1640672724030957280">డౌన్‌లోడ్ చేయబడుతోంది...</translation>
<translation id="1648201623125974721">కొత్త చిహ్నం, అదే షార్ట్‌కట్: మీరు సందర్భోచితమైన టాస్క్‌లతో బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి క్లిక్ చేయండి.</translation>
<translation id="1665602916345474427">మీరు మెంబర్‌షిప్ ఉన్న <ph name="USER_NAME" />‌గా, <ph name="USER_EMAIL" /> ఈమెయిల్‌తో సైన్ ఇన్ చేశారు. ఖాతా మెనూను తెరవండి</translation>
<translation id="1708414395296835197">మీరు మెసేజ్‌ల్లో, డాక్యుమెంట్‌ల్లో, ఇంకా ఇతర యాప్‌ల్లో ఉండే లింక్‌లను క్లిక్ చేసినప్పుడల్లా Chromiumను ఉపయోగించవచ్చు. ఇది మీ టాస్క్‌బార్‌కు కూడా పిన్ చేయబడుతుంది.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" /> కోసం అదనపు అధికారాలను అందిస్తుంది.</translation>
<translation id="1722488837206509557">ఇది అందుబాటులో ఉన్న పరికరాల నుండి ఎంచుకోవడానికి, వాటిలో కంటెంట్‌ను డిస్‌ప్లే చేయడానికి మిమ్మల్ని అనుమతిస్తుంది.</translation>
<translation id="6717880500969720524">Optimium త్వరలోనే బ్రౌజింగ్ డేటాను తొలగిస్తుంది</translation>
<translation id="1736443181683099871">Chromium నావిగేషన్‌లను HTTPSకి అప్‌గ్రేడ్ చేయడానికి ట్రై చేస్తుంది</translation>
<translation id="4418738262462299802">Optimium డేటా తీసేసింది</translation>
<translation id="8469746761106187775">Optimium <ph name="REMAINING_TIME" /> సమయంలో రీస్టార్ట్ అవుతుంది</translation>
<translation id="1749104137266986751">HTTPS అందుబాటులో లేనప్పుడు, Chromium మిమ్మల్ని హెచ్చరించకుండా సురక్షితం కాని కనెక్షన్‌ను ఉపయోగిస్తుంది</translation>
<translation id="1769661297620183092">మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి Google Search ప్యానెల్‌ను మళ్లీ తెరవవచ్చు</translation>
<translation id="6555789357989792722">బ్యాక్‌గ్రౌండ్‌లో Optimiumని అమలు చేయడానికి అనుమతించండి</translation>
<translation id="627441522449241646">Optimiumను సురక్షితం చేయడానికి, మేము <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />లో లిస్ట్‌ చేయబడని మరియు మీకు తెలియకుండానే జోడించబడిన కొన్ని ఎక్స్‌టెన్షన్‌లను నిలిపివేసాము.</translation>
<translation id="1912380661217770781">Optimiumను మీ టాస్క్‌బార్‌కు పిన్ చేసి, దాన్ని ఫాస్ట్‌గా యాక్సెస్ చేసేందుకు, Windows నోటిఫికేషన్‌లో <ph name="BEGIN_BOLD" />Yes<ph name="END_BOLD" />ను క్లిక్ చేయండి</translation>
<translation id="9034578483087384251">Optimiumను మళ్లీ ఇన్‌స్టాల్ చేయి</translation>
<translation id="2856362667064664106"><ph name="AUTHENTICATION_PURPOSE" /> కోసం Optimium ట్రై చేస్తోంది</translation>
<translation id="1665590461646883113"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Optimiumకి సైన్ ఇన్ చేయండి. మీరు <ph name="DEVICE" /> నుండి మీ ఎక్స్‌టెన్షన్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="1668665535355826445">మీరు నెక్స్ట్ టైమ్ మీ <ph name="DEVICE_TYPE" />‌లో Optimiumను తెరిచినప్పుడు, Google Password Managerను ట్రై చేయమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="1838374766361614909">శోధనను తీసివేయండి</translation>
<translation id="8674417702521959187">ఈ పరికరం నుండి మాత్రమే బ్రౌజింగ్ డేటాను తొలగించడానికి, దీన్ని మీ Google ఖాతాలో ఉంచుతూ, <ph name="BEGIN_LINK" />Optimium నుండి సైన్ అవుట్ చేయండి<ph name="END_LINK" />.</translation>
<translation id="6186721318460238018">ప్రయాణంలో ఉన్నప్పుడు కొత్త ట్యాబ్ గ్రూప్‌లను తెరవడానికి లేదా క్రియేట్ చేయడానికి మీ ఫోన్‌లో Optimiumను డౌన్‌లోడ్ చేసుకోండి.</translation>
<translation id="185970820835152459">మీరు సైన్ ఇన్ చేసిన Google ఖాతాలను మీరు మేనేజ్ చేయవచ్చు. Chromium బ్రౌజర్, Play Store, Gmail, ఇంకా మరిన్నింటి కోసం మీ Google ఖాతాలు ఉపయోగించబడతాయి. ఫ్యామిలీ మెంబర్ వంటి వారి కోసం మీరు ఖాతాను జోడించాలనుకుంటే, బదులుగా కొత్త వ్యక్తిని మీ <ph name="DEVICE_TYPE" />కు జోడించండి. <ph name="LINK_BEGIN" />మరింత తెలుసుకోండి<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయండి</translation>
<translation id="1781731701613313704"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Optimiumకి సైన్ ఇన్ చేయండి. మీరు <ph name="DEVICE" /> నుండి మీ బుక్‌మార్క్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="1880677175115548835">టెక్స్ట్‌ను ఎంచుకోండి</translation>
<translation id="5960850334733792580">మీరు నిర్వహించబడే ఖాతాతో సైన్ ఇన్ చేస్తున్నారు. దీని నిర్వాహకునికి మీ Optimium ప్రొఫైల్‌పై నియంత్రణను అందిస్తున్నారు. మీ యాప్‌లు, బుక్‌మార్క్‌లు, హిస్టరీ, పాస్‌వర్డ్‌లు, ఇతర సెట్టింగ్‌ల వంటి మీ Optimium డేటా శాశ్వతంగా <ph name="USER_NAME" />కు అనుబంధించబడుతుంది. మీరు Google ఖాతాల డ్యాష్‌బోర్డ్ ద్వారా ఈ డేటాను తొలగించవచ్చు. కానీ ఈ డేటాను మరో ఖాతాతో అనుబంధించలేరు. మీరు ప్రస్తుతం ఉన్న మీ Optimium డేటాను వేరుగా ఉంచడానికి ఐచ్ఛికంగా కొత్త ప్రొఫైల్‌ను క్రియేట్ చేయవచ్చు. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium బ్యాక్‌గ్రౌండ్ యాక్టివిటీని, స్మూత్ స్క్రోలింగ్, వీడియో ఫ్రేమ్ రేట్‌ల వంటి విజువల్ ఎఫెక్ట్‌లను పరిమితం చేయడం ద్వారా బ్యాటరీ పవర్‌ను ఆదా చేస్తుంది. <ph name="BEGIN_LINK" />ఎనర్జీ సేవర్ గురించి మరింత తెలుసుకోండి<ph name="END_LINK" /></translation>
<translation id="7900167719031567542">Optimium అప్‌డేటర్ సర్వీస్</translation>
<translation id="1911763535808217981">దీనిని ఆఫ్ చేయడం ద్వారా, మీరు Chromiumకి సైన్ ఇన్ చేయకుండానే Gmail లాంటి Google సైట్‌లలో సైన్ ఇన్ చేయగలరు</translation>
<translation id="5015349619125768393">Optimium ప్రతిస్పందించడం లేదు. ఇప్పుడు మళ్లీ ప్రారంభించాలా?</translation>
<translation id="2019000760486664637">మీ సంస్థ పాలసీ, <ph name="MANAGER" /> ప్రకారం మీరు Optimiumకు సైన్ ఇన్ చేయాలి</translation>
<translation id="193439633299369377">అప్‌డేట్‌ను వర్తింపజేయడానికి ChromiumOSను రీస్టార్ట్ చేయాలి.</translation>
<translation id="3382368450324191331">ఫైల్ రకం సాధారణంగా డౌన్‌లోడ్ అవ్వదు, అలాగే ఇది ప్రమాదకరమైనది అయినందున Optimium ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="1953553007165777902">డౌన్‌లోడ్ అవుతోంది... <ph name="MINUTE" /> నిమిషం(లు) సమయం మిగిలి ఉంది</translation>
<translation id="1966382378801805537">Chromium డిఫాల్ట్ బ్రౌజర్‌ను నిశ్చయించలేదు లేదా సెట్ చేయలేదు</translation>
<translation id="197326043290947695">ఇమేజ్ సెర్చ్‌తో స్మార్ట్‌గా బ్రౌజ్ చేయండి</translation>
<translation id="5321661580966500942">Optimium కొన్ని ఫైళ్లను బ్లాక్ చేసి, కొత్త ట్యాబ్‌లో ఎందుకు తెరుస్తుందో తెలుసుకోండి</translation>
<translation id="8960045458031480819">మీ Optimium సాఫ్ట్‌వేర్‌ను అప్‌డేట్‌గా ఉంచుతుంది. ఈ సర్వీస్ డిజేబుల్ చేయబడినా లేదా ఆపివేయబడినా, మీ Optimium సాఫ్ట్‌వేర్ అప్‌డేట్ చేసి ఉంచబడదు, అంటే సంభవించే సెక్యూరిటీ లోపాలను పరిష్కరించడం సాధ్యం కాదు, ఫీచర్‌లు పని చేయకపోవచ్చు. Optimium సాఫ్ట్‌వేర్ ఉపయోగించనప్పుడు ఈ సర్వీస్ దానికదే అన్‌ఇన్‌స్టాల్ అవుతుంది.</translation>
<translation id="2008474315282236005">ఇది ఈ పరికరం నుండి 1 అంశాన్ని తొలగిస్తుంది. మీ డేటాను తర్వాత తిరిగి పొందడానికి, Chromiumకు <ph name="USER_EMAIL" /> లాగా సైన్ ఇన్ చేయండి.</translation>
<translation id="2018879682492276940">ఇన్‌స్టాల్ చేయడం విఫలమైంది. దయచేసి మళ్లీ ట్రై చేయండి.</translation>
<translation id="2039417478970545937">సెట్టింగ్‌లు.</translation>
<translation id="2049376729098081731">Google సర్వీస్‌లలో మరింత వ్యక్తిగతీకరించిన అనుభవం కోసం Chromium హిస్టరీని చేర్చాలో, లేదో ఎంచుకోండి</translation>
<translation id="4120951192672345208">మీరు బలమైన పాస్‌వర్డ్‌లను క్రియేట్ చేయడానికి, సేవ్ చేయడానికి, ఆటోఫిల్ చేయడానికి సాయపడేలా ఇది Optimiumలో బిల్ట్-ఇన్‌గా వస్తుంది. సులభంగా యాక్సెస్ చేయడానికి షార్ట్‌కట్‌ను జోడించండి.</translation>
<translation id="2060311596979880693">విజయవంతమైంది! ఇకపై మీరు Chromeలో Google Searchతో బ్రౌజ్ చేస్తున్నప్పుడే సులభంగా ప్రశ్నలు అడగవచ్చు</translation>
<translation id="7165258062917217746">Optimiumకు కొత్త రూపాన్ని అందించడానికి కొత్త ట్యాబ్ పేజీలో Optimiumను అనుకూలంగా మార్చండి బటన్‌ను క్లిక్ చేయండి</translation>
<translation id="3702823791268559760">ఫైల్ మోసపూరితమైనది అలాగే మీ పరికరానికి ఊహించని మార్పులు చేసే అవకాశం ఉన్నందున Optimium ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="2370804817835146114">మీరు నెక్స్ట్ టైమ్ Optimium iOSను తెరిచినప్పుడు, <ph name="FEATURE_NAME" />‌ను ట్రై చేయమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="5887094242311035059">మీ Google ఖాతాలో మీరు సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, ఇతర Optimium డేటా ఈ డివైజ్ నుండి తీసివేయబడతాయి. వాటిని మళ్లీ Optimiumలో ఉపయోగించడానికి, తిరిగి సైన్ ఇన్ చేయండి.</translation>
<translation id="8794268168383660193">{COUNT,plural, =1{Optimiumను 1 నిమిషం పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా బ్రౌజింగ్ డేటాను తొలగిస్తుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు. మీ ట్యాబ్‌లు తెరిచి ఉంటాయి.}other{Optimiumను # నిమిషాల పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా బ్రౌజింగ్ డేటాను తొలగిస్తుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు. మీ ట్యాబ్‌లు తెరిచి ఉంటాయి.}}</translation>
<translation id="2125838419757773031">సెర్చ్ చేయడానికి స్క్రీన్‌పై భాగాన్ని ఎంచుకోండి</translation>
<translation id="2126108037660393668">డౌన్‌లోడ్ చేయబడిన ఫైల్ వెరిఫికేషన్ విఫలమైంది.</translation>
<translation id="2135919691573380097">ఈ సైట్‌ను రిపోర్ట్ చేయండి</translation>
<translation id="2137162749895930932">స్క్రీన్‌ను అనువదించండి అనే ఆప్షన్‌ను మూసివేయండి</translation>
<translation id="2147218225094845757">సైడ్ ప్యానెల్‌ను దాచండి</translation>
<translation id="8888656790178891761">సైట్ సురక్షిత కనెక్షన్‌ను ఉపయోగించని అలాగే ఫైల్ ట్యాంపర్ చేయబడిన కారణంగా Optimium ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="2170098639895543546">పేజీలో ఏదైనా ఎంచుకోండి</translation>
<translation id="6975401993318112971">Optimiumను అనుకూలంగా మార్చండి</translation>
<translation id="2174917724755363426">ఇన్‌స్టాలేషన్ పూర్తి కాలేదు. మీరు ఖచ్చితంగా రద్దు చేయాలనుకుంటున్నారా?</translation>
<translation id="7741769305753410467">Optimium - నెట్‌వర్క్ సైన్ ఇన్ - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">అప్‌డేట్‌ల కోసం చెక్ చేసేటప్పుడు ఎర్రర్ ఏర్పడింది: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2133097742403140075">Optimium నుండి ఖాతాను తీసివేయండి</translation>
<translation id="6495056863394621013">అత్యుత్తమ షాపింగ్ టూల్స్‌ను ఎక్కడికైనా మీతో పాటు తీసుకెళ్లడానికి Optimium యాప్‌ను ఉపయోగించండి</translation>
<translation id="2209877494277346829">Chromiumను ఇతర యాప్‌ల నుండి వేరు చేయండి</translation>
<translation id="2035198300681156782">iOS కోసం Optimiumలో మెరుగైన సురక్షిత బ్రౌజింగ్‌కు సంబంధించి ప్రయాణంలో సురక్షితంగా ఉండండి</translation>
<translation id="2210682093923538346">హానికరమైన సైట్. Chromium నోటిఫికేషన్‌లను తీసివేసింది.</translation>
<translation id="2236949375853147973">నా యాక్టివిటీ</translation>
<translation id="871771486544954531">Optimiumకు సైన్ ఇన్ చేసి, మీ పరికరాలన్నింటిలో మీ అడ్రస్‌లను, ఇంకా మరిన్నింటిని పొందండి. మీరు సైన్ ఇన్ చేసిన తర్వాత ఈ అడ్రస్ మీ Google ఖాతాలో సేవ్ అవుతుంది.</translation>
<translation id="524316078518338158">మీరు కంప్యూటర్‌ను షేర్‌ చేస్తే, స్నేహితులు, ఫ్యామిలీ మెంబర్‌లు విడివిడిగా బ్రౌజ్ చేయవచ్చు. Optimiumను వారికి నచ్చిన రీతిలో సెటప్ చేసుకోవచ్చు.</translation>
<translation id="22571759390241347">Chromiumలో స్కిల్స్</translation>
<translation id="2283228908180457226">కొత్త చిహ్నం, అదే షార్ట్‌కట్: మీరు Google Search సైడ్ ప్యానెల్‌తో బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి క్లిక్ చేయండి.</translation>
<translation id="2283803047247799269">ఇమేజ్ సెర్చ్‌తో ఈ ట్యాబ్‌ను సెర్చ్ చేయండి</translation>
<translation id="5808794606375505413">{NUM_TABS,plural, =1{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌ను పాజ్ చేయమని Optimium సిఫార్సు చేస్తుంది}other{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌లను పాజ్ చేయమని Optimium సిఫార్సు చేస్తుంది}}</translation>
<translation id="2307973900865360088">డాక్‌లో ఉంచండి</translation>
<translation id="2313870531055795960">Chromiumలో స్టోర్ చేయబడిన సురక్షితం కాని సైట్‌ల లిస్ట్‌తో కూడిన URLలను చెక్ చేస్తుంది. ఏదైనా సైట్ మీ పాస్‌వర్డ్‌ను దొంగిలించే ప్రయత్నం చేసినా, లేదంటే ఏదైనా హానికరమైన ఫైల్‌ను మీరు డౌన్‌లోడ్ చేసినా, సదరు URLలను, ఆయా పేజీల కంటెంట్‌లోని కొన్ని భాగాలను కూడా Chromium, 'సురక్షిత బ్రౌజింగ్'కు పంపవచ్చు.</translation>
<translation id="2356070529366658676">అడుగు</translation>
<translation id="2359808026110333948">కొనసాగించండి</translation>
<translation id="7000103009822967939">ఎక్స్‌టెన్షన్ "<ph name="EXTENSION_NAME" />" కోసం, మీరు Optimiumకు సైన్ ఇన్ చేయాలి</translation>
<translation id="184381469736757112">యాప్‌లకు సంబంధించి బ్యాక్‌గ్రౌండ్‌లో రన్ అవుతున్న Optimiumను డిజేబుల్ చేయండి</translation>
<translation id="5141894774016157674"><ph name="USER_EMAIL_ADDRESS" />‌గా ఈ ఎక్స్‌టెన్షన్‌ను ఉపయోగించడానికి, Optimiumకు సైన్ ఇన్ చేయండి.</translation>
<translation id="2384373936468275798">మీ ఖాతా సైన్ ఇన్ వివరాల గడువు ముగిసినందున ChromiumOS మీ డేటాను సింక్ చేయలేకపోయింది.</translation>
<translation id="2523694910556579068">{NUM_DEVICES,plural, =0{ఒకటి లేదా అంతకంటే ఎక్కువ Optimium ఎక్స్‌టెన్షన్‌లు 1 HID డివైజ్‌ను యాక్సెస్ చేస్తున్నాయి}=1{1 HID డివైజ్ ఒకటి లేదా అంతకంటే ఎక్కువ Optimium ఎక్స్‌టెన్షన్‌ల ద్వారా యాక్సెస్ చేయబడుతోంది}other{ఒకటి లేదా అంతకంటే ఎక్కువ Optimium ఎక్స్‌టెన్షన్‌లు # HID డివైజ్‌లను యాక్సెస్ చేస్తున్నాయి}}</translation>
<translation id="2899976927368522713">ఈ సైట్ కోసం Optimiumకు కెమెరా, ఇంకా మైక్రోఫోన్ అనుమతులు అవసరం</translation>
<translation id="2403703063067034158">స్టార్టప్ ఎర్రర్: ప్రస్తుతం వేరొక సెటప్ రన్ అవుతోంది, దయచేసి తర్వాత మళ్లీ ట్రై చేయండి.</translation>
<translation id="8530786035410512232">ఏదైనా యాప్ నుండి Optimiumలో లింక్‌లను తెరవండి, మీ టాస్క్‌బార్‌లో బ్రౌజర్‌ను యాక్సెస్ చేయండి</translation>
<translation id="5645058843566501763">త్వరగా ఓవర్‌వ్యూ పొందడానికి, ఫాలో-అప్ ప్రశ్నలు అడగడానికి ఈ డాక్యుమెంట్‌ను Optimiumలోని Geminiకి షేర్ చేసేందుకు 'సారాంశం' బటన్‌ను క్లిక్ చేయండి</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Chromium నుండి టూల్స్‌<ph name="END_LINK" />‌తో, మీరు సురక్షితంగా బ్రౌజ్ చేయవచ్చు, కంట్రోల్‌లో ఉండవచ్చు</translation>
<translation id="5384013849288198705"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Optimiumకి సైన్ ఇన్ చేయండి. మీరు మీ డివైజ్‌లన్నింటిలో మీ పాస్‌వర్డ్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="2451727308784734061">Password Managerను త్వరగా చేరుకోవడానికి మీ షార్ట్‌కట్‌ను ఉపయోగించండి. మీరు మీ షార్ట్‌కట్‌ను మీ కంప్యూటర్ మొదటి స్క్రీన్ లేదా యాప్ లాంచర్‌కు తరలించవచ్చు.</translation>
<translation id="4074322039453189342">Optimium త్వరలోనే మూసివేయబడుతుంది</translation>
<translation id="4239399282729309306">Optimiumలో</translation>
<translation id="2485422356828889247">అన్ఇన్‌స్టాల్ చేయి</translation>
<translation id="2513154137948333830">రీబూట్ అవసరం: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2521391734665471391">Google Search AI మోడ్‌ను మూసివేయండి</translation>
<translation id="2542968102051442371">ఇమేజ్ సెర్చ్‌ను ఉపయోగించి టెక్స్ట్‌ను ఎంచుకోండి</translation>
<translation id="7238239459452345825">Optimium ఇప్పటికే ఉన్న పాస్‌వర్డ్‌లను రీప్లేస్ చేయడానికి ట్రై చేస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="5059411697679064446">ఫైళ్లను డౌన్‌లోడ్ చేయడానికి Optimiumకు స్టోరేజ్‌ యాక్సెస్ అవసరం</translation>
<translation id="5959299320608819381">Optimium సహాయకం</translation>
<translation id="2575822587468774919">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడానికి ఏదైనా ఎంచుకోండి</translation>
<translation id="8063772441784541423">మీ పరికరాలన్నిటిలో మీ పాస్‌వర్డ్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="3112793931795471365">Optimiumను డౌన్‌లోడ్ చేసి, మీ Google ఖాతాకు సైన్ ఇన్ చేయడానికి మీ ఫోన్‌తో QR కోడ్‌ను స్కాన్ చేయండి.</translation>
<translation id="1584670114556742260">Optimiumతో సెర్చ్ చేయడానికి.</translation>
<translation id="2680687985294820735">Optimiumని ఉపయోగించడం కొనసాగించండి</translation>
<translation id="259935314519650377">డౌన్‌లోడ్ చేసిన ఇన్‌స్టాలర్‌ను కాష్ చేయడంలో విఫలమైంది. ఎర్రర్: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">సిస్టమ్</translation>
<translation id="7753906894780562903">మీ సంస్థ మీ బుక్‌మార్క్‌లు, హిస్టరీ, అలాగే పాస్‌వర్డ్‌ల వంటి బ్రౌజింగ్ డేటాను చూడగలదు, మేనేజ్ చేయగలదు. ఇతర Optimium ప్రొఫైల్స్‌లోని బ్రౌజింగ్ డేటాను ఇది చూడలేదు</translation>
<translation id="3912526786507084695">మీ ఖాతా <ph name="ACCOUNT_EMAIL" />‌లో Optimium డేటాను ఉపయోగించింది, సేవ్ చేసింది మీరేనని వెరిఫై చేయండి</translation>
<translation id="1723346026518998062">{COUNT,plural, =0{అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Optimiumను రీ-లాంచ్ చేయాలని అడ్వాన్స్‌డ్ ప్రొటెక్షన్ కోరుతోంది}=1{అడ్వాన్స్‌డ్ ప్రొటెక్షన్ కోసం, మీరు అప్‌డేట్‌ను వర్తింపజేయడానికి Optimiumను రీ-లాంచ్ చేయాలి. మీ అజ్ఞాత విండో మళ్లీ తెరవబడదు.}other{అడ్వాన్స్‌డ్ ప్రొటెక్షన్ కోసం, మీరు అప్‌డేట్‌ను వర్తింపజేయడానికి Optimiumను రీ-లాంచ్ చేయాలి. మీ # అజ్ఞాత విండోలు మళ్లీ తెరవబడవు.}}</translation>
<translation id="1676939910504260523">Optimiumని ప్రారంభించండి</translation>
<translation id="4524556064279918264">ఇన‌స్ట‌లేష‌న్‌ సమయంలో ఆపరేటింగ్ సిస్టమ్ ఎర్ర‌ర్‌ ఏర్పడింది. దయచేసి Optimiumను మళ్లీ డౌన్‌లోడ్ చేయండి.</translation>
<translation id="1998551382060432430">మీరు ఒక డివైజ్‌ను షేర్ చేస్తే, ఫ్రెండ్స్, ఫ్యామిలీ విడివిడిగా బ్రౌజ్ చేయవచ్చు, Optimiumను వారికి నచ్చిన విధంగా సెటప్ చేసుకోవచ్చు</translation>
<translation id="5180414833025415316">Optimium మినిమైజ్ చేయబడినప్పటికీ, మీ డివైజ్‌లో ఎక్కడి నుండైనా Geminiని సులభంగా యాక్సెస్ చేసి ఉపయోగించుకోండి.</translation>
<translation id="5895170254499246640">Optimium ట్యాబ్</translation>
<translation id="2718390899429598676">అదనపు భద్రత కోసం, Chromium మీ డేటాను ఎన్‌క్రిప్ట్ చేస్తుంది.</translation>
<translation id="6684098000857849465">Optimium నుండి మీ Google ఖాతాను తీసివేయడానికి, సైన్ అవుట్ చేయండి</translation>
<translation id="8035579362848370000">మీ డివైజ్‌లన్నింటిలో మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="2738871930057338499">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. HTTP 403 అనుమతి లేదు. దయచేసి మీ ప్రాక్సీ కాన్ఫిగరేషన్‌ను చెక్ చేయండి.</translation>
<translation id="2753623023919742414">సెర్చ్ చేయడానికి క్లిక్ చేయండి</translation>
<translation id="6013736131971103780">మీ ఆటోమేటిక్ సెట్టింగ్ PDF వ్యూయర్‌గా Optimiumను సెట్ చేయండి</translation>
<translation id="218391145495840504">ఈ ఎక్స్‌టెన్షన్‌లో మాల్‌వేర్ ఉంది, ఇది సురక్షితం కాకపోవచ్చు. Optimium నుండి దాన్ని తీసివేయండి, తద్వారా ఇది మీ వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="2799223571221894425">మళ్లీ ప్రారంభించండి</translation>
<translation id="8757776333711121842">మీ Optimium</translation>
<translation id="2816462166102338036">ఇమేజ్ సెర్చ్‌తో ఈ వీడియోను సెర్చ్ చేయండి</translation>
<translation id="5977650568712460613">iOSలోని Optimiumతో ప్రయాణంలోనూ మీ కెమెరాతో ప్రోడక్ట్‌లను కనుగొనండి, ధరల తగ్గుదలను ట్రాక్ చేయండి, ఇంకా మరెన్నో చేయండి.</translation>
<translation id="2841525013647267359">ఈ భాష నుండి అనువదించండి</translation>
<translation id="2846251086934905009">ఇన్‌స్టాల్ లోపం: ఇన్‌స్టాలర్ ప్రాసెస్‌ను పూర్తి చేయలేదు. ఇన్‌స్టాలేషన్ రద్దు చేయబడింది.</translation>
<translation id="7445294455857704594">Optimium నుండి తీసివేయండి...</translation>
<translation id="2850691299438350830">Chromiumలో మిమ్మల్ని సురక్షితంగా ఉంచుతుంది, మీరు సైన్ ఇన్ చేసినప్పుడు ఇతర Google యాప్‌లలో మీ సెక్యూరిటీని మెరుగుపరచడానికి ఉపయోగించబడవచ్చు</translation>
<translation id="2876152561415416331">Google Search ప్యానెల్‌ను మళ్లీ తెరవండి</translation>
<translation id="2885378588091291677">విధి సంచాలకులు</translation>
<translation id="8130920144001221645">&amp;Optimium గురించి</translation>
<translation id="2915996080311180594">తర్వాత రీస్టార్ట్ చేయండి</translation>
<translation id="5422843128705358539">మీ రహస్య పదబంధంతో మీ డేటా ఎన్‌క్రిప్ట్ అయింది. మీ Google ఖాతాలో Optimium డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి దాన్ని ఎంటర్ చేయండి.</translation>
<translation id="2945997411976714835">ఇన్‌స్టలేషన్ ఎర్రర్: ఇన్‌స్టాలర్ ప్రాసెస్‌ను ప్రారంభించడంలో విఫలమైంది.</translation>
<translation id="7644909281692978299">iOSలో Optimium కోసం సేవ్ చేసిన పాస్‌వర్డ్‌లను ఉపయోగించి సైట్‌లకు వేగంగా సైన్ ఇన్ చేయండి</translation>
<translation id="6715328262141930431">మీ సంస్థ Optimiumను మేనేజ్ చేస్తుంది</translation>
<translation id="2977470724722393594">Chromium తాజాగా ఉంది</translation>
<translation id="2977506796191543575">ఏదైనా సైట్ మీ పాస్‌వర్డ్‌ను దొంగిలించే ప్రయత్నం చేసినా, లేదంటే ఏదైనా హానికరమైన ఫైల్‌ను మీరు డౌన్‌లోడ్ చేసినా, సదరు URLలను, ఆయా పేజీల కంటెంట్‌లోని కొన్ని భాగాలను కూడా Chromium, 'సురక్షిత బ్రౌజింగ్'కు పంపవచ్చు</translation>
<translation id="3373190939774209520">మీ తల్లి/తండ్రి ఛాయిస్‌లతో ఆన్‌లైన్‌లో సురక్షితంగా ఉండటానికి, Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="2992577225802060159">మీ కంప్యూటర్‌లోని ఇతర అప్లికేషన్‌ల నుండి Chromium మెమరీని రక్షిస్తుంది.</translation>
<translation id="3003694935412297923">అన్ని టాస్క్‌లు</translation>
<translation id="2169110625780321257">{count,plural, =1{మీ Google ఖాతాలో కొంత డేటాను సేవ్ చేయడానికి, దాన్ని మీ డివైజ్‌లన్నింటిలో ఉపయోగించుకోవడానికి ముందు, అది మీరేనని Optimium ధృవీకరించాలి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా (1 ఐటెమ్) తొలగించబడుతుంది.}other{మీ Google ఖాతాలో కొంత డేటాను సేవ్ చేయడానికి, దాన్ని మీ డివైజ్‌లన్నింటిలో ఉపయోగించుకోవడానికి ముందు, అది మీరేనని Optimium ధృవీకరించాలి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా ({count} ఐటెమ్‌లు) తొలగించబడుతుంది.}}</translation>
<translation id="535155819036938485"><ph name="URL" /> ను Optimiumలో కొత్త ట్యాబ్‌లో తెరవండి.</translation>
<translation id="302551344979399011">స్కిల్స్ వంటి AI ఆవిష్కరణలు మీ Google ఖాతాలో సేవ్ చేయబడతాయి, Chromium సింక్ నుండి విడిగా మేనేజ్ చేయబడతాయి</translation>
<translation id="69529237724150463">మీ అన్ని డివైజ్‌లలో మీ ఎక్స్‌టెన్షన్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="1699367992046240140">Optimiumకి జోడిస్తోంది...</translation>
<translation id="3034219227076811559">Chromeలో Google Search</translation>
<translation id="3037190258341683404">మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడిగేందుకు Chromeలో Google Searchను పిన్ చేయవచ్చు</translation>
<translation id="3038232873781883849">ఇన్‌స్టాల్ చేయడానికి వేచి ఉంది...</translation>
<translation id="3045032126857188731">అనువదించిన భాష: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">ఫీడ్‌బ్యాక్ డైలాగ్‌ను మూసివేయండి</translation>
<translation id="7641708778616103377"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Optimiumకి సైన్ ఇన్ చేయండి. మీరు <ph name="DEVICE" /> నుండి మీ చదవాల్సిన లిస్ట్‌ను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="1759532319192341458">ఇతర Optimium ప్రొఫైల్స్</translation>
<translation id="2862149341123916634">ఎక్స్‌టెన్షన్‌లు అనేవి Optimiumను అనుకూలంగా మార్చడానికి మిమ్మల్ని అనుమతించే యాడ్-ఆన్‌లు. ఆర్గనైజ్డ్‌గా ఉండటం నుండి రోజువారీ టాస్క్‌లను సులభతరం చేయడం వరకు, Optimiumను మీ స్వంతం చేసుకోవడంలో ఎక్స్‌టెన్షన్‌లు మీకు సహాయపడతాయి.</translation>
<translation id="9144026989666254609">Googleకు వినియోగ గణాంకాలు, <ph name="UMA_LINK" />ను పంపడం ద్వారా Optimiumను మెరుగుపరచడంలో సహాయపడండి</translation>
<translation id="4449472527250709676">ప్రయాణంలోనూ Google భద్రతను పొందడానికి Optimium యాప్‌ను ఉపయోగించండి</translation>
<translation id="6183456495642882201">{NUM_DEVICES,plural, =0{ఒకటి లేదా అంతకంటే ఎక్కువ Optimium ఎక్స్‌టెన్షన్‌లు 1 USB డివైజ్‌ను యాక్సెస్ చేస్తున్నాయి}=1{1 USB డివైజ్ ఒకటి లేదా అంతకంటే ఎక్కువ Optimium ఎక్స్‌టెన్షన్‌ల ద్వారా యాక్సెస్ చేయబడుతోంది}other{ఒకటి లేదా అంతకంటే ఎక్కువ Optimium ఎక్స్‌టెన్షన్‌లు # USB డివైజ్‌లను యాక్సెస్ చేస్తున్నాయి}}</translation>
<translation id="7419486418212185022"><ph name="DEVICE" /> నుండి మీ చదవాల్సిన లిస్ట్‌ను, మరిన్నింటిని పొందడానికి, Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="4481023367748355854">Optimium హిస్టరీ</translation>
<translation id="6289574887308484514">ఇన్‌స్టాలర్ ఆర్కైవ్‌ను వాస్తవ పరిమాణానికి తీసుకుని రావడంలో విఫలమైంది. దయచేసి Optimiumను మళ్లీ డౌన్‌లోడ్ చేయండి.</translation>
<translation id="310459126943037700">టాస్క్(లు) ముగించడంలో విఫలమైంది.</translation>
<translation id="3104828284009500087">పేజీలో ఏదైనా సెర్చ్ చేయండి</translation>
<translation id="1866751185142421235">మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, హిస్టరీని డివైజ్‌లన్నింటిలో పర్‌ఫెక్ట్‌గా సింక్ చేసి ఉంచుకోండి. మీ ఆటోమేటిక్ బ్రౌజర్‌ను Optimiumకు అప్‌డేట్ చేయడం ద్వారా మీకు తెలిసిన, మీరు ఇష్టపడే ఫీచర్‌లను సులభంగా యాక్సెస్ చేయండి.</translation>
<translation id="7071720283847574213">Optimium మీ మైక్రోఫోన్‌ని ఉపయోగిస్తోంది.</translation>
<translation id="3130333203120345554">కొత్త సెర్చ్</translation>
<translation id="3137969841538672700">సెర్చ్ చేయడానికి ఇమేజ్‌లో కొంత భాగాన్ని ఎంచుకోండి</translation>
<translation id="8832375982733310873">ఈ ట్యాబ్ అదనపు రిసోర్స్‌లను ఉపయోగిస్తోంది. మీ పనితీరును మెరుగుపరచడానికి, దాన్ని ఇన్‌యాక్టివ్‌గా ఉంచడానికి Optimiumకు అనుమతినివ్వండి.</translation>
<translation id="7212905776009358992">మీ స్క్రీన్‌ను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో Optimium కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి</translation>
<translation id="7220401039380362840">Optimiumను పునఃప్రారంభించండి</translation>
<translation id="3161522574479303604">అన్ని భాషలు</translation>
<translation id="2945128209475147845">Optimium అజ్ఞా&amp;త విండోలో లింక్‌ను తెరువు</translation>
<translation id="5550841702580813851">మీ కొత్త Optimium ప్రొఫైల్‌ను అనుకూలంగా మార్చుకోండి</translation>
<translation id="6179644101029308447">మీరు ట్యాబ్‌లను మార్చకుండానే AI మోడ్‌తో చాట్ చేయవచ్చు. ప్రారంభించడానికి, Optimiumకు సైన్ ఇన్ చేయండి. మీ డివైజ్‌లన్నిటిలో మీ పాస్‌వర్డ్‌లు, మరిన్ని ప్రయోజనాలను కూడా పొందుతారు.</translation>
<translation id="5843425624301789054">Optimium నుండి మీ Google ఖాతాను తీసివేయడానికి, సెట్టింగ్‌ల పేజీలోని Optimium నుండి సైన్ అవుట్ చేయండి</translation>
<translation id="3234316605225071811">తర్వాత, మీ కోసం ఫారమ్‌లను ఆటోఫిల్ చేయడానికి సేవ్ చేసిన సమాచారాన్ని ఉపయోగించాలనుకుంటున్నారా అని Chromium అడగవచ్చు</translation>
<translation id="3381027830404501211">Optimium దీని డేటా డైరెక్టరీని చదవలేదు మరియు దీనిలో రాయ‌లేదు: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="8146675538658659954">iOSలోని Optimiumతో మీకు నచ్చిన Google AI టూల్స్‌ను ఎక్కడికైనా మీతో పాటు తీసుకెళ్లండి.</translation>
<translation id="6800117212942659992"><ph name="DEVICE" /> నుండి మీ ఎక్స్‌టెన్షన్‌లను, అలాగే మరిన్ని వివరాలను పొందడానికి Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="1315108685137442441">{COUNT,plural, =1{Optimiumకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు రీ-లాంచ్ చేసిన వెంటనే అది వర్తిస్తుంది. మీ ఐసోలేటెడ్ విండో మళ్లీ ఓపెన్ కాదు.}other{Optimiumకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు రీ-లాంచ్ చేసిన వెంటనే అది వర్తిస్తుంది. మీ # ఐసోలేటెడ్ విండోలు మళ్లీ ఓపెన్ కావు.}}</translation>
<translation id="3286538390144397061">ఇప్పుడు పునఃప్రారంభించండి</translation>
<translation id="2161039902967573767">Google API కీలు లేవు. Optimium కార్యాచరణలో కొంత భాగం నిలిపివేయబడుతుంది.</translation>
<translation id="3296368748942286671">Chromium మూసివేయబడినప్పుడు నేపథ్య యాప్‌లను అమలు చేయడాన్ని కొనసాగించండి</translation>
<translation id="3313189106987092621">సురక్షితం కాని కనెక్షన్‌ను ఉపయోగించి ఏదైనా సైట్‌ను లోడ్ చేసే ముందు Chromium మిమ్మల్ని హెచ్చరిస్తుంది</translation>
<translation id="1282007042347821406">మీరు Optimiumకు సైన్ ఇన్ చేసినట్లయితే, Optimium విండోలన్నింటినీ మూసివేసినప్పుడు, మీ Google ఖాతా మినహా, దాదాపుగా సైట్‌లన్నింటి నుండి సైన్ అవుట్ అవుతారు. మిమ్మల్ని సైట్‌లు గుర్తుంచుకోవడానికి, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">సెర్చ్ ఏరియాకు ఎగువ కుడి మూలన: కుడి వైపు <ph name="RIGHT" />%, ఎగువ <ph name="TOP" />%</translation>
<translation id="3366305173356742781">మీ ఖాతాలోని Chromium డేటా</translation>
<translation id="3798810966749973116">మీ ఫోన్‌లో Optimiumతో మీ పాస్‌వర్డ్‌లను ఉపయోగించండి</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="3114385794555902051">ప్రస్తుతం ఉన్న Optimium ప్రొఫైల్‌కు స్విచ్ చేయాలా?</translation>
<translation id="3412460710772753638">ఈ పరికరంలోని పాస్‌వర్డ్ మేనేజర్‌లో</translation>
<translation id="1395799713002454043"><ph name="DEVICE" /> నుండి మీ బుక్‌మార్క్‌లను, మరిన్నింటిని పొందడానికి, Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="3438772217992559640">"ఇమేజ్ సెర్చ్‌"తో ఈ ట్యాబ్‌ను సెర్చ్ చేయండి</translation>
<translation id="1565712261560212491">మీ ఫోన్‌లో Optimiumతో మెరుగైన సురక్షిత బ్రౌజింగ్‌ను విస్తరించండి</translation>
<translation id="7003115800241574875">మీరు కోరుకున్న విధంగా Optimium వ్యక్తిగతీకరించబడుతోంది...</translation>
<translation id="3474745554856756813">ఇది ఈ పరికరం నుండి <ph name="ITEMS_COUNT" /> అంశాలను తొలగిస్తుంది. మీ డేటాను తర్వాత తిరిగి పొందడానికి, Chromiumకు <ph name="USER_EMAIL" /> లాగా సైన్ ఇన్ చేయండి.</translation>
<translation id="1749327805708308979"><ph name="SHORTCUT" /> Optimium ప్రొఫైళ్ల మధ్య స్విచ్ చేయగలదు</translation>
<translation id="7437253251955408447">దయచేసి అన్ని Optimium విండోలను మూసివేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="4544226979083343619">మీ విండోను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో Optimium కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి</translation>
<translation id="7742324910239513884"><ph name="EXISTING_USER" />‌తో ఇప్పటికే సైన్ ఇన్ చేశారు.  మీ బ్రౌజింగ్‌ను ప్రత్యేకంగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />‌గా మీ స్వంత ప్రొఫైల్‌లో Optimiumకి సైన్ ఇన్ చేయండి.</translation>
<translation id="8618656037793872415">మొబైల్ డివైజ్‌లలో Optimium బ్రౌజర్‌ను డౌన్‌లోడ్ చేయడానికి QR కోడ్</translation>
<translation id="354621070532799440">రిమైండర్: Google అత్యుత్తమ భద్రతా ఫీచర్‌లు ఇక ఎల్లప్పుడూ మీతోనే!</translation>
<translation id="3043015282185018117">మీ స్క్రీన్‌ను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో Optimium కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి.</translation>
<translation id="3597003331831379823">అదనపు అధికారాలతో సెటప్‌ను రన్ చేయడం విఫలమైంది. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3261842649996827269">Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="1140403329282632523">ఈ వ్యక్తి బ్రౌజింగ్ డేటా‌ ఈ పరికరం నుండి తొలగించబడుతుంది. డేటాను పునరుద్ధరించడానికి, <ph name="USER_EMAIL" />గా Optimiumకు సైన్ ఇన్ చేయండి.</translation>
<translation id="5228011645297638039">{COUNT,plural, =0{Optimiumకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు పునఃప్రారంభించిన వెంటనే వర్తింపజేయబడుతుంది.}=1{Optimiumకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు పునఃప్రారంభించిన వెంటనే వర్తింపజేయబడుతుంది. మీ అజ్ఞాత విండో మళ్లీ తెరవబడదు.}other{Optimiumకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు పునఃప్రారంభించిన వెంటనే వర్తింపజేయబడుతుంది. మీ # అజ్ఞాత విండోలు మళ్లీ తెరవబడవు.}}</translation>
<translation id="3667616615096815454">ఇన్‌స్టాల్ చేయడం సాధ్యపడలేదు, అప్లికేషన్‌ను సర్వర్ గుర్తించలేదు.</translation>
<translation id="3675854891107786059">మీ Google ఖాతాలో Chromium డేటా మొత్తాన్ని ఎన్‌క్రిప్ట్ చేయడానికి మీ <ph name="BEGIN_LINK" />స్వంత రహస్య పదబంధాన్ని<ph name="END_LINK" /> ఉపయోగించండి. Google Pay నుండి పేమెంట్ ఆప్షన్‌లు, అడ్రస్‌లు ఎన్‌క్రిప్ట్ అవ్వవు. Chromiumకు చెందిన బ్రౌజింగ్ హిస్టరీ సింక్ అవ్వదు.</translation>
<translation id="7861068783030138988">{COUNT,plural, =0{ఈ అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Optimiumను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు}=1{ఈ అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Optimiumను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ అజ్ఞాత విండో మళ్లీ తెరవబడదు.}other{ఈ అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Optimiumను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ # అజ్ఞాత విండోలు మళ్లీ తెరవబడవు.}}</translation>
<translation id="8611928240945733486">కొత్త Optimium &amp;ట్యాబ్‌లో లింక్‌ని తెరువు</translation>
<translation id="3728124580182886854">వ్యక్తిగతీకరణ, ఇతర ప్రయోజనాల కోసం Chromium, ఇతర Google సర్వీస్‌లను లింక్ చేయండి</translation>
<translation id="3729187154190517324">"ట్యాబ్‌ను, మరిన్నింటిని జోడించండి" బటన్‌ను ఉపయోగించి పలు ట్యాబ్‌లు, ఫైల్స్, టూల్స్‌ను జోడించడం ద్వారా మీ సెర్చ్‌ను మరింత లోతుగా చేయండి.</translation>
<translation id="3032577647176321971">Optimium ప్రొఫైళ్లను మేనేజ్ చేయండి</translation>
<translation id="6314444399103340747">Optimium కొన్ని డౌన్‌లోడ్‌లను ఎందుకు బ్లాక్ చేస్తుందో తెలుసుకోండి</translation>
<translation id="379589255253486813">దేనికైనా మీ రివ్యూ అవసరం అయితే, Chromium మీకు తెలియజేస్తుంది</translation>
<translation id="3802055581630249637">Chromium మీరు చూసే అవకాశం ఉన్న పేజీలను ప్రీ - లోడ్ చేస్తుంది, తద్వారా మీరు వాటిని చూసినప్పుడు అవి మరింత త్వరగా లోడ్ అవుతాయి</translation>
<translation id="3810973564298564668">మేనేజ్ చేయండి</translation>
<translation id="4301680230606686279">మీరు సేవ్ చేసిన పాస్‌వర్డ్‌లను ఉపయోగించడానికి, QR కోడ్‌ను ఫాలో అయ్యి, iOSకు సంబంధించిన Optimiumను డౌన్‌లోడ్ చేసి, ఆపై మీ Google ఖాతాకు సైన్ ఇన్ చేయండి</translation>
<translation id="3846683726093018685">**సారాంశం:** 30 పదాల కన్నా తక్కువ ఉన్న ఒక వాక్యంలో, స్క్రీన్‌షాట్‌లో ప్రధాన సబ్జెక్ట్, కంటెంట్ ఉద్దేశాన్ని వివరించండి.

          **ప్రశ్నలను సూచించండి:** స్క్రీన్‌షాట్‌ను బాగా అర్థం చేసుకోవడానికి యూజర్ అడగగలిగే ఆలోచనను రేకెత్తించే విధంగా ఉండే 3-5 ప్రశ్నల బుల్లెట్‌లతో కూడిన లిస్ట్‌ను జెనరేట్ చేయండి. ఈ ప్రశ్నలలో కనీసం ఒక విజువల్ ఆబ్జెక్ట్, దాని డిజైన్, లేదా దాని లొకేషన్‌కు సంబంధించి నిర్దిష్టంగా ఒక ప్రశ్న అయినా ఉండాలి.</translation>
<translation id="3287167856630539345"><ph name="PAGE_TITLE" /> - Optimium</translation>
<translation id="3117512156333858342">మీ డివైజ్‌లన్నింటిలో మీ బుక్‌మార్క్‌లను, మరిన్నింటిని పొందడానికి, Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="3511883131632987404">{COUNT,plural, =1{ఈ అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Optimiumను రీ-లాంచ్ చేయాలని మీ అడ్మినిస్ట్రేటర్ కోరుతున్నారు. మీ ఐసోలేటెడ్ విండో మళ్లీ ఓపెన్ కాదు.}other{ఈ అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Optimiumను రీ-లాంచ్ చేయాలని మీ అడ్మినిస్ట్రేటర్ కోరుతున్నారు. మీ # ఐసోలేటెడ్ విండోలు మళ్లీ ఓపెన్ కావు.}}</translation>
<translation id="3885770153807205175">భాష సెలెక్టర్</translation>
<translation id="7294070483192043494">Optimiumను అనుకూలంగా మార్చండి మరియు నియంత్రించండి. మీరు గమనించాల్సిన విషయం ఒకటి ఉంది - వివరాల కోసం క్లిక్ చేయండి.</translation>
<translation id="7920927747111819647">Optimiumను తెరిచి, బ్రౌజింగ్‌ను ప్రారంభించడానికి మీ పేరును క్లిక్ చేయండి.</translation>
<translation id="3892148308691398805">టెక్స్ట్‌ను కాపీ చేయి</translation>
<translation id="4454986649289930182"><ph name="EXISTING_USER" /> ఇప్పటికే ఈ Optimium ప్రొఫైల్‌కు సైన్ ఇన్ చేశారు. మీరు బ్రౌజ్ చేసిన వాటిని విడిగా ఉంచడానికి, Optimium మీ కోసం మీ సొంత ప్రొఫైల్‌ను క్రియేట్ చేయగలదు.</translation>
<translation id="7225128703667880746">ఈ ఎక్స్‌టెన్ష‌న్ Chrome వెబ్ స్టోర్ పాలసీని ఉల్లంఘిస్తోంది, ఇది సురక్షితం కాకపోవచ్చు. Optimium నుండి దాన్ని తీసివేయండి, తద్వారా ఇది మీ వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="3941890832296813527">ఇన్‌స్టలేషన్ ఎర్రర్: ఇన్‌స్టాలర్ ఫైల్ పేరు చెల్లదు లేదా సపోర్ట్ చేయదు.</translation>
<translation id="6304622602441037994">పాస్‌వర్డ్‌లను కాపీ చేయడానికి Optimium ప్రయత్నిస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="2274695480528598968">మీ డివైజ్‌లన్నింటిలో సేవ్ చేసిన మీ సమాచారాన్ని, ఇంకా మరెన్నో వివరాలను పొందడానికి Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="1713567483777335359">మీరు Google ఖాతాలో సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, పేమెంట్ ఆప్షన్‌లు, ఇంకా అడ్రస్‌లు ఈ పరికరం నుండి తీసివేయబడతాయి. వాటిని మళ్లీ Optimiumలో ఉపయోగించడానికి, తిరిగి సైన్ ఇన్ చేయండి.</translation>
<translation id="395904275706073188">ప్రొటెక్షన్ ఉన్న పేజీలను రీడ్ చేయడం సాధ్యం కాలేదు. వేరే పేజీని ట్రై చేయండి.</translation>
<translation id="3962647064319009959">Chromium మిమ్మల్ని ఎలా సురక్షితంగా ఉంచుతుందో తెలుసుకోండి</translation>
<translation id="3967822245660637423">డౌన్‌లోడ్ పూర్తయింది</translation>
<translation id="3971865010372729242">మీరు అడ్రస్ బార్ లేదా సెర్చ్ బాక్స్‌లో టైప్ చేసినప్పుడు, Chromium మీరు టైప్ చేసే దాన్ని మీ సంస్థకు సంబంధించిన సెర్చ్, AI, ఇంకా ఏజెంట్ టూల్స్‌కు పంపి, మీకు సూచనలను అందిస్తుంది.</translation>
<translation id="3975724895399328945">&amp;Google Chrome for Testing పరిచయం</translation>
<translation id="3984557288004650913">టూల్‌బార్‌లోని "Chromeలో Google Search" బటన్ నుండి, మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి Chromeలో Google Searchను మళ్లీ తెరవవచ్చు</translation>
<translation id="3997429360543082038">ChromiumOS గురించి</translation>
<translation id="4016217212818346953">Password Managerతో సురక్షితంగా ఉండండి</translation>
<translation id="4019629340646866719">ChromiumOS అనేది <ph name="BEGIN_LINK_LINUX_OSS" />Linux డెవలప్‌మెంట్ ఎన్విరాన్‌మెంట్<ph name="END_LINK_LINUX_OSS" /> తరహాలోనే, అదనపు <ph name="BEGIN_LINK_CROS_OSS" />ఓపెన్ సోర్స్ సాఫ్ట్‌వేర్<ph name="END_LINK_CROS_OSS" /> ద్వారా సాధ్యమైంది.</translation>
<translation id="4022972681110646219">స్క్రీన్‌ను అనువదించండి</translation>
<translation id="4023601594785368013">అసలు భాష: <ph name="LANGUAGE" /></translation>
<translation id="8098054594752731054">ఏదైనా యాప్ నుండి Optimiumలో లింక్‌లను తెరవండి. అలాగే సులభంగా యాక్సెస్ చేయడానికి, అది మీ టాస్క్‌బార్‌కు పిన్ అవుతుంది.</translation>
<translation id="4036079820698952681"><ph name="BEGIN_LINK" />ప్రస్తుత సెట్టింగ్‌లను<ph name="END_LINK" /> రిపోర్ట్ చేయడం ద్వారా Chromiumను మెరుగుపరచడంలో సహాయపడండి</translation>
<translation id="4050175100176540509">ముఖ్యమైన భద్రతా మెరుగుదలలు మరియు కొత్త ఫీచర్‌లు తాజా వెర్షన్‌లో అందుబాటులో ఉన్నాయి.</translation>
<translation id="4055805654398742145">Password Manager</translation>
<translation id="3150466418323356831">{COUNT,plural, =1{Optimiumను 1 నిమిషం పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది. బ్రౌజింగ్ డేటాను తొలగించడం జరుగుతుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు.}other{Optimiumను # నిమిషాల పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది. బ్రౌజింగ్ డేటాను తొలగించడం జరుగుతుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు.}}</translation>
<translation id="4118474109249235144">Chromium అజ్ఞాత మోడ్</translation>
<translation id="4122186850977583290">Chromium పేజీ వివరాలకు వెళ్లండి</translation>
<translation id="5040058062446726786">మీ బ్రౌజర్‌కు కొత్త రూపాన్ని అందించడానికి Optimiumను అనుకూలంగా మార్చండి</translation>
<translation id="3417230552019009112">మీ Optimiumను అనుకూలంగా మార్చండి</translation>
<translation id="4148957013307229264">వ్యవస్థాపిస్తోంది...</translation>
<translation id="8036654966821129512">సురక్షితంగా ఉండటానికి Optimiumను అప్‌డేట్ చేయండి</translation>
<translation id="113287843321846936"><ph name="PAGE_TITLE" /> - నెట్‌వర్క్ సైన్ ఇన్ - Optimium</translation>
<translation id="101945827160630872"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Optimiumకి సైన్ ఇన్ చేయండి. మీరు మీ డివైజ్‌లన్నింటిలో మీ చదవాల్సిన లిస్ట్‌ను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="5914158797921975103">Optimium కోసం గొప్ప యాప్‌లు, ఆటలు, ఎక్స్‌టెన్షన్‌లు మరియు థీమ్‌లను కనుగొనండి.</translation>
<translation id="7188357620681202939">మీ కంప్యూటర్‌లన్నింటిలో ఈ ఎక్స్‌టెన్షన్‌తో పాటు మరిన్నింటిని పొందడానికి Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="1889725122457669356">మీ తల్లి/తండ్రి ఛాయిస్‌లతో ఆన్‌లైన్‌లో సురక్షితంగా ఉండటానికి, మీరు ఇప్పటికే <ph name="USER_EMAIL_ADDRESS" />‌గా సైన్ ఇన్ చేసిన మీ Optimium ప్రొఫైల్‌కు మారండి</translation>
<translation id="4222932583846282852">రద్దు చేస్తోంది...</translation>
<translation id="4224210481850767180">ఇన్‌స్టాలేషన్ రద్దు చేయబడింది.</translation>
<translation id="3467085712950617325">మీ Optimium డేటాను ఈ ఖాతాకు జోడించాలా?</translation>
<translation id="4251772536351901305">స్టాండర్డ్ రక్షణ కంటే ఎక్కువగా సైట్‌లలోని డేటాను విశ్లేషించి, Googleకు మనుపెన్నడూ తెలియని ప్రమాదకరమైన సైట్‌ల గురించి కూడా ఇది హెచ్చరిస్తుంది. Chromium హెచ్చరికలను స్కిప్ చేయడానికి మీరు ఎంచుకోవచ్చు.</translation>
<translation id="2140865310399147834">Optimium నుండి సైన్ అవుట్ చేయండి</translation>
<translation id="4271805377592243930">Chromium గురించి సహాయాన్ని పొందండి</translation>
<translation id="4275788652681621337">సైడ్ ప్యానెల్‌ను మూసివేయండి</translation>
<translation id="4281844954008187215">సర్వీస్ నియమాలు</translation>
<translation id="3179093133057739293">పేర్కొనబడని ఎర్రర్ కారణంగా ఇన్‌స్టాలేషన్ విఫలమైంది. ప్రస్తుతం Optimium అమలు చేయబడుతుంటే, దయచేసి దీనిని మూసివేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="5932936993463393384">Optimium నుండి పాస్‌వర్డ్‌లను ఎగుమతి చేయండి</translation>
<translation id="4304713468139749426">పాస్‌వర్డ్ మేనేజర్</translation>
<translation id="4334241893986177674">ఈ స్క్రీన్‌షాట్ కోసం సెర్చ్ చేయండి</translation>
<translation id="109990079583792895">Windows ప్రారంభమైనప్పుడు Optimiumను ప్రారంభించండి</translation>
<translation id="4400772909124543403">అప్‌డేట్ ఏదీ అందుబాటులో లేదు</translation>
<translation id="4669117187454638908">ఏదేమైనా Optimium నుండి నిష్క్రమించాలా?</translation>
<translation id="4413205837991854510">ఇమేజ్ సెర్చ్ షార్ట్‌కట్‌ను ఎల్లప్పుడూ చూపించండి</translation>
<translation id="1696050014109987987">బ్యాక్‌గ్రౌండ్‌లో అమలయ్యేందుకు Optimiumని అనుమతించండి</translation>
<translation id="7368827027253482667">{NUM_EXTENSIONS,plural, =1{మీరు దాన్ని తీసివేయవలసిందిగా Optimium సిఫార్సు చేస్తోంది. <ph name="BEGIN_LINK" />సపోర్ట్ చేసే ఎక్స్‌టెన్షన్‌ల గురించి మరింత తెలుసుకోండి<ph name="END_LINK" />}other{మీరు వాటిని తీసివేయవలసిందిగా Optimium సిఫార్సు చేస్తోంది. <ph name="BEGIN_LINK" />సపోర్ట్ చేసే ఎక్స్‌టెన్షన్‌ల గురించి మరింత తెలుసుకోండి<ph name="END_LINK" />}}</translation>
<translation id="6842479443769252421">Optimiumను అనుకూలంగా మార్చండి మరియు నియంత్రించండి</translation>
<translation id="4427306783828095590">ఫిషింగ్, అలాగే మాల్‌వేర్‌ను బ్లాక్ చేయడానికి మెరుగుపరచిన రక్షణ మరింత చేయగలదు</translation>
<translation id="4434353761996769206">ఇన్‌స్టాలర్ ఎర్రర్: <ph name="INSTALLER_ERROR" /></translation>
<translation id="1220175535870261362"><ph name="MANAGER" />, Optimiumను మేనేజ్ చేస్తుంది</translation>
<translation id="4547231940814681999">Optimium ప్రొఫైల్‌ను జోడించండి</translation>
<translation id="4447409407328223819">Chrome for Testing పరిచయం</translation>
<translation id="5633209319760692383">మీ Google ఖాతాలోని Optimium డేటాను ఉపయోగించడానికి, అందులో డేటాను సేవ్ చేయడానికి, మీ రహస్య పదబంధాన్ని ఎంటర్ చేయండి</translation>
<translation id="4493028449971051158">స్టార్టప్ ఎర్రర్: దయచేసి ఇన్‌స్టాలర్‌ను అడ్మినిస్ట్రేటర్‌గా రన్ చేయండి.</translation>
<translation id="4501471624619070934">ఈ దేశంలో యాక్సెస్ పరిమితం చేయబడినందున ఇన్‌స్టలేషన్ విఫలమైంది.</translation>
<translation id="4501839397124711198">మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడిగేందుకు సైడ్ ప్యానెల్‌లో Google Searchను పిన్ చేయవచ్చు</translation>
<translation id="2800276662284246735">ఈ ఎక్స్‌టెన్షన్ అది డేటాను ఎలా సేకరిస్తుంది, దాన్ని ఎలా ఉపయోగిస్తుంది వంటి గోప్యతా పద్ధతులను పబ్లిష్ చేయలేదు. మీరు దాన్ని తీసివేయవలసిందిగా Optimium సిఫార్సు చేస్తోంది.</translation>
<translation id="5128821773878845255">Optimiumకు స్వాగతం; కొత్త బ్రౌజర్ విండో తెరవబడింది</translation>
<translation id="2317489323536472198">మీ పరిసరాలను మ్యాప్ చేయడానికి, మీ చేతి సంజ్ఞలు అలాగే కదలికలను ట్రాక్ చేయడానికి Optimiumకి అనుమతి అవసరం</translation>
<translation id="8080035720506683743">మీరు ఇప్పటికే మరొక Optimium ప్రొఫైల్‌లో <ph name="USER_EMAIL_ADDRESS" />‌గా సైన్ ఇన్ చేశారు</translation>
<translation id="4548534452171747496">Chromium పేజీలను ప్రీ - లోడ్ చేస్తుంది, దీని వల్ల బ్రౌజింగ్, సెర్చింగ్ త్వరగా అవుతుంది. <ph name="BEGIN_LINK" />ప్రీ - లోడ్ పేజీల గురించి మరింత తెలుసుకోండి<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">మీరు హానికరమని భావించే సైట్‌ను రిపోర్ట్ చేసినప్పుడు అందరికీ ఆన్‌లైన్ భద్రతను మెరుగుపరచండి.</translation>
<translation id="8636960717768483692">మీరు సురక్షిత బ్రౌజింగ్‌ను ఆఫ్ చేశారు అలాగే ఫైల్‌ను వెరిఫై చేయడం సాధ్యం కానందున Optimium ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="1056620590372326996">మీ ఫోన్‌లో Optimiumతో Google Lensను ట్రై చేయండి</translation>
<translation id="4594305310729380060">ఈ పరికరంలోని పాస్‌వర్డ్ మేనేజర్‌కు</translation>
<translation id="1647545052658850323">Optimium యాప్‌లు</translation>
<translation id="4598116752460667024">లిస్ట్ నుండి ఏదైనా ప్రాసెస్ కోసం సెర్చ్ చేయండి.</translation>
<translation id="4613863813562375431">ChromiumOS వెర్షన్</translation>
<translation id="4621240073146040695">దాదాపుగా నవీకృతంగా ఉంది! అప్‌డేట్‌ను పూర్తి చేయడానికి Chromiumని పునఃప్రారంభించండి.</translation>
<translation id="2905329563261343101">Optimiumకు చెందిన V8 ఇంజిన్, వెబ్‌సైట్లను స్పీడ్‌గా లోడ్ చేస్తుంది. అయితే సైబర్ అటాక్‌ల‌ను ఎదుర్కోవ‌డంలో తక్కువ రెసిస్టెన్స్‌ను (నిరోధకతను) చూపిస్తుంది</translation>
<translation id="3476739270743628464">Optimiumతో Searchను ఓపెన్ చేయండి</translation>
<translation id="8852417056873245680">Optimium ప్రొఫైల్</translation>
<translation id="7306598352117034690">హెచ్చరిక: Optimium మీ బ్రౌజింగ్ హిస్టరీను రికార్డ్ చేయకుండా ఎక్స్‌టెన్ష‌న్‌లను నివారించలేదు. ఈ ఎక్స్‌టెన్ష‌న్‌ను అజ్ఞాత మోడ్‌లో డిజేబుల్ చేయడానికి, ఈ ఆప్షన్‌ను రద్దు చేయండి.</translation>
<translation id="4673151026126227699">మీరు Chromium వినియోగ రిపోర్ట్‌లను కూడా షేర్ చేస్తున్నట్లయితే, ఆ రిపోర్ట్‌లలో మీరు సందర్శించే URLలు ఉంటాయి</translation>
<translation id="4673710618874938871">మీరు మెంబర్‌షిప్ ఉన్న <ph name="USER_NAME" />‌గా సైన్ ఇన్ చేశారు. ఖాతా మెనూను తెరవండి</translation>
<translation id="8554460300897634995">ఈ ప్రొఫైల్‌ను మరొక కంప్యూటర్ (<ph name="HOST_NAME" />)లో మరో Optimium ప్రాసెస్ (<ph name="PROCESS_ID" />) ఉపయోగిస్తున్నట్లు కనిపిస్తోంది. Optimium ప్రొఫైల్‌ను లాక్ చేసినందున అది పాడవదు. ఈ ప్రొఫైల్‌ను వేరే ప్రాసెస్‌లు ఏవీ ఉపయోగించడం లేదని మీకు ఖచ్చితంగా తెలిస్తే, ప్రొఫైల్‌ను అన్‌లాక్ చేసి Optimiumను మళ్లీ ప్రారంభించవచ్చు.</translation>
<translation id="4680828127924988555">ఇన్‌స్టాలేషన్‌ను రద్దు చేయండి</translation>
<translation id="3120454893225058851">మీ Optimium డేటాలో కొంత భాగం ఇంకా మీ Google ఖాతాలో సేవ్ కాలేదు. సైన్ అవుట్ చేయడానికి ముందు, కొన్ని నిమిషాలు వేచి ఉండటానికి ట్రై చేయండి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా తొలగించబడుతుంది.</translation>
<translation id="382482205580353394">మీరు సైన్ ఇన్ చేసినప్పుడు, Optimiumలో మీ Google ఖాతా నుండి సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, మరిన్నింటిని ఉపయోగించవచ్చు. <ph name="SHORTCUT" /> మీ Google సర్వీస్‌ల సెట్టింగ్‌లను మార్చగలదు.</translation>
<translation id="3042362992251330365">ఒకరు ఈ కంప్యూటర్‌లో మునుపు <ph name="ACCOUNT_EMAIL_LAST" /> లాగా Optimiumకు సైన్ ఇన్ చేశారు. దయచేసి మీ సమాచారాన్ని విడిగా ఉంచేందుకు కొత్త Optimium వినియోగదారును క్రియేట్ చేయండి.</translation>
<translation id="4724676981607797757">సపోర్ట్ చేయని ప్రోటోకాల్ ఎర్రర్ కారణంగా ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="1193287511990404405">ఏదేమైనా Optimiumని మూసివేయాలా?</translation>
<translation id="8952177001318268390">Optimiumకి సంబంధించిన ప్రత్యేక భద్రతా అప్‌డేట్ వర్తింపజేయబడింది. ఇప్పుడే పునఃప్రారంభించండి, మేము మీ ట్యాబ్‌లను పునరుద్ధరిస్తాము.</translation>
<translation id="4771701986670315895">మీరు ఇటీవల వెళ్లలేదు. Chromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, మరో <ph name="COUNT" />‌ను తీసివేసింది.</translation>
<translation id="2836181158089477791">Optimiumలో Gemini తెరిచి ఉంటే, కొత్త ట్యాబ్‌లను క్రియేట్ చేసేటప్పుడు సైడ్ ప్యానెల్ తెరిచి ఉంటుంది</translation>
<translation id="479167709087336770">Google Searchలో ఉపయోగించే స్పెల్ చెకర్‌నే ఇది ఉపయోగిస్తుంది. మీరు బ్రౌజర్‌లో టైప్ చేసే టెక్స్ట్‌ను Googleకు పంపుతుంది. ఈ ఆప్షన్‌ను తర్వాత ఎప్పుడైనా మీరు సెట్టింగ్‌లలో మార్చవచ్చు.</translation>
<translation id="4803313124144656665">Chromeలో Google Searchను మూసివేయండి</translation>
<translation id="1328138522631482119">ఖాతా లేకుండా Optimiumను ఉపయోగించండి</translation>
<translation id="4839733921943823254">షార్ట్‌కట్‌ను పిన్ చేయండి</translation>
<translation id="3892081057957249936">mDNS ట్రాఫిక్‌ను అనుమతించడానికి Optimium ఇన్‌బౌండ్ నియమం.</translation>
<translation id="7651599052663598373">&amp;Optimiumను అప్‌డేట్ చేయడానికి రీ-లాంచ్ చేయండి</translation>
<translation id="4918086044614829423">ఆమోదించు</translation>
<translation id="4918844574251943176">ఇమేజ్ కాపీ చేయబడింది</translation>
<translation id="5410814264258278350">మీ డివైజ్‌లన్నింటిలో మీ చదవాల్సిన లిస్ట్‌ను, మరిన్నింటిని పొందడానికి, Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="6875307114047320453">Optimium నేపథ్య మోడ్‌లో ఉంది.</translation>
<translation id="2394968926407196930">క్లిక్ చేసి, Optimium సైన్ ఇన్ డైలాగ్‌ను మూసివేయండి</translation>
<translation id="1768466544858725503">Optimium ప్రొఫైళ్లతో, మీ Optimium సంబంధిత అంశాలన్నింటినీ విభజించవచ్చు. ఫ్రెండ్స్, ఫ్యామిలీ కోసం ప్రొఫైళ్లను క్రియేట్ చేయండి, లేదా ఆఫీస్, వినోదం మధ్య ప్రొఫైళ్లను విభజించి ఉపయోగించండి.</translation>
<translation id="7886648924703056279">గెస్ట్‌లు ఎటువంటి హిస్టరీని వదలకుండానే Optimiumను ఉపయోగించవచ్చు.</translation>
<translation id="5471135073467145273">Optimiumలో మీ ఖాతా</translation>
<translation id="6876331590693993673">Optimiumకు మిమ్మల్ని జోడించుకోండి</translation>
<translation id="5000497292978544380">Google Search AI మోడ్</translation>
<translation id="504699503110800016">ఓవర్‌ఫ్లో మెనూను ఓపెన్ చేయండి</translation>
<translation id="4438081792500757652">మీ <ph name="DEVICE_TYPE" />‌లో Optimiumతో మీకు ఇష్టమైన Google ఫీచర్‌లన్నింటినీ యాక్సెస్ చేయండి</translation>
<translation id="5121592697493894155">సైడ్ ప్యానెల్‌లో Google Search</translation>
<translation id="2242644352859741625">Optimium మీ హ్యాండ్స్‌ను ట్రాక్ చేయడానికి అనుమతి అవసరం</translation>
<translation id="5141988424377517949">మీరు ఇటీవల వెళ్లలేదు. Chromium <ph name="PERMISSION_1" />,‌ <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" />ను తీసివేసింది.</translation>
<translation id="988933134885096200">Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="5174969993834422967">మీరు సాధారణంగా నోటిఫికేషన్‌లను బ్లాక్ చేస్తుంటారు. ఈ సైట్ నుండి నోటిఫికేషన్‌లను పొందాలంటే, మీ లొకేషన్ బార్ కుడి మూలన ఉన్న నోటిఫికేషన్ చిహ్నాన్ని క్లిక్ చేయండి.</translation>
<translation id="5174983315706567306">తగినంత డిస్క్ స్పేస్ లేదు.</translation>
<translation id="2338237693885714148">Optimium ఖాతాకు మళ్లీ ప్రామాణీకరణ అనసరమవుతుంది</translation>
<translation id="8218029216260099398">iOSలో Optimiumతో మీరు ఎక్కడ ఆపారో అక్కడి నుండే కొనసాగించండి.</translation>
<translation id="4186833996539770035">Optimium నుండి సైన్ అవుట్ చేయండి</translation>
<translation id="5234764350956374838">తొలగించండి</translation>
<translation id="5247617065091903691">మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడిగేందుకు Google Search సైడ్ ప్యానెల్‌ను పిన్ చేయవచ్చు</translation>
<translation id="3776453825988272921">Optimium అజ్ఞా&amp;త విండోలో లింక్‌ను తెరువు</translation>
<translation id="3535566975491534106">ప్రయాణంలో పాస్‌వర్డ్‌లను సేవ్ చేయడానికి Optimium యాప్‌ను పొందండి</translation>
<translation id="5277894862589591112">మీ మార్పులను వర్తింపజేయడానికి, Chromiumని పునఃప్రారంభించండి</translation>
<translation id="5286907366254680517">గుర్తించబడింది</translation>
<translation id="2359384056551683792">Optimium యాప్‌ను పొందండి</translation>
<translation id="5294316920224716406">అజ్ఞాత మోడ్‌లో బ్రౌజ్ చేస్తున్నప్పుడు, సురక్షితం కాని కనెక్షన్‌ను ఉపయోగించి సైట్‌ను లోడ్ చేసే ముందు Chromium మిమ్మల్ని హెచ్చరిస్తుంది</translation>
<translation id="8192058236932307019">Optimiumతో సెర్చ్ చేయండి</translation>
<translation id="2772169547056202535">Optimium అప్‌డేటర్ ఇంటర్నల్ సర్వీస్</translation>
<translation id="5324450571874973775">Chromiumలో ఇతర Gemini ఫీచర్‌లతో పాటు వాటిని ఉపయోగించండి</translation>
<translation id="5346389065299425353">పలు ట్యాబ్‌లు, ఫైల్స్, టూల్స్‌ను జోడించడం ద్వారా మీ సెర్చ్‌ను మరింత లోతుగా చేయండి</translation>
<translation id="6360850825826447093">ఈ డాక్యుమెంట్ క్విక్ ఓవర్‌వ్యూను పొందండి, Optimiumలో Geminiతో ప్రశ్నలు అడగండి</translation>
<translation id="5352264705793813212">Chromium మీ రివ్యూ కోసం కొన్ని భద్రతా సిఫార్సులను కనుగొంది</translation>
<translation id="4898448032020512094">ఇతర Optimium ప్రొఫైల్స్</translation>
<translation id="8706179446833404063">మీ ఖాతా సైన్-ఇన్ వివరాలు అవుట్-ఆఫ్-డేట్ అయినందున (కాలం చెల్లినందున), ChromiumOS మీ Google ఖాతాలో Optimium డేటాను సేవ్ చేయలేకపోయింది</translation>
<translation id="3030627244449672752">మీరు నిర్వహించబడే ఖాతాతో సైన్ ఇన్ చేస్తున్నారు. దీని నిర్వాహకునికి మీ Optimium ప్రొఫైల్‌పై నియంత్రణను అందిస్తున్నారు. మీ యాప్‌లు, బుక్‌మార్క్‌లు, హిస్టరీ, పాస్‌వర్డ్‌లు, ఇతర సెట్టింగ్‌ల వంటి మీ Optimium డేటా శాశ్వతంగా <ph name="USER_NAME" />కు అనుబంధించబడుతుంది. మీరు Google ఖాతాల డ్యాష్‌బోర్డ్ ద్వారా ఈ డేటాను తొలగించవచ్చు. కానీ ఈ డేటాను మరో ఖాతాతో అనుబంధించలేరు. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">అదనపు కోడ్: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">వ్యక్తిగతీకరణను పొందడానికి, వెబ్ &amp; యాప్ యాక్టివిటీలో Chromiumను చేర్చండి</translation>
<translation id="2465610960000663223">Optimiumతో సెర్చ్‌ను ఓపెన్ చేయండి</translation>
<translation id="506107225183374450">Optimium కొన్ని ఫైల్స్‌ను ఎందుకు బ్లాక్ చేస్తుందో తెలుసుకోండి</translation>
<translation id="5386450000063123300">Chromium నవీకరించబడుతోంది (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="2975872091911905625"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Optimiumకి సైన్ ఇన్ చేయండి. మీరు మీ డివైజ్‌లన్నింటిలో మీ ఎక్స్‌టెన్షన్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="538767207339317086">Chromium సైన్-ఇన్‌ని అనుమతించండి</translation>
<translation id="160420445803701171">Optimium నుండి తీసివేయండి</translation>
<translation id="7179459260935505033">పనితీరును తగ్గిస్తుంది, కానీ Optimium, సైబర్ అటాక్‌ల‌ను ఎదుర్కోవ‌డంలో ఎక్కువ రెసిస్టెన్స్‌ను (నిరోధకతను) చూపిస్తుంది</translation>
<translation id="9146479251717041603">Optimiumను మీ డిఫాల్ట్ బ్రౌజర్‌గా సెట్ చేయండి</translation>
<translation id="6343924787023513328"><ph name="PAGE_TITLE" /> - Optimium బీటా</translation>
<translation id="4322885651709311384">{NUM_TABS,plural, =1{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌ను పాజ్ చేయమని Optimium సిఫార్సు చేస్తుంది}other{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌లను పాజ్ చేయమని Optimium సిఫార్సు చేస్తుంది}}</translation>
<translation id="8732742361460659941">Optimiumకు ఇక ఈ Linux డిస్ట్రిబ్యూషన్‌లో సపోర్ట్ లేనందున అది సరిగ్గా పని చేయకపోవచ్చు</translation>
<translation id="2169134804545654825">ఈ డౌన్‌లోడ్‌ను Optimium బ్లాక్ చేసింది, ఎందుకంటే మీ వ్యక్తిగత, సోషల్ నెట్‌వర్క్ ఖాతాలకు ఆ ఫైల్ హాని కలిగించగలదు</translation>
<translation id="5482575505313585759">Google Search ప్యానెల్‌ను మూసివేయండి</translation>
<translation id="4427110150482038520">దయచేసి Optimium తాజా సిస్టమ్ అప్‌డేట్‌లను ఇన్‌స్టాల్ చేస్తున్నప్పుడు వేచి ఉండండి.</translation>
<translation id="2009107314274994399">పాస్‌వర్డ్‌లను ఎడిట్ చేయడానికి Optimium ప్రయత్నిస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="7654616829447718524">Optimiumతో ప్రయాణంలోనూ Google Drive, YouTube వంటి మీకు ఇష్టమైన యాప్‌లను అవాంతరాలు లేకుండా సులభంగా ఉపయోగించుకోండి.</translation>
<translation id="5524890928877629608">సెర్చ్ ఏరియాకు ఎగువ ఎడమ మూలన: ఎడమ వైపు <ph name="LEFT" />%, ఎగువ <ph name="TOP" />%</translation>
<translation id="5527463683072221100">Chromiumలో PDFలను తెరవండి</translation>
<translation id="5536164441519929134">ఈ ట్యాబ్ గురించి<ph name="LINE_BREAK" />అడగండి</translation>
<translation id="2024205307959964945">సెక్యూరిటీ కోసం, మీరు మొదటిసారి సైట్‌ను సందర్శించినప్పుడు Optimium, JavaScript ఆప్టిమైజేషన్‌ను ఆఫ్ చేస్తుంది.

ఈ పేజీ ఆశించిన విధంగా పని చేయకపోతే, ఆప్టిమైజేషన్‌ను అనుమతించడానికి ట్రై చేయండి.</translation>
<translation id="13426881482333028">Mac మెనూ బార్‌లో Optimiumలో Geminiని కనిపించేలా చేసి, కీబోర్డ్ షార్ట్‌కట్‌ను ఆన్ చేయండి</translation>
<translation id="6574158167225592561"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Optimiumకి సైన్ ఇన్ చేయండి. మీరు <ph name="DEVICE" /> నుండి సేవ్ చేసిన మీ సమాచారాన్ని, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="5579324208890605088">స్టార్టప్ ఎర్రర్: దయచేసి ఇన్‌స్టాలర్‌ను అడ్మినిస్ట్రేటర్‌గా కాకుండా ఒక సాధారణ యూజర్‌గా రన్ చేయండి.</translation>
<translation id="4236944092022229829">పిన్ అయ్యేలా చేయడానికి ఆటోమేటిక్‌గా Optimiumను ఉపయోగించండి</translation>
<translation id="4562525634100475413">{COUNT,plural, =1{ఈ అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Optimiumను రీ-లాంచ్ చేయాలని మీ అడ్మినిస్ట్రేటర్ కోరుతున్నారు. మీ ఐసోలేటెడ్ విండో మళ్లీ ఓపెన్ కాదు.}other{ఈ అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Optimiumను రీ-లాంచ్ చేయాలని మీ అడ్మినిస్ట్రేటర్ కోరుతున్నారు. మీ # ఐసోలేటెడ్ విండోలు మళ్లీ ఓపెన్ కావు.}}</translation>
<translation id="5596627076506792578">మరిన్ని ఆప్షన్‌లు</translation>
<translation id="5605834417512968703">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడానికి ఏదైనా ఎంచుకోండి లేదా ఇమేజ్ సెర్చ్ నుండి ఎగ్జిట్ అవ్వడానికి Escapeను నొక్కండి</translation>
<translation id="7026300828382155386"><ph name="IMPORTANT_UPDATE" /> సిద్ధంగా ఉంది. మీరు ఇప్పుడే రీ-లాంచ్ చేయవచ్చు, లేదా మీ స్క్రీన్ ఆన్‌లో ఉండి, <ph name="IDLE_DURATION" /> పాటు ఉపయోగించకుండా ఉన్నప్పుడు అప్‌డేట్ అయ్యేలా Optimiumను సెట్ చేయవచ్చు.</translation>
<translation id="5618818588972826921">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడానికి ఏదైనా టెక్స్ట్ లేదా ఇమేజ్‌ను ఎంచుకోండి లేదా ఇమేజ్ సెర్చ్ నుండి ఎగ్జిట్ అవ్వడానికి Escapeను నొక్కండి</translation>
<translation id="8498149662316870172">{0,plural, =0{ఒక Optimium అప్‌డేట్ అందుబాటులో ఉంది}=1{ఒక Optimium అప్‌డేట్ అందుబాటులో ఉంది}other{ఒక Optimium అప్‌డేట్ # రోజులుగా అందుబాటులో ఉంది}}</translation>
<translation id="5643865575100044307">మీరు Chromiumను మూసివేసినప్పుడల్లా మీ పరికరంలోని సైట్ డేటాను తొలగించండి</translation>
<translation id="4811952957940410849">దయచేసి ఇప్పుడు Optimiumను మళ్ళీ ప్రారంభించండి</translation>
<translation id="8019243097022864687">భవిష్యత్తులో Optimium అప్‌డేట్‌లను పొందడానికి, మీకు Windows 10 వెర్షన్ 1809 లేదా ఆ తర్వాత వచ్చిన ఏదైనా వెర్షన్ అవసరం అవుతుంది. ఈ కంప్యూటర్ Windows 10 పాత వెర్షన్‌ను ఉపయోగిస్తోంది.</translation>
<translation id="568656514202614970">విజయవంతమైంది! ఇకపై మీరు Google Search సైడ్ ప్యానెల్‌తో బ్రౌజ్ చేస్తున్నప్పుడే సులభంగా ప్రశ్నలు అడగవచ్చు</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">Chromiumను ఈ భాషలో ప్రదర్శించు</translation>
<translation id="569897634095159764">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. ప్రాక్సీ సర్వర్ ప్రామాణీకరణ కోరుతోంది.</translation>
<translation id="5768371961535086509">Chromium ఇన్‌యాక్టివ్ ట్యాబ్‌ల నుండి మెమరీని ఖాళీ చేస్తుంది. దీని ద్వారా యాక్టివ్ ట్యాబ్‌లకు, ఇతర యాప్‌లకు మరిన్ని కంప్యూటర్ రిసోర్స్‌లు లభిస్తాయి, దీనితో Chromium వేగంగా పని చేస్తుంది. మీ ఇన్‌యాక్టివ్ ట్యాబ్‌లకు మీరు తిరిగి వచ్చినప్పుడు, అవి ఆటోమేటిక్‌గా మళ్లీ యాక్టివ్‌గా మారతాయి. <ph name="BEGIN_LINK" />మెమరీ సేవర్ గురించి మరింత తెలుసుకోండి<ph name="END_LINK" /></translation>
<translation id="7953122114569280985">మీ రహస్య పదబంధాన్ని మీరు మర్చిపోయినా లేదా ఈ సెట్టింగ్‌ను మార్చాలనుకున్నా, మీ ఖాతాలోని Optimium డేటాను <ph name="SETTINGS_LINK" /></translation>
<translation id="174898372403396774">Optimiumను అనుకూలంగా మార్చండి, కంట్రోల్ చేయండి. Optimiumను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయండి.</translation>
<translation id="7513745843649038539">Optimiumను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసుకోవడం ద్వారా, మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, హిస్టరీని డివైజ్‌లన్నింటిలో పర్‌ఫెక్ట్‌గా సింక్ చేసి ఉంచుకోండి.</translation>
<translation id="5809516625706423866">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. HTTP 401 అనధికార యాక్సెస్. దయచేసి మీ ప్రాక్సీ కాన్ఫిగరేషన్‌ను చెక్ చేయండి.</translation>
<translation id="579643040945073674">Optimium V8 ఇంజిన్‌తో సైట్‌లను వేగవంతం చేస్తుంది కానీ Optimium అటాక్‌లకు కొద్దిగా తక్కువ నిరోధకతను కలిగిస్తుంది. ఈ సెట్టింగ్ ఆఫ్ చేయబడింది.</translation>
<translation id="4979951833951359193">మీ Google ఖాతాలో Optimium డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి, Optimiumను అప్‌డేట్ చేయండి</translation>
<translation id="5824893331272123205">ఈ ప్యానెల్‌ను లోడ్ చేయడం సాధ్యపడలేదు, మళ్లీ ట్రై చేయండి</translation>
<translation id="7677335892217820153">Optimiumకు స్వాగతం</translation>
<translation id="5871205389137001634">ఇమేజ్ సెర్చ్‌ నుండి ఎగ్జిట్ అవ్వడానికి క్లిక్ చేయండి</translation>
<translation id="3069954563229169503">ఈ ఐటెమ్‌లు మాల్‌వేర్‌ను కలిగి ఉన్నట్టుగా Optimium కనుగొన్నది:</translation>
<translation id="5889361821821684993">మీ బ్రౌజర్ సెట్టింగ్‌లు అత్యంత సురక్షితంగా ఉండేలా చూసుకోవడానికి Chromium క్రమం తప్పకుండా చెక్ చేస్తూ ఉంటుంది. దేనికైనా మీ రివ్యూ అవసరం అయితే, మేము మీకు తెలియజేస్తాము.</translation>
<translation id="5895138241574237353">మళ్ళీ ప్రారంభించండి</translation>
<translation id="8498138353382813879">Optimiumలో Gemini Enterprise</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - నెట్‌వర్క్ సైన్ ఇన్</translation>
<translation id="5924017743176219022">ఇంటర్నెట్‌కు కనెక్ట్ చేస్తోంది...</translation>
<translation id="5941711191222866238">కనిష్టీకరించు</translation>
<translation id="7780105764415426863">మీ పరికరాలన్నింటిలో ఈ బుక్‌మార్క్‌తో పాటు మరిన్ని పొందడానికి, Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="3113857336144207971">Optimiumను మీకు నచ్చినట్లు సెటప్ చేయండి</translation>
<translation id="5960071705175224773">మీ సెట్టింగ్‌లు తెలియని యాప్ ద్వారా మార్చబడ్డాయి</translation>
<translation id="2841415208664905665">{COUNT,plural, =1{Optimiumను 1 నిమిషం పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది.}other{Optimiumను # నిమిషాల పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది.}}</translation>
<translation id="6753703218327532561">సింక్‌ను ప్రారంభించడానికి Optimiumను అప్‌డేట్ చేయండి</translation>
<translation id="5990360079535151574">టూల్‌బార్‌లోని "సందర్భోచితమైన టాస్క్‌లు" బటన్ నుండి, మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి సందర్భోచితమైన టాస్క్‌లను మళ్లీ తెరవవచ్చు</translation>
<translation id="6003112304606738118">డౌన్‌లోడ్ అవుతోంది... <ph name="HOURS" /> గంట(లు) సమయం మిగిలి ఉంది</translation>
<translation id="6009821354356307391">అదనపు క్వెరీని అడగండి</translation>
<translation id="6040143037577758943">మూసివేయండి</translation>
<translation id="4546936953038997559">మీ <ph name="DEVICE_TYPE" />‌లో Optimium యాప్‌ను ఉపయోగించినప్పుడు, ఆన్‌లైన్ షాపింగ్‌లో మరిన్ని ప్రయోజనాలను పొందండి</translation>
<translation id="6058380562449900225">మీ డేటాను సురక్షితంగా ఉంచడానికి, మీరు ఇటీవల ఉపయోగించని సైట్‌లకు అనుమతులను తీసివేయడానికి Chromiumకు అనుమతినివ్వండి. నోటిఫికేషన్‌లు అందుతూనే ఉంటాయి.</translation>
<translation id="9167712407654403538">&amp;Optimiumలో తెరవండి</translation>
<translation id="6069027071882229820">ఇమేజ్‌గా కాపీ చేయండి</translation>
<translation id="2336867934702997612">Optimiumకు <ph name="EXTENSION_NAME" /> జోడించబడింది</translation>
<translation id="4963754686639647216">Optimiumను అనుకూలంగా మార్చండి మరియు నియంత్రించండి. అప్‌డేట్ అందుబాటులో ఉంది.</translation>
<translation id="3238331535068195595">ఆన్‌లో ఉంది • ఈ ఎక్స్‌టెన్షన్ ఎక్కడ నుండి వచ్చిందో Optimium వెరిఫై చేయలేదు</translation>
<translation id="1591882001986563343">Optimiumలో మీ ఖాతా</translation>
<translation id="9174470061972211626">Optimium టూల్‌బార్‌లో యాక్సెస్ రిక్వెస్ట్‌లను చూపడానికి ఎక్స్‌టెన్షన్‌ను అనుమతించండి</translation>
<translation id="6285996195476638282"><ph name="FILE_NAME" /> హానికరం, కావున Optimium దాన్ని బ్లాక్ చేసింది.</translation>
<translation id="2722851476153659127">Optimium త్వరలోనే మూసివేయబడుతుంది, డేటా తొలగించబడుతుంది</translation>
<translation id="6855625092121599072">మీరు ఇక్కడ Optimium ప్రొఫైళ్ల మధ్య స్విచ్ అవ్వవచ్చు</translation>
<translation id="615103374448673771">మీరు కుక్కీలను అనుమతిస్తే, ప్రీ - లోడ్ చేసేటప్పుడు Chromium వాటిని ఉపయోగించవచ్చు</translation>
<translation id="6165508094623778733">మరింత తెలుసుకోండి</translation>
<translation id="440816316079905155">మీ ఖాతాలో Optimium డేటాను క్లియర్ చేయండి</translation>
<translation id="8018999409456045233">ఈ ఫైల్ ప్రమాదకరమైనది కావచ్చు<ph name="LINE_BREAK" />మీరు పాస్‌వర్డ్‌ను అందించినట్లయితే Optimium మీ కోసం ఈ డౌన్‌లోడ్‌ను చెక్ చేస్తుంది. ఫైల్ గురించిన సమాచారం Google సురక్షిత బ్రౌజింగ్‌కు పంపబడుతుంది, అయితే ఫైల్ కంటెంట్, పాస్‌వర్డ్ మీ పరికరంలో ఉంటాయి.</translation>
<translation id="6182736845697986886">అప్‌డేట్ సర్వర్ అంతర్గత ఎర్రర్ కారణంగా ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="3469021117852380318">మీ <ph name="TARGET_DEVICE_NAME" />లో మీరు Optimiumకు సైన్ ఇన్ చేశారని నిర్ధారించుకుని, ఆపై మళ్లీ పంపడానికి ట్రై చేయండి.</translation>
<translation id="2986761964667678689">Optimium మినిమైజ్ అయి ఉన్నా, ఎక్కడి నుండైనా సెర్చ్ చేయవచ్చు, ప్రశ్నలు అడగవచ్చు. Optimiumను బ్యాక్‌గ్రౌండ్‌లో రన్ చేయడానికి అనుమతిస్తుంది.</translation>
<translation id="1244028666242035366">ఈ కంప్యూటర్‌లో ఇప్పటికే మరింత తాజాదైన Optimium వెర్షన్ ఉంది. సాఫ్ట్‌వేర్ పని చేయకపోతే, దయచేసి Optimiumను అన్ఇన్‌స్టాల్ చేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="6513480350636703580">{0,plural, =0{Optimium ఇప్పుడు తిరిగి ప్రారంభించబడుతుంది}=1{1 సెకనులో Optimium తిరిగి ప్రారంభించబడుతుంది}other{# సెకన్లలో Optimium తిరిగి ప్రారంభించబడుతుంది}}</translation>
<translation id="3859762680410498178">మీ స్క్రీన్ ఉపయోగించనప్పుడు Optimium అప్‌డేట్ అవుతుంది</translation>
<translation id="18853993527252772">ఫైళ్లను డౌన్‌లోడ్ చేయడానికి Optimiumకు స్టోరేజ్ యాక్సెస్‌కు సంబంధించిన అనుమతి అవసరం</translation>
<translation id="6245734527075554892">Chromiumలో స్టోర్ చేయబడిన సురక్షితం కాని సైట్‌ల లిస్ట్‌తో కూడిన URLలను చెక్ చేస్తుంది</translation>
<translation id="571621467627269416">Optimiumను డిఫాల్ట్ బ్రౌజర్‌గా చేయి</translation>
<translation id="6248988683584659830">సెర్చ్ సెట్టింగ్‌లు</translation>
<translation id="4260906300317983841">మీ ఫోన్‌లోని Optimium యాప్‌తో, ప్రయాణంలోనూ Google అత్యుత్తమ సేఫ్టీ ఫీచర్‌లను పొందండి</translation>
<translation id="6919871734111021049">Optimium నుండి సైన్ అవుట్ చేయాలా?</translation>
<translation id="8269500201917700071">ఈ ట్యాబ్‌లు అదనపు రిసోర్స్‌లను ఉపయోగిస్తున్నాయి. మీ పనితీరును మెరుగుపరచడానికి, వాటిని ఇన్‌యాక్టివ్‌గా ఉంచడానికి Optimiumకు అనుమతినివ్వండి.</translation>
<translation id="2906910751900335741">మీ Optimium ప్రొఫైల్‌ను అనుకూలంగా మార్చండి</translation>
<translation id="6290827346642914212">మీ Chromium ప్రొఫైల్‌కు పేరు పెట్టండి</translation>
<translation id="6294638840436017818">టూల్‌బార్‌లోని "Google Search సైడ్ ప్యానెల్" బటన్ నుండి, మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి Google Search సైడ్ ప్యానెల్‌ను మళ్లీ తెరవవచ్చు</translation>
<translation id="6612045300479871672">ఒక ఎక్స్‌టెన్షన్ మీరు Optimiumకి సైన్ ఇన్ చేయాల్సిందిగా కోరుతోంది</translation>
<translation id="2723016125417495514"><ph name="FILE_NAME" /> హానికరం కావచ్చు, కావున Optimium దాన్ని బ్లాక్ చేసింది.</translation>
<translation id="6308106880471005841">టూల్‌బార్‌లోని "Google Search ప్యానెల్" బటన్‌కు కొత్త చిహ్నం ఉంది. మీరు Google Search ప్యానెల్‌తో బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి దాన్ని క్లిక్ చేయండి.</translation>
<translation id="6151952148243982653">Optimium మీ కెమెరాను ఉపయోగిస్తోంది.</translation>
<translation id="7744220780291650493">Optimiumలో మరొక వ్యవస్థాపన జరుగుతోంది. దయచేసి తర్వాత మళ్లీ ట్రై చేయండి.</translation>
<translation id="4212271170228408978">ఇప్పుడు మీ Google ఖాతాతో, షేర్ చేయ‌బ‌డిన కంప్యూట‌ర్‌ల‌లో Optimiumను సులభంగా ఉపయోగించవచ్చు.</translation>
<translation id="7560359899505953564">Optimiumను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయడం ద్వారా మీకు తెలిసిన, మీరు ఇష్టపడే, విశ్వసించే ఫీచర్‌లకు యాక్సెస్‌ను సులభంగా పొందండి.</translation>
<translation id="9090225774559341003">Optimium షార్ట్‌కట్</translation>
<translation id="6926580396655648750">ఫైల్ సాధారణంగా డౌన్‌లోడ్ అవ్వని, అలాగే ఇది ప్రమాదకరమైనది అయినందున Optimium ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="8406846117825568223">మీరు ఖచ్చితంగా Optimiumను అన్ఇన్‌స్టాల్ చేయాలనుకుంటున్నారా?</translation>
<translation id="6375219077595103062">Password Managerకు షార్ట్‌కట్‌ను జోడించండి</translation>
<translation id="6388799252195623474">ఈ విషయంలో నాకు సహాయం కావాలి</translation>
<translation id="9091694200019721003">కొనసాగించడానికి, Optimiumకి <ph name="EMAIL" />‌తో సైన్ ఇన్ చేయండి. ఇది మీ సంస్థకు సంబంధించిన పాలసీలను మీరు పొందారని నిర్ధారిస్తుంది.</translation>
<translation id="3942952894185574182">కంప్యూటర్ స్క్రీన్‌లో Optimium లోగో.</translation>
<translation id="3353682461772532321">Optimium అనేది మెరుపు వేగంతో వెబ్‌పేజీలను మరియు యాప్‌ల‌ను అమలు చేసే వెబ్ బ్రౌజర్. ఇది వేగవంతమైనది, స్థిరమైనది మరియు ఉపయోగించడానికి సులభమైనది. Optimiumలో రూపొందించిన మాల్‌వేర్‌ మరియు ఫిషింగ్ రక్షణతో మరింత సురక్షితంగా వెబ్‌లో బ్రౌజ్ చేయండి.</translation>
<translation id="6791461984478543248">మీరు మీ Google ఖాతాలో Optimium డేటాను ఎల్లప్పుడూ ఉపయోగించగలరని, సేవ్ చేయగలరని నిర్ధారించుకోవడానికి, ఇది మీరేనని వెరిఫై చేయండి</translation>
<translation id="6174985388495951106">Optimium మరింత వేగంగా పని చేస్తుంది, JavaScriptను ఉపయోగించే ఫీచర్‌లు డిజైన్ చేసిన విధంగానే పని చేస్తాయి</translation>
<translation id="6436260184216827876">ఇమేజ్ సెర్చ్ అందుబాటులో లేదు. తర్వాత మళ్లీ ట్రై చేయండి.</translation>
<translation id="6442900851116057561">ChromiumOSను రీస్టార్ట్ చేయండి</translation>
<translation id="6443470774889161065">Chromium మీరు సందర్శించే అవకాశం ఉన్న ఇంకా మరిన్ని పేజీలను ప్రీ - లోడ్ చేస్తుంది, తద్వారా మీరు వాటిని సందర్శించినప్పుడు అవి మరింత త్వరగా లోడ్ అవుతాయి</translation>
<translation id="2102210363398612557">ధరలను ట్రాక్ చేయడానికి, ఏదైనా సైట్‌లో ధర తగ్గినప్పుడు అలర్ట్‌లను పొందడానికి మీ ఫోన్‌లో Optimiumను డౌన్‌లోడ్ చేసుకోండి</translation>
<translation id="6598227122144472874">ఆఫ్‌లో ఉంది • ఈ ఎక్స్‌టెన్షన్ ఎక్కడ నుండి వచ్చిందో Optimium వెరిఫై చేయలేదు</translation>
<translation id="3895850825918446737">Optimium ప్రొఫైళ్లకు స్వాగతం</translation>
<translation id="3239105679122868308">మీరు నెక్స్ట్ టైమ్ మీ <ph name="DEVICE_TYPE" />‌లో Optimiumను తెరిచినప్పుడు, ట్యాబ్ గ్రూప్‌లను ఉపయోగించమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="5440394152628202500">Optimium నుండి ఖాతాను తీసివేయండి</translation>
<translation id="5673289019038024720">ఇది మీరు Optimiumని ప్రారంభించేటప్పుడు చూపబడే పేజీని కూడా నియంత్రిస్తుంది.</translation>
<translation id="648319183876919572">ప్రమాదకరమైన వెబ్‌సైట్‌ల నుండి, డౌన్‌లోడ్‌ల నుండి మెరుగైన సురక్షిత బ్రౌజింగ్ మీకు మరింత రక్షణను అందిస్తుంది</translation>
<translation id="3922692586556595624">Optimiumను అన్ఇన్‌స్టాల్ చేయి</translation>
<translation id="5977471146123132488">షార్ట్‌కట్‌లు Optimiumలో తెరవబడతాయి</translation>
<translation id="1873460655129342919">Optimiumను <ph name="TIMEOUT_DURATION" /> సమయం పాటు వినియోగించకపోతే, మీ సంస్థ దానిని మూసివేస్తుంది. బ్రౌజింగ్ డేటా తొలగించబడింది. ఈ తొలగించబడే డేటాలో హిస్టరీ, ఆటోమేటిక్‌గా పూరించబడిన డేటా, ఇంకా డౌన్‌లోడ్‌లు ఉండవచ్చు.</translation>
<translation id="139284349466910875">ప్రతి ప్రొఫైల్‌లో బుక్‌మార్క్‌లు, హిస్టరీ, పాస్‌వర్డ్‌లు లాంటి దాని సొంత Optimium సమాచారం ఉంటుంది</translation>
<translation id="6556755379298048869">కీబోర్డ్ షార్ట్‌కట్‌తో సెర్చ్ చేయండి.</translation>
<translation id="6563921047760808519"><ph name="BEGIN_LINK" />Chromium మీ డేటాను ఎలా ప్రైవేట్‌గా ఉంచుతుంది<ph name="END_LINK" /> అనే దాని గురించి మరింత తెలుసుకోండి</translation>
<translation id="562266251854740285">Optimium రీస్టార్ట్ అయిన తర్వాత ఈ సెట్టింగ్‌కు మార్పులు వర్తింపజేయడం జరుగుతుంది.</translation>
<translation id="965740992595240282">Optimium ప్రధాన మెనూలోని ఎక్స్‌టెన్షన్‌లను క్లిక్ చేయడం ద్వారా మీ ఎక్స్‌టెన్షన్‌లను మేనేజ్ చేయండి.</translation>
<translation id="2549448919385330625">మీరు మరొక Optimium ప్రొఫైల్‌కు మారి, పాస్‌వర్డ్‌లను చూడవచ్చు</translation>
<translation id="2662027419736610653">అత్యుత్తమ AI టూల్స్‌ను ఎక్కడికైనా మీతో పాటు తీసుకెళ్లడానికి Optimium యాప్‌ను ఉపయోగించండి</translation>
<translation id="6570579332384693436">అక్షరక్రమ లోపాలను పరిష్కరించడానికి, మీరు వచన ఫీల్డ్‌లలో టైప్ చేసే వచనాన్ని, Chromium Googleకు పంపుతుంది</translation>
<translation id="8346408025829878332">Optimium నోటిఫికేషన్ సెట్టింగ్‌లకు వెళ్లు</translation>
<translation id="6600016381025017075">ఈ పేజీలో దేన్నైనా సెర్చ్ చేయండి</translation>
<translation id="5149981246269331326">మీ మార్పులు మీరు Optimiumని మరుసటిసారి ప్రారంభించినప్పుడు ప్రభావాన్ని చూపుతాయి.</translation>
<translation id="1163143914216098175">Windows ప్రారంభమైనప్పుడు Optimium ఇప్పుడు ప్రారంభమవుతుంది, కాబట్టి మీరు తక్షణమే బ్రౌజింగ్‌ను ప్రారంభించవచ్చు. మీరు దీన్ని సెట్టింగ్‌లలో ఆఫ్ చేయవచ్చు.</translation>
<translation id="7839895033810030903">మీరు ఆపివేసిన చోట నుండి కొనసాగించండి: Optimium మీ చివరి సెషన్ నుండి మీ ట్యాబ్‌లను రీస్టోర్ చేస్తుంది. మీరు వీటిలో ఆఫ్ చేయవచ్చు</translation>
<translation id="8919724422686713691">మీ పరిసరాల 3D మ్యాప్‌ను క్రియేట్ చేయడానికి Optimiumకు కెమెరా అనుమతి అవసరం</translation>
<translation id="6669284030132180248">మీ బుక్‌మార్క్‌లను Google ఖాతాలో కూడా సేవ్ చేస్తే, మీరు Chromiumలో ప్రోడక్ట్ ధరలను ట్రాక్ చేయవచ్చు, ధర తగ్గినప్పుడు తెలియజేయబడుతుంది</translation>
<translation id="6676384891291319759">ఇంటర్నెట్‌ను యాక్సెస్ చేయండి</translation>
<translation id="668175097507315160">సైన్ ఇన్ చేయడంలో ఎర్రర్ ఏర్పడినందున ChromiumOS మీ డేటాను సింక్ చేయలేకపోయింది.</translation>
<translation id="2337492685922399200">Optimium నుండి ఈ యాప్ డేటాను తీసివేయండి</translation>
<translation id="7200198227335381561">ఈ సైట్ కోసం Optimiumకు మైక్రోఫోన్ అనుమతి అవసరం</translation>
<translation id="6712881677154121168">డౌన్‌లోడ్ చేయడంలో ఎర్రర్ ఏర్పడింది: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="358599119501177356">మీ ప్రొఫైల్, కొత్త Optimium వెర్షన్‌కు చెందినది కాబట్టి, దీనిని ఉపయోగించడం సాధ్యపడదు.

కొన్ని ఫీచర్‌లు అందుబాటులో ఉండకపోవచ్చు. దయచేసి వేరొక ప్రొఫైల్ డైరెక్టరీని పేర్కొనండి లేదా Optimium యొక్క కొత్త వెర్షన్‌ను ఉపయోగించండి.</translation>
<translation id="6729124504294600478">వ్యక్తిగతీకరణను, ఇతర ఫీచర్‌లను పొందడానికి, Chromiumను 'వెబ్ &amp; యాప్ యాక్టివిటీ'లో, లింక్ అయిన Google సర్వీస్‌లలో చేర్చండి</translation>
<translation id="196085196242095682">మీ కంప్యూటర్‌లోని వినియోగదారులందరికీ Optimium ఇప్పటికే ఇన్‌స్టాల్ చేయబడింది.</translation>
<translation id="8573534493546068455">మీ డివైజ్‌లన్నింటిలో మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Optimiumకు సైన్ ఇన్ చేయండి మీరు సైన్ ఇన్ చేసిన తర్వాత ఈ బుక్‌మార్క్ మీ Google ఖాతాలో సేవ్ అవుతుంది.</translation>
<translation id="674891594898436429">ఈ ట్యాబ్‌లో యాక్టివ్ సెర్చ్‌ను విస్మరించండి</translation>
<translation id="87486021868820245">Optimium V8 ఇంజిన్‌తో సైట్‌లను వేగవంతం చేస్తుంది కానీ Optimium అటాక్‌లకు కొద్దిగా తక్కువ నిరోధకతను కలిగిస్తుంది. ఈ సెట్టింగ్ ఆన్ చేయబడింది.</translation>
<translation id="474617559993879524">{count,plural, =1{మీ Optimium డేటాలో కొంత భాగం, ఇంకా మీ Google ఖాతాలో సేవ్ కాలేదు. సైన్ అవుట్ చేయడానికి ముందు, కొన్ని నిమిషాలు వేచి ఉండటానికి ట్రై చేయండి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా (1 ఐటెమ్) తొలగించబడుతుంది.}other{మీ Optimium డేటాలో కొంత భాగం, ఇంకా మీ Google ఖాతాలో సేవ్ కాలేదు. సైన్ అవుట్ చేయడానికి ముందు, కొన్ని నిమిషాలు వేచి ఉండటానికి ట్రై చేయండి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా ({count} ఐటెమ్‌లు) తొలగించబడుతుంది.}}</translation>
<translation id="1681402107856523620">ఈ ఫైల్ ప్రమాదకరమైనది కావచ్చు, కాబట్టి దీనిని స్కాన్ చేయమని Optimium సిఫార్సు చేస్తోంది.</translation>
<translation id="6779406956731413166">ChromiumOS అనేది అదనపు <ph name="BEGIN_LINK_CROS_OSS" />ఓపెన్ సోర్స్ సాఫ్ట్‌వేర్<ph name="END_LINK_CROS_OSS" /> ద్వారా సాధ్యమైంది.</translation>
<translation id="6804256634866838775">యాక్టివ్ సెర్చ్‌ను విస్మరించండి</translation>
<translation id="6831043979455480757">అనువదించు</translation>
<translation id="2199057756312069531">మీ పాస్‌వర్డ్‌లు ఎప్పుడైనా హ్యాక్ అయితే, Optimium మీకు తెలియచేస్తుంది</translation>
<translation id="684888714667046800">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. మీరు ఫైర్‌వాల్‌ను ఉపయోగిస్తుంటే, దయచేసి <ph name="PRODUCT_EXE_NAME" /> వైట్‌లిస్ట్‌లో ఉందని నిర్ధారించుకోండి.</translation>
<translation id="6664374380152979637">Optimium - <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">కొనసాగించడానికి ట్యాబ్ చేయండి</translation>
<translation id="6862030660799253820">ఇమేజ్ సెర్చ్‌తో ఈ ఇమేజ్‌ను సెర్చ్ చేయండి</translation>
<translation id="6869568587896659271">అడ్రస్ బార్ కింద వెబ్‌సైట్‌లకు సులభమైన యాక్సెస్</translation>
<translation id="4548192511713002443">"<ph name="EXTENSION_NAME" />"లో మాల్‌వేర్ ఉన్నట్టుగా Optimium కనుగొన్నది</translation>
<translation id="6877155553248388166">సెర్చ్ ఏరియాకు దిగువ కుడి మూలన: కుడి వైపు <ph name="RIGHT" />%, దిగువ <ph name="BOTTOM" />%</translation>
<translation id="6896758677409633944">కాపీ చేయండి</translation>
<translation id="6898028264630240901">మీరు బ్రౌజ్ చేస్తున్నప్పుడు సులభంగా ప్రశ్నలు అడిగేందుకు సందర్భోచితమైన టాస్క్‌లను పిన్ చేయవచ్చు</translation>
<translation id="3594007018780395447">Optimiumను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసి, దానిని మీ టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="8874878391047306490">&amp;Optimium ప్రొఫైల్స్‌ను మేనేజ్ చేయండి</translation>
<translation id="8227361644719983591">ఈ చర్య కారణంగా:
          <ph name="LINE_BREAKS" />
            • మీ ప్రారంభ పేజీ, కొత్త ట్యాబ్ పేజీ, సెర్చ్ ఇంజిన్, పిన్ చేసిన ట్యాబ్‌లు రీసెట్ అవుతాయి
            <ph name="LINE_BREAK" />
            • ఎక్స్‌టెన్షన్‌లు డిజేబుల్ అవుతాయి
            <ph name="LINE_BREAK" />
            • కుక్కీలు, ఇతర తాత్కాలిక సైట్ డేటాను తొలగించడం జరుగుతుంది
            <ph name="LINE_BREAK" />
            • Optimium షార్ట్‌కట్‌లు రీసెట్ అవుతాయి
            <ph name="LINE_BREAKS" />
            బుక్‌మార్క్స్, హిస్టరీ, ఇంకా సేవ్ అయిన పాస్‌వర్డ్‌లు ప్రభావితం కావు.</translation>
<translation id="6926772305569367352">టూల్‌బార్‌లోని "Chromeలో Google Search" బటన్‌కు కొత్త చిహ్నం ఉంది. Chromeలో Google Searchతో బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి దాన్ని క్లిక్ చేయండి.</translation>
<translation id="7079691767892495301">మీరు Optimium పరిమితి అయిన <ph name="BOOKMARK_LIMIT" /> బుక్‌మార్క్‌లను చేరుకున్నారు, కాబట్టి మీ బుక్‌మార్క్‌లలో కొన్ని ఇంకా మీ Google ఖాతాలో సేవ్ కాలేదు.

మీరు కొన్ని బుక్‌మార్క్‌లను తొలగించే వరకు మీ ఖాతాలో కొత్త బుక్‌మార్క్‌లను సేవ్ చేయడం సాధ్యపడదు. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, సేవ్ చేయని బుక్‌మార్క్‌లు తొలగించబడతాయి.</translation>
<translation id="8488478146459741524">Optimium అజ్ఞా&amp;త విండోలో లింక్‌ను తెరువు</translation>
<translation id="6965382102122355670">సరే</translation>
<translation id="6985329841647292029">ChromiumOS నియమాలు</translation>
<translation id="8559464220428426642">మీ ఖాతా <ph name="ACCOUNT_EMAIL" />‌లో Optimium డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి మీ రహస్య పదబంధాన్ని ఎంటర్ చేయండి</translation>
<translation id="7011190694940573312">ఈ వెర్షన్ ఆపరేటింగ్ సిస్టమ్ సపోర్ట్ చేయనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="7024536598735240744">డెవలపర్ మోడ్‌లో ఉన్న ఎర్రర్: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7941779569092758272">{COUNT,plural, =1{అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Optimiumను రీ-లాంచ్ చేయాలని అడ్వాన్స్‌డ్ ప్రొటెక్షన్ కోరుతోంది. మీ ఐసోలేటెడ్ విండో మళ్లీ ఓపెన్ కాదు.}other{అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Optimiumను రీ-లాంచ్ చేయాలని అడ్వాన్స్‌డ్ ప్రొటెక్షన్ కోరుతోంది. మీ # ఐసోలేటెడ్ విండోలు మళ్లీ ఓపెన్ కావు.}}</translation>
<translation id="5367778139372857256">Optimiumను మీకు నచ్చిన విధంగా తయారు చేసుకోండి</translation>
<translation id="7047386856539490735">ఈ ఫలితాలు ఉపయోగకరంగా ఉన్నాయా?</translation>
<translation id="6654931874608808546">Optimiumను అప్‌డేట్ చేయి</translation>
<translation id="1078205929937913964">చిత్రంలో ఉపయోగకరమైన వివరణ లేకుంటే, మీ కోసం ఒక వివరణను అందించడానికి Optimium ప్రయత్నిస్తుంది. వివరణలను క్రియేట్ చేయడానికి, చిత్రాలు Googleకు పంపబడతాయి.</translation>
<translation id="8657336023716174215">మీ <ph name="DEVICE_TYPE" />‌లో Optimium యాప్‌ను ఉపయోగించి AI సామర్థ్యాలను పొందండి</translation>
<translation id="8360922610978196377">మీ ఫోన్‌లోని Optimium యాప్‌తో మీ పాస్‌వర్డ్‌లు, ట్యాబ్‌లు, మరిన్నింటిని ఎక్కడికైనా మీతో పాటు తీసుకెళ్లండి</translation>
<translation id="7141270731789036260">Chrome for Testingను అనుకూలంగా మార్చండి</translation>
<translation id="7147227333672430807">మీరు మెసేజ్‌ల్లో, డాక్యుమెంట్‌ల్లో, ఇంకా ఇతర యాప్‌ల్లో ఉండే లింక్‌లను క్లిక్ చేసినప్పుడల్లా Chromiumను ఉపయోగించవచ్చు</translation>
<translation id="7635847276859447848">Optimium నుండి <ph name="EXTENSION_NAME" />‌ను తీసివేయండి</translation>
<translation id="4634249408802713112">Optimium డేటాను <ph name="TIMEOUT_DURATION" /> సమయం పాటు వినియోగించకపోతే, మీ సంస్థ దానిని తొలగిస్తుంది. ఈ తొలగించబడే డేటాలో హిస్టరీ, ఆటోమేటిక్‌గా పూరించబడిన డేటా, ఇంకా డౌన్‌లోడ్‌లు ఉండవచ్చు.</translation>
<translation id="3308314751977712481">ఈ సైట్ కోసం Optimiumకు కెమెరా అనుమతి అవసరం</translation>
<translation id="1700107811881467396">Optimiumను ప్రారంభించడం సాధ్యపడలేదు. మళ్లీ ట్రై చేయండి.</translation>
<translation id="615859695332174696">Optimiumలో Geminiతో, మీరు ఎక్కడ ఉన్నా సరే, ఏదైనా అడగండి</translation>
<translation id="4082322885657154457">Optimiumను మీకు కావలసినప్పుడల్లా త్వరగా పొందడానికి దాన్ని మీ డాక్‌లో ఉంచుకోండి</translation>
<translation id="5886985791575399945">మీరు మెసేజ్‌లలో, డాక్యుమెంట్‌లలో, ఇంకా ఇతర యాప్‌లలో ఉండే లింక్‌లను క్లిక్ చేసినప్పుడల్లా Optimiumను ఉపయోగించండి</translation>
<translation id="7213435258745128111">Chromiumలో Google Search</translation>
<translation id="7216228761061470870">మీరు డెస్క్‌టాప్‌లో ఇమేజ్ సెర్చ్‌ను ఉపయోగించినప్పుడు, పేజీ టైటిల్, URL, అలాగే PDFలతో సహా అందులోని కంటెంట్ అంతా సర్వర్‌కు వెళుతుంది.</translation>
<translation id="3899250150715276784">విధి నిర్వాహకుడు - Optimium</translation>
<translation id="357779301278973973">ఇతర యాప్‌లు లేదా ఫైల్స్ వంటి Optimium వెలుపల ఉన్న కంటెంట్ గురించి అడగండి</translation>
<translation id="2192941957286691074"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Optimiumకి సైన్ ఇన్ చేయండి. మీరు మీ డివైజ్‌లన్నింటిలో సేవ్ చేసిన మీ సమాచారాన్ని, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="4695009148423764441">తక్షణమే బ్రౌజింగ్‌ను ప్రారంభించండి: Windows ప్రారంభమైనప్పుడు Optimium ఇప్పుడు ప్రారంభించబడుతుంది.</translation>
<translation id="7274695763216404502">పిన్ చేశారు! టూల్‌బార్ నుండి ఇమేజ్ సెర్చ్‌ను మళ్లీ ఉపయోగించండి</translation>
<translation id="7288567540154601580">ట్యాబ్‌లు, ఎక్స్‌టెన్షన్‌లు</translation>
<translation id="7290997427370476749">టూల్‌బార్‌లోని "Google Search ప్యానెల్" బటన్ నుండి, మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి Google Search ప్యానెల్‌ను మళ్లీ తెరవవచ్చు</translation>
<translation id="1079602886106438527">{NUM_EXTENSIONS,plural, =1{మీరు దాన్ని తీసివేయవలసిందిగా Optimium సిఫార్సు చేస్తోంది}other{మీరు వాటిని తీసివేయవలసిందిగా Optimium సిఫార్సు చేస్తోంది}}</translation>
<translation id="5279936464959604532">సిస్టమ్ ఆడియోను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లను తెరిచి, Optimium కోసం 'సిస్టమ్ ఆడియో రికార్డింగ్ మాత్రమే'ను అనుమతించండి. ఆపై మీరు Optimiumను రీస్టార్ట్ చేయాలి.</translation>
<translation id="7299899569525778554">డెస్క్‌టాప్ నుండి సెర్చ్ చేయండి</translation>
<translation id="731795002583552498">Chromiumని అప్‌డేట్ చేస్తోంది</translation>
<translation id="1032861344046520617">మీ ప్రాధాన్యతల ఫైల్ పాడైంది లేదా చెల్లదు. Optimium మీ సెట్టింగ్‌లను పునరుద్ధరించలేకపోయింది.</translation>
<translation id="7324051657739063017">మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి మీరు సందర్భోచితమైన టాస్క్‌లను మళ్లీ తెరవవచ్చు</translation>
<translation id="265884122223707624">మీ వెబ్, బుక్‌మార్క్‌లు మరియు ఇతర Optimium అంశాలు ఇక్కడ చూపబడతాయి.</translation>
<translation id="7347827960336370838">మీ రహస్య పదబంధం ఉన్న కొంతమంది మాత్రమే ఎన్‌క్రిప్ట్ చేసిన మీ డేటాను చదవగలరు. రహస్య పదబంధం Googleకు పంపబడదు లేదా Googleలో స్టోర్ అవ్వదు. మీరు మీ రహస్య పదభందాన్ని మర్చిపోతే లేదా ఈ సెట్టింగ్‌ను మార్చాలనుకుంటే, మీరు <ph name="BEGIN_LINK" />మీ ఖాతాలోని Chromium డేటాను తొలగించాల్సి ఉంటుంది<ph name="END_LINK" />.</translation>
<translation id="3014807377884544255"><ph name="TARGET_URL_HOSTNAME" />ను యాక్సెస్ చేయడం కోసం <ph name="ALTERNATIVE_BROWSER_NAME" />ను తెరిచే విధంగా Optimiumను మీ సిస్టమ్ నిర్వాహకుడు కాన్ఫిగర్ చేశారు.</translation>
<translation id="7352651011704765696">ఏదో తప్పు జరిగింది</translation>
<translation id="6261059974673858354">భవిష్యత్తులో Optimium అప్‌డేట్‌లను పొందడానికి, మీకు macOS 13 కానీ, అంతకన్నా లేటెస్ట్ వెర్షన్ కానీ ఉండాలి. ఈ కంప్యూటర్ macOS 12 వెర్షన్‌ను ఉపయోగిస్తోంది.</translation>
<translation id="7374061268215476070">మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి Google Search సైడ్ ప్యానెల్‌ను మళ్లీ తెరవవచ్చు</translation>
<translation id="7376384068949534168">మీరు ఇటీవల వెళ్లలేదు. Chromium <ph name="PERMISSION_1" />,‌ <ph name="PERMISSION_2" />ను తీసివేసింది.</translation>
<translation id="73786666777299047">Chrome వెబ్ స్టోర్‌ను తెరవండి</translation>
<translation id="3890970823792853036">సిస్టమ్ ట్రేలో Optimiumలో Geminiని చూడండి</translation>
<translation id="7401687852903179959">"ఇమేజ్ సెర్చ్‌"తో ఈ వీడియోను సెర్చ్ చేయండి</translation>
<translation id="3864955417896853787">Optimium ఇప్పుడు మీ ఆటోమేటిక్ బ్రౌజర్</translation>
<translation id="7774148037106099906">మీరు ఆపివేసిన చోట నుండి కొనసాగించండి: మీరు రీస్టార్ట్ చేసిన ప్రతిసారీ Optimium మీ ట్యాబ్‌లను రీస్టోర్ చేస్తుంది. దీన్ని ఆఫ్ చేసి, ఇక్కడికి వెళ్లండి</translation>
<translation id="8928491002876394495">Optimiumకు పాస్‌వర్డ్‌లను దిగుమతి చేయండి</translation>
<translation id="5203709869300967635">1. దిగువున <ph name="BUTTON_LABEL" /> ఆప్షన్‌ను క్లిక్ చేయండి
2. మీ Windows సెట్టింగ్‌లలో <ph name="BUTTON_2" />‌ను క్లిక్ చేయండి
3. క్విక్ యాక్సెస్ కోసం Optimiumను మీ టాస్క్‌బార్‌కు పిన్ చేయడానికి, Windows నోటిఫికేషన్‌లో <ph name="BUTTON_3" />‌ను క్లిక్ చేయండి</translation>
<translation id="1391846143863378733"><ph name="PAGE_TITLE" /> - Optimium Dev</translation>
<translation id="7450541714075000668">టెక్స్ట్ కాపీ చేయబడింది</translation>
<translation id="7458892263350425044">మైక్రోఫోన్‌ను ఉపయోగించడానికి, <ph name="BEGIN_LINK" />సిస్టమ్ సెట్టింగ్‌ల<ph name="END_LINK" />‌లో Chromiumకు యాక్సెస్ ఇవ్వండి</translation>
<translation id="6029586608765705546">భవిష్యత్తులో Optimium అప్‌డేట్‌లను పొందడానికి, మీకు Windows 10 లేదా ఆ తర్వాత వచ్చిన ఏదైనా వెర్షన్ అవసరం అవుతుంది. ఈ కంప్యూటర్ Windows 7ను ఉపయోగిస్తోంది.</translation>
<translation id="7467949745582939695">Chromiumను రీ-లాంచ్ చేయాలా?</translation>
<translation id="5752242571869112795">ప్రస్తుతం అమలు అవుతోన్న అదే Optimium వెర్షన్‌ను ఇన్‌స్టాల్ చేయలేరు. దయచేసి Optimiumను మూసివేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="7510190804000607802">రిమైండర్: Google అత్యుత్తమ ఫీచర్‌లు ఇక ఎల్లప్పుడూ మీతోనే!</translation>
<translation id="751935028865900641">సైట్‌లు బహుశా ఊహించిన విధంగా పని చేస్తాయి. మీరు Chromiumకు సైన్ ఇన్ చేసినట్లయితే మీ Google ఖాతా మినహా అన్ని Chromium విండోలను మూసివేసినప్పుడు మీరు చాలా సైట్‌ల నుండి సైన్ అవుట్ చేయబడతారు.</translation>
<translation id="63211891312143018">{0,plural, =1{1 నిమిషంలో Optimium తిరిగి ప్రారంభించబడుతుంది}other{# నిమిషాల్లో Optimium తిరిగి ప్రారంభించబడుతుంది}}</translation>
<translation id="7565444033145385702">మీ డేటాను సురక్షితంగా ఉంచడానికి, మీరు ఇటీవల ఉపయోగించని సైట్‌లకు అనుమతులను తీసివేయడానికి Chromiumకు అనుమతినివ్వండి.</translation>
<translation id="3125039289492641783">తక్షణమే బ్రౌజింగ్‌ను ప్రారంభించడానికి Optimiumను ఆటోమేటిక్‌గా లాంచ్ చేయండి.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> ఇన్‌స్టాలర్</translation>
<translation id="4408734053922791034">Optimium మీ కెమెరా మరియు మైక్రోఫోన్‌ని ఉపయోగిస్తోంది.</translation>
<translation id="3179764934195866467">Optimium ఇప్పుడు మెరుగైంది</translation>
<translation id="6404693631411216689">ఇప్పుడు మీకు Optimiumలో మరిన్ని ఫీచర్లు అందుబాటులో ఉన్నాయి</translation>
<translation id="7624307931717240213">ఈ సర్వీస్‌ను మెరుగుపరచడానికి మేము సమాచారాన్ని ఉపయోగిస్తాము. గోప్యతా పాలసీని, సర్వీస్ నియమాలను చూడండి.</translation>
<translation id="7649070708921625228">సహాయం</translation>
<translation id="8311510395768039141">Optimium యాప్‌ను పొందండి</translation>
<translation id="7658239707568436148">రద్దు చేయండి</translation>
<translation id="133478151344333089">Optimium మీ డిఫాల్ట్ బ్రౌజర్ కాదు</translation>
<translation id="280841280407738358">మీ పరికరాల అంతటా Optimiumను సింక్ చేయండి మరియు వ్యక్తిగతీకరించండి</translation>
<translation id="7699779824407626136">Chromium అప్‌డేట్</translation>
<translation id="4220506181038618136">Optimiumలో మీ వర్క్ సురక్షితంగా ఉంటుంది</translation>
<translation id="7716950018788545737">టాస్క్(లు) ముగిసింది.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME" />‌కు సిస్టమ్‌ను ట్రేస్ చేసే సర్వీస్‌లను అందిస్తోంది. ఈ సర్వీస్ డిజేబుల్ అయితే, బ్రౌజర్ ద్వారా క్రియేట్ అయిన పనితీరు ట్రేస్‌లలో కాంటెక్స్ట్ స్విచ్, సిద్ధంగా ఉన్న థ్రెడ్ ఈవెంట్‌ల వంటి సిస్టమ్ అంతటికీ సంబంధించిన ఈవెంట్‌లు ఉండవు.</translation>
<translation id="7745317241717453663">ఇది ఈ పరికరం నుండి మీ బ్రౌజింగ్ డేటాను తొలగిస్తుంది. మీ డేటాను తర్వాత తిరిగి పొందడానికి, Chromiumకు <ph name="USER_EMAIL" /> లాగా సైన్ ఇన్ చేయండి.</translation>
<translation id="7747138024166251722">ఇన్‌స్టాలర్ ఒక తాత్కాలిక డైరక్టరీని సృష్టించలేకపోయింది. సాఫ్ట్‌వేర్‌ను ఇన్‌స్టాల్ చేయడానికి దయచేసి ఖాళీ డిస్క్ స్థలం, అనుమతిని చెక్ చేయండి.</translation>
<translation id="4874030584283115178">ఆటోమేటిక్‌గా ఉండే Optimium రూపానికి రీసెట్ చేయండి</translation>
<translation id="4747871007139957101">Optimiumలో మీ వర్క్‌ను సురక్షితంగా ఉంచేందుకు, మీరు Optimiumకు సైన్-ఇన్ చేసినప్పుడు మీ సంస్థ నిర్దిష్ట సమాచారాన్ని చూడగలదు లేదా మేనేజ్ చేయగలదు.</translation>
<translation id="39303350018938562">Optimiumను ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసి, టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="1411498815218277204">Optimiumను వేగవంతం చేయండి</translation>
<translation id="6759916683257281869"><ph name="PAGE_TITLE" /> - Optimium Canary</translation>
<translation id="7800043020703832708">సైడ్ ప్యానెల్‌లో Google Searchను క్లోజ్ చేయండి</translation>
<translation id="7801317262080715012">కొత్త చిహ్నం, అదే షార్ట్‌కట్: మీరు Google Search ప్యానెల్‌తో బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి క్లిక్ చేయండి.</translation>
<translation id="7803986347287457849">మీ ఇంటర్నెట్ ట్రాఫిక్‌కు యాక్సెస్ ఉన్న వ్యక్తులు మీరు బ్రౌజ్ చేసే సైట్‌లను చూడటం కష్టతరం చేయండి. DNS (డొమైన్ నేమ్ సిస్టమ్)లో సైట్ IP అడ్రస్‌ను చూసేందుకు Chromium సురక్షితమైన కనెక్షన్‌ను ఉపయోగిస్తుంది.</translation>
<translation id="7810005234485217901">సులభంగా యాక్సెస్ చేయడం కోసం మీరు ఇమేజ్ సెర్చ్‌ను పిన్ చేయవచ్చు</translation>
<translation id="3974047900913685132">{COUNT,plural, =1{Optimiumకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు రీ-లాంచ్ చేసిన వెంటనే అది వర్తిస్తుంది. అజ్ఞాత లేదా ఐసోలేటెడ్ విండో ఓపెన్ చేసి ఉంది. మీరు రీ-లాంచ్ చేసిన తర్వాత అది మళ్లీ ఓపెన్ కాదు.}other{Optimiumకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు రీ-లాంచ్ చేసిన వెంటనే అది వర్తిస్తుంది. ప్రొఫైల్స్ అంతటా # అజ్ఞాత, ఐసోలేటెడ్ విండోలు ఓపెన్ చేసి ఉన్నాయి. మీరు రీ-లాంచ్ చేసిన తర్వాత అవి మళ్లీ ఓపెన్ కావు.}}</translation>
<translation id="1327395026710636574">Optimiumతో దేనిని షేర్ చేయాలో ఎంచుకోండి</translation>
<translation id="7712700268586648421">ఈ పరికరంలో ఇప్పటికే ఈ ఖాతాతో ఒక Optimium ప్రొఫైల్ ఉంది</translation>
<translation id="7845233973568007926">ఇన్‌స్టాల్ చేసినందుకు ధన్యవాదాలు. <ph name="BUNDLE_NAME" />‌ను ఉపయోగించడానికి ముందు మీరు కంప్యూటర్‌ను తప్పకుండా రీస్టార్ట్ చేయాలి.</translation>
<translation id="7639854797882089460">మీ సెర్చ్ ఇంజిన్ Optimium వెలుపల నుండి మార్చబడింది. మిమ్మల్ని రక్షించడానికి, దాని ఒరిజినల్ ఆటోమేటిక్ సెట్టింగ్‌కు Optimium దాన్ని రీసెట్ చేసింది. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3551756496947130501">Optimiumకు కొత్త రూపాన్ని అందించడానికి దాన్ని అనుకూలంగా మార్చండి</translation>
<translation id="7859018312476869945">మీరు అడ్రస్ బార్‌లో లేదా సెర్చ్ బాక్స్‌లో టైప్ చేసినప్పుడు, మెరుగైన సూచనలను పొందడానికి Chromium మీరు టైప్ చేసిన దానిని మీ ఆటోమేటిక్ సెర్చ్ ఇంజిన్‌కు పంపుతుంది. అజ్ఞాత మోడ్‌లో ఇది ఆఫ్‌లో ఉంటుంది.</translation>
<translation id="7884611555881634231">Optimiumను తాజా వెర్షన్‌కు అప్‌డేట్ చేయడం సాధ్యం కాలేదు, కాబట్టి మీరు కొత్త ఫీచర్‌లు మరియు భద్రతా పరిష్కారాలను పొందడం లేదు.</translation>
<translation id="7872446069773932638">డౌన్‌లోడ్ అవుతోంది... <ph name="SECONDS" /> సెకను(లు) సమయం మిగిలి ఉంది</translation>
<translation id="7873537467422636035">మీ రహస్య పదబంధాన్ని మీరు మర్చిపోయినా లేదా ఈ సెట్టింగ్‌ను మార్చాలనుకున్నా, <ph name="BEGIN_LINK" />మీ ఖాతాలోని Chromium డేటాను తొలగించండి<ph name="END_LINK" /></translation>
<translation id="3834573390507006929">మీకు అవసరమైనప్పుడల్లా Optimiumలో Geminiని త్వరగా తెరవండి</translation>
<translation id="6294556714699385535">Optimiumను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయండి</translation>
<translation id="7904213866086517086">సైడ్ ప్యానెల్‌లో Google Searchను మళ్లీ తెరవండి</translation>
<translation id="7934340546140346950">వీలైనప్పుడు, Chromium ఆటోమేటిక్‌గా సురక్షితం కాని కనెక్షన్‌లను HTTPSకు అప్‌గ్రేడ్ చేస్తుంది</translation>
<translation id="5730000852184248909">మీరు <ph name="USER_EMAIL_ADDRESS" />గా Optimiumకు సైన్ ఇన్ చేశారు. దయచేసి మళ్లీ సైన్ ఇన్ చేయడానికి ఇదే ఖాతాను ఉపయోగించండి.</translation>
<translation id="8566131222358264585"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Optimiumకి సైన్ ఇన్ చేయండి. మీరు మీ అన్ని డివైజ్‌లలో మీ బుక్‌మార్క్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="7975919845073681630">ఇది Chromium రెండవ ఇన‌స్ట‌లేష‌న్. దీన్ని మీ డిఫాల్ట్ బ్రౌజర్‌గా చేయడం సాధ్యపడదు.</translation>
<translation id="6422450341111525365">తెలియని మూలాలకు చెందిన ఎక్స్‌టెన్షన్‌లు, యాప్‌లు, రూపాలు మీ పరికరానికి హాని కలిగించవచ్చు. <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> నుండి మాత్రమే వాటిని ఇన్‌స్టాల్ చేయని Optimium సిఫార్సు చేస్తోంది</translation>
<translation id="6757123197146934198">మీ<ph name="DEVICE_TYPE" />‌లోని Optimium యాప్‌తో Google అందించే అత్యుత్తమ ప్రయోజనాలను పొందండి</translation>
<translation id="8004582292198964060">బ్రౌజర్</translation>
<translation id="8010081455002666927">ఆటోమేటిక్ గుర్తింపు</translation>
<translation id="1278413817028711539">ఓసారి Optimiumకి యాక్సెస్ లభించాక, ఆపై వెబ్‌సైట్‌లకు ఏమైనా యాక్సెస్‌ కావాలంటే అవి మిమ్మల్ని అడగవచ్చు.</translation>
<translation id="349886907929581949">Optimiumను మీకు కావలసినప్పుడల్లా త్వరగా పొందడానికి దాన్ని టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="80471789339884597">ఇన్‌స్టాల్ చేసినందుకు ధన్యవాదాలు. <ph name="BUNDLE_NAME" />‌ను ఉపయోగించే ముందు మీరు తప్పకుండా మీ అన్ని బ్రౌజర్‌లను రీస్టార్ట్ చేయాలి.</translation>
<translation id="8054112667659782652">ఇమేజ్ సెర్చ్ షార్ట్‌కట్‌ను ఎల్లప్పుడూ చూపించండి</translation>
<translation id="8069447462453318634">"టూల్‌బార్‌కు పిన్ చేయండి" ఆప్షన్‌ను ఎంచుకోండి</translation>
<translation id="4174818101907153398">యాప్‌లకు సంబంధించి బ్యాక్‌గ్రౌండ్‌లో రన్ అవుతున్న Optimiumను డిజేబుల్ చేయండి</translation>
<translation id="80790299200510644">ఇమేజ్ సెర్చ్</translation>
<translation id="8086881907087796310">మీ కంప్యూటర్ కనీస హార్డ్‌వేర్ అవసరాలకు అనుగుణంగా లేనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> - Google Chrome for Testing</translation>
<translation id="1888025000812363096">ఈ సైట్ కోసం Optimiumకు లొకేషన్ అనుమతి అవసరం</translation>
<translation id="7584643292999340766">మీరు నెక్స్ట్ టైమ్ మీ <ph name="DEVICE_TYPE" />‌లో Optimiumను తెరిచినప్పుడు, ధర ట్రాకింగ్ అలర్ట్‌లను ఎనేబుల్ చేయమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="7461287607957342327">మీ ఫోన్‌లోని Optimium యాప్‌తో మీకు నచ్చిన వస్తువుల ధరలు తగ్గినప్పుడు అలర్ట్‌లను పొందండి</translation>
<translation id="8118331347066725040">Lensతో సెర్చ్ చేయడం కోసం ఫీడ్‌బ్యాక్‌ను పంపండి</translation>
<translation id="3539581840889743095">ఇక మీకు నచ్చినట్లుగా Optimium</translation>
<translation id="8133124826068723441">మీ డొమైన్ కోసం సింక్ అందుబాటులో లేనందున, ChromiumOS మీ డేటాను సింక్ చేయలేకపోయింది.</translation>
<translation id="813913629614996137">ప్రారంభిస్తోంది...</translation>
<translation id="4772631357296776122">కీబోర్డ్ షార్ట్‌కట్‌తో Optimiumలో Geminiని తెరవండి.</translation>
<translation id="8164014945047474187">Chromium అదనపు సర్వీస్ నియమాలు</translation>
<translation id="4835039973898764392">{COUNT,plural, =1{ఈ అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Optimiumను రీ-లాంచ్ చేయాలని మీ అడ్మినిస్ట్రేటర్ కోరుతున్నారు. అజ్ఞాత లేదా ఐసోలేటెడ్ విండో ఓపెన్ చేసి ఉంది. మీరు రీ-లాంచ్ చేసిన తర్వాత అది మళ్లీ ఓపెన్ కాదు.}other{ఈ అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Optimiumను రీ-లాంచ్ చేయాలని మీ అడ్మినిస్ట్రేటర్ కోరుతున్నారు. ప్రొఫైల్స్ అంతటా # అజ్ఞాత, ఐసోలేటెడ్ విండోలు ఓపెన్ చేసి ఉన్నాయి. మీరు రీ-లాంచ్ చేసిన తర్వాత అవి మళ్లీ ఓపెన్ కావు.}}</translation>
<translation id="8065654717207240588">ఈ ఫైల్ అపాయకరమైనది, కాబట్టి Optimium దీన్ని బ్లాక్ చేసింది.</translation>
<translation id="8177472873527554730">పేజీలో కంటెంట్ కనుగొనడం సాధ్యం కాలేదు</translation>
<translation id="8200109504272824693">మీ ఖాతా, <ph name="USER_EMAIL" />‌లో Chromium డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి మీ రహస్య పదబంధాన్ని ఎంటర్ చేయండి</translation>
<translation id="8203105157044679380">Google Search ప్యానెల్</translation>
<translation id="820759916613250543">"ఇమేజ్ సెర్చ్‌"తో ఈ ఇమేజ్‌ను సెర్చ్ చేయండి</translation>
<translation id="8221491193165283816">మీరు సాధారణంగా నోటిఫికేషన్‌లను బ్లాక్ చేస్తుంటారు. ఈ సైట్ నుండి నోటిఫికేషన్‌లను పొందాలంటే, ఇక్కడ క్లిక్ చేయండి.</translation>
<translation id="8223363452568144035">మీ కెమెరాను ఉపయోగించడానికి, <ph name="BEGIN_LINK" />సిస్టమ్ సెట్టింగ్‌ల<ph name="END_LINK" />‌లో Chromiumకు యాక్సెస్ ఇవ్వండి</translation>
<translation id="1094434558959920914">ఈ ఎక్స్‌టెన్షన్ ఎక్కడ నుండి వచ్చిందో Optimium వెరిఫై చేయడం సాధ్యం కాదు, ఇది సురక్షితం కాకపోవచ్చు. Optimium నుండి దాన్ని తీసివేయండి, తద్వారా ఇది వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="3957438238123670294">చిత్రంలో ఉపయోగకరమైన వివరణ లేకుంటే, మీ కోసం ఒక వివరణను అందించడానికి Optimium ప్రయత్నిస్తుంది. వివరణలను క్రియేట్ చేయడానికి, చిత్రాలు Googleకు పంపబడతాయి. మీరు దీన్ని ఎప్పుడైనా సెట్టింగ్‌లలో ఆఫ్ చేయవచ్చు.</translation>
<translation id="2706853324286223963">కొత్త ప్రొఫైల్‌లో Optimiumకి సైన్ ఇన్ చేయాలా?</translation>
<translation id="1237310177197195175"><ph name="EXISTING_USER" /> ఇప్పటికే సైన్ ఇన్ అయి ఉన్నారు. మీ బ్రౌజింగ్ వివరాలను విడిగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS" />గా మీ స్వంత ప్రొఫైల్‌తో Optimiumకి సైన్ ఇన్ చేయండి. మీరు <ph name="DEVICE" /> నుండి మీ పాస్‌వర్డ్‌లను, అలాగే మరిన్ని వివరాలను కూడా పొందుతారు.</translation>
<translation id="2801607883759458012">సిస్టమ్ ట్రేలో Optimiumలో Geminiని చూపించి, కీబోర్డ్ షార్ట్‌కట్‌ను ఆన్ చేయండి</translation>
<translation id="8286943863733751221">సురక్షితం కాని సైట్‌లు, డౌన్‌లోడ్‌ల గురించి <ph name="BEGIN_LINK" />Chromium మిమ్మల్ని హెచ్చరిస్తుంది<ph name="END_LINK" /></translation>
<translation id="8295827201165805317">మీరు ఇటీవల వెళ్లలేదు. Chromium <ph name="PERMISSION" />‌ను తీసివేసింది.</translation>
<translation id="5265623464653503960">Optimium iOS యాప్‌లో మీ కెమెరాతో మీరు చూసే వాటిని షాపింగ్ చేయండి, అనువదించండి, అలాగే గుర్తించండి</translation>
<translation id="7565411431973063464">Optimiumకు <ph name="USER_NAME" />‌గా సైన్ ఇన్ చేయడానికి QR కోడ్</translation>
<translation id="8313851650939857356">స్టార్టప్ ఎర్రర్: <ph name="STARTUP_ERROR" />.</translation>
<translation id="5911806827430614904">Optimiumను <ph name="TIMEOUT_DURATION" /> సమయం పాటు వినియోగించకపోతే, మీ సంస్థ దానిని మూసివేస్తుంది.</translation>
<translation id="8321058241987390452">విజయవంతమైంది! ఇకపై మీరు Google Search ప్యానెల్‌తో బ్రౌజ్ చేస్తున్నప్పుడే సులభంగా ప్రశ్నలు అడగవచ్చు</translation>
<translation id="8321888067342493336">ఇమేజ్‌గా సేవ్ చేయండి</translation>
<translation id="1508573889613002459"><ph name="USER_EMAIL_ADDRESS" /> మునుపు Optimiumని ఉపయోగించింది</translation>
<translation id="8351551329754447960">Chromiumలో స్కిల్స్‌ను ఎనేబుల్ చేయండి</translation>
<translation id="406081439566291910">మీ Google ఖాతా <ph name="ACCOUNT_EMAIL" />‌లోని Optimium డేటాను ఉపయోగించేందుకు Optimiumను అప్‌డేట్ చేయండి</translation>
<translation id="1007124785122331769">భవిష్యత్తు Optimium అప్‌డేట్‌లను పొందడానికి, మీకు Windows 10 లేదా ఆ తర్వాత వచ్చిన ఏదైనా వెర్షన్ అవసరం అవుతుంది. ఈ కంప్యూటర్ Windows 8ను ఉపయోగిస్తోంది.</translation>
<translation id="8362914115861174987">ఈ భాషలోకి అనువదించండి</translation>
<translation id="8367705492654390392">ఏదైనా అడగండి</translation>
<translation id="8370517070665726704">కాపీరైట్ <ph name="YEAR" /> సర్వ హక్కులు Google LLCకి రిజర్వ్ అయ్యాయి.</translation>
<translation id="3692978295966861512">మీ పరికరాలన్నిటిలో మీ పాస్‌వర్డ్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Optimiumకు సైన్ ఇన్ చేయండి. ఈ పాస్‌వర్డ్, మీరు సైన్ ఇన్ చేసిన తర్వాత మీ Google ఖాతాలో సేవ్ అవుతుంది.</translation>
<translation id="7364603585139702314">ఆపై మీరు Optimiumను రీస్టార్ట్ చేయాలి.</translation>
<translation id="8376752431516546391">Google Search సైడ్ ప్యానెల్</translation>
<translation id="8236183484860169180">మీరు దాన్ని తీసివేయవలసిందిగా Optimium సిఫార్సు చేస్తోంది. <ph name="BEGIN_LINK" />సపోర్ట్ చేసే ఎక్స్‌టెన్షన్‌ల గురించి మరింత తెలుసుకోండి<ph name="END_LINK" /></translation>
<translation id="5920842078198979811">ఈ ఎక్స్‌టెన్షన్ పబ్లిషింగ్‌ను దాని డెవలపర్ రద్దు చేశారు, ఇది సురక్షితం కాకపోవచ్చు. Optimium నుండి దాన్ని తీసివేయండి, తద్వారా ఇది మీ వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="8406687098231754303">టూల్‌బార్‌లోని "సైడ్ ప్యానెల్‌లో Google Search" బటన్ నుండి, మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి సైడ్ ప్యానెల్‌లో Google Searchను మళ్లీ తెరవవచ్చు</translation>
<translation id="2185697372454035703">మీ Google ఖాతాలో కొంత డేటాను సేవ్ చేయడానికి, దాన్ని మీ డివైజ్‌లన్నింటిలో ఉపయోగించుకోవడానికి ముందు Optimium ఇది మీరేనని వెరిఫై చేయాలి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా తొలగించబడుతుంది.</translation>
<translation id="4724639108574581385">{0,plural, =1{ఒక రోజులోపు Optimiumను తిరిగి ప్రారంభించండి}other{# రోజులలోపు Optimiumను తిరిగి ప్రారంభించండి}}</translation>
<translation id="8438543370129609977">మీరు ఇమేజ్ సెర్చ్‌ను ఉపయోగించడం ద్వారా, PDFలతో పాటు పేజీ టైటిల్, URL, ఇంకా కంటెంట్ సర్వర్‌కు పంపబడతాయి. <ph name="LEARN_MORE" /></translation>
<translation id="3557945352384776441">Optimiumలో ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడం గురించి మరింత తెలుసుకోండి</translation>
<translation id="6672310590031980518">ఇన్‌స్టాలర్ ఆర్కైవ్ పాడైంది లేదా చెల్లదు. దయచేసి Optimiumను మళ్లీ డౌన్‌లోడ్ చేయండి.</translation>
<translation id="8463672209299734063">ఆప్షనల్: Googleకు సమస్య విశ్లేషణ, అలాగే వినియోగ డేటాను ఆటోమేటిక్‌గా పంపడం ద్వారా ChromiumOS ఫీచర్‌లను, ఇంకా పనితీరును మెరుగుపరచడంలో సహాయపడండి.</translation>
<translation id="3954441584666499211">మీ Google ఖాతాలో Optimium డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి, ఇది మీరేనని వెరిఫై చేయండి</translation>
<translation id="8482493977473846331">Chromiumకు సైన్ ఇన్ చేయడానికి ప్రాంప్ట్‌లను చూపిస్తుంది</translation>
<translation id="8202428378580208719">Optimium కాలం చెల్లినది</translation>
<translation id="850264194101621529">మీ ఆటోమేటిక్ బ్రౌజర్‌గా Chromiumను ఎంచుకున్నందుకు ధన్యవాదాలు!</translation>
<translation id="8520489851087523435">Google Search సైడ్ ప్యానెల్‌ను మళ్లీ తెరవండి</translation>
<translation id="8522801943730206384">మీరు వాటిని సేవ్ చేసినప్పుడు Chromium మీ పాస్‌వర్డ్‌లను చెక్ చేయగలదు</translation>
<translation id="8525579356836940628">ఇన్‌స్టాలేషన్ ఆగిపోయింది</translation>
<translation id="8984919429007493543">మీ <ph name="DEVICE_TYPE" />‌లోని Optimium యాప్‌తో మీ పాస్‌వర్డ్‌లు, ట్యాబ్‌లు, మరిన్నింటిని ఎక్కడికైనా మీతో పాటు తీసుకెళ్లండి</translation>
<translation id="8555465886620020932">సర్వీస్ ఎర్రర్: <ph name="SERVICE_ERROR" />.</translation>
<translation id="3963774984615461205">కొన్ని Optimium ఫీచర్‌లు, ఎక్స్‌టెన్షన్‌లు షార్ట్‌కట్‌లతో వస్తాయి. మీరు వాటిని తిరిగి ఆన్ చేయడాన్ని ఎంచుకోవచ్చు.</translation>
<translation id="8556420416730706394">సులభంగా యాక్సెస్ చేయడం కోసం మీరు ఇమేజ్ సెర్చ్‌ను పిన్ చేయవచ్చు; సైడ్ ప్యానెల్‌లో ఎగువున ఉన్న 'పిన్ చేయండి' బటన్‌ను క్లిక్ చేయండి</translation>
<translation id="8564408666201523086">విజయవంతమైంది! ఇకపై మీరు సైడ్ ప్యానెల్‌లో Google Searchతో బ్రౌజ్ చేస్తున్నప్పుడే సులభంగా ప్రశ్నలు అడగవచ్చు</translation>
<translation id="856656450041460113">భాష లిస్ట్‌ను సెర్చ్ చేయండి</translation>
<translation id="8568499811906962479">మీరు బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడిగేందుకు Google Search ప్యానెల్‌ను పిన్ చేయవచ్చు</translation>
<translation id="2996904635986800713">పలు సంస్థలు Optimiumను మేనేజ్ చేస్తాయి</translation>
<translation id="8586442755830160949">కాపీరైట్ <ph name="YEAR" /> Chromium రచయితలు. అన్ని హ‌క్కులు రిజ‌ర్వ్ చేయ‌బ‌డ్డాయి.</translation>
<translation id="8590782867495422699">Google Search AI మోడ్‌ను మళ్లీ తెరవండి</translation>
<translation id="2446482746737130055">Optimiumని ప్రారంభిస్తోంది...</translation>
<translation id="8624541899164515475">సెట్టింగ్‌లు, కొత్త ట్యాబ్‌లో తెరుచుకుంటాయి.</translation>
<translation id="8648201657708811153">Chrome for Testingను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయడం సాధ్యపడదు.</translation>
<translation id="9172606645924379921">Optimiumతో ఎక్కడి నుండైనా సెర్చ్ చేయండి</translation>
<translation id="8689408573494410517">టూల్‌బార్‌లోని "సైడ్ ప్యానెల్‌లో Google Search" బటన్‌కు కొత్త చిహ్నం ఉంది. సైడ్ ప్యానెల్‌లో Google Searchతో బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి దాన్ని క్లిక్ చేయండి.</translation>
<translation id="5596132704047725626">ఇది మీరు Optimiumను ప్రారంభించేటప్పుడు లేదా ఓమ్నిబాక్స్ నుండి వెతికేటప్పుడు చూపబడే పేజీని కూడా నియంత్రిస్తుంది.</translation>
<translation id="567010981548424498">ఈ ట్యాబ్‌ను మరొక డివైజ్‌కు పంపడానికి, అక్కడ Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="4758459198907306138">ఇది మీ Optimium</translation>
<translation id="8712637175834984815">అర్థమైంది</translation>
<translation id="5293592838971423777">Optimiumకు సైన్ ఇన్ చేయాలా?</translation>
<translation id="8747073452963259673">సెర్చ్ ఏరియాకు దిగువ ఎడమ మూలన: ఎడమ వైపు <ph name="LEFT" />%, దిగువ <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">ఇన్‌స్టలేషన్ ఎర్రర్: మీ నెట్‌వర్క్ అడ్మినిస్ట్రేటర్ ఇన్‌స్టాలేషన్‌ను నిరోధించే గ్రూప్ పాలసీని వర్తింపజేశారు: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">నాకు తర్వాత గుర్తు చేయి</translation>
<translation id="8601403845093292651">త్వరగా ఓవర్‌వ్యూ పొందడానికి, ఫాలో-అప్ ప్రశ్నలు అడగడానికి, Optimium లోని Gemini తో ఈ డాక్యుమెంట్‌ను షేర్ చేయండి</translation>
<translation id="3011694712607672183">Optimiumకు సైన్ ఇన్ చేయాలా?</translation>
<translation id="8823401858233292222">Chromiumను ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసి, టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="8826492472752484139">“Password Manager”ను క్లిక్ చేయండి</translation>
<translation id="8833697763442816810">ChromiumOS సిస్టమ్</translation>
<translation id="8852026904190808918">Chromiumలో మెనూలు, సెట్టింగ్‌లు, అలర్ట్‌లు, ఇతర టెక్స్ట్‌ను డిస్‌ప్లే చేయడానికి ఈ భాష ఉపయోగించబడుతుంది</translation>
<translation id="8862326446509486874">సిస్టమ్-స్థాయిలో ఇన్‌స్టాల్‌ చేయ‌డానికి మీకు సరైన హక్కులు లేవు. నిర్వాహకుడి లాగా ఇన్‌స్టాలర్‌ను మ‌ళ్లీ రన్ చేయ‌డానికి ప్రయత్నించండి.</translation>
<translation id="8400219074131043686">Optimium ప్రొఫైల్‌ను జోడించండి</translation>
<translation id="3471339840299959661">సైన్-ఇన్ చేయడంలో ఎర్రర్ వచ్చింది. అందువల్ల ChromiumOS మీ Google ఖాతాలో Optimium డేటాను సేవ్ చేయలేకపోయింది</translation>
<translation id="8161120518458367008">మీ సంస్థ పాలసీ ప్రకారం మీరు Optimiumకు సైన్ ఇన్ చేయాలి</translation>
<translation id="8897637834206928776">కొత్త చిహ్నం, అదే షార్ట్‌కట్: మీరు సైడ్ ప్యానెల్‌లో Google Searchతో బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి క్లిక్ చేయండి.</translation>
<translation id="3459877940554598369">Optimiumకు Windows 10 వెర్షన్ 1809 లేదా అంతకంటే కొత్త వెర్షన్ అవసరం.</translation>
<translation id="4176797355456373725">Optimium పాస్‌వర్డ్‌లను చూపడానికి ప్రయత్నిస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="8300184335948277828">Optimium ఇకపై మీ ఆటోమేటిక్ బ్రౌజర్‌గా ఉండదు. Optimiumను ఆటోమేటిక్ బ్రౌజర్‌గా చేయాలా?</translation>
<translation id="8365648631713891786">Optimiumని అప్‌డేట్ చేయడం సాధ్యం కాదు</translation>
<translation id="8944232836376404813">ఈ చర్య కారణంగా:
          <ph name="LINE_BREAKS" />
            • మీ ప్రారంభ పేజీ, కొత్త ట్యాబ్ పేజీ, సెర్చ్ ఇంజిన్, పిన్ చేసిన ట్యాబ్‌లు రీసెట్ చేయబడతాయి
            <ph name="LINE_BREAK" />
            • ఎక్స్‌టెన్షన్‌లు డిజేబుల్ చేయబడతాయి
            <ph name="LINE_BREAK" />
            • కుక్కీలు, ఇతర తాత్కాలిక సైట్ డేటాను తొలగించడం జరుగుతుంది
            <ph name="LINE_BREAKS" />
            బుక్‌మార్క్స్, హిస్టరీ, ఇంకా సేవ్ అయిన పాస్‌వర్డ్‌లు ప్రభావితం కావు.</translation>
<translation id="4517341657960407384">Optimium సైట్ షార్ట్‌కట్‌లను చూడండి</translation>
<translation id="6334459924587075942">Optimium Enterprise లోగో</translation>
<translation id="1013608620694172987">మీ <ph name="DEVICE_TYPE" />‌లోని Optimium యాప్‌తో Google భద్రతను ఎక్కడికైనా మీతో పాటు తీసుకెళ్లండి.</translation>
<translation id="6377692339934065652">మీ ప్రొఫైల్‌ను తెరుస్తున్నప్పుడు ఏదో పొరపాటు జరిగినందున Optimiumను ప్రారంభించడం సాధ్యపడలేదు. Optimiumను రీస్టార్ట్ చేయడానికి ట్రై చేయండి.</translation>
<translation id="8411734418760705455">Optimiumతో సెర్చ్ చేయడానికి లేదా <ph name="BEGIN_LINK" />సెట్టింగ్స్‌<ph name="END_LINK" />లో అనుకూలంగా మార్చడానికి</translation>
<translation id="4403836439014450645">Optimium ప్రొఫైళ్లను మేనేజ్ చేయండి</translation>
<translation id="7714694033208252813">Optimiumలోని Gemini, మీరు తెరిచిన ట్యాబ్ మధ్య నావిగేట్ చేయడానికి మీ కీబోర్డ్‌ను ఉపయోగించండి.</translation>
<translation id="9018218886431812662">ఇన్‌స్టాలేషన్ పూర్తయింది</translation>
<translation id="4028461118515168614">Optimiumని సురక్షితం చేయడానికి, మేము కింది ఎక్స్‌టెన్షన్‌ను నిలిపివేసాము, ఇది <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />లో లిస్ట్‌ చేయబడలేదు మరియు మీకు తెలియకుండా జోడించబడి ఉండవచ్చు.</translation>
<translation id="8853260188791570953">Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="6769418925691762561">Mac మెనూ బార్‌లో Optimiumతో సెర్చ్‌ను చూపించి, కీబోర్డ్ షార్ట్‌కట్‌ను ఆన్ చేయండి</translation>
<translation id="1582160730719680639">ఈ డౌన్‌లోడ్‌ను Optimium బ్లాక్ చేసింది, ఎందుకంటే ఆ ఆర్కైవ్ ఫైల్‌లో మాల్‌వేర్‌ను దాచి ఉంచగల ఇతర ఫైల్స్ ఉన్నాయి</translation>
<translation id="136372829312763612">మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, హిస్టరీని డివైజ్‌లన్నింటిలో పర్‌ఫెక్ట్‌గా సింక్ చేసి ఉంచుకోండి. మీ ఆటోమేటిక్ బ్రౌజర్‌ను Optimiumకు అప్‌డేట్ చేయడం ద్వారా మీకు తెలిసిన, మీరు ఇష్టపడే ఫీచర్‌లను సులభంగా యాక్సెస్ చేయండి. క్విక్ యాక్సెస్ కోసం Optimium మీ టాస్క్‌బార్‌కు పిన్ చేయబడుతుంది.</translation>
<translation id="4121763951659864948">మీ ఫోన్‌లోని Optimium యాప్‌తో Googleకు చెందిన అత్యుత్తమ AI టూల్స్‌ను ఉపయోగించుకోండి</translation>
<translation id="570680773394181802"><ph name="DEVICE" /> నుండి మీ పాస్‌వర్డ్‌లను, మరిన్నింటిని పొందడానికి, Optimiumకు సైన్ ఇన్ చేయండి</translation>
<translation id="9062666675513499497">మీరు ఇతర Google సర్వీస్‌లకు సైన్ ఇన్ చేసినప్పుడు Chromiumకి సైన్ ఇన్ చేయండి</translation>
<translation id="9074041031320636790">విజయవంతమైంది! ఇకపై మీరు Google Search AI మోడ్‌తో బ్రౌజ్ చేస్తున్నప్పుడే సులభంగా ప్రశ్నలు అడగవచ్చు</translation>
<translation id="9074163480955555019">కొత్త చిహ్నం, అదే షార్ట్‌కట్: మీరు Chromeలో Google Searchతో బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి క్లిక్ చేయండి.</translation>
<translation id="516400912738056453">Optimium ఆటోమేటిక్‌గా మూసివేయబడింది</translation>
<translation id="807899198682302888">Optimium కాలం చెల్లినది</translation>
<translation id="4711199283523757502">{0,plural, =1{ఒక గంటలో Optimium తిరిగి ప్రారంభించబడుతుంది}other{# గంటల్లో Optimium తిరిగి ప్రారంభించబడుతుంది}}</translation>
<translation id="9106236359747881194">సెర్చ్ చేయడానికి టెక్స్ట్‌ను ఎంచుకోండి</translation>
<translation id="8368867604698561866">భవిష్యత్తులో Optimium అప్‌డేట్‌లను పొందడానికి, మీకు Windows 10 లేదా ఆ తర్వాత వచ్చిన ఏదైనా వెర్షన్ అవసరం అవుతుంది. ఈ కంప్యూటర్ Windows 8.1ను ఉపయోగిస్తోంది.</translation>
<translation id="4437683009835184797">కొత్త Optimium &amp;ట్యాబ్‌లో లింక్‌ని తెరువు</translation>
<translation id="911206726377975832">మీ బ్రౌజింగ్ డేటాను కూడా తొలగించాలా?</translation>
<translation id="9118146721060781133">టూల్‌బార్‌లోని "సందర్భోచితమైన టాస్క్‌లు" బటన్‌కు కొత్త చిహ్నం ఉంది. మీరు సందర్భోచితమైన టాస్క్‌లతో బ్రౌజ్ చేస్తున్నప్పుడు ప్రశ్నలు అడగడానికి దాన్ని క్లిక్ చేయండి.</translation>
<translation id="9134482777260927479">హోమ్‌వర్క్‌లో సహాయం</translation>
<translation id="9148058034647219655">నిష్క్రమించండి</translation>
<translation id="3295815393935110309">మీరు ఆపివేసిన చోట నుండి కొనసాగించండి: మీరు రీస్టార్ట్ చేసిన ప్రతిసారీ Optimium మీ ట్యాబ్‌లను రీస్టోర్ చేయగలదు. దీన్ని ఆన్ చేయడానికి, వీటికి వెళ్లండి</translation>
<translation id="5167935114017057528"><ph name="TARGET_URL_HOSTNAME" />‌ను యాక్సెస్ చేయడం కోసం ఒక ప్రత్యామ్నాయ బ్రౌజర్‌ను తెరిచే విధంగా Optimiumను మీ సిస్టమ్ నిర్వాహకులు కాన్ఫిగర్ చేశారు.</translation>
<translation id="903669083727317908">&amp;Optimiumను అప్‌డేట్ చేయడానికి రీ-లాంచ్ చేయండి</translation>
<translation id="1256233032126781893">Optimium (mDNS-In)</translation>
<translation id="6225435091563451277">Optimiumను మీకు అనుకూలంగా ఉండే విధంగా వ్యక్తిగతీకరించుకోండి</translation>
<translation id="1987988401118534091">Optimiumకి ఇప్పుడు Windows XP లేదా Windows Vistaలో మద్దతు లేనందున ఇది సరిగ్గా పని చేయకపోవచ్చు</translation>
<translation id="8102971646278891292">ప్రయాణంలోనూ Google అత్యుత్తమ భద్రతా ఫీచర్‌లను Optimiumతో పొందండి.</translation>
<translation id="945522503751344254">ఫీడ్‌బ్యాక్ పంపండి</translation>
<translation id="225981349930289899">Optimiumను ఎవరు ఉపయోగిస్తున్నారు?</translation>
<translation id="2788235168912697021">Optimium అత్యంత సురక్షితమైన సెక్యూరిటీని పొందండి</translation>
<translation id="983803489796659991">అప్‌డేట్ సర్వర్‌లో అప్లికేషన్ కోసం హ్యాష్ డేటా లేనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="802168381040095988">ఖాతా లేకుండా Optimiumను ఉపయోగించండి</translation>
<translation id="985602178874221306">Chromium రచయితలు</translation>
<translation id="989970834842471429">"ఇమేజ్ సెర్చ్‌"తో సెర్చ్ చేయడానికి టెక్స్ట్‌ను లేదా ఇమేజ్‌ను ఎంచుకోండి</translation>
<translation id="992780518932311116">మీ లొకేషన్‌ను ఉపయోగించడానికి, <ph name="BEGIN_LINK" />సిస్టమ్ సెట్టింగ్‌ల<ph name="END_LINK" />‌లో Chromiumకు యాక్సెస్ ఇవ్వండి</translation>
</translationbundle>

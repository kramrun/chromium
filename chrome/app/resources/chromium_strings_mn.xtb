<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="mn">
<translation id="1026101648481255140">Үргэлжлүүлэн суулгах</translation>
<translation id="1029669172902658969">&amp;ChromiumOS-г шинэчлэхийн тулд дахин ачаална уу</translation>
<translation id="4063809399345498325">Optimium танд энэ өргөтгөлийг шалгахыг зөвлөж байна</translation>
<translation id="1042552502243217427">Сайт өөрийн хуудсан дээр холбооснуудыг нууцлалтайгаар урьдчилан ачаалахыг хүсэхэд Chromium Google-н серверүүдийг ашиглана. Энэ нь таны таниулбарыг урьдчилан ачаалсан сайтаас нуух ч Google ямар сайтуудыг урьдчилан ачаалдгийг мэдэж авна.</translation>
<translation id="1051793555070215510">Бидэнд энэ 1 минутын судалгааг бөглөж Нууцлалтай горимыг сайжруулахад тусална уу.</translation>
<translation id="1065672644894730302">Таны хүсэлтийг уншиж чадахгүй байна.

Зарим үйлдлүүд нь боломжгүй байж магадгүй бөгөөд сонголтонд хийсэн өөрчлөлтүүд хадгалагдахгүй.</translation>
<translation id="7250992450852052182">Таны эцэг эх Optimium-н "Сайт, апп болон өргөтгөлүүдийн зөвшөөрөл"-ийг унтраасан байна</translation>
<translation id="6711838932294803312">Optimium-д ойролцоох төхөөрөмжүүдийг олж, ашиглахын тулд таны дотоод сүлжээнд хандах эрх шаардлагатай</translation>
<translation id="2807920805712601449">Optimium-н тодорхой онцлог, өргөтгөлийг хайхын тулд хаяг оруулах хэсэгт товчлолыг нь сонгосон товчлуурт гарын товчийн хамт шивж оруулна уу</translation>
<translation id="5994612110840535151">Системийн жижиг тэмдэг бүхий хэсэгт Optimium дахь хайлтыг харуулж, гарын товчлолыг асаагаарай</translation>
<translation id="7212528213853025915">Optimium таны нууц үгийг экспортлох хүсэлтэй байна. Үүнийг зөвшөөрч байгаа бол Windows-н нууц үгээ оруулна уу.</translation>
<translation id="112640046208448578">Зүйл болон газрыг таньж, текст хуулж эсвэл орчуулна. Таныг Зурган хайлтыг ашиглахад хуудасны дэлгэцийн агшныг сервер лүү илгээнэ. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium таны өгөгдмөл хөтөч</translation>
<translation id="1131805035311359397">Нууц үгнүүддээ өгөгдлийн зөрчил болон аюулгүй байдлын өөр асуудал байхгүй болохыг шалгахын тулд <ph name="BEGIN_LINK" />Chromium-д нэвтэрнэ үү<ph name="END_LINK" />.</translation>
<translation id="3458316367708035110">{COUNT,plural, =1{Танай администратор энэ шинэчлэлтийг хэрэгжүүлэхийн тулд танаас Optimium-г дахин ачаалахыг хүсэж байна. Нууцлалтай, тусгаарласан цонх нээлттэй байна. Дахин ачаалсны тань дараа энэ цонх ахин нээгдэхгүй.}other{Танай администратор энэ шинэчлэлтийг хэрэгжүүлэхийн тулд танаас Optimium-г дахин ачаалахыг хүсэж байна. Профайлууд дээр нууцлалтай, тусгаарласан # цонх нээлттэй байна. Дахин ачаалсны тань дараа эдгээр цонх ахин нээгдэхгүй.}}</translation>
<translation id="1150418667633096194">Хэрэгслийн мөр дээрх "Google Хайлтын хажуугийн самбар" товч шинэ дүрс тэмдэгтэй боллоо. Google Хайлтын хажуугийн самбараар үзэх явцдаа асуулт асуухын тулд үүн дээр товшино уу.</translation>
<translation id="759898790519515623">Optimium цэсийг товшино уу</translation>
<translation id="1157952955648710254">Google Хайлтын хажуугийн самбарыг хаана уу</translation>
<translation id="1157985233335035034">Саяхан сонгосон хэлнүүд</translation>
<translation id="1184145431117212167">Таны Windows-н хувилбарыг дэмждэггүй тул суулгаж чадсангүй.</translation>
<translation id="1185134272377778587">Chromium-ийн тухай</translation>
<translation id="5987505065981917957">Утсан дээрээ Optimium-р үнэ мөшгөх мэдэгдэл аваарай</translation>
<translation id="1203500561924088507">Суулгасанд баярлалаа. Та <ph name="BUNDLE_NAME" />-г ашиглахаасаа өмнө хөтчөө дахин эхлүүлэх ёстой.</translation>
<translation id="1232234696885483911">Таныг Зурган хайлтыг нээхэд хуудасны гарчиг, URL болон PDF зэрэг контентыг сервер лүү автоматаар илгээнэ. <ph name="LEARN_MORE" /></translation>
<translation id="3560913454241378492">Та нэвтэрсэн байхдаа Optimium-д Google Бүртгэлээсээ нууц үг болон бусад зүйлээ ашиглах боломжтой. Үүнийг өөрчлөхийн тулд “Optimium дахь таны бүртгэл” рүү очно уу.</translation>
<translation id="8922965532693587493">Mac-н цэсийн мөрд Optimium дахь Gemini-г харуулах</translation>
<translation id="236433590733312836">Optimium дахь Gemini-д дэлгэцийн хэсгийг сонгохын тулд товчлуурын шууд холбоосыг ашиглана уу.</translation>
<translation id="7976124325589452515">Энэ табыг идэвхгүй үед Optimium-г хурдан байлгахын тулд санах ойг чөлөөлсөн. Та энэ сайтыг идэвхгүй болохоос үргэлж хасахаар сонгох боломжтой.</translation>
<translation id="2758503437544511902">Энэ файл аюултай тул Optimium энэ таталтыг блоклосон</translation>
<translation id="126567311906253476"><ph name="USER_EMAIL" />-р Gmail эсвэл YouTube зэрэг Google-н үйлчилгээнд нэвтрэх үед та тухайн бүртгэлээр Chromium-д автоматаар нэвтрэх боломжтой</translation>
<translation id="4104061172701635162">Утсан дээрээ Optimium-г аваарай</translation>
<translation id="1290883685122687410">Тохируулгын алдаа: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="3443894627866827446">Optimium-н шинэ профайлаа тохируулах</translation>
<translation id="8946186262159916495">Optimium дахь Gemini-р туршиж үзэх</translation>
<translation id="7981347318091963592">Optimium-д Bluetooth төхөөрөмжүүдийг судлахад
 Bluetooth-н хандалт шаардлагатай. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6099322702899630168">Утсан дээрээ Optimium-д нэвтрэх</translation>
<translation id="1330562121671411446">Хэл илрүүлэх</translation>
<translation id="3294414641786025647">Мөн Optimium-с өгөгдөл устгах (<ph name="URL" />)</translation>
<translation id="4214354213779528068">{COUNT,plural, =1{Дэвшилтэт хамгаалалт шинэчлэлт хэрэгжүүлэхийн тулд танаас Optimium-г дахин ачаалахыг шаардаж байна. Нууцлалтай, тусгаарласан цонх нээлттэй байна. Дахин ачаалсны тань дараа энэ цонх ахин нээгдэхгүй.}other{Дэвшилтэт хамгаалалт шинэчлэлт хэрэгжүүлэхийн тулд танаас Optimium-г дахин ачаалахыг шаардаж байна. Профайлууд дээр нууцлалтай, тусгаарласан # цонх нээлттэй байна. Дахин ачаалсны тань дараа эдгээр цонх ахин нээгдэхгүй.}}</translation>
<translation id="1345251407431278948">Бэхэлсэн! Та Зурган хайлтад самбар дээрх шинэ товчоос дахин хандах боломжтой</translation>
<translation id="1383876407941801731">Хайлт</translation>
<translation id="7825299065989465359">Явж байх зуураа үргэлжлүүлэн үзэхийн тулд Optimium аппыг ашиглаарай</translation>
<translation id="141901961143729572">Бодол санаагаа хуваалц</translation>
<translation id="1438812738230833934">Та үзэх явцдаа асуулт асуухын тулд хажуугийн самбар дахь Google Хайлтыг дахин нээх боломжтой</translation>
<translation id="4131307166987455854">Цонхоо хуваалцахын тулд Системийн тохиргоонд Optimium-д дэлгэцийн үйлдэл бичихийг зөвшөөрнө үү.</translation>
<translation id="1470136641087909499">Та үзэх явцдаа асуулт асуухын тулд Chrome дахь Google Хайлтыг дахин нээх боломжтой</translation>
<translation id="1478370723027452770">Chrome for Testing-р тусламж авах</translation>
<translation id="9200022682397754538"><ph name="DEVICE" />-с хадгалсан мэдээлэл болон бусад зүйлээ авахын тулд Optimium-д нэвтэрнэ үү</translation>
<translation id="1497802159252041924">Суулгалтын алдаа: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Энэ хуудсыг хамгаалагдсан байна</translation>
<translation id="892690000529877604">Optimium-н таб хуваалцах</translation>
<translation id="15408169957028265">Chrome дахь Google Хайлтыг дахин нээх</translation>
<translation id="9039191226880557963">Optimium-д нэвтрэх</translation>
<translation id="1547469039832541117">Тодруулсан ажлыг дуусгана.</translation>
<translation id="4414991100979797293">Optimium-г бэхлэх</translation>
<translation id="1574377791422810894">Chromium-н аюулгүй байдлын хэрэгсэл</translation>
<translation id="3934587628489930735">Optimium таны Нууц үгний менежерийн өгөгдлийг устгахыг хүсэж байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="6745390171113033635">{COUNT,plural, =0{Шинэчлэлтийг хэрэгжүүлэхийн тулд Optimium-г дахин ачаалахыг таны администратор танаас шаардаж байна}=1{Шинэчлэлтийг хэрэгжүүлэхийн тулд Optimium-г дахин ачаалахыг таны администратор танаас шаардаж байна. Таны нууцлалтай цонхыг дахин нээхгүй.}other{Шинэчлэлтийг хэрэгжүүлэхийн тулд Optimium-г дахин ачаалахыг таны администратор танаас шаардаж байна. Таны # нууцлалтай цонхыг дахин нээхгүй.}}</translation>
<translation id="7186551909256266009">Утсан дээрээ Optimium аппаар Google-н шилдэг зүйлсийг аваарай</translation>
<translation id="1625909126243026060">Chromium-н нууцлал болон аюулгүй байдлын үндсэн хяналтуудыг шалгана уу</translation>
<translation id="1640672724030957280">Татаж байна...</translation>
<translation id="1648201623125974721">Шинэ дүрс тэмдэг, ижил товчлол: Хам сэдэвт даалгавраар үзэх явцдаа асуулт асуухын тулд товшино уу.</translation>
<translation id="1665602916345474427"><ph name="USER_NAME" /> <ph name="USER_EMAIL" />-р гишүүнчлэлийн эрхтэйгээр нэвтэрсэн. Бүртгэлийн цэсийг нээх</translation>
<translation id="1708414395296835197">Та мессеж, баримт бичиг болон бусад апп дахь холбоосон дээр товших бүрдээ Chromium-г ашиглах боломжтой. Үүнийг мөн таны ажлын хэсэгт бэхэлнэ.</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME" />-н нэмэлт эрхээр хангадаг.</translation>
<translation id="1722488837206509557">Энэ нь танд боломжтой төхөөрөмжүүд сонгож, тэдгээр төхөөрөмжид контент үзүүлэх боломжийг олгоно.</translation>
<translation id="6717880500969720524">Optimium удахгүй интернэтээр үзсэн өгөгдлийг устгана</translation>
<translation id="1736443181683099871">Chromium навигацуудыг HTTPS болгож сайжруулахаар оролдоно</translation>
<translation id="4418738262462299802">Optimium-н өгөгдлийг устгасан</translation>
<translation id="8469746761106187775">Optimium-г <ph name="REMAINING_TIME" />-н дараа дахин эхлүүлнэ</translation>
<translation id="1749104137266986751">HTTPS боломжгүй үед Chromium танд сануулалгүйгээр аюултай холболт ашиглана</translation>
<translation id="1769661297620183092">Та үзэх явцдаа асуулт асуухын тулд Google Хайлтын самбарыг дахин нээх боломжтой</translation>
<translation id="6555789357989792722">Optimium-ыг арын орчинд ажиллуулах</translation>
<translation id="627441522449241646">Optimium аюулгүй байдлыг нэмэгдүүлэхийн тулд бид <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ны жагсаалтад байхгүй бөгөөд танд мэдэгдэлгүйгээр нэмэгдсэн байж болзошгүй зарим өргөтгөлүүдийг идэвхгүй болгосон.</translation>
<translation id="1912380661217770781">Optimium-г ажлын хэсэгтээ бэхэлж, шуурхай хандахын тулд Windows-н мэдэгдэл дэх <ph name="BEGIN_BOLD" />Тийм<ph name="END_BOLD" /> дээр товшино уу</translation>
<translation id="9034578483087384251">Optimium-ыг дахин суулгах</translation>
<translation id="2856362667064664106">Optimium <ph name="AUTHENTICATION_PURPOSE" /> оролдож байна</translation>
<translation id="1665590461646883113"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд Optimium-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү. Та мөн <ph name="DEVICE" />-с өргөтгөл болон бусад зүйлээ авна.</translation>
<translation id="1668665535355826445">Та дараагийн удаа <ph name="DEVICE_TYPE" /> дээрээ Optimium-г нээхдээ Google Нууц үгний менежерийг ашиглах сануулга харна.</translation>
<translation id="1838374766361614909">Хайлтыг арилгах</translation>
<translation id="8674417702521959187">Интернэтээр үзсэн өгөгдлөө Google Бүртгэлдээ үлдээж, зөвхөн энэ төхөөрөмжөөс устгахын тулд <ph name="BEGIN_LINK" />Optimium-с гарна уу<ph name="END_LINK" />.</translation>
<translation id="6186721318460238018">Явж байх зуураа шинэ табын бүлэг нээх эсвэл үүсгэхийн тулд утсан дээрээ Optimium-г татаарай.</translation>
<translation id="185970820835152459">Та нэвтэрсэн Google Бүртгэлүүдээ удирдах боломжтой. Таны Google Бүртгэлүүдийг Chromium хөтөч, Play Store, Gmail болон бусад дээр ашигладаг. Хэрэв та гэр бүлийн гишүүн зэрэг өөр хэн нэгний бүртгэлийг нэмэхийг хүсвэл оронд нь өөрийн <ph name="DEVICE_TYPE" />-д шинэ хүн нэмнэ үү. <ph name="LINK_BEGIN" />Нэмэлт мэдээлэл авах<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Зурган хайлтаар хайх</translation>
<translation id="1781731701613313704"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд Optimium-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү. Та мөн <ph name="DEVICE" />-с хавчуурга болон бусад зүйлээ авна.</translation>
<translation id="1880677175115548835">Текст сонгох</translation>
<translation id="5960850334733792580">Та удирдлагатай бүртгэл рүү нэвтрэн орсноор түүний админд нь өөрийн Optimium-ын хувийн мэдээллийг удирдах эрхийг олгож байна гэсэн үг юм. Таны Optimium-ын мэдээлэл, аппликейшн, хайлтын жагсаалт, түүх, нууц үг болон бусад тохиргоонууд <ph name="USER_NAME" /> руу нэгдэх болно. Та энэ мэдээллийг Google-ийн Хяналтын самбарыг ашиглан устгаж болох хэдий ч энэ мэдээллийг өөр данс руу нэгтгэж чадахгүй. Та одоо байгаа Optimium-ын мэдээллийг тусад нь хадгалахын тулд шинэ хувийн мэдээлэл үүсгэж болно. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Chromium саадгүй гүйлгэх, видеоны фреймийн хурд зэрэг арын үйл ажиллагаа болон визуал эффектийг хязгаарласнаар батарейн цэнэгийг хэмнэнэ. <ph name="BEGIN_LINK" />Эрчим хүч хэмнэгчийн талаар нэмэлт мэдээлэл авах<ph name="END_LINK" /></translation>
<translation id="7900167719031567542">Optimium Шинэчлэгч үйлчилгээ</translation>
<translation id="1911763535808217981">Үүнийг унтрааснаар та Gmail зэрэг Google-н сайтуудад Chromium-д нэвтрэлгүйгээр нэвтэрч болно</translation>
<translation id="5015349619125768393">Optimium ажиллахгүй байна. Дахин эхлүүлэх үү?</translation>
<translation id="2019000760486664637">Танай байгууллага болох <ph name="MANAGER" /> таныг Optimium-д нэвтрэхийг шаардаж байна</translation>
<translation id="193439633299369377">Шинэчлэлтийг хэрэгжүүлэхийн тулд ChromiumOS-г дахин эхлүүлэх шаардлагатай.</translation>
<translation id="3382368450324191331">Файлын төрлийг ихэвчлэн татдаггүй бөгөөд энэ нь аюултай байж магадгүй тул Optimium энэ таталтыг блоклосон</translation>
<translation id="1953553007165777902">Татаж байна... <ph name="MINUTE" /> минут үлдсэн</translation>
<translation id="1966382378801805537">Chromium нь өгөгдмөл хөтчийг тодорхойлох эсвэл тохируулах боломжгүй</translation>
<translation id="197326043290947695">Зурган хайлтаар илүү ухаалгаар үзээрэй</translation>
<translation id="5321661580966500942">Optimium зарим файлыг яагаад блоклодог болохыг мэдэж авна уу, шинэ табд нээгдэнэ</translation>
<translation id="8960045458031480819">Таны Optimium программ хангамжийг хамгийн шинэ байлгана. Хэрэв энэ үйлчилгээг идэвхгүй болгосон эсвэл зогсоосон бол таны Optimium-н программ хангамж хамгийн шинэ байхгүй бөгөөд энэ нь аюулгүй байдлын гарч болзошгүй сул эмзэг байдлыг засах боломжгүй, мөн онцлогууд ажиллахгүй байж магадгүй гэсэн үг юм. Энэ үйлчилгээг ашигладаг Optimium-н программ хангамж байхгүй байхад энэ үйлчилгээ өөрийгөө устгана.</translation>
<translation id="2008474315282236005">Энэ нь төхөөрөмжөөс 1 зүйл устгана. Өгөгдлөө дараа сэргээхийн тулд Chromium-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="2018879682492276940">Суулгаж чадсангүй. Дахин оролдоно уу.</translation>
<translation id="2039417478970545937">Тохиргоо.</translation>
<translation id="2049376729098081731">Google-н үйлчилгээнүүдэд илүү хувийн болгосон туршлага авахын тулд Chromium-н түүхийг багтаах эсэхээ сонгоно уу</translation>
<translation id="4120951192672345208">Танд сайн нууц үг үүсгэх, хадгалах, автоматаар бөглөхөд туслахын тулд Optimium-д суурилуулсан. Хялбар хандахын тулд товчлолыг нэмээрэй.</translation>
<translation id="2060311596979880693">Амжилттай! Та одоо Chrome дахь Google Хайлтаар үзэх явцдаа асуулт хялбархан асуух боломжтой</translation>
<translation id="7165258062917217746">Optimium-д шинэ дүр төрх өгөхийн тулд Шинэ таб хуудсан дээрх Optimium-г тусгайлан өөрчлөх товчин дээр товшино уу</translation>
<translation id="3702823791268559760">Файл нь хуурамч бөгөөд таны төхөөрөмжид гэнэтийн өөрчлөлт хийж магадгүй тул Optimium энэ таталтыг блоклосон</translation>
<translation id="2370804817835146114">Та дараагийн удаа Optimium iOS-г нээхдээ <ph name="FEATURE_NAME" />-г туршиж үзэхийг сануулсан сануулга харна.</translation>
<translation id="5887094242311035059">Таны Google Бүртгэлдээ хадгалсан нууц үг болон Optimium-н бусад өгөгдлийг энэ төхөөрөмжөөс хасна. Тэдгээрийг Optimium-д дахин ашиглахын тулд буцаж нэвтэрнэ үү.</translation>
<translation id="8794268168383660193">{COUNT,plural, =1{Optimium-г 1 минутын турш ашиглаагүй үед танай байгууллага интернэтээр үзсэн өгөгдлийг автоматаар устгана. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно. Таны табууд нээлттэй хэвээр үлдэнэ.}other{Optimium-г # минутын турш ашиглаагүй үед танай байгууллага интернэтээр үзсэн өгөгдлийг автоматаар устгана. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно. Таны табууд нээлттэй хэвээр үлдэнэ.}}</translation>
<translation id="2125838419757773031">Хайх дэлгэцийн хэсэг сонгох</translation>
<translation id="2126108037660393668">Татсан файлын баталгаажуулалт амжилтгүй боллоо.</translation>
<translation id="2135919691573380097">Энэ сайтыг мэдээлэх</translation>
<translation id="2137162749895930932">Орчуулах дэлгэцийг хаах</translation>
<translation id="2147218225094845757">Хажуугийн самбарыг нуух</translation>
<translation id="8888656790178891761">Сайт аюулгүй холболт ашиглахгүй байгаа бөгөөд файлыг оролдсон байж магадгүй тул Optimium энэ таталтыг блоклосон</translation>
<translation id="2170098639895543546">Хуудсан дээрх дурын зүйлийг сонгоно уу</translation>
<translation id="6975401993318112971">Optimium-г өөрчлөх</translation>
<translation id="2174917724755363426">Суулгаж дуусаагүй байна. Та цуцлахдаа итгэлтэй байна уу?</translation>
<translation id="7741769305753410467">Optimium - Сүлжээнд нэвтрэх - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Шалгалтын алдааг шинэчлэх: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2133097742403140075">Optimium-с бүртгэл хасах</translation>
<translation id="6495056863394621013">Optimium аппыг ашиглан худалдан авалтын шилдэг хэрэгслүүдийг явж байх зуураа ашиглаарай</translation>
<translation id="2209877494277346829">Chromium-г бусад аппаас тусгаарлах</translation>
<translation id="2035198300681156782">iOS-т зориулсан Optimium дээрх Сайжруулсан аюулгүй хөтчийг ашиглан явж байх зуур илүү аюулгүй байгаарай</translation>
<translation id="2210682093923538346">Аюултай сайт. Chromium мэдэгдлүүдийг хассан.</translation>
<translation id="2236949375853147973">Миний үйл ажиллагаа</translation>
<translation id="871771486544954531">Хаяг болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Optimium-д нэвтэрнэ үү. Таныг нэвтэрсний дараа энэ хаягийг Google Бүртгэлд тань хадгална.</translation>
<translation id="524316078518338158">Хэрэв та компьютероо дундаа ашиглаж байгаа бол таны найз нөхөд, гэр бүл  тусдаа хайлт хийж,  өөрсдийн хүссэнээрээ Optimium-ыг тохируулж болно.</translation>
<translation id="22571759390241347">Chromium-н Ур чадвар</translation>
<translation id="2283228908180457226">Шинэ дүрс тэмдэг, ижил товчлол: Google Хайлтын хажуугийн самбараар үзэх явцдаа асуулт асуухын тулд товшино уу.</translation>
<translation id="2283803047247799269">Зурган хайлтаар энэ табаас хайх</translation>
<translation id="5808794606375505413">{NUM_TABS,plural, =1{Optimium таны хөтчийг удаашруулж буй табыг түр зогсоохыг зөвлөж байна}other{Optimium таны хөтчийг удаашруулж буй табуудыг түр зогсоохыг зөвлөж байна}}</translation>
<translation id="2307973900865360088">Суурилуулагчид байлгах</translation>
<translation id="2313870531055795960">URL-г Chromium-д хадгалсан аюултай сайтын жагсаалттай харьцуулж шалгадаг. Хэрэв сайт таны нууц үгийг хулгайлах гэж оролдвол эсвэл таныг аюултай файл татах үед Chromium нь хуудасны контентын зэрэг URL-г Аюулгүй хайлт руу мөн илгээж болзошгүй.</translation>
<translation id="2356070529366658676">Асуух</translation>
<translation id="2359808026110333948">Цааш</translation>
<translation id="7000103009822967939">"<ph name="EXTENSION_NAME" />" өргөтгөл таныг Optimium-д нэвтрэхийг хүсэж байна</translation>
<translation id="184381469736757112">Аппуудын хувьд Optimium-г дэвсгэрт ажиллуулахыг идэвхгүй болгох</translation>
<translation id="5141894774016157674">Энэ өргөтгөлийг <ph name="USER_EMAIL_ADDRESS" />-р ашиглахын тулд Optimium-д нэвтэрнэ үү.</translation>
<translation id="2384373936468275798">Таны бүртгэлийн нэвтрэх дэлгэрэнгүй мэдээлэл хуучирсан тул ChromiumOS таны өгөгдлийг синк хийж чадсангүй.</translation>
<translation id="2523694910556579068">{NUM_DEVICES,plural, =0{1 HID төхөөрөмжид нэг эсвэл түүнээс олон Optimium-н өргөтгөл хандаж байсан}=1{1 HID төхөөрөмжид нэг эсвэл түүнээс олон Optimium-н өргөтгөл хандаж байна}other{# HID төхөөрөмжид нэг эсвэл түүнээс олон Optimium-н өргөтгөл хандаж байна}}</translation>
<translation id="2899976927368522713">Optimium-д энэ сайтад зориулж камер болон микрофоны зөвшөөрөл шаардлагатай</translation>
<translation id="2403703063067034158">Эхлэхэд алдаа гарлаа: одоогоор тохируулгын өөр нэг инстанс ажиллаж байна. Дараа дахин оролдоно уу.</translation>
<translation id="8530786035410512232">Дурын аппаас холбоосыг Optimium-д нээж, хөтчийг ажлын хэсэгтээ хандах боломжтой байлгаарай</translation>
<translation id="5645058843566501763">Шуурхай тойм авах, араас нь лавлах асуулт асуухаар энэ баримт бичгийг Optimium дахь Gemini-тай хуваалцахын тулд Хураангуйлах товчин дээр товшино уу</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Chromium-н хэрэгслийн<ph name="END_LINK" /> тусламжтайгаар та аюулгүй үзэх болон хяналтыг гартаа байлгах боломжтой</translation>
<translation id="5384013849288198705"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд Optimium-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү. Та мөн бүх төхөөрөмж дээрээ нууц үг болон бусад зүйлээ авна.</translation>
<translation id="2451727308784734061">Нууц үгний менежерт шуурхай очихын тулд товчлолоо ашиглана уу. Та товчлолоо компьютерын үндсэн нүүр эсвэл апп байршуулагч руугаа зөөх боломжтой.</translation>
<translation id="4074322039453189342">Optimium-г удахгүй хаана</translation>
<translation id="4239399282729309306">Optimium-д</translation>
<translation id="2485422356828889247">Устгах</translation>
<translation id="2513154137948333830">Дахин асаах шаардлагатай: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2521391734665471391">Google Хайлтын ХОУ-ы горимыг хаах</translation>
<translation id="2542968102051442371">Зурган хайлтаар текст сонгоно уу</translation>
<translation id="7238239459452345825">Optimium одоо байгаа нууц үгнүүдийг солихоор оролдож байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="5059411697679064446">Файл татахын тулд Optimium-д сангийн хандалт шаардлагатай</translation>
<translation id="5959299320608819381">Optimium-ийн туслагч</translation>
<translation id="2575822587468774919">Зурган хайлтаар хайхыг хүссэн зүйлээ сонгоно уу</translation>
<translation id="8063772441784541423">Нууц үг болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Optimium-д нэвтэрнэ үү</translation>
<translation id="3112793931795471365">Optimium-г татаж, Google Бүртгэлдээ нэвтрэхийн тулд утсаараа QR кодыг скан хийнэ үү.</translation>
<translation id="1584670114556742260">Optimium-р хайхын тулд.</translation>
<translation id="2680687985294820735">Optimium-г үргэлжлүүлэн ашиглах</translation>
<translation id="259935314519650377">Татсан суулгагчийг завсрын санах ойд хадгалж чадсангүй. Алдаа: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Систем</translation>
<translation id="7753906894780562903">Танай байгууллага таны хавчуурга, түүх, нууц үг зэрэг интернэтээр үзсэн өгөгдлийг харж, удирдах боломжтой. Энэ нь Optimium-н бусад профайл дахь интернэтээр үзсэн өгөгдлийг харах боломжгүй</translation>
<translation id="3912526786507084695"><ph name="ACCOUNT_EMAIL" /> бүртгэлдээ Optimium-н өгөгдлөө ашиглах, хадгалахын тулд өөрийгөө мөн болохыг баталгаажуулна уу</translation>
<translation id="1723346026518998062">{COUNT,plural, =0{Дэвшилтэт хамгаалалт нь шинэчлэлтийг хэрэгжүүлэхийн тулд танаас Optimium-г дахин ачаалахыг шаарддаг}=1{Дэвшилтэт хамгаалалт нь шинэчлэлтийг хэрэгжүүлэхийн тулд танаас Optimium-г дахин ачаалахыг шаарддаг. Таны нууцлалтай цонх дахин нээгдэхгүй.}other{Дэвшилтэт хамгаалалт нь шинэчлэлтийг хэрэгжүүлэхийн тулд танаас Optimium-г дахин ачаалахыг шаарддаг. Таны нууцлалтай # цонх дахин нээгдэхгүй.}}</translation>
<translation id="1676939910504260523">Optimium-г эхлүүлэх</translation>
<translation id="4524556064279918264">Суулгалтын явцад үйлдлийн системийн алдаа гарлаа. Optimium-ыг дахин татаж авна уу.</translation>
<translation id="1998551382060432430">Хэрэв та төхөөрөмжийг дундаа ашигладаг бол найз нөхөд, гэр бүл тань хөтчөөр тусдаа үзэж, Optimium-г хүссэнээрээ тохируулах боломжтой</translation>
<translation id="5180414833025415316">Optimium-г жижгэрүүлсэн байсан ч төхөөрөмж дээрээ Optimium дахь Gemini-г ашиглахын тулд хялбархан хандаарай.</translation>
<translation id="5895170254499246640">Optimium таб</translation>
<translation id="2718390899429598676">Таны аюулгүй байдлыг сайжруулахын тулд Chromium таны өгөгдлийг шифрлэх болно.</translation>
<translation id="6684098000857849465">Google Бүртгэлээ Optimium-с хасахын тулд гарна уу</translation>
<translation id="8035579362848370000">Нууц үг, хавчуурга болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Optimium-д нэвтэрнэ үү</translation>
<translation id="2738871930057338499">Интернэтэд холбогдох боломжгүй байна. HTTP 403 хориотой. Прокси тохируулгаа шалгана уу.</translation>
<translation id="2753623023919742414">Хайхын тулд товшино уу</translation>
<translation id="6013736131971103780">Optimium-г өгөгдмөл PDF үзэгчээрээ тохируулах</translation>
<translation id="218391145495840504">Энэ өргөтгөл хортой программ агуулж байгаа бөгөөд аюултай байна. Үүнийг Optimium-с хассанаар энэ нь цаашид таны хувийн мэдээллийг оруулаад зочилсон сайтуудын тань өгөгдлийг харах болон өөрчлөх боломжгүй болно.</translation>
<translation id="2799223571221894425">Дахин эхлүүлэх</translation>
<translation id="8757776333711121842">Таны Optimium</translation>
<translation id="2816462166102338036">Зурган хайлтаар энэ видеог хай</translation>
<translation id="8289509301112665497">Анхааруулга: Optimium нь өргөтгөлийг таны хөтчийн түүхийг бүртгэж авахаас сэргийлж чадахгүй. Энэ өргөтгөлийг Тусгаарлагдсан горимд идэвхгүй болгохын тулд энэ сонголтыг сонгохгүй орхино уу.</translation>
<translation id="5977650568712460613">iOS дээрх Optimium-р камераараа бүтээгдэхүүн олж, үнийн бууралт болон илүү ихийг явж байх зуураа хянаарай.</translation>
<translation id="2841525013647267359">Дараах хэлээс орчуулах</translation>
<translation id="2846251086934905009">Суулгах үед алдаа гарлаа: Суулгагч дуусгаагүй. Суулгалтыг тасалсан.</translation>
<translation id="7445294455857704594">Optimium-аас устгах ...</translation>
<translation id="2850691299438350830">Таныг нэвтэрсэн үед Chromium дээр таны аюулгүй байдлыг хангадаг бөгөөд Google-н бусад апп дахь таны аюулгүй байдлыг сайжруулахын тулд ашиглаж болзошгүй</translation>
<translation id="2876152561415416331">Google Хайлтын самбарыг дахин нээх</translation>
<translation id="2885378588091291677">Асуудлын менежер</translation>
<translation id="8130920144001221645">Optimium-ын тухай</translation>
<translation id="2915996080311180594">Дараа дахин эхлүүлэх</translation>
<translation id="5422843128705358539">Таны өгөгдлийг нэвтрэх үгээр тань шифрлэдэг. Google Бүртгэлдээ Optimium-н өгөгдлөө ашиглах, хадгалахын тулд нэвтрэх үгээ оруулна уу.</translation>
<translation id="2945997411976714835">Суулгах үед алдаа гарлаа: Суулгагч явцыг эхлүүлж чадсангүй.</translation>
<translation id="7644909281692978299">iOS-т зориулсан Optimium-д хадгалсан нууц үгээ ашиглан сайтад илүү хурдан нэвтрээрэй</translation>
<translation id="6715328262141930431">Танай байгууллага Optimium-г удирддаг</translation>
<translation id="2977470724722393594">Chromium-г шинэчилсэн байна</translation>
<translation id="2977506796191543575">Хэрэв сайт таны нууц үгийг хулгайлахаар оролдох эсвэл таныг аюултай файл татах үед Chromium URL-г хуудасны бага зэрэг контентын хамт Аюулгүй үзэх рүү мөн илгээж болзошгүй</translation>
<translation id="3373190939774209520">Эцэг эхийнхээ сонголтуудаар онлайн орчинд илүү аюулгүй байхын тулд Optimium-д нэвтэрнэ үү</translation>
<translation id="2992577225802060159">Chromium-н санах ойг таны компьютер дээрх бусад аппликейшнаас хамгаална.</translation>
<translation id="3003694935412297923">Бүх ажил</translation>
<translation id="2169110625780321257">{count,plural, =1{Зарим өгөгдлийг таны Google Бүртгэлд хадгалж, бүх төхөөрөмж дээр тань ашиглах боломжтой болохын өмнө Optimium таныг мөн болохыг баталгаажуулах шаардлагатай байна. Хэрэв та одоо гарвал энэ өгөгдлийг (1 зүйл) устгана.}other{Зарим өгөгдлийг таны Google Бүртгэлд хадгалж, бүх төхөөрөмж дээр тань ашиглах боломжтой болохын өмнө Optimium таныг мөн болохыг баталгаажуулах шаардлагатай байна. Хэрэв та одоо гарвал энэ өгөгдлийг ({count} зүйл) устгана.}}</translation>
<translation id="535155819036938485"><ph name="URL" />-г Optimium-д шинэ табд нээнэ үү.</translation>
<translation id="302551344979399011">Ур чадвар зэрэг ХОУ-ы инновацыг таны Google Бүртгэлд хадгалж, Chromium Синкээс тусад нь удирддаг</translation>
<translation id="69529237724150463">Өргөтгөл болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Optimium-д нэвтэрнэ үү</translation>
<translation id="1699367992046240140">Optimium-д өгөгдөл нэмэх нь ...</translation>
<translation id="3034219227076811559">Chrome дахь Google Хайлт</translation>
<translation id="3037190258341683404">Та үзэх явцдаа асуулт асуухын тулд Chrome дахь Google Хайлтыг бэхлэх боломжтой</translation>
<translation id="3038232873781883849">Суулгахыг хүлээж байна...</translation>
<translation id="3045032126857188731">Орчуулсан хэл: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Санал хүсэлтийн харилцах цонхыг хаах</translation>
<translation id="7641708778616103377"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд Optimium-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү. Та мөн <ph name="DEVICE" />-с унших жагсаалт болон бусад зүйлээ авна.</translation>
<translation id="1759532319192341458">Optimium-н бусад профайл</translation>
<translation id="2862149341123916634">Өргөтгөл нь танд Optimium-г тусгайлан өөрчлөх боломжийг олгодог нэмэлт юм. Цэгцтэй байхаас эхлээд өдөр тутмын ажлыг хялбаршуулах хүртэл өргөтгөл танд Optimium-г өөрийн болгоход тусалдаг.</translation>
<translation id="9144026989666254609">Алдаа ослын тайлан болон <ph name="UMA_LINK" />-ыг Google рүү илгээх замаар Optimium-ыг улам сайжруулахад тусална уу.</translation>
<translation id="4449472527250709676">Google-н аюулгүй байдлын онцлогуудыг явж байх зуураа авахын тулд Optimium аппыг ашиглаарай</translation>
<translation id="6183456495642882201">{NUM_DEVICES,plural, =0{1 USB төхөөрөмжид нэг эсвэл түүнээс олон Optimium-н өргөтгөл хандаж байсан}=1{1 USB төхөөрөмжид нэг эсвэл түүнээс олон Optimium-н өргөтгөл хандаж байна}other{# USB төхөөрөмжид нэг эсвэл түүнээс олон Optimium-н өргөтгөл хандаж байна}}</translation>
<translation id="7419486418212185022"><ph name="DEVICE" />-с унших жагсаалт болон бусад зүйлээ авахын тулд Optimium-д нэвтэрнэ үү</translation>
<translation id="4481023367748355854">Optimium-н түүх</translation>
<translation id="6289574887308484514">Програм суулгагч нь архивыг задалж үл чадсан тул Optimium-г дахин татаж авна уу.</translation>
<translation id="310459126943037700">Ажил(ууд)-ыг дуусгаж чадсангүй.</translation>
<translation id="3104828284009500087">Хуудсан дээрх аливаа зүйлийг хайна уу</translation>
<translation id="1866751185142421235">Нууц үг, хавчуурга, түүхээ төхөөрөмжүүд дээр төгс синк хийсэн байлгаарай. Та өгөгдмөл хөтчөө Optimium болгон шинэчилж мэддэг, дуртай онцлогууддаа хялбархан хандаарай.</translation>
<translation id="7071720283847574213">Optimium нь таны микрофоныг ашиглаж байна.</translation>
<translation id="3130333203120345554">Шинэ хайлт</translation>
<translation id="3137969841538672700">Хайхын тулд чирнэ үү</translation>
<translation id="8832375982733310873">Энэ таб нэмэлт нөөц ашиглаж байна. Гүйцэтгэлээ сайжруулахын тулд Optimium-д энэ табыг идэвхгүй болгохыг зөвшөөрнө үү.</translation>
<translation id="7212905776009358992">Дэлгэцээ хуваалцахын тулд Системийн тохиргоонд Optimium-д дэлгэцийн үйлдэл бичихийг зөвшөөрнө үү</translation>
<translation id="7220401039380362840">Optimium-г дахин эхлүүлэх</translation>
<translation id="3161522574479303604">Бүх хэл</translation>
<translation id="2945128209475147845">Холбоосыг Optimium-н нууцлалтай цонхонд нээх</translation>
<translation id="5550841702580813851">Optimium-н шинэ профайлаа тохируулна уу</translation>
<translation id="6179644101029308447">Та таб сэлгэхгүйгээр ХОУ-ы горимтой үргэлжлүүлэн чатлах боломжтой. Эхлүүлэхийн тулд Optimium-д нэвтэрнэ үү. Та мөн бүх төхөөрөмж дээрээ нууц үг болон бусад зүйлээ авна.</translation>
<translation id="5843425624301789054">Google Бүртгэлээ Optimium-с хасахын тулд Тохиргооны хуудсанд Optimium-с гарна уу</translation>
<translation id="3234316605225071811">Дараа нь Chromium танаас хадгалсан мэдээллийг танд зориулж маягтыг автоматаар бөглөхөд ашигламаар байгаа эсэхийг асууж болно</translation>
<translation id="3381027830404501211">Optimium нь өөрийн өгөгдлийн сан руу уншуулж бас бичиж чадахгүй байна: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="8146675538658659954">iOS дээрх Optimium-р Google-н ХОУ-ы дуртай хэрэгслүүдээ явж байх зуураа ашиглаарай.</translation>
<translation id="6800117212942659992"><ph name="DEVICE" />-с өргөтгөл болон бусад зүйлээ авахын тулд Optimium-д нэвтэрнэ үү</translation>
<translation id="1315108685137442441">{COUNT,plural, =1{Optimium-д шинэ шинэчлэлт боломжтой байгаа бөгөөд таныг дахин ачаалсан даруйд хэрэгжүүлнэ. Тусгаарласан цонх тань ахин нээгдэхгүй.}other{Optimium-д шинэ шинэчлэлт боломжтой байгаа бөгөөд таныг дахин ачаалсан даруйд хэрэгжүүлнэ. Тусгаарласан # цонх тань ахин нээгдэхгүй.}}</translation>
<translation id="3286538390144397061">Одоо дахин эхлүүлнэ үү</translation>
<translation id="2161039902967573767">Google-ийн API түлхүүр байхгүй байна. Optimium-ийн зарим функц идэвхгүй болно.</translation>
<translation id="3296368748942286671">Chromium-ийг хаахад ард байгаа програмуудыг ажиллуулсан хэвээр бай.</translation>
<translation id="3313189106987092621">Chromium аюултай холболт ашиглан аливаа сайтыг ачаалахаас өмнө танд сануулна</translation>
<translation id="1282007042347821406">Хэрэв та Optimium-д нэвтэрсэн бол таныг Optimium-н бүх цонхыг хаах үед Google Бүртгэлээс тань бусад ихэнх сайтаас гаргана. Сайтад таныг санахыг зөвшөөрөхийн тулд <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">хайлтын хэсгийн баруун дээд булан: баруун <ph name="RIGHT" />%, дээд <ph name="TOP" />%</translation>
<translation id="3366305173356742781">Таны бүртгэлийн Chromium-н өгөгдөл</translation>
<translation id="3798810966749973116">Утсан дээрээ Optimium-р нууц үгнүүдээ ашиглах</translation>
<translation id="3387527074123400161">ChromiumOS</translation>
<translation id="3114385794555902051">Optimium-н одоо байгаа профайл руу сэлгэх үү?</translation>
<translation id="3412460710772753638">Энэ төхөөрөмж дээрх Нууц үгний менежерт</translation>
<translation id="1395799713002454043"><ph name="DEVICE" />-с хавчуурга болон бусад зүйлээ авахын тулд Optimium-д нэвтэрнэ үү</translation>
<translation id="3438772217992559640">Зурган хайлтаар энэ табаас хайх</translation>
<translation id="1565712261560212491">Утсан дээрээ Optimium-р Сайжруулсан аюулгүй хөтчийг өргөтгөх</translation>
<translation id="7003115800241574875">Optimium-г өөрийн болгоорой...</translation>
<translation id="3474745554856756813">Энэ нь төхөөрөмжөөс <ph name="ITEMS_COUNT" /> зүйл устгана. Өгөгдлөө дараа сэргээхийн тулд Chromium-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="1749327805708308979"><ph name="SHORTCUT" /> Optimium-н профайлууд хооронд сэлгэх боломжтой</translation>
<translation id="7437253251955408447">Optimium-н бүх цонхыг хаасны дараагаар дахин хандана уу.</translation>
<translation id="4544226979083343619">Цонхоо хуваалцахын тулд Системийн тохиргоонд Optimium-д дэлгэцийн үйлдэл бичихийг зөвшөөрнө үү</translation>
<translation id="7742324910239513884"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна.  Хөтчийн үзэлтээ тусдаа байлгахын тулд Optimium-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү.</translation>
<translation id="8618656037793872415">Хөдөлгөөнт төхөөрөмж дээр Optimium хөтчийг татах QR код</translation>
<translation id="354621070532799440">Сануулагч: Google-н аюулгүй байдлын шилдэг онцлогууд таны халаасанд байна</translation>
<translation id="3043015282185018117">Дэлгэцээ хуваалцахын тулд Системийн тохиргоонд Optimium-д дэлгэцийн үйлдэл бичихийг зөвшөөрнө үү.</translation>
<translation id="3597003331831379823">Нэмэлт эрхтэйгээр тохируулгыг ажиллуулж чадсангүй. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3261842649996827269">Optimium-д нэвтрэх</translation>
<translation id="1140403329282632523">Энэ хэрэглэгчийн хөтчийн өгөгдлийг энэ төхөөрөмжөөс устгана. Өгөгдлийг сэргээхийн тулд Optimium-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="5228011645297638039">{COUNT,plural, =0{Optimium-н шинэ шинэчлэлт боломжтой байгаа бөгөөд таныг дахин ачаалах үед түүнийг хэрэгжүүлэх болно.}=1{Optimium-н шинэ шинэчлэлт боломжтой байгаа бөгөөд таныг дахин ачаалах үед түүнийг хэрэгжүүлэх болно. Таны нууцлалтай цонхыг дахин нээхгүй.}other{Optimium-н шинэ шинэчлэлт боломжтой байгаа бөгөөд таныг дахин ачаалах үед түүнийг хэрэгжүүлэх болно. Таны # нууцлалтай цонхыг дахин нээхгүй.}}</translation>
<translation id="3667616615096815454">Суулгах боломжгүй. Аппликэйшнийг сервер танихгүй байна.</translation>
<translation id="3675854891107786059">Google Бүртгэлийнхээ Chromium-н бүх өгөгдлийг шифрлэхийн тулд <ph name="BEGIN_LINK" />өөрийн нэвтрэх үгийг<ph name="END_LINK" /> ашиглана уу. Google Pay-н төлбөрийн хэрэгсэл, хаягийг шифрлэхгүй. Chromium-н хөтчийн түүхийг синк хийхгүй.</translation>
<translation id="7861068783030138988">{COUNT,plural, =0{Энэ шинэчлэлтийг хэрэгжүүлэхийн тулд Optimium-г дахин ачаалахыг таны администратор танаас хүсэж байна}=1{Энэ шинэчлэлтийг хэрэгжүүлэхийн тулд Optimium-г дахин ачаалахыг таны администратор танаас хүсэж байна. Таны нууцлалтай цонхыг дахин нээхгүй.}other{Энэ шинэчлэлтийг хэрэгжүүлэхийн тулд Optimium-г дахин ачаалахыг таны администратор танаас хүсэж байна. Таны # нууцлалтай цонхыг дахин нээхгүй.}}</translation>
<translation id="8611928240945733486">Холбоосыг шинэ Optimium болон табад нээх</translation>
<translation id="3728124580182886854">Хувийн болгох болон бусад зорилгоор Chromium болон Google-н бусад үйлчилгээг холбоно уу</translation>
<translation id="3729187154190517324">"Таб болон бусад зүйл нэмэх" товчийг ашиглан олон таб, файл, хэрэгсэл нэмж хайлтаа гүнзгийрүүлээрэй.</translation>
<translation id="3032577647176321971">Optimium-н профайлуудыг удирдах</translation>
<translation id="6314444399103340747">Optimium зарим татаж авсан файлыг яагаад блоклодог болохыг мэдэж авах</translation>
<translation id="379589255253486813">Та ямар нэг зүйлийг шалгах шаардлагатай бол Chromium танд мэдэгдэнэ</translation>
<translation id="3802055581630249637">Chromium таны зочлох магадлалтай хуудаснуудыг урьдчилан ачаалах бөгөөд ингэснээр тэдгээр нь таныг зочлох үед илүү хурдан ачаална</translation>
<translation id="3810973564298564668">удирдах</translation>
<translation id="4301680230606686279">Хадгалсан нууц үгнүүдээ ашиглахын тулд QR кодыг уншуулаад, iOS-т зориулсан Optimium-г татаж, Google Бүртгэлдээ нэвтэрнэ үү</translation>
<translation id="3846683726093018685">**Хураангуйлах:** 30-аас цөөн үгтэй нэг өгүүлбэрээр дэлгэцийн агшны агуулгын үндсэн сэдэв, зорилгыг тайлбарлана уу.

          **Асуулт санал болгох:** Хэрэглэгч дэлгэцийн агшныг илүү сайн ойлгохын тулд асууж болох 3-5 бодлогошруулах асуултын жагсаалтын тэмдэгтэй жагсаалт (bulleted list) үүсгэнэ үү. Эдгээр асуултын дор хаяж нэг нь визуал объект, үүний дизайн, байршлын талаарх тодорхой асуулт байх ёстой.</translation>
<translation id="3287167856630539345"><ph name="PAGE_TITLE" /> - Optimium</translation>
<translation id="3117512156333858342">Хавчуурга болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Optimium-д нэвтэрнэ үү</translation>
<translation id="3511883131632987404">{COUNT,plural, =1{Танай администратор энэ шинэчлэлтийг хэрэгжүүлэхийн тулд танаас Optimium-г дахин ачаалахыг хүсэж байна. Тусгаарласан цонх тань ахин нээгдэхгүй.}other{Танай администратор энэ шинэчлэлтийг хэрэгжүүлэхийн тулд танаас Optimium-г дахин ачаалахыг хүсэж байна. Тусгаарласан # цонх тань ахин нээгдэхгүй.}}</translation>
<translation id="3885770153807205175">Хэл сонгогч</translation>
<translation id="7294070483192043494">Optimium-г өөрчилж, хянана уу. Та ямар нэг зүйлд анхаарлаа хандуулах шаардлагатай байна. Дэлгэрэнгүй мэдээлэл авахын тулд товшино уу.</translation>
<translation id="7920927747111819647">Optimium-г нээх мөн хөтөчийг ашиглаж эхлэхийн тулд өөрийн нэр дээр дарна уу.</translation>
<translation id="3892148308691398805">Текстийг хуулах</translation>
<translation id="4454986649289930182"><ph name="EXISTING_USER" /> Optimium-н энэ профайлд аль хэдийн нэвтэрсэн байна. Таны хөтчийн үзэлтийг тусад нь байлгахын тулд Optimium танд өөрийн гэсэн профайл үүсгэж өгөх боломжтой.</translation>
<translation id="7225128703667880746">Энэ өргөтгөл Chrome Веб Дэлгүүрийн бодлогыг зөрчиж байгаа бөгөөд аюултай байж магадгүй. Үүнийг Optimium-с хассанаар энэ нь цаашид таны хувийн мэдээллийг оруулаад зочилсон сайтуудын тань өгөгдлийг харах болон өөрчлөх боломжгүй болно.</translation>
<translation id="3941890832296813527">Суулгах үед алдаа гарлаа: Суулгагчийн файлын нэр буруу эсвэл дэмжигдээгүй.</translation>
<translation id="6304622602441037994">Optimium нь нууц үгс хуулахыг оролдож байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="2274695480528598968">Хадгалсан мэдээлэл болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Optimium-д нэвтэрнэ үү</translation>
<translation id="1713567483777335359">Таны Google Бүртгэлдээ хадгалсан нууц үг, төлбөрийн хэрэгсэл, хаягуудыг энэ төхөөрөмжөөс хасна. Тэдгээрийг Optimium-д дахин ашиглахын тулд буцаж нэвтэрнэ үү.</translation>
<translation id="395904275706073188">Хамгаалагдсан хуудсыг унших боломжгүй. Өөр хуудас туршиж үзнэ үү.</translation>
<translation id="3962647064319009959">Chromium таныг хэрхэн аюулгүй байлгадаг болохыг мэдэж авна уу</translation>
<translation id="3967822245660637423">Татаж авч дууслаа</translation>
<translation id="3971865010372729242">Таныг хаяг оруулах хэсэг, хайх хэсэгт шивэх үед Chromium зөвлөмж авахын тулд таны шивсэн зүйлийг танай байгууллагын хайлт, ХОУ, агентын хэрэгслүүд рүү илгээдэг.</translation>
<translation id="3975724895399328945">&amp;Google Chrome for Testing-н тухай</translation>
<translation id="3984557288004650913">Та үзэх явцдаа асуулт асуухын тулд хэрэгслийн мөр дээрх "Chrome дахь Google Хайлт" товчноос Chrome дахь Google Хайлтыг дахин нээх боломжтой</translation>
<translation id="3997429360543082038">ChromiumOS-н тухай</translation>
<translation id="4016217212818346953">Нууц үгний менежерээр аюулгүй байгаарай</translation>
<translation id="4019629340646866719">ChromiumOS-г <ph name="BEGIN_LINK_LINUX_OSS" />Linux-н хөгжүүлэлтийн орчин <ph name="END_LINK_LINUX_OSS" /> болох нэмэлт <ph name="BEGIN_LINK_CROS_OSS" />нээлттэй эх кодын программ хангамжаар<ph name="END_LINK_CROS_OSS" /> боломжтой болгосон.</translation>
<translation id="4022972681110646219">Дэлгэцийг орчуулах</translation>
<translation id="4023601594785368013">Эх хэл: <ph name="LANGUAGE" /></translation>
<translation id="8098054594752731054">Дурын аппаас холбоосыг Optimium-д нээнэ үү. Түүнчлэн хялбар хандахад зориулж үүнийг таны ажлын хэсэгт бэхэлдэг.</translation>
<translation id="4036079820698952681"><ph name="BEGIN_LINK" />Одоогийн тохиргоог<ph name="END_LINK" /> мэдэгдэж Chromium-г сайжруулахад тусална уу</translation>
<translation id="4050175100176540509">Хамгийн сүүлийн хувилбар дээр аюулгүй байдлын чухал сайжруулалт болон шинэ функцийг санал болгож байна.</translation>
<translation id="4055805654398742145">Нууц үгний менежер</translation>
<translation id="3150466418323356831">{COUNT,plural, =1{Optimium-г 1 минутын турш ашиглаагүй үед танай байгууллага үүнийг автоматаар хаана. Интернэтээр үзсэн өгөгдлийг устгадаг. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно.}other{Optimium-г # минутын турш ашиглаагүй үед танай байгууллага үүнийг автоматаар хаана. Интернэтээр үзсэн өгөгдлийг устгадаг. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно.}}</translation>
<translation id="4118474109249235144">Chromium-н нууцлалын горим</translation>
<translation id="4122186850977583290">Chromium-н тухай хуудас руу очно уу</translation>
<translation id="5040058062446726786">Хөтчидөө шинэ дүр төрх өгөхийн тулд Optimium-г тусгайлан өөрчилнө үү</translation>
<translation id="3417230552019009112">Optimium-аа тусгайлан өөрчлөх</translation>
<translation id="4148957013307229264">Суулгаж байна...</translation>
<translation id="8036654966821129512">Аюулгүй байхын тулд Optimium-г шинэчилнэ үү</translation>
<translation id="113287843321846936"><ph name="PAGE_TITLE" /> - Сүлжээнд нэвтрэх - Optimium</translation>
<translation id="101945827160630872"><ph name="EXISTING_USER" /> аль хэдийн нэвтэрсэн байна. Хөтчийн түүхээ тусад нь байлгахын тулд Optimium-д <ph name="USER_EMAIL_ADDRESS" />-р өөрийн профайлаар нэвтэрнэ үү. Та мөн бүх төхөөрөмж дээрээ унших жагсаалт болон бусад зүйлээ авна.</translation>
<translation id="5914158797921975103">Optimium-д зориулсан гайхалтай апп, тоглоом, өргөтгөл болон дэлгэцийн зургуудыг олж сонирхоорой.</translation>
<translation id="7188357620681202939">Энэ өргөтгөл болон илүү ихийг бүх компьютер дээрээ авахын тулд Optimium-д нэвтэрнэ үү</translation>
<translation id="1889725122457669356">Эцэг эхийнхээ сонголтуудаар онлайн орчинд илүү аюулгүй байхын тулд та <ph name="USER_EMAIL_ADDRESS" />-р хэдийн нэвтэрсэн Optimium профайл руугаа сэлгэнэ үү</translation>
<translation id="4222932583846282852">Цуцалж байна...</translation>
<translation id="4224210481850767180">Суулгах үйлдлийг цуцалсан.</translation>
<translation id="3467085712950617325">Та өөрийн Optimium өгөгдлийг энэ хаягтай холбох хүсэлтэй байна уу?</translation>
<translation id="4251772536351901305">Стандарт хамгаалалтаас илүүтэйгээр сайтуудын бусад өгөгдлийг задлан шинжилснээр танд аюултай сайтуудын талаар сануулах бөгөөд эдгээрт Google-н өмнө нь мэдээгүй сайт ч багтана. Та Chromium-н сануулгыг алгасахаар сонгох боломжтой.</translation>
<translation id="2140865310399147834">Optimium-с гарах</translation>
<translation id="4271805377592243930">Chromium-с тусламж авах</translation>
<translation id="4275788652681621337">Хажуугийн самбарыг хаах</translation>
<translation id="4281844954008187215">Үйлчилгээний нөхцөл</translation>
<translation id="3179093133057739293">Гэнэтийн асуудлаас болж суулгах ажиллагаа амжилтгүй боллоо. Хэрвээ Optimium яг одоо ажиллаж байгаа бол хаагаад дахин оролдож үзнэ үү.</translation>
<translation id="5932936993463393384">Optimium-с нууц үг экспортлох</translation>
<translation id="4304713468139749426">Нууц үгний менежер</translation>
<translation id="4334241893986177674">Энэ дэлгэцийн агшнаас хайх</translation>
<translation id="109990079583792895">Windows-г эхлэх үед Optimium-г эхлүүлэх</translation>
<translation id="4400772909124543403">Шинэчлэлт боломжгүй байна</translation>
<translation id="4669117187454638908">Ямар ч байсан Optimium-с гарах уу?</translation>
<translation id="4413205837991854510">Зурган хайлтын товчлолыг үргэлж харуулах</translation>
<translation id="1696050014109987987">Optimium-г цаана ажиллуулахыг зөвшөөрөх</translation>
<translation id="7368827027253482667">{NUM_EXTENSIONS,plural, =1{Optimium танд үүнийг хасахыг зөвлөж байна. <ph name="BEGIN_LINK" />Дэмжигдсэн өргөтгөлийн талаар нэмэлт мэдээлэл авах<ph name="END_LINK" />}other{Optimium танд эдгээрийг хасахыг зөвлөж байна. <ph name="BEGIN_LINK" />Дэмжигдсэн өргөтгөлийн талаар нэмэлт мэдээлэл авах<ph name="END_LINK" />}}</translation>
<translation id="6842479443769252421">Optimium-ыг гүйцэтгэх ба хянах</translation>
<translation id="4427306783828095590">Сайжруулсан хамгаалалт нь фишинг болон хортой кодыг блоклохын тулд илүү ихийг хийдэг</translation>
<translation id="4434353761996769206">Суулгагчийн алдаа: <ph name="INSTALLER_ERROR" /></translation>
<translation id="1220175535870261362"><ph name="MANAGER" /> Optimium-г удирддаг</translation>
<translation id="4547231940814681999">Optimium-н профайл нэмэх</translation>
<translation id="4447409407328223819">Chrome for Testing-н тухай</translation>
<translation id="5633209319760692383">Google Бүртгэлийнхээ Optimium-н өгөгдлийг ашиглах болон хадгалахын тулд нэвтрэх үгээ оруулна уу</translation>
<translation id="4493028449971051158">Эхлэхэд алдаа гарлаа: суулгагчийг администратораар дахин ажиллуулна уу.</translation>
<translation id="4501471624619070934">Энэ улсад хандалтыг хязгаарласан тул суулгаж чадсангүй.</translation>
<translation id="4501839397124711198">Та үзэх явцдаа асуулт асуухын тулд хажуугийн самбарт Google Хайлтыг бэхлэх боломжтой</translation>
<translation id="2800276662284246735">Энэ өргөтгөл өгөгдлийг хэрхэн цуглуулж, ашигладаг гэх мэт нууцлалын практикаа нийтлээгүй байна. Optimium танд үүнийг хасахыг зөвлөж байна.</translation>
<translation id="5128821773878845255">Optimium-д тавтай морилно уу; хөтчийн шинэ цонхыг нээсэн</translation>
<translation id="2317489323536472198">Таны орчин тойрныг зураглаж, гарыг тань тандахад Optimium-д зөвшөөрөл шаардлагатай</translation>
<translation id="8080035720506683743">Та <ph name="USER_EMAIL_ADDRESS" /> хаягаараа Optimium-н өөр профайлд аль хэдийн нэвтэрсэн байна</translation>
<translation id="4548534452171747496">Chromium хуудаснуудыг урьдчилан ачаалах бөгөөд энэ нь үзэх, хайхыг илүү хурдан болгоно. <ph name="BEGIN_LINK" />Хуудас урьдчилан ачаалах талаар нэмэлт мэдээлэл авах<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Хортой гэж бодож буй сайтыг мэдээлж, хүн бүрийн онлайн аюулгүй байдлыг сайжруулахад тусална уу.</translation>
<translation id="8636960717768483692">Та Safe Browsing-г унтраасан бөгөөд файлыг баталгаажуулах боломжгүй тул Optimium энэ таталтыг блоклосон</translation>
<translation id="1056620590372326996">Утсан дээрээ Optimium-р Google Lens-г туршиж үзэх</translation>
<translation id="4594305310729380060">Энэ төхөөрөмж дээрх Нууц үгний менежерт</translation>
<translation id="1647545052658850323">Optimium App</translation>
<translation id="4598116752460667024">Жагсаалтаас ямар нэг явцыг хайна уу.</translation>
<translation id="4613863813562375431">ChromiumOS-н хувилбар</translation>
<translation id="4621240073146040695">Удахгүй шинэчилж дууслаа! Chromium-н шинэчлэлийг дуусгахын тулд дахин ачаалж эхлүүлнэ үү.</translation>
<translation id="2905329563261343101">Optimium-н V8 системээр сайтыг хурдасгах ч Optimium-г халдлагад арай тэсвэр багатай болгоно</translation>
<translation id="3476739270743628464">Optimium-р хайхыг нээх</translation>
<translation id="8852417056873245680">Optimium-н профайл</translation>
<translation id="7306598352117034690">Анхааруулга: Optimium өргөтгөлүүдийг таны хөтчийн түүхийг бичихээс хамгаалж чадахгүй. Энэ өргөтгөлийг Нууцлалтай горимд идэвхгүй болгохын тулд энэ сонголтыг болиулна уу.</translation>
<translation id="4673151026126227699">Хэрэв та мөн Chromium-н ашиглалтын тайланг хуваалцвал тэдгээр тайланд таны зочилсон URL багтана</translation>
<translation id="4673710618874938871"><ph name="USER_NAME" />-р гишүүнчлэлийн эрхтэйгээр нэвтэрсэн. Бүртгэлийн цэсийг нээх</translation>
<translation id="8554460300897634995">Хувийн мэдээллийг (<ph name="HOST_NAME" />) өөр компьютер дээр өөр Optimium үйлдэлд (<ph name="PROCESS_ID" />) ашиглаж байна гэж харагдаж байна. Optimium-аас хувийн мэдээллийг түгжсэн байгаа учраас үүнийг өөр зүйлд ашиглах боломжгүй юм. Хэрэв та өөр ямар ч үйлдэлд энэ хувийн мэдээллийг ашиглахгүй байгаа гэдэгт та итгэлтэй байгаа бол хувийн мэдээллээ цоожилж Optimium-ыг дахин эхлүүлж болно.</translation>
<translation id="4680828127924988555">Суулгахыг цуцлах</translation>
<translation id="3120454893225058851">Таны Optimium-н зарим өгөгдлийг одоогоор Google Бүртгэлд тань хадгалаагүй байна. Гарахаасаа өмнө хэдэн минут хүлээж үзнэ үү. Хэрэв та одоо гарвал энэ өгөгдлийг устгана.</translation>
<translation id="382482205580353394">Та нэвтэрсэн байхдаа Optimium-д Google Бүртгэлээсээ нууц үг болон бусад зүйлээ ашиглах боломжтой. <ph name="SHORTCUT" /> таны Google-н үйлчилгээний тохиргоог өөрчлөх боломжтой.</translation>
<translation id="3042362992251330365">Хэн нэгэн энэ компьютерт <ph name="ACCOUNT_EMAIL_LAST" /> бүртгэлээр Optimium-д нэвтэрсэн байна. Мэдээллээ тусад нь хадгалахын тулд Optimium-н шинэ хэрэглэгч үүсгэнэ үү.</translation>
<translation id="4724676981607797757">Дэмжигдээгүй протоколын алдааны улмаас суулгалт амжилтгүй болсон.</translation>
<translation id="1193287511990404405">Ямар ч байсан Optimium-г орхих уу?</translation>
<translation id="8952177001318268390">Optimium-н аюулгүй байдлын тусгай шинэчлэлт хийгдэж дууслаа. Одоо дахин эхлүүлнэ үү. Бид таны табыг сэргээх болно.</translation>
<translation id="4771701986670315895">Та ойрын үед зочлоогүй байна. Chromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> болон өөр <ph name="COUNT" /> зөвшөөрлийг хассан.</translation>
<translation id="2836181158089477791">Хэрэв Optimium дахь Gemini нээлттэй бол шинэ таб үүсгэхэд хажуугийн самбар нээлттэй хэвээр байна</translation>
<translation id="479167709087336770">Энэ нь Google хайлтад ашигладаг зөв бичгийн ижил алдаа шалгагчийг ашигладаг. Таны хөтчид бичсэн текстийг Google-д илгээдэг. Та энэ ажиллах төлөвийг хүссэн үедээ тохиргоонд өөрчилж болно</translation>
<translation id="4803313124144656665">Chrome дахь Google Хайлтыг хаах</translation>
<translation id="1328138522631482119">Optimium-г бүртгэлгүйгээр ашиглах</translation>
<translation id="4839733921943823254">Товчлол бэхлэх</translation>
<translation id="3892081057957249936">MDNS урсгалыг зөвшөөрөхийн тулд Optimium-д зориулсан хөндлөнгийн дүрэм.</translation>
<translation id="7651599052663598373">&amp;Optimium-г шинэчлэхийн тулд дахин ачаалах</translation>
<translation id="4918086044614829423">Хүлээн зөвшөөрөх</translation>
<translation id="4918844574251943176">Зургийг хуулсан</translation>
<translation id="5410814264258278350">Унших жагсаалт болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Optimium-д нэвтэрнэ үү</translation>
<translation id="6875307114047320453">Optimium нь суурь горимд байна.</translation>
<translation id="2394968926407196930">Optimium-н нэвтрэх харилцах цонхыг хаахын тулд товшино уу</translation>
<translation id="1768466544858725503">Та Optimium профайлаар Optimium-н бүх зүйлээ тусгаарлах боломжтой. Найз, гэр бүлийнхэндээ зориулж профайл үүсгэх эсвэл ажил, зугааг ялгаж салгаарай.</translation>
<translation id="7886648924703056279">Зочид Optimium-ийг ашигласнаар хамгийн сүүлийн үеийн мэдээллийг авна.</translation>
<translation id="5471135073467145273">Таны Optimium дахь бүртгэл</translation>
<translation id="6876331590693993673">Өөрийгөө Optimium руу нэмэх</translation>
<translation id="5000497292978544380">Google Хайлтын ХОУ-ы горим</translation>
<translation id="504699503110800016">Урт цэсийг нээх</translation>
<translation id="4438081792500757652"><ph name="DEVICE_TYPE" /> дээрээ Optimium-р Google-н бүх дуртай зүйлдээ хандаарай</translation>
<translation id="5121592697493894155">Хажуугийн самбар дахь Google Хайлт</translation>
<translation id="2242644352859741625">Optimium-д таны гарыг хянах зөвшөөрөл шаардлагатай</translation>
<translation id="5141988424377517949">Та ойрын үед зочлоогүй байна. Chromium <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" />-г хассан.</translation>
<translation id="988933134885096200">Optimium-д нэвтэрнэ үү</translation>
<translation id="5174969993834422967">Та ихэвчлэн мэдэгдлийг блоклодог. Энэ сайтад танд мэдэгдэхийг зөвшөөрөхийн тулд байршлын хэсгийн тань баруун дээд буланд байх мэдэгдлийн дүрс тэмдгийг товшино уу.</translation>

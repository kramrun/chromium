<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="lt">
<translation id="1026101648481255140">Tęsti diegimą</translation>
<translation id="1029669172902658969">Paleisti iš naujo ir atnaujinti „&amp;Chromium“ OS</translation>
<translation id="4063809399345498325">„Optimium“ rekomenduoja peržiūrėti šį plėtinį</translation>
<translation id="1042552502243217427">Kai svetainė paprašo privačiai iš anksto įkelti nuorodas savo puslapyje, „Chromium“ naudoja „Google“ serverius. Taip slepiama jūsų tapatybė nuo iš anksto įkeltos svetainės, bet „Google“ sužino, kokios svetainės įkeliamos iš anksto.</translation>
<translation id="1051793555070215510">Padėkite mums tobulinti inkognito režimą dalyvaudami šioje vienos minutės trukmės apklausoje.</translation>
<translation id="1065672644894730302">Jūsų nuostatų negalima nuskaityti.

Kai kurios funkcijos gali būti nepasiekiamos ir nuostatų pakeitimai nebus išsaugoti.</translation>
<translation id="7250992450852052182">Vienas iš tėvų išjungė svetainių, programų ir plėtinių leidimus sistemoje „Optimium“</translation>
<translation id="6711838932294803312">„Optimium“ reikalinga prieiga prie vietinio tinklo, kad būtų galima aptikti ir naudoti netoliese esančius įrenginius</translation>
<translation id="2807920805712601449">Jei norite ieškoti konkrečios „Optimium“ funkcijos ar plėtinio, įveskite šaukinį adreso juostoje ir paspauskite pasirinktą klaviatūros klavišą</translation>
<translation id="5994612110840535151">Rodyti paiešką naudojant „Optimium“ sistemos juostelėje ir įjungti spartųjį klavišą</translation>
<translation id="7212528213853025915">„Optimium“ nori eksportuoti jūsų slaptažodžius. Įveskite „Windows“ slaptažodį, kad tai leistumėte.</translation>
<translation id="112640046208448578">Nustatykite daiktus ar vietas ir kopijuokite arba verskite tekstą. Kai naudojate vaizdų paiešką, puslapio ekrano kopija siunčiama į serverį. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">„Chromium“ yra numatytoji naršyklė</translation>
<translation id="1131805035311359397">Jei norite patikrinti, ar slaptažodžiai apsaugoti nuo duomenų saugos pažeidimų bei kitų saugos problemų, <ph name="BEGIN_LINK" />prisijunkite prie „Chromium“<ph name="END_LINK" />.</translation>
<translation id="3458316367708035110">{COUNT,plural, =1{Administratorius prašo paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti šį naujinį. Atidarytas inkognito arba izoliuotas langas. Paleidus iš naujo jis nebus atidarytas iš naujo}one{Administratorius prašo paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti šį naujinį. Profiliuose atidarytas # inkognito ir izoliuotas langas. Paleidus iš naujo jie nebus atidaryti iš naujo.}few{Administratorius prašo paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti šį naujinį. Profiliuose atidaryti # inkognito ir izoliuoti langai. Paleidus iš naujo jie nebus atidaryti iš naujo.}many{Administratorius prašo paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti šį naujinį. Profiliuose atidaryta # inkognito ir izoliuoto lango. Paleidus iš naujo jie nebus atidaryti iš naujo.}other{Administratorius prašo paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti šį naujinį. Profiliuose atidaryta # inkognito ir izoliuotų langų. Paleidus iš naujo jie nebus atidaryti iš naujo.}}</translation>
<translation id="1150418667633096194">Įrankių juostos mygtukas „Google“ paieškos šoninis skydelis“ turi naują piktogramą. Spustelėkite, kad naršydami galėtumėte užduoti klausimų naudodami „Google“ paieškos šoninį skydelį.</translation>
<translation id="759898790519515623">Spustelėkite „Optimium“ meniu</translation>
<translation id="1157952955648710254">Uždaryti „Google“ paieškos šoninį skydelį</translation>
<translation id="1157985233335035034">Naujausios kalbos</translation>
<translation id="1184145431117212167">Įdiegti nepavyko, nes jūsų „Windows“ versija nepalaikoma.</translation>
<translation id="1185134272377778587">Apie „Chromium“</translation>
<translation id="5987505065981917957">Gaukite kainų stebėjimo įspėjimus naudodami „Optimium“ telefone</translation>
<translation id="1203500561924088507">Dėkojame už diegimą. Turite iš naujo paleisti naršyklę, prieš naudodami „<ph name="BUNDLE_NAME" />“.</translation>
<translation id="1232234696885483911">Kai atidarysite vaizdų paiešką, puslapio pavadinimas, URL ir turinys, įskaitant PDF failus, bus automatiškai siunčiami į serverį. <ph name="LEARN_MORE" /></translation>
<translation id="3560913454241378492">Prisijungus galima naudoti slaptažodžius ir daugiau iš „Google“ paskyros „Optimium“ įrenginyje. Jei norite tai pakeisti, eikite į skiltį „Jūsų paskyra sistemoje „Optimium“.</translation>
<translation id="8922965532693587493">Rodyti „Gemini“ naršyklėje „Optimium“ kompiuterio „Mac“ meniu juostoje</translation>
<translation id="236433590733312836">Jei norite pasirinkti ekrano dalį sistemoje „Gemini“ naršyklėje „Optimium“, naudokite sparčiuosius klavišus.</translation>
<translation id="7976124325589452515">Kol šis skirtukas buvo neaktyvus, atmintis buvo atlaisvinta, kad „Optimium“ veiktų sparčiai. Galite pasirinkti visada išskirti šią svetainę, kad būtų aktyvi.</translation>
<translation id="2758503437544511902">„Optimium“ užblokavo šį atsisiuntimą, nes failas pavojingas</translation>
<translation id="126567311906253476">Prisijungdami prie „Google“ paslaugų, pvz., „Gmail“ ar „YouTube“, naudodami <ph name="USER_EMAIL" />, galite automatiškai prisijungti prie „Chromium“ naudodami tą pačią paskyrą</translation>
<translation id="4104061172701635162">Gaukite „Optimium“ telefone</translation>
<translation id="1290883685122687410">Sąrankos klaida: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="3443894627866827446">Nustatykite naują „Optimium“ profilį</translation>
<translation id="8946186262159916495">Išbandyti naudojant „Gemini“ naršyklėje „Optimium“</translation>
<translation id="7981347318091963592">„Optimium“ reikalinga „Bluetooth“ prieiga, kad galėtų naršyti
 „Bluetooth“ įrenginius. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6099322702899630168">Prisijunkite prie „Optimium“ telefone</translation>
<translation id="1330562121671411446">Aptikti kalbą</translation>
<translation id="3294414641786025647">Taip pat ištrinti duomenis iš „Optimium“ (<ph name="URL" />)</translation>
<translation id="4214354213779528068">{COUNT,plural, =1{Naudojant Papildomą apsaugą reikia paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti naujinį. Atidarytas inkognito arba izoliuotas langas. Paleidus iš naujo jis nebus atidarytas iš naujo}one{Naudojant Papildomą apsaugą reikia paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti naujinį. Profiliuose atidarytas # inkognito ir izoliuotas langas. Paleidus iš naujo jie nebus atidaryti iš naujo.}few{Naudojant Papildomą apsaugą reikia paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti naujinį. Profiliuose atidaryti # inkognito ir izoliuoti langai. Paleidus iš naujo jie nebus atidaryti iš naujo.}many{Naudojant Papildomą apsaugą reikia paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti naujinį. Profiliuose atidaryta # inkognito ir izoliuoto lango. Paleidus iš naujo jie nebus atidaryti iš naujo.}other{Naudojant Papildomą apsaugą reikia paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti naujinį. Profiliuose atidaryta # inkognito ir izoliuotų langų. Paleidus iš naujo jie nebus atidaryti iš naujo.}}</translation>
<translation id="1345251407431278948">Prisegta! Galite vėl pasiekti vaizdų paiešką naudodami naują įrankių juostos mygtuką</translation>
<translation id="1383876407941801731">Ieškoti</translation>
<translation id="7825299065989465359">Naudokite „Optimium“ programą, kad galėtumėte naršyti keliaudami</translation>
<translation id="141901961143729572">Pasidalykite mintimis</translation>
<translation id="1438812738230833934">Galite iš naujo atidaryti „Google“ paiešką šoniniame skydelyje, kad naršydami galėtumėte užduoti klausimų</translation>
<translation id="4131307166987455854">Jei norite bendrinti langą, sistemos nustatymuose leiskite įrašyti „Optimium“ ekrano vaizdą.</translation>
<translation id="1470136641087909499">Galite iš naujo atidaryti „Google“ paiešką naršyklėje „Chrome“, kad naršydami galėtumėte užduoti klausimų</translation>
<translation id="1478370723027452770">Gauti pagalbos dėl „Chrome for Testing“</translation>
<translation id="9200022682397754538">Jei norite gauti išsaugotą informaciją ir kt. iš <ph name="DEVICE" />, prisijunkite prie „Optimium“</translation>
<translation id="1497802159252041924">Diegimo klaida: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Šis puslapis apsaugotas</translation>
<translation id="892690000529877604">„Optimium“ skirtuko bendrinimas</translation>
<translation id="15408169957028265">Iš naujo atidaryti „Google“ paiešką naršyklėje „Chrome“</translation>
<translation id="9039191226880557963">Prisijungti prie „Optimium“</translation>
<translation id="1547469039832541117">Baigiama paryškinta užduotis.</translation>
<translation id="4414991100979797293">Prisegti „Optimium“</translation>
<translation id="1574377791422810894">„Chromium“ saugos įrankiai</translation>
<translation id="3934587628489930735">„Optimium“ nori ištrinti jūsų Slaptažodžių tvarkyklės duomenis. Įveskite „Windows“ slaptažodį, kad tai leistumėte.</translation>
<translation id="6745390171113033635">{COUNT,plural, =0{Administratorius reikalauja paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti naujinį}=1{Administratorius reikalauja paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti naujinį. Inkognito langas nebus atidarytas iš naujo.}one{Administratorius reikalauja paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti naujinį. # inkognito langas nebus atidarytas iš naujo.}few{Administratorius reikalauja paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti naujinį. # inkognito langai nebus atidaryti iš naujo.}many{Administratorius reikalauja paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti naujinį. # inkognito lango nebus atidaryta iš naujo.}other{Administratorius reikalauja paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti naujinį. # inkognito langų nebus atidaryta iš naujo.}}</translation>
<translation id="7186551909256266009">Išnaudokite visas „Google“ galimybes, naudodami „Optimium“ programą telefone</translation>
<translation id="1625909126243026060">Peržiūrėkite pagrindinius privatumo ir saugos valdiklius naršyklėje „Chromium“</translation>
<translation id="1640672724030957280">Atsisiunčiama...</translation>
<translation id="1648201623125974721">Nauja piktograma, tas pats spartusis klavišas: spustelėkite, kad naršydami galėtumėte užduoti klausimų naudodami kontekstines užduotis.</translation>
<translation id="1665602916345474427">Prisijungta kaip <ph name="USER_NAME" />, <ph name="USER_EMAIL" />, narystė. Atidaryti paskyros meniu</translation>
<translation id="1708414395296835197">Galite naudoti „Chromium“ bet kada spustelėję nuorodas pranešimuose, dokumentuose ir kitose programose. Ji taip pat bus prisegta prie užduočių juostos.</translation>
<translation id="1709772298389099340">Suteikia „<ph name="BROWSER_NAME" />“ aukštesnio lygio privilegijas.</translation>
<translation id="1722488837206509557">Galėsite pasirinkti iš pasiekiamų įrenginių ir pateikti turinį juose.</translation>
<translation id="6717880500969720524">„Optimium“ netrukus ištrins naršymo duomenis</translation>
<translation id="1736443181683099871">„Chromium“ bandys naujovinti naršymą į HTTPS</translation>
<translation id="4418738262462299802">Išvalyti „Optimium“ duomenys</translation>
<translation id="8469746761106187775">„Optimium“ bus paleista iš naujo po <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Kai HTTPS nepasiekiamas, „Chromium“ naudos nesaugų ryšį be perspėjimo</translation>
<translation id="1769661297620183092">Galite iš naujo atidaryti „Google“ paieškos skydelį, kad naršydami galėtumėte užduoti klausimų</translation>
<translation id="6555789357989792722">Paleisti „Optimium“ fone</translation>
<translation id="627441522449241646">Kad „Optimium“ padarytume saugesnę, išjungėme kai kuriuos plėtinius, kurių nėra „<ph name="IDS_EXTENSION_WEB_STORE_TITLE" />“ sąraše ir kurie galėjo būti pridėti be jūsų žinios.</translation>
<translation id="1912380661217770781">Spustelėkite mygtuką <ph name="BEGIN_BOLD" />Taip<ph name="END_BOLD" /> „Windows“ pranešime, kad prisegtumėte „Optimium“ prie užduočių juostos ir galėtumėte sparčiai ją pasiekti.</translation>
<translation id="9034578483087384251">Iš naujo įdiegti „Optimium“</translation>
<translation id="2856362667064664106">„Optimium“ bando <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="1665590461646883113"><ph name="EXISTING_USER" /> jau prisijungė. Jei norite atskirti naršymą, prisijunkite prie „Optimium“ savo profilyje kaip <ph name="USER_EMAIL_ADDRESS" />. Be to, plėtinius ir kitus duomenis pasieksite <ph name="DEVICE" />.</translation>
<translation id="1668665535355826445">Kitą kartą atidarius „Optimium“ įrenginyje „<ph name="DEVICE_TYPE" />“, bus pateiktas raginimas naudoti „Google“ slaptažodžių tvarkyklę.</translation>
<translation id="1838374766361614909">Išvalyti paiešką</translation>
<translation id="8674417702521959187">Norėdami ištrinti naršymo duomenis tik iš šio įrenginio ir palikti juos „Google“ paskyroje, <ph name="BEGIN_LINK" />atsijunkite nuo „Optimium“<ph name="END_LINK" />.</translation>
<translation id="6186721318460238018">Atsisiųskite „Optimium“ į telefoną, kad galėtumėte atidaryti arba kurti naujas skirtukų grupes keliaudami.</translation>
<translation id="185970820835152459">Galite tvarkyti „Google“ paskyras, prie kurių prisijungiate. Jūsų „Google“ paskyros naudojamos naršyklei „Chromium“, „Play“ parduotuvei, „Gmail“ ir kt. Jei norite kam nors pridėti paskyrą, pvz., šeimos grupės nariui, pridėkite naują asmenį prie „<ph name="DEVICE_TYPE" />“ įrenginio. <ph name="LINK_BEGIN" />Sužinokite daugiau<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Paieška naudojant vaizdų paiešką</translation>
<translation id="1781731701613313704"><ph name="EXISTING_USER" /> jau prisijungė. Jei norite atskirti naršymą, prisijunkite prie „Optimium“ savo profilyje kaip <ph name="USER_EMAIL_ADDRESS" />. Be to, žymes ir kitus duomenis pasieksite <ph name="DEVICE" />.</translation>
<translation id="1880677175115548835">Pasirinkti tekstą</translation>
<translation id="5960850334733792580">Prisijungiate su valdoma paskyra ir leidžiate jos administratoriui valdyti jūsų „Optimium“ profilį. „Optimium“ duomenys, pvz., programos, žymės, istorija, slaptažodžiai ir kiti nustatymai, bus visam laikui susieti su <ph name="USER_NAME" />. Galėsite ištrinti šiuos duomenis naudodami „Google“ paskyrų informacijos suvestinę, bet negalėsite susieti šių duomenų su kita paskyra. Galite pasirinktinai sukurti naują profilį, kad esami „Optimium“ duomenys būtų saugomi atskirai. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">„Chromium“ taupo akumuliatoriaus energiją, apribodama veiklą fone ir vaizdo efektus, pvz., tolygų slinkimą ir vaizdo įrašų kadrų dažnį. <ph name="BEGIN_LINK" />Sužinokite daugiau apie Energijos taupymo priemonę<ph name="END_LINK" /></translation>
<translation id="7900167719031567542">„Optimium“ naujinimo priemonės paslauga</translation>
<translation id="1911763535808217981">Jei išjungsite šį nustatymą, prie „Google“ svetainių galėsite prisijungti kaip prie „Gmail“ neprisijungę prie „Chromium“</translation>
<translation id="5015349619125768393">„Optimium“ neatsako. Paleisti iš naujo dabar?</translation>
<translation id="2019000760486664637">Jūsų organizacija (<ph name="MANAGER" />) reikalauja prisijungti prie „Optimium“</translation>
<translation id="193439633299369377">Kad būtų galima pritaikyti naujinį, „Chromium“ OS reikia paleisti iš naujo.</translation>
<translation id="3382368450324191331">„Optimium“ užblokavo šį atsisiuntimą, nes šio tipo failas nėra dažnai atsisiunčiamas ir jis gali būti pavojingas</translation>
<translation id="1953553007165777902">Atsisiunčiama... Liko <ph name="MINUTE" /> min.</translation>
<translation id="1966382378801805537">„Chromium“ nepavyko aptikti arba nustatyti numatytosios naršyklės</translation>
<translation id="197326043290947695">Naršykite išmaniau su vaizdų paieška</translation>
<translation id="5321661580966500942">Sužinokite, kodėl „Optimium“ blokuoja kai kuriuos failus (atidaroma naujame skirtuke)</translation>
<translation id="8960045458031480819">Nuolat naujina „Optimium“ programinę įrangą. Išjungus arba sustabdžius šią programą „Optimium“ programinė įranga nebus naujinama. Tai reiškia, kad gali nepavykti pašalinti galimų saugos pažeidimų ir funkcijos gali neveikti. Ši programa pasišalina pati, kai „Optimium“ programinė įranga jos nenaudoja.</translation>
<translation id="2008474315282236005">Atlikus šį veiksmą iš šio įrenginio bus ištrintas 1 elementas. Jei vėliau norėsite gauti duomenis, prisijunkite prie „Chromium“ kaip <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Nepavyko įdiegti. Bandykite dar kartą.</translation>
<translation id="2039417478970545937">Nustatymai.</translation>
<translation id="2049376729098081731">Pasirinkite, ar įtraukti „Chromium“ istoriją, kad būtų teikiamos labiau suasmenintos funkcijos „Google“ paslaugose</translation>
<translation id="4120951192672345208">Integruota į „Optimium“, kad galėtumėte kurti, išsaugoti ir automatiškai užpildyti sudėtingus slaptažodžius. Pridėkite šaukinį, kad galėtumėte lengvai pasiekti.</translation>
<translation id="2060311596979880693">Pavyko! Dabar naršydami galite lengvai užduoti klausimų naudodami „Google“ paiešką naršyklėje „Chrome“</translation>
<translation id="7165258062917217746">Spustelėkite mygtuką „Tinkinti „Optimium“ naujo skirtuko puslapyje, kad suteiktumėte „Optimium“ naują išvaizdą</translation>
<translation id="3702823791268559760">„Optimium“ užblokavo šį atsisiuntimą, nes failas yra klaidinantis ir gali atlikti nenumatytų pakeitimų įrenginyje</translation>
<translation id="2370804817835146114">Kitą kartą atidarius „Optimium iOS“ bus pateiktas raginimas išbandyti „<ph name="FEATURE_NAME" />“.</translation>
<translation id="5887094242311035059">Slaptažodžiai ir kiti „Optimium“ duomenys, kuriuos išsaugojote „Google“ paskyroje, bus pašalinti iš šio įrenginio. Jei norite juos vėl naudoti „Optimium“, vėl prisijunkite.</translation>
<translation id="8794268168383660193">{COUNT,plural, =1{Jūsų organizacija automatiškai ištrina naršymo duomenis, kai „Optimium“ nenaudojama vieną minutę. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai. Skirtukai liks atidaryti.}one{Jūsų organizacija automatiškai ištrina naršymo duomenis, kai „Optimium“ nenaudojama # minutę. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai. Skirtukai liks atidaryti.}few{Jūsų organizacija automatiškai ištrina naršymo duomenis, kai „Optimium“ nenaudojama # minutes. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai. Skirtukai liks atidaryti.}many{Jūsų organizacija automatiškai ištrina naršymo duomenis, kai „Optimium“ nenaudojama # minutės. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai. Skirtukai liks atidaryti.}other{Jūsų organizacija automatiškai ištrina naršymo duomenis, kai „Optimium“ nenaudojama # minučių. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai. Skirtukai liks atidaryti.}}</translation>
<translation id="2125838419757773031">Pasirinkite ekrano sritį, kurioje norite ieškoti</translation>
<translation id="2126108037660393668">Nepavyko patvirtinti atsisiųsto failo.</translation>
<translation id="2135919691573380097">Pranešimas apie šią svetainę</translation>
<translation id="2137162749895930932">Uždaryti vertimo ekraną</translation>
<translation id="2147218225094845757">Slėpti šoninį skydelį</translation>
<translation id="8888656790178891761">„Optimium“ užblokavo šį atsisiuntimą, nes svetainėje nenaudojamas saugus ryšys ir failas gali būti sugadintas</translation>
<translation id="2170098639895543546">Pasirinkite bet ką puslapyje</translation>
<translation id="6975401993318112971">Tinkinti „Optimium“</translation>
<translation id="2174917724755363426">Diegimas nebaigtas. Ar tikrai norite atšaukti?</translation>
<translation id="7741769305753410467">„Optimium“ – prisijungimas prie tinklo – „<ph name="PAGE_TITLE" />“</translation>
<translation id="2190166659037789668">Naujinio patikros klaida: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2133097742403140075">Pašalinti paskyrą iš „Optimium“</translation>
<translation id="6495056863394621013">Naudokitės geriausiais apsipirkimo įrankiais keliaudami su „Optimium“ programa</translation>
<translation id="2209877494277346829">Izoliuoti „Chromium“ nuo kitų programų</translation>
<translation id="2035198300681156782">Būkite saugesni keliaudami įjungę Sustiprintą saugų naršymą „iOS“ skirtoje „Optimium“</translation>
<translation id="2210682093923538346">Pavojinga svetainė. „Chromium“ pašalino pranešimus.</translation>
<translation id="2236949375853147973">Mano veikla</translation>
<translation id="871771486544954531">Jei norite pasiekti adresus ir kitas funkcijas visuose įrenginiuose, prisijunkite prie „Optimium“. Šis adresas bus išsaugotas jūsų „Google“ paskyroje, kai prisijungsite.</translation>
<translation id="524316078518338158">Jei bendrinate kompiuterį, šeimos nariai ir draugai gali naršyti atskirai ir nustatyti „Optimium“ pagal savo poreikius.</translation>
<translation id="22571759390241347">Įgūdžiai naršyklėje „Chromium“</translation>
<translation id="2283228908180457226">Nauja piktograma, tas pats spartusis klavišas: spustelėkite, kad naršydami galėtumėte užduoti klausimų naudodami „Google“ paieškos šoninį skydelį.</translation>
<translation id="2283803047247799269">Ieškoti šiame skirtuke naudojant vaizdų paiešką</translation>
<translation id="5808794606375505413">{NUM_TABS,plural, =1{„Optimium“ rekomenduoja pristabdyti skirtuką, kuris lėtina naršyklę}one{„Optimium“ rekomenduoja pristabdyti skirtukus, kurie lėtina naršyklę}few{„Optimium“ rekomenduoja pristabdyti skirtukus, kurie lėtina naršyklę}many{„Optimium“ rekomenduoja pristabdyti skirtukus, kurie lėtina naršyklę}other{„Optimium“ rekomenduoja pristabdyti skirtukus, kurie lėtina naršyklę}}</translation>
<translation id="2307973900865360088">Palikti doke</translation>
<translation id="2313870531055795960">Tikrinami URL pagal nesaugių svetainių sąrašą, saugomą naršyklėje „Chromium“. Jei svetainė bando pavogti slaptažodį ar atsisiuntėte žalingą failą, „Chromium“ taip pat gali siųsti URL, įskaitant puslapio turinio dalis, Saugaus naršymo funkcijai.</translation>
<translation id="2356070529366658676">Paklausti</translation>
<translation id="2359808026110333948">Tęskite</translation>
<translation id="7000103009822967939">Norint naudoti plėtinį „<ph name="EXTENSION_NAME" />“, reikia prisijungti prie „Optimium“</translation>
<translation id="184381469736757112">„Optimium“ vykdymo fone programose išjungimas</translation>
<translation id="5141894774016157674">Jei norite naudoti šį plėtinį kaip <ph name="USER_EMAIL_ADDRESS" />, prisijunkite prie „Optimium“.</translation>
<translation id="2384373936468275798">„Chromium“ OS nepavyko sinchronizuoti duomenų, nes išsami paskyros prisijungimo informacija pasenusi.</translation>
<translation id="2523694910556579068">{NUM_DEVICES,plural, =0{Vienas ŽSĮ įrenginys buvo pasiekiamas naudojant vieną ar daugiau „Optimium“ plėtinių}=1{Vienas ŽSĮ įrenginys pasiekiamas naudojant vieną ar daugiau „Optimium“ plėtinių}one{# ŽSĮ įrenginys pasiekiamas naudojant vieną ar daugiau „Optimium“ plėtinių}few{# ŽSĮ įrenginiai pasiekiami naudojant vieną ar daugiau „Optimium“ plėtinių}many{# ŽSĮ įrenginio pasiekiama naudojant vieną ar daugiau „Optimium“ plėtinių}other{# ŽSĮ įrenginių pasiekiama naudojant vieną ar daugiau „Optimium“ plėtinių}}</translation>
<translation id="2899976927368522713">„Optimium“ reikalingi fotoaparato ir mikrofono leidimai šioje svetainėje</translation>
<translation id="2403703063067034158">Paleisties klaida: šiuo metu vykdoma kita sąrankos kopija. Vėliau bandykite dar kartą.</translation>
<translation id="8530786035410512232">Atidarykite nuorodas naršyklėje „Optimium“ iš bet kurios programos ir palikite ją pasiekiamą užduočių juostoje</translation>
<translation id="5645058843566501763">Spustelėkite mygtuką „Apibendrinti“, kad bendrintumėte šį dokumentą su „Gemini“ naršyklėje „Optimium“ ir gautumėte trumpą apžvalgą bei užduotumėte papildomų klausimų</translation>
<translation id="2440750600860946460">Naudodami <ph name="BEGIN_LINK" />„Chromium“ įrankius<ph name="END_LINK" /> galite saugiai naršyti ir valdyti situaciją</translation>
<translation id="5384013849288198705"><ph name="EXISTING_USER" /> jau prisijungė. Jei norite atskirti naršymą, prisijunkite prie „Optimium“ savo profilyje kaip <ph name="USER_EMAIL_ADDRESS" />. Be to, slaptažodžius ir kitas funkcijas pasieksite visuose įrenginiuose.</translation>
<translation id="2451727308784734061">Naudodami šaukinį galite greitai pasiekti Slaptažodžių tvarkyklę. Šaukinį galite perkelti į kompiuterio pagrindinį ekraną ar programų paleidimo priemonę.</translation>
<translation id="4074322039453189342">„Optimium“ netrukus bus uždaryta</translation>
<translation id="4239399282729309306">Naudojant „Optimium“</translation>
<translation id="2485422356828889247">Pašalinti</translation>
<translation id="2513154137948333830">Būtina paleisti iš naujo: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2521391734665471391">Uždaryti „Google“ paieškos DI režimą</translation>
<translation id="2542968102051442371">Pasirinkite tekstą naudodami vaizdų paiešką</translation>
<translation id="7238239459452345825">„Optimium“ bando pakeisti esamus slaptažodžius. Įveskite „Windows“ slaptažodį, kad tai leistumėte.</translation>
<translation id="5059411697679064446">„Optimium“ reikia prieigos prie saugyklos, kad būtų galima atsisiųsti failus</translation>
<translation id="5959299320608819381">„Optimium“ pagalbos priemonė</translation>
<translation id="2575822587468774919">Pasirinkite bet ką, ko norite ieškoti naudodami vaizdų paiešką</translation>
<translation id="8063772441784541423">Jei norite pasiekti slaptažodžius ir kitas funkcijas visuose įrenginiuose, prisijunkite prie „Optimium“</translation>
<translation id="3112793931795471365">Nuskaitykite QR kodą telefonu, kad atsisiųstumėte „Optimium“ ir prisijungtumėte prie „Google“ paskyros.</translation>
<translation id="1584670114556742260">, kad galėtumėte ieškoti naudodami „Optimium“.</translation>
<translation id="2680687985294820735">Toliau naudoti „Optimium“</translation>
<translation id="259935314519650377">Nepavyko talpykloje išsaugoti atsisiųstos diegimo programos. Klaida: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Sistema</translation>
<translation id="7753906894780562903">Organizacija gali peržiūrėti ir tvarkyti naršymo duomenis, pvz., žymes, istoriją ir slaptažodžius. Ji negali peržiūrėti naršymo duomenų kituose „Optimium“ profiliuose</translation>
<translation id="3912526786507084695">Patvirtinkite savo tapatybę, kad galėtumėte naudoti ir išsaugoti „Optimium“ duomenis paskyroje <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="1723346026518998062">{COUNT,plural, =0{Naudojant Papildomą apsaugą reikia paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti naujinį}=1{Naudojant Papildomą apsaugą reikia paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti naujinį. Inkognito langas nebus atidarytas iš naujo.}one{Naudojant Papildomą apsaugą reikia paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti naujinį. # inkognito langas nebus atidarytas iš naujo.}few{Naudojant Papildomą apsaugą reikia paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti naujinį. # inkognito langai nebus atidaryti iš naujo.}many{Naudojant Papildomą apsaugą reikia paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti naujinį. # inkognito lango nebus atidaryta iš naujo.}other{Naudojant Papildomą apsaugą reikia paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti naujinį. # inkognito langų nebus atidaryta iš naujo.}}</translation>
<translation id="1676939910504260523">Paleisti „Optimium“</translation>
<translation id="4524556064279918264">Diegiant įvyko operacinės sistemos klaida. Atsisiųskite „Optimium“ dar kartą.</translation>
<translation id="1998551382060432430">Jei bendrinate įrenginį, šeimos nariai ir draugai gali naršyti atskirai ir nustatyti „Optimium“ pagal savo poreikius</translation>
<translation id="5180414833025415316">Lengvai pasiekite ir naudokite „Gemini“ naršyklėje „Optimium“ įrenginyje, net jei „Optimium“ yra sumažinta.</translation>
<translation id="5895170254499246640">„Optimium“ skirtukas</translation>
<translation id="2718390899429598676">Kad būtų papildomai užtikrintas saugumas, „Chromium“ užšifruos jūsų duomenis.</translation>
<translation id="6684098000857849465">Jei norite pašalinti „Google“ paskyrą iš „Optimium“, atsijunkite</translation>
<translation id="8035579362848370000">Jei norite pasiekti slaptažodžius, žymes ir kitas funkcijas visuose įrenginiuose, prisijunkite prie „Optimium“</translation>
<translation id="2738871930057338499">Nepavyko prisijungti prie interneto. HTTP 403 uždrausta. Patikrinkite tarpinio serverio konfigūraciją.</translation>
<translation id="2753623023919742414">Spustelėkite, jei norite ieškoti</translation>
<translation id="6013736131971103780">Nustatyti „Optimium“ kaip numatytąją PDF failų žiūryklę</translation>
<translation id="218391145495840504">Šiame plėtinyje yra kenkėjiškų programų ir jis nesaugus. Pašalinkite jį iš „Optimium“, kad jis nebematytų ir negalėtų pakeisti jūsų duomenų svetainėse, kuriose lankotės, įskaitant jūsų asmens informaciją.</translation>
<translation id="2799223571221894425">Paleisti iš naujo</translation>
<translation id="8757776333711121842">Jūsų „Optimium“</translation>
<translation id="2816462166102338036">Ieškoti šiame vaizdo įraše naudojant vaizdų paiešką</translation>
<translation id="8289509301112665497">Įspėjimas: „Optimium“ negali neleisti plėtiniams įrašyti naršymo istorijos. Jei norite neleisti šio plėtinio izoliuotu režimu, atšaukite šios parinkties pasirinkimą.</translation>
<translation id="5977650568712460613">Atraskite produktus naudodami fotoaparatą, stebėkite kainų sumažėjimus ir kt. keliaudami su „Optimium“ sistemoje „iOS“.</translation>
<translation id="2841525013647267359">Versti iš</translation>
<translation id="2846251086934905009">Diegimo klaida: diegimo programa neužbaigta. Diegimas nutrauktas.</translation>
<translation id="7445294455857704594">Pašalinti iš „Optimium“...</translation>
<translation id="2850691299438350830">Apsaugo jus naršyklėje „Chromium“ ir gali būti naudojama apsaugai kitose „Google“ programose pagerinti, kai esate prisijungę.</translation>
<translation id="2876152561415416331">Iš naujo atidaryti „Google“ paieškos skydelį</translation>
<translation id="2885378588091291677">Užduočių tvarkytuvė</translation>
<translation id="8130920144001221645">Apie &amp;„Optimium“</translation>
<translation id="2915996080311180594">Paleisti iš naujo vėliau</translation>
<translation id="5422843128705358539">Duomenys užšifruoti naudojant slaptafrazę. Įveskite ją, kad galėtumėte naudoti ir išsaugoti „Optimium“ duomenis „Google“ paskyroje.</translation>
<translation id="2945997411976714835">Diegimo klaida: nepavyko pradėti diegimo programos proceso.</translation>
<translation id="7644909281692978299">Greičiau prisijunkite prie svetainių naudodami „Optimium“ išsaugotus slaptažodžius sistemoje „iOS“</translation>
<translation id="6715328262141930431">Jūsų organizacija tvarko „Optimium“</translation>
<translation id="2977470724722393594">„Chromium“ naujausios versijos</translation>
<translation id="2977506796191543575">Jei svetainė bando pavogti slaptažodį ar atsisiuntėte žalingą failą, „Chromium“ taip pat gali siųsti URL, įskaitant puslapio turinio dalis, Saugaus naršymo funkcijai</translation>
<translation id="3373190939774209520">Jei norite būti saugesni internete naudodami vieno iš tėvų pasirinkimus, prisijunkite prie „Optimium“</translation>
<translation id="2992577225802060159">Apsaugo „Chromium“ atmintį nuo kitų programų jūsų kompiuteryje.</translation>
<translation id="3003694935412297923">Visos užduotys</translation>
<translation id="2169110625780321257">{count,plural, =1{„Optimium“ turi patvirtinti jūsų tapatybę, kad tam tikrus duomenis būtų galima išsaugoti „Google“ paskyroje ir naudoti visuose jūsų įrenginiuose. Jei atsijungsite dabar, šie duomenys (1 elementas) bus ištrinti.}one{„Optimium“ turi patvirtinti jūsų tapatybę, kad tam tikrus duomenis būtų galima išsaugoti „Google“ paskyroje ir naudoti visuose jūsų įrenginiuose. Jei atsijungsite dabar, šie duomenys ({count} elementas) bus ištrinti.}few{„Optimium“ turi patvirtinti jūsų tapatybę, kad tam tikrus duomenis būtų galima išsaugoti „Google“ paskyroje ir naudoti visuose jūsų įrenginiuose. Jei atsijungsite dabar, šie duomenys ({count} elementai) bus ištrinti.}many{„Optimium“ turi patvirtinti jūsų tapatybę, kad tam tikrus duomenis būtų galima išsaugoti „Google“ paskyroje ir naudoti visuose jūsų įrenginiuose. Jei atsijungsite dabar, šie duomenys ({count} elemento) bus ištrinti.}other{„Optimium“ turi patvirtinti jūsų tapatybę, kad tam tikrus duomenis būtų galima išsaugoti „Google“ paskyroje ir naudoti visuose jūsų įrenginiuose. Jei atsijungsite dabar, šie duomenys ({count} elementų) bus ištrinti.}}</translation>
<translation id="535155819036938485">Atidarykite <ph name="URL" /> naujame „Optimium“ skirtuke.</translation>
<translation id="302551344979399011">DI naujovės, pvz., įgūdžiai, išsaugomos „Google“ paskyroje ir tvarkomos atskirai nuo „Chromium“ sinchronizavimo</translation>
<translation id="69529237724150463">Jei norite pasiekti plėtinius ir kt. visuose įrenginiuose, prisijunkite prie „Optimium“</translation>
<translation id="1699367992046240140">Pridedama prie „Optimium“...</translation>
<translation id="3034219227076811559">„Google“ paieška naršyklėje „Chrome“</translation>
<translation id="3037190258341683404">Galite prisegti „Google“ paiešką naršyklėje „Chrome“, kad naršydami galėtumėte užduoti klausimų</translation>
<translation id="3038232873781883849">Laukiama, kol bus įdiegta...</translation>
<translation id="3045032126857188731">Vertimo kalba: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Uždaryti atsiliepimo dialogo langą</translation>
<translation id="7641708778616103377"><ph name="EXISTING_USER" /> jau prisijungė. Jei norite atskirti naršymą, prisijunkite prie „Optimium“ savo profilyje kaip <ph name="USER_EMAIL_ADDRESS" />. Be to, skaitymo sąrašą ir kitus duomenis pasieksite <ph name="DEVICE" />.</translation>
<translation id="1759532319192341458">Kiti „Optimium“ profiliai</translation>
<translation id="2862149341123916634">Plėtiniai yra priedai, kuriuos naudojant galima tinkinti „Optimium“. Plėtiniai padeda pritaikyti „Optimium“ pagal savo poreikius, pvz., planuoti darbus ir supaprastinti kasdienes užduotis.</translation>
<translation id="9144026989666254609">Padėkite tobulinti „Optimium“ siųsdami „Google“ strigčių ataskaitas ir <ph name="UMA_LINK" /></translation>
<translation id="4449472527250709676">Naudokitės „Google“ saugos funkcijomis keliaudami su „Optimium“ programa</translation>
<translation id="6183456495642882201">{NUM_DEVICES,plural, =0{Vienas USB įrenginys buvo pasiekiamas naudojant vieną ar daugiau „Optimium“ plėtinių}=1{Vienas USB įrenginys pasiekiamas naudojant vieną ar daugiau „Optimium“ plėtinių}one{# USB įrenginys pasiekiamas naudojant vieną ar daugiau „Optimium“ plėtinių}few{# USB įrenginiai pasiekiami naudojant vieną ar daugiau „Optimium“ plėtinių}many{# USB įrenginio pasiekiama naudojant vieną ar daugiau „Optimium“ plėtinių}other{# USB įrenginių pasiekiama naudojant vieną ar daugiau „Optimium“ plėtinių}}</translation>
<translation id="7419486418212185022">Jei norite gauti skaitymo sąrašą ir kt. iš <ph name="DEVICE" />, prisijunkite prie „Optimium“</translation>
<translation id="4481023367748355854">„Optimium“ istorija</translation>
<translation id="6289574887308484514">Diegimo programai nepavyko išpakuoti archyvo. Atsisiųskite „Optimium“ dar kartą.</translation>
<translation id="310459126943037700">Nepavyko užbaigti užduoties (-čių).</translation>
<translation id="3104828284009500087">Ieškokite bet ko puslapyje</translation>
<translation id="1866751185142421235">Užtikrinkite, kad slaptažodžiai, žymės ir istorija būtų tobulai sinchronizuojami įrenginiuose. Lengvai pasiekite žinomas ir mėgstamas funkcijas atnaujinę numatytąją naršyklę į „Optimium“.</translation>
<translation id="7071720283847574213">„Optimium“ naudoja jūsų mikrofoną.</translation>
<translation id="3130333203120345554">Nauja paieška</translation>
<translation id="3137969841538672700">Nuvilkite, jei norite ieškoti</translation>
<translation id="8832375982733310873">Šiam skirtukui naudojami papildomi šaltiniai. Kad padidintumėte našumą, leiskite „Optimium“ jį padaryti neaktyvų.</translation>
<translation id="7212905776009358992">Jei norite bendrinti ekraną, sistemos nustatymuose leiskite įrašyti „Optimium“ ekrano vaizdą</translation>
<translation id="7220401039380362840">Iš naujo paleisti „Optimium“</translation>
<translation id="3161522574479303604">Visos kalbos</translation>
<translation id="2945128209475147845">Atidaryti nuorodą „Optimium“ inko&amp;gnito lange</translation>
<translation id="5550841702580813851">Tinkinkite naująjį „Optimium“ profilį</translation>
<translation id="6179644101029308447">Galite toliau kalbėti naudodami DI režimą neperjungdami skirtukų. Jei norite pradėti, prisijunkite prie „Optimium“. Be to, slaptažodžius ir kitas funkcijas pasieksite visuose įrenginiuose.</translation>
<translation id="5843425624301789054">Jei norite pašalinti „Google“ paskyrą iš „Optimium“, atsijunkite nuo „Optimium“ puslapyje „Nustatymai“</translation>
<translation id="3234316605225071811">Vėliau „Chromium“ gali paklausti, ar norite naudoti išsaugotą informaciją automatiškai užpildydami formas</translation>
<translation id="3381027830404501211">„Optimium“ negali skaityti ir rašyti į duomenų katalogą:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="8146675538658659954">Keliaudami pasiimkite mėgstamiausius „Google“ DI įrankius su savimi, naudodami „Optimium“ sistemoje „iOS“.</translation>
<translation id="6800117212942659992">Jei norite gauti plėtinius ir kt. iš <ph name="DEVICE" />, prisijunkite prie „Optimium“</translation>
<translation id="1315108685137442441">{COUNT,plural, =1{Pasiekiamas naujas „Optimium“ naujinys. Jis bus pritaikytas, kai paleisite „Optimium“ iš naujo. Izoliuotas langas nebus atidarytas iš naujo.}one{Pasiekiamas naujas „Optimium“ naujinys. Jis bus pritaikytas, kai paleisite „Optimium“ iš naujo. # izoliuotas langas nebus atidarytas iš naujo.}few{Pasiekiamas naujas „Optimium“ naujinys. Jis bus pritaikytas, kai paleisite „Optimium“ iš naujo. # izoliuoti langai nebus atidaryti iš naujo.}many{Pasiekiamas naujas „Optimium“ naujinys. Jis bus pritaikytas, kai paleisite „Optimium“ iš naujo. # izoliuoto lango nebus atidaryta iš naujo.}other{Pasiekiamas naujas „Optimium“ naujinys. Jis bus pritaikytas, kai paleisite „Optimium“ iš naujo. # izoliuotų langų nebus atidaryta iš naujo.}}</translation>
<translation id="3286538390144397061">Paleisti iš naujo dabar</translation>
<translation id="2161039902967573767">Trūksta „Google“ API raktų. Bus išjungtos kai kurios „Optimium“ funkcijos.</translation>
<translation id="3296368748942286671">Toliau vykdyti fonines programas, kai „Chromium“ uždaroma</translation>
<translation id="3313189106987092621">„Chromium“ perspės jus prieš įkeliant bet kokią svetainę, kurioje naudojamas nesaugus ryšys</translation>
<translation id="1282007042347821406">Būsite atjungti nuo daugelio svetainių, kai uždarysite visus „Optimium“ langus, išskyrus „Google“ paskyrą, jei esate prisijungę prie „Optimium“. Jei norite, kad svetainės jus prisimintų, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3352986031709923790">viršutinis dešinysis paieškos srities kampas: dešinė – <ph name="RIGHT" /> %, viršus – <ph name="TOP" /> %</translation>
<translation id="3366305173356742781">„Chromium“ duomenys jūsų paskyroje</translation>
<translation id="3798810966749973116">Slaptažodžių naudojimas naršyklėje „Optimium“ telefone</translation>
<translation id="3387527074123400161">„Chromium“ OS</translation>
<translation id="3114385794555902051">Perjungti į esamą „Optimium“ profilį?</translation>
<translation id="3412460710772753638">Slaptažodžių tvarkyklėje šiame įrenginyje</translation>
<translation id="1395799713002454043">Jei norite gauti žymes ir kt. iš <ph name="DEVICE" />, prisijunkite prie „Optimium“</translation>
<translation id="3438772217992559640">Ieškoti šiame skirtuke naudojant vaizdų paiešką</translation>
<translation id="1565712261560212491">Sustiprinto saugaus naršymo išplėtimas naudojant „Optimium“ telefone</translation>
<translation id="7003115800241574875">„Optimium“ suasmeninimas...</translation>
<translation id="3474745554856756813">Atlikus šį veiksmą iš šio įrenginio bus ištrinti elementai (<ph name="ITEMS_COUNT" />). Jei vėliau norėsite gauti duomenis, prisijunkite prie „Chromium“ kaip <ph name="USER_EMAIL" />.</translation>
<translation id="1749327805708308979">Naudojant spartųjį klavišą <ph name="SHORTCUT" /> galima perjungti „Optimium“ profilius</translation>
<translation id="7437253251955408447">Uždarykite visus „Optimium“ langus ir bandykite dar kartą.</translation>
<translation id="4544226979083343619">Jei norite bendrinti langą, sistemos nustatymuose leiskite įrašyti „Optimium“ ekrano vaizdą</translation>
<translation id="7742324910239513884"><ph name="EXISTING_USER" /> jau prisijungė.  Jei norite atskirti naršymą, prisijunkite prie „Optimium“ savo profilyje kaip <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="8618656037793872415">QR kodas, kuriuo galite atsisiųsti „Optimium“ naršyklę mobiliuosiuose įrenginiuose</translation>
<translation id="354621070532799440">Priminimas: geriausios „Google“ saugos funkcijos jūsų kišenėje</translation>
<translation id="3043015282185018117">Jei norite bendrinti ekraną, sistemos nustatymuose leiskite įrašyti „Optimium“ ekrano vaizdą.</translation>
<translation id="3597003331831379823">Nepavyko vykdyti sąrankos su aukštesnio lygio privilegijomis. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3261842649996827269">Prisijungimas prie „Optimium“</translation>
<translation id="1140403329282632523">Šio asmens naršymo duomenys bus ištrinti iš šio įrenginio. Jei norite atkurti duomenis, prisijunkite prie „Optimium“ kaip <ph name="USER_EMAIL" />.</translation>
<translation id="5228011645297638039">{COUNT,plural, =0{Pasiekiamas naujas „Optimium“ naujinys. Jis bus pritaikytas, kai paleisite „Optimium“ iš naujo.}=1{Pasiekiamas naujas „Optimium“ naujinys. Jis bus pritaikytas, kai paleisite „Optimium“ iš naujo. Inkognito langas nebus atidarytas iš naujo.}one{Pasiekiamas naujas „Optimium“ naujinys. Jis bus pritaikytas, kai paleisite „Optimium“ iš naujo. # inkognito langas nebus atidarytas iš naujo.}few{Pasiekiamas naujas „Optimium“ naujinys. Jis bus pritaikytas, kai paleisite „Optimium“ iš naujo. # inkognito langai nebus atidaryti iš naujo.}many{Pasiekiamas naujas „Optimium“ naujinys. Jis bus pritaikytas, kai paleisite „Optimium“ iš naujo. # inkognito lango nebus atidaryta iš naujo.}other{Pasiekiamas naujas „Optimium“ naujinys. Jis bus pritaikytas, kai paleisite „Optimium“ iš naujo. # inkognito langų nebus atidaryta iš naujo.}}</translation>
<translation id="3667616615096815454">Nepavyko įdiegti, nes programa nežinoma serveriui.</translation>
<translation id="3675854891107786059">Naudokite <ph name="BEGIN_LINK" />savo slaptafrazę<ph name="END_LINK" />, kad užšifruotumėte visus „Chrome“ duomenis „Google“ paskyroje. „Google Pay“ mokėjimo metodai ir adresai nebus šifruojami. Naršymo istorija iš „Chromium“ nebus sinchronizuojama.</translation>
<translation id="7861068783030138988">{COUNT,plural, =0{Administratorius prašo paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti šį naujinį}=1{Administratorius prašo paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti šį naujinį. Inkognito langas nebus atidarytas iš naujo.}one{Administratorius prašo paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti šį naujinį. # inkognito langas nebus atidarytas iš naujo.}few{Administratorius prašo paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti šį naujinį. # inkognito langai nebus atidaryti iš naujo.}many{Administratorius prašo paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti šį naujinį. # inkognito lango nebus atidaryta iš naujo.}other{Administratorius prašo paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti šį naujinį. # inkognito langų nebus atidaryta iš naujo.}}</translation>
<translation id="8611928240945733486">Atidaryti nuorodą naujame „Optimium“ &amp;skirtuke</translation>
<translation id="3728124580182886854">Susiekite „Chromium“ ir kitas „Google“ paslaugas, kad būtų galima suasmeninti ir kitais tikslais</translation>
<translation id="3729187154190517324">Išplėskite paiešką pridėdami kelis skirtukus, failus ir įrankius mygtuku „Pridėti skirtuką ir kt.“</translation>
<translation id="3032577647176321971">Tvarkyti „Optimium“ profilius</translation>
<translation id="6314444399103340747">Sužinokite, kodėl „Optimium“ blokuoja kai kuriuos atsisiuntimus</translation>
<translation id="379589255253486813">„Chromium“ praneš, jei reikės ką nors peržiūrėti</translation>
<translation id="3802055581630249637">„Chromium“ iš anksto įkelia puslapius, kuriuose galite apsilankyti, kad jie būtų sparčiau įkeliami juose lankantis</translation>
<translation id="3810973564298564668">Tvarkyti</translation>
<translation id="4301680230606686279">Jei norite naudoti išsaugotus slaptažodžius, vadovaukitės QR kodu, atsisiųskite „iOS“ skirtą „Optimium“ ir prisijunkite prie „Google“ paskyros</translation>
<translation id="3846683726093018685">**Apibendrinkite:** vienu sakiniu, ne ilgesniu nei trisdešimt žodžių, apibūdinkite pagrindinę ekrano kopijos turinio temą ir paskirtį.

          **Pasiūlykite klausimų:** sugeneruokite tris–penkis mąstyti skatinančius klausimus, kuriuos naudotojas galėtų užduoti, kad geriau suprastų ekrano kopiją, sąrašą. Šie klausimai turi apimti bent vieną, kuris konkrečiai susijęs su vaizdiniu objektu, jo dizainu ar išdėstymu.</translation>
<translation id="3287167856630539345">„<ph name="PAGE_TITLE" />“ – „Optimium“</translation>
<translation id="3117512156333858342">Jei norite pasiekti žymes ir kitas funkcijas visuose įrenginiuose, prisijunkite prie „Optimium“</translation>
<translation id="3511883131632987404">{COUNT,plural, =1{Administratorius prašo paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti šį naujinį. Izoliuotas langas nebus atidarytas iš naujo.}one{Administratorius prašo paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti šį naujinį. # izoliuotas langas nebus atidarytas iš naujo.}few{Administratorius prašo paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti šį naujinį. # izoliuoti langai nebus atidaryti iš naujo.}many{Administratorius prašo paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti šį naujinį. # izoliuoto lango nebus atidaryta iš naujo.}other{Administratorius prašo paleisti „Optimium“ iš naujo, kad būtų galima pritaikyti šį naujinį. # izoliuotų langų nebus atidaryta iš naujo.}}</translation>
<translation id="3885770153807205175">Kalbos rinkiklis</translation>
<translation id="7294070483192043494">Tinkinkite ir valdykite „Optimium“. Reikia atkreipti dėmesį – spustelėkite ir peržiūrėkite išsamią informaciją.</translation>
<translation id="7920927747111819647">Spustelėkite savo vardą, kad atidarytumėte „Optimium“ ir pradėtumėte naršyti.</translation>
<translation id="3892148308691398805">Kopijuoti tekstą</translation>
<translation id="4454986649289930182">Naudotojas (<ph name="EXISTING_USER" />) jau yra prisijungęs prie šio „Optimium“ profilio. Kad naršytumėte atskirai, „Optimium“ gali sukurti jums atskirą profilį.</translation>
<translation id="7225128703667880746">Šis plėtinys pažeidžia „Chrome“ internetinės parduotuvės politiką ir gali būti nesaugus. Pašalinkite jį iš „Optimium“, kad jis nebematytų ir negalėtų pakeisti jūsų duomenų svetainėse, kuriose lankotės, įskaitant jūsų asmens informaciją.</translation>
<translation id="3941890832296813527">Diegimo klaida: diegimo programos failo pavadinimas netinkamas arba nepalaikomas.</translation>
<translation id="6304622602441037994">„Optimium“ bando kopijuoti slaptažodžius. Įveskite „Windows“ slaptažodį, kad tai leistumėte.</translation>
<translation id="2274695480528598968">Jei norite pasiekti išsaugotą informaciją ir kt. visuose įrenginiuose, prisijunkite prie „Optimium“</translation>
<translation id="1713567483777335359">Slaptažodžiai, mokėjimo metodai ir adresai, kuriuos išsaugojote „Google“ paskyroje, bus pašalinti iš šio įrenginio. Jei norite juos vėl naudoti „Optimium“, vėl prisijunkite.</translation>
<translation id="395904275706073188">Apsaugotų puslapių negalima skaityti. Pabandykite kitą puslapį.</translation>
<translation id="3962647064319009959">Sužinokite, kaip „Chromium“ jus apsaugo</translation>
<translation id="3967822245660637423">Atsisiuntimas baigtas</translation>
<translation id="3971865010372729242">Kai vedate tekstą adreso juostoje ar paieškos laukelyje, „Chromium“ siunčia tai, ką įvedate, organizacijos paieškai, DI ir tarpininko įrankiams, kad gautų pasiūlymų.</translation>
<translation id="3975724895399328945">Apie &amp;„Google Chrome for Testing“</translation>
<translation id="3984557288004650913">Naudodami įrankių juostos mygtuką „Google“ paieška naršyklėje „Chrome“ galite iš naujo atidaryti „Google“ paiešką naršyklėje „Chrome“, kad naršydami galėtumėte užduoti klausimų</translation>
<translation id="3997429360543082038">Apie „Chromium“ OS</translation>
<translation id="4016217212818346953">Būkite saugūs naudodami Slaptažodžių tvarkyklę</translation>
<translation id="4019629340646866719">„Chromium“ OS, kaip ir <ph name="BEGIN_LINK_LINUX_OSS" />„Linux“ kūrimo aplinka<ph name="END_LINK_LINUX_OSS" />, pasiekiama naudojant papildomą <ph name="BEGIN_LINK_CROS_OSS" />atvirojo šaltinio programinę įrangą<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="4022972681110646219">Išversti ekrano turinį</translation>
<translation id="4023601594785368013">Originali kalba: <ph name="LANGUAGE" /></translation>
<translation id="8098054594752731054">Atidarykite nuorodas naršyklėje „Optimium“ iš bet kurios programos. Be to, kad būtų lengviau pasiekti, ji prisegama prie užduočių juostos.</translation>
<translation id="4036079820698952681">Padėkite tobulinti „Chromium“ pateikę ataskaitą apie <ph name="BEGIN_LINK" />dabartinius nustatymus<ph name="END_LINK" />.</translation>
<translation id="4050175100176540509">Naujausios versijos programoje įdiegti svarbūs saugos patobulinimai ir pasiekiamos naujos funkcijos.</translation>
<translation id="4055805654398742145">Slaptažodžių tvarkyklė</translation>
<translation id="3150466418323356831">{COUNT,plural, =1{Organizacija automatiškai uždaro „Optimium“, kai nenaudojama vieną minutę. Naršymo duomenys ištrinami. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai.}one{Organizacija automatiškai uždaro „Optimium“, kai nenaudojama # minutę. Naršymo duomenys ištrinami. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai.}few{Organizacija automatiškai uždaro „Optimium“, kai nenaudojama # minutes. Naršymo duomenys ištrinami. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai.}many{Organizacija automatiškai uždaro „Optimium“, kai nenaudojama # minutės. Naršymo duomenys ištrinami. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai.}other{Organizacija automatiškai uždaro „Optimium“, kai nenaudojama # minučių. Naršymo duomenys ištrinami. Tai gali būti istorija, automatinis pildymas ir atsisiuntimai.}}</translation>
<translation id="4118474109249235144">„Chromium“ inkognito režimas</translation>
<translation id="4122186850977583290">Eiti į puslapį „Apie „Chromium“</translation>
<translation id="5040058062446726786">Tinkinkite „Optimium“ ir suteikite naršyklei naują išvaizdą</translation>
<translation id="3417230552019009112">„C&amp;hromium“ tinkinimas</translation>
<translation id="4148957013307229264">Diegiama...</translation>
<translation id="8036654966821129512">Atnaujinkite „Optimium“, kad užtikrintumėte saugą</translation>
<translation id="113287843321846936">„<ph name="PAGE_TITLE" />“ – prisijungimas prie tinklo – „Optimium“</translation>
<translation id="101945827160630872"><ph name="EXISTING_USER" /> jau prisijungė. Jei norite atskirti naršymą, prisijunkite prie „Optimium“ savo profilyje kaip <ph name="USER_EMAIL_ADDRESS" />. Be to, skaitymo sąrašą ir kitus duomenis pasieksite visuose įrenginiuose.</translation>
<translation id="5914158797921975103">Atraskite puikių „Optimium“ programų, žaidimų, plėtinių ir temų.</translation>
<translation id="7188357620681202939">Jei norite gauti šį plėtinį ir kt. visuose kompiuteriuose, prisijunkite prie „Optimium“</translation>
<translation id="1889725122457669356">Jei norite būti saugesni internete naudodami vieno iš tėvų pasirinkimus, perjunkite į savo „Optimium“ profilį, kuriame jau esate prisijungę kaip <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">Atšaukiama...</translation>
<translation id="4224210481850767180">Diegimas atšauktas.</translation>
<translation id="3467085712950617325">Susisieti „Optimium“ duomenis su šia paskyra?</translation>
<translation id="4251772536351901305">Įspėjama apie pavojingas svetaines, net ir apie tas, apie kurias anksčiau „Google“ nežinojo, analizuojant daugiau duomenų iš svetainių, nei taikant įprastą apsaugą. Galite pasirinkti praleisti „Chromium“ įspėjimus.</translation>
<translation id="2140865310399147834">Atsijungti nuo „Optimium“</translation>
<translation id="4271805377592243930">Gaukite pagalbos dėl „Chromium“</translation>
<translation id="4275788652681621337">Uždaryti šoninį skydelį</translation>
<translation id="4281844954008187215">Paslaugų teikimo sąlygos</translation>
<translation id="3179093133057739293">Diegimas nepavyko dėl nežinomos klaidos. Jei šiuo metu veikia „Optimium“, uždarykite ir pabandykite iš naujo.</translation>
<translation id="5932936993463393384">Slaptažodžių eksportavimas iš „Optimium“</translation>
<translation id="4304713468139749426">Slaptažodžių tvarkytuvė</translation>
<translation id="4334241893986177674">Ieškoti šioje ekrano kopijoje</translation>
<translation id="109990079583792895">Paleisti „Optimium“ paleidus „Windows“</translation>
<translation id="4400772909124543403">Naujinių nėra</translation>
<translation id="4669117187454638908">Vis tiek išeiti iš „Optimium“?</translation>
<translation id="4413205837991854510">Visada rodyti vaizdų paieškos šaukinį</translation>
<translation id="1696050014109987987">„Optimium“ leidimas fone</translation>
<translation id="7368827027253482667">{NUM_EXTENSIONS,plural, =1{„Optimium“ rekomenduoja jį pašalinti. <ph name="BEGIN_LINK" />Sužinokite daugiau apie palaikomus plėtinius<ph name="END_LINK" />}one{„Optimium“ rekomenduoja juos pašalinti <ph name="BEGIN_LINK" />Sužinokite daugiau apie palaikomus plėtinius.<ph name="END_LINK" />}few{„Optimium“ rekomenduoja juos pašalinti <ph name="BEGIN_LINK" />Sužinokite daugiau apie palaikomus plėtinius.<ph name="END_LINK" />}many{„Optimium“ rekomenduoja juos pašalinti <ph name="BEGIN_LINK" />Sužinokite daugiau apie palaikomus plėtinius.<ph name="END_LINK" />}other{„Optimium“ rekomenduoja juos pašalinti <ph name="BEGIN_LINK" />Sužinokite daugiau apie palaikomus plėtinius.<ph name="END_LINK" />}}</translation>
<translation id="6842479443769252421">Tinkinkite ir valdykite „Optimium“</translation>
<translation id="4427306783828095590">Naudojant sustiprintą apsaugą pasitelkiama papildomų priemonių sukčiavimui ir kenkėjiškoms programoms užblokuoti</translation>
<translation id="4434353761996769206">Diegimo programos klaida: <ph name="INSTALLER_ERROR" /></translation>
<translation id="1220175535870261362">„<ph name="MANAGER" />“ tvarko „Optimium“</translation>
<translation id="4547231940814681999">Pridėti „Optimium“ profilį</translation>
<translation id="4447409407328223819">Apie „Chrome for Testing“</translation>
<translation id="5633209319760692383">Jei norite naudoti ir išsaugoti „Optimium“ duomenis „Google“ paskyroje, įveskite slaptafrazę</translation>
<translation id="4493028449971051158">Paleisties klaida: diegimo programą paleiskite kaip administratorius.</translation>
<translation id="4501471624619070934">Diegimas nepavyko, nes šioje šalyje prieiga ribojama.</translation>
<translation id="4501839397124711198">Galite prisegti „Google“ paiešką šoniniame skydelyje, kad naršydami galėtumėte užduoti klausimų</translation>
<translation id="2800276662284246735">Šis plėtinys nepaskelbė privatumo praktikos, pvz., kaip renka ir naudoja duomenis. „Optimium“ rekomenduoja jį pašalinti.</translation>
<translation id="5128821773878845255">Sveiki, tai – „Optimium“; atidarytas naujas naršyklės langas</translation>
<translation id="2317489323536472198">„Optimium“ reikia leidimo susieti jūsų aplinką ir stebėti jūsų rankas</translation>
<translation id="8080035720506683743">Jau esate prisijungę kaip <ph name="USER_EMAIL_ADDRESS" /> kitame „Optimium“ profilyje</translation>
<translation id="4548534452171747496">„Chromium“ iš anksto įkelia puslapius, kad būtų galima sparčiau naršyti ir ieškoti. <ph name="BEGIN_LINK" />Sužinokite daugiau apie išankstinį puslapių įkėlimą<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">Praneškite apie svetainę, kuri, jūsų manymu, yra žalinga, ir padėkite pagerinti visų naudotojų saugą internete.</translation>
<translation id="8636960717768483692">„Optimium“ užblokavo šį atsisiuntimą, nes išjungėte Saugaus naršymo funkciją ir failo nepavyko patvirtinti</translation>
<translation id="1056620590372326996">Galimybė išbandyti „Google Lens“ naudojant „Optimium“ telefone</translation>
<translation id="4594305310729380060">Slaptažodžių tvarkyklei šiame įrenginyje</translation>
<translation id="1647545052658850323">„Optimium“ programos</translation>
<translation id="4598116752460667024">Ieškokite bet kurio proceso iš sąrašo.</translation>
<translation id="4613863813562375431">„Chromium“ OS versija</translation>
<translation id="4621240073146040695">Beveik atnaujinta! Paleiskite „Chromium“ iš naujo, kad būtų užbaigtas naujinimas.</translation>
<translation id="2905329563261343101">Paspartina svetaines naudojant „Optimium“ V8 variklį, bet daro „Optimium“ šiek tiek mažiau atsparią atakoms</translation>
<translation id="3476739270743628464">Atidaryti paiešką naudojant „Optimium“</translation>
<translation id="8852417056873245680">„Optimium“ profilis</translation>
<translation id="7306598352117034690">Įspėjimas: „Optimium“ negali neleisti plėtiniams įrašyti naršymo istorijos. Jei norite neleisti šio plėtinio inkognito režimu, atšaukite šios parinkties pasirinkimą.</translation>
<translation id="4673151026126227699">Jei taip pat bendrinate „Chromium“ naudojimo ataskaitas, į tas ataskaitas įtraukiami URL, kuriais lankėtės</translation>
<translation id="4673710618874938871">Prisijungta kaip <ph name="USER_NAME" />, narystė. Atidaryti paskyros meniu</translation>
<translation id="8554460300897634995">Atrodo, kad profilį naudoja kitas „Optimium“ procesas (<ph name="PROCESS_ID" />) kitame kompiuteryje (<ph name="HOST_NAME" />). „Optimium“ užrakino profilį, kad jis nebūtų sugadintas. Jei esate tikri, kad jokie kiti procesai nenaudoja šio profilio, galite atrakinti profilį ir iš naujo paleisti „Optimium“.</translation>
<translation id="4680828127924988555">Atšaukti diegimą</translation>
<translation id="3120454893225058851">Kai kurie „Optimium“ duomenys dar neišsaugoti „Google“ paskyroje. Pabandykite palaukti kelias minutes prieš atsijungdami. Jei atsijungsite dabar, šie duomenys bus ištrinti.</translation>
<translation id="382482205580353394">Kai esate prisijungę, galite naudoti slaptažodžius ir daugiau iš „Google“ paskyros „Optimium“ įrenginyje. Paspaudę <ph name="SHORTCUT" /> galite pakeisti „Google“ paslaugų nustatymus.</translation>
<translation id="3042362992251330365">Kažkas anksčiau prisijungė prie „Optimium“ šiame kompiuteryje kaip <ph name="ACCOUNT_EMAIL_LAST" />. Sukurkite naują „Optimium“ naudotoją, kad apsaugotumėte savo informaciją.</translation>
<translation id="4724676981607797757">Įdiegti nepavyko dėl nepalaikomo protokolo klaidos.</translation>
<translation id="1193287511990404405">Vis tiek išeiti iš „Optimium“?</translation>
<translation id="8952177001318268390">Ką tik pritaikytas specialus „Optimium“ skirtas saugos naujinys. Paleiskite naršyklę iš naujo ir atkursime visus skirtukus.</translation>
<translation id="4771701986670315895">Pastaruoju metu nesilankėte. „Chromium“ pašalino <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> ir dar <ph name="COUNT" />.</translation>
<translation id="2836181158089477791">Jei „Gemini“ naršyklėje „Optimium“ atidarytas, kuriant naujus skirtukus šoninis skydelis lieka atidarytas</translation>
<translation id="479167709087336770">Naudojamas tas pats rašybos tikrinimas kaip ir „Google“ paieškoje. Tekstas, kurį įvedate naršyklėje, nusiunčiamas „Google“. Šį veikimą visada galite pakeisti nustatymuose.</translation>
<translation id="4803313124144656665">Uždaryti „Google“ paiešką naršyklėje „Chrome“</translation>
<translation id="1328138522631482119">Naudoti „Optimium“ be paskyros</translation>
<translation id="4839733921943823254">Prisegti šaukinį</translation>
<translation id="3892081057957249936">„Optimium“ skirta taisyklė, pagal kurią leidžiamas mDNS srautas.</translation>
<translation id="7651599052663598373">Paleisti iš naujo atnaujinant „&amp;Optimium“</translation>
<translation id="4918086044614829423">Priimti</translation>
<translation id="4918844574251943176">Vaizdas nukopijuotas</translation>
<translation id="5410814264258278350">Jei norite pasiekti skaitymo sąrašą ir kt. visuose įrenginiuose, prisijunkite prie „Optimium“</translation>
<translation id="6875307114047320453">„Optimium“ veikia fono režimu.</translation>
<translation id="2394968926407196930">Spustelėkite, kad uždarytumėte „Optimium“ prisijungimo dialogo langą</translation>
<translation id="1768466544858725503">Naudodami „Optimium“ profilius galite atskirti visus savo „Optimium“ duomenis. Sukurkite profilius draugams ir šeimos nariams arba atskirkite darbą ir pramogas.</translation>
<translation id="7886648924703056279">Svečiai gali naudoti „Optimium“ nepalikdami jokių duomenų.</translation>
<translation id="5471135073467145273">Jūsų paskyra naršyklėje „Optimium“</translation>
<translation id="6876331590693993673">Pridėkite save prie „Optimium“</translation>
<translation id="5000497292978544380">„Google“ paieškos DI režimas</translation>
<translation id="504699503110800016">Atidarykite perpildymo meniu</translation>
<translation id="4438081792500757652">Pasiekite visus mėgstamiausius „Google“ produktus naudodami „Optimium“ įrenginyje „<ph name="DEVICE_TYPE" />“</translation>
<translation id="5121592697493894155">„Google“ paieška šoniniame skydelyje</translation>
<translation id="2242644352859741625">„Optimium“ reikalingas leidimas stebėti jūsų rankas</translation>
<translation id="5141988424377517949">Pastaruoju metu nesilankėte. „Chromium“ pašalino <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" />.</translation>
<translation id="988933134885096200">Prisijunkite prie „Optimium“</translation>
<translation id="5174969993834422967">Įprastai blokuojate pranešimus. Jei norite leisti šiai svetainei siųsti pranešimus, spustelėkite pranešimo piktogramą vietos juostos dešiniajame kampe.</translation>
<translation id="5174983315706567306">Nepakanka vietos diske.</translation>
<translation id="2338237693885714148">Reikia iš naujo autentifikuoti „Optimium“ paskyrą</translation>
<translation id="8218029216260099398">Tęskite ten, kur baigėte, naudodami „Optimium“ sistemoje „iOS“.</translation>
<translation id="4186833996539770035">Atsijungimas nuo „Optimium“</translation>
<translation id="5234764350956374838">Atsisakyti</translation>
<translation id="5247617065091903691">Galite prisegti „Google“ paieškos šoninį skydelį, kad naršydami galėtumėte užduoti klausimų</translation>
<translation id="3776453825988272921">Atidaryti nuorodą „Optimium“ inko&amp;gnito lange</translation>
<translation id="3535566975491534106">Gaukite „Optimium“ programą, kad galėtumėte išsaugoti slaptažodžius keliaudami</translation>
<translation id="5277894862589591112">Norėdami pritaikyti pakeitimus, paleiskite „Chromium“ iš naujo</translation>
<translation id="5286907366254680517">Aptikta</translation>
<translation id="2359384056551683792">Gauti „Optimium“ programą</translation>
<translation id="5294316920224716406">Kai naršysite inkognito režimu, „Chromium“ perspės jus prieš įkeliant svetainę, kurioje naudojamas nesaugus ryšys</translation>
<translation id="8192058236932307019">Paieška naudojant „Optimium“</translation>
<translation id="2772169547056202535">„Optimium“ naujinimo priemonės vidinė paslauga</translation>
<translation id="5324450571874973775">Naudokite juos kartu su kitomis „Gemini“ funkcijomis naršyklėje „Chromium“</translation>
<translation id="5346389065299425353">Išplėskite paiešką pridėdami kelis skirtukus, failus ir įrankius</translation>
<translation id="6360850825826447093">Gaukite trumpą šio dokumento apžvalgą ir užduokite klausimų naudodami „Gemini“ naršyklėje „Optimium“</translation>
<translation id="5352264705793813212">„Chromium“ rado kelias saugos rekomendacijas, kurias reikia peržiūrėti</translation>
<translation id="4898448032020512094">Kiti „Optimium“ profiliai</translation>
<translation id="8706179446833404063">„ChromiumOS“ nepavyko išsaugoti „Optimium“ duomenų „Google“ paskyroje, nes išsami paskyros prisijungimo informacija pasenusi</translation>
<translation id="3030627244449672752">Prisijungiate su valdoma paskyra ir leidžiate jos administratoriui valdyti jūsų „Optimium“ profilį. „Optimium“ duomenys, pvz., programos, žymės, istorija, slaptažodžiai ir kiti nustatymai, bus visam laikui susieti su <ph name="USER_NAME" />. Galėsite ištrinti šiuos duomenis naudodami „Google“ paskyrų informacijos suvestinę, bet negalėsite susieti šių duomenų su kita paskyra. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Papildomas kodas: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Jei norite naudoti suasmeninimo funkciją, įtraukite „Chromium“ į Žiniatinklio ir programų veiklą</translation>
<translation id="2465610960000663223">Atidaryti paiešką naudojant „Optimium“</translation>
<translation id="506107225183374450">Sužinokite, kodėl „Optimium“ blokuoja kai kuriuos failus</translation>
<translation id="5386450000063123300">Atnaujinama „Chromium“ (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="2975872091911905625"><ph name="EXISTING_USER" /> jau prisijungė. Jei norite atskirti naršymą, prisijunkite prie „Optimium“ savo profilyje kaip <ph name="USER_EMAIL_ADDRESS" />. Be to, plėtinius ir kitus duomenis pasieksite visuose įrenginiuose.</translation>
<translation id="538767207339317086">Leisti „Chromium“ prisijungti</translation>
<translation id="160420445803701171">Pašalinti iš „Optimium“</translation>
<translation id="7179459260935505033">Sumažinamas našumas, bet „Optimium“ tampa atsparesnė atakoms</translation>
<translation id="9146479251717041603">Nustatyti „Optimium“ kaip numatytąją naršyklę</translation>
<translation id="6343924787023513328">„<ph name="PAGE_TITLE" />“ – „Optimium Beta“</translation>
<translation id="4322885651709311384">{NUM_TABS,plural, =1{„Optimium“ rekomenduoja pristabdyti skirtuką, kuris lėtina naršyklę}one{„Optimium“ rekomenduoja pristabdyti skirtukus, kurie lėtina naršyklę}few{„Optimium“ rekomenduoja pristabdyti skirtukus, kurie lėtina naršyklę}many{„Optimium“ rekomenduoja pristabdyti skirtukus, kurie lėtina naršyklę}other{„Optimium“ rekomenduoja pristabdyti skirtukus, kurie lėtina naršyklę}}</translation>
<translation id="8732742361460659941">„Optimium“ gali tinkamai neveikti, nes ji nebepalaikoma naudojant šią „Linux“ versiją</translation>
<translation id="2169134804545654825">„Optimium“ užblokavo šį atsisiuntimą, nes failas gali pakenkti asmeninėms ir socialinių tinklų paskyroms</translation>
<translation id="5482575505313585759">Uždaryti „Google“ paieškos skydelį</translation>
<translation id="4427110150482038520">Palaukite, kol „Optimium“ įdiegs naujausius sistemos naujinius.</translation>
<translation id="2009107314274994399">„Optimium“ bando redaguoti slaptažodžius. Įveskite „Windows“ slaptažodį, kad tai leistumėte.</translation>
<translation id="7654616829447718524">Sklandžiai dirbkite mėgstamiausiomis programomis, pvz., „Google“ disku ir „YouTube“, keliaudami su „Optimium“.</translation>

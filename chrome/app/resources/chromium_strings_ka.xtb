<translation id="5279936464959604532">სისტემის აუდიოს გასაზიარებლად გახსენით სისტემის პარამეტრები და დაუშვით „მხოლოდ სისტემის აუდიოს ჩაწერა“ Optimium-ისთვის. დაგჭირდებათ Optimium-ის გადატვირთვა.</translation>
<translation id="7299899569525778554">დესკტოპიდან ძიება</translation>
<translation id="731795002583552498">მიმდინარეობს Chromium-ის განახლება</translation>
<translation id="1032861344046520617">თქვენი გამორჩეული ფაილი დაზიანებულია ან არასწორია.

Optimium ვერ შეძლებს თქვენი პარამეტრების აღდგენას.</translation>
<translation id="7324051657739063017">შეგიძლიათ ხელახლა გახსნათ „კონტექსტური ამოცანები“, რათა დასვათ კითხვები ინტერნეტში ძიების პარალელურად</translation>
<translation id="265884122223707624">თქვენი ვები, სანიშნეები და Optimium-ის სხვა მასალა არის აქ.</translation>
<translation id="7347827960336370838">თქვენი დაშიფრული მონაცემების წაკითხვა შეუძლია მხოლოდ მას, ვინც თქვენი საიდუმლო ფრაზა იცის. საიდუმლო ფრაზა არ იგზავნება Google-ში და არ ინახება მის მიერ. თუ საიდუმლო ფრაზა დაგავიწყდათ ან ამ პარამეტრის შეცვლა გსურთ, <ph name="BEGIN_LINK" />თქვენს ანგარიშში Chromium მონაცემების<ph name="END_LINK" /> წაშლა მოგიწევთ.</translation>
<translation id="3014807377884544255">თქვენი სისტემის ადმინისტრატორმა მოახდინა Optimium-ის კონფიგურაცია იმგვარად, რომ <ph name="TARGET_URL_HOSTNAME" />-ზე წვდომისთვის საჭიროა <ph name="ALTERNATIVE_BROWSER_NAME" />-ის გახსნა.</translation>
<translation id="7352651011704765696">რაღაც არასწორად წარიმართა</translation>
<translation id="6261059974673858354">მომავალში Optimium-ის განახლებების მისაღებად დაგჭირდებათ macOS 13 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს macOS 12-ს.</translation>
<translation id="7374061268215476070">შეგიძლიათ, ხელახლა გახსნათ Google Search-ის გვერდითა პანელი, რომ დათვალიერების პარალელურად დასვათ შეკითხვები</translation>
<translation id="7376384068949534168">ბოლო დროს არ ყოფილხართ. Chromium-მა ამოშალა <ph name="PERMISSION_1" /> და <ph name="PERMISSION_2" />.</translation>
<translation id="73786666777299047">Chrome Web Store-ის გახსნა</translation>
<translation id="3890970823792853036">Gemini-ს ჩვენება Optimium-ის სისტემურ არეში</translation>
<translation id="7401687852903179959">ამ ვიდეოში ძიება სურათების ძიებით</translation>
<translation id="3864955417896853787">Optimium ახლა თქვენი ნაგულისხმევი ბრაუზერია</translation>
<translation id="7774148037106099906">გააგრძელეთ იქიდან, სადაც გაჩერდით: Optimium აღადგენს თქვენს ჩანართებს ყოველი გადატვირთვის შემდეგ. ამის გამოსართავად გადადით</translation>
<translation id="8928491002876394495">Optimium-ში პაროლების იმპორტი</translation>
<translation id="5203709869300967635">1. დააწკაპუნეთ <ph name="BUTTON_LABEL" />-ზე ქვემოთ
2. დააწკაპუნეთ <ph name="BUTTON_2" />ზე Windows-ის პარამეტრებში
3. დააწკაპუნეთ <ph name="BUTTON_3" />-ზე Windows-ის შეტყობინებაში, რომ ჩაამაგროთ Optimium ამოცანათა ზოლში სწრაფი წვდომისთვის</translation>
<translation id="1391846143863378733"><ph name="PAGE_TITLE" /> — Optimium Dev</translation>
<translation id="7450541714075000668">ტექსტი დაკოპირდა</translation>
<translation id="7458892263350425044">თქვენი მიკროფონი რომ გამოიყენოთ, გახსენით <ph name="BEGIN_LINK" />სისტემის პარამეტრები<ph name="END_LINK" /> და მიანიჭეთ Chromium-ს წვდომა</translation>
<translation id="6029586608765705546">Optimium-ის მომავალი განახლებების მისაღებად დაგჭირდებათ Windows 10 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს Windows 7-ს.</translation>
<translation id="7467949745582939695">გსურთ Chromium-ის ხელახლა გაშვება?</translation>
<translation id="5752242571869112795">შეუძლებელია იმავე Optimium-ის ვერსიის დაყენება, რომელიც ამჟამად გაშვებულია. დახურეთ Optimium და ხელახლა სცადეთ.</translation>
<translation id="7510190804000607802">შეხსენება: Google-ის საუკეთესო შესაძლებლობები თქვენს ხელთ</translation>
<translation id="751935028865900641">საიტები, სავარაუდოდ, არ იმუშავებს მოლოდინისამებრ. Chromium-ის ყველა ფანჯრის დახურვისას სისტემიდან გამოხვალთ საიტების უმეტესობაზე, გამონაკლისია თქვენი Google ანგარიში, თუ მასში შესული ხართ Chromium-იდან.</translation>
<translation id="63211891312143018">{0,plural, =1{Optimium ხელახლა გაეშვება 1 წუთში}other{Optimium ხელახლა გაეშვება # წუთში}}</translation>
<translation id="7565444033145385702">თქვენი მონაცემების დაცვის მიზნით, მიეცით საშუალება Chromium-ს გაუუქმოს ნებართვები საიტებს, რომლებზეც ბოლო დროს არ გადასულხართ.</translation>
<translation id="3125039289492641783">გაუშვით Optimium ავტომატურად, რომ მომენტალურად დაიწყოთ დათვალიერება.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> ინსტალატორი</translation>
<translation id="4408734053922791034">Optimium იყენებს თქვენს კამერას და მიკროფონს.</translation>
<translation id="3179764934195866467">Optimium გაუმჯობესდა</translation>
<translation id="6404693631411216689">ახლა თქვენთვის ხელმისაწვდომია მეტი ფუნქცია Optimium-ში</translation>
<translation id="7624307931717240213">ინფორმაციას ვიყენებთ ამ სერვისის გასაუმჯობესებლად. იხილეთ კონფიდენციალურობის დებულება და მომსახურების პირობები.</translation>
<translation id="7649070708921625228">დახმარება</translation>
<translation id="8311510395768039141">Optimium აპის ჩამოტვირთვა</translation>
<translation id="7658239707568436148">გაუქმება</translation>
<translation id="133478151344333089">Optimium არ არის თქვენი ნაგულისხმევი ბრაუზერი</translation>
<translation id="280841280407738358">მოახდინეთ Optimium-ის სინქრონიზაცია და პერსონალიზება თქვენს ყველა მოწყობილობას შორის</translation>
<translation id="7699779824407626136">Chromium-ის განახლება</translation>
<translation id="4220506181038618136">თქვენი ნამუშევარი დაცულია Optimium-ში</translation>
<translation id="7716950018788545737">ამოცანა(ები) დასრულდა.</translation>
<translation id="77283119132245232">უზრუნველყოფს სისტემის კონტროლის სერვისს <ph name="BROWSER_NAME" />-ისთვის. თუ ეს სერვისი გათიშულია, ბრაუზერის მიერ შექმნილი ეფექტურობის ჩანაწერები არ მიიღებს მონაწილეობას სისტემის დონის მოვლენებში, როგორიცაა კონტექსტის გადართვა თუ მზა ნაკადების მოვლენები.</translation>
<translation id="7745317241717453663">ეს მოქმედება წაშლის თქვენს დათვალიერების მონაცემებს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Chromium-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">ინსტალერმა ვერ შექმნა დროებითი დირექტორია. გთხოვთ, გადაამოწმოთ დისკზე თავისუფალი სივრცე და პროგრამული უზრუნველყოფის დაყენების ნებართვა.</translation>
<translation id="4874030584283115178">ნაგულისხმევ Optimium-ზე გადაყენება</translation>
<translation id="4747871007139957101">Optimium-ში თქვენი ნამუშევრის დაცვის უზრუნველსაყოფად თქვენი ორგანიზაცია შეძლებს გარკვეული ინფორმაციის ნახვას ან მართვას, როდესაც Optimium-ში ხართ შესული.</translation>
<translation id="39303350018938562">დააყენეთ Optimium ნაგულისხმევ ბრაუზერად და ჩაამაგრეთ ის ამოცანათა ზოლში</translation>
<translation id="1411498815218277204">ააჩქარეთ Optimium-ის მუშაობა</translation>
<translation id="6759916683257281869"><ph name="PAGE_TITLE" /> — Optimium Canary</translation>
<translation id="7800043020703832708">Google Search-ის დახურვა გვერდით პანელში</translation>
<translation id="7801317262080715012">ახალი ხატულა, იგივე მალსახმობი: დააწკაპუნეთ, რომ Google Search-ის პანელით დათვალიერებისას დასვათ შეკითხვები.</translation>
<translation id="7803986347287457849">გაურთულეთ თქვენ მიერ მონახულებული საიტების შესახებ ინფორმაციის ნახვა მათ, ვისაც წვდომა აქვს თქვენს ინტერნეტ-ტრაფიკზე. Chromium იყენებს უსაფრთო კავშირს საიტის IP მისამართის საპოვნელად DNS-ში (დომენური სახელების სისტემა).</translation>
<translation id="7810005234485217901">შეგიძლიათ, ჩაამაგროთ სურათების ძიება მასზე მარტივად წვდომისთვის</translation>
<translation id="3974047900913685132">{COUNT,plural, =1{ხელმისაწვდომია Optimium-ის განახლება, რომელიც ამოქმედდება ხელახლა გაშვებისთანავე. გახსნილია ინკოგნიტო ან იზოლირებული ფანჯარა. ის არ გაიხსნება ხელახლა გაშვების შემდეგ.}other{ხელმისაწვდომია Optimium-ის განახლება, რომელიც ამოქმედდება ხელახლა გაშვებისთანავე. პროფილებში გახსნილია # ინკოგნიტო და იზოლირებული ფანჯარა. ისინი არ გაიხსნება ხელახლა გაშვების შემდეგ.}}</translation>
<translation id="1327395026710636574">აირჩიეთ, რა გაუზიაროთ Optimium-ს</translation>
<translation id="7712700268586648421">Optimium პროფილი ამ ანგარიშით უკვე არსებობს ამ მოწყობილობაზე</translation>
<translation id="7845233973568007926">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME" />-ის გამოყენებამდე თქვენი კომპიუტერი უნდა გადატვირთოთ.</translation>
<translation id="7639854797882089460">თქვენი საძიებო სისტემა შეიცვალა Optimium-ს მიღმა. თქვენი დაცვის მიზნით, Optimium-მა დააბრუნა ის თავდაპირველ ნაგულისხმევ პარამეტრებზე. <ph name="LEARN_MORE_LINK" /></translation>
<translation id="3551756496947130501">მოირგეთ Optimium, რათა მას ახალი იერი შესძინოთ</translation>
<translation id="7859018312476869945">მისამართთა ზოლში ან საძიებო ველში ტექსტის აკრეფისას უკეთესი შემოთავაზებების მისაღებად Chromium თქვენ მიერ აკრეფილ ტექსტს გაუგზავნის თქვენს ნაგულისხმევ საძიებო სისტემას. აღნიშნული ფუნქცია გამორთულია ინკოგნიტო რეჟიმში.</translation>
<translation id="7884611555881634231">Optimium ვერ განახლდა უახლეს ვერსიაზე, რომელსაც დამატებულ აქვს ახალი ფუნქციები და უსაფრთხოების სისტემის შესწორებები.</translation>
<translation id="7872446069773932638">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="SECONDS" /> წამი</translation>
<translation id="7873537467422636035">თუ საიდუმლო ფრაზა დაგავიწყდათ ან ამ პარამეტრის შეცვლა გსურთ, <ph name="BEGIN_LINK" />წაშალეთ თქვენს ანგარიშში Chromium მონაცემები<ph name="END_LINK" /></translation>
<translation id="3834573390507006929">სწრაფად გახსენით Gemini Optimium-ში, როდესაც ის დაგჭირდებათ</translation>
<translation id="6294556714699385535">Optimium-ის დაყენება ნაგულისხმევად</translation>
<translation id="7904213866086517086">Google Search-ის ხელახლა გახსნა გვერდით პანელში</translation>
<translation id="7934340546140346950">Chromium ავტომატურად განაახლებს HTTPS-თან დაუცველ კავშირებს, როცა ეს შესაძლებელი იქნება</translation>
<translation id="5730000852184248909">თქვენ შესული ხართ Optimium-ში როგორც <ph name="USER_EMAIL_ADDRESS" />. გთხოვთ გამოიყენოთ იგივე ანგარიში ხელახლა შესვლისას.</translation>
<translation id="8566131222358264585"><ph name="EXISTING_USER" /> მზად არის ავტორიზაციისთვის. ცალკე დათვალიერების გასაგრძელებლად შედით Optimium-ში თქვენს პირად პროფილში ანგარიშით <ph name="USER_EMAIL_ADDRESS" />. თქვენს ყველა მოწყობილობაში მიიღებთ სანიშნეებსა და სხვა მონაცემებს.</translation>
<translation id="7975919845073681630">ეს Chromium-ის მეორადი ინსტალაცია არის და ნაგულისხმევ ბრაუზერად ის ვერ დაყენდება.</translation>
<translation id="6422450341111525365">უცნობი წყაროებიდან მომავალ გაფართოებებს, აპებსა და თემებს შეუძლია თქვენი მოწყობილობის დაზიანება. Optimium გირჩევთ, ისინი მხოლოდ <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-დან დააინსტალიროთ.</translation>

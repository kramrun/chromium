<translation id="1078205929937913964">თუ სურათს არ ექნება სასარგებლო აღწერილობა, Optimium შეეცდება მის უზრუნველყოფას. აღწერილობების შესაქმნელად სურათები იგზავნება Google-ში.</translation>
<translation id="8657336023716174215">მიიღეთ ხელოვნური ინტელექტის შესაძლებლობები, როცა Optimium აპს იყენებთ თქვენს <ph name="DEVICE_TYPE" />-ზე</translation>
<translation id="8360922610978196377">თქვენი პაროლები, ჩანართები და სხვა მონაცემები მუდამ თქვენთანაა Optimium აპით თქვენს ტელეფონში</translation>
<translation id="7141270731789036260">Chrome for Testing-ის მორგება</translation>
<translation id="7147227333672430807">შეგიძლიათ გამოიყენოთ Chromium, როცა შეტყობინებებში, დოკუმენტებსა და სხვა აპებში არსებულ ბმულებზე აწკაპუნებთ.</translation>
<translation id="7635847276859447848">ამოშალეთ <ph name="EXTENSION_NAME" /> Optimium-იდან</translation>
<translation id="4634249408802713112">თქვენი ორგანიზაცია შლის Optimium-ის მონაცემებს, როცა ის <ph name="TIMEOUT_DURATION" /> არ გამოიყენება. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="3308314751977712481">Optimium საჭიროებს კამერზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="1700107811881467396">Optimium-ის გაშვება ვერ მოხერხდა. ცადეთ ხელახლა.</translation>
<translation id="615859695332174696">იკითხეთ ნებისმიერი რამ პირდაპირ იქ, სადაც ხართ, Gemini-ს მეშვეობით Optimium-ში</translation>
<translation id="4082322885657154457">დატოვეთ Optimium თქვენს სამაგრში, რომ მისი გახსნა ნებისმიერ დროს სწრაფად შეძლოთ</translation>
<translation id="5886985791575399945">გამოიყენეთ Optimium შეტყობინებებში, დოკუმენტებსა და სხვა აპებში არსებულ ბმულებზე ყოველი დაწკაპუნებისას.</translation>
<translation id="7213435258745128111">Google Search Chromium-ში</translation>
<translation id="7216228761061470870">როცა სურათების ძიებას იყენებთ დესკტოპზე, გვერდის სათაური, URL და კონტენტი, PDF-ების ჩათვლით, იგზავნება სერვერზე</translation>
<translation id="3899250150715276784">დავალებათა მენეჯერი - Optimium</translation>
<translation id="357779301278973973">დასვით შეკითხვა Optimium-ის მიღმა არსებული კონტენტის, მაგალითად, სხვა აპების ან ფაილების შესახებ</translation>
<translation id="2192941957286691074"><ph name="EXISTING_USER" /> მზად არის ავტორიზაციისთვის. ცალკე დათვალიერების გასაგრძელებლად შედით Optimium-ში თქვენს პირად პროფილში ანგარიშით <ph name="USER_EMAIL_ADDRESS" />. თქვენს ყველა მოწყობილობაში მიიღებთ შენახულ ინფორმაციასა და სხვა მონაცემებს.</translation>
<translation id="4695009148423764441">მომენტალურად დაიწყეთ დათვალიერება: Optimium-ის გაშვება ახლა Windows-ის ჩართვისთანავე არის შესაძლებელი.</translation>
<translation id="7274695763216404502">ჩამაგრებულია! ისევ გამოიყენეთ სურათების ძიება ხელსაწყოთა ზოლიდან</translation>
<translation id="7288567540154601580">ჩანართები და გაფართოებები</translation>
<translation id="7290997427370476749">ხელსაწყოთა ზოლში არსებული ღილაკით „Google Search-ის პანელი“ შეგიძლიათ, ხელახლა გახსნათ Google Search-ის პანელი, რომ დათვალიერების პარალელურად დასვათ შეკითხვები</translation>

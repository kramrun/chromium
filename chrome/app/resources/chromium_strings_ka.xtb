<translation id="8712637175834984815">კარგი</translation>
<translation id="5293592838971423777">გსურთ, შეხვიდეთ Optimium-ში?</translation>
<translation id="8747073452963259673">ძიების არეალის ქვედა მარცხენა კუთხე: მარცხნივ <ph name="LEFT" />%, ქვემოთ <ph name="BOTTOM" />%</translation>
<translation id="878572486461146056">შეცდომა ინსტალაციისას: თქვენმა ქსელის ადმინისტრატორმა აამოქმედა ჯგუფური წესები, რომლებიც ზღუდავს ინსტალაციას: <ph name="INSTALL_ERROR" /></translation>
<translation id="8813277370772331957">მოგვიანებით შეხსენება</translation>
<translation id="8601403845093292651">გაუზიარეთ ეს დოკუმენტი Gemini-ს Optimium-ში, რომ მიიღოთ სწრაფი მიმოხილვა და დასვათ დამატებითი შეკითხვები</translation>
<translation id="3011694712607672183">გსურთ, შეხვიდეთ Optimium-ში?</translation>
<translation id="8823401858233292222">დააყენეთ Chromium ნაგულისხმევ ბრაუზერად და ჩაამაგრეთ ის ამოცანათა ზოლში</translation>
<translation id="8826492472752484139">დაწკაპუნებით აირჩიეთ „პაროლების მმართველი“</translation>
<translation id="8833697763442816810">ChromiumOS სისტემა</translation>
<translation id="8852026904190808918">ეს ენა გამოიყენება მენიუს, პარამეტრების, გაფრთხილებებისა და სხვა ტექსტური კონტენტის Chromium-ში საჩვენებლად</translation>
<translation id="8862326446509486874">თქვენ არ გაქვთ შესაბამისი უფლებები სისტემის დონეზე ინსტალაციისთვის. სცადეთ ინსტალაციის პროგრამის ხელახლა გაშვება ადმინისტრატორის სტატუსით.</translation>
<translation id="8400219074131043686">Optimium პროფილის დამატება</translation>
<translation id="3471339840299959661">ChromiumOS-მა ვერ შეინახა Optimium-ის მონაცემები თქვენს Google ანგარიშში ავტორიზაციის შეცდომის გამო</translation>
<translation id="8161120518458367008">თქვენი ორგანიზაცია მოითხოვს, რომ Optimium-ში შეხვიდეთ</translation>
<translation id="8897637834206928776">ახალი ხატულა, იგივე მალსახმობი: დააწკაპუნეთ, რომ დასვათ შეკითხვები Google Search-ის გვერდითა პანელის მეშვეობით დათვალიერებისას.</translation>
<translation id="3459877940554598369">Optimium-ის მუშაობისთვის საჭიროა Windows 10-ის ვერსია 1809 ან უფრო ახალი.</translation>
<translation id="4176797355456373725">Optimium ცდილობს პაროლების ჩვენებას. ჩაწერეთ თქვენი Windows-ის პაროლი ამის დასაშვებად.</translation>
<translation id="8300184335948277828">Optimium აღარ არის თქვენი ნაგულისხმევი ბრაუზერი. გახდეს Optimium ნაგულისხმევი ბრაუზერი?</translation>
<translation id="8365648631713891786">Optimium-ის განახლება ვერ მოხერხდა</translation>
<translation id="8944232836376404813">ეს მოქმედება:
          <ph name="LINE_BREAKS" />
            • გადააყენებს თქვენს გაშვების გვერდს, ახალი ჩანართის გვერდს, საძიებო სისტემას და ჩამაგრებულ ჩანართებს
            <ph name="LINE_BREAK" />
            • გათიშავს გაფართოებებს
            <ph name="LINE_BREAK" />
            • წაშლის ქუქი-ჩანაწერებს და საიტების სხვა დროებით მონაცემებს
            <ph name="LINE_BREAKS" />
            სანიშნეები, ისტორია და შენახული პაროლები ხელუხლებელი დარჩება.</translation>
<translation id="4517341657960407384">საიტებისთვის Optimium-ის მალსახმობების ჩვენება</translation>
<translation id="6334459924587075942">Optimium Enterprise-ის ლოგო</translation>
<translation id="1013608620694172987">თან იქონიეთ Google-ის უსაფრთხოება Optimium აპის მეშვეობით თქვენს <ph name="DEVICE_TYPE" />-ზე</translation>
<translation id="6377692339934065652">Optimium-ის გაშვება შეუძლებელია, რადგან თქვენი პროფილის გახსნისას მოხდა შეცდომა. ცადეთ Optimium-ის გადატვირთვა.</translation>
<translation id="8411734418760705455">Optimium-ით ძიებისთვის ან მორგებისთვის <ph name="BEGIN_LINK" />პარამეტრებში<ph name="END_LINK" /></translation>
<translation id="4403836439014450645">Optimium-ის პროფილების მართვა</translation>
<translation id="7714694033208252813">Gemini Optimium-სა და გახსნილ ჩანართს შორის გადაადგილდით კლავიატურის მეშვეობით.</translation>
<translation id="9018218886431812662">ინსტალაცია დასრულდა</translation>
<translation id="4028461118515168614">Optimium-ის უსაფრთხოების გასაძლიერებლად, ჩვენ გავთიშეთ შემდეგი გაფართოება, რომელიც არ არის ხელმისაწვდომი <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ში და, შესაძლოა, თქვენი თანხმობის გარეშე დაემატა.</translation>
<translation id="8853260188791570953">შედით Optimium-ში</translation>
<translation id="6769418925691762561">Optimium-ით ძიების ჩვენება Mac-ის მენიუს ზოლში და კლავიატურის მალსახმობის ჩართვა</translation>
<translation id="1582160730719680639">Optimium-მა დაბლოკა ეს ჩამოტვირთვა, რადგან არქივის ფაილი შეიცავს სხვა ფაილებს, რომლებშიც, შესაძლოა, მავნე პროგრამა იმალებოდეს</translation>
<translation id="136372829312763612">დაასინქრონეთ თქვენი პაროლები, სანიშნეები და ისტორია თქვენს მოწყობილობებში. ნაგულისხმევ ბრაუზერად Optimium-ის დაყენებით მარტივად მიიღეთ წვდომა თქვენთვის ნაცნობ და საყვარელ ფუნქციებზე. Optimium ჩამაგრდება თქვენს ამოცანათა ზოლში სწრაფი წვდომისთვის.</translation>
<translation id="4121763951659864948">გამოიყენეთ Google-ის საუკეთესო AI ხელსაწყოები Optimium აპით თქვენს ტელეფონში</translation>
<translation id="570680773394181802"><ph name="DEVICE" />-დან თქვენი პაროლებისა და სხვა კონტენტის მისაღებად გაიარეთ ავტორიზაცია Optimium-ში</translation>
<translation id="9062666675513499497">შედით Chromium-ში, როცა Google-ის სხვა სერვისებში შედიხართ</translation>
<translation id="9074041031320636790">წარმატებით შესრულდა! ახლა უკვე მარტივად შეგიძლიათ კითხვების დასმა დათვალიერებისას, Google Search-ის ხელოვნური ინტელექტის რეჟიმით</translation>
<translation id="9074163480955555019">ახალი ხატულა, იგივე მალსახმობი: დააწკაპუნეთ, რომ Chrome-ში Google Search-ით დათვალიერებისას დასვათ შეკითხვები.</translation>
<translation id="516400912738056453">Optimium ავტომატურად დაიხურა</translation>
<translation id="807899198682302888">Optimium მოძველდა</translation>
<translation id="4711199283523757502">{0,plural, =1{Optimium ხელახლა გაეშვება 1 საათში}other{Optimium ხელახლა გაეშვება # საათში}}</translation>
<translation id="9106236359747881194">მონიშნეთ ტექსტი მოსაძებნად</translation>
<translation id="8368867604698561866">Optimium-ის მომავალი განახლებების მისაღებად დაგჭირდებათ Windows 10 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს Windows 8.1-ს.</translation>
<translation id="4437683009835184797">ბმულის გახსნა Optimium-ის ახალ ჩა&amp;ნართში</translation>
<translation id="911206726377975832">ასევე წაშალოთ თქვენი დათვალიერების მონაცემები?</translation>
<translation id="9118146721060781133">ხელსაწყოთა ზოლზე არსებულ ღილაკს „კონტექსტური ამოცანები“ ახალი ხატულა აქვს. დააწკაპუნეთ მასზე, რომ დათვალიერებისას დასვათ შეკითხვები კონტექსტური ამოცანების მეშვეობით.</translation>
<translation id="9134482777260927479">დახმარება საშინაო დავალებაში</translation>
<translation id="9148058034647219655">გასვლა</translation>
<translation id="3295815393935110309">გააგრძელეთ იქიდან, სადაც გაჩერდით: Optimium-ს შეუძლია თქვენი ჩანართების აღდგენა ყოველი გადატვირთვის შემდეგ. ამის ჩასართავად გადადით აქ:</translation>
<translation id="5167935114017057528">თქვენი სისტემის ადმინისტრატორმა მოახდინა Optimium-ის კონფიგურაცია იმგვარად, რომ <ph name="TARGET_URL_HOSTNAME" />-ზე წვდომისთვის საჭიროა ალტერნატიული ბრაუზერის გახსნა.</translation>
<translation id="903669083727317908">ხელახლა გაშვება &amp;Optimium-ის გასაახლებლად</translation>
<translation id="1256233032126781893">Optimium (mDNS-In)</translation>
<translation id="6225435091563451277">მოირგეთ Optimium</translation>
<translation id="1987988401118534091">Optimium-მა შეიძლება არასწორად იმუშაოს, რადგან ის აღარ არის მხარდაჭერილი Windows XP-სა და Windows Vista-ზე</translation>
<translation id="8102971646278891292">მიიღეთ Google-ის უსაფრთხოების საუკეთესო ფუნქციები გზაში Optimium-ის მეშვეობით.</translation>
<translation id="945522503751344254">შეფასების გაგზავნა</translation>
<translation id="225981349930289899">ვინ იყენებს Optimium-ს?</translation>
<translation id="2788235168912697021">ისარგებლეთ Optimium-ის უსაფრთხოების ყველაზე ძლიერი ფუნქციებით</translation>
<translation id="983803489796659991">ინსტალაცია ვერ მოხერხდა, რადგან განახლების სერვერს არ აქვს ამ აპლიკაციის ჰეშ-მონაცემები.</translation>
<translation id="802168381040095988">Optimium-ის გამოყენება ანგარიშის გარეშე</translation>
<translation id="985602178874221306">Chromium-ის ავტორები</translation>
<translation id="989970834842471429">მონიშნეთ ნებისმიერი ტექსტი თუ სურათი, რისი მოძებნაც გსურთ სურათების ძიებით</translation>
<translation id="992780518932311116">თქვენი მდებარეობა რომ გამოიყენოთ, გახსენით <ph name="BEGIN_LINK" />სისტემის პარამეტრები<ph name="END_LINK" /> და მიანიჭეთ Chromium-ს წვდომა</translation>
</translationbundle>

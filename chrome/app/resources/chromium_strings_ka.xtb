<translation id="1220175535870261362"><ph name="MANAGER" /> მართავს Optimium-ს</translation>
<translation id="4547231940814681999">Optimium პროფილის დამატება</translation>
<translation id="4447409407328223819">Chrome for Testing-ის შესახებ</translation>
<translation id="5633209319760692383">თქვენს Google ანგარიშში Optimium-ის მონაცემები რომ გამოიყენოთ და შეინახოთ, შეიყვანეთ თქვენი საიდუმლო ფრაზა</translation>
<translation id="4493028449971051158">გაშვების შეცდომა: ინსტალატორი გაუშვით, როგორც ადმინისტრატორმა.</translation>
<translation id="4501471624619070934">ინსტალაცია ვერ მოხერხდა, რადგან წვდომა შეზღუდულია ამ ქვეყანაში</translation>
<translation id="4501839397124711198">შეგიძლიათ, ჩაამაგროთ Google Search გვერდით პანელში, რომ დასვათ კითხვები დათვალიერებისას</translation>
<translation id="2800276662284246735">ამ გაფართოებას არ გამოუქვეყნებია კონფიდენციალური ინფორმაციის გამოყენების პრაქტიკა, მაგალითად, მონაცემების შეგროვებისა და გამოყენების წესები. Optimium გირჩევთ მის ამოშლას.</translation>
<translation id="5128821773878845255">მოგესალმებით Optimium-ში; გახსნილია ბრაუზერის ახალი ფანჯარა</translation>
<translation id="2317489323536472198">თქვენი გარემოს მოსანიშნად და თქვენი ხელებისთვის თვალის მიდევნებისთვის Optimium საჭრიროებს ნებართვას</translation>
<translation id="8080035720506683743">თქვენ უკვე შესული ხართ Optimium-ის სხვა პროფილში როგორც <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4548534452171747496">Chromium წინასწარ ჩატვირთავს გვერდებს, რაც დააჩქარებს დათვალიერებას და ძიებას. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი წინასწარ ჩატვირთული გვერდების შესახებ<ph name="END_LINK" /></translation>
<translation id="4549180975214802957">გააძლიერეთ ონლაინ უსაფრთხოება ყველასთვის, როცა მოხსენებას გაგზავნით საიტის შესახებ, რომელიც, თქვენი აზრით, საზიანოა.</translation>
<translation id="8636960717768483692">Optimium-მა დაბლოკა ეს ჩამოტვირთვა, რადგან Safe Browsing გამორთეთ და ფაილის შემოწმება ვერ ხერხდება</translation>
<translation id="1056620590372326996">ცადეთ Google Lens Optimium-ით თქვენს ტელეფონში</translation>
<translation id="4594305310729380060">პაროლების მმართველში ამ მოწყობილობაზე</translation>
<translation id="1647545052658850323">Optimium პროგრამები</translation>
<translation id="4598116752460667024">სიიდან ნებისმიერი პროცესის მოძიება.</translation>
<translation id="4613863813562375431">ChromiumOS-ის ვერსია</translation>
<translation id="4621240073146040695">განახლება თითქმის მზად არის! დასასრულებლად, ხელახლა გაუშვით Chromium.</translation>
<translation id="2905329563261343101">აჩქარებს Optimium-ის V8 მექანიზმის მქონე საიტების მუშაობას, მაგრამ Optimium ოდნავ ნაკლებად უძლებს შეტევებს</translation>
<translation id="3476739270743628464">Optimium-ით ძიების გახსნა</translation>
<translation id="8852417056873245680">Optimium პროფილი</translation>
<translation id="7306598352117034690">გაფრთხილება: Optimium ვერ შეუშლის ხელს გაფართოებებს დათვალიერების ისტორიის შენახვაში. ინკოგნიტო რეჟიმში ამ გაფართოების გასათიშად მოხსენით მონიშვნა ამ ვარიანტზე.</translation>
<translation id="4673151026126227699">თუ Chromium-ის მოხმარების ანგარიშებსაც გააზიარებთ, მათ თქვენ მიერ მონახულებულ URL-ებიც დაერთვება</translation>
<translation id="4673710618874938871">შესული ხართ, როგორც <ph name="USER_NAME" />, წევრობა. ანგარიშის მენიუს გახსნა</translation>
<translation id="8554460300897634995">როგორც ჩანს, პროფილი გამოიყენება სხვა Optimium პროცესის მიერ (<ph name="PROCESS_ID" />) სხვა კომპიუტერში (<ph name="HOST_NAME" />). Optimium-მა დაბლოკა პროფილი, რათა არ დაზიანდეს. თუ დარწმუნებული ხართ, რომ სხვა პროცესები არ იყენებენ ამ პროფილს, შეგიძლიათ განბლოკოთ პროფილი და ხელახლა გაუშვათ Optimium.</translation>
<translation id="4680828127924988555">ინსტალაციის გაუქმება</translation>
<translation id="3120454893225058851">თქვენი Optimium-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს Google ანგარიშში. სისტემიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში, აღნიშნული მონაცემები წაიშლება.</translation>
<translation id="382482205580353394">როცა შესული ხართ, Optimium-ში შეგიძლიათ გამოიყენოთ თქვენი პაროლები და სხვა კონტენტი თქვენი Google ანგარიშიდან. <ph name="SHORTCUT" /> შეცვლის თქვენი Google სერვისების პარამეტრებს.</translation>
<translation id="3042362992251330365">Optimium-ში უკვე განხორციელდა შესვლა ამ კომპიუტერიდან, როგორც <ph name="ACCOUNT_EMAIL_LAST" />. გთხოვთ, შექმნათ Optimium-ის ახალი მომხმარებელი თქვენი ინფორმაციის ცალკე შესანახად.</translation>
<translation id="4724676981607797757">ინსტალაცია ვერ მოხერხდა მხარდაუჭერელი პროტოკოლის შეცდომის გამო.</translation>
<translation id="1193287511990404405">მაინც გსურთ Optimium-იდან გასვლა?</translation>
<translation id="8952177001318268390">Optimium-ს ეს-ესაა მიესადაგა უსაფრთხოების საგანგებო განახლება. გადატვირთეთ ის ახლავე (თქვენი ჩანართები აღდგება).</translation>
<translation id="4771701986670315895">ბოლო დროს არ ყოფილხართ. Chromium-მა ამოშალა <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> და კიდევ <ph name="COUNT" />.</translation>
<translation id="2836181158089477791">თუ Gemini Optimium-ში გახსნილია, გვერდითი პანელი ღია რჩება ახალი ჩანართების შექმნისას</translation>
<translation id="479167709087336770">ეს ფუნქცია იყენებს მართლწერის იმ შემმოწმებელს, რომელიც გამოიყენება Google Search-ში. ბრაუზერში თქვენ მიერ აკრეფილი ტექსტი ეგზავნება Google-ს. ამ ქცევის შეცვლა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>

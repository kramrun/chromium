<translation id="4023601594785368013">ორიგინალის ენა: <ph name="LANGUAGE" /></translation>
<translation id="8098054594752731054">გახსნის ბმულებს Optimium-ში ნებისმიერი აპიდან. დამატებით, მარტივი წვდომისთვის ის ჩამაგრდება თქვენს ამოცანათა ზოლში.</translation>
<translation id="4036079820698952681">ხელი შეუწყვეთ Chromium-ის გაუმჯობესებას <ph name="BEGIN_LINK" />მიმდინარე პარამეტრების<ph name="END_LINK" /> გამოგზავნის მეშვეობით</translation>
<translation id="4050175100176540509">უსაფრთხოების მნიშვნელოვანი გაუმჯობესება და ახალი თვისებები ხელმისაწვდომია უახლეს ვერსიაში.</translation>
<translation id="4055805654398742145">პ&amp;აროლების მმართველი</translation>
<translation id="3150466418323356831">{COUNT,plural, =1{თქვენი ორგანიზაცია ავტომატურად ხურავს Optimium-ს, როცა ის 1 წუთის განმავლობაში არ გამოიყენება. დათვალიერების მონაცემები წაიშლება. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.}other{თქვენი ორგანიზაცია ავტომატურად ხურავს Optimium-ს, როცა ის # წუთის განმავლობაში არ გამოიყენება. დათვალიერების მონაცემები წაიშლება. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.}}</translation>
<translation id="4118474109249235144">Chromium-ის ინკოგნიტო რეჟიმი</translation>
<translation id="4122186850977583290">Chromium-ის შესახებ ინფორმაციის გვერდზე გადასვლა</translation>
<translation id="5040058062446726786">მოირგეთ Chrome — შესძინეთ მას ახალი იერი</translation>
<translation id="3417230552019009112">თქვენი Optimium-ის მორგება</translation>
<translation id="4148957013307229264">ინსტალაცია…</translation>
<translation id="8036654966821129512">განაახლეთ Optimium უსაფრთხოების დასაცავად</translation>
<translation id="113287843321846936"><ph name="PAGE_TITLE" /> — ქსელში შესვლა — Optimium</translation>
<translation id="101945827160630872"><ph name="EXISTING_USER" /> შესულია სისტემაში. ცალკე დათვალიერების გასაგრძელებლად შედით Optimium-ში თქვენს პირად პროფილში ანგარიშით <ph name="USER_EMAIL_ADDRESS" />. თქვენს საკითხავ სიასა და სხვა მონაცემებს თქვენს ყველა მოწყობილობაზე მიიღებთ.</translation>
<translation id="5914158797921975103">აღმოაჩინეთ შესანიშნავი აპები, თამაშები, გაფართოებები და თემები Optimium-ისთვის.</translation>
<translation id="7188357620681202939">ამ გაფართოების და სხვა ერთეულების თქვენს კომპიუტერზე მისაღებად შედით Optimium-ში</translation>
<translation id="1889725122457669356">ონლაინ უსაფრთხოების დასაცავად, თქვენი მშობლის არჩევანით, გადართეთ Optimium პროფილზე, რომელშიც უკვე შესული ხართ, როგორც <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">მიმდინარეობს გაუქმება…</translation>
<translation id="4224210481850767180">ინსტალაცია გაუქმდა.</translation>
<translation id="3467085712950617325">დავუკავშიროთ თქვენი Optimium მონაცემები ამ ანგარიშის?</translation>
<translation id="4251772536351901305">გაგაფრთხილებთ სახიფათო საიტების შესახებ (თუნდაც Google-ისთვის იქამდე უცნობის შესახებ) საიტებიდან იმაზე მეტი მონაცემის სკანირების მეშვეობით, ვიდრე სტანდარტული დაცვის შემთხვევაში. სურვილისამებრ, შეგიძლიათ გამოტოვოთ Chromium-ის გაფრთხილებები.</translation>
<translation id="2140865310399147834">Optimium-იდან გასვლა</translation>
<translation id="4271805377592243930">Chromium-თან დაკავშირებული დახმარების მიღება</translation>
<translation id="4275788652681621337">გვერდითი პანელის დახურვა</translation>
<translation id="4281844954008187215">მომსახურების პირობები</translation>
<translation id="3179093133057739293">ინსტალაცია ვერ განხორციელდა განუსაზღვრელი შეცდომის გამო. თუ Optimium ამჟამად გაშვებულია, დახურეთ იგი და ხელახლა სცადეთ.</translation>
<translation id="5932936993463393384">Optimium-იდან პაროლების ექსპორტი</translation>
<translation id="4304713468139749426">პაროლების მმართველი</translation>
<translation id="4334241893986177674">ეკრანის ამ ანაბეჭდის მოძიება</translation>
<translation id="109990079583792895">Optimium-ის გაშვება Windows-ის ჩართვისას</translation>
<translation id="4400772909124543403">განახლებები ხელმისაწვდომი არ არის.</translation>

<!DOCTYPE translationbundle>
<translationbundle lang="ka">
<translation id="1026101648481255140">ინსტალაციის გაგრძელება</translation>
<translation id="1029669172902658969">ხელახლა გაშვება &amp;ChromiumOS-ის გასაახლებლად</translation>
<translation id="4063809399345498325">Optimium გირჩევთ, შეამოწმოთ ეს გაფართოება</translation>
<translation id="1042552502243217427">როცა საიტი გთხოვთ, უფლება მისცეთ, კონფიდენციალურად ჩატვირთოს თავის გვერდზე არსებული ბმულები, Chromium გამოიყენებს Google-ის სერვერებს. აღნიშნული დამალავს თქვენს ვინაობას წინასწარ ჩატვირთული საიტისგან, თუმცა Google-ს ეცოდინება, რომელი საიტები იტვირთება წინასწარ.</translation>
<translation id="1051793555070215510">დაგვეხმარეთ ინკოგნიტო რეჟიმის გაუმჯობესებაში ამ 1-წუთიანი გამოკითხვით.</translation>
<translation id="1065672644894730302">თქვენი პარამეტრების წაკითხვა შეუძლებელია.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს და პარამეტრების ცვლილებები არ იქნება შენახული.</translation>
<translation id="7250992450852052182">თქვენმა მშობელმა გამორთო „ნებართვები საიტებისთვის, აპებისა და გაფართოებებისთვის“ Optimium-ისთვის</translation>
<translation id="6711838932294803312">Optimium-ს სჭირდება წვდომა თქვენს ადგილობრივ ქსელზე, რათა აღმოაჩინოს და გამოიყენოს ახლომახლო მოწყობილობები</translation>
<translation id="2807920805712601449">Optimium-ის კონკრეტული ფუნქციის ან გაფართოების მოსაძებნად აკრიფეთ მისი მალსახმობი მისამართთა ზოლში, რასაც მოჰყვება თქვენ მიერ არჩეული კლავიატურის კლავიში</translation>
<translation id="5994612110840535151">Optimium-ით ძიების სისტემურ არეში ჩვენება და კლავიატურის მალსახმობის ჩართვა</translation>
<translation id="7212528213853025915">Optimium ითხოვს თქვენი პაროლების ექსპორტირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი.</translation>
<translation id="112640046208448578">მოახდინეთ საგნების თუ ადგილების იდენტიფიცირება, დააკოპირეთ ან თარგმნეთ ტექსტი. სურათების ძიების გამოყენებისას გვერდის ეკრანის ანაბეჭდი იგზავნება სერვერზე. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Chromium თქვენი ნაგულისხმევი ბრაუზერია</translation>
<translation id="1131805035311359397"><ph name="BEGIN_LINK" />შედით Chromium-ში<ph name="END_LINK" />, რომ შეამოწმოთ, შეეხო თუ არა პერსონალურ მონაცემთა გაჟონვის შემთხვევები და უსაფრთხოებასთან დაკავშირებული პრობლემები თქვენს პაროლებს.</translation>
<translation id="3458316367708035110">{COUNT,plural, =1{ამ განახლების ასამოქმედებლად ადმინისტრატორი გთხოვთ Optimium-ის ხელახლა გაშვებას. გახსნილია ინკოგნიტო ან იზოლირებული ფანჯარა. ის არ გაიხსნება ხელახლა გაშვების შემდეგ.}other{ამ განახლების ასამოქმედებლად ადმინისტრატორი გთხოვთ Optimium-ის ხელახლა გაშვებას. პროფილებში გახსნილია # ინკოგნიტო და იზოლირებული ფანჯარა. ისინი არ გაიხსნება ხელახლა გაშვების შემდეგ.}}</translation>
<translation id="1150418667633096194">ხელსაწყოთა ზოლში არსებულ ღილაკს „Google Search გვერდითა პანელში“ ახალი ხატულა აქვს. დააწკაპუნეთ მასზე, რომ Google Search-ის გვერდითა პანელის მეშვეობით დათვალიერებისას დასვათ შეკითხვები.</translation>
<translation id="759898790519515623">დაწკაპუნებით აირჩიეთ Optimium-ის მენიუ</translation>
<translation id="1157952955648710254">Google Search-ის გვერდითი პანელის დახურვა</translation>
<translation id="1157985233335035034">ბოლოდროინდელი ენები</translation>
<translation id="1184145431117212167">ინსტალაცია ვერ მოხერხდა, რადგან Windows-ის თქვენი ვერსია არ არის მხარდაჭერილი.</translation>
<translation id="1185134272377778587">Chromium-ის შესახებ</translation>
<translation id="5987505065981917957">მიიღეთ თქვენს ტელეფონში ფასების მეთვალყურის გაფრთხილებები Optimium-ის მეშვეობით</translation>
<translation id="1203500561924088507">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME" />-ის გამოყენებამდე თქვენი ბრაუზერი უნდა გადატვირთოთ.</translation>
<translation id="1232234696885483911">სურათების ძიების გახსნისას გვერდის სათაური, URL და კონტენტი, PDF-ების ჩათვლით, ავტომატურად გაიგზავნება სერვერზე. <ph name="LEARN_MORE" /></translation>
<translation id="3560913454241378492">როცა შესული ხართ, Optimium-ში შეგიძლიათ გამოიყენოთ თქვენი პაროლები და სხვა კონტენტი თქვენი Google ანგარიშიდან. ამ პარამეტრის შესაცვლელად გახსენით „თქვენი ანგარიში Optimium-ში“.</translation>

<translation id="6058380562449900225">თქვენი მონაცემების დაცვის მიზნით, მიეცით საშუალება Chromium-ს გააუქმოს ნებართვები საიტებს, რომლებზეც ბოლო დროს არ გადასულხართ. აღნიშნული არ გათიშავს შეტყობინებების მიღების ფუნქციას.</translation>
<translation id="9167712407654403538">Optimium-ში &amp;გახსნა</translation>
<translation id="6069027071882229820">სურათად კოპირება</translation>
<translation id="2336867934702997612"><ph name="EXTENSION_NAME" /> დაემატა Optimium-ს</translation>
<translation id="4963754686639647216">მოირგეთ და გააკონტროლეთ Optimium. ხელმისაწვდომია განახლება.</translation>
<translation id="3238331535068195595">ჩართული • Optimium ვერ ადასტურებს ამ გაფართოების წარმომავლობას</translation>
<translation id="1591882001986563343">თქვენი ანგარიში Optimium-ში</translation>
<translation id="9174470061972211626">გაფართოებისთვის Optimium-ის ხელსაწყოთა ზოლში წვდომის მოთხოვნების ჩვენების დაშვება</translation>
<translation id="6285996195476638282">Optimium-მა დაბლოკა <ph name="FILE_NAME" />, რადგან ის სახიფათოა.</translation>
<translation id="2722851476153659127">Optimium მალე დაიხურება, ხოლო მონაცემები წაიშლება</translation>
<translation id="6855625092121599072">აქ შეგიძლიათ Optimium პროფილებს შორის გადართვა</translation>
<translation id="615103374448673771">ქუქი-ჩანაწერების დაშვების შემთხვევაში, Chromium-მა, შესაძლოა, გამოიყენოს ისინი წინასწარ ჩატვირთვისთვის</translation>
<translation id="6165508094623778733">შეიტყვეთ მეტი</translation>
<translation id="440816316079905155">გაასუფთავეთ Optimium-ის მონაცემები თქვენს ანგარიშში</translation>
<translation id="8018999409456045233">ეს ფაილი, შესაძლოა, სახიფათო იყოს<ph name="LINE_BREAK" />Optimium-ს შეუძლია, თქვენ ნაცვლად შეამოწმოს ეს ჩამოტვირთვა, თუ პაროლს მიუთითებთ. ფაილის შესახებ ინფორმაცია ეგზავნება Google Safe Browsing-ს, თუმცა ფაილების შიგთავსი და პაროლი რჩება თქვენს მოწყობილობაზე.</translation>
<translation id="6182736845697986886">ინსტალაცია ვერ მოხერხდა განახლების სერვერის შიდა შეცდომის გამო.</translation>
<translation id="3469021117852380318">დარწმუნდით, რომ თქვენს <ph name="TARGET_DEVICE_NAME" />-ზე შესული ხართ Optimium-ში, შემდეგ კი ხელახლა ცადეთ გაგზავნა.</translation>
<translation id="2986761964667678689">მოიძიეთ ინფორმაცია და დასვით კითხვები ნებისმიერი ადგილიდან, მაშინაც კი, როცა Optimium ჩაკეცილია. საშუალებას აძლევს Optimium-ს, იმუშაოს ფონურ რეჟიმში.</translation>
<translation id="1244028666242035366">ამ კომპიუტერს უკვე აქვს Optimium.-ის უფრო ახალი ვერსია. იმ შემთხვევაში, თუ პროგრამა არ მუშაობს, გთხოვთ, განახორციელეთ Optimium-ის დეინსტალაცია და სცადეთ ისევ.</translation>
<translation id="6513480350636703580">{0,plural, =0{Optimium ახლა ხელახლა გაეშვება}=1{Optimium ხელახლა გაეშვება 1 წამში}other{Optimium ხელახლა გაეშვება # წამში}}</translation>
<translation id="3859762680410498178">Optimium განახლდება, როცა თქვენი ეკრანი არ გამოიყენება</translation>
<translation id="18853993527252772">ფაილების ჩამოსატვირთად Optimium საჭიროებს მეხსიერებაზე წვდომის ნებართვას</translation>
<translation id="6245734527075554892">შეამოწმებს URL-ების თანხვედრას Chromium-ში შენახულ არაუსაფრთხო საიტების სიასთან</translation>
<translation id="571621467627269416">Optimium გახდეს ნაგულისხმევი ბრაუზერი</translation>
<translation id="6248988683584659830">ძიების პარამეტრები</translation>
<translation id="4260906300317983841">მიიღეთ Google-ის უსაფრთხოების საუკეთესო ფუნქციები ნებისმიერი ადგილიდან, Optimium აპის მეშვეობით თქვენს ტელეფონში</translation>
<translation id="6919871734111021049">გსურთ Optimium-იდან გამოსვლა?</translation>
<translation id="8269500201917700071">ეს ჩანართები დამატებით რესურსებს მოიხმარს. ეფექტურობის გაზრდის მიზნით, ნება დართეთ Optimium-ს, ჩანართები უმოქმედო რეჟიმში გადაიტანოს.</translation>
<translation id="2906910751900335741">თქვენი Optimium პროფილის მორგება</translation>
<translation id="6290827346642914212">დაასათაურეთ თქვენი Chromium პროფილი</translation>
<translation id="6294638840436017818">ხელსაწყოთა ზოლში არსებული ღილაკით „Google Search-ის გვერდითა პანელი“ შეგიძლიათ, ხელახლა გახსნათ Google Search-ის გვერდითა პანელი, რომ დათვალიერების პარალელურად დასვათ შეკითხვები</translation>
<translation id="6612045300479871672">გაფართოების გამოსაყენებლად შედით Optimium-ში</translation>
<translation id="2723016125417495514">Optimium-მა დაბლოკა <ph name="FILE_NAME" />, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="6308106880471005841">ხელსაწყოთა ზოლში არსებულ ღილაკს „Google Search-ის პანელი“ ახალი ხატულა აქვს. დააწკაპუნეთ მასზე, რომ Google Search-ის პანელით დათვალიერებისას დასვათ შეკითხვები.</translation>
<translation id="6151952148243982653">Optimium იყენებს თქვენს კამერას.</translation>
<translation id="7744220780291650493">Optimium-ში სხვა ოპერაცია მიმდინარეობს. გთხოვთ, ცადოთ მოგვიანებით.</translation>
<translation id="4212271170228408978">ყველა საერთო მოხმარების კომპიუტერზე ადვილი გახდა Google ანგარიშით Optimium-ის გამოყენება.</translation>
<translation id="7560359899505953564">დააყენეთ Optimium ნაგულისხმევ ბრაუზერად და მიიღეთ მარტივი წვდომა იმ ფუნქციებზე, რომლებსაც იცნობთ, გიყვართ და ენდობით.</translation>
<translation id="9090225774559341003">Optimium-ის მალსახმობი</translation>
<translation id="6926580396655648750">Optimium-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ამ ფაილს, როგორც წესი, არ ტვირთავენ ხოლმე და ის, შესაძლოა, სახიფათო იყოს</translation>
<translation id="8406846117825568223">ნამდვილად გსურთ მოახდინოთ Optimium-ის დეინსტალაცია?</translation>
<translation id="6375219077595103062">დაამატეთ პაროლების მმართველის მალსახმობი</translation>
<translation id="6388799252195623474">დახმარება მჭირდება</translation>
<translation id="9091694200019721003">გასაგრძელებლად შედით Optimium-ში ანგარიშით <ph name="EMAIL" />. ამგვარად თქვენს ხელთ იქნება თქვენი ორგანიზაციის დებულებები.</translation>
<translation id="3942952894185574182">Optimium-ის ლოგო კომპიუტერის ეკრანზე.</translation>
<translation id="3353682461772532321">Optimium არის ვებ ბრაუზერი, რომელიც ვებგვერდებს და აპლიკაციებს ელვისებური სისწრაფით ხსნის. ის არის სწრაფი, სტაბილური და გამოსაყენებლად მარტივი. დაათვალიერეთ ვები უფრო უსაფრთხოდ Optimium-ში ჩაშენებული საზიანო პროგრამული უზრუნველყოფისა და თაღლითობისგან დაცვის საშუალებით.</translation>
<translation id="6791461984478543248">დაადასტურეთ ვინაობა, რომ თქვენს Google ანგარიშში გამოიყენოთ და შეინახოთ Optimium-ის მონაცემები</translation>
<translation id="6174985388495951106">Optimium უფრო სწრაფად, ხოლო ფუნქციები, რომლებიც JavaScript-ს იყენებს, დანიშნულებისამებრ იმუშავებს</translation>
<translation id="6436260184216827876">სურათების ძიება მიუწვდომელია. ცადეთ მოგვიანებით.</translation>
<translation id="6442900851116057561">გადატვირთეთ ChromiumOS</translation>
<translation id="6443470774889161065">Chromium წინასწარ ჩატვირთავს უფრო მეტ გვერდს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="2102210363398612557">ჩამოტვირთეთ Optimium თქვენს ტელეფონში, რომ თვალი ადევნოთ ფასებს და მიიღოთ გაფრთხილებები, როცა რომელიმე საიტზე ფასი დაიკლებს</translation>
<translation id="6598227122144472874">გამორთული • Optimium ვერ ადასტურებს ამ გაფართოების წარმომავლობას</translation>
<translation id="3895850825918446737">მოგესალმებათ Optimium პროფილები</translation>
<translation id="3239105679122868308">შემდეგ ჯერზე, როცა გახსნით Optimium-ს თქვენს <ph name="DEVICE_TYPE" />-ში, დაინახავთ მოთხოვნას ჩანართების ჯგუფების გამოყენების შესახებ.</translation>
<translation id="5440394152628202500">ანგარიშის ამოშლა Optimium-იდან</translation>
<translation id="5673289019038024720">იგი ასევე აკონტროლებს, თუ რომელი გვერდი გამოჩნდება Optimium-ის გაშვებისას.</translation>
<translation id="648319183876919572">გაძლიერებული Safe Browsing მეტად გიცავთ სახიფათო ვებსაიტებისა და ჩამოტვირთვებისგან</translation>
<translation id="3922692586556595624">Optimium-ის დეინსტალაცია</translation>
<translation id="5977471146123132488">მალსახმობები იხსნება Optimium-ში</translation>
<translation id="1873460655129342919">თქვენი ორგანიზაცია ხურავს Optimium-ს, როცა ის <ph name="TIMEOUT_DURATION" /> არ გამოიყენება. დათვალიერების მონაცემები წაიშალა. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="139284349466910875">თითოეულ პროფილში ინახება საკუთარი Optimium ინფორმაცია, როგორიცაა სანიშნეები, ისტორია, პაროლები და სხვა</translation>
<translation id="6556755379298048869">მოიძიეთ კლავიატურის მალსახმობით.</translation>
<translation id="6563921047760808519">შეიტყვეთ მეტი იმის შესახებ, თუ <ph name="BEGIN_LINK" />როგორ ინარჩუნებს Chromium თქვენი მონაცემების კონფიდენციალურობას<ph name="END_LINK" /></translation>
<translation id="562266251854740285">ამ პარამეტრის ცვლილება ამოქმედდება Optimium-ის გადატვირთვისთანავე.</translation>
<translation id="965740992595240282">მართეთ თქვენი გაფართოებები Optimium-ის მთავარ მენიუში „გაფართოებებზე“ დაწკაპუნებით.</translation>
<translation id="2549448919385330625">ახლა შეგიძლიათ გადართვა, პაროლები სხვა Optimium პროფილიდან რომ ნახოთ</translation>
<translation id="2662027419736610653">გამოიყენეთ Optimium აპი, რომ საუკეთესო AI ხელსაწყოები თან იქონიოთ</translation>
<translation id="6570579332384693436">მართლწერის შეცდომების გასასწორებლად, Chromium თქვენ მიერ ტექსტის ველში აკრეფილ ტექსტებს Google-ს უგზავნის</translation>
<translation id="8346408025829878332">Optimium-ის შეტყობინების პარამეტრებზე გადასვლა</translation>
<translation id="6600016381025017075">მოძებნეთ ნებისმიერი რამ ამ გვერდზე</translation>
<translation id="5149981246269331326">თქვენი ცვლილებები გააქტიურდება Optimium-ის შემდეგი გაშვებისას.</translation>
<translation id="1163143914216098175">Optimium ახლა Windows-ის ჩართვისას გაეშვება, რათა დათვალიერება მომენტალურად დაიწყოთ. ამის გამორთვა პარამეტრებიდან შეგიძლიათ.</translation>
<translation id="7839895033810030903">გააგრძელეთ იქიდან, სადაც გაჩერდით: Optimium-მა აღადგინა ჩანართები თქვენი ბოლო სესიიდან. ამის გამორთვა შეგიძლიათ აქ:</translation>
<translation id="8919724422686713691">თქვენი შემოგარენის 3-განზომილებიანი რუკის შესაქმნელად Optimium საჭიროებს მეხსიერებაზე წვდომის ნებართვას</translation>
<translation id="6669284030132180248">თუ თქვენს სანიშნეებს Google ანგარიშშიც ინახავთ, შეგიძლიათ თვალი მიადევნოთ პროდუქტების ფასებს Chromium-ში და შეიტყოთ, როცა ფასი დაიკლებს</translation>
<translation id="6676384891291319759">წვდომა ინტერნეტზე</translation>
<translation id="668175097507315160">ChromiumOS-მა ვერ დაასინქრონა თქვენი მონაცემები შესვლის შეცდომის გამო.</translation>
<translation id="2337492685922399200">ამ აპის მონაცემების Optimium-იდან ამოშლა</translation>
<translation id="7200198227335381561">Optimium საჭიროებს მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="6712881677154121168">შეცდომა ჩამოტვირთვისას: <ph name="DOWNLOAD_ERROR" /></translation>
<translation id="358599119501177356">თქვენი პროფილის გამოყენება შეუძლებელია, რადგან ის Optimium-ის უახლესი ვერსიიდანაა.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს. გთხოვთ მიუთითოთ სხვადასხვა პროფილის დირექტორია ან გამოიყენეთ Optimium-ის ახალი ვერსია.</translation>
<translation id="6729124504294600478">პერსონალიზაციის და სხვა ფუნქციებით რომ ისარგებლოთ, დაურთეთ Chromium როგორც ვებსა და აპებში აქტივობას, ისე მიბმულ Google სერვისებს</translation>
<translation id="196085196242095682">Optimium უკვე დაინსტალირებულია თქვენი კომპიუტერის ყველა მომხმარებლისთვის.</translation>
<translation id="8573534493546068455">შედით Optimium-ში, რომ მიიღოთ სანიშნეები და სხვა მონაცემები თქვენს ყველა მოწყობილობაზე. შესვლის შემდეგ ეს სანიშნე შეინახება თქვენს Google ანგარიშში.</translation>
<translation id="674891594898436429">ამ ჩანართში აქტიური ძიების დახურვა</translation>
<translation id="87486021868820245">აჩქარებს Optimium-ის V8 მექანიზმის მქონე საიტების მუშაობას, მაგრამ Optimium ოდნავ ნაკლებად უძლებს შეტევებს. ეს პარამეტრი ჩართულია.</translation>
<translation id="474617559993879524">{count,plural, =1{თქვენი Optimium-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს Google ანგარიშში. ანგარიშიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში აღნიშნული მონაცემები (1 ერთეული) წაიშლება.}other{თქვენი Optimium-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს Google ანგარიშში. ანგარიშიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში აღნიშნული მონაცემები ({count} ერთეული) წაიშლება.}}</translation>
<translation id="1681402107856523620">Optimium გირჩევთ, დაასკანიროთ ეს ფაილი, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="6779406956731413166">ChromiumOS-ს უზრუნველყოფს დამატებითი <ph name="BEGIN_LINK_CROS_OSS" />ღია წყაროს პროგრამული უზრუნველყოფა<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6804256634866838775">აქტიური ძიების დახურვა</translation>

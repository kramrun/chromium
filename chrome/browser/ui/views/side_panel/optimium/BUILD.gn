assert(is_win || is_mac || is_linux || is_chromeos)

# Keep the public coordinator independent of the web-page integration deps.
source_set("optimium") {
  public = [ "soundcloud_side_panel_coordinator.h" ]
  public_deps = [
    "//base",
    "//chrome/browser/ui/side_panel",
    "//ui/base/unowned_user_data",
  ]
}

source_set("impl") {
  sources = [ "soundcloud_side_panel_coordinator.cc" ]
  deps = [
    ":optimium",
    "//base",
    "//chrome/app/vector_icons",
    "//chrome/browser:file_select_helper",
    "//chrome/browser/content_settings",
    "//chrome/browser/media/webrtc",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/task_manager",
    "//chrome/browser/ui:browser_tabstrip",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/color:color_headers",
    "//chrome/browser/ui/prefs",
    "//chrome/browser/ui/side_panel",
    "//chrome/browser/ui/side_panel:side_panel_views_dependent",
    "//chrome/browser/ui/views/frame:browser_view_header",
    "//chrome/browser/ui/webui:webui_util",
    "//components/content_settings/browser",
    "//components/javascript_dialogs",
    "//components/permissions",
    "//components/version_info",
    "//components/web_modal",
    "//content/public/browser",
    "//third_party/blink/public/common",
    "//ui/base",
    "//ui/gfx",
    "//ui/views",
    "//ui/views/controls/webview",
    "//url",
  ]
}

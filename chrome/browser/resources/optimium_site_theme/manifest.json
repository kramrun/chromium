{
  "manifest_version": 3,
  "name": "Optimium • оформление сайтов",
  "version": "1.0",
  "description": "Цвета Optimium на YouTube и в поиске Google. Управление во Внешнем виде.",
  "key": "",
  "permissions": [
    "settingsPrivate"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://google.com/*",
    "https://www.google.com/*",
    "https://google.ru/*",
    "https://www.google.ru/*",
    "https://w.soundcloud.com/player/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://google.com/*",
        "https://www.google.com/*",
        "https://google.ru/*",
        "https://www.google.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://w.soundcloud.com/player/*"],
      "js": ["soundcloud.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
